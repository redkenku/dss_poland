event={"id":"poland_events_2021_2023.nov21_konf","source":"source/scenes/poland_events_2021_2023.scene.dry:1793","proseGrade":"A","proseAudit":"The premise quotes the actual county-meeting and Telegram language (\"executioners\", \"foreign agents\") so the threat is specific rather than categorical, and expose, protect and dismiss each end in a different organisational fact.","historicalDate":"November 2021 — Rage is getting organised","factualBaseline":"Konfederacja organisers tie anti-vaccine messaging to anti-left rhetoric and abortion backlash. In county meetings and Telegram channels, doctors are called \"executioners,\" women's-strike volunteers \"foreign agents,\" and left councillors \"enemies of Polish families.\" The campaign frame is no longer only taxes and lockdowns. It is social conflict with named targets.","peopleIntroduced":[],"organisationsIntroduced":["Lewica","Konfederacja"],"requiredRole":"Lewica national leadership under the live constitutional role shown by the event","legalAuthority":"Authority is limited to the named office, chamber, party body or cabinet actor; party leadership cannot exercise another institution’s power.","availabilityConditions":"november_2021_konf_done = 0","choices":[{"id":"poland_events_2021_2023.nov21_konf_expose","title":"Expose the network and name the intimidation chain","subtitle":"Cost: 1 resource.","subtitleSource":"source","availabilityConditions":"resources >= 1 · The monitoring team lacks legal and media capacity.","authorityStage":"proposal","immediateConsequence":"resources -= 1; media_capacity += 3; constitutional_restraint += 2; feminist_trust += 2; minority_safety += 2; konf_poll_momentum -= 0.15; news_headline = \"Lewica publishes the anti-left intimidation chain behind Konfederacja's campaign\"","delayedCallbacks":["constitutional_restraint","feminist_trust","konf_poll_momentum","media_capacity","minority_safety","news_headline","resources"],"mediaPublicReception":["Lewica publishes the anti-left intimidation chain behind Konfederacja"],"strategicallyDefensible":true},{"id":"poland_events_2021_2023.nov21_konf_protect","title":"Build clinic, school and activist protection protocols","subtitle":"Authority and foreseeable risk are recorded by the immediate consequence and callback fields.","subtitleSource":"manifest_fallback","availabilityConditions":"Available whenever the parent event is active.","authorityStage":"negotiated_concession","immediateConsequence":"local_network += 3; minority_safety += 4; feminist_trust += 3; police_trust += 1; public_trust += 2; konf_poll_momentum += 0.05; news_headline = \"The Left builds local protection against anti-left intimidation\"","delayedCallbacks":["feminist_trust","konf_poll_momentum","local_network","minority_safety","news_headline","police_trust","public_trust"],"mediaPublicReception":["The Left builds local protection against anti-left intimidation"],"strategicallyDefensible":true},{"id":"poland_events_2021_2023.nov21_konf_dismiss","title":"Treat it as online theatre and stay on other files","subtitle":"Authority and foreseeable risk are recorded by the immediate consequence and callback fields.","subtitleSource":"manifest_fallback","availabilityConditions":"Available whenever the parent event is active.","authorityStage":"proposal","immediateConsequence":"konf_poll_momentum += 0.3; far_right_agenda += 2; feminist_trust -= 2; minority_safety -= 2; news_headline = \"Konfederacja hardens anti-left language without sustained answer\"","delayedCallbacks":["far_right_agenda","feminist_trust","konf_poll_momentum","minority_safety","news_headline"],"mediaPublicReception":["Konfederacja hardens anti-left language without sustained answer"],"strategicallyDefensible":true}],"delayedCallbacks":["constitutional_restraint","far_right_agenda","feminist_trust","konf_poll_momentum","local_network","media_capacity","minority_safety","news_headline","police_trust","public_trust","resources"],"mediaPublicReception":["Lewica publishes the anti-left intimidation chain behind Konfederacja","The Left builds local protection against anti-left intimidation","Konfederacja hardens anti-left language without sustained answer"],"alternateHistoryDependencies":"november_2021_konf_done = 0","splitFallback":"If a named faction or party has split, preserve the institution and resolve the live successor organisation or office-holder; never silently reunify it.","classification":"dated_choice"}
