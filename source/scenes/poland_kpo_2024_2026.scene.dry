@kpo_budget_gate_2024
# prose-audit: Grade A — The budget gate distinguishes usable projects from paper milestones and gives each role an honest political consequence.
title: KPO reaches the budget table
subtitle: Unspent money is not fiscal capacity until projects can use it.
face-image: img/poland/events/kpo.webp
new-page: true
tags: poland_event
priority: 10
order: 80
max-visits: 1
view-if: continuous_campaign = 1 and year = 2024 and month = 12
on-arrival: {!
const kpoBudgetNum24 = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoBudgetNum24(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoBudgetNum24(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoBudgetNum24(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoBudgetNum24(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoBudgetNum24(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoBudgetNum24(Q.kpo_deadline_pressure, 8);
Q.kpo_shortcut_debt = kpoBudgetNum24(Q.kpo_shortcut_debt, 0);
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
const kpoBudgetReadiness24 =
    Q.kpo_milestones * 2 + Q.kpo_delivery -
    Q.kpo_deadline_pressure - Q.kpo_shortcut_debt * 2;
Q.kpo_review_2024 =
    kpoBudgetReadiness24 >= 15
        ? "Milestones credible"
        : (kpoBudgetReadiness24 >= 4
            ? "Corrective file required"
            : "Next tranche at risk");
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
Q.kpo_last_summary = "The first full coalition budget must distinguish grants, co-financing and ordinary promises.";
Q.news_headline = "KPO co-financing enters the first full coalition budget";
!}

