on-arrival: {!
const kpoNumber = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoNumber(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoNumber(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoNumber(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoNumber(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoNumber(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoNumber(Q.kpo_deadline_pressure, 8);
Q.kpo_shortcut_debt = kpoNumber(Q.kpo_shortcut_debt, 0);
Q.kpo_funds_delayed = kpoNumber(Q.kpo_funds_delayed, 0);
if (Q.kpo_2022_concession_pending) {
    Q.kpo_delivery += 3;
    Q.kpo_milestones += 2;
    Q.kpo_2022_concession_implemented = 1;
    Q.kpo_2022_concession_pending = 0;
    Q.last_policy_stage = "Government implementation callback";
    Q.last_policy_authority =
        "Council of Ministers and European Commission";
    Q.last_policy_implementation =
        "The 2022 concession reaches the 2024 payment dossier";
}
const kpoNames24a = {
    ko: "KO",
    p2050: "Poland 2050",
    psl: "PSL",
    pis: "PiS",
    konf: "Konfederacja"
};
const kpoSeats24a = function(code) {
    return Q["ministry_" + code + "_in_cabinet"]
        ? Math.max(0, Number(Q[code + "_seats"]) || 0)
        : 0;
};
// The senior party is the partner whether or not it is the largest; below it,
// the biggest cabinet club is the one whose ministries a credit fight costs.
Q.kpo_partner_code = Object.keys(kpoNames24a)
    .filter(function(code) { return kpoSeats24a(code) > 0; })
    .sort(function(first, second) {
        return (second == Q.government_party ? 1e6 : kpoSeats24a(second)) -
            (first == Q.government_party ? 1e6 : kpoSeats24a(first));
    })[0] || "";
Q.kpo_partner_name =
    kpoNames24a[Q.kpo_partner_code] || "the coalition's other parties";
Q.kpo_partner_leader =
    String(Q[Q.kpo_partner_code + "_leader"] || "").trim() ||
    String(Q.prime_minister || "the senior partner");
// The chain's own memory. Later events read who signed the ledger, whose name
// is on the file, and which partner is still owed an argument.
Q.kpo_ledger_public = 0;
Q.kpo_opposition_file = 0;
Q.kpo_owner = "none";
Q.kpo_prior_owner = "none";
Q.kpo_owner_label = "No party has attached itself to the file";
Q.kpo_grudge_active = 0;
Q.kpo_grudge_code = "";
Q.kpo_grudge_name = "";
Q.kpo_grudge_leader = "";
Q.kpo_grudge_reason = "";
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
Q.kpo_last_summary = "The payment dossier reaches the coalition table.";
Q.kpo_funds_status = "Payment request under assessment";
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
Q.news_headline = "The rule-of-law plan becomes a recovery-fund payment file";
!}

= February 2024 — From action plan to payment

The recovery plan is worth **€59.8 billion** and it has an expiry date. Every
milestone has to be met, invoiced and certified by **31 August 2026**; after
that, money not drawn is not delayed, it is gone. The rule-of-law action plan
went to Brussels this month, which unfreezes the argument without moving a
single euro: the Commission still has to assess the milestones, and the payment
request is one file in a queue on a desk in the Berlaymont.

[? if left_in_government = 1: The coalition's KPO committee meets with three documents in front of it — the milestone schedule, the list of ministries answerable for each line, and a draft communications plan. Only the third has been read by everybody in the room.?]
[? if left_in_government = 1: **[+ prime_minister +]** wants an announcement that is clean and singular. **[+ kpo_partner_leader +]** wants [+ kpo_partner_name +]'s ministries named inside it. **[+ finance_minister +]** wants nobody promising a złoty before Brussels has promised one first. Our own delegation wants to know which line on this schedule will still have Lewica's name attached to it in 2027, when none of the people currently arguing will be in the room.?]
[? if left_in_government = 0: We are not in the room. The committee sits in the Chancellery under **[+ prime_minister +]**, the schedule is a government document, and the first any opposition party will see of the annexes is when somebody leaks them or we go and read them ourselves.?]

[? if kpo_delivery >= 6: Earlier Left pressure has already produced a delivery ledger somebody can actually use. Nobody is arguing about whether the projects exist. They are arguing about whose logo goes on the hoarding.?]
[? if kpo_delivery < 6: Earlier KPO bargains produced more promises than administrative preparation. There are ministries on this schedule that cannot say, this month, how many of their milestones have a named official behind them.?]

