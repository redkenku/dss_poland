order: 15
max-visits: 1
view-if: continuous_campaign = 1 and year = 2024 and month = 2
on-arrival: {!
const kpoNumber = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoNumber(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoNumber(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoNumber(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoNumber(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoNumber(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoNumber(Q.kpo_deadline_pressure, 8);
Q.kpo_shortcut_debt = kpoNumber(Q.kpo_shortcut_debt, 0);
Q.kpo_funds_delayed = kpoNumber(Q.kpo_funds_delayed, 0);
if (Q.kpo_2022_concession_pending) {
    Q.kpo_delivery += 3;
    Q.kpo_milestones += 2;
    Q.kpo_2022_concession_implemented = 1;
    Q.kpo_2022_concession_pending = 0;
    Q.last_policy_stage = "Government implementation callback";
    Q.last_policy_authority =
        "Council of Ministers and European Commission";
    Q.last_policy_implementation =
        "The 2022 concession reaches the 2024 payment dossier";
}
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
Q.kpo_last_summary = "The payment dossier reaches the coalition table.";
Q.kpo_funds_status = "Payment request under assessment";
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
Q.news_headline = "The rule-of-law plan becomes a recovery-fund payment file";
!}

= February 2024 — From action plan to payment

The government has presented its rule-of-law action plan. The Commission will
still assess milestones before money moves, while every coalition party wants
credit for the first funded projects.

[? if kpo_delivery >= 6: Earlier Left pressure has already produced a usable
delivery ledger. The argument is now over ownership.?]
[? if kpo_delivery < 6: Earlier KPO bargains produced more promises than
administrative preparation. The first claim needs a credible ledger.?]

- @dossier_public_ledger
- @dossier_left_earmarks
- @dossier_fast_claim
- @dossier_opposition_audit
- @dossier_opposition_record

@dossier_public_ledger
title: Put every milestone, ministry and deadline on one public ledger
subtitle: Make every coalition ministry own a deadline that voters can inspect later.
view-if: left_in_government = 1
on-arrival: {!
Q.kpo_milestones += 4;
Q.kpo_delivery += 2;
Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 3);
Q.kpo_public_credit += 2;
Q.public_trust += 3;
Q.ko_relation += 2;
Q.psl_relation += 1;
Q.razem_dissent -= 3;
Q.kpo_last_credit_change = 2;
Q.kpo_last_delivery_change = 2;
Q.kpo_last_summary = "A common public ledger makes later credit claims auditable.";
Q.news_headline = "The coalition publishes a ministry-by-ministry KPO ledger";
!}

Every milestone goes onto one page with a ministry beside it and a date beneath
it. Nothing about the document is generous: a minister who misses a deadline
will be missing it in public, against a line somebody else in the same cabinet
met on time.

Our partners sign it because refusing to sign looks worse than signing. They
understand what they have agreed to by the second week, when a journalist
telephones about a housing line rather than about the fund in general.

- @kpo_result: File the ledger

@dossier_left_earmarks
title: Reserve the Left's claim for housing, care and local services
subtitle: Cost: 1 resource. Put Lewica's name on social investment and provoke a coalition credit fight.
view-if: left_in_government = 1
choose-if: resources >= 1
unavailable-subtitle: The party cannot staff a parallel investment team.
on-arrival: {!
Q.resources -= 1;
Q.kpo_milestones += 2;
Q.kpo_delivery += 4;
Q.kpo_public_credit += 5;
Q.ko_relation -= 3;
Q.psl_relation -= 1;
Q.government_coalition_dissent += 2;
Q.labor_credibility += 3;
Q.local_network += 2;
Q.kpo_last_credit_change = 5;
Q.kpo_last_delivery_change = 4;
Q.kpo_last_summary = "The Left attaches its name to a concrete social-investment file.";
Q.news_headline = "Lewica marks housing, care and local services as its KPO share";
!}

Our own people go through the annexes and come back with the lines that can be
photographed: social housing, care places, the bus routes that stopped running
in 2019. Those become the Lewica file, staffed by Lewica officials, defended in
committee under our name.

KO's managers call it a raid on a common fund. They are not wrong. The
calculation is that a fund with no author gets remembered as the government's,
and a government is a thing voters can already name without us.

- @kpo_result: Claim the social file

@dossier_fast_claim
title: File quickly behind Prime Minister [+ prime_minister +]
subtitle: Move the claim quickly and let [+ prime_minister +] own the announcement.
view-if: left_in_government = 1
on-arrival: {!
Q.kpo_milestones += 3;
Q.kpo_delivery += 1;
Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 2);
const leftOwnsPremiership = Q.government_party == "lewica";
if (leftOwnsPremiership) {
    Q.kpo_public_credit += 3;
    Q.government_delivery += 2;
    Q.party_unity += 2;
    Q.razem_dissent -= 2;
    Q.ko_coalition_dissent += 2;
    Q.psl_coalition_dissent += 1;
    Q.kpo_last_credit_change = 3;
    Q.kpo_last_summary =
        "The file moves faster, and Lewica's prime minister owns the result.";
} else {
    Q.kpo_public_credit -= 2;
    if (Q.government_party == "ko") {
        Q.ko_relation += 4;
        Q.ko_coalition_dissent -= 2;
    } else if (Q.government_party == "psl") {
        Q.psl_relation += 4;
        Q.psl_coalition_dissent -= 2;
    } else if (Q.government_party == "p2050") {
        Q.p2050_relation += 4;
        Q.p2050_coalition_dissent -= 2;
    } else {
        Q.government_coalition_dissent -= 2;
    }
    Q.razem_dissent += 4;
    Q.kpo_last_credit_change = -2;
    Q.kpo_last_summary =
        "The file moves faster, but the Left disappears behind " +
        Q.prime_minister + ".";
}
Q.kpo_last_delivery_change = 1;
Q.news_headline = Q.prime_minister + " submits a rapid common KPO claim";
!}

The claim goes to Brussels inside a fortnight, unamended, with the Chancellery's
covering letter on top of it. Speed is worth something real: the Commission's
desk officers are working through a queue, and a file that arrives early and
tidy is a file that gets read.

[? if government_party = "lewica": The letter is signed by our own prime
minister, so the tidiness and the queue position both belong to us. Razem
notes, without much warmth, that the fastest way to look like a party of
government is to behave like one.?]
[? if government_party != "lewica": **[+ prime_minister +]** announces it alone,
because the letter went out under the Chancellery's name and nobody thought to
ask for a second signature. Razem asks what exactly we bought with the fortnight
we saved.?]

- @kpo_result: Send the rapid claim

@dossier_opposition_audit
title: Publish a social-investment and milestone audit
subtitle: Cost: 1 resource. Expose the missing social ledger without claiming cabinet powers.
view-if: left_in_government = 0
choose-if: resources >= 1
unavailable-subtitle: Opposition scrutiny needs staff, data work and legal capacity.
on-arrival: {!
Q.resources -= 1;
Q.kpo_scrutiny += 2;
Q.kpo_public_credit += 3;
Q.media_capacity += 2;
Q.labor_credibility += 2;
Q.public_trust += 2;
Q.ko_relation -= 2;
Q.kpo_last_credit_change = 3;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_summary = "Opposition scrutiny wins credit without pretending to control the payment.";
Q.news_headline = "The Left publishes the missing social side of the KPO ledger";
!}

Two researchers and a lawyer spend the month reading annexes nobody in the
press gallery has opened. What they publish is not an accusation but a
comparison: the milestones the plan promises, and the housing, care and local
lines that were quietly dropped between draft and submission.

The government does not have to answer an opposition document. It does have to
answer the mayors who read it and recognised their own withdrawn projects. We
have changed nothing about the payment and a good deal about who is asking
questions in the committee corridor.

- @kpo_result: Publish the audit

@dossier_opposition_record
title: Table written questions and record the missing milestones
subtitle: Always available in opposition. A parliamentary paper records the gap but cannot replace a staffed audit.
view-if: left_in_government = 0
on-arrival: {!
Q.kpo_scrutiny += 1;
Q.kpo_public_credit += 1;
Q.kpo_last_credit_change = 1;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_summary = "Written questions preserve an opposition record without claiming to complete a milestone audit.";
Q.news_headline = "Lewica records the missing KPO milestones in Parliament";
!}

The questions go in under parliamentary rules: numbered, dated, requiring an
answer within thirty days. It costs the club a morning and produces no
headline whatsoever.

What it produces is a record. When a minister later says the social lines were
never part of the plan, there will be a signed reply on file saying something
else. It is the cheapest instrument we have and the slowest.

- @kpo_result: File the questions


@kpo_first_payment_2024
# prose-audit: Grade B — Authorised payment and repaired courts stay properly distinct, and each of the six routes now lands somewhere concrete — open calls, ribbon-cutting flagships, an invisible co-financing reserve, a published correction file. The premise itself is still two conditional sentences where the branches beneath it are three paragraphs.
title: The first KPO payment
subtitle: European confidence creates capacity, not a blank cheque.
face-image: img/poland/events/kpo.webp
new-page: true
tags: poland_event
priority: 27
order: 10
max-visits: 1
view-if: continuous_campaign = 1 and year = 2024 and month = 4
on-arrival: {!
const kpoNum24 = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoNum24(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoNum24(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoNum24(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoNum24(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoNum24(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoNum24(Q.kpo_deadline_pressure, 8);
Q.kpo_shortcut_debt = kpoNum24(Q.kpo_shortcut_debt, 0);
Q.kpo_funds_delayed = kpoNum24(Q.kpo_funds_delayed, 0);
const kpoLegitimacy24 = kpoNum24(Q.judicial_legitimacy, 35);
const kpoRestraint24 = kpoNum24(Q.government_procedural_restraint, 45);
const kpoDualism24 = kpoNum24(Q.legal_dualism, 50);
// January 2023: the price Lewica put on the disciplinary bill. Lending votes
// for money the Commission had not yet promised moved the file faster and
// left an unverified milestone behind it; that debt is what the October 2025
// review scores. Refusing kept the record clean and the clock running.
const kpoBillQuality23 = Q.kpo_bill_2023_done
    ? kpoNum24(Q.kpo_bill_quality, 0) : -1;
Q.kpo_bill_2023_legacy = "No Lewica position on the 2023 bill";
if (kpoBillQuality23 == 3) {
    Q.kpo_milestones += 1;
    Q.kpo_shortcut_debt = Math.max(0, Q.kpo_shortcut_debt - 1);
    Q.kpo_bill_2023_legacy = "Verified milestones survive the Commission's audit";
} else if (kpoBillQuality23 == 2) {
    Q.kpo_shortcut_debt += 2;
    Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 2);
    Q.kpo_bill_2023_legacy = "The unverified 2023 bill is carried as technical debt";
} else if (kpoBillQuality23 == 0) {
    Q.kpo_deadline_pressure += 2;
    Q.kpo_bill_2023_legacy = "A year was lost refusing a renamed disciplinary system";
}
const kpoDossier24 = Q.kpo_milestones + Q.kpo_delivery;
Q.kpo_first_payment_paid =
    Q.government_party != "pis" &&
    (kpoDualism24 < 78 || kpoRestraint24 >= 35 || kpoDossier24 >= 10 ||
        kpoBillQuality23 == 2) &&
    kpoLegitimacy24 > 8 ? 1 : 0;
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
if (Q.kpo_first_payment_paid) {
    Q.kpo_funds_available += 6;
    Q.kpo_milestones += 2;
    Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 4);
    Q.kpo_funds_status = "First payment released; later milestones remain";
    Q.kpo_last_funds_change = 6;
    Q.kpo_last_summary = "The first payment lands, but later tranches remain conditional.";
    Q.news_headline = "The first KPO payment reaches Poland";
} else {
    Q.kpo_funds_delayed += 6;
    Q.kpo_deadline_pressure += 8;
    Q.kpo_funds_status = "First payment returned for correction";
    Q.kpo_last_summary = "The first payment file is delayed by an exceptional legitimacy failure.";
    Q.news_headline = "The KPO payment file returns with legal conditions";
}
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
!}

= April 2024 — Payment brings obligations

[? if kpo_first_payment_paid: The first recovery payment is authorised.
Domestic courts are not thereby repaired; the coalition has received money
and a monitored implementation schedule.?]
[? if not kpo_first_payment_paid: The payment file is returned for correction.
This requires an extreme alternate record of legal dualism and weak
implementation—the government can repair the file or politicise the delay.?]

[? if kpo_bill_quality = 2 and kpo_bill_2023_done = 1: The Commission's
auditors reach the January 2023 disciplinary bill we voted for before anyone
had promised a euro. It moved the money then. It is an unverified milestone
now, and it stays on the file until somebody closes it.?]
[? if kpo_bill_quality = 3 and kpo_bill_2023_done = 1: The independent
verification we made the price of our votes in January 2023 is already in the
file. The auditors read a milestone that has been checked by somebody other
than the ministry that wrote it, and move on.?]
[? if kpo_bill_quality = 0 and kpo_bill_2023_done = 1: We refused the renamed
disciplinary system in January 2023 and the fund stayed frozen for another
year. The record is clean and the deadline is a year closer.?]

