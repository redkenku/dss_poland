Q.kpo_shortcut_debt = Math.max(0, Q.kpo_shortcut_debt - 4);
Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 2);
Q.kpo_public_credit += 2;
Q.public_trust += 3;
Q.ko_relation -= 2;
Q.kpo_last_credit_change += 2;
Q.kpo_last_delivery_change = 3;
Q.kpo_last_summary = "A smaller honest file loses money but protects trust and later audits.";
Q.news_headline = "The government submits a smaller independently audited KPO file";
!}
