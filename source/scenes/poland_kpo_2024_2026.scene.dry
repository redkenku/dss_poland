        ? Math.max(0, Number(Q[code + "_seats"]) || 0)
        : 0;
};
Q.kpo_partner_code = Object.keys(kpoNames25)
    .filter(function(code) { return kpoSeats25(code) > 0; })
    .sort(function(first, second) {
        return (second == Q.government_party ? 1e6 : kpoSeats25(second)) -
            (first == Q.government_party ? 1e6 : kpoSeats25(first));
    })[0] || "";
