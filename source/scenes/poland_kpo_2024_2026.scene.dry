on-arrival: {!
const kpoNum24 = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoNum24(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoNum24(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoNum24(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoNum24(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoNum24(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoNum24(Q.kpo_deadline_pressure, 8);
Q.kpo_shortcut_debt = kpoNum24(Q.kpo_shortcut_debt, 0);
Q.kpo_funds_delayed = kpoNum24(Q.kpo_funds_delayed, 0);
const kpoLegitimacy24 = kpoNum24(Q.judicial_legitimacy, 35);
const kpoRestraint24 = kpoNum24(Q.government_procedural_restraint, 45);
const kpoDualism24 = kpoNum24(Q.legal_dualism, 50);
const kpoNames24b = {
    ko: "KO",
    p2050: "Poland 2050",
    psl: "PSL",
    pis: "PiS",
    konf: "Konfederacja"
};
const kpoSeats24b = function(code) {
    return Q["ministry_" + code + "_in_cabinet"]
        ? Math.max(0, Number(Q[code + "_seats"]) || 0)
        : 0;
};
Q.kpo_partner_code = Object.keys(kpoNames24b)
    .filter(function(code) { return kpoSeats24b(code) > 0; })
    .sort(function(first, second) {
        return (second == Q.government_party ? 1e6 : kpoSeats24b(second)) -
            (first == Q.government_party ? 1e6 : kpoSeats24b(first));
    })[0] || "";
Q.kpo_partner_name =
    kpoNames24b[Q.kpo_partner_code] || "the coalition's other parties";
Q.kpo_partner_leader =
    String(Q[Q.kpo_partner_code + "_leader"] || "").trim() ||
    String(Q.prime_minister || "the senior partner");
Q.kpo_ledger_public = Q.kpo_ledger_public ? 1 : 0;
Q.kpo_prior_ledger = Q.kpo_ledger_public;
Q.kpo_opposition_file = Q.kpo_opposition_file ? 1 : 0;
Q.kpo_owner = String(Q.kpo_owner || "none");
Q.kpo_prior_owner = Q.kpo_owner;
Q.kpo_grudge_active = Q.kpo_grudge_active ? 1 : 0;
Q.kpo_grudge_name = String(Q.kpo_grudge_name || "");
Q.kpo_grudge_leader = String(Q.kpo_grudge_leader || "");
Q.kpo_grudge_reason = String(Q.kpo_grudge_reason || "");
// January 2023: the price Lewica put on the disciplinary bill. Lending votes
// for money the Commission had not yet promised moved the file faster and
// left an unverified milestone behind it; that debt is what the October 2025
// review scores. Refusing kept the record clean and the clock running.
const kpoBillQuality23 = Q.kpo_bill_2023_done
    ? kpoNum24(Q.kpo_bill_quality, 0) : -1;
Q.kpo_bill_2023_legacy = "No Lewica position on the 2023 bill";
if (kpoBillQuality23 == 3) {
    Q.kpo_milestones += 1;
    Q.kpo_shortcut_debt = Math.max(0, Q.kpo_shortcut_debt - 1);
    Q.kpo_bill_2023_legacy = "Verified milestones survive the Commission's audit";
} else if (kpoBillQuality23 == 2) {
    Q.kpo_shortcut_debt += 2;
    Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 2);
    Q.kpo_bill_2023_legacy = "The unverified 2023 bill is carried as technical debt";
} else if (kpoBillQuality23 == 0) {
    Q.kpo_deadline_pressure += 2;
    Q.kpo_bill_2023_legacy = "A year was lost refusing a renamed disciplinary system";
}
const kpoDossier24 = Q.kpo_milestones + Q.kpo_delivery;
Q.kpo_first_payment_paid =
    Q.government_party != "pis" &&
    (kpoDualism24 < 78 || kpoRestraint24 >= 35 || kpoDossier24 >= 10 ||
        kpoBillQuality23 == 2) &&
    kpoLegitimacy24 > 8 ? 1 : 0;
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
if (Q.kpo_first_payment_paid) {
    Q.kpo_funds_available += 6;
    Q.kpo_milestones += 2;
    Q.kpo_deadline_pressure = Math.max(0, Q.kpo_deadline_pressure - 4);
    Q.kpo_funds_status = "First payment released; later milestones remain";
    Q.kpo_last_funds_change = 6;
    Q.kpo_last_summary = "The first payment lands, but later tranches remain conditional.";
    Q.news_headline = "The first KPO payment reaches Poland";
} else {
    Q.kpo_funds_delayed += 6;
    Q.kpo_deadline_pressure += 8;
    Q.kpo_funds_status = "First payment returned for correction";
    Q.kpo_last_summary = "The first payment file is delayed by an exceptional legitimacy failure.";
    Q.news_headline = "The KPO payment file returns with legal conditions";
}
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
!}

= April 2024 — Payment brings obligations

[? if kpo_first_payment_paid: **€6.3 billion** is authorised and moves on 15 April. It is the first recovery money to reach Poland since the plan was written, and it arrives as a transfer with an implementation schedule attached, not as a verdict: no Polish court has been repaired by it, no appointment has been undone, and the next tranche is conditional on work nobody has yet done.?]
[? if not kpo_first_payment_paid: The file comes back. The Commission's letter is four pages, courteous, and specific about which milestones it cannot certify; the transfer does not move. This takes an exceptional record — legal dualism deep enough and implementation thin enough that the assessment had nowhere to go — and it leaves the coalition two options, repair the file or blame Brussels for it.?]

[? if kpo_ledger_public = 1: February's public ledger is already doing work nobody enjoys. Journalists have the column headings, so the first question at the ministry briefing is not what the money is for but which of the fourteen lines due this quarter are late — and two of the late ones are ours.?]
[? if kpo_owner = "chancellery": The claim went in under [+ prime_minister +]'s signature and the announcement follows the same route. Our ministers learn the disbursement date from the wires.?]
[? if kpo_owner = "lewica" and left_in_government = 1: The social annexes have our name on them, which means the housing and care lines will be read as Lewica's success or Lewica's failure, and nobody else will be standing there when either happens.?]
[? if kpo_grudge_active: Across the table, [+ kpo_grudge_name +] has not moved on from [+ kpo_grudge_reason +]. **[+ kpo_grudge_leader +]** is pleasant about it in public and is counting.?]

[? if kpo_bill_quality = 2 and kpo_bill_2023_done = 1: The Commission's auditors reach the January 2023 disciplinary bill — the one we voted for before anybody in Brussels had promised a euro. It moved the money then. It is an unverified milestone now, sitting in the file with a query against it, and it will sit there until somebody spends a year closing it.?]
[? if kpo_bill_quality = 3 and kpo_bill_2023_done = 1: The independent verification we made the price of our votes in January 2023 is already in the file. The auditors read a milestone that was checked by somebody other than the ministry that wrote it, make no note, and move to the next page. It is the cheapest thing in the dossier and it cost us a year of abuse.?]
[? if kpo_bill_quality = 0 and kpo_bill_2023_done = 1: We refused the renamed disciplinary system in January 2023 and the fund stayed frozen for another year. The record is clean. The deadline is a year closer and every project office in the country knows exactly how many months it has lost.?]

