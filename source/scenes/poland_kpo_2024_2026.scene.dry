@kpo_final_window_2026
title: The last KPO summer
subtitle: Completion, correction or a frozen final file.
new-page: true
tags: poland_event
priority: 24
order: 30
max-visits: 1
view-if: continuous_campaign = 1 and year = 2026 and month = 7
on-arrival: {!
const kpoFinalNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.kpo_delivery = kpoFinalNum(Q.kpo_delivery, 0);
Q.kpo_milestones = kpoFinalNum(Q.kpo_milestones, 0);
Q.kpo_funds_available = kpoFinalNum(Q.kpo_funds_available, 0);
Q.kpo_funds_spent = kpoFinalNum(Q.kpo_funds_spent, 0);
Q.kpo_public_credit = kpoFinalNum(Q.kpo_public_credit, 0);
Q.kpo_deadline_pressure = kpoFinalNum(Q.kpo_deadline_pressure, 10) + 4;
Q.kpo_shortcut_debt = kpoFinalNum(Q.kpo_shortcut_debt, 0);
Q.kpo_funds_delayed = kpoFinalNum(Q.kpo_funds_delayed, 0);
const kpoFinalRestraint =
    kpoFinalNum(Q.government_procedural_restraint, 45);
const kpoFinalDualism = kpoFinalNum(Q.legal_dualism, 50);
const kpoFinalScore =
    Q.kpo_milestones * 2 + Q.kpo_delivery * 3 +
    Q.kpo_funds_spent * 2 + kpoFinalRestraint * 0.1 -
    Q.kpo_deadline_pressure - Q.kpo_shortcut_debt * 3 -
    Q.kpo_funds_delayed - kpoFinalDualism * 0.06;
Q.kpo_last_credit_change = 0;
Q.kpo_last_delivery_change = 0;
Q.kpo_last_funds_change = 0;
if (kpoFinalScore >= 70) {
    Q.kpo_final_status = "Green — final payment file credible";
    Q.kpo_funds_available += 4;
    Q.kpo_funds_status = "Final file credible; completion audit pending";
    Q.kpo_last_funds_change = 4;
    Q.kpo_last_summary = "A strong delivery record unlocks the last substantial funding block.";
    Q.news_headline = "The final KPO file enters the green lane";
} else if (kpoFinalScore >= 32) {
    Q.kpo_final_status = "Amber — corrective completion required";
    Q.kpo_funds_available += 2;
    Q.kpo_funds_delayed += 1;
    Q.kpo_funds_status = "Partial release; corrective completion required";
    Q.kpo_last_funds_change = 2;
    Q.kpo_last_summary = "Part of the final file clears while weak projects enter correction.";
    Q.news_headline = "The final KPO file receives a partial green light";
} else {
    Q.kpo_final_status = "Red — final payment at risk";
    Q.kpo_funds_delayed += 4;
    Q.kpo_funds_status = "Final payment at risk";
    Q.fiscal_stress += 5;
    Q.kpo_last_summary = "Missed delivery and shortcut debt threaten the final payment.";
    Q.news_headline = "The final KPO file enters a funding crisis";
}
Q.kpo_uncommitted = Math.max(
    0,
    Q.kpo_funds_available - Q.kpo_funds_spent
);
!}

