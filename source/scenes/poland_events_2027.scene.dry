on-arrival: {!
const p2050SeatsBefore = Math.max(
    0,
    Math.round(Number(Q.p2050_seats) || 0)
);
const p2050SocialShare = Math.min(
    0.55,
    0.30 +
    Math.max(0, (Number(Q.p2050_state_capacity_share) || 0) - 40) / 200 +
    Math.max(0, (Number(Q.sikorski_protest_strength) || 0) - 30) / 400
);
const p2050Transfer = Math.min(
    p2050SeatsBefore,
    Math.max(1, Math.round(p2050SeatsBefore * p2050SocialShare))
);
Q.p2050_social_joined_left = 1;
Q.left_p2050_current_seats =
    Math.max(0, Number(Q.left_p2050_current_seats) || 0) +
    p2050Transfer;
Q.p2050_seats = Math.max(0, p2050SeatsBefore - p2050Transfer);
Q.left_seats = Math.max(0, Number(Q.left_seats) || 0) + p2050Transfer;
Q.left_progressives_seats =
    Math.max(0, Number(Q.left_progressives_seats) || 0) +
    p2050Transfer;
Q.government_support_seats = Math.max(
    0,
    (Number(Q.government_support_seats) || 0) - p2050Transfer
);
Q.sikorski_refugee_seats += p2050Transfer;
Q.sikorski_refugee_wave = 3;
Q.sikorski_minority_government =
    Q.government_support_seats < 231 ? 1 : 0;
Q.sikorski_government_status = Q.sikorski_minority_government
    ? "Minority government awaiting the election under opposition toleration"
    : "Nominal majority held together after three refugee waves";
Q.coalition_status = Q.sikorski_government_status;
Q.p2050_state_capacity_share = Math.max(
    0,
    (Number(Q.p2050_state_capacity_share) || 0) - 18
);
Q.p2050_coalition_dissent += 30;
Q.progressives_strength += 5;
Q.party_unity += 2;
Q.razem_dissent += 6;
Q.razem_cooperation -= 4;
if ((Number(Q.p2050_seats) || 0) <= 0) {
    Q.ministry_p2050_in_cabinet = 0;
}
Q.news_headline = p2050Transfer +
    " Poland 2050 social-reform MPs enter " + Q.left_party_name;
