Q.war_top_2027_bonus = 0;
Q.war_top_2027_legacy = "No settled war at the top";
if (settledWar) {
    const sideBonus = {
        institutions: 0.45,
        exploit: 0.30,
        cabinet: 0.10,
        palace: 0.05,
        undeclared: 0,
        price: -0.20
    }[String(Q.war_top_left_side || "undeclared")] || 0;
    const splitBonus = Q.war_top_split
        ? (Q.war_top_camp == "lewica" ? -0.80 : 0.40)
        : 0;
    Q.war_top_2027_bonus = Math.round(
        (sideBonus + splitBonus) * 100
    ) / 100;
    // The election count consumes this quality before testing every filed
    // committee against its threshold.
    Q.snap_campaign_left_bonus += Q.war_top_2027_bonus;
    const sideRecord = {
        institutions: "a constitutional protocol that outlasted both leaders",
        exploit: "turning another camp's rupture into an opposition case",
        cabinet: "defending the sitting cabinet against the Palace",
        palace: "backing the Palace in the succession fight",
        price: "concessions extracted while the governing camp divided",
        undeclared: "keeping its distance from both claimants"
    }[String(Q.war_top_left_side || "undeclared")] ||
        "keeping its distance from both claimants";
    Q.war_top_2027_legacy = warSettlement + ". Lewica campaigns on " +
        sideRecord + ".";
}
!}

= September 2027 — one argument survives the noise

By September, the campaign has narrowed to a single argument. The polls,
committee thresholds and Senate arrangements are already visible; one last
month remains to decide what the Left wants hesitant voters to remember.

[? if war_top_stage >= 5: **The second war at the top:** [+
war_top_2027_legacy +]?]

