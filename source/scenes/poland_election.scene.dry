<div class="election-table-row"><span class="party party-ko">KO</span><span>[+ ko_vote_intent +]%</span><b>[+ ko_projected_seats +]</b><span>[+ ko_org_resources +]</span></div>
[? if third_way_joint_list = 1: <div class="election-table-row"><span class="party party-third-way">Trzecia Droga</span><span>[+ p2050_vote_intent + psl_vote_intent +]%</span><b>[+ third_way_projected_seats +]</b><span>PSL [+ psl_org_resources +] · PL2050 [+ p2050_org_resources +]</span></div>?]
[? if third_way_joint_list = 0 and p2050_emerged = 1: <div class="election-table-row"><span class="party party-p2050">Polska 2050</span><span>[+ p2050_vote_intent +]%</span><b>[+ p2050_projected_seats +]</b><span>[+ p2050_org_resources +]</span></div>?]
<div class="election-table-row"><span class="party party-lewica">[+ left_party_name +]</span><span>[+ left_vote_intent +]%</span><b>[+ left_projected_seats +]</b><span>[+ resources +]</span></div>
[? if barons_party_formed = 1: <div class="election-table-row"><span class="party party-sld">[+ barons_party_name +]</span><span>[+ sld_breakaway_vote_intent +]%</span><b>[+ sld_breakaway_projected_seats +]</b><span>separate</span></div>?]
[? if spring_party_formed = 1: <div class="election-table-row"><span class="party party-wiosna">[+ spring_party_name +]</span><span>[+ spring_breakaway_vote_intent +]%</span><b>[+ spring_breakaway_projected_seats +]</b><span>separate</span></div>?]
[? if labor_party_formed = 1: <div class="election-table-row"><span class="party party-left-labor">[+ labor_party_name +]</span><span>[+ labor_left_vote_intent +]%</span><b>[+ labor_left_projected_seats +]</b><span>separate</span></div>?]
[? if progressives_party_formed = 1: <div class="election-table-row"><span class="party party-progressive">[+ progressives_party_name +]</span><span>[+ young_left_vote_intent +]%</span><b>[+ young_left_projected_seats +]</b><span>separate</span></div>?]
[? if razem_party_formed = 1: <div class="election-table-row"><span class="party party-razem">Razem</span><span>[+ razem_vote_intent +]%</span><b>[+ razem_projected_seats +]</b><span>separate</span></div>?]
[? if pps_party_formed = 1: <div class="election-table-row"><span class="party party-pps">PPS</span><span>[+ pps_vote_intent +]%</span><b>[+ pps_projected_seats +]</b><span>separate</span></div>?]
[? if unia_centrum_formed = 1: <div class="election-table-row"><span class="party party-centrum">Unia Centrum</span><span>[+ centrum_vote_intent +]%</span><b>[+ centrum_projected_seats +]</b><span>separate</span></div>?]
