title: Elections

@presidential_2020
# Save-resume dispatcher: re-enters the 2020 chapter at whatever stage the
# stored presidential phase says. Branches must stay mutually exclusive —
# Dendry picks at random among every matching go-to.
title: Presidential election
new-page: true
go-to: poland_presidential_election.setup if pres_first_round_complete = 0; poland_presidential_election.runoff_setup if pres_first_round_complete = 1 and pres_first_round_majority = 0 and pres_runoff_complete = 0; poland_presidential_election.majority_confirmation if pres_first_round_complete = 1 and pres_first_round_majority = 1; poland_presidential_election.runoff_consequences if pres_first_round_complete = 1 and pres_first_round_majority = 0 and pres_runoff_complete = 1

@results_2023
title: 2023 Sejm election
new-page: true
call: poland_normalize
on-arrival: {!
Q.election_2023_seen = 1;
const leftFamilySeatCeiling =
    Q.left_seats + Q.sld_breakaway_seats + Q.social_patriot_seats +
    Q.spring_breakaway_seats +
    Q.labor_left_seats + Q.young_left_seats +
    Q.razem_party_seats + Q.pps_party_seats + Q.tak_rozwoj_seats;
if (
    !Number.isFinite(Number(Q.left_committed_seats)) ||
    Q.left_committed_seats < Q.left_seats ||
    Q.left_committed_seats > leftFamilySeatCeiling
) {
    Q.left_splinter_support_votes =
        (Q.barons_party_relation >= 45 ? Q.sld_breakaway_seats : 0) +
        (!["pis", "konf"].includes(Q.social_patriot_list_committee) &&
            Q.social_patriot_party_relation >= 45
            ? Q.social_patriot_seats : 0) +
        (Q.spring_party_relation >= 45 ? Q.spring_breakaway_seats : 0) +
        (Q.labor_party_relation >= 45 ? Q.labor_left_seats : 0) +
        (Q.progressives_party_relation >= 45 ? Q.young_left_seats : 0) +
        (Q.razem_party_relation >= 45 ? Q.razem_party_seats : 0) +
        (Q.pps_party_relation >= 45 ? Q.pps_party_seats : 0) +
        (Q.tak_rozwoj_parent_relation >= 45 ? Q.tak_rozwoj_seats : 0);
    Q.left_committed_seats =
        Q.left_seats + Q.left_splinter_support_votes;
}
const leftOnRightList2023 = ["pis_5", "konf_5"].includes(
    String(Q.sejm_list_outcome || "left_5")
);
Q.coalition_democratic_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats +
    Q.centrum_seats + (leftOnRightList2023 ? 0 : Q.left_committed_seats);
Q.coalition_center_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats + Q.centrum_seats;
Q.coalition_right_seats =
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats +
    (leftOnRightList2023 ? Q.left_seats : 0) +
    (["pis", "konf"].includes(Q.social_patriot_list_committee)
        ? Q.social_patriot_seats : 0);
Q.coalition_pis_psl_seats = Q.pis_seats + Q.psl_seats +
    (Q.social_patriot_list_committee == "pis"
        ? Q.social_patriot_seats : 0);
Q.news_headline =
    "The election produces " + Q.coalition_democratic_seats +
    " democratic seats";
const result2023BroadList = Q.sejm_list_outcome == "democratic_8";
Q.result_2023_broad_list = result2023BroadList ? 1 : 0;
Q.result_2023_ko_row_class = result2023BroadList
    ? "election-tree-row--child"
    : "election-tree-row--committee";
Q.result_2023_ko_member_class = result2023BroadList
    ? "election-tree-row--grandchild"
    : "election-tree-row--child";
Q.result_2023_third_way_row_class = result2023BroadList
    ? "election-tree-row--child"
    : "election-tree-row--committee";
Q.result_2023_third_way_member_class = result2023BroadList
    ? "election-tree-row--grandchild"
    : "election-tree-row--child";
Q.result_2023_left_row_class = result2023BroadList
    ? "election-tree-row--child"
    : "election-tree-row--committee";
Q.result_2023_left_member_class = result2023BroadList
    ? "election-tree-row--grandchild"
    : "election-tree-row--child";
!}
on-display: {!
const data = [];
const certifiedParties = [
    ["left", Q.left_party_short_name || "Lewica", Q.left_party_long_name || Q.left_party_name || "Lewica", Q.left_seats],
    ["sld_breakaway", "SLD", Q.barons_party_name, Q.sld_breakaway_seats],
    ["social_patriot", "LP", Q.social_patriot_party_name, Q.social_patriot_seats],
    ["spring_breakaway", "Spring", Q.spring_party_name, Q.spring_breakaway_seats],
    ["labor_left", "Labour", Q.labor_party_name, Q.labor_left_seats],
    ["young_left", "Young", Q.progressives_party_name, Q.young_left_seats],
    ["razem", "Razem", Q.razem_party_name, Q.razem_party_seats],
    ["pps", "PPS", Q.pps_party_name, Q.pps_party_seats],
    ["ko", "KO", "KO", Q.ko_seats],
    ["centrum", "Centrum", "Unia Centrum", Q.centrum_seats],
    ["pis", "PiS", "PiS", Q.pis_seats],
    ["rozwoj", "Rozwój+", "Rozwój Plus", Q.rozwoj_seats],
    ["konf", "Konf.", "Konfederacja", Q.konf_seats],
    ["korona", "Korona", "Korona", Q.korona_seats],
    ["other", "Inni", "Inni", Q.other_seats]
];
if (Q.third_way_split) {
    certifiedParties.splice(
        10,
        0,
        ["psl", "PSL", "PSL", Q.psl_seats],
        ["p2050", "PL2050", "Polska 2050", Q.p2050_seats]
    );
} else {
    certifiedParties.splice(
        10,
        0,
        [
            "third_way",
            "Third Way",
            "Trzecia Droga",
            Q.psl_seats + Q.p2050_seats
        ]
    );
}
for (const party of certifiedParties) {
    if (party[3] > 0) {
        data.push({
            id: party[0],
            legend: party[1],
            name: party[2],
            seats: party[3]
        });
    }
}
if (
    typeof window !== "undefined" &&
    typeof d3 !== "undefined" &&
    document.getElementById("poland-sejm")
) {
    let width = 500;
    let height = 500;
    const content = document.getElementById("content");
    if (content && content.offsetWidth < 450) {
        width = Math.max(260, content.offsetWidth - 30);
        height = width;
        document.getElementById("poland-sejm").style.height =
            Math.round(width / 2) + "px";
    }
    const parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#poland-sejm").datum(data).call(parliament);
}
!}

= Election results

**Sejm system:** [+ sejm_electoral_system_label +] — [+
sejm_result_list_seats +] list, [+ sejm_result_urban_seats +] urban district
and [+ sejm_result_rural_seats +] rural district seats. **Lewica:** [+
left_list_seats +] list · [+ left_urban_seats +] urban · [+
left_rural_seats +] rural.

{!<svg id="poland-sejm" class="poland-sejm-chart"></svg>!}

{!<div class="election-map-host" data-election-map-source="sejm-2023"></div>!}

<div class="election-table election-tree">
<div class="election-table-head"><span>Committee / member</span><span>Vote</span><span>Seats</span><span>Status</span></div>
[? if sejm_list_has_partners: <div class="election-table-row election-tree-row--committee election-tree-row--broad"><span class="party party-lewica">[+ sejm_list_target +]</span><span>[+ election_2023_filed_committee_vote +]%</span><b>[+ election_2023_filed_committee_seats +]</b><span>[? if sejm_electoral_system = "fptp_460": common district pact?][? if sejm_electoral_system != "fptp_460": one [+ sejm_list_threshold +]% committee?]</span></div>?]
<div class="election-table-row [+ result_2023_ko_row_class +]"><span class="party party-ko">Koalicja Obywatelska</span><span>[+ election_2023_ko_vote +]%</span><b>[+ ko_seats +]</b><span>[? if result_2023_broad_list: component of common list?][? if not result_2023_broad_list: certified committee?]</span></div>
[? if result_member_po_sejm > 0 and result_member_po_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-ko">[+ result_member_po_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_po_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_nowoczesna_sejm > 0 and result_member_nowoczesna_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-ko">[+ result_member_nowoczesna_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_nowoczesna_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_ipl_sejm > 0 and result_member_ipl_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-ko">[+ result_member_ipl_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ipl_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_greens_sejm > 0 and result_member_greens_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-ko">[+ result_member_greens_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_greens_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_ko_party_sejm > 0 and result_member_ko_party_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-ko">[+ result_member_ko_party_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ko_party_sejm +]</b><span>consolidated KO party</span></div>?]
[? if result_member_porozumienie_sejm > 0 and result_member_porozumienie_family = "ko": <div class="election-table-row [+ result_2023_ko_member_class +]"><span class="party party-agreement">[+ result_member_porozumienie_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_porozumienie_sejm +]</b><span>KO list partner</span></div>?]
[? if result_member_ko_independent_parliamentarians_sejm > 0: <div class="election-table-row [+ result_2023_ko_member_class +]"><span>KO-affiliated independents</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ko_independent_parliamentarians_sejm +]</b><span>non-party nominees</span></div>?]
[? if third_way_split = 0: <div class="election-table-row [+ result_2023_third_way_row_class +]"><span class="party party-third-way">[+ third_way_display_name +]</span><span>[+ election_2023_third_way_vote +]%</span><b>[+ p2050_seats + psl_seats +]</b><span>[? if result_2023_broad_list: component of common list?][? if not result_2023_broad_list: joint committee?]</span></div><div class="election-table-row [+ result_2023_third_way_member_class +]"><span class="party party-p2050">Polska 2050</span><span>[+ election_2023_p2050_vote +]%</span><b>[+ result_member_p2050_party_sejm +]</b><span>Third Way member</span></div><div class="election-table-row [+ result_2023_third_way_member_class +]"><span class="party party-psl">PSL</span><span>[+ election_2023_psl_vote +]%</span><b>[+ result_member_psl_party_sejm +]</b><span>Third Way member</span></div>?]
[? if third_way_split = 1: <div class="election-table-row [+ result_2023_third_way_row_class +]"><span class="party party-p2050">Polska 2050</span><span>[+ election_2023_p2050_vote +]%</span><b>[+ p2050_seats +]</b><span>separate committee</span></div><div class="election-table-row [+ result_2023_third_way_row_class +]"><span class="party party-psl">PSL</span><span>[+ election_2023_psl_vote +]%</span><b>[+ psl_seats +]</b><span>separate committee</span></div>?]
[? if third_way_split = 1 and result_member_psl_party_family = "kp" and kp_coalition_active = 1: <div class="election-table-row election-tree-row--child"><span class="party party-psl">[+ result_member_psl_party_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_psl_party_sejm +]</b><span>lead party</span></div>?]
[? if result_member_kukiz15_sejm > 0 and result_member_kukiz15_family = "kp": <div class="election-table-row [+ result_2023_third_way_member_class +]"><span class="party party-kukiz">[+ result_member_kukiz15_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kukiz15_sejm +]</b><span>member party</span></div>?]
[? if result_member_kp_partners_sejm > 0 and result_member_kp_partners_family = "kp": <div class="election-table-row [+ result_2023_third_way_member_class +]"><span class="party party-ued">[+ result_member_kp_partners_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kp_partners_sejm +]</b><span>member party</span></div>?]
[? if result_member_porozumienie_sejm > 0 and result_member_porozumienie_family = "kp": <div class="election-table-row [+ result_2023_third_way_member_class +]"><span class="party party-agreement">[+ result_member_porozumienie_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_porozumienie_sejm +]</b><span>list partner</span></div>?]
<div class="election-table-row [+ result_2023_left_row_class +]"><span class="party party-lewica">[+ left_party_name +]</span><span>[+ election_2023_left_vote +]%</span><b>[+ left_seats +]</b><span>[? if result_2023_broad_list: component of common list?][? if not result_2023_broad_list: main list?]</span></div>
[? if left_barons_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-lewica">[+ barons_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ left_barons_seats +]</b><span>constituent organisation</span></div>?]
[? if left_spring_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-wiosna">[+ spring_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ left_spring_seats +]</b><span>constituent organisation</span></div>?]
[? if left_labor_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-left-labor">[+ labor_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ left_labor_seats +]</b><span>constituent network</span></div>?]
[? if left_progressives_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-progressive">[+ progressives_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ left_progressives_seats +]</b><span>constituent current</span></div>?]
[? if razem_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-razem">Razem</span><span aria-label="no separate ballot share">—</span><b>[+ razem_seats +]</b><span>internal allocation</span></div>?]
[? if left_pps_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-pps">PPS</span><span aria-label="no separate ballot share">—</span><b>[+ left_pps_seats +]</b><span>internal allocation</span></div>?]
[? if left_social_patriot_seats > 0: <div class="election-table-row [+ result_2023_left_member_class +]"><span class="party party-social-patriot">Social-patriot current</span><span aria-label="no separate ballot share">—</span><b>[+ left_social_patriot_seats +]</b><span>internal allocation</span></div>?]
<div class="election-table-row election-tree-row--committee election-tree-row--right"><span class="party party-pis">Zjednoczona Prawica</span><span>[+ election_2023_pis_vote +]%</span><b>[+ pis_seats +]</b><span>one certified committee</span></div>
[? if result_member_pis_party_sejm > 0 and result_member_pis_party_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-pis">[+ result_member_pis_party_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_pis_party_sejm +]</b><span>lead party</span></div>?]
[? if result_member_solidarna_sejm > 0 and result_member_solidarna_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-pis">[+ result_member_solidarna_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_solidarna_sejm +]</b><span>member party</span></div>?]
[? if result_member_porozumienie_sejm > 0 and result_member_porozumienie_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-pis">[+ result_member_porozumienie_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_porozumienie_sejm +]</b><span>member party</span></div>?]
[? if result_member_republikanie_sejm > 0 and result_member_republikanie_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-pis">[+ result_member_republikanie_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_republikanie_sejm +]</b><span>member party</span></div>?]
[? if result_member_odnowa_sejm > 0 and result_member_odnowa_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-pis">[+ result_member_odnowa_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_odnowa_sejm +]</b><span>member party</span></div>?]
[? if result_member_kukiz15_sejm > 0 and result_member_kukiz15_family = "zp": <div class="election-table-row election-tree-row--child"><span class="party party-kukiz">[+ result_member_kukiz15_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kukiz15_sejm +]</b><span>list partner</span></div>?]
[? if sld_breakaway_seats > 0 or barons_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-sld">[+ barons_party_name +]</span><span>[+ election_2023_sld_breakaway_vote +]%</span><b>[+ sld_breakaway_seats +]</b><span>breakaway committee</span></div>?]
[? if social_patriot_seats > 0 or social_patriot_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-social-patriot">[+ social_patriot_party_name +]</span><span>[+ election_2023_social_patriot_vote +]%</span><b>[+ social_patriot_seats +]</b><span>[? if social_patriot_list_committee = "pis": ZP host list?][? if social_patriot_list_committee != "pis": independent?]</span></div>?]
[? if spring_breakaway_seats > 0 or spring_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-wiosna">[+ spring_party_name +]</span><span>[+ election_2023_spring_breakaway_vote +]%</span><b>[+ spring_breakaway_seats +]</b><span>breakaway committee</span></div>?]
[? if labor_left_seats > 0 or labor_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-left-labor">[+ labor_party_name +]</span><span>[+ election_2023_labor_left_vote +]%</span><b>[+ labor_left_seats +]</b><span>breakaway committee</span></div>?]
[? if young_left_seats > 0 or progressives_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-progressive">[+ progressives_party_name +]</span><span>[+ election_2023_young_left_vote +]%</span><b>[+ young_left_seats +]</b><span>breakaway committee</span></div>?]
[? if razem_party_seats > 0 or razem_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-razem">Razem</span><span>[+ election_2023_razem_vote +]%</span><b>[+ razem_party_seats +]</b><span>independent committee</span></div>?]
[? if pps_party_seats > 0 or pps_party_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-pps">PPS</span><span>[+ election_2023_pps_vote +]%</span><b>[+ pps_party_seats +]</b><span>independent committee</span></div>?]
[? if centrum_seats > 0 or unia_centrum_formed = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-centrum">Unia Centrum</span><span>[+ election_2023_centrum_vote +]%</span><b>[+ centrum_seats +]</b><span>PL2050 split</span></div>?]
[? if rozwoj_seats > 0 or pis_split = 1: <div class="election-table-row election-tree-row--committee"><span class="party party-rozwoj">Rozwój Plus</span><span>[+ election_2023_rozwoj_vote +]%</span><b>[+ rozwoj_seats +]</b><span>PiS split</span></div>?]
[? if korona_seats > 0 or far_right_split > 0: <div class="election-table-row election-tree-row--committee"><span class="party party-korona">Korona</span><span>[+ election_2023_korona_vote +]%</span><b>[+ korona_seats +]</b><span>Konfederacja split</span></div>?]
<div class="election-table-row election-tree-row--committee election-tree-row--right"><span class="party party-konf">Konfederacja</span><span>[+ election_2023_konf_vote +]%</span><b>[+ konf_seats +]</b><span>one certified committee</span></div>
[? if result_member_nowa_nadzieja_sejm > 0: <div class="election-table-row election-tree-row--child"><span class="party party-konf">[+ result_member_nowa_nadzieja_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_nowa_nadzieja_sejm +]</b><span>member party</span></div>?]
[? if result_member_ruch_narodowy_sejm > 0: <div class="election-table-row election-tree-row--child"><span class="party party-konf">[+ result_member_ruch_narodowy_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ruch_narodowy_sejm +]</b><span>member party</span></div>?]
[? if result_member_kkp_sejm > 0: <div class="election-table-row election-tree-row--child"><span class="party party-konf">[+ result_member_kkp_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kkp_sejm +]</b><span>member party</span></div>?]
</div>

Election-day movement: **[+ election_2023_day_shock_summary +]**.

- @sejm_threshold_defeat: Concede the election
- @summary_2023: Read the election summary

@sejm_threshold_defeat
# prose-audit: Grade B — The zero-seat ending is the right idea and its generated components (organisations, chamber, successor cabinet, 2030 horizon) are real prose. The scene around them is assembled from fields, and it closes by printing raw counters — "[+ individual_defections +] individual defections, [+ parliamentary_circles +] parliamentary clubs and [+ organised_left_splits +] organised splits" — under a line admitting they are statistics. An extinction ending should not end on a tally.
title: Epilogue — Out of the Sejm
new-page: true
face-image: img/poland/cards/campaigning.webp
view-if: left_seats = 0 and election_2027_terminal = 0
game-over: true
on-arrival: {!
Q.game_over = 1;
