[? if far_right_split > 0: <div class="election-table-row"><span class="party party-korona">Korona</span><span>[+ korona_vote_intent +]%</span><b>[+ korona_projected_seats +]</b><span>separate</span></div>?]
[? if third_way_joint_list = 0: <div class="election-table-row"><span class="party party-psl">PSL</span><span>[+ psl_vote_intent +]%</span><b>[+ psl_projected_seats +]</b><span>[+ psl_org_resources +]</span></div>?]
<div class="election-table-row"><span class="party party-konf">Konfederacja</span><span>[+ konf_vote_intent +]%</span><b>[+ konf_projected_seats +]</b><span>[+ konf_org_resources +]</span></div>
</div>

