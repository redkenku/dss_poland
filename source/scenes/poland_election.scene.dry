[? if sld_breakaway_seats > 0 or barons_party_formed = 1: <div class="election-table-row"><span class="party party-sld">[+ barons_party_name +]</span><span>[+ election_2023_sld_breakaway_vote +]%</span><b>[+ sld_breakaway_seats +]</b><span>breakaway</span></div>?]
[? if social_patriot_seats > 0 or social_patriot_party_formed = 1: <div class="election-table-row"><span class="party party-social-patriot">[+ social_patriot_party_name +]</span><span>[+ election_2023_social_patriot_vote +]%</span><b>[+ social_patriot_seats +]</b><span>[? if social_patriot_list_committee = "pis": PiS host list?][? if social_patriot_list_committee != "pis": independent?]</span></div>?]
[? if spring_breakaway_seats > 0 or spring_party_formed = 1: <div class="election-table-row"><span class="party party-wiosna">[+ spring_party_name +]</span><span>[+ election_2023_spring_breakaway_vote +]%</span><b>[+ spring_breakaway_seats +]</b><span>breakaway</span></div>?]
[? if labor_left_seats > 0 or labor_party_formed = 1: <div class="election-table-row"><span class="party party-left-labor">[+ labor_party_name +]</span><span>[+ election_2023_labor_left_vote +]%</span><b>[+ labor_left_seats +]</b><span>breakaway</span></div>?]
[? if young_left_seats > 0 or progressives_party_formed = 1: <div class="election-table-row"><span class="party party-progressive">[+ progressives_party_name +]</span><span>[+ election_2023_young_left_vote +]%</span><b>[+ young_left_seats +]</b><span>breakaway</span></div>?]
[? if razem_party_seats > 0 or razem_party_formed = 1: <div class="election-table-row"><span class="party party-razem">Razem</span><span>[+ election_2023_razem_vote +]%</span><b>[+ razem_party_seats +]</b><span>independent list</span></div>?]
[? if pps_party_seats > 0 or pps_party_formed = 1: <div class="election-table-row"><span class="party party-pps">PPS</span><span>[+ election_2023_pps_vote +]%</span><b>[+ pps_party_seats +]</b><span>independent list</span></div>?]
[? if centrum_seats > 0 or unia_centrum_formed = 1: <div class="election-table-row"><span class="party party-centrum">Unia Centrum</span><span>[+ election_2023_centrum_vote +]%</span><b>[+ centrum_seats +]</b><span>PL2050 split</span></div>?]
[? if rozwoj_seats > 0 or pis_split = 1: <div class="election-table-row"><span class="party party-rozwoj">Rozwój Plus</span><span>[+ election_2023_rozwoj_vote +]%</span><b>[+ rozwoj_seats +]</b><span>PiS split</span></div>?]
[? if korona_seats > 0 or far_right_split > 0: <div class="election-table-row"><span class="party party-korona">Korona</span><span>[+ election_2023_korona_vote +]%</span><b>[+ korona_seats +]</b><span>Konf. split</span></div>?]
<div class="election-table-row"><span class="party party-konf">Konfederacja</span><span>[+ election_2023_konf_vote +]%</span><b>[+ konf_seats +]</b><span>certified</span></div>
</div>

