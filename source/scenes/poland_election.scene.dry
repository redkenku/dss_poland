[? if sejm_list_has_partners: <div class="election-table-row"><span class="party party-lewica">[+ sejm_list_target +]</span><span>[+ left_committee_poll_display +]%</span><b>[+ left_filed_committee_projected_seats +]</b><span>[? if sejm_electoral_system = "fptp_460": district candidate pact?][? if sejm_electoral_system != "fptp_460": [+ sejm_list_threshold +]% committee?]</span></div>?]
[? if right_2027_committee_projected_seats > 0: <div class="election-table-row"><span class="party party-prawica">Prawica</span><span>[+ right_2027_poll_display +]%</span><b>[+ right_2027_committee_projected_seats +]</b><span>[? if sejm_electoral_system = "fptp_460": district candidate pact · component nominees?][? if sejm_electoral_system != "fptp_460": 8% coalition threshold · component seats allocated?]</span></div>?]
[? if common_centre_2027_committee_projected_seats > 0: <div class="election-table-row"><span class="party party-ko">Wspólne Centrum 2027</span><span>[+ common_centre_2027_poll_display +]%</span><b>[+ common_centre_2027_committee_projected_seats +]</b><span>one coalition list · autonomous components</span></div>?]
[? if third_way_2027_committee_projected_seats > 0: <div class="election-table-row"><span class="party party-third-way">Trzecia Droga 2027</span><span>[+ third_way_2027_poll_display +]%</span><b>[+ third_way_2027_committee_projected_seats +]</b><span>one permanent coalition list</span></div>?]
[? if right_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-pis">PiS</span><span>[+ pis_vote_intent_display +]%</span><b>[+ pis_projected_seats +]</b><span>party list</span></div>?]
[? if common_centre_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-ko">KO</span><span>[+ ko_vote_intent_display +]%</span><b>[+ ko_projected_seats +]</b><span>party list</span></div>?]
[? if third_way_joint_list = 1 and third_way_2027_committee_projected_seats = 0 and common_centre_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-third-way">[+ third_way_display_name +]</span><span>[+ third_way_vote_intent_display +]%</span><b>[+ third_way_projected_seats +]</b><span>[? if sejm_electoral_system = "fptp_460": joint district pact?][? if sejm_electoral_system != "fptp_460": 8% coalition?]</span></div>?]
[? if third_way_joint_list = 0 and p2050_emerged = 1 and common_centre_2027_committee_projected_seats = 0 and third_way_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-p2050">Polska 2050</span><span>[+ p2050_vote_intent_display +]%</span><b>[+ p2050_projected_seats +]</b><span>party list</span></div>?]
<div class="election-table-row"><span class="party party-lewica">[+ left_party_name +]</span><span>[+ left_vote_intent_display +]%</span><b>[+ left_projected_seats +]</b><span>[? if not sejm_list_has_partners: host list?][? if sejm_list_has_partners: component share?]</span></div>
[? if barons_party_formed = 1: <div class="election-table-row"><span class="party party-sld">[+ barons_party_name +]</span><span>[+ sld_breakaway_vote_intent_display +]%</span><b>[+ sld_breakaway_projected_seats +]</b><span>separate</span></div>?]
[? if social_patriot_party_formed = 1: <div class="election-table-row"><span class="party party-social-patriot">[+ social_patriot_party_name +]</span><span>[+ social_patriot_vote_intent_display +]%</span><b>[+ social_patriot_projected_seats +]</b><span>[? if social_patriot_list_committee = "pis": PiS host list?][? if social_patriot_list_committee != "pis": independent?]</span></div>?]
[? if spring_party_formed = 1: <div class="election-table-row"><span class="party party-wiosna">[+ spring_party_name +]</span><span>[+ spring_breakaway_component_vote_intent_display +]%</span><b>[+ spring_breakaway_projected_seats +]</b><span>[? if spring_list_committee = "left": Lewica host?][? if spring_list_committee = "razem": Razem list?][? if spring_list_committee = "left_coalition": Left coalition?][? if spring_list_committee = "spring_breakaway": separate?]</span></div>?]
[? if labor_party_formed = 1: <div class="election-table-row"><span class="party party-left-labor">[+ labor_party_name +]</span><span>[+ labor_left_component_vote_intent_display +]%</span><b>[+ labor_left_projected_seats +]</b><span>[? if labor_list_committee = "left": Lewica host?][? if labor_list_committee = "razem": Razem list?][? if labor_list_committee = "left_coalition": Left coalition?][? if labor_list_committee = "labor_left": separate?]</span></div>?]
[? if progressives_party_formed = 1: <div class="election-table-row"><span class="party party-progressive">[+ progressives_party_name +]</span><span>[+ young_left_component_vote_intent_display +]%</span><b>[+ young_left_projected_seats +]</b><span>[? if progressives_list_committee = "left": Lewica host?][? if progressives_list_committee = "razem": Razem list?][? if progressives_list_committee = "left_coalition": Left coalition?][? if progressives_list_committee = "young_left": separate?]</span></div>?]
[? if razem_party_formed = 1: <div class="election-table-row"><span class="party party-razem">Razem</span><span>[+ razem_component_vote_intent_display +]%</span><b>[+ razem_projected_seats +]</b><span>[? if razem_list_committee = "left_coalition": Left coalition?][? if razem_list_committee = "razem" and sejm_list_outcome = "razem_5": host list?][? if razem_list_committee = "razem" and sejm_list_outcome != "razem_5": separate?]</span></div>?]
[? if tak_dla_rozwoju_party_formed = 1: <div class="election-table-row"><span class="party party-tak-rozwoj">[+ tak_rozwoj_party_name +]</span><span>[+ tak_rozwoj_component_vote_intent_display +]%</span><b>[+ tak_rozwoj_projected_seats +]</b><span>[? if prawica_member_tak_rozwoj: Prawica component?][? if not prawica_member_tak_rozwoj: separate?]</span></div>?]
[? if kukiz_left_kp = 1 and kukiz_active = 1: <div class="election-table-row"><span class="party party-kukiz">Kukiz'15</span><span>[+ kukiz_vote_intent +]%</span><b>[+ kukiz_projected_seats +]</b><span>[? if kukiz_list_committee = "right_2027": Prawica component?][? if kukiz_list_committee = "pis": PiS host list?][? if kukiz_list_committee = "psl": Koalicja Polska?][? if kukiz_list_committee = "kukiz": independent?]</span></div>?]
[? if (porozumienie_exit_done = 1 or prawica_member_porozumienie = 1) and porozumienie_active = 1: <div class="election-table-row"><span class="party party-agreement">Porozumienie</span><span>[+ porozumienie_vote_intent +]%</span><b>[+ porozumienie_projected_seats +]</b><span>[? if porozumienie_list_committee = "right_2027": Prawica component?][? if porozumienie_list_committee = "third_way": Third Way list?][? if porozumienie_list_committee = "ko": KO host list?][? if porozumienie_list_committee = "porozumienie": independent?]</span></div>?]
[? if prawica_member_suwerenna: <div class="election-table-row"><span class="party party-solidary-poland">Solidarna / Suwerenna Polska</span><span>[+ suwerenna_component_vote_intent_display +]%</span><b>[+ suwerenna_projected_seats +]</b><span>Prawica component</span></div>?]
[? if prawica_member_republikanie: <div class="election-table-row"><span class="party party-republicans">Partia Republikańska</span><span>[+ republikanie_component_vote_intent_display +]%</span><b>[+ republikanie_projected_seats +]</b><span>Prawica component</span></div>?]
[? if prawica_member_odnowa: <div class="election-table-row"><span class="party party-odnowa">OdNowa RP</span><span>[+ odnowa_component_vote_intent_display +]%</span><b>[+ odnowa_projected_seats +]</b><span>Prawica component</span></div>?]
[? if prawica_member_ko_splinter: <div class="election-table-row"><span class="party party-ko">[+ ko_splinter_name +]</span><span>[+ ko_splinter_component_vote_intent_display +]%</span><b>[+ ko_splinter_projected_seats +]</b><span>Prawica component</span></div>?]
[? if pps_party_formed = 1: <div class="election-table-row"><span class="party party-pps">PPS</span><span>[+ pps_vote_intent_display +]%</span><b>[+ pps_projected_seats +]</b><span>separate</span></div>?]
[? if unia_centrum_formed = 1 and common_centre_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-centrum">Unia Centrum</span><span>[+ centrum_vote_intent_display +]%</span><b>[+ centrum_projected_seats +]</b><span>separate</span></div>?]
[? if pis_split = 1: <div class="election-table-row"><span class="party party-rozwoj">Rozwój Plus</span><span>[+ rozwoj_vote_intent_display +]%</span><b>[+ rozwoj_projected_seats +]</b><span>separate</span></div>?]
[? if far_right_split > 0: <div class="election-table-row"><span class="party party-korona">Korona</span><span>[+ korona_vote_intent_display +]%</span><b>[+ korona_projected_seats +]</b><span>separate</span></div>?]
[? if new_hope_projected_seats > 0 and right_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-konf">Nowa Nadzieja</span><span>[+ new_hope_component_vote_intent_display +]%</span><b>[+ new_hope_projected_seats +]</b><span>separate list</span></div>?]
[? if national_movement_projected_seats > 0 and right_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-konf">Ruch Narodowy</span><span>[+ national_movement_component_vote_intent_display +]%</span><b>[+ national_movement_projected_seats +]</b><span>separate list</span></div>?]
[? if duda_projected_seats > 0: <div class="election-table-row"><span class="party party-pis">Ruch Dudy</span><span>[+ duda_component_vote_intent_display +]%</span><b>[+ duda_projected_seats +]</b><span>component allocation</span></div>?]
[? if social_conservative_projected_seats > 0: <div class="election-table-row"><span class="party party-pis">Konserwatyści społeczni</span><span>[+ social_conservative_component_vote_intent_display +]%</span><b>[+ social_conservative_projected_seats +]</b><span>component allocation</span></div>?]
[? if p0_formed = 1: <div class="election-table-row"><span class="party party-p0">[+ p0_name +]</span><span>[+ p0_vote_intent_display +]%</span><b>[+ p0_projected_seats +]</b><span>[? if prawica_member_p0: Prawica component?][? if not prawica_member_p0: separate?]</span></div>?]
[? if third_way_joint_list = 0 and common_centre_2027_committee_projected_seats = 0 and third_way_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-psl">PSL</span><span>[+ psl_vote_intent_display +]%</span><b>[+ psl_projected_seats +]</b><span>party list</span></div>?]
[? if right_2027_committee_projected_seats = 0: <div class="election-table-row"><span class="party party-konf">Konfederacja</span><span>[+ konf_vote_intent_display +]%</span><b>[+ konf_projected_seats +]</b><span>party list</span></div>?]
</div>

<div class="coalition-option [? if coalition_democratic_seats >= 231: viable?]"><span>KO · Poland 2050 · PSL · Lewica</span><b>[+ coalition_democratic_seats +]</b><small>[? if coalition_democratic_seats >= 231: possible majority?][? if coalition_democratic_seats < 231: short of 231?]</small></div>
<div class="coalition-option [? if coalition_center_seats + left_committed_projected_seats >= 231: viable?]"><span>KO · Poland 2050 · PSL · Lewica support</span><b>[+ coalition_center_seats + left_committed_projected_seats +]</b><small>formal centre plus Left confidence</small></div>
<div class="coalition-option [? if ko_projected_seats + psl_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>KO · PSL · Lewica</span><b>[+ ko_projected_seats + psl_projected_seats + left_committed_projected_seats +]</b><small>Poland 2050 outside government</small></div>
<div class="coalition-option [? if ko_projected_seats + p2050_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>KO · Poland 2050 · Lewica</span><b>[+ ko_projected_seats + p2050_projected_seats + left_committed_projected_seats +]</b><small>PSL outside government</small></div>
<div class="coalition-option [? if ko_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>KO · Lewica</span><b>[+ ko_projected_seats + left_committed_projected_seats +]</b><small>[? if ko_projected_seats + left_committed_projected_seats >= 231: self-sufficient majority?][? if ko_projected_seats + left_committed_projected_seats < 231: outside support required?]</small></div>
<div class="coalition-option [? if p2050_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>Poland 2050 · Lewica</span><b>[+ p2050_projected_seats + left_committed_projected_seats +]</b><small>[? if p2050_projected_seats + left_committed_projected_seats >= 231: majority without KO or PSL?][? if p2050_projected_seats + left_committed_projected_seats < 231: short of 231?]</small></div>
<div class="coalition-option [? if psl_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>PSL · Lewica</span><b>[+ psl_projected_seats + left_committed_projected_seats +]</b><small>[? if psl_projected_seats + left_committed_projected_seats >= 231: majority without KO or Poland 2050?][? if psl_projected_seats + left_committed_projected_seats < 231: short of 231?]</small></div>
<div class="coalition-option [? if p2050_projected_seats + psl_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>Third Way · Lewica</span><b>[+ p2050_projected_seats + psl_projected_seats + left_committed_projected_seats +]</b><small>[? if p2050_projected_seats + psl_projected_seats + left_committed_projected_seats >= 231: majority without KO?][? if p2050_projected_seats + psl_projected_seats + left_committed_projected_seats < 231: short of 231 before outside support?]</small></div>
<div class="coalition-option [? if coalition_right_seats >= 231: viable?]"><span>PiS · Konfederacja</span><b>[+ coalition_right_seats +]</b><small>[? if coalition_right_seats >= 231: possible majority?][? if coalition_right_seats < 231: short of 231?]</small></div>
<div class="coalition-option [? if coalition_right_seats + p2050_projected_seats + psl_projected_seats >= 231: viable?]"><span>PiS · Konfederacja · Third Way</span><b>[+ coalition_right_seats + p2050_projected_seats + psl_projected_seats +]</b><small>Third Way split or toleration required</small></div>
<div class="coalition-option [? if pis_projected_seats + left_committed_projected_seats >= 231: viable?]"><span>PiS · Lewica</span><b>[+ pis_projected_seats + left_committed_projected_seats +]</b><small>exploratory cross-party pact</small></div>
<div class="coalition-option [? if p2050_projected_seats + psl_projected_seats + left_committed_projected_seats + pis_projected_seats >= 231: viable?]"><span>Poland 2050 · PSL · Lewica · PiS toleration</span><b>[+ p2050_projected_seats + psl_projected_seats + left_committed_projected_seats +]</b><small>cabinet seats shown; [+ pis_projected_seats +] PiS votes tolerate from outside</small></div>
<div class="coalition-option [? if coalition_pis_psl_seats >= 231: viable?]"><span>PiS · PSL</span><b>[+ coalition_pis_psl_seats +]</b><small>[? if coalition_pis_psl_seats >= 231: possible majority?][? if coalition_pis_psl_seats < 231: short of 231?]</small></div>

- @poland_hub: Continue into the election campaign
