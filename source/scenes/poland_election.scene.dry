title: Elections

@presidential_2020
title: Presidential election
new-page: true
go-to: poland_presidential_election.setup if pres_first_round_complete = 0; poland_presidential_election.runoff_setup if pres_first_round_complete = 1 and pres_first_round_majority = 0 and pres_runoff_complete = 0; poland_presidential_election.majority_confirmation if pres_first_round_majority = 1; poland_presidential_election.runoff_consequences if pres_runoff_complete = 1 and pres_first_round_majority = 0

@results_2023
title: 2023 Sejm election
new-page: true
on-arrival: {!
Q.election_2023_seen = 1;
const leftFamilySeatCeiling =
    Q.left_seats + Q.sld_breakaway_seats + Q.social_patriot_seats +
    Q.spring_breakaway_seats +
    Q.labor_left_seats + Q.young_left_seats +
    Q.razem_party_seats + Q.pps_party_seats + Q.tak_rozwoj_seats;
if (
    !Number.isFinite(Number(Q.left_committed_seats)) ||
    Q.left_committed_seats < Q.left_seats ||
    Q.left_committed_seats > leftFamilySeatCeiling
) {
    Q.left_splinter_support_votes =
        (Q.barons_party_relation >= 45 ? Q.sld_breakaway_seats : 0) +
        (Q.social_patriot_list_committee != "pis" &&
            Q.social_patriot_party_relation >= 45
            ? Q.social_patriot_seats : 0) +
        (Q.spring_party_relation >= 45 ? Q.spring_breakaway_seats : 0) +
        (Q.labor_party_relation >= 45 ? Q.labor_left_seats : 0) +
        (Q.progressives_party_relation >= 45 ? Q.young_left_seats : 0) +
        (Q.razem_party_relation >= 45 ? Q.razem_party_seats : 0) +
        (Q.pps_party_relation >= 45 ? Q.pps_party_seats : 0) +
        (Q.tak_rozwoj_parent_relation >= 45 ? Q.tak_rozwoj_seats : 0);
    Q.left_committed_seats =
        Q.left_seats + Q.left_splinter_support_votes;
}
Q.coalition_democratic_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats +
    Q.centrum_seats + Q.left_committed_seats;
Q.coalition_center_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats + Q.centrum_seats;
Q.coalition_right_seats =
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats +
    (Q.social_patriot_list_committee == "pis"
        ? Q.social_patriot_seats : 0);
Q.coalition_pis_psl_seats = Q.pis_seats + Q.psl_seats +
    (Q.social_patriot_list_committee == "pis"
        ? Q.social_patriot_seats : 0);
Q.news_headline =
    "The election produces " + Q.coalition_democratic_seats +
    " democratic seats";
!}
on-display: {!
const data = [];
const certifiedParties = [
    ["pis", "PiS", "PiS", Q.pis_seats],
    ["konf", "Konf.", "Konfederacja", Q.konf_seats],
    ["ko", "KO", "KO", Q.ko_seats],
    ["left", "NL", Q.left_party_name || "Lewica", Q.left_seats],
    ["sld_breakaway", "SLD", Q.barons_party_name, Q.sld_breakaway_seats],
    ["social_patriot", "LP", Q.social_patriot_party_name, Q.social_patriot_seats],
    ["spring_breakaway", "Spring", Q.spring_party_name, Q.spring_breakaway_seats],
    ["labor_left", "Labour", Q.labor_party_name, Q.labor_left_seats],
    ["young_left", "Young", Q.progressives_party_name, Q.young_left_seats],
    ["razem", "Razem", Q.razem_party_name, Q.razem_party_seats],
    ["pps", "PPS", Q.pps_party_name, Q.pps_party_seats],
    ["centrum", "Centrum", "Unia Centrum", Q.centrum_seats],
    ["rozwoj", "Rozwój+", "Rozwój Plus", Q.rozwoj_seats],
    ["korona", "Korona", "Korona", Q.korona_seats],
    ["other", "Inni", "Inni", Q.other_seats]
];
if (Q.third_way_split) {
    certifiedParties.splice(
        2,
        0,
        ["psl", "PSL", "PSL", Q.psl_seats],
        ["p2050", "PL2050", "Polska 2050", Q.p2050_seats]
    );
} else {
    certifiedParties.splice(
        2,
        0,
        [
            "third_way",
            "Third Way",
            "Trzecia Droga",
            Q.psl_seats + Q.p2050_seats
        ]
    );
}
for (const party of certifiedParties) {
    if (party[3] > 0) {
        data.push({
            id: party[0],
            legend: party[1],
            name: party[2],
            seats: party[3]
        });
    }
}
if (
    typeof window !== "undefined" &&
    typeof d3 !== "undefined" &&
    document.getElementById("poland-sejm")
) {
    let width = 500;
    let height = 500;
    const content = document.getElementById("content");
    if (content && content.offsetWidth < 450) {
        width = Math.max(260, content.offsetWidth - 30);
        height = width;
        document.getElementById("poland-sejm").style.height =
            Math.round(width / 2) + "px";
    }
    const parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#poland-sejm").datum(data).call(parliament);
}
!}

