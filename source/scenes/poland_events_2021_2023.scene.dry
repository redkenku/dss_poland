@may_2023
title: Lex Tusk
new-page: true
on-arrival: {!
const finiteLex = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const lexRightsFit = (
    finiteLex(Q.ko_accept_rights, 55) +
    finiteLex(Q.psl_accept_rights, 34) +
    finiteLex(Q.p2050_accept_rights, 49)
) / 3;
const lexOrderFit = (
    finiteLex(Q.ko_accept_order, 51) +
    finiteLex(Q.psl_accept_order, 57) +
    finiteLex(Q.p2050_accept_order, 49)
) / 3;
const lexOpenness = (
    finiteLex(Q.ko_coalition_openness, 52) +
    finiteLex(Q.psl_coalition_openness, 36) +
    finiteLex(Q.p2050_coalition_openness, 48)
) / 3;
Q.lex_tusk_common_front_open =
    lexRightsFit >= 38 &&
    lexOrderFit >= 42 &&
    lexOpenness >= 38 ? 1 : 0;
Q.lex_tusk_relation_payoff = Math.max(
    1,
    Math.min(
        6,
        Math.round((lexRightsFit + lexOrderFit + lexOpenness - 85) / 18)
    )
);
Q.lex_tusk_2023_done = 1;
Q.institutional_issue_salience += 9;
Q.news_headline = "The Russian-influence commission unifies the opposition";
!}

