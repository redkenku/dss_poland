const finiteBudget22 = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const budget22GovernmentFit = (
    finiteBudget22(Q.pis_accept_social, 49) +
    finiteBudget22(Q.pis_accept_order, 68) +
    finiteBudget22(Q.pis_coalition_openness, 25)
) / 3;
const budget22SecurityFit = (
    finiteBudget22(Q.ko_accept_order, 52) +
    finiteBudget22(Q.psl_accept_order, 62) +
    finiteBudget22(Q.p2050_accept_order, 52) +
    finiteBudget22(Q.ko_coalition_openness, 50) +
    finiteBudget22(Q.p2050_coalition_openness, 46)
) / 5;
Q.budget22_pis_deal_open = budget22GovernmentFit >= 39 ? 1 : 0;
Q.budget22_security_front_open = budget22SecurityFit >= 45 ? 1 : 0;
Q.budget22_pis_relation_payoff = Math.max(
    2,
    Math.min(7, Math.round((budget22GovernmentFit - 22) / 5))
);
Q.budget22_security_payoff = Math.max(
    1,
    Math.min(5, Math.round((budget22SecurityFit - 30) / 7))
);
Q.budget_2022_done = 1;
Q.next_budget_label = "December 2023";
Q.annual_budget_year = 2022;
Q.annual_budget_left_cabinet_authority =
    Q.left_in_government && Q.government_party == "pis" ? 1 : 0;
if (Q.annual_budget_left_cabinet_authority) {
    Q.budget = Math.max(3, Number(Q.budget) || 0);
    Q.budget_authority =
        "Third Morawiecki Cabinet — negotiated social-policy capacity";
} else {
    Q.budget = 0;
    Q.budget_authority = "Opposition — no state spending authority";
}
!}
