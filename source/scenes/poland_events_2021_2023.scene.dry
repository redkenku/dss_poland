    (Number(Q.anti_establishment_youth_konf_affinity) || 0) +
    (trustedVaccination ? 1 : 2);
Q.far_right_agenda += trustedVaccination ? 1 : 3;
Q.news_headline =
    "Gowin leaves government as Konfederacja recruits from pandemic anger";
!}

