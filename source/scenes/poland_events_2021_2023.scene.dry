    Q.budget21_opposition_relation_payoff - 1
);
Q.pis_relation -= 5;
Q.united_right_cohesion -= 5;
Q.public_trust += 1;
!}
go-to: budget_2021_ratification

@budget21_fragments
title: Let every current file its own amendments
