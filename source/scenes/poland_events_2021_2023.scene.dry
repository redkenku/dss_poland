    "gawkowski",
    "nowicka",
    "wieczorek",
    "czarzasty"
];
const countRoster = function() {
    return roster.reduce(function(total, advisor) {
        return total + (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
    }, 0);
};
while (countRoster() > 3) {
    const cut = cutOrder.find(function(advisor) {
        return Number(Q[advisor + "_advisor"]) === 1;
    });
    if (!cut) {
        break;
    }
    Q[cut + "_advisor"] = 0;
}
Q.n_advisors = countRoster();
Q.advisor_slot_2 = Number(Q.czarzasty_advisor) === 1
    ? "czarzasty"
    : (Number(Q.wieczorek_advisor) === 1 ? "wieczorek" : "");
Q.advisor_slot_3 = [
