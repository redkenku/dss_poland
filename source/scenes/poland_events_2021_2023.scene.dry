    115,
    Q.aug21_vonc_left_sponsors
);
Q.constructive_yes = Math.min(
    Math.max(
        0,
        (Number(Q.sejm_total) || 460) -
            Math.max(0, Math.round(Number(Q.pis_seats) || 0))
    ),
    Q.aug21_vonc_democratic_base +
        Q.aug21_vonc_porozumienie_support +
        Q.aug21_vonc_other_support
);
Q.constructive_no = Math.max(0, Math.round(Number(Q.pis_seats) || 0));
Q.constructive_abstain = Math.max(
    0,
    (Number(Q.sejm_total) || 460) -
        Q.constructive_yes - Q.constructive_no
);
Q.aug21_vonc_initiator = "Lewica";
Q.aug21_vonc_strategy = "Immediate opposition count";
Q.ko_relation += 3;
Q.psl_relation += 4;
Q.pis_relation -= 6;
