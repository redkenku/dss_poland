@budget_2022_ratification
title: The five-caucus vote
new-page: true
call: poland_normalize
on-arrival: {!
const clamp22 = value => Math.max(0, Math.min(100, value));
const common22 =
    41 + Q.party_unity * 0.35 -
    Math.max(0, Q.budget_promises) * 0.65 -
    Q.budget_breaches * 2.5;
const support22 = {
    barons: common22 - Q.barons_dissent * 0.55,
    spring: common22 - Q.spring_dissent * 0.55,
    labor: common22 - Q.labor_dissent * 0.55,
    progressives: common22 - Q.progressives_dissent * 0.55,
    razem: common22 - Q.razem_dissent * 0.55
};
if (Q.budget_2022_package_code == 1) {
    support22.barons += 5;
    support22.spring += 7;
    support22.labor += 13;
    support22.progressives += 10;
    support22.razem += 15;
}
if (Q.budget_2022_package_code == 2) {
    support22.barons += 10;
    support22.spring += 3;
    support22.labor += 4;
    support22.progressives -= 4;
    support22.razem += 2;
}
if (Q.budget_2022_package_code == 3) {
    support22.barons += 12;
    support22.spring += 2;
    support22.labor += 6;
    support22.progressives -= 7;
    support22.razem -= 12;
}
if (Q.budget_2022_package_code == 4) {
    support22.barons += 2;
    support22.spring += 2;
    support22.razem += 2;
}
for (const key of Object.keys(support22)) {
    support22[key] = clamp22(support22[key]);
}
const strength22 =
    Q.barons_strength + Q.spring_strength + Q.labor_strength +
    Q.progressives_strength + Q.razem_strength;
const weighted22 =
    support22.barons * Q.barons_strength +
    support22.spring * Q.spring_strength +
    support22.labor * Q.labor_strength +
    support22.progressives * Q.progressives_strength +
    support22.razem * Q.razem_strength;
Q.budget_2022_backing = Math.round(weighted22 / Math.max(1, strength22));
Q.budget_2022_vetoes = Object.keys(support22).filter(
    key => support22[key] < 35
).length;
Q.budget_2022_ratified =
    Q.budget_2022_package_code != 4 &&
    Q.budget_2022_backing >= 54 &&
    Q.budget_2022_vetoes <= 1 ? 1 : 0;
if (Q.budget_2022_ratified) {
    Q.party_unity += 4;
    Q.public_trust += 2;
    Q.senate_cohesion += 2;
    Q.senate_last_vote = "Common 2023 budget opposition line";
    Q.news_headline = "The Left survives the war budget";
} else {
    Q.party_unity -= Q.budget_2022_backing >= 40 ? 6 : 10;
    Q.public_trust -= 3;
    Q.senate_cohesion -= 3;
    Q.senate_last_vote = "Left caucuses split on the 2023 budget";
    Q.news_headline = "War and inflation break the common budget line";
}
!}

= The count

