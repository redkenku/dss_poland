title: Dated political events
new-page: true
call: poland_normalize
on-arrival: {!
const previousScene = this.state.prevSceneId || "";
const returningFromEvent =
    Q.poland_event_phase == 1 &&
    previousScene != "root" &&
    previousScene != "poland_event_queue" &&
    previousScene.indexOf("poland_event_queue.") != 0;
Q.poland_event_phase = 1;
const queueScene =
    this.game.scenes["poland_event_queue.events_choice"];
const allEventsScene =
    this.game.scenes["poland_event_queue.all_events"];
const compiled = this._compileChoices(queueScene) || [];
const allCompiled = this._compileChoices(allEventsScene) || [];
const rootId = this.state.rootSceneId;
const activeTier = compiled.filter(function(choice) {
    return choice.id !== rootId;
});
const datedEvents = allCompiled.filter(function(choice) {
    return choice.id !== rootId;
});
Q.poland_event_queue_count = datedEvents.length;
Q.poland_event_queue_tier_count = activeTier.length;
Q.poland_event_queue_titles = datedEvents.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_tier_titles = activeTier.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_date = Q.date_label;
Q.poland_event_return_beat = returningFromEvent ? 1 : 0;
!}
go-to: events_choice if poland_event_queue_count > 0; complete if poland_event_queue_count = 0

@afterword
title: The decision lands
new-page: true

= The decision lands

**[+ news_headline +]**

[? if poland_event_queue_count = 0: The file closes. With no other dated
decisions waiting, the leadership can return to the wider campaign.?]
[? if poland_event_queue_count = 1: The immediate response is now part of the
political record. One other dated decision is still waiting on the desk.?]
[? if poland_event_queue_count > 1: The immediate response is now part of the
political record. **[+ poland_event_queue_count +] dated decisions** are still
waiting on the desk.?]

- @afterword_desk
- @afterword_complete

@afterword_desk
title: Return to the events desk
view-if: poland_event_queue_count > 0
go-to: events_choice

@afterword_complete
title: Return to the leadership table
view-if: poland_event_queue_count = 0
go-to: complete

@events_choice
title: Events on the desk
new-page: true

= [+ date_label +] — events on the desk

**Cabinet:** [+ government_name +], led by **[+ prime_minister +]**.  
**President:** [+ president_name +].  
**Lewica's authority:** [+ left_role +].

[? if poland_event_return_beat: **Last decision:** [+ news_headline +]. The
consequence is recorded here without an additional confirmation screen.?]

[? if poland_event_queue_count = 1: One dated decision must be resolved before
the leadership table reopens.?]
[? if poland_event_queue_count > 1: **[+ poland_event_queue_count +] crises
remain in this month.** Resolve every one before the leadership table
reopens.?]
[? if poland_event_queue_count > poland_event_queue_tier_count:
The **[+ poland_event_queue_tier_count +]** most urgent
[? if poland_event_queue_tier_count = 1:issue is?][? if
poland_event_queue_tier_count != 1:issues are?] on the desk now. Lower-priority
files open as soon as this tier is exhausted.?]

- #poland_event

@all_events
title: Every pending event
min-choices: 999

- #poland_event

@complete
title: The desk clears
new-page: true
on-arrival: poland_event_phase = 0; poland_event_queue_count = 0; poland_event_queue_tier_count = 0; poland_event_queue_titles = ""; poland_event_queue_tier_titles = ""; poland_event_months_cleared += 1
go-to: poland_ending.final_assessment if year = 2026 and month = 12; poland_hub if not (year = 2026 and month = 12)
