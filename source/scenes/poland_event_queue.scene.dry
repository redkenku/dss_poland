title: Dated political events
call: poland_normalize
on-arrival: {!
Q.poland_event_phase = 1;
const queueScene =
    this.game.scenes["poland_event_queue.events_choice"];
const allEventsScene =
    this.game.scenes["poland_event_queue.all_events"];
const classScenes = {
    interrupt: this.game.scenes["poland_event_queue.all_interrupt_events"],
    calendar: this.game.scenes["poland_event_queue.all_calendar_events"],
    reactive: this.game.scenes["poland_event_queue.all_reactive_events"]
};
const rootId = this.state.rootSceneId;
const millerAuthorityLive =
    Q.continuous_campaign && Q.left_in_government &&
    Q.government_has_confidence && !Q.caretaker_government &&
    Q.justice_minister_party == "Lewica";
const millerRazemStrong =
    Q.razem_active && Q.left_dominant_current == "razem" &&
    (Number(Q.razem_strength) || 0) >= 23;
if (
    !Q.miller_accountability_done && millerAuthorityLive && millerRazemStrong
) {
    if (
        !Number.isFinite(Number(Q.miller_justice_control_start_time)) ||
        Number(Q.miller_justice_control_start_time) < 0
    ) {
        Q.miller_justice_control_start_time = Number(Q.time) || 0;
        Q.miller_accountability_due_time =
            Q.miller_justice_control_start_time + 3;
    }
} else if (!Q.miller_accountability_done) {
    Q.miller_justice_control_start_time = -1;
    Q.miller_accountability_due_time = -1;
    Q.miller_accountability_pending = 0;
    Q.miller_launch_checked_time = -1;
}
if (
    millerAuthorityLive && millerRazemStrong &&
    !Q.miller_accountability_done && !Q.miller_accountability_pending &&
    Number(Q.time) >= Number(Q.miller_accountability_due_time) &&
    Number(Q.miller_accountability_due_time) >= 0 &&
    Number(Q.miller_launch_checked_time) != Number(Q.time)
) {
    Q.miller_launch_checked_time = Number(Q.time) || 0;
    const guardedEvents = (this._compileChoices(allEventsScene) || [])
        .filter(function(choice) {
            return choice.id !== rootId;
        });
    Q.miller_launch_guard_count = guardedEvents.length;
    Q.miller_launch_guard_titles = guardedEvents.map(function(choice) {
        return choice.title;
    }).join(" · ");
    if (guardedEvents.length === 0) {
        Q.miller_accountability_elapsed_months =
            Number(Q.time) - Number(Q.miller_justice_control_start_time);
        Q.miller_accountability_pending = 1;
    }
}
const allCompiled = this._compileChoices(allEventsScene) || [];
const classEvents = {};
for (const name of ["interrupt", "calendar", "reactive"]) {
    classEvents[name] = (this._compileChoices(classScenes[name]) || [])
        .filter(function(choice) { return choice.id !== rootId; });
}
Q.poland_event_queue_class = classEvents.interrupt.length
    ? "interrupt"
    : (classEvents.calendar.length ? "calendar" :
        (classEvents.reactive.length ? "reactive" : ""));
const compiled = this._compileChoices(queueScene) || [];
const activeTier = compiled.filter(function(choice) {
    return choice.id !== rootId;
});
const datedEvents = allCompiled.filter(function(choice) {
    return choice.id !== rootId;
});
Q.poland_event_queue_count = datedEvents.length;
Q.poland_event_queue_tier_count = activeTier.length;
Q.poland_event_queue_titles = datedEvents.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_tier_titles = activeTier.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_date = Q.date_label;
!}
go-to: events_choice if poland_event_queue_count > 0; complete if poland_event_queue_count = 0

@events_choice
title: Events on the desk
new-page: true

= [+ date_label +]

[? if year > 2026 or (year = 2026 and month > 7): **Scenario horizon:** most
files on this desk are counterfactual projections beyond the July 2026 research
cutoff; any later sourced update is dated explicitly inside its file.?]

[? if poland_event_queue_count = 1: One file has to be dealt with before the
leadership table reopens.?]
[? if poland_event_queue_count > 1: **[+ poland_event_queue_count +]** files
have to be dealt with before the leadership table reopens, and the month does
not lengthen to accommodate them.?]
[? if poland_event_queue_class = "interrupt": **Interrupt file:** an emergency
or terminal constitutional deadline takes precedence. Calendar and reactive
files remain on the desk.?]
[? if poland_event_queue_class = "calendar": **Calendar files:** dated and
deterministic deadlines are handled before reactive files.?]
[? if poland_event_queue_class = "reactive": **Reactive files:** threshold and
pressure events remain after the calendar clears.?]
[? if poland_event_queue_count > poland_event_queue_tier_count:
The rest can wait an hour. [? if poland_event_queue_tier_count = 1:This one
cannot.?][? if poland_event_queue_tier_count != 1:These **[+
poland_event_queue_tier_count +]** cannot.?]?]

- #poland_event_interrupt
- view-if: poland_event_queue_class = "interrupt"
- #poland_event_calendar
- view-if: poland_event_queue_class = "calendar"
- #poland_event_reactive
- view-if: poland_event_queue_class = "reactive"

@all_events
title: Every pending event
min-choices: 999

- #poland_event

@all_interrupt_events
title: Every pending interrupt event
min-choices: 999

- #poland_event_interrupt

@all_calendar_events
title: Every pending calendar event
min-choices: 999

- #poland_event_calendar

@all_reactive_events
title: Every pending reactive event
min-choices: 999

- #poland_event_reactive

@complete
title: The desk clears
new-page: true
on-arrival: poland_event_phase = 0; poland_event_queue_class = ""; poland_event_queue_count = 0; poland_event_queue_tier_count = 0; poland_event_queue_titles = ""; poland_event_queue_tier_titles = ""; poland_event_months_cleared += 1
go-to: poland_scenario_epilogue.legal if year = 2027 and month >= 10; poland_caucus_dynamics.router if not (year = 2027 and month >= 10) and caucus_crisis_dispatchable = 1; poland_hub if not (year = 2027 and month >= 10) and caucus_crisis_dispatchable = 0
