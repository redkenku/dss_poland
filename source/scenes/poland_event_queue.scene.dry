title: Dated political events
call: poland_normalize
on-arrival: {!
Q.poland_event_phase = 1;
const queueScene =
    this.game.scenes["poland_event_queue.events_choice"];
const allEventsScene =
    this.game.scenes["poland_event_queue.all_events"];
const compiled = this._compileChoices(queueScene) || [];
const allCompiled = this._compileChoices(allEventsScene) || [];
const rootId = this.state.rootSceneId;
const activeTier = compiled.filter(function(choice) {
    return choice.id !== rootId;
});
const datedEvents = allCompiled.filter(function(choice) {
    return choice.id !== rootId;
});
Q.poland_event_queue_count = datedEvents.length;
Q.poland_event_queue_tier_count = activeTier.length;
Q.poland_event_queue_titles = datedEvents.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_tier_titles = activeTier.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_event_queue_date = Q.date_label;
!}
go-to: events_choice if poland_event_queue_count > 0; complete if poland_event_queue_count = 0

@events_choice
title: Events on the desk
new-page: true

= [+ date_label +]

[? if left_in_government and caretaker_government = 0: The morning meeting is
held in a ministry rather than a party office, which after eight years in
opposition still catches people out. **[+ prime_minister +]** leads the **[+
government_name +]**; **[+ president_name +]** holds the Palace; our own
standing in the arrangement is **[+ left_role +]**. Everything on the table
today is something we will be answerable for.?]
[? if caretaker_government = 1: **[+ prime_minister +]** is still signing
papers, but only the ones that cannot wait — a caretaker administers and does
not decide. **[+ president_name +]** holds the Palace. Our position is **[+
left_role +]**, which for the moment means less than the parties negotiating
around us think it does.?]
[? if left_in_government = 0 and caretaker_government = 0: We meet where we
have always met, with the advantage and the poverty of opposition: nothing
today is our responsibility and nothing today is ours to decide. **[+
prime_minister +]** leads the **[+ government_name +]** and **[+ president_name
+]** holds the Palace. Our standing is **[+ left_role +]**.?]

[? if poland_event_queue_count = 1: One file has to be dealt with before the
leadership table reopens.?]
[? if poland_event_queue_count > 1: **[+ poland_event_queue_count +]** files
have to be dealt with before the leadership table reopens, and the month does
not lengthen to accommodate them.?]
[? if poland_event_queue_count > poland_event_queue_tier_count:
The rest can wait an hour. [? if poland_event_queue_tier_count = 1:This one
cannot.?][? if poland_event_queue_tier_count != 1:These **[+
poland_event_queue_tier_count +]** cannot.?]?]

- #poland_event

@all_events
title: Every pending event
min-choices: 999

- #poland_event

@complete
title: The desk clears
new-page: true
on-arrival: poland_event_phase = 0; poland_event_queue_count = 0; poland_event_queue_tier_count = 0; poland_event_queue_titles = ""; poland_event_queue_tier_titles = ""; poland_event_months_cleared += 1
go-to: poland_ending.final_assessment if year = 2027 and month >= 10; poland_hub if not (year = 2027 and month >= 10)
