go-to: priority_record

@priority_kpo
title: KPO public investment
view-if: (annual_budget_year = 2024 or annual_budget_year = 2026) and opposition_budget_priority_1_code != 8
on-arrival: opposition_budget_priority_candidate_code = 8; opposition_budget_priority_candidate = "KPO co-financing tied to public investment and milestones"
go-to: priority_record

@priority_razem_promises
title: Razem's written promises
view-if: annual_budget_year = 2024 and opposition_budget_priority_1_code != 12
on-arrival: opposition_budget_priority_candidate_code = 12; opposition_budget_priority_candidate = "the wage, housing and health promises made to Razem"
go-to: priority_record

@priority_education
title: Schools and local services
view-if: annual_budget_year = 2025 and opposition_budget_priority_1_code != 14
