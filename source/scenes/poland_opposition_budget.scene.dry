title: Opposition budget process

@start
title: Open the government's budget file
new-page: true
view-if: annual_budget_left_cabinet_authority = 0
call: poland_normalize
on-arrival: {!
Q.annual_budget_year = Number(Q.annual_budget_year) || Number(Q.year) || 2019;
Q.annual_budget_fiscal_year = Q.annual_budget_year + 1;
Q.opposition_budget_stage = 1;
Q.opposition_budget_priority_count = 0;
Q.opposition_budget_priority_1_code = 0;
Q.opposition_budget_priority_2_code = 0;
Q.opposition_budget_priority_1 = "Not selected";
Q.opposition_budget_priority_2 = "Not selected";
Q.opposition_budget_priority_candidate_code = 0;
Q.opposition_budget_priority_candidate = "Not selected";
Q.opposition_budget_conference_management = "Conference not held";
Q.opposition_budget_conference_code = 0;
Q.opposition_budget_rebel_count = 0;
Q.opposition_budget_named_rebels = "None";
Q.opposition_budget_tactic = "No tactic selected";
Q.opposition_budget_tactic_code = 0;
Q.opposition_budget_amendment_1 = "No amendment filed";
Q.opposition_budget_amendment_2 = "No amendment filed";
Q.opposition_budget_amendment_1_passed = 0;
Q.opposition_budget_amendment_2_passed = 0;
Q.opposition_budget_amendments_passed = 0;
Q.opposition_budget_negotiation_score = 0;
Q.opposition_budget_negotiation_threshold = 0;
Q.annual_budget_passed = 0;
Q.annual_budget_margin = 0;
Q.annual_budget_shortfall = 0;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.annual_budget_government_yes = 0;
Q.annual_budget_government_abstain = 0;
Q.annual_budget_yes = 0;
Q.annual_budget_no = 0;
Q.annual_budget_abstain = 0;

const oppositionYear = Number(Q.annual_budget_year) || 2019;
const oppositionDrafts = {
    2019: {
        title: "PiS's 2020 consolidation budget",
        priorities: "social transfers, revenue centralisation and continuity after the election",
        omissions: "public-sector pay, housing, labour inspection and durable local finance",
        scene: "Finance Minister Tadeusz Kościński brings the first budget of the new term to a chamber PiS still commands. It is written to prove that transfers and a balanced ledger can coexist, and it pays for that proof by holding down public-sector pay and pushing costs onto councils that cannot refuse them.\n\nForty-nine Lewica deputies cannot amend this budget into a different document. They can decide which two failures the country hears about between now and the vote, and whether our name ends up on the bill or on the objection."
    },
    2020: {
        title: "PiS's 2021 pandemic budget",
        priorities: "emergency health spending, anti-crisis shields and central control of recovery",
        omissions: "full sick-pay replacement, council liquidity, housing security and reproductive care",
        scene: "Hospitals are strained, households have lost income, town halls are short of money and the Tribunal's abortion ruling has changed the ground under every social argument. The draft answers with emergency spending routed through the centre, where the Prime Minister's office decides who is rescued and in what order.\n\nThe Left does not control a złoty of it. What we control is the shape of the objection: which two failures we make impossible to ignore, and whether we trade a default no vote for something a nurse, a tenant or a mayor could actually point to."
    },
    2021: {
        title: "PiS's 2022 Polish Deal budget",
        priorities: "the Polish Deal tax settlement, health contributions and discretionary local compensation",
        omissions: "administrative repair, rights safeguards, stable hospital finance and transparent local grants",
        scene: "The budget arrives wrapped around the Polish Deal. Its health-contribution rules have already been rewritten twice, and the compensation promised to local government is discretionary — which is to say it is a grant a minister may withhold from a mayor who campaigned against him.\n\nMorawiecki no longer has a stable majority to pass it with. That does not hand us the treasury, but it does mean the government must count, and counting is the only leverage an opposition budget has ever had."
    },
    2022: {
        title: "PiS's 2023 war-and-inflation budget",
        priorities: "defence, energy shields, refugee support and inflation relief",
        omissions: "a wage floor, long-term refugee services, housing and accountable procurement",
        scene: "Defence procurement, energy shields and refugee support enter the same document as an inflation rate eating every fixed number in it. Nobody in the chamber will vote against the army or against Ukraine, and the government knows it: the contested part is what gets quietly indexed at less than prices, and what gets bought without a published contract.\n\nWe can make the wage floor and the procurement record the price of a calm passage, or leave both to a majority that would rather discuss the front line."
    },
    2023: {
        title: "the inherited 2024 transition budget",
        priorities: "teacher pay, IVF restoration, local-government finance and a rapid public-media transition",
        omissions: "a settled housing programme, durable health staffing and the full equality timetable",
        scene: "The new majority is spending a budget somebody else wrote. PiS drafted the numbers; the transition inherits them along with teacher pay, restored IVF funding and a public-media transfer already being litigated. Amendments must survive a Palace that is not on the coalition's side.\n\nFor Lewica this is the first budget in eight years in which our demands are made from inside the tent — and the first in which failing to deliver them is our record too."
    },
    2024: {
        title: "the coalition's first full 2025 budget",
        priorities: "flood reconstruction, record defence commitments, KPO co-financing and coalition continuity",
        omissions: "Razem's wage, housing and health promises and a funded route after the abortion defeat",
        scene: "Kłodzko and Nysa need rebuilding, defence has a record line, and KPO projects need Polish money before European money will move. Each of those is defensible. Together they crowd out the wage, housing and health commitments the Left signed a coalition agreement to obtain.\n\nRazem is counting. So is every organiser who was told after the abortion defeat that delivery elsewhere would be the compensation."
    },
    2025: {
        title: "the 2026 post-presidential budget",
        priorities: "defence, school reform, coalition survival and accommodation with a hostile Palace",
        omissions: "shorter working time, enforceable collective bargaining, housing delivery and local-service staffing",
        scene: "The presidential result has changed what a budget is for. Ministers are drafting less to govern than to survive: defence and schools because they cannot be attacked, and everything else trimmed to whatever the Palace will not send back.\n\nShorter hours, enforceable bargaining and housing delivery were the reasons the Left is in this cabinet at all. They are now the lines most easily surrendered to keep the cabinet standing."
    },
    2026: {
        title: "the pre-election 2027 budget",
        priorities: "deficit restraint, defence, remaining KPO milestones and pre-election protection of incumbents",
        omissions: "funded Labour Inspection powers, partnership delivery, municipal services and social housing",
        scene: "This is the last full budget before the election, and every party in the chamber is reading it as a campaign document. The deficit line exists to be quoted at doorsteps; the incumbent-friendly local grants exist to be announced in the districts that need them.\n\nLabour inspection, the partnership statute and municipal services are all cheap enough to fund and unglamorous enough to postpone. Whichever of them survives this draft is the one the Left will be able to run on."
    }
};
const oppositionDraft = oppositionDrafts[oppositionYear] || oppositionDrafts[2026];
Q.opposition_budget_draft_title = oppositionDraft.title;
Q.opposition_budget_draft_priorities = oppositionDraft.priorities;
Q.opposition_budget_draft_omissions = oppositionDraft.omissions;
Q.opposition_budget_draft_scene = oppositionDraft.scene;
const oppositionBudgetProfiles = {
    pis: {social: 18.6, defence: 4.9, deficit: 5.8},
    ko: {social: 17.4, defence: 4.8, deficit: 4.5},
    psl: {social: 16.8, defence: 5.0, deficit: 4.0},
    p2050: {social: 16.9, defence: 4.6, deficit: 3.9},
    default: {social: 17.2, defence: 4.7, deficit: 4.6}
};
const roundOppositionShare = function(value) {
    return Math.round(Number(value) * 10) / 10;
};
const oppositionBudgetFrame =
    oppositionBudgetProfiles[Q.government_party] ||
    oppositionBudgetProfiles.default;
Q.annual_budget_draft_social_share =
    roundOppositionShare(oppositionBudgetFrame.social);
Q.annual_budget_draft_defence_share =
    roundOppositionShare(oppositionBudgetFrame.defence);
Q.annual_budget_draft_deficit_share =
    roundOppositionShare(oppositionBudgetFrame.deficit);
Q.annual_budget_social_share = Q.annual_budget_draft_social_share;
Q.annual_budget_defence_share = Q.annual_budget_draft_defence_share;
Q.annual_budget_deficit_share = Q.annual_budget_draft_deficit_share;
Q.annual_budget_projected_balance =
    roundOppositionShare(-Q.annual_budget_deficit_share);
Q.annual_budget_outrageous_support = 0;

const chamberTotal = Math.max(1, Math.round(Number(Q.sejm_total) || 460));
const leftSeats = Math.max(
    0,
    Math.min(chamberTotal, Math.round(Number(Q.left_seats) || 0))
);
let governmentSeats = Math.round(
    Number(Q.government_support_seats) ||
    Number(Q.coalition_seats) || 0
);
const storedGovernmentPreview =
    Math.round(Number(Q.annual_budget_preview_government_yes) || 0) +
    Math.round(Number(Q.annual_budget_preview_government_abstain) || 0);
if (oppositionYear >= 2023 && storedGovernmentPreview > 0) {
    governmentSeats = storedGovernmentPreview;
}
if (governmentSeats <= 0) {
    if (Q.government_party == "pis") {
        governmentSeats = Math.round(Number(Q.pis_seats) || 0);
    } else if (Q.government_party == "ko") {
        governmentSeats =
            Math.round(Number(Q.ko_seats) || 0) +
            Math.round(Number(Q.p2050_seats) || 0) +
            Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "psl") {
        governmentSeats = Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "p2050") {
        governmentSeats = Math.round(Number(Q.p2050_seats) || 0);
    } else {
        governmentSeats = Math.round(
            Number(Q.government_support_seats) || 0
        );
    }
}
governmentSeats = Math.max(
    0,
    Math.min(chamberTotal - leftSeats, governmentSeats)
);
Q.opposition_budget_government_seats = governmentSeats;
Q.opposition_budget_left_seats = leftSeats;
Q.opposition_budget_other_opposition_seats = Math.max(
    0,
    chamberTotal - governmentSeats - leftSeats
);
let previewExternalYes = 0;
let previewExternalAbstain = 0;
const governmentAgreementYes = Q.government_party == "pis"
    ? Math.min(
        Q.opposition_budget_other_opposition_seats,
        oppositionYear >= 2022 ? 3 : 5
    )
    : 0;
const governmentAgreementAbstain = Q.government_party == "pis"
    ? Math.min(
        Math.max(
            0,
            Q.opposition_budget_other_opposition_seats -
                governmentAgreementYes
        ),
        2
    )
    : 0;
previewExternalYes += governmentAgreementYes;
previewExternalAbstain += governmentAgreementAbstain;
Q.opposition_budget_government_agreement_yes = governmentAgreementYes;
Q.opposition_budget_government_agreement_abstain =
    governmentAgreementAbstain;
if (
    Q.government_party != "pis" &&
    (Number(Q.centrum_relation) || 0) >= 55 &&
    (Number(Q.rival_relation_ko_p2050) || 0) >= 50
) {
    previewExternalYes += Math.max(0, Number(Q.centrum_seats) || 0);
}
const previewAlignedSplinters = Math.min(
    Q.opposition_budget_other_opposition_seats,
    Math.max(0, Math.round(Number(Q.left_splinter_support_votes) || 0))
);
previewExternalYes = Math.min(
    Q.opposition_budget_other_opposition_seats - previewAlignedSplinters,
    Math.max(0, Math.round(previewExternalYes))
);
previewExternalAbstain = Math.min(
    Q.opposition_budget_other_opposition_seats -
        previewAlignedSplinters - previewExternalYes,
    Math.max(0, Math.round(previewExternalAbstain))
);
Q.opposition_budget_preview_aligned_splinters = previewAlignedSplinters;
Q.opposition_budget_preview_external_yes = previewExternalYes;
Q.opposition_budget_preview_external_abstain = previewExternalAbstain;
Q.opposition_budget_preview_external_no = Math.max(
    0,
    Q.opposition_budget_other_opposition_seats -
        previewExternalYes - previewExternalAbstain
);
Q.opposition_budget_government_margin = governmentSeats -
    Q.opposition_budget_preview_external_no;
Q.opposition_budget_left_is_pivotal =
    governmentSeats + previewExternalYes <=
        Q.opposition_budget_preview_external_no + leftSeats &&
    governmentSeats + previewExternalYes + previewAlignedSplinters +
        leftSeats >
        Q.opposition_budget_preview_external_no - previewAlignedSplinters
        ? 1 : 0;
if (
    !Number.isFinite(Number(Q.budget_submission_time)) ||
    Number(Q.budget_submission_year) != oppositionYear
) {
    // This scene is the December vote.  The constitutional clock starts with
    // the government's normal end-of-September submission, not tonight.
    Q.budget_submission_time = Math.max(0, (Number(Q.time) || 0) - 3);
    Q.budget_submission_year = oppositionYear;
    Q.budget_submission_month = 9;
    Q.budget_deadline_time = Q.budget_submission_time + 4;
    const deadlineIndex =
        oppositionYear * 12 + Q.budget_submission_month - 1 + 4;
    Q.budget_deadline_year = Math.floor(deadlineIndex / 12);
    Q.budget_deadline_month = deadlineIndex % 12 + 1;
    const deadlineMonths = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ];
    Q.budget_deadline_label =
        deadlineMonths[Q.budget_deadline_month - 1] + " " +
        Q.budget_deadline_year;
}
Q.budget_deadline_active = 1;
!}
go-to: audit if opposition_budget_audit_pending = 1 and opposition_budget_audit_year < annual_budget_year; read_draft if opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year

@audit
title: Prior-year audit — What actually reached public services
new-page: true
view-if: opposition_budget_audit_pending = 1 and opposition_budget_audit_year < annual_budget_year
call: poland_normalize
on-arrival: {!
Q.opposition_budget_stage = 6;
Q.opposition_budget_audit_capacity_gain = 0;
const applyEnactedPriority = function(code) {
    const priorityCode = Number(code) || 0;
    if (priorityCode == 1) {
        Q.household_security += 2;
    } else if (priorityCode == 2 || priorityCode == 7) {
        Q.health_capacity += 2;
    } else if (priorityCode == 3) {
        Q.household_security += 1;
        Q.local_network += 1;
    } else if (priorityCode == 4 || priorityCode == 15) {
        Q.minority_safety += 2;
    } else if (priorityCode == 5 || priorityCode == 11 || priorityCode == 14) {
        Q.local_network += 2;
    } else if (priorityCode == 6) {
        Q.military_trust += 2;
    } else if (priorityCode == 8) {
        Q.government_delivery += 1;
        Q.climate_state_capacity += 1;
    } else if (priorityCode == 9) {
        Q.government_procedural_restraint += 2;
    } else if (priorityCode == 10) {
        Q.refugee_service_capacity += 1;
        Q.energy_security += 1;
    } else if (priorityCode == 12) {
        Q.local_network += 1;
        Q.household_security += 1;
    } else if (priorityCode == 13 || priorityCode == 16) {
        Q.household_security += 1;
        Q.government_delivery += 1;
    }
    if (priorityCode > 0) Q.opposition_budget_audit_capacity_gain += 2;
};
if (Q.opposition_budget_audit_enacted) {
    if (Q.opposition_budget_audit_priority_1_enacted) {
        applyEnactedPriority(Q.opposition_budget_audit_priority_1_code);
    }
    if (Q.opposition_budget_audit_priority_2_enacted) {
        applyEnactedPriority(Q.opposition_budget_audit_priority_2_code);
    }
    Q.government_delivery += Math.max(
        1,
        Number(Q.opposition_budget_audit_priority_1_enacted) +
            Number(Q.opposition_budget_audit_priority_2_enacted)
    );
    Q.opposition_budget_audit_result =
        "Enacted clauses added " + Q.opposition_budget_audit_capacity_gain +
        " public-capacity points";
} else if (Q.opposition_budget_audit_tactic_code == 1) {
    Q.opposition_budget_audit_result =
        "The shadow programme changed political ownership, not public capacity";
} else {
    Q.opposition_budget_audit_result =
        "No enacted Lewica clause changed public capacity";
}
Q.opposition_budget_audit_done = 1;
Q.opposition_budget_audit_pending = 0;
Q.news_headline = Q.opposition_budget_audit_result;
!}

= Fiscal-year [+ opposition_budget_audit_fiscal_year +] accounts

Last year's tactic was **[+ opposition_budget_audit_tactic +]**. The recorded
Lewica clauses were **[+ opposition_budget_audit_amendment_1 +]** and **[+
opposition_budget_audit_amendment_2 +]**.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Delivery audit</div>
<div class="ledger-row"><span>Budget enacted</span><b>[? if opposition_budget_audit_budget_passed: yes?][? if not opposition_budget_audit_budget_passed: no?]</b></div>
<div class="ledger-row"><span>Lewica clause enacted</span><b>[? if opposition_budget_audit_enacted: yes?][? if not opposition_budget_audit_enacted: no?]</b></div>
<div class="ledger-row"><span>Public-capacity gain</span><b>[+ opposition_budget_audit_capacity_gain +]</b></div>
<div class="ledger-row"><span>Finding</span><b>[+ opposition_budget_audit_result +]</b></div></div>

A passed Senate proposal, a press release or a cabinet promise is not counted
as delivery. Only language that survived the final bill changes hospitals,
household security, councils, defence or administrative capacity.

- @audit_continue: Open this year's draft

@audit_continue
go-to: poland_budget_2023_2026.annual_budget if annual_budget_left_cabinet_authority = 1; read_draft if annual_budget_left_cabinet_authority = 0

@read_draft
title: Step 1 of 4 — Read the government draft
new-page: true
on-arrival: opposition_budget_stage = 1

= [+ opposition_budget_draft_title +]

[+ opposition_budget_draft_scene +]

The government's actual priorities are **[+ opposition_budget_draft_priorities
+]**. Its draft leaves **[+ opposition_budget_draft_omissions +]** exposed.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Draft fiscal frame (% of GDP)</div>
<div class="ledger-row"><span>Social spending</span><b>[+ annual_budget_social_share +]%</b></div>
<div class="ledger-row"><span>Defence spending</span><b>[+ annual_budget_defence_share +]%</b></div>
<div class="ledger-row"><span>Deficit</span><b>[+ annual_budget_deficit_share +]%</b></div>
<div class="ledger-subrow">Left and PiS seek higher social; PiS, KO and PSL seek higher defence; KO, PSL and Konfederacja seek lower deficit.</div></div>

<div class="ledger-notice"><b>Your task:</b> choose two demands, settle the
club line, then choose whether to bargain, abstain or oppose. The final screen
will show the cabinet's answer and the actual vote.</div>

<div class="ledger-section ledger-section-first"><div class="ledger-title">What the chamber can do</div>
<div class="ledger-row"><span>Cabinet starts with</span><b>[+ opposition_budget_government_seats +] votes</b></div>
<div class="ledger-row"><span>Lewica controls</span><b>[+ opposition_budget_left_seats +] votes</b></div>
<div class="ledger-row"><span>Are Lewica's votes pivotal?</span><b>[? if opposition_budget_left_is_pivotal: Yes?][? if not opposition_budget_left_is_pivotal: No?]</b></div>
<div class="ledger-row"><span>Passage rule</span><b>More yes than no</b></div></div>

Lewica may amend, bargain, abstain or oppose. It cannot spend a złoty, order a
ministry to implement a promise or treat a shadow programme as enacted law.

- @priorities: Choose two Left priorities

@priorities
title: Step 2 of 4 — Choose two Left priorities
new-page: true

The menu changes with the year's crises. Choose exactly two. The conference
will have to reconcile both; the parliamentary tactic will determine whether
either becomes an amendment, a concession or only a shadow-programme claim.

[? if opposition_budget_priority_count = 0: Nothing selected yet.?]
[? if opposition_budget_priority_count = 1: First demand: **[+ opposition_budget_priority_1 +]**. Choose one more.?]
[? if opposition_budget_priority_count = 2: Demands: **[+ opposition_budget_priority_1 +]** and **[+ opposition_budget_priority_2 +]**.?]

- @priority_wages
- @priority_services
- @priority_housing
- @priority_equality
- @priority_local
- @priority_security
- @priority_pandemic
- @priority_polish_deal
- @priority_energy_refugees
- @priority_transition
- @priority_flood
- @priority_kpo
- @priority_razem_promises
- @priority_education
- @priority_inspection
- @priority_partnerships

@priority_wages
title: Wages and work
view-if: opposition_budget_priority_1_code != 1
on-arrival: {!
Q.opposition_budget_priority_candidate_code = 1;
const wageLabels = {
    2019: "public-sector wages and labour inspection",
    2020: "sick pay and wage replacement",
    2021: "wages protected through the Polish Deal",
    2022: "an inflation-proof wage floor",
    2023: "teacher and public-sector pay",
    2024: "the promised public-sector wage settlement",
    2025: "collective bargaining and shorter working time",
    2026: "enforceable pay and collective agreements"
};
Q.opposition_budget_priority_candidate =
    wageLabels[Q.annual_budget_year] || "wages and work";
!}
go-to: priority_record

@priority_services
title: Health and public services
view-if: opposition_budget_priority_1_code != 2
on-arrival: {!
Q.opposition_budget_priority_candidate_code = 2;
const serviceLabels = {
    2019: "hospital staffing and public services",
    2020: "hospital capacity and safe staffing",
    2021: "stable hospital finance and care",
    2022: "health and public services under inflation",
    2023: "health staffing and IVF delivery",
    2024: "health funding promised to Razem",
    2025: "health staffing after the presidential campaign",
    2026: "protected health and care services"
};
Q.opposition_budget_priority_candidate =
    serviceLabels[Q.annual_budget_year] || "health and public services";
!}
go-to: priority_record

@priority_housing
title: Housing
view-if: annual_budget_year != 2021 and opposition_budget_priority_1_code != 3
on-arrival: opposition_budget_priority_candidate_code = 3; opposition_budget_priority_candidate = "social housing and tenant security"
go-to: priority_record

@priority_equality
title: Equality and care
view-if: annual_budget_year != 2022 and annual_budget_year != 2025 and opposition_budget_priority_1_code != 4
on-arrival: opposition_budget_priority_candidate_code = 4; opposition_budget_priority_candidate = "equality, reproductive care and anti-discrimination services"
go-to: priority_record

@priority_local
title: Local government
view-if: annual_budget_year != 2022 and annual_budget_year != 2024 and opposition_budget_priority_1_code != 5
on-arrival: opposition_budget_priority_candidate_code = 5; opposition_budget_priority_candidate = "predictable local-government finance"
go-to: priority_record

@priority_security
title: Defence and security
view-if: annual_budget_year >= 2021 and opposition_budget_priority_1_code != 6
on-arrival: {!
Q.opposition_budget_priority_candidate_code = 6;
Q.opposition_budget_priority_candidate = Q.annual_budget_year == 2024
    ? "defence readiness without raiding social services"
    : "defence, security and accountable procurement";
!}
go-to: priority_record

@priority_pandemic
title: Pandemic income protection
view-if: annual_budget_year = 2020 and opposition_budget_priority_1_code != 7
on-arrival: opposition_budget_priority_candidate_code = 7; opposition_budget_priority_candidate = "pandemic sick pay, care and income protection"
go-to: priority_record

@priority_polish_deal
title: Repair the Polish Deal
view-if: annual_budget_year = 2021 and opposition_budget_priority_1_code != 9
on-arrival: opposition_budget_priority_candidate_code = 9; opposition_budget_priority_candidate = "a costed Polish Deal repair and transparent grants"
go-to: priority_record

@priority_energy_refugees
title: Energy and refugee services
view-if: annual_budget_year = 2022 and opposition_budget_priority_1_code != 10
on-arrival: opposition_budget_priority_candidate_code = 10; opposition_budget_priority_candidate = "energy relief and durable refugee services"
go-to: priority_record

@priority_transition
title: Transition institutions
view-if: annual_budget_year = 2023 and opposition_budget_priority_1_code != 9
on-arrival: opposition_budget_priority_candidate_code = 9; opposition_budget_priority_candidate = "IVF, public-media and delivery safeguards in the transition"
go-to: priority_record

@priority_flood
title: Flood reconstruction
view-if: annual_budget_year = 2024 and opposition_budget_priority_1_code != 11
