@priority_wages
title: Wages and work
view-if: opposition_budget_priority_1_code != 1
on-arrival: {!
Q.opposition_budget_priority_candidate_code = 1;
const wageLabels = {
    2019: "public-sector wages and labour inspection",
    2020: "sick pay and wage replacement",
    2021: "wages protected through the Polish Deal",
    2022: "an inflation-proof wage floor",
    2023: "teacher and public-sector pay",
    2024: "the promised public-sector wage settlement",
    2025: "collective bargaining and shorter working time",
    2026: "enforceable pay and collective agreements"
};
Q.opposition_budget_priority_candidate =
    wageLabels[Q.annual_budget_year] || "wages and work";
!}
go-to: priority_record

@priority_services
title: Health and public services
view-if: opposition_budget_priority_1_code != 2
on-arrival: {!
Q.opposition_budget_priority_candidate_code = 2;
const serviceLabels = {
    2019: "hospital staffing and public services",
    2020: "hospital capacity and safe staffing",
    2021: "stable hospital finance and care",
    2022: "health and public services under inflation",
    2023: "health staffing and IVF delivery",
    2024: "health funding promised to Razem",
    2025: "health staffing after the presidential campaign",
    2026: "protected health and care services"
};
Q.opposition_budget_priority_candidate =
    serviceLabels[Q.annual_budget_year] || "health and public services";
!}
go-to: priority_record

