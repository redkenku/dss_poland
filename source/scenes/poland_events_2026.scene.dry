Q.rozwoj_association_active = 1;
Q.rozwoj_association_members = 34;
Q.rozwoj_chain_stage = 1;
const association = (Q.rival_group_records || []).find(function(record) {
    return record.id == "rozwoj_plus";
});
if (association) {
    association.active = 1;
    association.legal_status = "political association inside PiS";
    association.organisation = 38;
    association.cohesion = 54;
    association.mp_count = 34;
    association.sejm_mps = 34;
    association.senators = 0;
    association.meps = 3;
    association.defection_readiness = 24;
}
const associationPeople = [
    "morawiecki", "semieniuk", "cieszynski", "jablonski", "kwiecien",
    "bartosik", "lorek", "dworczyk", "muller"
];
for (const person of (Q.rival_person_records || [])) {
    if (associationPeople.includes(person.id)) {
        person.organisation = "rozwoj_plus";
        person.loyalty = "dual PiS and Rozwój+ loyalty";
        person.status = person.chamber == "Sejm"
            ? "PiS MP in Rozwój+ association"
            : "PiS MEP in Rozwój+ association";
    }
}
Q.news_headline = "Rozwój+ turns Morawiecki's network into an association";
!}

