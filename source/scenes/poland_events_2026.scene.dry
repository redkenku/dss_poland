Q.snap_campaign_due_time = Q.snap_campaign_start_time + 1;
Q.snap_campaign_start_year = Number(Q.year) || 0;
Q.snap_campaign_start_month = Number(Q.month) || 0;
Q.snap_campaign_beyond_horizon =
