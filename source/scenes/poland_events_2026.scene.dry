Q.rozwoj_chain_stage = 5;
if (association) {
    association.kind = Q.rozwoj_party_formed ? "party" : "association";
    association.bloc = Q.rozwoj_party_formed ? "rozwoj" : "pis";
    association.parent = Q.rozwoj_party_formed ? "Rozwój+" : association.parent;
    association.allied = Q.rozwoj_party_formed ? 0 : association.allied;
    association.legal_status = Q.rozwoj_party_formed
        ? "registered party with parliamentary club"
        : association.legal_status;
}
if (Q.rozwoj_party_formed) {
    for (const person of (Q.rival_person_records || [])) {
        if (
            person.organisation == "rozwoj_plus" &&
            person.party == "independent"
        ) {
            person.party = "rozwoj";
            person.loyalty = "Rozwój+";
            person.status = "Rozwój+ MP";
        }
    }
}
if (
    Q.rozwoj_party_formed &&
    Q.matysiak_party == "independent" &&
    Q.matysiak_has_sejm_mandate &&
    (Number(Q.other_seats) || 0) > 0
) {
    Q.other_seats -= 1;
    Q.rozwoj_seats = (Number(Q.rozwoj_seats) || 0) + 1;
