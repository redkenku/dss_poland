Q.coalition_right_seats =
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats;
const snapKoPslPledge =
    (Number(Q.rival_relation_ko_psl) || 0) >= 55 &&
    (Number(Q.psl_coalition_dissent) || 0) < 65
        ? Q.psl_seats
        : 0;
const snapKoP2050Pledge =
    (Number(Q.rival_relation_ko_p2050) || 0) >= 55 &&
    (Number(Q.p2050_coalition_dissent) || 0) < 65
        ? Q.p2050_seats
        : 0;
Q.democratic_committed_seats =
    Q.ko_seats + snapKoPslPledge + snapKoP2050Pledge +
    (Q.centrum_relation >= 55 ? Q.centrum_seats : 0);
Q.snap_psl_cabinet_committed = snapKoPslPledge > 0 ? 1 : 0;
Q.snap_p2050_cabinet_committed = snapKoP2050Pledge > 0 ? 1 : 0;
Q.snap_centrum_cabinet_committed =
    Q.centrum_relation >= 55 && Q.centrum_seats > 0 ? 1 : 0;
Q.snap_cabinet_commitments_recorded = 1;
Q.right_committed_seats =
    Q.pis_seats +
    (Q.rival_relation_pis_konf >= 50 ? Q.konf_seats : 0);
Q.seat_subvention_seats = Q.left_seats;
Q.snap_election_complete = 1;
Q.caretaker_government = 1;
Q.government_has_confidence = 0;
Q.news_headline =
    Q.snap_election_cycle > 1
        ? "A fresh second campaign shifts the balance but again fragments the Sejm"
        : "The alternative election returns a fragmented Sejm";
!}

= Alternative Sejm result

[? if snap_election_cycle > 1: This is the **[+ snap_election_cycle +]**th
election in the constitutional sequence. Voters have moved again during the
fresh campaign; the parties do not simply inherit the previous count.?]

**[+ snap_election_day_summary +]**

**Senate:** [+ senate_democratic_seats +] democratic · [+
senate_right_seats +] right-aligned · [+ senate_independent_seats +]
independent. **[+ senate_control +]** under 100 single-member district results.

<div class="election-table">
<div class="election-table-head"><span>Party</span><span></span><span>Seats</span><span></span></div>
<div class="election-table-row"><span class="party party-pis">PiS / loyalist right</span><span></span><b>[+ pis_seats +]</b><span></span></div>
<div class="election-table-row"><span class="party party-ko">KO</span><span></span><b>[+ ko_seats +]</b><span></span></div>
[? if ko_splinter_seats > 0: <div class="election-table-row"><span class="party party-ko">[+ ko_splinter_type +] KO splinter</span><span></span><b>[+ ko_splinter_seats +]</b><span>KO split</span></div>?]
<div class="election-table-row"><span class="party party-lewica">[+ left_party_name +]</span><span></span><b>[+ left_seats +]</b><span>main list</span></div>
[? if sld_breakaway_seats > 0: <div class="election-table-row"><span class="party party-sld">[+ barons_party_name +]</span><span></span><b>[+ sld_breakaway_seats +]</b><span>breakaway</span></div>?]
[? if social_patriot_seats > 0: <div class="election-table-row"><span class="party party-social-patriot">[+ social_patriot_party_name +]</span><span></span><b>[+ social_patriot_seats +]</b><span>[+ social_patriot_electoral_strategy +]</span></div>?]
[? if spring_breakaway_seats > 0: <div class="election-table-row"><span class="party party-wiosna">[+ spring_party_name +]</span><span></span><b>[+ spring_breakaway_seats +]</b><span>breakaway</span></div>?]
[? if labor_left_seats > 0: <div class="election-table-row"><span class="party party-left-labor">[+ labor_party_name +]</span><span></span><b>[+ labor_left_seats +]</b><span>breakaway</span></div>?]
[? if young_left_seats > 0: <div class="election-table-row"><span class="party party-progressive">[+ progressives_party_name +]</span><span></span><b>[+ young_left_seats +]</b><span>breakaway</span></div>?]
[? if razem_party_seats > 0: <div class="election-table-row"><span class="party party-razem">Razem</span><span></span><b>[+ razem_party_seats +]</b><span>independent</span></div>?]
[? if pps_party_seats > 0: <div class="election-table-row"><span class="party party-pps">PPS</span><span></span><b>[+ pps_party_seats +]</b><span>independent</span></div>?]
[? if tak_rozwoj_seats > 0: <div class="election-table-row"><span class="party party-razem">Tak! Dla Rozwoju</span><span></span><b>[+ tak_rozwoj_seats +]</b><span>Matysiak splitter</span></div>?]
<div class="election-table-row"><span class="party party-psl">PSL</span><span></span><b>[+ psl_seats +]</b><span></span></div>
<div class="election-table-row"><span class="party party-p2050">Poland 2050</span><span></span><b>[+ p2050_seats +]</b><span></span></div>
[? if centrum_seats > 0: <div class="election-table-row"><span class="party party-centrum">Unia Centrum</span><span></span><b>[+ centrum_seats +]</b><span>PL2050 split</span></div>?]
<div class="election-table-row"><span class="party party-konf">Konfederacja</span><span></span><b>[+ konf_seats +]</b><span></span></div>
[? if korona_seats > 0: <div class="election-table-row"><span class="party party-korona">Korona</span><span></span><b>[+ korona_seats +]</b><span>Konf. split</span></div>?]
[? if rozwoj_seats > 0: <div class="election-table-row"><span class="party party-rozwoj">Rozwój Plus</span><span></span><b>[+ rozwoj_seats +]</b><span>PiS split</span></div>?]
</div>

- @poland_election.sejm_threshold_defeat: Concede the election
- @snap_resolve_senate_marshal
- @snap_palace_pick

@snap_resolve_senate_marshal
title: Hold the Senate Marshal vote before cabinet formation
view-if: left_seats > 0 and snap_senate_marshal_return = 1 and office_incompatibility_pending = 1
go-to: poland_office_authority.resolve

@snap_senate_marshal_resume
on-arrival: snap_senate_marshal_return = 0
go-to: snap_palace_pick

@snap_palace_pick
title: The President receives the first move
view-if: left_seats > 0 and snap_senate_marshal_return = 0
new-page: true
on-arrival: {!
Q.snap_senate_marshal_return = 0;
const hostilePalace =
    Boolean(Q.pres_2025_hostile_president) ||
    Q.president_name == "Andrzej Duda";
const pisSeats = Math.max(0, Number(Q.pis_seats) || 0);
const pslSeats = Math.max(0, Number(Q.psl_seats) || 0);
const morawieckiCamp = Math.max(
    0,
    Number(Q.pis_morawiecki_camp) || 0
);
const democraticClaim = Math.max(
    0,
    (Number(Q.democratic_committed_seats) || 0) +
        (Number(Q.left_committed_seats) || 0)
);
const democraticCore = Math.max(
    0,
    Number(Q.democratic_committed_seats) || 0
);
const rightClaim = Math.max(
    0,
    Number(Q.right_committed_seats) || 0
);
Q.snap_left_cabinet_commitment = 0;
if (
    !hostilePalace &&
    democraticClaim >= 231 &&
    democraticClaim > rightClaim
) {
    Q.snap_pm_candidate = "Donald Tusk";
    Q.snap_pm_party = "ko";
    Q.snap_pm_is_right = 0;
    Q.snap_pm_base = democraticCore;
    Q.snap_nomination_reason =
        "A non-hostile Palace recognises the bloc that can demonstrate a clear democratic majority.";
} else if (Q.pis_split || morawieckiCamp >= 25) {
    Q.snap_pm_candidate = "Mateusz Morawiecki";
    Q.snap_pm_party = "pis";
    Q.snap_pm_is_right = 1;
    Q.snap_pm_base =
        (Q.pis_split ? 0 : pisSeats) +
        (Q.pis_split ? (Number(Q.rozwoj_seats) || 0) : 0) +
        (Q.rival_relation_pis_konf >= 50 ? Q.konf_seats : 0);
    Q.snap_nomination_reason =
        "The PiS rupture makes Morawiecki the right-wing figure with the broadest recruitment claim.";
} else if (
    hostilePalace &&
    (Number(Q.far_right_agenda) || 0) >= 45
) {
    Q.snap_pm_candidate = "Przemysław Czarnek";
    Q.snap_pm_party = "pis";
    Q.snap_pm_is_right = 1;
    Q.snap_pm_base =
        pisSeats +
        (Q.rival_relation_pis_konf >= 50 ? Q.konf_seats : 0);
    Q.snap_nomination_reason =
        "A hostile Palace prioritises right-wing consolidation over centrist recruitment.";
    Q.far_right_agenda += 3;
} else if (hostilePalace) {
    Q.snap_pm_candidate = "Beata Szydło";
    Q.snap_pm_party = "pis";
    Q.snap_pm_is_right = 1;
    Q.snap_pm_base =
        pisSeats +
        (Q.rival_relation_pis_psl >= 55 &&
            Q.psl_coalition_dissent < 65 ? pslSeats : 0);
    Q.snap_nomination_reason =
        "The Palace tests whether a welfare-nationalist nominee can recruit rural deputies.";
    Q.pis_solidarist_share += 4;
} else {
    Q.snap_pm_candidate = "Mateusz Morawiecki";
    Q.snap_pm_party = "pis";
    Q.snap_pm_is_right = 1;
    Q.snap_pm_base =
        pisSeats +
        (Q.rival_relation_pis_konf >= 50 ? Q.konf_seats : 0) +
        (Q.rival_relation_pis_psl >= 55 &&
            Q.psl_coalition_dissent < 65 ? pslSeats : 0);
    Q.snap_nomination_reason =
        "A non-hostile Palace follows the largest plausible right-led formation claim without endorsing it.";
}
Q.news_headline =
    Q.president_name + " gives " +
    Q.snap_pm_candidate + " the first cabinet attempt";
!}

= A nominee before a majority

President **[+ president_name +]**, not Lewica, designates **[+
snap_pm_candidate +]**. [+ snap_nomination_reason +]

The nominee begins with **[+ snap_pm_base +]** expected votes outside Lewica
and still needs 231. Lewica now decides whether its votes also entail cabinet
responsibility.

- @snap_left_offer: Receive the nominee's approach

@snap_left_offer
title: The Palace nominee courts the Left
new-page: true

= Confidence is not the same thing as office

**[+ snap_pm_candidate +]** begins with **[+ snap_pm_base +]** expected votes.
A confidence vote needs 231 yes votes; abstaining does not add yes votes.

- @snap_left_reject
- @snap_left_welfare
- @snap_left_abstain
- @snap_left_join_democratic
- @snap_left_supply_democratic
- @snap_left_reject_democratic

@snap_left_reject
title: Reject the offer as a right-wing restoration
subtitle: No Lewica votes or abstentions; party unity +3 and KO relations +3.
view-if: snap_pm_is_right = 1
on-arrival: snap_left_transfer = 0; snap_left_abstentions = 0; party_unity += 3; ko_relation += 3; razem_cooperation += 2; news_headline = "The Left closes the first-attempt auction"
go-to: snap_first_vote

@snap_left_welfare
title: Demand labour law, public housing and a constitutional restraint pact
subtitle: 22% of Lewica MPs vote yes; unity −7, KO relations −10 and Razem dissent +10.
view-if: snap_pm_is_right = 1
on-arrival: {!
Q.snap_left_transfer = Math.round(Number(Q.left_seats) * 0.22);
Q.snap_left_abstentions = 0;
Q.party_unity -= 7;
Q.barons_dissent -= 4;
Q.progressives_dissent += 8;
Q.razem_dissent += 10;
Q.ko_relation -= 10;
Q.pis_relation += 8;
Q.news_headline =
    "A welfare pact splits the Left before the confidence vote";
!}
go-to: snap_first_vote

@snap_left_abstain
title: Abstain in exchange for a short caretaker programme
subtitle: All Lewica MPs abstain; unity −3 and KO relations −5, but no yes votes.
view-if: snap_pm_is_right = 1
on-arrival: {!
Q.snap_left_transfer = 0;
Q.snap_left_abstentions = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.party_unity -= 3;
Q.ko_relation -= 5;
Q.pis_relation += 3;
Q.early_election_risk -= 5;
Q.news_headline =
    "The Left withholds confidence votes while negotiating caretaker limits";
!}
go-to: snap_first_vote

@snap_left_join_democratic
title: Enter the democratic cabinet under a written coalition agreement
subtitle: Lewica votes yes, takes collective responsibility and receives governing capacity.
view-if: snap_pm_is_right = 0
on-arrival: {!
Q.snap_left_transfer =
    Math.max(0, Number(Q.left_committed_seats) || 0);
Q.snap_left_abstentions = 0;
Q.snap_left_cabinet_commitment = 1;
Q.party_unity += 2;
Q.ko_relation += 4;
Q.psl_relation -= 1;
Q.news_headline =
    "Lewica signs a cabinet agreement before the first-attempt vote";
!}
go-to: snap_first_vote

@snap_left_supply_democratic
title: Supply confidence from outside the cabinet
subtitle: The same yes votes, but no ministries and no state-budget authority.
view-if: snap_pm_is_right = 0
on-arrival: {!
Q.snap_left_transfer =
    Math.max(0, Number(Q.left_committed_seats) || 0);
Q.snap_left_abstentions = 0;
Q.snap_left_cabinet_commitment = 0;
Q.razem_dissent -= 4;
Q.barons_dissent += 3;
Q.ko_relation += 1;
Q.news_headline =
    "Lewica offers confidence and supply without entering cabinet";
!}
go-to: snap_first_vote

@snap_left_reject_democratic
title: Withhold confidence and remain full opposition
subtitle: No Lewica votes are added to the nominee's base.
view-if: snap_pm_is_right = 0
on-arrival: {!
Q.snap_left_transfer = 0;
Q.snap_left_abstentions = 0;
Q.snap_left_cabinet_commitment = 0;
Q.party_unity += 1;
Q.ko_relation -= 6;
Q.news_headline =
    "Lewica withholds confidence from the democratic nominee";
!}
go-to: snap_first_vote

@snap_first_vote
title: First-attempt confidence
new-page: true
on-arrival: {!
const randomVotes = Math.floor(
    (this.random.uint32() / 4294967296) * 7
) - 3;
Q.snap_first_variance = randomVotes;
Q.confidence_candidate = Q.snap_pm_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Math.round(Number(Q.snap_pm_base) || 0) +
            Math.round(Number(Q.snap_left_transfer) || 0) +
            randomVotes
    )
);
Q.confidence_abstain = Math.max(
    0,
    Math.min(
        460 - Q.confidence_yes,
        60,
        4 + (Number(Q.snap_left_abstentions) || 0)
    )
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present = 460;
Q.confidence_threshold = 231;
Q.government_has_confidence = Q.confidence_yes >= 231 ? 1 : 0;
Q.confidence_mode = "Post-snap presidential first attempt";
!}

= First confidence roll call

**[+ snap_pm_candidate +]: [+ confidence_yes +] yes · [+
confidence_no +] no · [+ confidence_abstain +] abstain**

Yes count: **[+ snap_pm_base +] nominee base** + **[+
snap_left_transfer +] Lewica transfers** + **[+ snap_first_variance +]
roll-call variance**. Threshold: **231**.

- @snap_first_pass
- @snap_sejm_candidate

@snap_first_pass
title: The presidential nominee takes office
view-if: government_has_confidence = 1
on-arrival: {!
Q.prime_minister = Q.snap_pm_candidate;
Q.government_name = Q.snap_pm_candidate + " cabinet";
Q.government_party = Q.snap_pm_party;
Q.government_owner = Q.snap_pm_is_right
    ? "PiS-led presidential nominee"
    : "KO-led democratic coalition";
Q.left_in_government =
    Q.snap_left_cabinet_commitment ? 1 : 0;
Q.budget = Q.left_in_government ? 3 : 0;
Q.budget_authority = Q.left_in_government
    ? "Post-election coalition reserve"
    : "Opposition — no state spending authority";
Q.position = Q.left_in_government
    ? "Governing coalition"
    : (
        (Number(Q.snap_left_transfer) || 0) > 0
            ? "Confidence-and-supply opposition"
            : "Parliamentary opposition"
    );
Q.coalition_status = "Presidential nominee won confidence";
Q.coalition_seats = Q.government_party == "pis"
    ? Math.max(0, Number(Q.right_committed_seats) || 0)
    : Math.min(
        Number(Q.sejm_total) || 460,
        Math.max(0, Number(Q.democratic_committed_seats) || 0) +
        (Q.left_in_government
            ? Math.max(0, Number(Q.left_seats) || 0)
            : 0)
    );
Q.government_support_seats = Q.snap_pm_is_right
    ? Math.max(0, Number(Q.snap_pm_base) || 0)
    : Math.max(0, Number(Q.democratic_committed_seats) || 0);
Q.caretaker_government = 0;
Q.formation_complete = 1;
Q.formation_in_progress = 0;
Q.snap_election_requested = 0;
Q.left_cabinet_committed = Q.left_in_government ? 1 : 0;
Q.left_cabinet_model = Q.left_in_government
    ? "New Left ministers · Razem external support"
    : (
        (Number(Q.snap_left_transfer) || 0) > 0
            ? "Confidence and supply from opposition"
            : "Opposition"
    );
Q.ministries_finalized = Q.left_in_government ? 0 : 1;
Q.ministry_allocation_mode = Q.left_in_government
    ? "formation"
    : "settled";
Q.ministry_return_mode = "event_queue";
Q.news_headline =
    Q.snap_pm_candidate + " forms the post-election government";
!}
go-to: poland_ministries if left_in_government = 1; poland_event_queue if left_in_government = 0

@snap_sejm_candidate
title: The Sejm receives the second attempt
view-if: government_has_confidence = 0
new-page: true

= A democratic candidate needs 231

The President's nominee has failed. The Sejm now chooses its own candidate for
prime minister, and Lewica's support will affect both the nominee and the
coalition assembled around that person.

- @snap_sejm_tusk
- @snap_sejm_trzaskowski
- @snap_sejm_nowacka
- @snap_sejm_sikorski
- @snap_sejm_left

@snap_sejm_tusk
title: Donald Tusk
subtitle: Starts with the democratic core outside Lewica; KO relations +2.
on-arrival: {!
Q.snap_dem_candidate = "Donald Tusk";
Q.snap_dem_candidate_left = 0;
Q.snap_dem_base = Math.max(
    0,
    Q.democratic_committed_seats
);
Q.ko_relation += 2;
!}
go-to: snap_democratic_role

@snap_sejm_trzaskowski
title: Rafał Trzaskowski
subtitle: Only if he is not President; democratic base −2, KO +3 and PSL −1.
view-if: president_name != "Rafał Trzaskowski"
on-arrival: {!
Q.snap_dem_candidate = "Rafał Trzaskowski";
Q.snap_dem_candidate_left = 0;
Q.snap_dem_base = Math.max(
    0,
    Q.democratic_committed_seats - 2
);
Q.ko_relation += 3;
Q.psl_relation -= 1;
!}
go-to: snap_democratic_role

@snap_sejm_nowacka
title: Barbara Nowacka
subtitle: Democratic base −4; progressive dissent −2 and PSL relations −3.
on-arrival: {!
Q.snap_dem_candidate = "Barbara Nowacka";
Q.snap_dem_candidate_left = 0;
Q.snap_dem_base = Math.max(
    0,
    Q.democratic_committed_seats - 4
);
Q.progressives_dissent -= 2;
Q.psl_relation -= 3;
!}
go-to: snap_democratic_role

@snap_sejm_sikorski
title: Radosław Sikorski
subtitle: Democratic base −3; military trust +2 and PSL relations +1.
on-arrival: {!
Q.snap_dem_candidate = "Radosław Sikorski";
Q.snap_dem_candidate_left = 0;
Q.snap_dem_base = Math.max(
    0,
    Q.democratic_committed_seats - 3
);
Q.military_trust += 2;
Q.psl_relation += 1;
!}
go-to: snap_democratic_role

@snap_sejm_left
title: A Left compromise candidate
subtitle: Gains 20% of other seats but loses about 8% of KO; unity +4 and KO −5.
new-page: true

Lewica must nominate a person, not an abstract “Left compromise”. Each option
uses the same parliamentary arithmetic; the choice decides the cabinet's
political centre and who owns its programme.

- @snap_left_campaign_nominee
- @snap_left_dziemianowicz
- @snap_left_biejat
- @snap_left_gawkowski
- @snap_left_kotula

@snap_left_campaign_nominee
title: Re-nominate Lewica's 2025 presidential candidate
view-if: pres_2025_left_candidate != "Undecided" and pres_2025_left_candidate != president_name and pres_2025_left_candidate != "Agnieszka Dziemianowicz-Bąk" and pres_2025_left_candidate != "Magdalena Biejat" and pres_2025_left_candidate != "Krzysztof Gawkowski" and pres_2025_left_candidate != "Katarzyna Kotula"
on-arrival: snap_dem_candidate = pres_2025_left_candidate
go-to: snap_left_nominee_ready

@snap_left_dziemianowicz
title: Nominate Agnieszka Dziemianowicz-Bąk on a labour programme
view-if: president_name != "Agnieszka Dziemianowicz-Bąk"
on-arrival: snap_dem_candidate = "Agnieszka Dziemianowicz-Bąk"; labor_credibility += 3
go-to: snap_left_nominee_ready

@snap_left_biejat
title: Nominate Magdalena Biejat on a social and housing programme
view-if: president_name != "Magdalena Biejat"
on-arrival: snap_dem_candidate = "Magdalena Biejat"; public_trust += 2
