@snap_attempt_three_vote
title: Third-attempt confidence vote
new-page: true
on-arrival: {!
const attemptThreeRoll =
    Math.floor((this.random.uint32() / 4294967296) * 9) - 4;
Q.snap_formation_variance = attemptThreeRoll;
Q.confidence_candidate = Q.snap_formation_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Q.snap_formation_base +
        (Number(Q.snap_formation_left_votes) || 0) +
        attemptThreeRoll
    )
);
Q.confidence_abstain = Math.max(
    0,
    Math.min(
        160,
        8 + (Number(Q.snap_formation_left_abstentions) || 0)
    )
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present = 460;
Q.confidence_threshold =
    Math.floor(
        (Q.confidence_yes + Q.confidence_no) / 2
    ) + 1;
Q.government_has_confidence =
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
Q.snap_formation_attempt = 3;
!}

**[+ confidence_yes +] yes · [+ confidence_no +] no · [+
confidence_abstain +] abstain.** The simple-majority threshold is **[+
confidence_threshold +]**.

