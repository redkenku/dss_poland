@snap_formation_attempt_one
title: First formation attempt — the President's nominee
new-page: true
on-arrival: {!
const firstRight =
    Q.government_party == "pis" ||
    Q.president_name == "Andrzej Duda" ||
    Boolean(Q.pres_2025_hostile_president);
const successionNominee =
    Q.office_incompatibility_pm_formation &&
    String(Q.office_incompatibility_pm_nominee || "").length &&
    Q.office_incompatibility_pm_nominee != Q.president_name
        ? Q.office_incompatibility_pm_nominee
        : "";
const rightNominee = Q.president_name == "Mateusz Morawiecki"
    ? "Beata Szydło"
    : "Mateusz Morawiecki";
Q.snap_formation_candidate = successionNominee || (firstRight
    ? rightNominee
    : (
        String(Q.prime_minister || "").length &&
        !String(Q.prime_minister || "").includes("Vacant") &&
        Q.prime_minister != Q.president_name
            ? Q.prime_minister
            : "Donald Tusk"
    ));
const firstNomineeParty = successionNominee
    ? String(Q.office_incompatibility_pm_nominee_party || "")
    : "";
Q.snap_formation_first_right = successionNominee
    ? (firstNomineeParty == "pis" ? 1 : 0)
    : (firstRight ? 1 : 0);
Q.snap_formation_nominee_is_left =
    firstNomineeParty == "lewica" || [
        "Agnieszka Dziemianowicz-Bąk", "Magdalena Biejat",
        "Krzysztof Gawkowski", "Włodzimierz Czarzasty",
        "Robert Biedroń", "Adrian Zandberg"
    ].includes(Q.snap_formation_candidate) ? 1 : 0;
const pisKonfPledge =
    (Number(Q.rival_relation_pis_konf) || 0) >= 50
        ? Math.max(0, Number(Q.konf_seats) || 0)
        : 0;
const pisPslPledge =
    (Number(Q.rival_relation_pis_psl) || 0) >= 55 &&
    (Number(Q.psl_coalition_dissent) || 0) < 65
        ? Math.max(0, Number(Q.psl_seats) || 0)
        : 0;
const koPslPledge =
    (Number(Q.rival_relation_ko_psl) || 0) >= 55 &&
    (Number(Q.psl_coalition_dissent) || 0) < 65
        ? Math.max(0, Number(Q.psl_seats) || 0)
        : 0;
const koP2050Pledge =
    (Number(Q.rival_relation_ko_p2050) || 0) >= 55 &&
    (Number(Q.p2050_coalition_dissent) || 0) < 65
        ? Math.max(0, Number(Q.p2050_seats) || 0)
        : 0;
const centrumPledge =
    (Number(Q.centrum_relation) || 0) >= 55
        ? Math.max(0, Number(Q.centrum_seats) || 0)
        : 0;
Q.right_committed_seats =
    Math.max(0, Number(Q.pis_seats) || 0) + pisKonfPledge;
Q.democratic_committed_seats =
    Math.max(0, Number(Q.ko_seats) || 0) + koPslPledge +
    koP2050Pledge + centrumPledge;
Q.snap_psl_cabinet_committed = Q.snap_formation_first_right
    ? (pisPslPledge > 0 ? 1 : 0)
    : (koPslPledge > 0 ? 1 : 0);
Q.snap_p2050_cabinet_committed =
    !Q.snap_formation_first_right && koP2050Pledge > 0 ? 1 : 0;
Q.snap_centrum_cabinet_committed =
    !Q.snap_formation_first_right && centrumPledge > 0 ? 1 : 0;
Q.snap_left_cabinet_commitment = 0;
if (Q.snap_formation_first_right) {
    Q.snap_formation_base = Q.right_committed_seats + pisPslPledge;
    Q.snap_formation_pledge_basis =
        "PiS" + (pisKonfPledge ? " · Konfederacja pact" : "") +
        (pisPslPledge ? " · PSL pact" : "");
} else {
    Q.snap_formation_base = Q.democratic_committed_seats;
    Q.snap_formation_pledge_basis =
        "KO" + (koPslPledge ? " · PSL pact" : "") +
        (koP2050Pledge ? " · Poland 2050 pact" : "") +
        (centrumPledge ? " · Centrum pact" : "");
}
Q.snap_formation_base = Math.max(
    0,
    Math.min(460, Math.round(Q.snap_formation_base))
);
Q.snap_formation_left_votes = 0;
Q.news_headline =
    Q.president_name + " nominates " +
    Q.snap_formation_candidate + " in the first attempt";
!}

= An appointment still needs 231

The nominee begins with **[+ snap_formation_base +]** expected votes from **[+
snap_formation_pledge_basis +]**. Other parties are possible partners, not
automatic yes votes; Lewica controls
only its own **[+ left_committed_seats +]** committed votes.

- @snap_attempt_one_support
- @snap_attempt_one_join
- @snap_attempt_one_reject

@snap_attempt_one_support
title: Supply confidence for a time-limited constitutional cabinet
view-if: snap_formation_nominee_is_left = 0
on-arrival: snap_formation_left_votes = left_committed_seats; snap_left_cabinet_commitment = 0; party_unity -= 5; public_trust -= 1; pis_relation += 5 if snap_formation_first_right = 1; ko_relation += 3 if snap_formation_first_right = 0; news_headline = "Lewica offers confidence without claiming to control the nominee"
go-to: snap_attempt_one_vote

@snap_attempt_one_join
title: Join a non-hostile nominee under a written cabinet agreement
subtitle: Confidence entails real collective responsibility and ministries.
view-if: snap_formation_first_right = 0
on-arrival: snap_formation_left_votes = left_committed_seats; snap_left_cabinet_commitment = 1; party_unity += 1; ko_relation += 3; government_coalition_dissent += 2; news_headline = "Lewica joins the first-attempt cabinet under a written programme"
go-to: snap_attempt_one_vote

@snap_attempt_one_reject
title: Reject the presidential nominee
on-arrival: snap_formation_left_votes = 0; party_unity += 2; pis_relation -= 3 if snap_formation_first_right = 1; news_headline = "Lewica withholds confidence from the first attempt"
go-to: snap_attempt_one_vote

@snap_attempt_one_vote
title: First-attempt confidence vote
new-page: true
on-arrival: {!
const attemptOneRoll =
    Math.floor((this.random.uint32() / 4294967296) * 7) - 3;
Q.snap_formation_variance = attemptOneRoll;
Q.confidence_candidate = Q.snap_formation_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Q.snap_formation_base +
        (Number(Q.snap_formation_left_votes) || 0) +
        attemptOneRoll
    )
);
Q.confidence_abstain = Math.max(
    0,
    Math.min(24, 460 - Q.confidence_yes)
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present = 460;
Q.confidence_threshold = 231;
Q.government_has_confidence =
    Q.confidence_yes >= 231 ? 1 : 0;
Q.snap_formation_attempt = 1;
!}

**[+ confidence_yes +] yes · [+ confidence_no +] no · [+
confidence_abstain +] abstain.** The first attempt requires 231 yes votes.

- @snap_formation_success
- @snap_formation_attempt_two

@snap_formation_attempt_two
title: Second formation attempt — the Sejm's nominee
new-page: true
view-if: government_has_confidence = 0
on-arrival: {!
const leftCandidate =
    (Number(Q.ko_relation) || 0) < 34 &&
    (Number(Q.left_committed_seats) || 0) >= 45;
const eligibleLeftNominees = [
    Q.pres_2025_left_candidate,
    "Agnieszka Dziemianowicz-Bąk",
    "Magdalena Biejat",
    "Krzysztof Gawkowski",
    "Katarzyna Kotula"
].filter(function(name) {
    return name && name != "Undecided" && name != Q.president_name;
});
Q.snap_formation_candidate = leftCandidate
    ? eligibleLeftNominees[0]
    : (Q.president_name == "Donald Tusk" ? "Barbara Nowacka" : "Donald Tusk");
Q.snap_formation_nominee_is_left = leftCandidate ? 1 : 0;
const sejmKoPslPledge =
    (Number(Q.rival_relation_ko_psl) || 0) >= 55 &&
    (Number(Q.psl_coalition_dissent) || 0) < 65
        ? Math.max(0, Number(Q.psl_seats) || 0)
        : 0;
const sejmKoP2050Pledge =
    (Number(Q.rival_relation_ko_p2050) || 0) >= 55 &&
    (Number(Q.p2050_coalition_dissent) || 0) < 65
        ? Math.max(0, Number(Q.p2050_seats) || 0)
        : 0;
const sejmCentrumPledge =
    (Number(Q.centrum_relation) || 0) >= 55
        ? Math.max(0, Number(Q.centrum_seats) || 0)
        : 0;
Q.democratic_committed_seats =
    Math.max(0, Number(Q.ko_seats) || 0) + sejmKoPslPledge +
    sejmKoP2050Pledge + sejmCentrumPledge;
Q.snap_psl_cabinet_committed = sejmKoPslPledge > 0 ? 1 : 0;
Q.snap_p2050_cabinet_committed = sejmKoP2050Pledge > 0 ? 1 : 0;
Q.snap_centrum_cabinet_committed = sejmCentrumPledge > 0 ? 1 : 0;
Q.snap_left_cabinet_commitment = 0;
Q.snap_formation_base = Q.democratic_committed_seats;
Q.snap_formation_pledge_basis =
    "KO" + (sejmKoPslPledge ? " · PSL pact" : "") +
    (sejmKoP2050Pledge ? " · Poland 2050 pact" : "") +
    (sejmCentrumPledge ? " · Centrum pact" : "");
if (leftCandidate) {
    Q.snap_formation_base -= Math.round(
        Math.max(0, Number(Q.ko_seats) || 0) * 0.16
    );
}
Q.snap_formation_base = Math.max(
    0,
    Math.min(460, Math.round(Q.snap_formation_base))
);
Q.snap_formation_left_votes = 0;
Q.news_headline =
    "The Sejm proposes " + Q.snap_formation_candidate +
    " in the second attempt";
!}

The Sejm nominee begins with **[+ snap_formation_base +]** votes from **[+
snap_formation_pledge_basis +]** before Lewica commits its caucus. This stage
also requires an absolute majority of 231.

