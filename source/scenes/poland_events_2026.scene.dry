    Q.coalition_seats = Math.max(
        0,
        (Number(Q.coalition_seats) || 0) - hearingBatch
    );
}
Q.rozwoj_pending_seats =
    Math.max(0, Number(Q.rozwoj_pending_seats) || 0) + hearingBatch;
Q.other_seats = Math.max(0, Number(Q.other_seats) || 0) + hearingBatch;
Q.rozwoj_chain_stage = 3;
const departureOrder = [
    "morawiecki", "semieniuk", "cieszynski", "jablonski", "kwiecien",
    "bartosik"
];
for (let index = 0; index < departureOrder.length; index += 1) {
    const person = (Q.rival_person_records || []).find(function(candidate) {
        return candidate.id == departureOrder[index];
    });
    if (!person) continue;
    if (Q.rozwoj_definitive_departures >= 4 + index * 2) {
        person.party = "independent";
        person.organisation = "rozwoj_plus";
        person.loyalty = "Rozwój+";
        person.status = "departed PiS individually";
    } else {
        person.status = "disciplinary case still pending";
    }
}
const association = (Q.rival_group_records || []).find(function(record) {
    return record.id == "rozwoj_plus";
});
if (association) association.exclusive_seats = Q.rozwoj_pending_seats;
Q.news_headline = hearingBatch +
    " more PiS cases resolve as individual departures";
!}

