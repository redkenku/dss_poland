presidential mediation.

- @pis_expulsions
- @pis_reconcile
- @pis_wait

@pis_expulsions
title: Encourage a clean parliamentary split and negotiate with both camps
on-arrival: {!
const morawieckiDefectors = Math.min(
    Math.max(0, Number(Q.pis_morawiecki_camp) || 0),
    Math.max(0, Number(Q.pis_seats) || 0)
);
Q.pis_morawiecki_camp = morawieckiDefectors;
Q.pis_split = 1;
Q.pis_split_crisis = 0;
Q.pis_seats = Math.max(0, Q.pis_seats - morawieckiDefectors);
Q.other_seats =
    Math.max(0, Number(Q.other_seats) || 0) + morawieckiDefectors;
Q.pis_leader = "Jarosław Kaczyński";
Q.pis_dominant_wing = "Kaczyński loyalists and Czarnek hardliners";
Q.pis_relation += 2;
Q.public_trust -= 1;
Q.news_headline = "Rozwój Plus becomes a separate parliamentary bloc";
!}
go-to: poland_event_queue

