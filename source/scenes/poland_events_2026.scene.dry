const centrumSeatsReturning = Math.max(0, Number(Q.centrum_seats) || 0);
Q.centrum_returned_seats_2026 = centrumSeatsReturning;
const parentSupportsGovernment =
    Q.government_party == "p2050" || Boolean(Q.ministry_p2050_in_cabinet);
if (Q.centrum_supports_government && !parentSupportsGovernment) {
    Q.government_support_seats = Math.max(
        0,
        (Number(Q.government_support_seats) || 0) - centrumSeatsReturning
    );
}
Q.p2050_seats += centrumSeatsReturning;
Q.centrum_seats = 0;
Q.p2050_split = 0;
Q.centrum_supports_government = 0;
Q.p2050_coalition_dissent -= 7;
Q.p2050_relation += 4;
Q.centrum_relation += 2;
Q.centrum_party_readiness = 0;
Q.centrum_independent_vote_base = 0;
Q.news_headline =
    "The centrist caucus reunites under an autonomy agreement";
!}

The two wings sign guarantees for regional nominations, internal votes and a
place for Kobosko's network in the reunited organisation. All **[+
centrum_returned_seats_2026 +]** mandates have already been transferred back to Poland 2050
in the Sejm count; Centrum's separate caucus and electoral claim end here.
Autonomy survives on paper, ready to become either a bridge or the terms of the
next quarrel.

