@snap_dem_vote
title: Sejm-led cabinet vote
new-page: true
on-arrival: {!
const roll = Math.floor(
    (this.random.uint32() / 4294967296) * 9
) - 4;
Q.snap_dem_variance = roll;
Q.confidence_candidate = Q.snap_dem_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Math.round(Number(Q.snap_dem_base) || 0) + roll
    )
);
Q.confidence_abstain = Math.min(
    460 - Q.confidence_yes,
    18,
    4 + Math.abs(Math.min(0, roll))
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present = 460;
Q.confidence_threshold = 231;
Q.government_has_confidence = Q.confidence_yes >= 231 ? 1 : 0;
Q.confidence_mode = "Post-snap Sejm second attempt";
if (Q.government_has_confidence) {
    Q.prime_minister = Q.snap_dem_candidate;
    Q.prime_minister_intro_return = "ministries_or_event_queue";
    Q.prime_minister_intro_pending = 1;
    Q.government_name = Q.snap_dem_candidate + " democratic cabinet";
    const leftLedSnapCabinet =
        Number(Q.snap_dem_candidate_left) == 1;
    Q.government_party = leftLedSnapCabinet ? "lewica" : "ko";
    Q.government_owner = leftLedSnapCabinet
        ? Q.left_party_name
        : "KO-led democratic coalition";
    Q.left_in_government =
        Q.snap_left_cabinet_commitment ? 1 : 0;
    Q.position = Q.left_in_government
        ? "Governing coalition"
        : (
            Q.snap_dem_left_support
                ? "Confidence-and-supply opposition"
                : "Parliamentary opposition"
        );
    Q.coalition_status = Q.left_in_government
        ? "Sejm-elected democratic coalition cabinet"
        : "Sejm-elected cabinet with external Lewica support";
    Q.coalition_seats = Math.min(
        Number(Q.sejm_total) || 460,
        Math.max(0, Number(Q.democratic_committed_seats) || 0) +
        (Q.left_in_government
            ? Math.max(0, Number(Q.left_seats) || 0)
            : 0)
    );
    Q.government_support_seats = Math.max(
        0,
        Number(Q.democratic_committed_seats) || 0
    );
    Q.caretaker_government = 0;
    Q.formation_complete = 1;
    Q.formation_in_progress = 0;
    Q.budget = Q.left_in_government ? 3 : 0;
    Q.budget_authority = Q.left_in_government
        ? "Post-election coalition reserve"
        : "Opposition — no state spending authority";
    Q.left_cabinet_committed =
        Q.left_in_government ? 1 : 0;
    Q.left_cabinet_model = Q.left_in_government
        ? (
            leftLedSnapCabinet
                ? "Programme-bound cooperating Left entry"
                : "New Left ministers · Razem external support"
        )
        : (
            Q.snap_dem_left_support
                ? "Confidence and supply from opposition"
                : "Opposition"
        );
    Q.ministries_finalized =
        Q.left_in_government ? 0 : 1;
    Q.ministry_allocation_mode = Q.left_in_government
        ? "formation"
        : "settled";
    Q.ministry_return_mode = "event_queue";
    Q.news_headline =
        Q.snap_dem_candidate + " wins the Sejm's cabinet vote";
} else {
    Q.caretaker_government = 1;
    Q.early_election_risk = 100;
    Q.news_headline =
        "The Sejm's second attempt fails and a third presidential attempt remains";
}
!}

