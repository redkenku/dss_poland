const association = (Q.rival_group_records || []).find(function(record) {
    return record.id == "rozwoj_plus";
});
if (association) {
    association.active = 1;
    association.legal_status = "association under PiS disciplinary review";
    association.organisation = Math.max(54, Number(association.organisation) || 0);
    association.cohesion = Math.max(62, Number(association.cohesion) || 0);
    association.mp_count = Q.rozwoj_association_members;
    association.sejm_mps = Q.rozwoj_association_members;
    association.senators = 1;
    association.meps = 3;
    association.defection_readiness = Math.max(
        55,
        Number(association.defection_readiness) || 0
    );
    association.exclusive_seats =
