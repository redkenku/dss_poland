Q.partnership_presidential_score = Math.round(
    48 +
    relationshipContribution +
    Q.partnership_presidential_lobby_bonus +
    (Q.pres_2025_hostile_president ? -10 : 8) +
    Math.max(-3, Math.min(3, (Number(Q.psl_relation) - 40) * 0.10)) +
    Q.partnership_presidential_roll
);
Q.last_policy_stage = "Presidential decision";
Q.last_policy_authority = Q.president_name;
if (Q.partnership_presidential_score < 50) {
    Q.partnership_presidential_outcome = "Vetoed";
    Q.last_policy_implementation = "Blocked after parliamentary passage";
    Q.president_relation -= 5;
    Q.progressive_credibility -= 2;
    Q.news_headline =
        Q.president_name + " vetoes the partnership law";
} else {
    Q.partnership_presidential_outcome = "Signed";
    Q.last_policy_implementation = "Enacted; implementation scheduled for the next monthly callback";
    Q.president_relation += 4;
    Q.minority_safety += 5;
    Q.partnership_implementation_pending = 1;
    Q.partnership_implementation_due_time = (Number(Q.time) || 0) + 1;
    Q.progressive_credibility += 2;
    Q.news_headline =
        Q.president_name + " signs the partnership law";
}
!}

