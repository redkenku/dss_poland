    0,
    Math.round(Number(Q.pis_seats) || 0)
);
Q.rozwoj_association_members = Math.min(40, livePisCaucus);
Q.pis_morawiecki_camp = Q.rozwoj_association_members;
Q.rozwoj_loyalty_declarations = Q.rozwoj_association_members;
Q.rozwoj_disciplinary_cases = Math.min(44, livePisCaucus);
Q.rozwoj_cases_resolved = 0;
Q.rozwoj_chain_stage = 2;
Q.pis_split = 0;
Q.pis_split_crisis = 1;
Q.pis_rupture_outgoing_leadership =
    "Jarosław Kaczyński's unified PiS leadership, with Mateusz Morawiecki's modernising camp still inside";
Q.pis_rupture_incoming_leadership =
    "Kaczyński's loyalist PiS apparatus and Morawiecki's Rozwój+ association, backed by " +
