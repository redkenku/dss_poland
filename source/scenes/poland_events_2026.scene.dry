@partnership_revision_2026
# prose-audit: Grade D — The factual premise is usable, but the scene is skeletal; add named actors, Lewica viewpoint, and a bespoke aftermath for each exit.
title: The narrower partnership bill returns
subtitle: The promised follow-up receives a fresh Sejm and presidential test
new-page: true
tags: poland_event
priority: 35
order: 6
max-visits: 1
view-if: continuous_campaign = 1 and partnership_revision_pending = 1 and time >= partnership_revision_due_time
on-arrival: {!
Q.partnership_revision_pending = 0;
const revisionGain = Math.max(
    2,
    Math.min(
        18,
        7 + Math.round(((Number(Q.psl_relation) || 0) - 35) / 5)
    )
);
Q.partnership_revision_gain = revisionGain;
Q.partnership_revision_yes = Math.min(
    Number(Q.sejm_total) || 460,
    Math.max(0, Number(Q.partnership_sejm_yes) || 0) + revisionGain
);
Q.partnership_revision_no = Math.max(
    0,
    Math.max(0, Number(Q.partnership_sejm_no) || 0) - revisionGain
);
Q.partnership_revision_passed =
    Q.partnership_revision_yes > Q.partnership_revision_no ? 1 : 0;
const revisionHostilePresident =
    Q.pres_2025_hostile_president || [
        "Andrzej Duda", "Karol Nawrocki",
        "Sławomir Mentzen", "Grzegorz Braun"
    ].includes(Q.president_name);
Q.partnership_revision_enacted =
    Q.partnership_revision_passed &&
    (!revisionHostilePresident || Number(Q.president_relation) >= 48)
        ? 1 : 0;
if (Q.partnership_revision_enacted) {
    Q.partnership_revision_result =
        "The narrower bill passed and received presidential signature";
    Q.partnership_implementation_pending = 1;
    Q.partnership_implementation_due_time = (Number(Q.time) || 0) + 1;
    Q.minority_safety += 4;
    Q.news_headline = "The promised narrower partnership law is enacted";
} else if (Q.partnership_revision_passed) {
    Q.partnership_revision_result =
        "The narrower bill passed but met another presidential veto";
    Q.president_relation -= 4;
    Q.news_headline = "The Palace vetoes the narrower partnership bill";
} else {
    Q.partnership_revision_result =
        "The narrower bill failed its new Sejm vote";
    Q.public_trust -= 1;
    Q.news_headline = "The promised partnership revision fails in the Sejm";
}
!}

