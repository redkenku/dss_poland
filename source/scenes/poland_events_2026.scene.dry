Q.snap_campaign_strategy = "Unchosen";
Q.snap_campaign_left_bonus = 0;
Q.snap_election_requested = 0;
Q.snap_election_held = 0;
Q.snap_election_complete = 0;
Q.budget_deadline_active = 0;
Q.caretaker_government = 1;
Q.government_has_confidence = 0;
Q.formation_complete = 0;
