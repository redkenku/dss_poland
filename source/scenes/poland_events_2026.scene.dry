Q.ko_relation += 5;
Q.razem_cooperation -= 5;
Q.labor_credibility -= 3;
if (Q.horizon_budget_authority) {
    Q.fiscal_stress -= 4;
    Q.budget_breaches += 2;
} else {
    Q.last_policy_stage = "Proposal";
    Q.last_policy_authority = "Opposition shadow budget";
    Q.last_policy_implementation = 0;
