        12,
        ((Number(Q.economic_issue_salience) || 40) -
            (Number(Q.cultural_issue_salience) || 30)) * 0.18 +
        ((Number(Q.social_spending_support) || 50) - 50) * 0.10 +
        Math.max(0, Number(Q.party_system_left_pull) || 0) * 0.08
    )
);
Q.rozwoj_social_mood_score = Math.round(developmentalMood);
Q.rozwoj_party_readiness += Math.round(developmentalMood);
Q.rozwoj_party_formed =
    Q.rozwoj_club_formed &&
    organisation >= 48 && cohesion >= 55 &&
    Q.rozwoj_party_readiness >= 28 ? 1 : 0;
Q.rozwoj_party_result = Q.rozwoj_party_formed
    ? "Rozwój+ registers as a political party"
