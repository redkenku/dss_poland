@snap_attempt_three_support
title: Vote confidence from outside the cabinet
on-arrival: {!
Q.snap_formation_left_votes = Q.left_committed_seats;
Q.snap_formation_left_abstentions = 0;
Q.snap_left_cabinet_commitment = 0;
Q.party_unity -= 2;
Q.news_headline =
    "Lewica gives outside confidence to " + Q.snap_formation_candidate;
!}
go-to: snap_attempt_three_vote

@snap_attempt_three_join
title: Join the compromise cabinet under a written programme
subtitle: Available only for a non-hostile third-attempt nominee.
view-if: snap_third_hostile_nominee = 0
choose-if: coalition_viable_left_ko = 1 or coalition_viable_left_psl = 1 or coalition_viable_left_p2050 = 1
unavailable-subtitle: No centrist party will sign a cabinet programme with Lewica on the trust and distance this chamber records; support and abstention remain.
on-arrival: snap_formation_left_votes = left_committed_seats; snap_formation_left_abstentions = 0; snap_left_cabinet_commitment = 1; government_coalition_dissent += 3; party_unity += 1; news_headline = "Lewica binds its confidence votes to cabinet entry"
go-to: snap_attempt_three_vote

@snap_attempt_three_reject
title: Vote no and accept a mandatory election if the nominee fails
on-arrival: snap_formation_left_votes = 0; snap_formation_left_abstentions = 0; party_unity += 2; news_headline = "Lewica opposes the final nominee"
go-to: snap_attempt_three_vote

@snap_attempt_three_abstain
title: Abstain on a caretaker programme
on-arrival: snap_formation_left_votes = 0; snap_formation_left_abstentions = left_committed_seats; party_unity -= 1; public_trust -= 1; news_headline = "Lewica withholds yes votes but lowers the third-attempt majority"
go-to: snap_attempt_three_vote

@snap_attempt_three_vote
title: Third-attempt confidence vote
new-page: true
on-arrival: {!
const attemptThreeRoll =
    Math.floor((this.random.uint32() / 4294967296) * 9) - 4;
Q.snap_formation_variance = attemptThreeRoll;
Q.confidence_candidate = Q.snap_formation_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Q.snap_formation_base +
        (Number(Q.snap_formation_left_votes) || 0) +
        attemptThreeRoll
    )
);
Q.confidence_abstain = Math.max(
    0,
    Math.min(
        460 - Q.confidence_yes,
        8 + (Number(Q.snap_formation_left_abstentions) || 0)
    )
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold =
    Math.floor(
        (Q.confidence_yes + Q.confidence_no) / 2
    ) + 1;
Q.government_has_confidence =
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
Q.snap_formation_attempt = 3;
!}

**[+ confidence_yes +] yes · [+ confidence_no +] no · [+
confidence_abstain +] abstain.** The simple-majority threshold is **[+
confidence_threshold +]**.

