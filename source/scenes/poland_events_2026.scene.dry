The game does not silently rerun the same election forever. A second campaign
has produced a fresh seat result, yet all three constitutional attempts have
failed again. The outgoing cabinet remains caretaker while the unresolved
constitutional crisis moves beyond this scenario's political horizon.

- @snap_repeated_deadlock_return: Record the unresolved outcome

@snap_repeated_deadlock_return
go-to: poland_event_queue

@snap_result_2026
title: Alternative parliamentary election
new-page: true
on-arrival: {!
Q.snap_election_cycle =
    Math.max(0, Math.round(Number(Q.snap_election_cycle) || 0)) + 1;
const ids = [
    "pis", "ko", "p2050", "psl", "left", "konf", "other",
    "sld_breakaway", "spring_breakaway", "labor_left", "young_left",
    "razem", "pps", "centrum", "rozwoj", "korona", "ko_splinter"
];
const seatQuality = function(id) {
    if (id == "razem") return "razem_party_seats";
    if (id == "pps") return "pps_party_seats";
    return id + "_seats";
};
const rawSeats = {};
let total = 0;
for (const id of ids) {
    const projected = Number(Q[id + "_projected_seats"]);
    rawSeats[id] = Number.isFinite(projected)
        ? Math.max(0, Math.round(projected))
        : Math.max(
            0,
            Math.round(Number(Q[seatQuality(id)]) || 0)
        );
    total += rawSeats[id];
}
if (Q.snap_election_cycle > 1) {
    const campaignIndex = Math.floor(
        (this.random.uint32() / 4294967296) * 20
    );
    const campaignSwing = campaignIndex < 10
        ? -(campaignIndex + 3)
        : campaignIndex - 7;
    Q.snap_repeat_campaign_roll = campaignSwing;
    if (campaignSwing > 0) {
        const transfer = Math.min(campaignSwing, rawSeats.pis);
        rawSeats.pis -= transfer;
        rawSeats.ko += transfer;
    } else {
        const transfer = Math.min(-campaignSwing, rawSeats.ko);
        rawSeats.ko -= transfer;
        rawSeats.pis += transfer;
    }
    total = 0;
    for (const id of ids) total += rawSeats[id];
} else {
    Q.snap_repeat_campaign_roll = 0;
}
if (total <= 0) {
    rawSeats.pis = 180;
    rawSeats.ko = 170;
    rawSeats.left = 30;
    rawSeats.psl = 25;
    rawSeats.p2050 = 20;
    rawSeats.konf = 30;
    rawSeats.other = 5;
    total = 460;
}
let used = 0;
for (const id of ids) {
    Q[seatQuality(id)] = Math.floor(rawSeats[id] * 460 / total);
    used += Q[seatQuality(id)];
}
const ranked = ids.slice().sort(function(a, b) {
    return rawSeats[b] - rawSeats[a];
});
for (let i = 0; i < 460 - used; i += 1) {
    const winner = ranked[i % ranked.length];
    Q[seatQuality(winner)] += 1;
}
Q.left_splinter_seats =
    Q.sld_breakaway_seats + Q.spring_breakaway_seats +
    Q.labor_left_seats + Q.young_left_seats +
    Q.razem_party_seats + Q.pps_party_seats;
Q.left_family_seats = Q.left_seats + Q.left_splinter_seats;
Q.left_splinter_support_votes =
    (Q.barons_party_relation >= 45 ? Q.sld_breakaway_seats : 0) +
    (Q.spring_party_relation >= 45 ? Q.spring_breakaway_seats : 0) +
    (Q.labor_party_relation >= 45 ? Q.labor_left_seats : 0) +
    (
        Q.progressives_party_relation >= 45
            ? Q.young_left_seats
            : 0
    ) +
    (Q.razem_party_relation >= 45 ? Q.razem_party_seats : 0) +
    (Q.pps_party_relation >= 45 ? Q.pps_party_seats : 0);
Q.left_committed_seats =
    Q.left_seats + Q.left_splinter_support_votes;
const snapCentrumCommitted =
    Q.centrum_relation >= 45 ? Q.centrum_seats : 0;
Q.coalition_democratic_seats =
    Q.ko_seats + Q.ko_splinter_seats + Q.psl_seats + Q.p2050_seats +
    snapCentrumCommitted + Q.left_committed_seats;
Q.coalition_right_seats =
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats;
Q.seat_subvention_seats = Q.left_seats;
Q.snap_election_complete = 1;
Q.caretaker_government = 1;
Q.government_has_confidence = 0;
Q.news_headline =
    Q.snap_election_cycle > 1
        ? "A fresh second campaign shifts the balance but again fragments the Sejm"
        : "The alternative election returns a fragmented Sejm";
!}

