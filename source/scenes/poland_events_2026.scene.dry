);
const snapCurrentScale = previousMainLeftSeats > 0
    ? Q.left_seats / previousMainLeftSeats
    : 0;
Q.left_p2050_current_seats = Math.min(
    Q.left_seats,
    Math.round(previousP2050CurrentSeats * snapCurrentScale)
);
Q.left_green_current_seats = Math.min(
    Math.max(0, Q.left_seats - Q.left_p2050_current_seats),
    Math.round(previousGreenCurrentSeats * snapCurrentScale)
);
Q.left_rozwoj_current_seats = Math.min(
    Math.max(
        0,
        Q.left_seats - Q.left_p2050_current_seats -
            Q.left_green_current_seats
    ),
    Math.round(previousRozwojCurrentSeats * snapCurrentScale)
);

// Shortening the Sejm term also shortens the Senate term. Certify a new
// winner in each of the 100 single-member Senate districts from this same
// election, retaining the live pact choice instead of the stale 2023 chamber.
Q.senate_election_2023_certified = 0;
Q.senate_total = 100;
const snapSenateVote = function(id) {
    return Math.max(
        0,
        Number(Q["snap_election_" + id + "_vote"]) || 0
    );
};
const snapSenateVotes = {
    pis: snapSenateVote("pis") + snapSenateVote("rozwoj"),
    konf: snapSenateVote("konf") + snapSenateVote("korona"),
    ko: snapSenateVote("ko") + snapSenateVote("ko_splinter"),
    p2050: snapSenateVote("p2050") + snapSenateVote("centrum"),
    psl: snapSenateVote("psl"),
    left: [
        "left", "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left",
        "young_left", "razem", "pps", "tak_rozwoj"
    ].reduce(function(total, id) {
        return total + snapSenateVote(id);
    }, 0),
    independent: snapSenateVote("other")
};
const snapLeftPactMode = String(Q.senate_left_pact_mode || "full");
const snapLeftNominationWeight = snapLeftPactMode == "full"
    ? 1
    : (snapLeftPactMode == "reserved" ? 0.2 : 0);
const snapLeftVoteInsidePact = snapLeftPactMode != "outside";
const snapDemocraticSenateVote =
    snapSenateVotes.ko + snapSenateVotes.p2050 + snapSenateVotes.psl +
    (snapLeftVoteInsidePact ? snapSenateVotes.left : 0);
const snapPactStrength = Math.max(
    0,
    Math.min(100, Number(Q.senate_pact_strength) || 0)
);
const snapPactNomineeParts = apportionSnapCaucuses(
    Q.senate_total,
    [
        {id: "ko", weight: snapSenateVotes.ko},
        {id: "p2050", weight: snapSenateVotes.p2050},
        {id: "psl", weight: snapSenateVotes.psl},
        {
            id: "left",
            weight: snapSenateVotes.left * snapLeftNominationWeight
        }
    ]
);
const snapThirdNomineeParts = apportionSnapCaucuses(
    Q.senate_total,
    [
        {id: "p2050", weight: snapSenateVotes.p2050},
        {id: "psl", weight: snapSenateVotes.psl}
    ]
);
const snapNomineeSequence = function(parts, ids) {
    const nominees = [];
    for (const id of ids) {
        for (let seat = 0; seat < (parts[id] || 0); seat += 1) {
            nominees.push(id);
        }
    }
    while (nominees.length < Q.senate_total) nominees.push(ids[0]);
    for (let i = nominees.length - 1; i > 0; i -= 1) {
        const swap = this.random.uint32() % (i + 1);
        const current = nominees[i];
        nominees[i] = nominees[swap];
        nominees[swap] = current;
    }
    return nominees;
}.bind(this);
const snapPactNominees = snapNomineeSequence(
    snapPactNomineeParts,
    ["ko", "p2050", "psl", "left"]
);
const snapThirdNominees = snapNomineeSequence(
    snapThirdNomineeParts,
    ["p2050", "psl"]
);
const snapSenateWinners = {
    pis: 0, konf: 0, ko: 0, p2050: 0,
    psl: 0, left: 0, independent: 0
};
let snapSenateClosestMargin = 100;
const snapSenateRandom = function() {
    return this.random.uint32() / 4294967296;
}.bind(this);
for (let district = 0; district < Q.senate_total; district += 1) {
    const democraticLean = (snapSenateRandom() - 0.5) * 44;
    const candidates = [];
    const addCandidate = function(id, score) {
        if (score > 0) candidates.push({id: id, score: score});
    };
    if (Q.senate_pact_coordinated) {
        const transfer = 0.88 + snapPactStrength / 1000;
        addCandidate(
            snapPactNominees[district],
            snapDemocraticSenateVote * transfer + democraticLean +
                (snapSenateRandom() - 0.5) * 8
