        Q[portfolio + "_minister"] =
            replacementCabinet[portfolio][1];
    }
    Q.family_minister_party = Q.labor_minister_party;
    Q.family_minister = Q.labor_minister;
    Q.ministry_count = 0;
    Q.ministry_ko_in_cabinet = sikorskiReplacement ? 1 : 0;
    Q.ministry_p2050_in_cabinet = sikorskiReplacement &&
