@snap_result_2026
title: Alternative parliamentary election
new-page: true
on-arrival: {!
const ids = ["pis", "ko", "p2050", "psl", "left", "konf", "other"];
const rawSeats = {};
let total = 0;
for (const id of ids) {
    const projected = Number(Q[id + "_projected_seats"]);
    rawSeats[id] = Number.isFinite(projected)
        ? Math.max(0, Math.round(projected))
        : Math.max(0, Math.round(Number(Q[id + "_seats"]) || 0));
    total += rawSeats[id];
}
if (total <= 0) {
    rawSeats.pis = 180;
    rawSeats.ko = 170;
    rawSeats.left = 30;
    rawSeats.psl = 25;
    rawSeats.p2050 = 20;
    rawSeats.konf = 30;
    rawSeats.other = 5;
    total = 460;
}
let used = 0;
for (const id of ids) {
    Q[id + "_seats"] = Math.floor(rawSeats[id] * 460 / total);
    used += Q[id + "_seats"];
}
const ranked = ids.slice().sort(function(a, b) {
    return rawSeats[b] - rawSeats[a];
});
for (let i = 0; i < 460 - used; i += 1) {
    Q[ranked[i % ranked.length] + "_seats"] += 1;
}
Q.coalition_democratic_seats =
    Q.ko_seats + Q.psl_seats + Q.p2050_seats + Q.left_seats;
Q.coalition_right_seats = Q.pis_seats + Q.konf_seats;
Q.seat_subvention_seats = Q.left_seats;
Q.snap_election_complete = 1;
Q.news_headline =
    "The alternative election returns a fragmented Sejm";
!}

