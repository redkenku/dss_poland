@showdown_ultimatum
title: Threaten withdrawal unless the vetoes are reversed
subtitle: Requires a united party. The senior partner may concede, or may call it — and then we are outside.
choose-if: party_unity >= 55
unavailable-subtitle: A caucus this divided cannot credibly threaten to leave.
on-arrival: {!
Q.ministry_overruled_count = 0;
Q.pressure_last_response = "Threatened withdrawal";
// Credibility is the whole mechanism. The question the Chancellery asks is
// arithmetical: does this partner's departure end the majority? Everything
// else — caucus unity, size, and whether we could survive the election that
// would follow — only adjusts the answer.
const seats = Math.max(0, Number(Q.left_seats) || 0);
const margin = Math.max(
    0,
    Number(Q.government_support_seats) - Number(Q.sejm_statutory_majority)
);
const endsTheMajority = seats > margin;
const credibility =
    (endsTheMajority ? 62 : 18) +
    Math.max(0, Number(Q.party_unity) - 55) * 0.5 +
    Math.min(40, seats) * 0.4 -
    Math.max(0, Number(Q.early_election_risk) - 30) * 0.4 -
    Math.max(0, 8 - Number(Q.left_poll)) * 2;
const roll = (this.random.uint32() / 4294967296) * 100;
if (roll < Math.max(12, Math.min(88, credibility))) {
    Q.coalition_dispute_protocol = 1;
    Q.coalition_management = "Reversal won under a withdrawal threat";
    Q.government_delivery += 3;
    Q.party_unity += 5;
    Q.progressive_credibility += 4;
    Q.labor_credibility += 3;
    Q.left_coalition_dissent -= 6;
    Q.government_coalition_dissent += 6;
    Q.winner_reputation += 4;
    Q.left_poll_momentum += 0.3;
    Q.health_policy_pressure = Math.max(0, Q.health_policy_pressure - 4);
    Q.household_policy_pressure =
        Math.max(0, Q.household_policy_pressure - 4);
    Q.showdown_outcome = "Senior partner conceded";
    Q.news_headline =
        "The Chancellery reverses the vetoes rather than lose its majority";
} else {
    Q.government_coalition_dissent += 14;
    Q.left_coalition_dissent += 8;
    Q.early_election_risk += 10;
    Q.coalition_break_threat = 1;
    Q.winner_reputation -= 4;
    Q.party_unity -= 3;
    Q.coalition_blur += 4;
    Q.showdown_outcome = "Threat called";
    if (String(Q.government_party || "") == "pis") {
        Q.pis_relation -= 10;
    } else {
        Q.ko_relation -= 10;
        Q.psl_relation -= 6;
    }
    Q.news_headline =
        "The Chancellery invites Lewica to leave the government if it wishes";
}
!}

**Result:** [+ news_headline +].

[? if showdown_outcome = "Senior partner conceded": They counted the seats
before we did. Two of the three measures are restored to the cabinet agenda
