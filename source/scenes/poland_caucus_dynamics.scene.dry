title: Dynamic Left caucuses

@router
new-page: true
call: poland_normalize
go-to: social_patriot_launch if social_patriot_launch_pending = 1; barons_crisis if barons_active = 1 and barons_in_left = 1 and barons_escalation_stage = 2 and barons_demand_answered = 0 and time >= barons_demand_deadline and caucus_split_pending = 0; spring_crisis if spring_active = 1 and spring_in_left = 1 and spring_escalation_stage = 2 and spring_demand_answered = 0 and time >= spring_demand_deadline and caucus_split_pending = 0; labor_crisis if labor_active = 1 and labor_in_left = 1 and labor_escalation_stage = 2 and labor_demand_answered = 0 and time >= labor_demand_deadline and caucus_split_pending = 0; progressives_crisis if progressives_active = 1 and progressives_in_left = 1 and progressives_escalation_stage = 2 and progressives_demand_answered = 0 and time >= progressives_demand_deadline and caucus_split_pending = 0; razem_crisis if razem_active = 1 and razem_in_left = 1 and razem_breakaway_protected = 0 and razem_escalation_stage = 2 and razem_demand_answered = 0 and time >= razem_demand_deadline and caucus_split_pending = 0; pps_crisis if pps_active = 1 and pps_in_left = 1 and pps_escalation_stage = 2 and pps_demand_answered = 0 and time >= pps_demand_deadline and caucus_split_pending = 0; social_patriot_crisis if social_patriot_active = 1 and social_patriot_in_left = 1 and social_patriot_escalation_stage = 2 and social_patriot_demand_answered = 0 and time >= social_patriot_demand_deadline and caucus_split_pending = 0; barons_split if barons_active = 1 and barons_in_left = 1 and barons_escalation_stage >= 7; spring_split if spring_active = 1 and spring_in_left = 1 and spring_escalation_stage >= 7; labor_split if labor_active = 1 and labor_in_left = 1 and labor_escalation_stage >= 7; progressives_split if progressives_active = 1 and progressives_in_left = 1 and progressives_escalation_stage >= 7; razem_split if razem_active = 1 and razem_in_left = 1 and razem_breakaway_protected = 0 and razem_escalation_stage >= 7; pps_split if pps_active = 1 and pps_in_left = 1 and pps_escalation_stage >= 7; social_patriot_split if social_patriot_active = 1 and social_patriot_in_left = 1 and social_patriot_escalation_stage >= 7; return if caucus_crisis_pending = 0

@social_patriot_launch
title: The Social Patriots found their own organisation
subtitle: Welfare, regional development and sovereignty acquire a name beyond SLD
new-page: true
view-if: social_patriot_launch_pending = 1

= A current becomes an organisation

Repeated welfare-conservative and sovereignty choices have brought regional
organisers, developmentalists and a small group of MPs into one room. They
refuse to remain an SLD label for somebody else's line. The founding congress
registers **Lewica Patriotyczna** as an organisation inside the common Left,
with its own programme, membership referrals and leadership slate.

- @social_patriot_matysiak
- @social_patriot_collective

@social_patriot_matysiak
title: Ask Paulina Matysiak to organise the founding leadership
subtitle: A recognisable developmental bridge gains authority; Razem resents the transfer.
on-arrival: social_patriot_launch_pending = 0; social_patriot_leader = "Paulina Matysiak"; matysiak_party = "Lewica Patriotyczna"; matysiak_status = "Social-Patriot organiser"; social_patriot_strength += 2; social_patriot_dissent -= 4; social_patriot_referrals += 2; razem_dissent += 5; local_network += 2; news_headline = "Matysiak leads the Lewica Patriotyczna founding slate"
go-to: return

@social_patriot_collective
title: Begin with a regional organisers' collective
subtitle: Broader local ownership, but no single national face.
on-arrival: social_patriot_launch_pending = 0; social_patriot_leader = "regional founding council"; matysiak_party = "Lewica Patriotyczna"; matysiak_status = "Social-Patriot organiser"; social_patriot_strength += 1; social_patriot_cohesion += 6; social_patriot_local_organisation += 6; social_patriot_referrals += 3; local_network += 3; media_capacity -= 1; news_headline = "Lewica Patriotyczna opens through a regional founding council"
go-to: return

@barons_crisis
title: The organisational establishment issues an ultimatum
subtitle: Regional structures can leave with seats, offices and a revived SLD label
new-page: true
view-if: barons_active = 1 and barons_escalation_stage = 2 and barons_demand_answered = 0

= The machine can walk

**[+ barons_name +]** has reached **[+ barons_dissent +]/100 dissent**. Its
regional officers control premises, experienced treasurers and a share of the
parliamentary delegation. After private leaks failed to move the leadership,
they demand **[+ barons_demand +]** by month **[+ barons_demand_deadline +]**.

- @barons_compromise
- @barons_leave
- @barons_punish

@barons_compromise
title: Grant a regional-organisation statute
subtitle: Cost: 1 resource. The machine stays; younger caucuses gain dissent.
choose-if: resources >= 1
unavailable-subtitle: The central party cannot finance and police the settlement.
on-arrival: resources -= 1; barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 0; barons_grievance_memory -= 18; barons_dissent -= 30; barons_strength += 2; local_network += 4; progressives_dissent += 5; labor_dissent += 2; party_unity += 2; news_headline = "A regional statute answers the establishment's deadline"
go-to: return

@barons_leave
title: Concede a free vote and autonomous regional line
subtitle: The organisation stays, but public criticism and whip-by-whip bargaining begin.
on-arrival: barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 3; barons_dissent -= 6; barons_grievance_memory += 2; party_unity -= 1; news_headline = "Regional barons win a free vote without yet leaving"
go-to: return

@barons_punish
title: Reject the deadline and threaten the regional boards
subtitle: The demand fails; rebellion and a leadership challenge become the next stage.
on-arrival: barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 3; barons_dissent += 8; barons_grievance_memory += 12; party_unity -= 3; local_network -= 2; news_headline = "The leadership rejects the regional ultimatum"
go-to: return

