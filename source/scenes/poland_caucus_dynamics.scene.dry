title: Dynamic Left caucuses

@router
new-page: true
call: poland_normalize
go-to: barons_crisis if barons_active = 1 and barons_escalation_stage = 2 and barons_demand_answered = 0 and time >= barons_demand_deadline and caucus_split_pending = 0; spring_crisis if spring_active = 1 and spring_escalation_stage = 2 and spring_demand_answered = 0 and time >= spring_demand_deadline and caucus_split_pending = 0; labor_crisis if labor_active = 1 and labor_escalation_stage = 2 and labor_demand_answered = 0 and time >= labor_demand_deadline and caucus_split_pending = 0; progressives_crisis if progressives_active = 1 and progressives_escalation_stage = 2 and progressives_demand_answered = 0 and time >= progressives_demand_deadline and caucus_split_pending = 0; razem_crisis if razem_active = 1 and razem_escalation_stage = 2 and razem_demand_answered = 0 and time >= razem_demand_deadline and caucus_split_pending = 0; pps_crisis if pps_active = 1 and pps_escalation_stage = 2 and pps_demand_answered = 0 and time >= pps_demand_deadline and caucus_split_pending = 0; barons_split if barons_active = 1 and barons_escalation_stage >= 7; spring_split if spring_active = 1 and spring_escalation_stage >= 7; labor_split if labor_active = 1 and labor_escalation_stage >= 7; progressives_split if progressives_active = 1 and progressives_escalation_stage >= 7; razem_split if razem_active = 1 and razem_escalation_stage >= 7; pps_split if pps_active = 1 and pps_escalation_stage >= 7; return

@barons_crisis
title: The organisational establishment issues an ultimatum
subtitle: Regional structures can leave with seats, offices and a revived SLD label
new-page: true
view-if: barons_active = 1 and barons_escalation_stage = 2 and barons_demand_answered = 0

= The machine can walk

**[+ barons_name +]** has reached **[+ barons_dissent +]/100 dissent**. Its
regional officers control premises, experienced treasurers and a share of the
parliamentary delegation. After private leaks failed to move the leadership,
they demand **[+ barons_demand +]** by month **[+ barons_demand_deadline +]**.

- @barons_compromise
- @barons_leave
- @barons_punish

@barons_compromise
title: Grant a regional-organisation statute
subtitle: Cost: 1 resource. The machine stays; younger caucuses gain dissent.
choose-if: resources >= 1
unavailable-subtitle: The central party cannot finance and police the settlement.
on-arrival: resources -= 1; barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 0; barons_grievance_memory -= 18; barons_dissent -= 30; barons_strength += 2; local_network += 4; progressives_dissent += 5; labor_dissent += 2; party_unity += 2; news_headline = "A regional statute answers the establishment's deadline"
go-to: return

@barons_leave
title: Concede a free vote and autonomous regional line
subtitle: The organisation stays, but public criticism and whip-by-whip bargaining begin.
on-arrival: barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 3; barons_dissent -= 6; barons_grievance_memory += 2; party_unity -= 1; news_headline = "Regional barons win a free vote without yet leaving"
go-to: return

@barons_punish
title: Reject the deadline and threaten the regional boards
subtitle: The demand fails; rebellion and a leadership challenge become the next stage.
on-arrival: barons_last_crisis_time = time; barons_demand_answered = 1; barons_escalation_stage = 3; barons_dissent += 8; barons_grievance_memory += 12; party_unity -= 3; local_network -= 2; news_headline = "The leadership rejects the regional ultimatum"
go-to: return

@spring_crisis
title: Wiosna threatens to restore its own party
subtitle: The equality brand can leave with media access and recognisable candidates
new-page: true
view-if: spring_active = 1 and spring_escalation_stage = 2 and spring_demand_answered = 0

= Spring is not only a component

**[+ spring_name +]** has reached **[+ spring_dissent +]/100 dissent**. Its
leaders argue that parity has become ceremonial. After private briefings went
unanswered, they demand **[+ spring_demand +]** by month **[+ spring_demand_deadline +]**.

- @spring_compromise
- @spring_leave
- @spring_punish

@spring_compromise
title: Guarantee equality-policy ownership and list parity
subtitle: Cost: 1 resource. Wiosna stays; the establishment loses control.
choose-if: resources >= 1
unavailable-subtitle: A national equality and candidate process cannot be funded.
on-arrival: resources -= 1; spring_last_crisis_time = time; spring_demand_answered = 1; spring_escalation_stage = 0; spring_grievance_memory -= 18; spring_dissent -= 32; spring_strength += 2; progressive_credibility += 4; media_capacity += 3; barons_dissent += 5; party_unity += 3; news_headline = "Policy ownership answers Wiosna's deadline"
go-to: return

@spring_leave
title: Allow Wiosna a free vote and separate media line
subtitle: Public criticism becomes legitimate, but no independent list exists yet.
on-arrival: spring_last_crisis_time = time; spring_demand_answered = 1; spring_escalation_stage = 3; spring_dissent -= 6; spring_grievance_memory += 2; party_unity -= 1; news_headline = "Wiosna wins a public autonomous line without leaving"
go-to: return

@spring_punish
title: Reject parity and threaten the Wiosna nominations
subtitle: The deadline fails; rebellion and refusal to whip become likely.
on-arrival: spring_last_crisis_time = time; spring_demand_answered = 1; spring_escalation_stage = 3; spring_dissent += 8; spring_grievance_memory += 12; party_unity -= 3; progressive_credibility -= 2; news_headline = "The leadership rejects Wiosna's parity deadline"
go-to: return

@labor_crisis
title: The labour current withdraws its whip
subtitle: Union endorsements, workplace organisers and public-service deputies are at stake
new-page: true
view-if: labor_active = 1 and labor_escalation_stage = 2 and labor_demand_answered = 0

= No labour party without labour

**[+ labor_name +]** has reached **[+ labor_dissent +]/100 dissent**. Union
figures and public-service organisers have turned private complaints into a
demand for **[+ labor_demand +]** by month **[+ labor_demand_deadline +]**.

- @labor_compromise
- @labor_leave
- @labor_punish

@labor_compromise
title: Sign a union-ratified wages and services protocol
subtitle: Adds two budget promises. Labour stays and recovers credibility.
on-arrival: labor_last_crisis_time = time; labor_demand_answered = 1; labor_escalation_stage = 0; labor_grievance_memory -= 20; labor_dissent -= 34; labor_strength += 2; budget_promises += 2; labor_credibility += 5; workers_support += 3; barons_dissent += 3; party_unity += 3; news_headline = "A union-ratified protocol answers Labour's deadline"
go-to: return

@labor_leave
title: Recognise a free labour vote and union policy line
subtitle: The current stays inside while openly reserving its parliamentary votes.
on-arrival: labor_last_crisis_time = time; labor_demand_answered = 1; labor_escalation_stage = 3; labor_dissent -= 7; labor_grievance_memory += 2; party_unity -= 1; news_headline = "Labour wins a free vote without forming a separate club"
go-to: return

@labor_punish
title: Reject the protocol and replace union nominees
subtitle: The deadline fails; the labour current prepares to refuse the whip.
on-arrival: labor_last_crisis_time = time; labor_demand_answered = 1; labor_escalation_stage = 3; labor_dissent += 9; labor_grievance_memory += 13; party_unity -= 3; labor_credibility -= 3; news_headline = "The leadership rejects Labour's enforceable protocol"
go-to: return

