@pps_leave
title: Permit an autonomous PPS vote
subtitle: The historic partner stays, but publicly reserves its parliamentary line.
on-arrival: pps_last_crisis_time = time; pps_demand_answered = 1; pps_escalation_stage = 3; pps_dissent -= 8; pps_grievance_memory += 2; party_unity -= 1; news_headline = "PPS wins an autonomous vote without registering a list"
go-to: return

@pps_punish
