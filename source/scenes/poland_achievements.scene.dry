];
const escapeAchievementHtml = function(value) {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;");
};
const achievementRow = function(achievement) {
    const current = Q["game_achievement_" + achievement[0]] === 1;
    const unlocked = Q["achievement_" + achievement[0]] === 1;
    const stateClass = current ? "is-current" : (unlocked ? "is-earned" : "is-locked");
    const stateLabel = current ? "✓ This run" : (unlocked ? "✓ Earned" : "□ Locked");
    return "<tr class=\"" + stateClass + "\"><td class=\"achievement-table-status\">" +
        stateLabel + "</td><td><strong class=\"achievement-table-name\">" +
        escapeAchievementHtml(achievement[2]) +
        "</strong><small class=\"achievement-table-requirement\">" +
        escapeAchievementHtml(achievement[3]) + "</small></td></tr>";
};
Q.achievement_unlocked_count = achievements.filter(function(achievement) {
    return Q["achievement_" + achievement[0]] === 1;
}).length;
Q.achievement_total_count = achievements.length;
Q.achievement_percent_complete = Math.round(
    Q.achievement_unlocked_count / Q.achievement_total_count * 100
);
Q.achievement_catalogue_html =
    "<table class=\"achievement-table\"><thead><tr><th>Status</th>" +
    "<th>Achievement</th></tr></thead><tbody>" +
    achievements.map(achievementRow).join("") + "</tbody></table>";
if (typeof window !== "undefined" && window.requestAnimationFrame) {
    window.requestAnimationFrame(function() {
        const catalogueList = document.getElementById("achievement-catalogue-list");
        if (catalogueList) {
            catalogueList.innerHTML = Q.achievement_catalogue_html;
        }
    });
}
!}

= Achievements

**[+ achievement_unlocked_count +] / [+ achievement_total_count +] unlocked
([+ achievement_percent_complete +]%)**

Achievements persist between playthroughs. “This run” marks achievements
earned in the current campaign; “Earned” marks achievements from earlier runs.

{! <div id="achievement-catalogue-list"></div> !}

