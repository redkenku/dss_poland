Q.cabinet_psl_loss = 0;
Q.cabinet_left_loss = Math.min(
    Math.max(0, Number(Q.razem_seats) || 0),
    Math.max(0, Number(Q.candidate_left_votes) || 0)
);
if (Q.ministry_psl_in_cabinet) Q.psl_coalition_dissent -= 5;
else if (Q.candidate_psl_votes > 0) Q.psl_relation += 3;
if (Q.ministry_p2050_in_cabinet) Q.p2050_coalition_dissent -= 3;
else if (Q.candidate_p2050_votes > 0) Q.p2050_relation += 2;
if (Q.ministry_ko_in_cabinet) Q.ko_coalition_dissent -= 4;
Q.razem_dissent += 15;
Q.labor_credibility -= 5;
Q.constitutional_restraint += 4;
Q.institutional_trust += 3;
Q.news_headline = Q.cabinet_left_loss > 0
    ? "Razem refuses a cabinet programme without a social floor"
    : "The cabinet narrows its programme to institutional repair";
!}
go-to: cabinet_confidence_roll

