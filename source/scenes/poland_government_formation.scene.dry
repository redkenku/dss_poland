@formation_pm_alt_roll
title: Verify the nominee's coalition support
new-page: true
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const coalitionCode = String(Q.formation_coalition_code || "none");
const baseCoalitionCode = coalitionCode.replace(/_tolerated$/, "");
const formalMembers = Array.isArray(Q.formation_coalition_members)
    ? Q.formation_coalition_members : [];
const koSeats = Math.max(0, Number(Q.ko_seats) || 0);
const p2050Seats = Math.max(0, Number(Q.p2050_seats) || 0);
const pslSeats = Math.max(0, Number(Q.psl_seats) || 0);
const leftSeats = Math.max(0, Number(Q.left_committed_seats) || 0);
const outsideSupport = Math.max(
    0,
    (Number(Q.formation_coalition_support_seats) || 0) -
        (Number(Q.formation_coalition_seats) || 0)
);
const playerSupports = Boolean(Q.formation_player_in_government) ||
    Boolean(Q.formation_player_toleration);
let koVotes = formalMembers.includes("ko") ? koSeats : 0;
let p2050Votes = formalMembers.includes("p2050") ? p2050Seats : 0;
let pslVotes = formalMembers.includes("psl") ? pslSeats : 0;
if (!formalMembers.length && baseCoalitionCode == "democratic_2023") {
    koVotes = koSeats;
    p2050Votes = p2050Seats;
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "ko_psl_left") {
    koVotes = koSeats;
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "ko_p2050_left") {
    koVotes = koSeats;
    p2050Votes = p2050Seats;
} else if (!formalMembers.length && baseCoalitionCode == "third_left_pis") {
    p2050Votes = p2050Seats;
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "ko_left") {
    koVotes = koSeats;
} else if (!formalMembers.length && baseCoalitionCode == "pis_konf_third") {
    p2050Votes = p2050Seats;
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "pis_konf_psl") {
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "ko_third") {
    koVotes = koSeats;
    p2050Votes = p2050Seats;
    pslVotes = pslSeats;
} else if (!formalMembers.length && baseCoalitionCode == "ko_konf") {
    koVotes = koSeats;
}
if (baseCoalitionCode == "ko_psl_left") {
    p2050Votes = Math.min(p2050Seats, outsideSupport);
} else if (baseCoalitionCode == "ko_p2050_left") {
    pslVotes = Math.min(pslSeats, outsideSupport);
} else if (baseCoalitionCode == "ko_left") {
    p2050Votes = Math.min(p2050Seats, outsideSupport);
    pslVotes = Math.min(pslSeats, outsideSupport - p2050Votes);
}
Q.candidate_ko_votes = koVotes;
Q.candidate_p2050_votes = p2050Votes;
Q.candidate_psl_votes = pslVotes;
Q.candidate_psl_cap = pslVotes;
Q.candidate_centrum_votes = 0;
Q.candidate_left_votes = playerSupports ? leftSeats : 0;
const candidate = String(Q.democratic_candidate || "");
const candidateFamilies = {
    "Mateusz Morawiecki": "pis", "Beata Szydło": "pis",
    "Przemysław Czarnek": "pis", "Henryk Kowalczyk": "pis",
    "Władysław Kosiniak-Kamysz": "psl", "Piotr Zgorzelski": "psl",
    "Krzysztof Hetman": "psl", "Szymon Hołownia": "p2050",
    "Katarzyna Pełczyńska-Nałęcz": "p2050",
    "Paulina Hennig-Kloska": "p2050", "Leszek Miller": "lewica",
    "Dariusz Wieczorek": "lewica", "Monika Jaruzelska": "lewica",
    "Agnieszka Dziemianowicz-Bąk": "lewica", "Magdalena Biejat": "lewica",
    "Krzysztof Gawkowski": "lewica", "Katarzyna Kotula": "lewica",
    "Włodzimierz Czarzasty": "lewica", "Donald Tusk": "ko",
    "Rafał Trzaskowski": "ko", "Barbara Nowacka": "ko",
    "Radosław Sikorski": "ko", "Sławomir Mentzen": "konf",
    "Krzysztof Bosak": "konf"
};
let candidateParty = candidateFamilies[candidate] || "";
if (!candidateParty && candidate == String(Q.prime_minister_left_nominee || "")) {
    candidateParty = "lewica";
}
if (!candidateParty && candidate == String(Q.ko_leader || "")) {
    candidateParty = "ko";
}
if (!candidateParty && candidate == String(Q.psl_leader || "")) {
    candidateParty = "psl";
}
if (!candidateParty && candidate == String(Q.p2050_leader || "")) {
    candidateParty = "p2050";
}
if (!candidateParty && candidate == String(Q.formation_pm_pis_name || "")) {
    candidateParty = "pis";
}
if (!candidateParty && candidate == String(Q.formation_pm_p2050_name || "")) {
    candidateParty = "p2050";
}
Q.formation_pm_candidate_party = candidateParty ||
    String(Q.formation_government_party || "other");
Q.democratic_candidate_party = Q.formation_pm_candidate_party;
Q.prime_minister_party = Q.formation_pm_candidate_party;
const contractSupport = Math.max(
    0,
    Math.min(
        sejmTotal,
        Math.round(Number(Q.formation_coalition_support_seats) || 0)
    )
);
const candidateLoss = Math.max(
    0,
    Math.min(
        contractSupport,
        Math.round(Number(Q.formation_pm_candidate_loss) || 0)
    )
);
Q.formation_pm_candidate_support = contractSupport - candidateLoss;
Q.confidence_stage = Q.presidential_majority_designation ? 1 : 2;
Q.confidence_mode =
    "Pre-appointment whip count — coalition contract support";
Q.confidence_yes = Q.formation_pm_candidate_support;
Q.confidence_no = Math.max(0, sejmTotal - contractSupport);
Q.confidence_abstain = candidateLoss;
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Math.floor(Q.confidence_present / 2) + 1;
Q.candidate_vote_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes >= Q.confidence_threshold ? 1 : 0;
Q.democratic_votes = Q.confidence_yes;
Q.news_headline = Q.candidate_vote_passed
    ? Q.democratic_candidate + " shows an appointable coalition majority"
    : Q.democratic_candidate + " cannot hold the selected coalition together";
!}

= The signed whip count

This is not a second constitutional vote. It verifies that the coalition,
outside supporters and nominee-specific defectors still leave an appointable
cabinet. The whole ministerial slate and programme will face the one confidence
vote required by the applicable Article 154 stage.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Whip
count</div>
<div class="ledger-row"><span>Candidate</span><b>[+ confidence_candidate +]</b></div>
<div class="ledger-row"><span>Pledged yes</span><b>[+ confidence_yes +]</b></div>
<div class="ledger-row"><span>Declared against</span><b>[+ confidence_no +]</b></div>
<div class="ledger-row"><span>Withholding</span><b>[+ confidence_abstain +]</b></div>
<div class="ledger-row"><span>Needed for cabinet confidence</span><b>[+ confidence_threshold +]</b></div></div>

- @formation_pm_alt_continue: Continue

@formation_pm_alt_continue
title: Continue to the coalition outcome
go-to: formation_pm_alt_success if candidate_vote_passed = 1; formation_selected_first_attempt_fails if candidate_vote_passed = 0 and presidential_majority_designation = 1 and formation_coalition_selected = 1; presidential_first_fails if candidate_vote_passed = 0 and presidential_majority_designation = 1; third_attempt if candidate_vote_passed = 0 and presidential_majority_designation = 0

@formation_pm_alt_success
title: The selected coalition secures an appointable nominee
new-page: true
on-arrival: {!
let formationMembers = Array.isArray(Q.formation_coalition_members)
    ? Q.formation_coalition_members
    : [];
if (!formationMembers.length) {
    const code = String(Q.formation_coalition_code || "none")
        .replace(/_tolerated$/, "");
    formationMembers = ({
        democratic_2023: ["ko", "p2050", "psl", "lewica"],
        ko_psl_left: ["ko", "psl", "lewica"],
        ko_p2050_left: ["ko", "p2050", "lewica"],
        left_p2050: ["p2050", "lewica"],
        left_psl: ["psl", "lewica"],
        left_third: ["p2050", "psl", "lewica"],
        third_left_pis: ["p2050", "psl", "lewica"],
        ko_left: ["ko", "lewica"],
        left_only: ["lewica"],
        pis_konf_third: ["pis", "konf", "p2050", "psl"],
        pis_konf_psl: ["pis", "konf", "psl"],
        ko_third: ["ko", "p2050", "psl"],
        ko_konf: ["ko", "konf"]
    })[code] || [];
    Q.formation_coalition_members = formationMembers;
}
Q.left_cabinet_committed = Q.formation_player_in_government ? 1 : 0;
Q.left_cabinet_model = Q.left_cabinet_committed
    ? "Formation coalition cabinet"
    : (Q.formation_player_toleration
        ? "Confidence and supply from opposition"
        : "Parliamentary opposition");
Q.coalition_status = Q.formation_coalition_label + " cabinet proposal";
Q.coalition_seats = Math.max(
    0,
    Number(Q.formation_coalition_seats) || 0
);
Q.ministry_return_mode = "cabinet_program";
Q.ministries_finalized = Q.formation_player_in_government ? 0 : 1;
Q.ministry_allocation_mode = Q.formation_player_in_government
    ? "formation" : "settled";
Q.cabinet_ko_loss = 0;
Q.cabinet_p2050_loss = 0;
Q.cabinet_psl_loss = 0;
Q.cabinet_left_loss = 0;
Q.cabinet_pis_loss = 0;
Q.cabinet_konf_loss = 0;
Q.ministry_pis_in_cabinet = formationMembers.includes("pis") ? 1 : 0;
Q.ministry_ko_in_cabinet = formationMembers.includes("ko") ? 1 : 0;
Q.ministry_psl_in_cabinet = formationMembers.includes("psl") ? 1 : 0;
Q.ministry_p2050_in_cabinet = formationMembers.includes("p2050") ? 1 : 0;
Q.ministry_konf_in_cabinet = formationMembers.includes("konf") ? 1 : 0;
!}

= A nominee is not yet a government

The coalition agreement, Marshal ballot and whip count now align. The outgoing
cabinet remains caretaker until **[+ democratic_candidate +]** presents a full
ministerial slate and programme and wins the single constitutional confidence
vote.

[? if formation_player_in_government = 1: Lewica is promised ministries, so its
portfolios must be allocated before the programme is read from the rostrum.?]
[? if formation_player_in_government = 0: Lewica remains outside. It will vote
on the cabinet agreement without receiving ministries or government budget
authority.?]

- @formation_pm_alt_success_continue: Assemble the cabinet and proceed

@formation_pm_alt_success_continue
title: Continue from the nominee whip count
go-to: poland_ministries

@formation_external_cabinet_program
title: The outside-support cabinet presents its agreement
new-page: true
on-arrival: {!
Q.cabinet_program = Q.formation_player_toleration
    ? "Coalition contract with a written toleration protocol"
    : "Formal coalition contract without player participation";
Q.cabinet_ko_loss = 0;
Q.cabinet_p2050_loss = 0;
Q.cabinet_psl_loss = 0;
Q.cabinet_left_loss = 0;
Q.cabinet_pis_loss = 0;
Q.cabinet_konf_loss = 0;
Q.news_headline = "The proposed cabinet presents its contract to the Sejm";
!}

= Confidence without fictional ministries

The listed coalition parties present their ministers. Lewica has no portfolios
and no collective cabinet responsibility. A toleration promise, where one was
signed, contributes votes to confidence but does not turn the player into a
governing party.

- @cabinet_confidence_roll: Proceed to the cabinet confidence vote

@cabinet_program
title: One exposé, several coalition readings
new-page: true

= From a candidate to a cabinet

The prime-minister-elect must present ministers and a programme. Every party
that supplied the whip count now reads the agreement through its own mandate.
Social deadlines can secure the Left while testing any centrist votes pledged
to the cabinet; institutional minimalism can reassure the cabinet centre while
losing part of the social wing; a territorial opening can broaden the
government's reach while angering progressives.

