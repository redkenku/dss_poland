@move_to_budget
title: The first full governing year
view-if: left_in_government = 1
on-arrival: year = 2024; month = 12; month_name = "December"; date_label = "December 2024"; next_budget_label = "December 2024"; budget_cycle_year = 2025; news_headline = "The coalition reaches its first full annual budget"
