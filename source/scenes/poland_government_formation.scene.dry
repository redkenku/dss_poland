@third_reassemble
title: Reassemble the democratic bloc around Tusk and a smaller programme
subtitle: Lewica enters the cabinet; up to seven nervous deputies abstain.
on-arrival: {!
const democraticSeats =
    Math.max(0, Number(Q.ko_seats) || 0) +
    Math.max(0, Number(Q.p2050_seats) || 0) +
    Math.max(0, Number(Q.centrum_seats) || 0) +
    Math.max(0, Number(Q.psl_seats) || 0) +
    Math.max(0, Number(Q.left_committed_seats) || 0);
const fallbackRightSeats =
    Math.max(0, Number(Q.pis_seats) || 0) +
    Math.max(0, Number(Q.konf_seats) || 0) +
    Math.max(0, Number(Q.rozwoj_seats) || 0) +
    Math.max(0, Number(Q.korona_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const rightSeats = Math.max(
    0,
    Number.isFinite(Number(Q.coalition_right_seats))
        ? Number(Q.coalition_right_seats)
        : fallbackRightSeats
);
const democraticAbstentions = Math.min(7, democraticSeats);
const rightAbsences = Math.min(
    Math.max(0, Math.round(Number(Q.candidate_right_absent) || 0)),
    rightSeats
);
Q.third_candidate = "Donald Tusk";
Q.third_yes = democraticSeats - democraticAbstentions;
Q.third_no = rightSeats - rightAbsences;
Q.third_abstain = Math.max(
    0,
    (Number(Q.sejm_total) || 460) - rightAbsences -
        Q.third_yes - Q.third_no
);
Q.third_left_cabinet = 1;
Q.left_cabinet_committed = 1;
Q.left_cabinet_model = "Whole Left coalition delegation";
Q.candidate_ko_votes = Q.ko_seats;
Q.candidate_p2050_votes = Q.p2050_seats;
Q.candidate_psl_votes = Q.psl_seats;
Q.candidate_left_votes = Q.left_committed_seats;
Q.formation_psl_cabinet_committed = 1;
Q.ministries_finalized = 0;
Q.ministry_return_mode = "governing_agreement";
Q.news_headline =
    "The democratic parties try once more under simple-majority rules";
!}
go-to: third_confidence_roll

@third_presidential_compromise
title: Court the Palace for a Kosiniak-Kamysz compromise
subtitle: A broad cabinet containing Lewica, with up to twelve abstentions.
view-if: president_name != "Władysław Kosiniak-Kamysz"
choose-if: presidential_channel_open = 1 or president_relation >= 28
