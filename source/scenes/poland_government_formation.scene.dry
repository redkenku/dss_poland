on-arrival: {!
const democraticSeats =
    Math.max(0, Number(Q.ko_seats) || 0) +
    Math.max(0, Number(Q.p2050_seats) || 0) +
    Math.max(0, Number(Q.centrum_seats) || 0) +
    Math.max(0, Number(Q.psl_seats) || 0) +
    Math.max(0, Number(Q.left_committed_seats) || 0);
const fallbackRightSeats =
    Math.max(0, Number(Q.pis_seats) || 0) +
    Math.max(0, Number(Q.konf_seats) || 0) +
    Math.max(0, Number(Q.rozwoj_seats) || 0) +
    Math.max(0, Number(Q.korona_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const rightSeats = Math.max(
    0,
    Number.isFinite(Number(Q.coalition_right_seats))
        ? Number(Q.coalition_right_seats)
        : fallbackRightSeats
);
const democraticAbstentions = Math.min(12, democraticSeats);
Q.third_candidate = "Władysław Kosiniak-Kamysz";
Q.third_yes = democraticSeats - democraticAbstentions;
Q.third_no = rightSeats;
Q.third_abstain = Math.max(
    0,
    (Number(Q.sejm_total) || 460) - Q.third_yes - Q.third_no
);
Q.third_left_cabinet = 1;
Q.left_cabinet_committed = 1;
Q.left_cabinet_model = "New Left ministers · Razem external support";
Q.candidate_ko_votes = Q.ko_seats;
Q.candidate_p2050_votes = Q.p2050_seats;
Q.candidate_psl_votes = Q.psl_seats;
Q.candidate_left_votes = Q.left_committed_seats;
Q.formation_psl_cabinet_committed = 1;
Q.ministries_finalized = 0;
Q.ministry_return_mode = "governing_agreement";
Q.president_relation += 10;
Q.psl_relation += 8;
Q.ko_relation -= 5;
Q.news_headline = "The Palace accepts a broad Kosiniak-Kamysz cabinet";
!}
go-to: third_confidence_roll

@third_morawiecki_toleration
title: Let PSL tolerate a Morawiecki minority
subtitle: PiS and most PSL deputies vote yes; Lewica and much of the centre abstain.
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const pslSupport = Math.min(22, Math.max(0, Number(Q.psl_seats) || 0));
const pisBloc =
    Math.max(0, Number(Q.pis_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const leftOpposition = Math.max(
    0,
    Number(Q.left_committed_seats) || Number(Q.left_seats) || 0
);
Q.third_candidate = "Mateusz Morawiecki";
Q.third_yes = Math.min(sejmTotal, pisBloc + pslSupport);
Q.third_no = Math.min(
    sejmTotal - Q.third_yes,
    Math.max(0, Number(Q.ko_seats) || 0) + leftOpposition +
        Math.min(7, Math.max(0, Number(Q.p2050_seats) || 0))
);
Q.third_abstain = Math.max(
    0,
    sejmTotal - Q.third_yes - Q.third_no
);
Q.third_left_cabinet = 0;
Q.party_unity -= 8;
Q.psl_relation -= 12;
Q.far_right_agenda += 4;
Q.news_headline = "Simple-majority arithmetic rescues a Morawiecki minority";
!}
go-to: third_confidence_roll

