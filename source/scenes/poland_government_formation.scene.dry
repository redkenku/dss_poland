title: The 2023 transfer of power

@campaign_entry
title: October 2023 — certify the new Sejm
new-page: true
on-arrival: {!
const finiteFormation = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const apportionFormation = function(total, entries) {
    const safeTotal = Math.max(0, Math.round(finiteFormation(total, 0)));
    const weights = entries.map(function(entry) {
        return {
            id: entry.id,
            weight: Math.max(0, finiteFormation(entry.weight, 0))
        };
    });
    let weightTotal = weights.reduce(function(sum, entry) {
        return sum + entry.weight;
    }, 0);
    if (weightTotal <= 0) {
        weightTotal = weights.length;
        for (const entry of weights) entry.weight = 1;
    }
    const allocated = {};
    const remainders = [];
    let used = 0;
    for (const entry of weights) {
        const exact = safeTotal * entry.weight / weightTotal;
        const base = Math.floor(exact);
        allocated[entry.id] = base;
        used += base;
        remainders.push({
            id: entry.id,
            remainder: exact - base
        });
    }
    remainders.sort(function(a, b) {
        if (b.remainder != a.remainder) {
            return b.remainder - a.remainder;
        }
        return a.id < b.id ? -1 : 1;
    });
    for (let i = 0; i < safeTotal - used; i += 1) {
        allocated[remainders[i % remainders.length].id] += 1;
    }
    return allocated;
};

Q.started = 1;
Q.prototype_complete = 0;
Q.continuous_campaign = 1;
Q.formation_entry_mode = "continuous";
Q.formation_continuous = 1;
Q.formation_requested = 1;
Q.formation_in_progress = 1;
Q.formation_return_ready = 0;
Q.formation_complete = 0;
Q.formation_outcome_score = 0;
Q.election_2023_certified = 1;
Q.post_formation_return_pending = 0;

// This entry is deliberately not a new-game setup. Party resources, the
// agenda hand, advisors, factional history, rival AI, ideology, relations,
// presidential history and the judicial record all remain untouched.
Q.year = 2023;
Q.month = 10;
Q.month_name = "October";
Q.date_label = "October 2023";
Q.position = "Parliamentary opposition";
Q.prime_minister = "Mateusz Morawiecki";
Q.government_name = "Outgoing PiS caretaker cabinet";
Q.caretaker_government = 1;
Q.government_has_confidence = 0;
Q.left_in_government = 0;
Q.budget = 0;
Q.budget_authority = "Opposition — no state spending authority";
Q.coalition_broken = 0;
Q.coalition_status = "No new cabinet has won confidence";
Q.coalition_seats = 0;
Q.sejm_total = 460;
Q.sejm_quorum_floor = 230;
Q.sejm_statutory_majority = 231;

const partyIds = [
    "pis", "ko", "p2050", "psl", "left", "konf", "other"
];
const projectedEntries = partyIds.map(function(id) {
    return {
        id: id,
        weight: finiteFormation(Q[id + "_projected_seats"], 0)
    };
});
let projectedTotal = projectedEntries.reduce(function(sum, entry) {
    return sum + Math.max(0, Math.round(entry.weight));
}, 0);
let certified;
if (projectedTotal > 0) {
    certified = apportionFormation(Q.sejm_total, projectedEntries);
} else {
    certified = apportionFormation(
        Q.sejm_total,
        partyIds.map(function(id) {
            return {
                id: id,
                weight: finiteFormation(
                    Q[id + "_vote_intent"],
                    finiteFormation(Q[id + "_poll"], 0)
                )
            };
        })
    );
}
for (const id of partyIds) {
    Q[id + "_seats"] = certified[id];
    Q[id + "_projected_seats"] = certified[id];
    Q["election_2023_" + id + "_vote"] = finiteFormation(
        Q[id + "_vote_intent"],
        finiteFormation(Q[id + "_poll"], 0)
    );
}

const leftCaucuses = apportionFormation(Q.left_seats, [
    {id: "barons", weight: 6},
    {id: "new_generation", weight: 8},
    {id: "spring", weight: 5},
    {id: "razem", weight: 7}
]);
Q.left_barons_seats = leftCaucuses.barons;
Q.left_new_generation_seats = leftCaucuses.new_generation;
Q.left_spring_seats = leftCaucuses.spring;
Q.razem_seats = leftCaucuses.razem;
Q.nowa_lewica_seats = Math.max(0, Q.left_seats - Q.razem_seats);

const pslCaucuses = apportionFormation(Q.psl_seats, [
    {id: "core", weight: 19},
    {id: "regional", weight: 11},
    {id: "conservative", weight: 2}
]);
Q.psl_core_seats = pslCaucuses.core;
Q.psl_regional_seats = pslCaucuses.regional;
Q.psl_conservative_seats = pslCaucuses.conservative;

const p2050Caucuses = apportionFormation(Q.p2050_seats, [
    {id: "loyalist", weight: 20},
    {id: "liberal", weight: 10},
    {id: "independent", weight: 3}
]);
Q.p2050_loyalist_seats = p2050Caucuses.loyalist;
Q.p2050_liberal_seats = p2050Caucuses.liberal;
Q.p2050_independent_seats = p2050Caucuses.independent;

Q.coalition_democratic_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats + Q.left_seats;
Q.coalition_center_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats;
Q.coalition_right_seats = Q.pis_seats + Q.konf_seats;
Q.coalition_pis_psl_seats = Q.pis_seats + Q.psl_seats;
Q.seat_subvention_seats = Q.left_seats;
Q.seat_subvention = Q.left_seats > 0
    ? Math.max(1, Math.round(Q.left_seats / 25))
    : 0;
Q.party_income =
    Math.max(0, finiteFormation(Q.member_dues, 0)) + Q.seat_subvention;

// The Senate currently has no election simulator. Certify its historical
// 2023 composition while retaining all campaign-built institutional scores.
Q.senate_total = 100;
Q.senate_pis_seats = 34;
Q.senate_ko_seats = 41;
Q.senate_psl_seats = 11;
Q.senate_left_seats = 9;
Q.senate_independent_seats = 5;
Q.senate_opposition_seats = 66;
Q.senate_working_votes = 66;
Q.senate_marshal = "Małgorzata Kidawa-Błońska";
Q.senate_control = "Democratic coalition majority";

Q.election_summary_seen = 0;
Q.election_coalition_seen = 0;
Q.election_2023_seen = 0;
Q.confidence_stage = 0;
Q.confidence_mode = "Government formation has not begun";
Q.confidence_candidate = "None";
Q.confidence_present = 0;
Q.confidence_threshold = 0;
Q.confidence_yes = 0;
Q.confidence_no = 0;
Q.confidence_abstain = 0;
Q.morawiecki_votes = 0;
Q.democratic_votes = 0;
Q.democratic_candidate = "Undecided";
Q.democratic_pact = "Not negotiated";
Q.early_election_risk = 0;
Q.first_psl_yes = 0;
Q.first_psl_abstain = 0;
Q.first_left_yes = 0;
Q.first_left_abstain = 0;
Q.first_konf_yes = 0;
Q.first_konf_abstain = 0;
Q.first_pis_absent = Math.min(4, Q.pis_seats);
Q.candidate_right_absent = Math.min(
    11,
    Q.pis_seats + Q.konf_seats
);
Q.first_confidence_passed = 0;
Q.formation_discipline = 0;
Q.presidential_channel_open = finiteFormation(
    Q.presidential_channel_open,
    0
);
Q.candidate_ko_votes = 0;
Q.candidate_p2050_votes = 0;
Q.candidate_psl_votes = 0;
Q.candidate_psl_cap = 0;
Q.candidate_left_votes = 0;
Q.candidate_vote_passed = 0;
Q.left_cabinet_committed = 0;
Q.left_cabinet_model = "Not negotiated";
Q.ministry_return_mode = "cabinet_program";
Q.ministries_finalized = 0;
Q.ministry_count = 0;
Q.cabinet_confidence_passed = 0;
Q.cabinet_program = "Not negotiated";
Q.coalition_break_threat = 0;
Q.news_headline =
    "The election certifies " + Q.coalition_democratic_seats +
    " democratic seats and " + Q.coalition_right_seats +
    " seats for PiS and Konfederacja";
!}
go-to: poland_election.results_2023

