@article160_roll
title: Confidence in the sitting cabinet
new-page: true
view-if: left_in_government = 1
on-arrival: {!
Q.confidence_stage = 5;
Q.confidence_mode = "Article 160 prime-ministerial confidence — simple majority";
Q.confidence_candidate = Q.prime_minister;
Q.confidence_yes =
    Math.max(0, Q.ko_seats) + Math.max(0, Q.p2050_seats) +
    Math.max(0, Q.centrum_seats) +
    Q.article160_left_yes + Q.article160_psl_yes;
Q.confidence_no =
    Math.max(0, Q.pis_seats) + Math.max(0, Q.konf_seats) +
    Math.max(0, Q.rozwoj_seats) + Math.max(0, Q.korona_seats) +
    Q.article160_left_no + Q.article160_psl_no;
Q.confidence_abstain = Math.max(
    0,
    Q.sejm_total - Q.confidence_yes - Q.confidence_no
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.article160_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
if (Q.article160_passed) {
    Q.government_has_confidence = 1;
    Q.news_headline = "The cabinet survives an Article 160 vote";
} else {
    Q.government_has_confidence = 0;
    Q.news_headline = "The prime minister loses an Article 160 vote";
}
!}

