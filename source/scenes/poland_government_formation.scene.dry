@article160_roll
title: Confidence in the sitting cabinet
new-page: true
view-if: left_in_government = 1
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const requestedYes =
    Math.max(0, Number(Q.ko_seats) || 0) +
    Math.max(0, Number(Q.p2050_seats) || 0) +
    Math.max(0, Number(Q.centrum_seats) || 0) +
    Math.max(0, Number(Q.article160_left_yes) || 0) +
    Math.max(0, Number(Q.article160_psl_yes) || 0);
const fallbackRightNo =
    Math.max(0, Number(Q.pis_seats) || 0) +
    Math.max(0, Number(Q.konf_seats) || 0) +
    Math.max(0, Number(Q.rozwoj_seats) || 0) +
    Math.max(0, Number(Q.korona_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const rightNo = Number.isFinite(Number(Q.coalition_right_seats))
    ? Math.max(0, Number(Q.coalition_right_seats))
    : fallbackRightNo;
const requestedNo = rightNo +
    Math.max(0, Number(Q.article160_left_no) || 0) +
    Math.max(0, Number(Q.article160_psl_no) || 0);
Q.confidence_stage = 5;
Q.confidence_mode = "Article 160 prime-ministerial confidence — simple majority";
Q.confidence_candidate = Q.prime_minister;
Q.confidence_yes = Math.min(sejmTotal, requestedYes);
Q.confidence_no = Math.min(
    sejmTotal - Q.confidence_yes,
    requestedNo
);
Q.confidence_abstain = Math.max(
    0,
    sejmTotal - Q.confidence_yes - Q.confidence_no
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.article160_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
Q.government_support_seats = Q.confidence_yes;
if (Q.article160_passed) {
    Q.government_has_confidence = 1;
    Q.news_headline = "The cabinet survives an Article 160 vote";
} else {
    Q.government_has_confidence = 0;
    Q.news_headline = "The prime minister loses an Article 160 vote";
}
!}

