@budget_internal_roll
title: The Left's internal budget congress
new-page: true
view-if: left_in_government = 1
on-arrival: {!
const formationBudgetProfiles = {
    1: {
        barons: 64, spring: 85, labor: 86,
        progressives: 82, razem: 92, pps: 88, social_patriot: 78
    },
    2: {
        barons: 76, spring: 75, labor: 82,
        progressives: 74, razem: 68, pps: 84, social_patriot: 86
    },
    3: {
        barons: 84, spring: 44, labor: 42,
        progressives: 52, razem: 18, pps: 35, social_patriot: 82
    },
    4: {
        barons: 55, spring: 54, labor: 52,
        progressives: 50, razem: 45, pps: 50, social_patriot: 55
    }
};
const formationBudgetProfile =
    formationBudgetProfiles[Q.annual_budget_package_code] ||
    formationBudgetProfiles[4];
const caucusSeatQualities = {
    barons: "left_barons_seats",
    spring: "left_spring_seats",
    labor: "left_labor_seats",
    progressives: "left_progressives_seats",
    razem: "razem_seats",
    pps: "left_pps_seats",
    social_patriot: "left_social_patriot_seats"
};
const formationBudgetCaucuses = Object.keys(caucusSeatQualities).filter(
    function(caucus) {
        return Math.max(0, Number(Q[caucusSeatQualities[caucus]]) || 0) > 0;
    }
);
let formationWeightedBacking = 0;
let formationActiveSeats = 0;
let formationVetoes = 0;
for (const caucus of formationBudgetCaucuses) {
    const backing = Math.max(
        0,
        Math.min(100, formationBudgetProfile[caucus])
    );
    const seats = Math.max(
        0,
        Number(Q[caucusSeatQualities[caucus]]) || 0
    );
    Q["budget_" + caucus + "_backing"] = backing;
    formationWeightedBacking += backing * seats;
    formationActiveSeats += seats;
    if (backing < 35 && seats > 0) formationVetoes += 1;
}
Q.budget_new_generation_backing = Math.round(
    (
        (Number(Q.budget_labor_backing) || 0) *
            (Number(Q.left_labor_seats) || 0) +
        (Number(Q.budget_progressives_backing) || 0) *
            (Number(Q.left_progressives_seats) || 0)
    ) / Math.max(1, Number(Q.left_new_generation_seats) || 0)
);
Q.annual_budget_internal_backing = Math.round(
    formationWeightedBacking / Math.max(1, formationActiveSeats)
);
Q.annual_budget_internal_vetoes = formationVetoes;
!}

= The caucus chairs answer

[? if annual_budget_internal_backing >= 55: Most of our deputies are ready to
defend the cabinet text.?][? if annual_budget_internal_backing < 55: The
package has not persuaded most of the Left caucus; ministers may own it before
their own deputies do.?] [? if annual_budget_internal_vetoes = 0: No organised
current has declared a veto.?][? if annual_budget_internal_vetoes = 1: One
current has declared that the bill is not its budget.?][? if
annual_budget_internal_vetoes > 1: Several currents are reserving public no
votes.?]

Their refusal cannot erase a minister's legal power. It can deny the cabinet
the votes and party mandate needed to use it.

- @budget_ratify_clean
- @budget_emergency_conference
- @budget_allow_rebels

@budget_ratify_clean
title: Ratify the common budget line
subtitle: Available with at least 55% weighted backing and no more than one caucus veto.
view-if: left_in_government = 1
choose-if: left_in_government = 1 and annual_budget_internal_backing >= 55 and annual_budget_internal_vetoes <= 1
unavailable-subtitle: The proposal lacks a usable internal mandate.
on-arrival: annual_budget_left_votes = left_seats; annual_budget_left_no = 0; party_unity += 3; left_coalition_dissent -= 3
go-to: budget_coalition_council

@budget_emergency_conference
title: Buy a night for an emergency programme conference
subtitle: Cost: 1 party resource. Recover four Left votes; the vetoing caucus publishes reservations.
view-if: left_in_government = 1
choose-if: left_in_government = 1 and resources >= 1
unavailable-subtitle: Requires cabinet participation and one party resource.
on-arrival: {!
Q.resources -= 1;
Q.annual_budget_internal_backing = Math.min(
    100,
    Math.max(0, Number(Q.annual_budget_internal_backing) || 0) + 8
);
Q.annual_budget_left_votes = Math.min(
    Q.left_seats,
    Math.round(
        Q.left_seats * Q.annual_budget_internal_backing / 100
    ) + 4
);
Q.annual_budget_left_no =
    Q.left_seats - Q.annual_budget_left_votes;
Q.party_unity += 1;
Q.left_coalition_dissent += 2;
Q.news_headline =
    "An all-night Left congress prevents a full budget split";
!}
go-to: budget_coalition_council

@budget_allow_rebels
title: Let each caucus vote its mandate
subtitle: Free. The cabinet keeps its bill but loses Left votes in public.
view-if: left_in_government = 1
on-arrival: {!
Q.annual_budget_left_votes = Math.round(
    Q.left_seats * Q.annual_budget_internal_backing / 100
);
Q.annual_budget_left_no =
    Q.left_seats - Q.annual_budget_left_votes;
Q.party_unity -= 4;
Q.left_coalition_dissent += 7;
Q.news_headline = "Left caucus rebels reserve their no votes";
!}
go-to: budget_coalition_council

@budget_coalition_council
title: PSL puts the budget beside the exit
new-page: true
view-if: left_in_government = 1

= The coalition stage

KO's **[+ ko_seats +] seats** contain fiscal hawks, local-government advocates,
conservatives and a liberal-left wing. Poland 2050's **[+ p2050_seats +]**
contain Hołownia loyalists and independent centrists. PSL's **[+ psl_seats +]**
arrive with a prepared statement threatening to leave unless rural investment
and cultural autonomy are protected.

The threat is credible because the democratic bloc has **[+
coalition_democratic_seats - psl_seats +] seats without PSL**. It is also
tactical because abstention can still let a budget pass by ordinary majority.

- @budget_psl_guarantee
- @budget_split_difference
- @budget_dare_psl
- @budget_ko_rewrite

@budget_psl_guarantee
title: Fund the rural guarantee and bind every PSL deputy
subtitle: Spend 1 governing capacity. The clean majority; Razem calls it permanent ransom.
view-if: left_in_government = 1
choose-if: left_in_government = 1 and budget >= 1
unavailable-subtitle: Requires cabinet participation and one remaining governing-capacity point.
on-arrival: {!
Q.budget -= 1;
Q.annual_budget_ko_votes = Math.max(0, Number(Q.ko_seats) || 0);
Q.annual_budget_p2050_votes = Math.max(0, Number(Q.p2050_seats) || 0);
Q.annual_budget_psl_votes = Math.max(0, Number(Q.psl_seats) || 0);
Q.annual_budget_psl_no = 0;
Q.annual_budget_psl_abstain = 0;
Q.psl_coalition_dissent -= 9;
Q.razem_dissent += 4;
Q.government_delivery += 3;
Q.coalition_budget_bargain = "Full rural guarantee";
!}
go-to: budget_sejm_roll

@budget_split_difference
title: Give PSL local delivery but no new cultural veto
subtitle: Up to eight PSL deputies abstain; the rest vote yes.
view-if: left_in_government = 1
on-arrival: {!
const pslSeats = Math.max(0, Number(Q.psl_seats) || 0);
const pslAbstentions = Math.min(8, pslSeats);
Q.annual_budget_ko_votes = Math.max(0, Number(Q.ko_seats) || 0);
Q.annual_budget_p2050_votes = Math.max(0, Number(Q.p2050_seats) || 0);
Q.annual_budget_psl_votes = pslSeats - pslAbstentions;
Q.annual_budget_psl_no = 0;
Q.annual_budget_psl_abstain = pslAbstentions;
Q.psl_coalition_dissent += 3;
Q.psl_relation -= 2;
Q.government_delivery += 2;
Q.coalition_budget_bargain = "Local delivery compromise";
!}
go-to: budget_sejm_roll

@budget_dare_psl
title: Dare PSL to vote with PiS and Konfederacja
subtitle: If PSL dissent is high, its whole club votes no; otherwise it abstains.
view-if: left_in_government = 1
on-arrival: {!
const pslSeats = Math.max(0, Number(Q.psl_seats) || 0);
Q.annual_budget_ko_votes = Math.max(0, Number(Q.ko_seats) || 0);
Q.annual_budget_p2050_votes = Math.max(0, Number(Q.p2050_seats) || 0);
if (Q.psl_coalition_dissent >= 25) {
    Q.annual_budget_psl_votes = 0;
    Q.annual_budget_psl_no = pslSeats;
    Q.annual_budget_psl_abstain = 0;
    Q.coalition_break_threat = 1;
} else {
    Q.annual_budget_psl_votes = 0;
    Q.annual_budget_psl_no = 0;
    Q.annual_budget_psl_abstain = pslSeats;
}
Q.psl_coalition_dissent += 12;
Q.psl_relation -= 12;
Q.party_unity += 4;
Q.coalition_budget_bargain = "PSL challenged in the chamber";
Q.news_headline = "PSL is forced to choose between abstention and rupture";
!}
go-to: budget_sejm_roll

@budget_ko_rewrite
title: Accept KO's fiscal rewrite at the coalition council
subtitle: The centre closes ranks; Razem's available deputies vote no.
view-if: left_in_government = 1
on-arrival: {!
const pslSeats = Math.max(0, Number(Q.psl_seats) || 0);
const pslAbstentions = Math.min(2, pslSeats);
Q.annual_budget_ko_votes = Math.max(0, Number(Q.ko_seats) || 0);
Q.annual_budget_p2050_votes = Math.max(0, Number(Q.p2050_seats) || 0);
Q.annual_budget_psl_votes = pslSeats - pslAbstentions;
Q.annual_budget_psl_no = 0;
Q.annual_budget_psl_abstain = pslAbstentions;
const koRewriteDefectors = Math.min(
    Math.max(0, Number(Q.razem_seats) || 0),
    Math.max(0, Number(Q.annual_budget_left_votes) || 0)
);
Q.annual_budget_left_no += koRewriteDefectors;
Q.annual_budget_left_votes =
    Math.max(0, Q.annual_budget_left_votes - koRewriteDefectors);
Q.ko_coalition_dissent -= 7;
Q.psl_coalition_dissent -= 4;
Q.razem_dissent += 18;
Q.labor_credibility -= 4;
Q.coalition_budget_bargain = "KO fiscal rewrite";
!}
go-to: budget_sejm_roll

@budget_sejm_roll
# prose-audit: Grade B — Reports only the constitutionally meaningful counts and names the coalition consequence either way, which is the right discipline for a roll call; it remains a results screen rather than a scene.
title: The annual budget vote
face-image: img/poland/events/sejm-voting-device.webp
new-page: true
view-if: left_in_government = 1
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const koVotes = Math.max(
    0,
    Math.min(Number(Q.ko_seats) || 0, Number(Q.annual_budget_ko_votes) || 0)
);
const p2050Votes = Math.max(
    0,
    Math.min(
        Number(Q.p2050_seats) || 0,
        Number(Q.annual_budget_p2050_votes) || 0
    )
);
const centrumVotes = Math.max(0, Number(Q.centrum_seats) || 0);
const pslVotes = Math.max(
    0,
    Math.min(Number(Q.psl_seats) || 0, Number(Q.annual_budget_psl_votes) || 0)
);
const pslNo = Math.max(
    0,
    Math.min(
        (Number(Q.psl_seats) || 0) - pslVotes,
        Number(Q.annual_budget_psl_no) || 0
    )
);
const leftVotes = Math.max(
    0,
    Math.min(Number(Q.left_seats) || 0, Number(Q.annual_budget_left_votes) || 0)
);
const leftNo = Math.max(
    0,
    Math.min(
        (Number(Q.left_seats) || 0) - leftVotes,
        Number(Q.annual_budget_left_no) || 0
    )
);
const cooperatingSplinterVotes = Math.max(
    0,
    Number(Q.left_splinter_support_votes) || 0
);
const rightNo = Math.max(0, Number(Q.coalition_right_seats) || 0);
Q.annual_budget_yes = Math.min(
    sejmTotal,
    koVotes + p2050Votes + centrumVotes + pslVotes + leftVotes +
        cooperatingSplinterVotes
);
Q.annual_budget_no = Math.min(
    sejmTotal - Q.annual_budget_yes,
    rightNo + pslNo + leftNo
);
Q.annual_budget_abstain = Math.max(
    0,
    sejmTotal - Q.annual_budget_yes - Q.annual_budget_no
);
Q.annual_budget_present =
    Q.annual_budget_yes + Q.annual_budget_no + Q.annual_budget_abstain;
Q.annual_budget_threshold = Q.annual_budget_no + 1;
Q.annual_budget_passed =
    Q.annual_budget_present >= Q.sejm_quorum_floor &&
    Q.annual_budget_yes > Q.annual_budget_no ? 1 : 0;
Q.annual_budget_done = 1;
if (Q.annual_budget_passed) {
    Q.news_headline = "The coalition passes its annual budget";
} else {
    Q.news_headline = "The annual budget is defeated";
}
!}

