);
Q.third_abstain = Math.max(
    0,
    sejmTotal - Q.third_yes - Q.third_no
);
Q.third_left_cabinet = 0;
Q.party_unity -= 8;
Q.psl_relation -= 12;
Q.far_right_agenda += 4;
Q.news_headline = "Simple-majority arithmetic rescues a Sasin minority";
!}
go-to: third_confidence_roll

@third_kowalczyk_toleration
title: Let Kowalczyk keep the PiS minority alive
subtitle: The vote count is unchanged; the cabinet is just wearing a different label.
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const pslSupport = Math.min(22, Math.max(0, Number(Q.psl_seats) || 0));
const pisBloc =
    Math.max(0, Number(Q.pis_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const leftOpposition = Math.max(
    0,
    Number(Q.left_committed_seats) || Number(Q.left_seats) || 0
);
Q.third_candidate = "Henryk Kowalczyk";
Q.third_yes = Math.min(sejmTotal, pisBloc + pslSupport);
Q.third_no = Math.min(
    sejmTotal - Q.third_yes,
    Math.max(0, Number(Q.ko_seats) || 0) + leftOpposition +
        Math.min(7, Math.max(0, Number(Q.p2050_seats) || 0))
);
Q.third_abstain = Math.max(
    0,
    sejmTotal - Q.third_yes - Q.third_no
);
Q.third_left_cabinet = 0;
Q.party_unity -= 8;
Q.psl_relation -= 12;
Q.far_right_agenda += 4;
Q.news_headline = "Simple-majority arithmetic rescues a Kowalczyk minority";
!}
go-to: third_confidence_roll

@third_refuse_rescue
title: Vote the third cabinet down and accept an election
subtitle: Keep the certified blocs intact and exhaust the formation sequence.
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const pisBloc = Math.min(
    sejmTotal,
    Math.max(0, Number(Q.pis_seats) || 0) +
        (String(Q.social_patriot_list_committee || "") == "pis"
            ? Math.max(0, Number(Q.social_patriot_seats) || 0)
            : 0)
);
const pisAbsences = Math.min(
    Math.max(0, Math.round(Number(Q.first_pis_absent) || 0)),
    pisBloc
);
Q.third_candidate = "Mateusz Morawiecki";
Q.third_yes = Math.max(0, pisBloc - pisAbsences);
Q.third_no = Math.max(0, sejmTotal - pisBloc);
Q.third_abstain = 0;
Q.third_left_cabinet = 0;
Q.early_election_risk = 100;
Q.news_headline = "The Sejm heads toward a mandatory early election";
!}
go-to: third_confidence_roll

@third_confidence_roll
title: The final formation vote
new-page: true
on-arrival: {!
const boundedThird = function(value) {
    const numeric = Number.isFinite(Number(value)) ? Number(value) : 0;
    return Math.max(0, Math.round(numeric));
};
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
Q.confidence_stage = 4;
Q.confidence_mode =
    "Article 155 third attempt — simple majority of votes cast";
Q.confidence_candidate = Q.third_candidate;
Q.confidence_yes = Math.min(sejmTotal, boundedThird(Q.third_yes));
Q.confidence_no = Math.min(
    sejmTotal - Q.confidence_yes,
    boundedThird(Q.third_no)
);
Q.confidence_abstain = Math.min(
    sejmTotal - Q.confidence_yes - Q.confidence_no,
    boundedThird(Q.third_abstain)
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.third_confidence_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
if (Q.third_confidence_passed) {
    Q.news_headline =
        Q.third_candidate + " survives the final formation vote";
} else {
    Q.news_headline =
        "The final cabinet fails and an early election becomes mandatory";
}
!}

= The last roll call

<div class="ledger-section ledger-section-first"><div class="ledger-title">Roll
call</div>
<div class="ledger-row"><span>Candidate</span><b>[+ confidence_candidate +]</b></div>
<div class="ledger-row"><span>Yes</span><b>[+ confidence_yes +]</b></div>
<div class="ledger-row"><span>No</span><b>[+ confidence_no +]</b></div>
<div class="ledger-row"><span>Abstain</span><b>[+ confidence_abstain +]</b></div>
<div class="ledger-row"><span>Required</span><b>[+ confidence_threshold +]</b></div></div>

- @third_vote_continue: Continue from the roll call

@third_vote_continue
go-to: third_success if third_confidence_passed = 1; early_election if third_confidence_passed = 0

@third_success
title: A cabinet at the edge of the constitution
new-page: true
on-arrival: {!
Q.formation_complete = 1;
Q.formation_in_progress = 0;
Q.caretaker_government = 0;
Q.government_has_confidence = 1;
Q.prime_minister = Q.third_candidate;
Q.prime_minister_intro_return = "formation_government";
Q.prime_minister_intro_pending = 1;
Q.government_name = Q.third_candidate + " third-attempt cabinet";
const thirdCandidateKey = String(Q.third_candidate || "").toLowerCase();
if (
    thirdCandidateKey.includes("morawiecki") ||
    thirdCandidateKey.includes("szydło") ||
    thirdCandidateKey.includes("szydlo") ||
    thirdCandidateKey.includes("sasin") ||
    thirdCandidateKey.includes("kowalczyk") ||
    thirdCandidateKey.includes("czarnek")
) {
    Q.government_party = "pis";
    Q.government_owner = "PiS and its governing partners";
} else if (thirdCandidateKey.includes("kosiniak")) {
    Q.government_party = "psl";
    Q.government_owner = "PSL-led coalition";
} else {
    Q.government_party = "ko";
    Q.government_owner = "KO-led democratic coalition";
}
Q.left_in_government = Q.third_left_cabinet ? 1 : 0;
const thirdPisBlocSeats =
    Math.max(0, Number(Q.pis_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
Q.coalition_seats = Q.government_party == "pis"
    ? thirdPisBlocSeats
    : Math.min(
        Number(Q.sejm_total) || 460,
        Math.max(0, Number(Q.ko_seats) || 0) +
        Math.max(0, Number(Q.p2050_seats) || 0) +
        Math.max(0, Number(Q.psl_seats) || 0) +
        (Q.left_in_government
            ? Math.max(0, Number(Q.left_committed_seats) || 0)
            : 0)
    );
Q.government_support_seats = Math.max(
    Q.coalition_seats,
    Math.max(0, Number(Q.confidence_yes) || 0)
);
if (Q.left_in_government) {
    Q.left_cabinet_committed = 1;
    Q.ministries_finalized = 0;
    Q.ministry_allocation_mode = "formation";
    Q.position = "Coalition government";
    Q.coalition_status = "Third-attempt democratic coalition";
    Q.budget = 5;
    Q.budget_authority = "Governing coalition — negotiated fiscal capacity";
    Q.ending_name = "A government on the third attempt";
    if (Q.formation_continuous) {
        Q.formation_outcome_score = 38;
        Q.ending_score =
            (Number.isFinite(Number(Q.ending_score))
                ? Number(Q.ending_score)
                : 0) + 5;
    } else {
        Q.ending_score = 38;
    }
} else {
    Q.left_cabinet_committed = 0;
    Q.left_cabinet_model = "Opposition";
    Q.ministries_finalized = 1;
    Q.ministry_allocation_mode = "settled";
    Q.position = "Parliamentary opposition";
    Q.coalition_status = "PiS minority tolerated by PSL";
    Q.budget = 0;
    Q.budget_authority = "Opposition — no state spending authority";
    Q.ending_name = Q.third_candidate + " survives by abstention";
    if (Q.formation_continuous) {
        Q.formation_outcome_score = 18;
        Q.ending_score =
            (Number.isFinite(Number(Q.ending_score))
                ? Number(Q.ending_score)
                : 0) - 5;
    } else {
        Q.ending_score = 18;
    }
}
!}

The simple-majority rule has done what the absolute-majority stage could not.
[+ prime_minister +] has a cabinet, but its authority is exactly as broad as
the agreement behind **[+ government_support_seats +] confidence votes**.

- @poland_prime_minister_intro.show: Meet the new Prime Minister

@early_election
title: The Sejm is shortened
new-page: true
on-arrival: {!
Q.left_in_government = 0;
Q.formation_complete = 1;
Q.formation_in_progress = 0;
Q.government_has_confidence = 0;
Q.caretaker_government = 1;
Q.coalition_status = "No cabinet won confidence";
Q.position = "Election campaign";
Q.budget = 0;
Q.budget_authority = "Opposition — no state spending authority";
Q.ending_name = "A second election";
if (Q.formation_continuous) {
    Q.formation_outcome_score = 10;
    Q.ending_score =
        (Number.isFinite(Number(Q.ending_score)) ? Number(Q.ending_score) : 0) -
        10;
} else {
    Q.ending_score = 10;
}
Q.public_trust -= 6;
Q.early_election_risk = 100;
Q.snap_election_trigger =
    "Mandatory dissolution after failed Article 155 third attempt";
if (Q.formation_continuous) {
    // Only the 2023 transfer of power fast-forwards to December. A later
    // formation crisis (2026/2027 snap route) must keep its own calendar,
    // or year/month desynchronise from Q.time and every dated router breaks.
    const electionReturnYear = 2023;
    const electionReturnMonth = 12;
    const returnIndex = electionReturnYear * 12 + electionReturnMonth - 1;
    const currentIndex =
        (Number(Q.year) || electionReturnYear) * 12 +
        Math.max(1, Math.min(12, Number(Q.month) || electionReturnMonth)) - 1;
    if (currentIndex < returnIndex) {
        Q.time = Math.max(0, Number(Q.time) || 0) + returnIndex - currentIndex;
        Q.year = electionReturnYear;
        Q.month = electionReturnMonth;
        Q.month_name = "December";
        Q.date_label = "December 2023";
    }
}
!}

= No fourth attempt

The constitutional sequence is exhausted. The President must shorten the term
of the Sejm and order an election. This is not a discretionary threat and not a
presidential cabinet system: there is simply no government with parliamentary
confidence.

- @early_election_campaign: Enter the mandatory election campaign

@early_election_campaign
go-to: poland_events_2026_snap.snap_campaign_launch if formation_continuous = 1; formation_exit if formation_continuous = 0

@nonstandard_governing_agreement
title: Write rules for a non-standard coalition
new-page: true
view-if: left_in_government = 1 and standard_four_party_cabinet = 0

= A coalition the four-party template cannot describe

The cabinet that took office is not the standard KO–Poland 2050–PSL–Lewica
arrangement. One Third Way party may be outside, the government may depend on
toleration, or the Left may have entered a cross-bloc agreement. Applying the
four-party PSL budget script here would manufacture votes from parties that
never joined the cabinet.

The government therefore settles a narrower operating protocol now. Its first
annual budget must be handled by the general campaign system using the parties
actually committed to this cabinet, rather than the historical 2023 template.

- @nonstandard_written_protocol
- @nonstandard_transactional
- @nonstandard_red_lines

@nonstandard_written_protocol
title: Sign a written confidence and dispute protocol
subtitle: Cost: 1 party resource. Preserve the exact formal and outside-support ledgers, and take one written promise from each partner.
choose-if: resources >= 1
unavailable-subtitle: Drafting and ratifying the protocol costs one party resource.
