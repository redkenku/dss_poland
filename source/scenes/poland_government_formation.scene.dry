Q.third_left_cabinet = 0;
Q.early_election_risk = 100;
Q.news_headline = "The Sejm heads toward a mandatory early election";
!}
go-to: third_confidence_roll

@third_confidence_roll
title: The final formation vote
new-page: true
on-arrival: {!
const boundedThird = function(value) {
    const numeric = Number.isFinite(Number(value)) ? Number(value) : 0;
    return Math.max(0, Math.round(numeric));
};
Q.confidence_stage = 4;
Q.confidence_mode =
    "Article 155 third attempt — simple majority of votes cast";
Q.confidence_candidate = Q.third_candidate;
Q.confidence_yes = boundedThird(Q.third_yes);
Q.confidence_no = boundedThird(Q.third_no);
Q.confidence_abstain = boundedThird(Q.third_abstain);
const thirdOverflow = Math.max(
    0,
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain -
        Q.sejm_total
);
if (thirdOverflow > 0) {
    Q.confidence_abstain = Math.max(
        0,
        Q.confidence_abstain - thirdOverflow
    );
}
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.third_confidence_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
if (Q.third_confidence_passed) {
    Q.news_headline =
        Q.third_candidate + " survives the final formation vote";
} else {
    Q.news_headline =
        "The final cabinet fails and an early election becomes mandatory";
}
!}

= The last roll call

<div class="ledger-section ledger-section-first"><div class="ledger-title">Roll
call</div>
<div class="ledger-row"><span>Candidate</span><b>[+ confidence_candidate +]</b></div>
<div class="ledger-row"><span>Yes</span><b>[+ confidence_yes +]</b></div>
<div class="ledger-row"><span>No</span><b>[+ confidence_no +]</b></div>
<div class="ledger-row"><span>Abstain</span><b>[+ confidence_abstain +]</b></div>
<div class="ledger-row"><span>Required</span><b>[+ confidence_threshold +]</b></div></div>

