@democratic_candidate_roll
title: The coalition verifies a viable nominee
new-page: true
on-arrival: {!
const clampCandidateVotes = function(value, seats) {
    const numeric = Number.isFinite(Number(value)) ? Number(value) : 0;
    return Math.max(0, Math.min(Math.max(0, seats), Math.round(numeric)));
};
Q.candidate_ko_votes =
    clampCandidateVotes(Q.candidate_ko_votes, Q.ko_seats);
Q.candidate_p2050_votes =
    clampCandidateVotes(Q.candidate_p2050_votes, Q.p2050_seats);
Q.candidate_psl_votes =
    clampCandidateVotes(Q.candidate_psl_votes, Q.psl_seats);
Q.candidate_centrum_votes =
    clampCandidateVotes(Q.candidate_centrum_votes, Q.centrum_seats);
Q.candidate_left_votes =
    clampCandidateVotes(Q.candidate_left_votes, Q.left_committed_seats);
Q.confidence_stage = Q.presidential_majority_designation ? 1 : 2;
Q.confidence_mode =
    "Pre-appointment whip count — signed support, not a Sejm vote";
Q.confidence_candidate = Q.democratic_candidate;
Q.confidence_yes =
    Q.candidate_ko_votes + Q.candidate_p2050_votes +
    Q.candidate_psl_votes + Q.candidate_centrum_votes +
    Q.candidate_left_votes;
const rightSeats = Math.max(
    0,
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats
);
const rightAbsent = clampCandidateVotes(
    Q.candidate_right_absent,
    rightSeats
);
Q.confidence_no = Math.max(0, rightSeats - rightAbsent);
Q.confidence_abstain = Math.max(
    0,
    Q.sejm_total - rightAbsent -
        Q.confidence_yes - Q.confidence_no
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Math.floor(Q.confidence_present / 2) + 1;
Q.democratic_votes = Q.confidence_yes;
Q.candidate_vote_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no + Q.confidence_abstain ? 1 : 0;
if (Q.candidate_vote_passed) {
    Q.news_headline =
        Q.democratic_candidate + " shows an appointable majority";
} else {
    Q.news_headline =
        Q.democratic_candidate + " cannot show an appointable majority";
}
!}

= The signed whip count

This is a verification of written club commitments before appointment, not an
extra constitutional roll call. The cabinet and its programme will face the
single vote required by the applicable Article 154 stage.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Whip
count</div>
<div class="ledger-row"><span>Candidate</span><b>[+ confidence_candidate +]</b></div>
<div class="ledger-row"><span>Pledged</span><b>[+ confidence_yes +]</b></div>
<div class="ledger-row"><span>Declared against</span><b>[+ confidence_no +]</b></div>
<div class="ledger-row"><span>Uncommitted</span><b>[+ confidence_abstain +]</b></div>
<div class="ledger-row"><span>Needed for the later vote</span><b>[+ confidence_threshold +]</b></div></div>

[? if candidate_vote_passed: The nominee can proceed to ministerial vetting
and the constitutional cabinet vote.?]

[? if not candidate_vote_passed and presidential_majority_designation: The
President's first attempt cannot be appointed on these commitments. Initiative
will pass to the Sejm for its own second-stage nomination.?]
[? if not candidate_vote_passed and not presidential_majority_designation: The
Sejm-stage negotiation has exhausted itself. The President now regains
initiative for the simple-majority third attempt.?]

- @candidate_vote_continue: Continue from the roll call

@candidate_vote_continue
on-arrival: ministry_return_mode = "cabinet_program" if candidate_vote_passed = 1
go-to: poland_ministries if candidate_vote_passed = 1; presidential_first_fails if candidate_vote_passed = 0 and presidential_majority_designation = 1; third_attempt if candidate_vote_passed = 0 and presidential_majority_designation = 0

@presidential_first_fails
title: Initiative passes to the Sejm
view-if: presidential_majority_designation = 1
new-page: true
on-arrival: {!
Q.presidential_majority_designation = 0;
Q.confidence_stage = 2;
Q.confidence_mode = "Article 154 Sejm initiative — candidate selection";
if (!Q.formation_marshal_elected) {
    Q.sejm_speaker = "Marek Sawicki";
    Q.formation_marshal_elected = 1;
    Q.formation_marshal_compromise = 1;
    Q.formation_marshal_ballot_passed = 0;
}
Q.formation_coalition_selected = 0;
Q.formation_coalition_code = "none";
Q.formation_coalition_label = "No coalition selected";
Q.formation_coalition_locked = 0;
Q.formation_coalition_seats = 0;
Q.formation_coalition_support_seats = 0;
Q.formation_government_party = "other";
Q.formation_player_toleration = 0;
Q.formation_player_in_government = 1;
Q.coalition_broken = 0;
Q.left_cabinet_committed = 0;
Q.left_cabinet_model = "Not negotiated";
Q.candidate_ko_votes = 0;
Q.candidate_p2050_votes = 0;
Q.candidate_psl_votes = 0;
Q.candidate_psl_cap = 0; Q.candidate_psl_votes = Q.candidate_psl_cap;
Q.candidate_left_votes = 0;
Q.candidate_centrum_votes = 0;
Q.candidate_vote_passed = 0;
Q.democratic_votes = 0;
Q.democratic_candidate = "Undecided";
Q.cabinet_ko_loss = 0;
Q.cabinet_p2050_loss = 0;
Q.cabinet_psl_loss = 0;
Q.cabinet_left_loss = 0;
Q.ministries_finalized = 0;
Q.ministry_count = 0;
Q.ministry_ko_in_cabinet = 0;
Q.ministry_p2050_in_cabinet = 0;
Q.ministry_psl_in_cabinet = 0;
Q.news_headline =
    "The President's first attempt lapses and the Sejm opens its own nomination";
!}
go-to: sejm_candidate

@formation_coalition_menu
title: Build a coalition before naming offices
new-page: true
# poland_normalize republishes the pairwise coalition_viable_* gates the
# options below read, so an election or a courting round that just moved
# relations or party positions is reflected in this menu rather than in the
# next one.
call: poland_normalize
on-arrival: {!
Q.formation_coalition_selected = 0;
Q.formation_coalition_locked = 0;
Q.formation_coalition_seats = 0;
Q.formation_coalition_support_seats = 0;
Q.formation_coalition_members = [];
Q.formation_government_party = "other";
Q.formation_pm_default = "Undecided";
Q.formation_marshal_elected = 0;
Q.formation_marshal_nominee = "Undecided";
Q.formation_vice_witek_result = "Not voted";
Q.formation_vice_bosak_result = "Not voted";
Q.formation_vice_sikorski_result = "Not voted";
Q.formation_czarzasty_rotation = "Not negotiated";
Q.formation_fallback_code = "none";
Q.formation_fallback_members = [];
Q.formation_fallback_label = "No fallback selected";
Q.formation_fallback_seats = 0;
Q.formation_player_toleration = 0;
Q.formation_player_in_government = 1;
Q.formation_pis_left_safeguards = 0;
Q.formation_pis_rival_code = "none";
Q.formation_pis_rival_label = "No rival majority";
Q.formation_pis_rival_pressure = 0;
Q.formation_pis_rival_process_started = 0;
Q.formation_pis_rival_skip_reason = "Not evaluated";
Q.formation_rival_automatic_pm = 0;
Q.formation_pis_player_coalition = 0;
Q.formation_pending_pis_code = "none";
Q.formation_miller_konf_exception =
    Number(Q.sld_populist_route_active) == 1 &&
    String(Q.sld_populist_orientation || "") == "konfederacja" &&
    String(Q.sld_populist_alliance_state || "") == "accepted" &&
    String(Q.sejm_list_outcome || "") == "konf_5" ? 1 : 0;
// Marshal Senior is a 2023 fact. A later post-election formation opens with
// whoever the chamber last elected.
if ((Number(Q.year) || 2023) <= 2023) {
    Q.sejm_speaker = "Marek Sawicki (Marshal Senior)";
}
// Publish the arithmetic each option depends on, so the gray-out conditions
// and the ledger below can never disagree.
const seatsOf = function(key) {
    return Math.max(0, Math.round(Number(Q[key]) || 0));
};
const ko = seatsOf("ko_seats");
const p2050 = seatsOf("p2050_seats");
const psl = seatsOf("psl_seats");
const pis = seatsOf("pis_seats");
const left = seatsOf("left_committed_seats");
const solidarna = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "solidarna";
});
const solpolStillAttached = !Boolean(Q.suwerenna_walkout) &&
    Boolean(solidarna) && Boolean(solidarna.allied) &&
    !Boolean(solidarna.independent) && Boolean(solidarna.in_cabinet);
Q.formation_solpol_exit_seats = solpolStillAttached
    ? Math.min(pis, Math.max(
        0,
        Math.round(Number(solidarna.mp_count) ||
            Number(solidarna.sejm_mps) ||
            Number(solidarna.exclusive_seats) || 0)
    ))
    : 0;
const pisAfterSolpolExit = Math.max(0, pis - Q.formation_solpol_exit_seats);
Q.formation_majority_needed =
    Math.max(1, Math.round(Number(Q.sejm_statutory_majority) || 231));
const cappedOutsideSupport = function(formalSeats, availableSeats, cap) {
    return Math.min(
        Math.max(0, availableSeats),
        cap,
        Math.max(0, Q.formation_majority_needed - formalSeats)
    );
};
Q.formation_option_democratic = ko + p2050 + psl + left;
Q.formation_option_ko_psl_left_formal = ko + psl + left;
Q.formation_option_ko_psl_left_outside = cappedOutsideSupport(
    Q.formation_option_ko_psl_left_formal, p2050, 6
);
Q.formation_option_ko_psl_left =
    Q.formation_option_ko_psl_left_formal +
    Q.formation_option_ko_psl_left_outside;
Q.formation_option_ko_p2050_left_formal = ko + p2050 + left;
Q.formation_option_ko_p2050_left_outside = cappedOutsideSupport(
    Q.formation_option_ko_p2050_left_formal, psl, 6
);
Q.formation_option_ko_p2050_left =
    Q.formation_option_ko_p2050_left_formal +
    Q.formation_option_ko_p2050_left_outside;
Q.formation_option_left_p2050 = left + p2050;
Q.formation_option_left_psl = left + psl;
Q.formation_option_left_third = left + p2050 + psl;
Q.formation_option_third_left_pis_outside = cappedOutsideSupport(
    Q.formation_option_left_third, pis, 20
);
Q.formation_option_third_left_pis =
    Q.formation_option_left_third + Q.formation_option_third_left_pis_outside;
Q.formation_option_left_pis_gross = pis + left;
Q.formation_option_left_pis = pisAfterSolpolExit + left;
Q.formation_option_left_pis_psl = pisAfterSolpolExit + left + psl;
Q.formation_option_left_pis_p2050 = pisAfterSolpolExit + left + p2050;
Q.formation_option_left_pis_third = pisAfterSolpolExit + left + psl + p2050;
Q.formation_option_left_pis_konf =
    pisAfterSolpolExit + left + seatsOf("konf_seats");
Q.formation_option_left_pis_konf_psl =
    Q.formation_option_left_pis_konf + psl;
Q.formation_option_left_pis_konf_p2050 =
    Q.formation_option_left_pis_konf + p2050;
Q.formation_option_left_pis_konf_third =
    Q.formation_option_left_pis_konf + psl + p2050;
Q.formation_option_ko_left_formal = ko + left;
Q.formation_option_ko_left_outside = cappedOutsideSupport(
    Q.formation_option_ko_left_formal, p2050 + psl, 10
);
Q.formation_option_ko_left =
    Q.formation_option_ko_left_formal + Q.formation_option_ko_left_outside;
// The anomaly. left_committed_seats already folds in every splitter club whose
// relation clears the toleration threshold, so one number covers both "Lewica
// alone" and "Lewica plus the clubs that walked out of it".
Q.formation_option_left_only = left;
Q.formation_left_splitter_votes = Math.max(0, left - seatsOf("left_seats"));
Q.coalition_builder_ready = 0;
Q.coalition_builder_pending = 0;
if (typeof polandCoalitionModel != "undefined") {
    polandCoalitionModel.initialise(Q, {
        mode: "formation", sponsor: "lewica",
        roles: {lewica: "cabinet"}, locked: ["lewica"]
    });
}
!}

= Counting to 231

No prime minister can be safely nominated before the partners agree who forms
the majority. The post-election order now runs as: coalition deal, Marshal
ballot, then prime minister and cabinet confidence.

[? if formation_president_nominee != "": President **[+ president_name +]** has
already designated **[+ formation_president_nominee +]**. The chamber may still
assemble a different majority; the designation only decides who gets the first
constitutional attempt.?]

**[+ formation_majority_needed +] votes** carry a cabinet. Arrangements below
that number are shown but cannot be signed as a governing contract.

[? if formation_solpol_exit_seats > 0: **Solidarna Polska will leave rather
than enter a cabinet with Lewica.** Every PiS–Lewica total below already
deducts its [+ formation_solpol_exit_seats +] MPs; another partner must replace
those votes.?]

{!<div class="coalition-builder-host" data-coalition-mode="formation"></div>!}

<div class="coalition-table-wrap"><table class="coalition-table"><caption>Seat blocks</caption>
<thead><tr><th scope="col">Status</th><th scope="col">Bloc</th><th scope="col">Votes</th></tr></thead><tbody>
<tr data-status="[+ formation_status_democratic +]"><td class="coalition-table-status">[+ formation_status_democratic +]</td><th scope="row">KO + P2050 + PSL + NL</th><td>[+ formation_option_democratic +] formal</td></tr>
<tr data-status="[+ formation_status_ko_psl_left +]"><td class="coalition-table-status">[+ formation_status_ko_psl_left +]</td><th scope="row">KO + PSL + NL</th><td>[+ formation_option_ko_psl_left_formal +][? if formation_option_ko_psl_left_outside > 0: + [+ formation_option_ko_psl_left_outside +] P2050?][? if formation_option_ko_psl_left_outside = 0: formal?]</td></tr>
<tr data-status="[+ formation_status_ko_p2050_left +]"><td class="coalition-table-status">[+ formation_status_ko_p2050_left +]</td><th scope="row">KO + P2050 + NL</th><td>[+ formation_option_ko_p2050_left_formal +][? if formation_option_ko_p2050_left_outside > 0: + [+ formation_option_ko_p2050_left_outside +] PSL?][? if formation_option_ko_p2050_left_outside = 0: formal?]</td></tr>
<tr data-status="[+ formation_status_left_p2050 +]"><td class="coalition-table-status">[+ formation_status_left_p2050 +]</td><th scope="row">P2050 + NL</th><td>[+ formation_option_left_p2050 +] formal</td></tr>
<tr data-status="[+ formation_status_left_psl +]"><td class="coalition-table-status">[+ formation_status_left_psl +]</td><th scope="row">PSL + NL</th><td>[+ formation_option_left_psl +] formal</td></tr>
<tr data-status="[+ formation_status_left_third +]"><td class="coalition-table-status">[+ formation_status_left_third +]</td><th scope="row">TD + NL</th><td>[+ formation_option_left_third +] formal</td></tr>
<tr data-status="[+ formation_status_third_left_pis +]"><td class="coalition-table-status">[+ formation_status_third_left_pis +]</td><th scope="row">TD + NL (PiS support)</th><td>[+ formation_option_left_third +][? if formation_option_third_left_pis_outside > 0: + [+ formation_option_third_left_pis_outside +] PiS?][? if formation_option_third_left_pis_outside = 0: formal?]</td></tr>
<tr data-status="[+ formation_status_left_pis +]"><td class="coalition-table-status">[+ formation_status_left_pis +]</td><th scope="row">PiS + NL</th><td>[? if formation_solpol_exit_seats > 0: [+ formation_option_left_pis_gross +] gross · [+ formation_option_left_pis +] after SP exit?][? if formation_solpol_exit_seats = 0: [+ formation_option_left_pis +] formal?]</td></tr>
<tr data-status="[+ formation_status_left_pis_psl +]"><td class="coalition-table-status">[+ formation_status_left_pis_psl +]</td><th scope="row">PiS + NL + PSL</th><td>[+ formation_option_left_pis_psl +] formal</td></tr>
<tr data-status="[+ formation_status_left_pis_p2050 +]"><td class="coalition-table-status">[+ formation_status_left_pis_p2050 +]</td><th scope="row">PiS + NL + P2050</th><td>[+ formation_option_left_pis_p2050 +] formal</td></tr>
<tr data-status="[+ formation_status_left_pis_third +]"><td class="coalition-table-status">[+ formation_status_left_pis_third +]</td><th scope="row">PiS + NL + TD</th><td>[+ formation_option_left_pis_third +] formal</td></tr>
<tr data-status="[+ formation_status_left_pis_konf +]"><td class="coalition-table-status">[+ formation_status_left_pis_konf +]</td><th scope="row">SPS + PiS + Konf.</th><td>[? if formation_miller_konf_exception: [+ formation_option_left_pis_konf +] formal?][? if not formation_miller_konf_exception: pact required?]</td></tr>
<tr data-status="[+ formation_status_left_pis_konf_psl +]"><td class="coalition-table-status">[+ formation_status_left_pis_konf_psl +]</td><th scope="row">SPS + PiS + Konf. + PSL</th><td>[? if formation_miller_konf_exception: [+ formation_option_left_pis_konf_psl +] formal?][? if not formation_miller_konf_exception: pact required?]</td></tr>
<tr data-status="[+ formation_status_left_pis_konf_p2050 +]"><td class="coalition-table-status">[+ formation_status_left_pis_konf_p2050 +]</td><th scope="row">SPS + PiS + Konf. + P2050</th><td>[? if formation_miller_konf_exception: [+ formation_option_left_pis_konf_p2050 +] formal?][? if not formation_miller_konf_exception: pact required?]</td></tr>
<tr data-status="[+ formation_status_left_pis_konf_third +]"><td class="coalition-table-status">[+ formation_status_left_pis_konf_third +]</td><th scope="row">SPS + PiS + Konf. + TD</th><td>[? if formation_miller_konf_exception: [+ formation_option_left_pis_konf_third +] formal?][? if not formation_miller_konf_exception: pact required?]</td></tr>
<tr data-status="[+ formation_status_ko_left +]"><td class="coalition-table-status">[+ formation_status_ko_left +]</td><th scope="row">KO + NL</th><td>[+ formation_option_ko_left_formal +][? if formation_option_ko_left_outside > 0: + [+ formation_option_ko_left_outside +] TD?][? if formation_option_ko_left_outside = 0: formal?]</td></tr>
<tr data-status="[+ formation_status_left_only +]"><td class="coalition-table-status">[+ formation_status_left_only +]</td><th scope="row">NL</th><td>[+ formation_option_left_only +] total · [+ formation_left_splitter_votes +] splitters</td></tr>
</tbody></table></div>

