on-arrival: coalition_broken = 1; coalition_break_threat = 0; psl_coalition_dissent = 100; coalition_seats = 216; coalition_status = "KO · Poland 2050 · Left minority cabinet"; psl_relation -= 18; government_delivery -= 5; ending_name = "A 216-seat minority"; ending_score += 3; news_headline = "PSL leaves and the cabinet refuses to resign"
