@cabinet_confidence_roll
title: The cabinet confidence vote
new-page: true
on-arrival: {!
const democraticSeats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats + Q.left_seats;
const requestedCabinetLosses =
    Q.cabinet_ko_loss + Q.cabinet_p2050_loss +
    Q.cabinet_psl_loss + Q.cabinet_left_loss;
const cabinetLosses = Math.max(
    0,
    Math.min(Q.democratic_votes, requestedCabinetLosses)
);
const rightSeats = Math.max(0, Q.pis_seats + Q.konf_seats);
const rightAbsent = Math.max(
    0,
    Math.min(
        rightSeats,
        Math.round(Number(Q.candidate_right_absent) || 0)
    )
);
Q.confidence_stage = 3;
Q.confidence_mode =
    "Article 154 Sejm cabinet vote — absolute majority of deputies present";
Q.confidence_candidate = Q.democratic_candidate + " cabinet";
Q.confidence_yes = Math.max(0, Q.democratic_votes - cabinetLosses);
Q.confidence_no = Math.max(0, rightSeats - rightAbsent);
Q.confidence_abstain =
    Math.max(0, democraticSeats - Q.democratic_votes) +
    cabinetLosses + Math.max(0, Q.other_seats);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Math.floor(Q.confidence_present / 2) + 1;
Q.cabinet_confidence_passed =
    Q.confidence_present >= Q.sejm_quorum_floor &&
    Q.confidence_yes > Q.confidence_no + Q.confidence_abstain ? 1 : 0;
if (Q.cabinet_confidence_passed) {
    Q.news_headline =
        Q.democratic_candidate + "'s cabinet wins confidence";
} else {
    Q.news_headline =
        Q.democratic_candidate + "'s cabinet fails at the last vote";
}
!}

