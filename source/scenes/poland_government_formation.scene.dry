title: The 2023 transfer of power

@campaign_entry
title: October 2023 — certify the new Sejm
new-page: true
on-arrival: {!
const finiteFormation = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const apportionFormation = function(total, entries) {
    const safeTotal = Math.max(0, Math.round(finiteFormation(total, 0)));
    const weights = entries.map(function(entry) {
        return {
            id: entry.id,
            weight: Math.max(0, finiteFormation(entry.weight, 0))
        };
    });
    let weightTotal = weights.reduce(function(sum, entry) {
        return sum + entry.weight;
    }, 0);
    if (weightTotal <= 0) {
        weightTotal = weights.length;
        for (const entry of weights) entry.weight = 1;
    }
    const allocated = {};
    const remainders = [];
    let used = 0;
    for (const entry of weights) {
        const exact = safeTotal * entry.weight / weightTotal;
        const base = Math.floor(exact);
        allocated[entry.id] = base;
        used += base;
        remainders.push({
            id: entry.id,
            remainder: exact - base
        });
    }
    remainders.sort(function(a, b) {
        if (b.remainder != a.remainder) {
            return b.remainder - a.remainder;
        }
        return a.id < b.id ? -1 : 1;
    });
    for (let i = 0; i < safeTotal - used; i += 1) {
        allocated[remainders[i % remainders.length].id] += 1;
    }
    return allocated;
};

Q.started = 1;
Q.prototype_complete = 0;
Q.continuous_campaign = 1;
Q.formation_entry_mode = "continuous";
Q.formation_continuous = 1;
Q.formation_requested = 1;
Q.formation_in_progress = 1;
Q.formation_return_ready = 0;
Q.formation_complete = 0;
Q.formation_outcome_score = 0;
Q.post_formation_return_pending = 0;

// This entry is deliberately not a new-game setup. Party resources, the
// agenda hand, advisors, factional history, rival AI, ideology, relations,
// presidential history and the judicial record all remain untouched.
Q.pre_election_left_in_government = Q.left_in_government ? 1 : 0;
Q.pre_election_government_party = String(Q.government_party || "");
Q.pre_election_government_name = String(Q.government_name || "");
Q.pre_election_prime_minister = String(Q.prime_minister || "");
Q.pre_election_position = String(Q.position || "");
Q.year = 2023;
Q.month = 10;
Q.month_name = "October";
Q.date_label = "October 2023";
Q.position = "Parliamentary opposition";
Q.prime_minister = "Mateusz Morawiecki";
Q.government_name = "Outgoing PiS caretaker cabinet";
Q.caretaker_government = 1;
Q.government_has_confidence = 0;
Q.left_in_government = 0;
Q.budget = 0;
Q.budget_authority = "Opposition — no state spending authority";
Q.coalition_broken = 0;
Q.coalition_status = "No new cabinet has won confidence";
Q.coalition_seats = 0;
Q.government_support_seats = 0;
Q.sejm_total = 460;
Q.sejm_quorum_floor = 230;
Q.sejm_statutory_majority = 231;

const partyIds = [
    "pis", "ko", "p2050", "psl", "left", "konf", "other",
    "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left", "young_left",
    "razem", "pps", "centrum", "rozwoj", "korona", "ko_splinter",
    "left_coalition", "democratic_list", "third_way"
];
if (!Q.election_2023_certified) {
    const thirdWayJoint = Boolean(Q.third_way_joint_list) &&
        !Boolean(Q.third_way_split);
    const sourcePartyIds = partyIds.filter(function(id) {
        return !["left_coalition", "democratic_list", "third_way"].includes(id);
    });
    const committeeForFormation = {};
    for (const id of sourcePartyIds) committeeForFormation[id] = id;
    if (thirdWayJoint) {
        committeeForFormation.psl = "third_way";
        committeeForFormation.p2050 = "third_way";
    }
    const breakawayCommittees = {
        spring_breakaway: String(Q.spring_list_committee || "spring_breakaway"),
        labor_left: String(Q.labor_list_committee || "labor_left"),
        young_left: String(Q.progressives_list_committee || "young_left"),
        razem: String(Q.razem_list_committee || "razem"),
        social_patriot: String(
            Q.social_patriot_list_committee || "social_patriot"
        )
    };
    for (const id of Object.keys(breakawayCommittees)) {
        if (
            ["left", "razem", "left_coalition"].includes(
                breakawayCommittees[id]
            ) ||
            (id == "social_patriot" && breakawayCommittees[id] == "pis")
        ) {
            committeeForFormation[id] = breakawayCommittees[id];
        }
    }
    const listOutcome = String(Q.sejm_list_outcome || "left_5");
    if (listOutcome == "left_coalition_8") {
        committeeForFormation.left = "left_coalition";
    } else if (listOutcome == "razem_5" && Q.razem_party_formed) {
        committeeForFormation.left = "razem";
    } else if (listOutcome == "democratic_8") {
        committeeForFormation.left = "democratic_list";
        committeeForFormation.ko = "democratic_list";
        committeeForFormation.psl = "democratic_list";
        if (Q.p2050_emerged) committeeForFormation.p2050 = "democratic_list";
    } else if (listOutcome == "ko_5") {
        committeeForFormation.left = "ko";
    } else if (listOutcome == "third_way_8") {
        committeeForFormation.left = "third_way";
        committeeForFormation.psl = "third_way";
        if (Q.p2050_emerged) committeeForFormation.p2050 = "third_way";
    } else if (listOutcome == "third_host_5") {
        committeeForFormation.left = ["psl", "p2050"].includes(Q.sejm_list_host)
            ? Q.sejm_list_host
            : "psl";
        committeeForFormation.psl = "psl";
        committeeForFormation.p2050 = "p2050";
    } else if (listOutcome == "pis_5") {
        committeeForFormation.left = "pis";
    }
    const componentBaseVotes = {};
    const committeeBaseVotes = {};
    for (const id of sourcePartyIds) {
        const committee = committeeForFormation[id] || id;
        const mapped = committee != id;
        const componentVote = mapped
            ? Math.max(
                finiteFormation(Q[id + "_component_vote_intent"], 0),
                finiteFormation(Q[id + "_vote_intent"], 0)
            )
            : finiteFormation(
                Q[id + "_vote_intent"],
                finiteFormation(Q[id + "_poll"], 0)
            );
        componentBaseVotes[id] = Math.max(0, componentVote);
        committeeBaseVotes[committee] =
            Math.max(0, committeeBaseVotes[committee] || 0) +
            componentBaseVotes[id];
    }
    const countIds = Object.keys(committeeBaseVotes).filter(function(id) {
        return id != "other" && committeeBaseVotes[id] > 0.02;
    });
    if (!countIds.length) countIds.push("pis");
    const electionVotes = {};
    const electionShocks = {};
    for (const id of countIds) {
        const baseVote = committeeBaseVotes[id] || 0;
        const shock =
            (this.random.uint32() / 4294967296 - 0.5) * 2.5;
        electionShocks[id] = shock;
        electionVotes[id] = Math.max(0.02, baseVote + shock);
    }
    const otherVote = Math.max(
        0,
        finiteFormation(Q.other_vote_intent, finiteFormation(Q.other_poll, 0))
    );
    const voteTotal = otherVote + countIds.reduce(function(total, id) {
        return total + electionVotes[id];
    }, 0);
    for (const id of countIds) {
        electionVotes[id] = electionVotes[id] * 100 / Math.max(1, voteTotal);
    }
    const normalizedOther = otherVote * 100 / Math.max(1, voteTotal);
    const thresholds = {
        pis: 5, ko: Q.ko_consolidated || listOutcome == "ko_5" ? 5 : 8,
        p2050: 5, psl: 5,
        left: 5, konf: 5, sld_breakaway: 5, social_patriot: 5,
        spring_breakaway: 5,
        labor_left: 5, young_left: 5, razem: 5, pps: 5,
        centrum: 5, rozwoj: 5, korona: 5, ko_splinter: 5,
        left_coalition: 8, democratic_list: 8, third_way: 8
    };
    let qualified = countIds.filter(function(id) {
        return electionVotes[id] >= thresholds[id];
    });
    if (!qualified.length) {
        qualified = countIds.slice().sort(function(a, b) {
            return electionVotes[b] - electionVotes[a];
        }).slice(0, 1);
    }
    const certified = {};
    for (const id of partyIds.concat(["third_way"])) certified[id] = 0;
    for (let seat = 0; seat < Q.sejm_total; seat += 1) {
        let winner = qualified[0];
        let best = -1;
        for (const id of qualified) {
            const quotient = electionVotes[id] / (certified[id] + 1);
            if (quotient > best) {
                best = quotient;
                winner = id;
            }
        }
        certified[winner] += 1;
    }
    const certifiedComponents = {};
    for (const id of sourcePartyIds) certifiedComponents[id] = 0;
    for (const committee of countIds) {
        const members = sourcePartyIds.filter(function(id) {
            return componentBaseVotes[id] > 0 &&
                (committeeForFormation[id] || id) == committee;
        });
        const allocations = apportionFormation(
            certified[committee] || 0,
            members.map(function(id) {
                return {id: id, weight: componentBaseVotes[id]};
            })
        );
        for (const id of members) {
            certifiedComponents[id] = allocations[id] || 0;
        }
        Q[committee + "_committee_seats"] = certified[committee] || 0;
        Q["election_2023_" + committee + "_committee_vote"] =
            Math.round((electionVotes[committee] || 0) * 100) / 100;
        Q["election_2023_" + committee + "_vote"] =
            Math.round((electionVotes[committee] || 0) * 100) / 100;
    }
    for (const id of sourcePartyIds) {
        if (id == "razem") {
            Q.razem_party_seats = certifiedComponents[id];
        } else if (id == "pps") {
            Q.pps_party_seats = certifiedComponents[id];
        } else {
            Q[id + "_seats"] = certifiedComponents[id];
        }
        Q[id + "_projected_seats"] = certifiedComponents[id];
        const committee = committeeForFormation[id] || id;
        const committeeMembers = sourcePartyIds.filter(function(member) {
            return componentBaseVotes[member] > 0 &&
                (committeeForFormation[member] || member) == committee;
        });
        const committeeWeight = committeeMembers.reduce(function(total, member) {
            return total + componentBaseVotes[member];
        }, 0);
        const certifiedVote = id == "other"
            ? normalizedOther
            : (electionVotes[committee] || 0) *
                componentBaseVotes[id] / Math.max(0.01, committeeWeight);
        Q["election_2023_" + id + "_vote"] =
            Math.round(certifiedVote * 100) / 100;
    }
    Q.election_2023_third_way_vote =
        Math.round((electionVotes.third_way || 0) * 100) / 100;
    // Auxiliary caucus ledgers from the previous Sejm cannot survive a new
    // certification as extra seats. Their voters are already inside the
    // certified party/list totals above.
    Q.porozumienie_seats = 0;
    Q.suwerenna_seats = 0;
    const largestShock = countIds.slice().sort(function(a, b) {
        return Math.abs(electionShocks[b]) - Math.abs(electionShocks[a]);
    })[0];
    Q.election_2023_day_shock_summary = largestShock + " " +
        (electionShocks[largestShock] >= 0 ? "+" : "") +
        (Math.round(electionShocks[largestShock] * 100) / 100) +
        " points; thresholds and d'Hondt recalculated";
    Q.election_2023_certified = 1;
}
const certifiedLeftLists = [
    "left", "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left",
    "young_left", "razem", "pps"
].filter(function(id) {
    if (id == "left") return true;
    const activeQualities = {
        sld_breakaway: Q.barons_party_formed,
        social_patriot: Q.social_patriot_party_formed,
        spring_breakaway: Q.spring_party_formed,
        labor_left: Q.labor_party_formed,
        young_left: Q.progressives_party_formed,
        razem: Q.razem_party_formed,
        pps: Q.pps_party_formed
    };
    return !!activeQualities[id];
});
const certifiedMainCommittee = {
    left_coalition_8: "left_coalition",
    razem_5: "razem",
    democratic_8: "democratic_list",
    ko_5: "ko",
    third_way_8: "third_way",
    third_host_5: String(Q.sejm_list_host || "psl"),
    pis_5: "pis"
}[String(Q.sejm_list_outcome || "left_5")] || "left";
const certifiedLeftCommitteeFor = {
    left: certifiedMainCommittee,
    sld_breakaway: "sld_breakaway",
    social_patriot: String(
        Q.social_patriot_list_committee || "social_patriot"
    ),
    spring_breakaway: String(Q.spring_list_committee || "spring_breakaway"),
    labor_left: String(Q.labor_list_committee || "labor_left"),
    young_left: String(Q.progressives_list_committee || "young_left"),
    razem: String(Q.razem_list_committee || "razem"),
    pps: "pps"
};
const certifiedLeftCommitteeIds = [];
for (const id of certifiedLeftLists) {
    const committee = certifiedLeftCommitteeFor[id] || id;
    if (!certifiedLeftCommitteeIds.includes(committee)) {
        certifiedLeftCommitteeIds.push(committee);
    }
}
const certifiedThresholds = {
    left_coalition: 8,
    democratic_list: 8,
    third_way: 8
};
const certifiedCommitteeVote = function(id) {
    return finiteFormation(
        Q["election_2023_" + id + "_committee_vote"],
        finiteFormation(Q["election_2023_" + id + "_vote"], 0)
    );
};
Q.election_2023_filed_committee_vote =
    Math.round(certifiedCommitteeVote(certifiedMainCommittee) * 100) / 100;
Q.election_2023_filed_committee_seats = finiteFormation(
    Q[certifiedMainCommittee + "_committee_seats"],
    0
);
Q.left_family_vote_intent = Math.round(
    certifiedLeftLists.reduce(function(total, id) {
        return total + finiteFormation(Q["election_2023_" + id + "_vote"], 0);
    }, 0) * 100
) / 100;
Q.left_lists_contesting = certifiedLeftCommitteeIds.length;
Q.left_lists_above_threshold = certifiedLeftCommitteeIds.reduce(
    function(total, id) {
        const result = certifiedCommitteeVote(id);
        return total + (result >= (certifiedThresholds[id] || 5) ? 1 : 0);
    },
    0
);
Q.left_threshold_wasted_vote = Math.round(
    certifiedLeftLists.reduce(function(total, id) {
        const committee = certifiedLeftCommitteeFor[id] || id;
        const committeeResult = certifiedCommitteeVote(committee);
        const componentResult = finiteFormation(
            Q["election_2023_" + id + "_vote"],
            0
        );
        return total + (
            committeeResult > 0 &&
            committeeResult < (certifiedThresholds[committee] || 5)
                ? componentResult
                : 0
        );
    }, 0) * 100
) / 100;

const leftCaucusDefinitions = [
    {id: "barons", weight: Q.barons_active ? Q.barons_strength : 0},
    {id: "spring", weight: Q.spring_active ? Q.spring_strength : 0},
    {id: "labor", weight: Q.labor_active ? Q.labor_strength : 0},
    {
        id: "progressives",
        weight: Q.progressives_active ? Q.progressives_strength : 0
    },
    {id: "razem", weight: Q.razem_active ? Q.razem_strength : 0},
    {id: "pps", weight: Q.pps_active ? Q.pps_strength : 0},
    {
        id: "social_patriot",
        weight: Q.social_patriot_active ? Q.social_patriot_strength : 0
    }
].filter(function(entry) {
    return Number(entry.weight) > 0;
});
const leftCaucuses = leftCaucusDefinitions.length
    ? apportionFormation(Q.left_seats, leftCaucusDefinitions)
    : {};
Q.left_barons_seats = leftCaucuses.barons || 0;
Q.left_spring_seats = leftCaucuses.spring || 0;
Q.left_labor_seats = leftCaucuses.labor || 0;
Q.left_progressives_seats = leftCaucuses.progressives || 0;
Q.left_social_patriot_seats = leftCaucuses.social_patriot || 0;
Q.left_new_generation_seats =
    Q.left_labor_seats + Q.left_progressives_seats;
Q.razem_seats = leftCaucuses.razem || 0;
Q.left_pps_seats = leftCaucuses.pps || 0;
Q.nowa_lewica_seats =
    Q.left_barons_seats + Q.left_spring_seats +
    Q.left_labor_seats + Q.left_progressives_seats;

const pslCaucuses = apportionFormation(Q.psl_seats, [
    {id: "core", weight: 19},
    {id: "regional", weight: 11},
    {id: "conservative", weight: 2}
]);
Q.psl_core_seats = pslCaucuses.core;
Q.psl_regional_seats = pslCaucuses.regional;
Q.psl_conservative_seats = pslCaucuses.conservative;

const p2050Caucuses = apportionFormation(Q.p2050_seats, [
    {id: "loyalist", weight: 20},
    {id: "liberal", weight: 10},
    {id: "independent", weight: 3}
]);
Q.p2050_loyalist_seats = p2050Caucuses.loyalist;
Q.p2050_liberal_seats = p2050Caucuses.liberal;
Q.p2050_independent_seats = p2050Caucuses.independent;

Q.left_splinter_seats =
    Q.sld_breakaway_seats + Q.social_patriot_seats +
    Q.spring_breakaway_seats +
    Q.labor_left_seats + Q.young_left_seats +
    Q.razem_party_seats + Q.pps_party_seats + Q.tak_rozwoj_seats;
Q.left_family_seats = Q.left_seats + Q.left_splinter_seats;
Q.left_splinter_support_votes =
    (Q.barons_party_relation >= 45 ? Q.sld_breakaway_seats : 0) +
    (Q.social_patriot_list_committee != "pis" &&
        Q.social_patriot_party_relation >= 45
        ? Q.social_patriot_seats : 0) +
    (Q.spring_party_relation >= 45 ? Q.spring_breakaway_seats : 0) +
    (Q.labor_party_relation >= 45 ? Q.labor_left_seats : 0) +
    (Q.progressives_party_relation >= 45 ? Q.young_left_seats : 0) +
    (Q.razem_party_relation >= 45 ? Q.razem_party_seats : 0) +
    (Q.pps_party_relation >= 45 ? Q.pps_party_seats : 0) +
    (Q.tak_rozwoj_parent_relation >= 45 ? Q.tak_rozwoj_seats : 0);
Q.left_committed_seats =
    Q.left_seats + Q.left_splinter_support_votes;
Q.coalition_democratic_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats +
    Q.centrum_seats + Q.left_committed_seats;
Q.coalition_center_seats =
    Q.ko_seats + Q.p2050_seats + Q.psl_seats + Q.centrum_seats;
Q.coalition_right_seats =
    Q.pis_seats + Q.konf_seats + Q.rozwoj_seats + Q.korona_seats +
    (Q.social_patriot_list_committee == "pis"
        ? Q.social_patriot_seats : 0);
Q.coalition_pis_psl_seats = Q.pis_seats + Q.psl_seats +
    (Q.social_patriot_list_committee == "pis"
        ? Q.social_patriot_seats : 0);
Q.seat_subvention_seats = Q.left_seats;
Q.seat_subvention = Q.left_seats > 0
    ? Math.max(1, Math.round(Q.left_seats / 25))
    : 0;
Q.party_income =
    Math.max(0, finiteFormation(Q.member_dues, 0)) + Q.seat_subvention;

// Certify one winner in each of the Senate's 100 single-member districts.
// A pact combines its members behind one district candidate. Lewica may be a
// full partner, receive limited reservations, stand down or run outside a
// bilateral KO–Third Way agreement.
if (!Q.senate_election_2023_certified) {
    Q.senate_total = 100;
    if (!Q.senate_pact_2023_done) {
        Q.senate_pact_coordinated = 1;
        Q.senate_pact_side = "left";
        Q.senate_pact_strength = 60;
        Q.senate_pact_strategy =
            "Senate Pact with three Sejm lists";
        Q.senate_left_pact_mode = "full";
    }
    const senateVote = function(id) {
        return Math.max(
            0,
            finiteFormation(
                Q["election_2023_" + id + "_vote"],
                finiteFormation(Q[id + "_vote_intent"], 0)
            )
        );
    };
    const senateVotes = {
        pis: senateVote("pis") +
            (Q.social_patriot_list_committee == "pis"
                ? senateVote("social_patriot") : 0),
        konf: senateVote("konf"),
        rozwoj: senateVote("rozwoj"),
        korona: senateVote("korona"),
        ko: senateVote("ko") + senateVote("ko_splinter") +
            senateVote("centrum"),
        p2050: senateVote("p2050"),
        psl: senateVote("psl"),
        left: [
            "left", "sld_breakaway", "spring_breakaway",
            "labor_left", "young_left", "razem", "pps"
        ].reduce(function(total, id) {
            return total + senateVote(id);
        }, 0) + (Q.social_patriot_list_committee != "pis"
            ? senateVote("social_patriot") : 0),
        independent: senateVote("other")
    };
    const leftPactMode = String(Q.senate_left_pact_mode || "full");
    const leftPactNominationWeight = leftPactMode == "full"
        ? 1
        : (leftPactMode == "reserved" ? 0.2 : 0);
    const leftVoteInsidePact = leftPactMode != "outside";
    const rightPactMode = String(Q.senate_pact_side || "left") == "right"
        ? "full"
        : "outside";
    const rightVoteInsidePact = rightPactMode != "outside";
    const democraticPactVote =
        senateVotes.ko + senateVotes.p2050 + senateVotes.psl +
        (leftVoteInsidePact ? senateVotes.left : 0);
    const rightPactVote = senateVotes.pis + senateVotes.konf;
    const pactStrength = Math.max(
        0,
        Math.min(100, finiteFormation(Q.senate_pact_strength, 60))
    );
    const pactNomineeParts = apportionFormation(
        Q.senate_total,
        [
            {id: "ko", weight: senateVotes.ko},
            {id: "p2050", weight: senateVotes.p2050},
            {id: "psl", weight: senateVotes.psl},
            {
                id: "left",
                weight: senateVotes.left * leftPactNominationWeight
            }
        ]
    );
    const pactNominees = [];
    for (const id of ["ko", "p2050", "psl", "left"]) {
        for (let seat = 0; seat < pactNomineeParts[id]; seat += 1) {
            pactNominees.push(id);
        }
    }
    for (let i = pactNominees.length - 1; i > 0; i -= 1) {
        const swap = this.random.uint32() % (i + 1);
        const current = pactNominees[i];
        pactNominees[i] = pactNominees[swap];
        pactNominees[swap] = current;
    }
    const thirdNomineeParts = apportionFormation(
        Q.senate_total,
        [
            {id: "p2050", weight: senateVotes.p2050},
            {id: "psl", weight: senateVotes.psl}
        ]
    );
    const thirdNominees = [];
    for (const id of ["p2050", "psl"]) {
        for (let seat = 0; seat < thirdNomineeParts[id]; seat += 1) {
            thirdNominees.push(id);
        }
    }
    const rightPactNomineeParts = apportionFormation(
        Q.senate_total,
        [
            {id: "pis", weight: senateVotes.pis},
            {id: "konf", weight: senateVotes.konf}
        ]
    );
    const rightPactNominees = [];
    for (const id of ["pis", "konf"]) {
        for (let seat = 0; seat < rightPactNomineeParts[id]; seat += 1) {
            rightPactNominees.push(id);
        }
    }
    for (let i = thirdNominees.length - 1; i > 0; i -= 1) {
        const swap = this.random.uint32() % (i + 1);
        const current = thirdNominees[i];
        thirdNominees[i] = thirdNominees[swap];
        thirdNominees[swap] = current;
    }
    for (let i = rightPactNominees.length - 1; i > 0; i -= 1) {
        const swap = this.random.uint32() % (i + 1);
        const current = rightPactNominees[i];
        rightPactNominees[i] = rightPactNominees[swap];
        rightPactNominees[swap] = current;
    }
    const senateWinners = {
        pis: 0,
        konf: 0,
        ko: 0,
        p2050: 0,
        psl: 0,
        left: 0,
        independent: 0
    };
    let closestMargin = 100;
    const randomUnit = function(context) {
        return context.random.uint32() / 4294967296;
    };
    for (let district = 0; district < Q.senate_total; district += 1) {
        const democraticLean = (randomUnit(this) - 0.5) * 44;
        const candidates = [];
        const addCandidate = function(id, score) {
            if (score > 0) candidates.push({id: id, score: score});
        };
        if (Q.senate_pact_coordinated) {
            const transfer = 0.88 + pactStrength / 1000;
            if (String(Q.senate_pact_side || "left") == "right") {
                addCandidate(
                    rightPactNominees[district],
                    rightPactVote * transfer - democraticLean +
                        (randomUnit(this) - 0.5) * 8
                );
                if (rightVoteInsidePact == false) {
                    addCandidate(
                        "pis",
                        senateVotes.pis - democraticLean +
                            (randomUnit(this) - 0.5) * 10
                    );
                }
            } else {
                addCandidate(
                    pactNominees[district],
                    democraticPactVote * transfer + democraticLean +
                        (randomUnit(this) - 0.5) * 8
                );
                if (leftPactMode == "outside") {
                    addCandidate(
                        "left",
                        senateVotes.left + democraticLean * 0.55 +
                            (randomUnit(this) - 0.5) * 18
                    );
                }
            }
        } else {
            addCandidate(
                "ko",
                senateVotes.ko + democraticLean +
                    (randomUnit(this) - 0.5) * 12
            );
            addCandidate(
                thirdNominees[district],
                senateVotes.p2050 + senateVotes.psl + democraticLean * 0.45 +
                    (randomUnit(this) - 0.5) * 18
            );
            addCandidate(
                "left",
                senateVotes.left + democraticLean * 0.55 +
                    (randomUnit(this) - 0.5) * 18
            );
        }
        if (String(Q.senate_pact_side || "left") != "right") {
            addCandidate(
                "pis",
                senateVotes.pis - democraticLean +
                    (randomUnit(this) - 0.5) * 10
            );
            addCandidate(
                "konf",
                senateVotes.konf - democraticLean * 0.35 +
                    (randomUnit(this) - 0.5) * 16
            );
            addCandidate(
                "pis",
                senateVotes.rozwoj - democraticLean * 0.3 +
                    (randomUnit(this) - 0.5) * 18
            );
            addCandidate(
                "konf",
                senateVotes.korona - democraticLean * 0.25 +
                    (randomUnit(this) - 0.5) * 18
            );
        }
        addCandidate(
            "independent",
            senateVotes.independent + randomUnit(this) * 42
        );
        candidates.sort(function(a, b) {
            return b.score - a.score;
        });
        const winner = candidates[0] || {id: "independent", score: 0};
        senateWinners[winner.id] += 1;
        if (candidates.length > 1) {
            closestMargin = Math.min(
                closestMargin,
                winner.score - candidates[1].score
            );
        }
    }
    Q.senate_pis_seats = senateWinners.pis;
    Q.senate_konf_seats = senateWinners.konf;
    Q.senate_ko_seats = senateWinners.ko;
    Q.senate_p2050_seats = senateWinners.p2050;
    Q.senate_psl_seats = senateWinners.psl;
    Q.senate_left_seats = senateWinners.left;
    Q.senate_independent_seats = senateWinners.independent;
    Q.senate_democratic_seats =
        Q.senate_ko_seats + Q.senate_p2050_seats +
        Q.senate_psl_seats + Q.senate_left_seats;
    Q.senate_right_seats =
        Q.senate_pis_seats + Q.senate_konf_seats;
    Q.senate_opposition_seats =
        Q.senate_democratic_seats + Q.senate_independent_seats;
    const senateCohesion = Math.max(
        0,
        Math.min(100, finiteFormation(Q.senate_cohesion, 50))
    );
    Q.senate_working_votes = Math.min(
        Q.senate_total,
        Math.round(
            Q.senate_democratic_seats +
            Q.senate_independent_seats * senateCohesion / 100
        )
    );
    Q.senate_marshal = Q.senate_democratic_seats >= 51
        ? "Małgorzata Kidawa-Błońska"
        : (
            Q.senate_right_seats >= 51
                ? "Stanisław Karczewski"
                : "Senate election pending"
        );
    Q.senate_control = Q.senate_democratic_seats >= 51
        ? "Democratic Senate majority"
        : (
            Q.senate_right_seats >= 51
                ? "Right-aligned Senate majority"
                : "Hung Senate"
        );
    Q.senate_election_rule =
        "100 single-member districts; the leading candidate wins";
    Q.senate_election_closest_margin =
        Math.round(Math.max(0, closestMargin) * 100) / 100;
    Q.senate_election_2023_certified = 1;
}

