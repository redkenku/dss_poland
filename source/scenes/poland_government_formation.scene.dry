@formation_builder_commit
title: Continue with the interactive government agreement
view-if: coalition_builder_ready = 1
choose-if: coalition_builder_ready = 1
on-arrival: {!
const result = typeof polandCoalitionModel != "undefined"
    ? polandCoalitionModel.preview(Q) : {ok: false, route_code: "custom"};
Q.coalition_builder_ready = result.ok ? 1 : 0;
Q.coalition_builder_pending = result.ok ? 1 : 0;
Q.coalition_builder_route = result.route_code;
!}
go-to: formation_pick_left_only if coalition_builder_pending = 1 and coalition_builder_route = "left_only"; formation_pick_democratic if coalition_builder_pending = 1 and coalition_builder_route = "democratic_2023"; formation_pick_ko_psl_left if coalition_builder_pending = 1 and coalition_builder_route = "ko_psl_left"; formation_pick_ko_p2050_left if coalition_builder_pending = 1 and coalition_builder_route = "ko_p2050_left"; formation_pick_left_p2050 if coalition_builder_pending = 1 and coalition_builder_route = "left_p2050"; formation_pick_left_psl if coalition_builder_pending = 1 and coalition_builder_route = "left_psl"; formation_pick_left_third if coalition_builder_pending = 1 and coalition_builder_route = "left_third"; formation_pick_third_left_pis if coalition_builder_pending = 1 and coalition_builder_route = "third_left_pis"; formation_pick_left_pis if coalition_builder_pending = 1 and coalition_builder_route = "left_pis"; formation_pick_left_pis_psl if coalition_builder_pending = 1 and coalition_builder_route = "left_pis_psl"; formation_pick_left_pis_p2050 if coalition_builder_pending = 1 and coalition_builder_route = "left_pis_p2050"; formation_pick_left_pis_third if coalition_builder_pending = 1 and coalition_builder_route = "left_pis_third"; formation_pick_left_pis_konf if coalition_builder_pending = 1 and coalition_builder_route = "left_pis_konf"; formation_pick_left_pis_konf_psl if coalition_builder_pending = 1 and coalition_builder_route = "left_pis_konf_psl"; formation_pick_ko_left if coalition_builder_pending = 1 and coalition_builder_route = "ko_left"; formation_coalition_menu

@formation_builder_apply
title: Sign the parliamentary agreement
on-arrival: {!
if (Q.coalition_builder_pending && typeof polandCoalitionModel != "undefined") {
    const committed = polandCoalitionModel.commit(Q);
    Q.coalition_builder_pending = committed.committed ? 0 : 1;
}
!}
go-to: formation_marshal_ballot if coalition_builder_pending = 0; formation_coalition_menu

@formation_no_arrangement
title: Record that no bloc in this chamber can sign a contract
subtitle: Every arrangement on offer, including the fallback cabinets, fails on trust or programme distance rather than on seats.
# The compatibility half of every option above. When none of these holds, the
# whole menu and both fallback menus are grey, so the chamber needs the
# constitutional ladder rather than another look at the same arithmetic.
view-if: formation_option_left_only < formation_majority_needed and not (coalition_viable_left_ko = 1 or coalition_viable_left_psl = 1 or coalition_viable_left_p2050 = 1 or coalition_viable_left_pis = 1 or coalition_viable_pis_konf = 1 or coalition_viable_ko_konf = 1 or (coalition_viable_ko_psl = 1 and coalition_viable_ko_p2050 = 1))
on-arrival: coalition_status = "No coalition contract available in this Sejm"; news_headline = "No bloc in the new Sejm can sign a governing contract"
go-to: presidential_first_fails if presidential_majority_designation = 1; third_marshal_gate

@formation_pick_left_only
title: [? if formation_left_splitter_votes > 0: Govern alone on Left splitter toleration?][? if formation_left_splitter_votes = 0: Govern alone?]
subtitle: Every ministry is Lewica's. The splitter clubs stay outside and sign a toleration protocol instead of taking offices.
view-if: formation_status_left_only != "No path"
choose-if: formation_option_left_only >= formation_majority_needed
unavailable-subtitle: Lewica and the Left clubs that would tolerate it hold [+ formation_option_left_only +] seats — short of the [+ formation_majority_needed +] a cabinet needs.
on-arrival: {!
const leftOnlySeats = Math.max(
    0,
    Math.round(Number(Q.left_committed_seats) || 0)
);
Q.formation_coalition_selected = 1;
Q.formation_coalition_code = "left_only";
Q.formation_coalition_members = ["lewica"];
Q.formation_coalition_label = Q.formation_left_splitter_votes > 0
    ? "Lewica, tolerated by the Left splitter clubs"
    : "Lewica";
// The splitter clubs are formally outside the cabinet, but a chamber that has
// just produced this result has no other Left arithmetic to defect to. They
// are counted as government seats for the rest of the term rather than
// re-negotiated bill by bill.
Q.formation_coalition_seats = leftOnlySeats;
Q.formation_coalition_support_seats = leftOnlySeats;
Q.formation_government_party = "lewica";
Q.formation_pm_default = Q.left_leader || "Lewica nominee";
Q.formation_player_in_government = 1;
Q.formation_player_toleration = 0;
Q.coalition_status = "Single-party Lewica cabinet";
Q.candidate_ko_votes = 0;
Q.candidate_p2050_votes = 0;
Q.candidate_psl_cap = 0;
Q.candidate_psl_votes = 0;
Q.candidate_left_votes = leftOnlySeats;
// A signed protocol is what keeps those clubs above the relation threshold
// that puts their seats inside left_committed_seats every time the state is
// normalised. Without it the majority evaporates on the first bad month.
for (const relation of [
    "barons_party_relation", "social_patriot_party_relation",
    "spring_party_relation", "labor_party_relation",
    "progressives_party_relation", "razem_party_relation",
    "pps_party_relation", "tak_rozwoj_parent_relation"
]) {
    if (Number(Q[relation]) >= 45) {
        Q[relation] = Math.max(60, Number(Q[relation]));
    }
}
Q.party_unity = (Number(Q.party_unity) || 50) + 6;
Q.ko_relation -= 4;
Q.news_headline = Q.formation_left_splitter_votes > 0
    ? "The Left reunites on paper for one vote and forms a government"
    : "Lewica forms a government without a single centrist minister";
!}
go-to: formation_builder_apply if coalition_builder_pending = 1; formation_marshal_ballot

@formation_pick_democratic
