@budget_internal_roll
title: The Left's internal budget congress
new-page: true
view-if: left_in_government = 1
on-arrival: {!
let baronsBudget = 50;
let newGenerationBudget = 50;
let springBudget = 50;
let razemBudget = 50;
if (Q.annual_budget_package_code == 1) {
    baronsBudget = 64;
    newGenerationBudget = 82;
    springBudget = 85;
    razemBudget = 92;
}
if (Q.annual_budget_package_code == 2) {
    baronsBudget = 76;
    newGenerationBudget = 78;
    springBudget = 75;
    razemBudget = 68;
}
if (Q.annual_budget_package_code == 3) {
    baronsBudget = 84;
    newGenerationBudget = 52;
    springBudget = 44;
    razemBudget = 18;
}
if (Q.annual_budget_package_code == 4) {
    baronsBudget = 55;
    newGenerationBudget = 50;
    springBudget = 54;
    razemBudget = 45;
}
Q.budget_barons_backing = baronsBudget;
Q.budget_new_generation_backing = newGenerationBudget;
Q.budget_spring_backing = springBudget;
Q.budget_razem_backing = razemBudget;
Q.annual_budget_internal_backing = Math.round(
    (
        baronsBudget * Q.left_barons_seats +
        newGenerationBudget * Q.left_new_generation_seats +
        springBudget * Q.left_spring_seats +
        razemBudget * Q.razem_seats
    ) / Q.left_seats
);
Q.annual_budget_internal_vetoes = [
    baronsBudget,
    newGenerationBudget,
    springBudget,
    razemBudget
].filter(function(value) {
    return value < 35;
}).length;
!}

= Four caucuses, one line

<div class="ledger-section ledger-section-first"><div class="ledger-title">Left
ratification</div>
<div class="ledger-row"><span>Barons · 6 seats</span><b>[+ budget_barons_backing +]%</b></div>
<div class="ledger-row"><span>Younger progressive wing · 8</span><b>[+ budget_new_generation_backing +]%</b></div>
