@third_marshal_abstain
title: Abstain in the Marshal ballot
on-arrival: formation_marshal_vote_choice = "Abstain"
go-to: third_marshal_result

@third_marshal_result
title: Marshal result before PM selection
new-page: true
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const democraticSeats =
    Math.max(0, Number(Q.ko_seats) || 0) +
    Math.max(0, Number(Q.p2050_seats) || 0) +
    Math.max(0, Number(Q.psl_seats) || 0) +
    Math.max(0, Number(Q.left_committed_seats) || 0);
const fallbackRightSeats =
    Math.max(0, Number(Q.pis_seats) || 0) +
    Math.max(0, Number(Q.konf_seats) || 0) +
    Math.max(0, Number(Q.rozwoj_seats) || 0) +
    Math.max(0, Number(Q.korona_seats) || 0) +
    (String(Q.social_patriot_list_committee || "") == "pis"
        ? Math.max(0, Number(Q.social_patriot_seats) || 0)
        : 0);
const rightSeats = Math.max(
    0,
    Number.isFinite(Number(Q.coalition_right_seats))
        ? Number(Q.coalition_right_seats)
        : fallbackRightSeats
);
const playerSeats = Math.max(0, Number(Q.left_committed_seats) || 0);
const playerIncluded = Q.formation_marshal_nominee == "Szymon Hołownia";
let yes = playerIncluded ? democraticSeats : rightSeats;
const nonSupportWithoutPlayer = Math.max(
    0,
    sejmTotal - yes - (playerIncluded ? 0 : playerSeats)
);
let abstain = Math.min(12, nonSupportWithoutPlayer);
if (Q.formation_marshal_vote_choice == "Support" && !playerIncluded) {
    yes += playerSeats;
}
if (Q.formation_marshal_vote_choice == "Reject" && playerIncluded) {
    yes -= playerSeats;
    Q.party_unity += 2;
}
if (Q.formation_marshal_vote_choice == "Abstain") {
    if (playerIncluded) yes -= playerSeats;
    abstain += playerSeats;
}
Q.formation_marshal_yes = Math.max(0, Math.min(sejmTotal, yes));
Q.formation_marshal_abstain = Math.max(
    0,
    Math.min(sejmTotal - Q.formation_marshal_yes, abstain)
);
Q.formation_marshal_no = Math.max(
    0,
    sejmTotal - Q.formation_marshal_yes - Q.formation_marshal_abstain
);
const present = Q.formation_marshal_yes + Q.formation_marshal_no +
    Q.formation_marshal_abstain;
Q.formation_marshal_threshold = Math.floor(present / 2) + 1;
Q.formation_marshal_ballot_passed =
    present >= Q.sejm_quorum_floor &&
    Q.formation_marshal_yes >= Q.formation_marshal_threshold ? 1 : 0;
Q.formation_marshal_compromise = 0;
if (Q.formation_marshal_ballot_passed) {
    Q.formation_marshal_elected = 1;
    Q.sejm_speaker = Q.formation_marshal_nominee;
    Q.news_headline =
        Q.sejm_speaker + " wins the Marshal vote before PM selection";
} else {
    Q.formation_marshal_elected = 1;
    Q.formation_marshal_compromise = 1;
    Q.sejm_speaker = "Marek Sawicki";
    Q.early_election_risk += 8;
    Q.news_headline =
        "After a failed ballot, Marek Sawicki is elected compromise Marshal before the final PM vote";
}
!}

