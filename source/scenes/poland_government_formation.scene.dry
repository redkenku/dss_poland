Q.budget -= 2;
Q.annual_budget_yes = Math.max(0, Q.coalition_democratic_seats);
Q.annual_budget_no =
    Math.max(0, Q.pis_seats) + Math.max(0, Q.konf_seats) +
    Math.max(0, Q.rozwoj_seats) + Math.max(0, Q.korona_seats);
Q.annual_budget_abstain = Math.max(
    0,
    Q.sejm_total - Q.annual_budget_yes - Q.annual_budget_no
);
Q.annual_budget_passed =
    Q.annual_budget_yes > Q.annual_budget_no ? 1 : 0;
Q.government_delivery += Q.annual_budget_passed ? 2 : -2;
Q.psl_coalition_dissent -= 5;
Q.coalition_break_threat = 1;
Q.news_headline = Q.annual_budget_passed
    ? "A revised budget survives inside the constitutional window"
    : "The revised budget still cannot command a simple majority";
!}
