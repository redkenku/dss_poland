@formation_prepare_pis_route
title: Publish the selected PiS coalition
on-arrival: {!
const solidarna = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "solidarna";
});
const solpolExitSeats = Math.min(
    Math.max(0, Math.round(Number(Q.pis_seats) || 0)),
    Math.max(0, Math.round(Number(Q.formation_solpol_exit_seats) || 0))
);
if (solpolExitSeats > 0 && !Q.suwerenna_walkout) {
    Q.pis_seats = Math.max(0, (Number(Q.pis_seats) || 0) - solpolExitSeats);
    Q.suwerenna_seats = solpolExitSeats;
    Q.suwerenna_walkout = 1;
    Q.formation_solpol_exit_triggered = 1;
    if (solidarna) {
        solidarna.active = 1;
        solidarna.allied = 0;
        solidarna.independent = 1;
        solidarna.in_cabinet = 0;
        solidarna.support_mode = "opposition";
        solidarna.club = "sp";
        solidarna.legal_status = "opposition after rejecting a PiS–Lewica cabinet";
        solidarna.mp_count = solpolExitSeats;
        solidarna.sejm_mps = solpolExitSeats;
        solidarna.exclusive_seats = solpolExitSeats;
    }
}
const code = String(Q.formation_pending_pis_code || "left_pis");
const route = {
    left_pis: ["PiS + Lewica", ["pis", "lewica"]],
    left_pis_psl: ["PiS + Lewica + PSL", ["pis", "lewica", "psl"]],
    left_pis_p2050: ["PiS + Lewica + Poland 2050", ["pis", "lewica", "p2050"]],
    left_pis_third: ["PiS + Lewica + Third Way", ["pis", "lewica", "psl", "p2050"]],
    left_pis_konf: ["PiS + Miller's SPS + Konfederacja", ["pis", "lewica", "konf"]],
    left_pis_konf_psl: ["PiS + Miller's SPS + Konfederacja + PSL", ["pis", "lewica", "konf", "psl"]],
    left_pis_konf_p2050: ["PiS + Miller's SPS + Konfederacja + Poland 2050", ["pis", "lewica", "konf", "p2050"]],
    left_pis_konf_third: ["PiS + Miller's SPS + Konfederacja + Third Way", ["pis", "lewica", "konf", "psl", "p2050"]]
}[code];
const members = route[1];
const seats = {
    pis: Number(Q.pis_seats) || 0,
    lewica: Number(Q.left_committed_seats) || 0,
    psl: Number(Q.psl_seats) || 0,
    p2050: Number(Q.p2050_seats) || 0,
    konf: Number(Q.konf_seats) || 0
};
Q.formation_coalition_selected = 1;
Q.formation_coalition_code = code;
Q.formation_coalition_label = route[0];
Q.formation_coalition_members = members;
Q.formation_coalition_seats = members.reduce(function(total, member) {
    return total + (seats[member] || 0);
}, 0);
Q.formation_coalition_support_seats = Q.formation_coalition_seats;
Q.formation_government_party = "pis";
Q.formation_pm_default = "Mateusz Morawiecki";
Q.formation_player_in_government = 1;
Q.formation_player_toleration = 0;
Q.formation_pis_player_coalition = 1;
Q.formation_rival_automatic_pm = 0;
Q.formation_pis_left_safeguards = 0;
Q.formation_pis_cabinet_committed = 1;
Q.formation_ko_cabinet_committed = 0;
Q.formation_psl_cabinet_committed = members.includes("psl") ? 1 : 0;
Q.formation_p2050_cabinet_committed = members.includes("p2050") ? 1 : 0;
Q.formation_konf_cabinet_committed = members.includes("konf") ? 1 : 0;
Q.candidate_ko_votes = 0;
Q.candidate_p2050_votes = members.includes("p2050") ? seats.p2050 : 0;
Q.candidate_psl_votes = members.includes("psl") ? seats.psl : 0;
Q.candidate_psl_cap = Q.candidate_psl_votes;
Q.candidate_left_votes = seats.lewica;
Q.coalition_status = route[0] + " exploratory contract";
Q.pis_relation += 10;
Q.ko_relation -= 14;
Q.party_unity -= 8;
if (members.includes("psl")) Q.psl_relation += 4;
if (members.includes("p2050")) Q.p2050_relation += 4;
if (members.includes("konf")) {
    Q.konf_relation += 4;
    Q.progressives_dissent += 8;
}
Q.news_headline = "Lewica selects " + route[0] + " before naming a premier";
if (Q.coalition_builder_pending && typeof polandCoalitionModel != "undefined") {
    const committed = polandCoalitionModel.commit(Q);
    Q.coalition_builder_pending = committed.committed ? 0 : 1;
}
!}
go-to: formation_pis_negotiation_start if coalition_builder_pending = 0; formation_coalition_menu

@formation_pis_negotiation_start
title: PiS tests whether it has another majority
on-arrival: {!
const majority = Math.max(1, Number(Q.formation_majority_needed) || 231);
const seats = function() {
    return Array.prototype.slice.call(arguments).reduce(function(total, key) {
        return total + Math.max(0, Number(Q[key + "_seats"]) || 0);
    }, 0);
};
const can = function(total, gates) {
    return total >= majority && gates.every(Boolean);
};
let code = "none";
let label = "No rival majority";
let pressure = 0;
const rivalProcessClosed = Boolean(Q.formation_pis_rival_process_resolved) ||
    Boolean(Q.formation_pis_left_taboo_broken);
if (!rivalProcessClosed && can(seats("pis", "psl"), [Q.coalition_viable_pis_psl])) {
    code = "pis_psl";
    label = "PiS + PSL";
    pressure = 2;
} else if (!rivalProcessClosed && can(seats("pis", "psl", "p2050"), [
    Q.coalition_viable_pis_psl,
    Q.coalition_viable_pis_p2050,
    Q.coalition_viable_psl_p2050
])) {
    code = "pis_third";
    label = "PiS + Third Way";
    pressure = 2;
} else if (!rivalProcessClosed && can(seats("pis", "psl", "konf"), [
    Q.coalition_viable_pis_psl,
    Q.coalition_viable_pis_konf,
    Q.coalition_viable_psl_konf
])) {
    code = "pis_psl_konf";
    label = "PiS + PSL + Konfederacja";
    pressure = 1;
} else if (!rivalProcessClosed && can(seats("pis", "psl", "p2050", "konf"), [
    Q.coalition_viable_pis_psl,
    Q.coalition_viable_pis_p2050,
    Q.coalition_viable_pis_konf,
    Q.coalition_viable_psl_p2050,
    Q.coalition_viable_psl_konf,
    Q.coalition_viable_konf_p2050
])) {
    code = "pis_third_konf";
    label = "PiS + Third Way + Konfederacja";
    pressure = 1;
} else if (!rivalProcessClosed && can(seats("pis", "konf"), [Q.coalition_viable_pis_konf])) {
    code = "pis_konf";
    label = "PiS + Konfederacja";
    pressure = 1;
}
Q.formation_pis_rival_code = code;
Q.formation_pis_rival_label = label;
Q.formation_pis_rival_pressure = pressure;
Q.formation_pis_rival_process_started = code == "none" ? 0 : 1;
Q.formation_pis_rival_skip_reason = rivalProcessClosed
    ? (Q.formation_pis_left_taboo_broken
        ? "PiS–Lewica governing taboo already broken"
        : "Rival-government contest already resolved")
    : (code == "none" ? "No viable rival majority" : "Live rival majority");
Q.news_headline = code == "none"
    ? (rivalProcessClosed
        ? "The earlier PiS–Lewica precedent closes any repeat coalition auction"
        : "PiS finds no alternative majority and returns to the Left contract")
    : "PiS opens a parallel channel for " + label;
!}
go-to: formation_pis_safeguard_institutions

@formation_pis_safeguard_institutions
title: First safeguard — institutions and equality
new-page: true

PiS and Lewica must decide whether their cross-bloc contract contains an
enforceable institutional floor or only a promise to avoid immediate conflict.
[? if formation_pis_rival_code != "none": At the same time, **[+
formation_pis_rival_label +]** remains a live replacement majority.?]

- @formation_pis_institutions_firm
- @formation_pis_institutions_truce

@formation_pis_institutions_firm
title: Write enforceable institutional and equality safeguards
subtitle: Counts toward the contract and makes the parallel coalition less attractive.
on-arrival: formation_pis_left_safeguards += 1; formation_pis_rival_pressure -= 1 if formation_pis_rival_pressure > 0; constitutional_restraint += 5; minority_safety += 3; pis_relation -= 2; news_headline = "The cross-bloc contract gains enforceable institutional safeguards"
go-to: formation_pis_safeguard_welfare

@formation_pis_institutions_truce
title: Accept a temporary institutional truce
subtitle: Easier tonight, but it neither binds the cabinet nor closes PiS's other channel.
on-arrival: pis_relation += 3; constitutional_restraint -= 2; progressives_dissent += 4; news_headline = "PiS and Lewica postpone their institutional conflict"
go-to: formation_pis_safeguard_welfare

@formation_pis_safeguard_welfare
title: Second safeguard — the social floor
new-page: true

The cabinet needs a common answer on wages, public services and household
security before any ministry can be used as a substitute for policy.

- @formation_pis_welfare_firm
- @formation_pis_welfare_offices

@formation_pis_welfare_firm
title: Sign a welfare, labour and public-services floor
subtitle: Counts toward the contract and narrows the programme available to a rival cabinet.
on-arrival: formation_pis_left_safeguards += 1; formation_pis_rival_pressure -= 1 if formation_pis_rival_pressure > 0; labor_credibility += 5; household_security += 3; pis_relation += 2; news_headline = "PiS signs the social floor demanded by Lewica"
go-to: formation_pis_safeguard_exclusivity

@formation_pis_welfare_offices
title: Trade policy guarantees for a larger ministry offer
subtitle: More offices, no second safeguard, and the rival channel stays open.
on-arrival: budget_promises += 3; barons_dissent -= 3; razem_dissent += 6; coalition_blur += 4; news_headline = "The social floor dissolves into an auction over ministries"
go-to: formation_pis_safeguard_exclusivity

@formation_pis_safeguard_exclusivity
title: Third safeguard — one coalition at a time
new-page: true

[? if formation_pis_rival_code = "none": No other bloc can presently reach a
majority. An exclusivity clause still decides whether this cabinet is a real
contract rather than a collection of offices.?]
[? if formation_pis_rival_code != "none": PiS must choose between the selected
Left-inclusive contract and **[+ formation_pis_rival_label +]**. The latter is
[? if formation_pis_rival_pressure = 1: one firm commitment?][? if formation_pis_rival_pressure > 1: [+ formation_pis_rival_pressure +] firm commitments?]
away from being closed.?]

- @formation_pis_exclusive_firm
- @formation_pis_exclusive_auction

@formation_pis_exclusive_firm
title: Require a written no-replacement clause
subtitle: Counts as the third safeguard and closes one remaining point of rival pressure.
on-arrival: formation_pis_left_safeguards += 1; formation_pis_rival_pressure -= 1 if formation_pis_rival_pressure > 0; pis_relation += 2; coalition_blur -= 3; news_headline = "PiS signs an exclusivity clause with the selected coalition"
go-to: formation_pis_negotiation_result

@formation_pis_exclusive_auction
title: Let PiS keep both offers alive until the office ballots
subtitle: No safeguard; a live rival regains pressure.
on-arrival: {!
if (Q.formation_pis_rival_code != "none") {
    Q.formation_pis_rival_pressure = Math.min(
        2,
        Math.max(0, Number(Q.formation_pis_rival_pressure) || 0) + 1
    );
}
Q.party_unity -= 3;
Q.public_trust -= 2;
Q.news_headline = "PiS keeps the coalition auction open";
!}
go-to: formation_pis_negotiation_result

@formation_pis_negotiation_result
title: The cross-bloc contract reaches its deadline
on-arrival: {!
if (Q.formation_pis_rival_process_started) {
    Q.formation_pis_rival_process_resolved = 1;
}
if ((Number(Q.formation_pis_left_safeguards) || 0) >= 2 &&
    (Number(Q.formation_pis_rival_pressure) || 0) <= 0) {
    Q.formation_pis_left_taboo_broken = 1;
}
!}
go-to: formation_pis_rival_wins if formation_pis_rival_code != "none" and formation_pis_rival_pressure > 0; formation_pis_contract_signed if formation_pis_left_safeguards >= 2; formation_pis_contract_fails

@formation_pis_contract_signed
title: The selected PiS coalition signs
new-page: true
on-arrival: {!
Q.coalition_status = String(Q.formation_coalition_label || "PiS–Lewica") + " signed contract";
Q.news_headline = String(Q.formation_coalition_label || "PiS–Lewica") + " closes its parallel negotiations";
Q.formation_pis_left_taboo_broken = 1;
if (!Q.formation_pis_left_taboo_origin) {
    Q.formation_pis_left_taboo_origin = "PiS–Lewica formation contract";
}
!}

The partners have signed **[+ formation_pis_left_safeguards +]** enforceable
safeguards. The agreement now proceeds to the Marshal and prime-ministerial
ballots.

- @formation_marshal_ballot: Proceed to the Marshal ballot

@formation_pis_contract_fails
title: The Left contract fails without a replacement majority
new-page: true
on-arrival: {!
Q.formation_coalition_selected = 0;
Q.formation_coalition_code = "none";
Q.formation_coalition_members = [];
Q.pis_relation -= 6;
Q.party_unity -= 3;
Q.news_headline = "The PiS–Lewica contract fails its own safeguard test";
!}

Fewer than two safeguards survived. PiS has no viable replacement majority,
but Lewica cannot turn an office auction into a cabinet contract.

- @formation_coalition_menu: Return to coalition selection

@formation_pis_rival_wins
title: PiS replaces the player with its rival majority
new-page: true
on-arrival: {!
const code = String(Q.formation_pis_rival_code || "pis_konf");
const routes = {
    pis_psl: ["PiS + PSL", ["pis", "psl"]],
    pis_third: ["PiS + Third Way", ["pis", "psl", "p2050"]],
    pis_psl_konf: ["PiS + PSL + Konfederacja", ["pis", "psl", "konf"]],
    pis_third_konf: ["PiS + Third Way + Konfederacja", ["pis", "psl", "p2050", "konf"]],
    pis_konf: ["PiS + Konfederacja", ["pis", "konf"]]
};
const route = routes[code];
const members = route[1];
const seatMap = {
    pis: Number(Q.pis_seats) || 0,
    psl: Number(Q.psl_seats) || 0,
    p2050: Number(Q.p2050_seats) || 0,
    konf: Number(Q.konf_seats) || 0
};
Q.formation_coalition_selected = 1;
Q.formation_coalition_code = code;
Q.formation_coalition_label = route[0];
Q.formation_coalition_members = members;
Q.formation_coalition_seats = members.reduce(function(total, member) {
    return total + (seatMap[member] || 0);
}, 0);
Q.formation_coalition_support_seats = Q.formation_coalition_seats;
Q.formation_government_party = "pis";
Q.formation_pm_default = "Mateusz Morawiecki";
Q.formation_player_in_government = 0;
Q.formation_player_toleration = 0;
Q.formation_pis_player_coalition = 0;
Q.formation_rival_automatic_pm = 1;
Q.formation_pis_rival_process_resolved = 1;
Q.formation_pis_cabinet_committed = 1;
Q.formation_ko_cabinet_committed = 0;
Q.formation_psl_cabinet_committed = members.includes("psl") ? 1 : 0;
Q.formation_p2050_cabinet_committed = members.includes("p2050") ? 1 : 0;
Q.formation_konf_cabinet_committed = members.includes("konf") ? 1 : 0;
Q.candidate_ko_votes = 0;
Q.candidate_p2050_votes = members.includes("p2050") ? seatMap.p2050 : 0;
Q.candidate_psl_votes = members.includes("psl") ? seatMap.psl : 0;
Q.candidate_psl_cap = Q.candidate_psl_votes;
Q.candidate_left_votes = 0;
if (["pis_psl", "pis_psl_konf"].includes(code)) {
    Q.third_way_split = 1;
    Q.third_way_active = 0;
    Q.third_way_joint_list = 0;
    Q.third_way_display_name = "PSL and Poland 2050";
    Q.third_way_future = "Split after PSL joined a PiS-led cabinet";
}
Q.coalition_status = route[0] + " replaces the Left talks";
Q.news_headline = "PiS abandons Lewica for " + route[0];
!}

Lewica failed to close **[+ formation_pis_rival_label +]**. The replacement
majority proceeds without player ministries or a player-selected nominee.

- @formation_marshal_ballot: Proceed as opposition to the Marshal ballot

@formation_pick_ko_left
title: Build a KO-Lewica arrangement without Third Way
subtitle: A two-party majority governs alone when it has 231 seats; Third Way supplies only the exact shortfall otherwise.
view-if: formation_status_ko_left != "No path"
choose-if: formation_option_ko_left >= formation_majority_needed and coalition_viable_left_ko = 1
unavailable-subtitle: [? if formation_option_ko_left < formation_majority_needed: KO and Lewica reach only [+ formation_option_ko_left +] seats even with the Third Way toleration this format can expect. ?][? if coalition_viable_left_ko = 0: Distrust and programme distance between KO and Lewica rule out a joint cabinet contract. ?]
on-arrival: {!
Q.formation_coalition_selected = 1;
Q.formation_coalition_code = "ko_left";
Q.formation_coalition_label = "KO + Lewica";
Q.formation_coalition_members = ["ko", "lewica"];
Q.formation_coalition_seats = Number(Q.formation_option_ko_left_formal) || 0;
const outsideSupport = Number(Q.formation_option_ko_left_outside) || 0;
Q.formation_coalition_support_seats =
    Q.formation_coalition_seats + outsideSupport;
Q.formation_government_party = "ko";
Q.formation_pm_default = Q.ko_leader || "KO nominee";
Q.coalition_status = outsideSupport > 0
    ? "KO-Lewica cabinet with Third Way toleration"
    : "Self-sufficient KO-Lewica majority";
Q.candidate_ko_votes = Q.ko_seats;
Q.candidate_p2050_votes = Math.min(
    Number(Q.p2050_seats) || 0,
    outsideSupport
);
Q.candidate_psl_votes = Math.max(
    0,
    outsideSupport - Q.candidate_p2050_votes
);
Q.candidate_psl_cap = Q.candidate_psl_votes;
Q.candidate_left_votes = Q.left_committed_seats;
Q.ko_relation += 5;
Q.p2050_relation -= outsideSupport > 0 ? 2 : 8;
Q.psl_relation -= outsideSupport > 0 ? 2 : 9;
Q.news_headline = outsideSupport > 0
    ? "KO and Lewica secure the exact Third Way votes they lack"
    : "KO and Lewica form a two-party majority without Third Way";
!}
go-to: formation_builder_apply if coalition_builder_pending = 1; formation_marshal_ballot

@formation_fallback_menu
title: Explore fallback governments
new-page: true

= The majority that excludes the player

The first coalition contract has not produced a government in which the
player's party holds ministries. The chamber can now test the other arithmetic
without putting every option on the same ballot. Choose one political family;
the next page decides whether Konfederacja enters the cabinet formally or the
player stays outside and supplies toleration.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Fallback seat blocks</div>
<div class="ledger-row"><span>PiS + [+ konf_family_label +]</span><b>[+ pis_seats + konf_family_seats +] formal seats</b></div>
<div class="ledger-row"><span>PiS + [+ konf_family_label +] + Third Way</span><b>[+ pis_seats + konf_family_seats + p2050_seats + psl_seats +] formal seats</b></div>
<div class="ledger-row"><span>PiS + [+ konf_family_label +] + PSL</span><b>[+ pis_seats + konf_family_seats + psl_seats +] formal seats</b></div>
<div class="ledger-row"><span>KO + Third Way</span><b>[+ ko_seats + p2050_seats + psl_seats +] formal seats</b></div>
<div class="ledger-row"><span>KO + [+ konf_family_label +]</span><b>[+ ko_seats + konf_family_seats +] formal seats before centre partners</b></div></div>

- @formation_fallback_right_menu: Examine right-wing fallback governments
- @formation_fallback_ko_menu: Examine KO-led fallback governments
- @formation_coalition_menu: Back to coalition arrangements

@formation_fallback_right_menu
title: Right-wing fallback governments
new-page: true

The right can offer Konfederacja a formal place, or ask the Third Way/PSL to
provide institutional cover. The player remains outside these cabinets unless
the later toleration contract says otherwise.

- @formation_fallback_pis_konf
- @formation_fallback_pis_konf_third
- @formation_fallback_pis_konf_psl
- @formation_fallback_menu: Back to fallback families

@formation_fallback_ko_menu
title: KO-led fallback governments
new-page: true

KO can seek a reduced Third Way cabinet or make the more dangerous bargain of
bringing Konfederacja into the cabinet. The player may instead remain outside
and trade confidence for safeguards.

- @formation_fallback_ko_third
- @formation_fallback_ko_konf
- @formation_fallback_menu: Back to fallback families

@formation_fallback_pis_konf
title: PiS + the Konfederacja family
subtitle: A formal right-wing cabinet, or a right-wing cabinet tolerated from outside.
view-if: coalition_viable_pis_konf = 1 and pis_seats + konf_family_seats + left_committed_seats >= formation_majority_needed
choose-if: coalition_viable_pis_konf = 1
unavailable-subtitle: PiS and Konfederacja are too far apart, in trust and in programme, to sign a cabinet contract in this Sejm.
on-arrival: {!
Q.formation_fallback_code = "pis_konf";
Q.formation_fallback_label = "PiS + " + Q.konf_family_label;
Q.formation_fallback_members = ["pis", "konf"];
Q.formation_fallback_role = "Undecided";
Q.formation_fallback_seats = Q.pis_seats + Q.konf_family_seats;
!}
go-to: formation_fallback_role

@formation_fallback_pis_konf_third
title: PiS + Konfederacja + Third Way
subtitle: PiS seeks a broader right-wing arrangement and the Third Way's institutional cover.
view-if: coalition_viable_pis_konf = 1 and coalition_viable_pis_psl = 1 and coalition_viable_pis_p2050 = 1 and pis_seats + konf_family_seats + p2050_seats + psl_seats + left_committed_seats >= formation_majority_needed
choose-if: coalition_viable_pis_konf = 1 and coalition_viable_pis_psl = 1 and coalition_viable_pis_p2050 = 1
unavailable-subtitle: [? if coalition_viable_pis_konf = 0: PiS and Konfederacja cannot sign a cabinet contract in this Sejm. ?][? if coalition_viable_pis_psl = 0 or coalition_viable_pis_p2050 = 0: The Third Way parties will not give institutional cover to a right-wing cabinet on these terms. ?]
on-arrival: {!
Q.formation_fallback_code = "pis_konf_third";
Q.formation_fallback_label = "PiS + " + Q.konf_family_label + " + Third Way";
Q.formation_fallback_members = ["pis", "konf", "psl", "p2050"];
Q.formation_fallback_role = "Undecided";
Q.formation_fallback_seats = Q.pis_seats + Q.konf_family_seats + Q.p2050_seats + Q.psl_seats;
!}
go-to: formation_fallback_role

@formation_fallback_pis_konf_psl
title: PiS + Konfederacja + PSL
subtitle: A PiS–Konfederacja core offers PSL rural guarantees and ministries.
view-if: coalition_viable_pis_konf = 1 and coalition_viable_pis_psl = 1 and pis_seats + konf_family_seats + psl_seats + left_committed_seats >= formation_majority_needed
choose-if: coalition_viable_pis_konf = 1 and coalition_viable_pis_psl = 1
unavailable-subtitle: [? if coalition_viable_pis_konf = 0: PiS and Konfederacja cannot sign a cabinet contract in this Sejm. ?][? if coalition_viable_pis_psl = 0: PSL will not take ministries from a cabinet it neither trusts nor shares a programme with. ?]
on-arrival: {!
Q.formation_fallback_code = "pis_konf_psl";
Q.formation_fallback_label = "PiS + " + Q.konf_family_label + " + PSL";
Q.formation_fallback_members = ["pis", "konf", "psl"];
Q.formation_fallback_role = "Undecided";
Q.formation_fallback_seats = Q.pis_seats + Q.konf_family_seats + Q.psl_seats;
!}
go-to: formation_fallback_role

@formation_fallback_ko_third
title: KO + Third Way
subtitle: A centrist cabinet that excludes the player and must find confidence elsewhere.
view-if: coalition_viable_ko_psl = 1 and coalition_viable_ko_p2050 = 1 and ko_seats + p2050_seats + psl_seats + left_committed_seats >= formation_majority_needed
choose-if: coalition_viable_ko_psl = 1 and coalition_viable_ko_p2050 = 1
unavailable-subtitle: KO and the Third Way parties are too far apart, in trust and in programme, to sign a cabinet contract in this Sejm.
on-arrival: {!
Q.formation_fallback_code = "ko_third";
Q.formation_fallback_label = "KO + Third Way";
Q.formation_fallback_members = ["ko", "psl", "p2050"];
Q.formation_fallback_role = "Undecided";
Q.formation_fallback_seats = Q.ko_seats + Q.p2050_seats + Q.psl_seats;
!}
go-to: formation_fallback_role

@formation_fallback_ko_konf
title: KO + the Konfederacja family
subtitle: A poisonous institutional bargain that adds PSL and Poland 2050 only if 231 requires them.
view-if: coalition_viable_ko_konf = 1 and (trz_freebie_law = "" or ko_konf_partner_line != "closed") and (ko_seats + konf_family_seats + left_committed_seats >= formation_majority_needed or (psl_konf_partner_line != "closed" and coalition_viable_ko_psl = 1 and coalition_viable_psl_konf = 1 and ko_seats + konf_family_seats + psl_seats + left_committed_seats >= formation_majority_needed) or (psl_konf_partner_line != "closed" and coalition_viable_ko_psl = 1 and coalition_viable_psl_konf = 1 and coalition_viable_ko_p2050 = 1 and coalition_viable_psl_p2050 = 1 and coalition_viable_konf_p2050 = 1 and ko_seats + konf_family_seats + psl_seats + p2050_seats + left_committed_seats >= formation_majority_needed))
choose-if: coalition_viable_ko_konf = 1 and (trz_freebie_law = "" or ko_konf_partner_line != "closed")
unavailable-subtitle: A liberal KO and Konfederacja are too far apart, in trust and in programme, to sign a cabinet contract in this Sejm.
on-arrival: {!
Q.formation_fallback_code = "ko_konf";
Q.formation_fallback_members = ["ko", "konf"];
Q.formation_fallback_seats =
    (Number(Q.ko_seats) || 0) + (Number(Q.konf_family_seats) || 0);
if (Q.formation_fallback_seats < Q.formation_majority_needed &&
    Q.psl_konf_partner_line != "closed" &&
    Q.coalition_viable_ko_psl && Q.coalition_viable_psl_konf) {
    Q.formation_fallback_members.push("psl");
    Q.formation_fallback_seats += Number(Q.psl_seats) || 0;
}
if (Q.formation_fallback_seats < Q.formation_majority_needed &&
    Q.coalition_viable_ko_p2050 && Q.coalition_viable_konf_p2050 &&
    (!Q.formation_fallback_members.includes("psl") ||
        Q.coalition_viable_psl_p2050)) {
    Q.formation_fallback_members.push("p2050");
    Q.formation_fallback_seats += Number(Q.p2050_seats) || 0;
}
Q.formation_fallback_label = "KO + " + Q.konf_family_label +
    (Q.formation_fallback_members.includes("psl") ? " + PSL" : "") +
    (Q.formation_fallback_members.includes("p2050")
        ? " + Poland 2050" : "");
Q.formation_fallback_role = "Undecided";
!}
go-to: formation_fallback_role

@formation_fallback_role
title: Decide the player's role in the fallback
new-page: true

= Ministries or toleration

The proposed arrangement is **[+ formation_fallback_label +]**. The listed
parties can take collective cabinet responsibility while the player remains
outside, or the player can add a written confidence-and-supply promise without
accepting ministries. Toleration is support, not government ownership: it gives
no budget authority and no ministerial responsibility.

- @formation_fallback_formal
- @formation_fallback_tolerate
- @formation_fallback_back: Review another fallback arrangement

@formation_fallback_back
title: Review another fallback arrangement
go-to: formation_fallback_menu

@formation_fallback_formal
title: Accept the formal [+ formation_fallback_label +] cabinet
subtitle: The listed parties take ministries; the player remains outside and offers no automatic confidence votes.
view-if: formation_fallback_seats >= formation_majority_needed
on-arrival: {!
const code = String(Q.formation_fallback_code || "");
const pisLed = code.indexOf("pis_") === 0;
const fallbackMembers = Array.isArray(Q.formation_fallback_members)
    ? Q.formation_fallback_members : [];
const konfLed = fallbackMembers.includes("konf") &&
    (Number(Q.konf_family_seats) || 0) >
        (pisLed ? (Number(Q.pis_seats) || 0) : (Number(Q.ko_seats) || 0));
Q.formation_coalition_selected = 1;
Q.formation_player_toleration = 0;
Q.formation_player_in_government = 0;
Q.formation_government_party = konfLed ? "konf" : (pisLed ? "pis" : "ko");
Q.formation_pm_default = konfLed
    ? Q.konf_pm_candidate
    : (pisLed
    ? (Number(Q.pis_right_score) >= 60
        ? "Przemysław Czarnek"
        : "Mateusz Morawiecki")
    : "Donald Tusk");
Q.formation_coalition_code = code;
Q.formation_coalition_label = Q.formation_fallback_label + " formal cabinet";
Q.formation_coalition_members = fallbackMembers;
Q.formation_coalition_seats = Number(Q.formation_fallback_seats) || 0;
Q.formation_coalition_support_seats = Q.formation_coalition_seats;
Q.coalition_status = Q.formation_coalition_label;
Q.news_headline = "The chamber tests a formal fallback cabinet without the player";
!}
go-to: formation_marshal_ballot

@formation_fallback_tolerate
title: Withhold ministries and offer toleration
subtitle: The player votes confidence from outside; the fallback cabinet receives no player ministers.
view-if: formation_fallback_seats + left_committed_seats >= formation_majority_needed
on-arrival: {! 
const code = String(Q.formation_fallback_code || "");
const pisLed = code.indexOf("pis_") === 0;
const fallbackMembers = Array.isArray(Q.formation_fallback_members)
    ? Q.formation_fallback_members : [];
const konfLed = fallbackMembers.includes("konf") &&
    (Number(Q.konf_family_seats) || 0) >
        (pisLed ? (Number(Q.pis_seats) || 0) : (Number(Q.ko_seats) || 0));
Q.formation_coalition_selected = 1;
Q.formation_player_toleration = 1;
Q.formation_player_in_government = 0;
Q.formation_government_party = konfLed ? "konf" : (pisLed ? "pis" : "ko");
Q.formation_pm_default = konfLed
    ? Q.konf_pm_candidate
    : (pisLed
    ? (Number(Q.pis_right_score) >= 60
        ? "Przemysław Czarnek"
        : "Mateusz Morawiecki")
    : "Donald Tusk");
Q.formation_coalition_code = code + "_tolerated";
Q.formation_coalition_label = Q.formation_fallback_label + " with player toleration";
Q.formation_coalition_members = fallbackMembers;
Q.formation_coalition_seats = Number(Q.formation_fallback_seats) || 0;
Q.formation_coalition_support_seats = Q.formation_coalition_seats + (Number(Q.left_committed_seats) || 0);
Q.coalition_status = Q.formation_coalition_label;
Q.news_headline = "The player refuses ministries and offers a written toleration pact";
!}
go-to: formation_marshal_ballot

@formation_toleration_menu
title: Offer toleration without ministries
new-page: true

= Confidence without cabinet seats

This is the Weimar-style distinction between entering government and keeping a
cabinet alive. Choose a fallback family first; the next page offers formal
Konfederacja participation or the player's external toleration.

- @formation_fallback_menu

@formation_marshal_ballot
title: Secret ballot for the Sejm Marshal
new-page: true
face-image: img/poland/cards/coalition-council.webp
on-arrival: {!
const coalitionCode = String(Q.formation_coalition_code || "none");
const baseCoalitionCode = coalitionCode.replace(/_tolerated$/, "");
if ([
    "democratic_2023", "ko_p2050_left", "left_p2050", "left_third", "ko_third",
    "left_pis_p2050", "left_pis_third",
    "left_pis_konf_p2050", "left_pis_konf_third",
    "pis_third", "pis_third_konf"
].includes(baseCoalitionCode)) {
    Q.formation_marshal_nominee = Q.holownia_warsaw_mayor
        ? "Marek Sawicki" : "Szymon Hołownia";
} else if (
    baseCoalitionCode == "left_pis" ||
    ["left_pis_konf", "pis_konf", "pis_konf_third", "pis_konf_psl"].includes(
        baseCoalitionCode
    )
) {
    Q.formation_marshal_nominee = "Elżbieta Witek";
} else if ([
    "third_left_pis", "ko_psl_left", "left_psl", "left_pis_psl",
    "left_pis_konf_psl", "pis_psl", "pis_psl_konf"
].includes(baseCoalitionCode)) {
    Q.formation_marshal_nominee = "Marek Sawicki";
} else if (baseCoalitionCode == "ko_konf") {
    Q.formation_marshal_nominee = "Małgorzata Kidawa-Błońska";
} else {
    Q.formation_marshal_nominee = "Włodzimierz Czarzasty";
}
Q.formation_marshal_vote_choice = "Undecided";
Q.formation_marshal_choice_reason = "Undecided";
Q.formation_marshal_elected = 0;
Q.formation_marshal_compromise = 0;
Q.formation_marshal_ballot_passed = 0;
Q.news_headline =
    "Secret ballot opens for Marshal nominee " + Q.formation_marshal_nominee;
!}

= First office vote of the term

Before a prime minister is chosen, the chamber elects the Marshal in secret
ballot. The coalition contract is not a ceremonial document: it records who
gets the rostrum, who receives a vice-Marshal seat, and which caucus is asked
to swallow an institutional compromise. The nominee now meets the clubs one
by one before the envelopes are counted.

[? if formation_marshal_nominee = "Szymon Hołownia": Hołownia offers a
neutral chair, parliamentary scrutiny and proof that a centre party is not
merely an appendage of the largest coalition club.?]
[? if formation_marshal_nominee = "Elżbieta Witek": PiS treats Witek as an
institutional anchor for any right-led or PiS–Lewica agreement. Lewica must
decide whether the bargain is real enough to put her back on the rostrum.?]
[? if formation_marshal_nominee = "Marek Sawicki": No bloc can command the
rostrum. Sawicki offers seniority, procedure and a temporary chair acceptable
to a chamber that has not yet found a governing majority.?]
[? if formation_marshal_nominee = "Włodzimierz Czarzasty": The Left asks for
the rostrum as the price of carrying a fragile minority arrangement. Other
clubs demand guarantees that the chair will not become a party office.?]
[? if formation_marshal_nominee = "Małgorzata Kidawa-Błońska": KO proposes an
experienced institutional nominee rather than handing the rostrum to either
Konfederacja or a party outside the proposed cabinet.?]

The figures below are the pledged yes votes before the player's secret-ballot
decision. A refusal does not silently disappear: it is recorded as a breach
when the player is already bound by the coalition or toleration protocol.

= Who is asking for the chair?

[? if formation_marshal_nominee = "Szymon Hołownia":
<div style="display:flex;gap:8px;align-items:center;"><img src="img/poland/cards/coalition-council.webp" alt="Coalition negotiators around a parliamentary table" style="width:42%;"><div><b>Hołownia — the bridge nominee.</b><br>His candidacy lets Poland 2050 claim that the coalition is a partnership,
not an annexation. He promises an open rostrum, strict time limits and a
Marshal who will not turn every procedural ruling into a government whip.</div></div>?]
[? if formation_marshal_nominee = "Elżbieta Witek":
<div style="display:flex;gap:8px;align-items:center;"><img src="img/poland/cards/palace-mediation.webp" alt="Institutional mediation" style="width:42%;"><div><b>Witek — the PiS institutional anchor.</b><br>Witek knows the rules, commands a disciplined club and turns the first
sitting into a test of whether the agreement with PiS is a governing bargain
or merely arithmetic.</div></div>?]
[? if formation_marshal_nominee = "Marek Sawicki":
<div style="display:flex;gap:8px;align-items:center;"><img src="img/poland/cards/rural-hinge.webp" alt="Rural and parliamentary negotiations" style="width:42%;"><div><b>Sawicki — the neutral hinge.</b><br>No bloc can honestly claim the chair. Sawicki offers seniority, rural
credibility and a procedural truce while the chamber is still deciding who
will govern.</div></div>?]
[? if formation_marshal_nominee = "Włodzimierz Czarzasty":
<div style="display:flex;gap:8px;align-items:center;"><img src="img/poland/cards/advisor-czarzasty.webp" alt="Włodzimierz Czarzasty" style="width:42%;"><div><b>Czarzasty — the Left's institutional price.</b><br>Lewica asks for the chair because a minority or cross-party cabinet
cannot survive on programme promises alone. Supporting him wins the Left a
visible guarantee; rejecting him says its votes are welcome but its authority
is not.</div></div>?]
[? if formation_marshal_nominee = "Małgorzata Kidawa-Błońska":
<div style="display:flex;gap:8px;align-items:center;"><img src="img/poland/cards/coalition-council.webp" alt="Coalition negotiators around a parliamentary table" style="width:42%;"><div><b>Kidawa-Błońska — KO's institutional firewall.</b><br>KO wants a Marshal who can chair a poisonous cross-bloc chamber without
ceding the rostrum to Konfederacja. The nomination is less a reward than an
attempt to keep the first compromise from defining the whole cabinet.</div></div>?]

The corridor outside the chamber becomes a second ballot. Party whips count
the contracted clubs, the outside supporters and the player's own deputies.
The choice cannot be hidden in the final numbers: protect the agreed nominee,
make a protest vote, or leave the envelopes blank.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Pre-ballot commitments</div>
<div class="ledger-row"><span>Contracted yes votes</span><b>[+ formation_coalition_seats +]</b></div>
<div class="ledger-row"><span>Outside toleration/support</span><b>[+ formation_coalition_support_seats - formation_coalition_seats +]</b></div>
<div class="ledger-row"><span>Votes needed if all deputies attend</span><b>[+ sejm_statutory_majority +]</b></div></div>

- @formation_marshal_support
- @formation_marshal_reject
- @formation_marshal_abstain

@formation_marshal_support
title: Sign the coalition protocol and vote for [+ formation_marshal_nominee +]
subtitle: The player's secret ballot confirms the office bargain and protects the next PM negotiation.
on-arrival: formation_marshal_vote_choice = "Support"; formation_marshal_choice_reason = "Honoured the coalition protocol"; news_headline = "The player honours the coalition protocol and backs the Marshal nominee"
go-to: formation_marshal_result

@formation_marshal_reject
title: Break the protocol and vote against [+ formation_marshal_nominee +]
subtitle: A visible institutional revolt: preserve your red line, but make the coalition pay for it.
on-arrival: formation_marshal_vote_choice = "Reject"; formation_marshal_choice_reason = "Broke the protocol over the Marshal office"; news_headline = "The player breaks the coalition protocol in the Marshal ballot"
go-to: formation_marshal_result

@formation_marshal_abstain
title: Keep the envelopes blank
subtitle: Abstentions count against an absolute majority and may deny the chamber a chair.
on-arrival: formation_marshal_vote_choice = "Abstain"; formation_marshal_choice_reason = "Kept leverage through abstention"; news_headline = "The player keeps leverage by abstaining in the Marshal ballot"
go-to: formation_marshal_result

@formation_marshal_result
title: Marshal ballot result
new-page: true
on-arrival: {!
const coalitionCode = String(Q.formation_coalition_code || "none");
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const supportSeats = Math.max(
    0,
    Math.min(
        sejmTotal,
        Math.round(Number(Q.formation_coalition_support_seats) || 0)
    )
);
const playerSeats = Math.max(
    0,
    Math.min(
        sejmTotal,
        Math.round(Number(Q.left_committed_seats) || 0)
    )
);
const playerIncluded = Boolean(Q.formation_player_in_government) ||
    Boolean(Q.formation_player_toleration);
const nonSupportWithoutPlayer = Math.max(
    0,
    sejmTotal - supportSeats - (playerIncluded ? 0 : playerSeats)
);
let yes = supportSeats;
let abstain = Math.min(14, nonSupportWithoutPlayer);
if (Q.formation_marshal_vote_choice == "Support" && !playerIncluded) {
    yes += playerSeats;
}
if (Q.formation_marshal_vote_choice == "Reject") {
    if (playerIncluded) yes -= playerSeats;
    Q.party_unity += 3;
}
if (Q.formation_marshal_vote_choice == "Abstain") {
    if (playerIncluded) yes -= playerSeats;
    abstain += playerSeats;
}
Q.formation_marshal_yes = Math.max(0, Math.min(sejmTotal, yes));
Q.formation_marshal_abstain = Math.max(
    0,
    Math.min(sejmTotal - Q.formation_marshal_yes, abstain)
);
Q.formation_marshal_no = Math.max(
    0,
    sejmTotal - Q.formation_marshal_yes - Q.formation_marshal_abstain
);
const present = Q.formation_marshal_yes + Q.formation_marshal_no +
    Q.formation_marshal_abstain;
Q.formation_marshal_threshold = Math.floor(present / 2) + 1;
Q.formation_marshal_elected =
    present >= Q.sejm_quorum_floor &&
    Q.formation_marshal_yes >= Q.formation_marshal_threshold ? 1 : 0;
if (Q.formation_marshal_elected) {
    Q.sejm_speaker = Q.formation_marshal_nominee;
}
const betrayalDemocratic =
    coalitionCode == "democratic_2023" &&
    Q.formation_marshal_nominee == "Szymon Hołownia" &&
    Q.formation_marshal_vote_choice != "Support";
const betrayalWitek =
    Boolean(Q.formation_pis_player_coalition) &&
    Q.formation_marshal_nominee == "Elżbieta Witek" &&
    Q.formation_marshal_vote_choice != "Support";
if (betrayalDemocratic || betrayalWitek || !Q.formation_marshal_elected) {
    Q.formation_coalition_locked = 1;
    Q.coalition_broken = 1;
    Q.government_coalition_dissent += 16;
    Q.early_election_risk += 10;
    if (betrayalDemocratic) {
        Q.p2050_relation -= 20;
        Q.psl_relation -= 16;
        Q.ko_relation -= 10;
        Q.news_headline = "Refusing Hołownia triggers a coalition betrayal crisis";
    } else if (betrayalWitek) {
        Q.pis_relation -= 20;
        Q.news_headline = "Refusing Witek collapses the PiS-Lewica institutional bargain";
    } else {
        Q.news_headline = "Marshal vote fails and coalition trust collapses";
    }
} else {
    Q.formation_coalition_locked = 0;
    Q.news_headline = Q.sejm_speaker + " wins the Marshal ballot";
}
!}

<div class="ledger-section ledger-section-first"><div class="ledger-title">Secret
ballot</div>
<div class="ledger-row"><span>Nominee</span><b>[+ formation_marshal_nominee +]</b></div>
<div class="ledger-row"><span>Yes</span><b>[+ formation_marshal_yes +]</b></div>
<div class="ledger-row"><span>No</span><b>[+ formation_marshal_no +]</b></div>
<div class="ledger-row"><span>Abstain</span><b>[+ formation_marshal_abstain +]</b></div>
<div class="ledger-row"><span>Required</span><b>[+ formation_marshal_threshold +]</b></div></div>

[? if formation_marshal_elected = 1: The envelopes are opened. **[+ formation_marshal_nominee +]** has the numbers to take the chair, but the result also records who made the office possible. The next negotiation begins with a Marshal who now owes the chamber an explanation.?]
[? if formation_marshal_elected = 0: The envelopes are opened and the compromise collapses. The failure is not a decorative setback: without a trusted chair, the coalition cannot credibly move to the prime ministerial vote.?]
[? if formation_marshal_choice_reason = "Broke the protocol over the Marshal office": The winning number is therefore only part of the story. The coalition partners treat the ballot as a breach of contract, and the player enters the next constitutional stage with less trust and fewer safe exits.?]

- @formation_after_marshal

@formation_after_marshal
title: Marshal ballot outcome
go-to: formation_marshal_breakdown if formation_coalition_locked = 1; formation_vice_witek if formation_coalition_locked = 0 and formation_marshal_elected = 1 and year = 2023 and formation_coalition_code = "democratic_2023"; formation_vice_sikorski_left_pis if formation_coalition_locked = 0 and formation_marshal_elected = 1 and year = 2023 and formation_pis_player_coalition = 1; formation_pm_stage if formation_coalition_locked = 0 and formation_marshal_elected = 1 and (year != 2023 or (formation_coalition_code != "democratic_2023" and formation_pis_player_coalition = 0))

@formation_vice_sikorski_left_pis
title: Vice-Marshal ballot — Radosław Sikorski
new-page: true
face-image: img/poland/cards/coalition-council.webp

= Separate vice-marshal vote 1/2 (PiS path)

KO pushes Radosław Sikorski for vice-marshal. PiS asks Lewica to block the
nomination as proof that the Marshal deal was real.

Sikorski is not an ornamental second choice. He represents KO's demand for a
counterweight inside a chamber where PiS still controls the largest opposing
club. If Lewica blocks him, PiS can claim the coalition has accepted its
institutional veto. If Lewica lets him through, the new Marshal's office
begins with a public promise to police the government from the other side of
the aisle.

- @formation_vice_sikorski_block
- @formation_vice_sikorski_allow

@formation_vice_sikorski_block
title: Block Sikorski as PiS requests
on-arrival: formation_vice_sikorski_result = "Rejected with Left-PiS votes"; pis_relation += 6; ko_relation -= 9; p2050_relation -= 6; psl_relation -= 5; constitutional_restraint -= 1; news_headline = "Lewica and PiS block Sikorski's vice-marshal bid"
go-to: formation_vice_bosak_left_pis

@formation_vice_sikorski_allow
title: Let Sikorski take the vice-marshal seat
on-arrival: formation_vice_sikorski_result = "Elected over PiS objection"; pis_relation -= 10; ko_relation += 4; p2050_relation += 2; party_unity -= 3; news_headline = "Sikorski wins, and PiS questions the Marshal pact"
go-to: formation_vice_bosak_left_pis

@formation_vice_bosak_left_pis
title: Vice-Marshal ballot — Krzysztof Bosak
new-page: true
face-image: img/poland/cards/hostile-interview.webp

= Separate vice-marshal vote 2/2 (PiS path)

Bosak now seeks the vice-marshal seat. PiS whips support for him even when
Lewica asks for abstention.

The Bosak nomination is the bargain's ugly photograph. PiS calls it a matter
of proportional representation; Lewica sees a far-right platform receiving
the chamber's seal; Konfederacja sees proof that it can collect offices
without accepting ministerial responsibility. The player must decide whether
to enforce a democratic cordon or accept the seat as the price of keeping PiS
inside the constitutional deal.

- @formation_vice_bosak_left_pis_abstain_request
- @formation_vice_bosak_left_pis_accept

@formation_vice_bosak_left_pis_abstain_request
title: Ask PiS to abstain on Bosak
on-arrival: formation_vice_bosak_result = "Elected with PiS support despite Left abstention request"; pis_relation -= 4; minority_safety -= 3; far_right_agenda += 2; progressives_dissent += 4; news_headline = "PiS ignores abstention appeals and elects Bosak"
go-to: formation_pm_stage

@formation_vice_bosak_left_pis_accept
title: Accept PiS support for Bosak
on-arrival: formation_vice_bosak_result = "Elected with PiS support"; pis_relation += 1; minority_safety -= 4; far_right_agenda += 3; progressives_dissent += 5; news_headline = "Bosak enters the presidium with PiS backing"
go-to: formation_pm_stage

@formation_marshal_breakdown
title: Coalition trust collapses before investiture
new-page: true
on-arrival: confidence_mode = "Post-marshal breakdown — coalition arithmetic reset"; confidence_stage = 2

= Marshal failure has constitutional cost

The parties you picked treat this ballot as a trust vote. After a failed or
betrayed Marshal agreement, this coalition cannot carry a prime-ministerial
designation. A failed presidential first attempt returns initiative to the
Sejm; a failed Sejm-stage bargain moves toward the President's final attempt.

- @presidential_first_fails: Let the Sejm open its own nomination
- @third_marshal_gate: Reset the chamber and move to final-attempt arithmetic

@formation_vice_witek
title: Vice-Marshal ballot — Elżbieta Witek
new-page: true
face-image: img/poland/cards/palace-mediation.webp

= Separate vice-marshal vote 1/2

The democratic coalition must separately vote on Elżbieta Witek as one of the
vice-marshals. Historical sequence: KO and Third Way oppose her nomination.

The nomination is a test of the new majority's memory. Witek's supporters
call it normal representation for the largest opposition club. The coalition
calls it a question of whether the previous parliamentary practice can be
continued without an accounting. A yes vote lowers the temperature in the
room; a no vote tells the incoming government that institutional repair starts
with drawing a line.

- @formation_vice_witek_support
- @formation_vice_witek_reject

