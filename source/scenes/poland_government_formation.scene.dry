@left_whole_cabinet
title: Put cabinet entry to a Razem membership vote
subtitle: Cost: 1 party resource. High cooperation, a social-liberal KO or pivotal seats make entry easier; otherwise Razem supplies confidence from outside.
choose-if: resources >= 1 and left_splinter_support_votes = left_splinter_seats
unavailable-subtitle: [? if resources < 1: A joint programme convention and ministerial vetting cost one resource. ?][? if left_splinter_support_votes < left_splinter_seats: One or more breakaway Left parties refuse collective cabinet responsibility. Rebuild relations first. ?]
on-arrival: {!
Q.resources -= 1;
const razemSeats = Math.max(0, Number(Q.razem_seats) || 0);
const socialLiberalKO =
    (Number(Q.ko_social_liberal_share) || 0) >=
    (Number(Q.ko_classical_liberal_share) || 0);
Q.razem_pivotal_to_coalition =
    razemSeats > 0 &&
    (Number(Q.coalition_democratic_seats) || 0) - razemSeats <
        (Number(Q.sejm_statutory_majority) || 231) ? 1 : 0;
Q.razem_join_vote_score = Math.round(
    (Number(Q.razem_cooperation) || 0) * 0.70 +
    (Number(Q.ko_social_liberal_share) || 0) * 0.30 -
    Math.max(0, (Number(Q.razem_dissent) || 0) - 40) * 0.20 +
    (Q.razem_pivotal_to_coalition ? 20 : 0)
);
Q.razem_in_government =
    razemSeats > 0 && (
        Q.razem_pivotal_to_coalition ||
        (Number(Q.razem_cooperation) || 0) >= 65 ||
        socialLiberalKO
    ) ? 1 : 0;
Q.razem_budget_support_pact = 1;
Q.razem_join_vote_result = Q.razem_in_government
    ? "Razem ratifies cabinet entry"
    : "Razem chooses confidence and supply";
Q.razem_government_role = Q.razem_in_government
    ? "Coalition party with a red-line protocol"
    : "Confidence and supply";
Q.candidate_left_votes = Q.left_committed_seats;
Q.left_cabinet_committed = 1;
Q.left_cabinet_model = Q.razem_in_government
    ? "Whole cooperating Left coalition delegation"
    : "New Left ministers · Razem confidence and supply";
Q.democratic_pact = Q.razem_in_government
    ? "Ratified Whole-Left cabinet entry"
    : "New Left cabinet with Razem confidence and supply";
Q.party_unity += Q.razem_in_government ? 5 : 3;
Q.razem_dissent += Q.razem_in_government ? -6 : -3;
Q.barons_dissent += Q.razem_in_government ? 3 : 1;
Q.news_headline = Q.razem_join_vote_result;
!}
go-to: democratic_psl_mandate

