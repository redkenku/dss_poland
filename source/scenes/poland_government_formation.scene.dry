Q.party_unity -= 18;
Q.barons_dissent -= 12;
Q.labor_dissent -= 7;
Q.progressives_dissent += 16;
Q.spring_dissent += 14;
Q.razem_dissent += 22;
Q.pis_relation += 15;
Q.ko_relation -= 13;
Q.p2050_relation -= 9;
Q.public_trust -= 7;
Q.news_headline = "A group of Left deputies accepts a PiS social pact";
!}
