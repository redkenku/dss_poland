@cabinet_social_deadlines
title: Announce abortion, housing and labour deadlines
subtitle: [? if candidate_psl_votes > 0 and candidate_p2050_votes > 0: Up to twelve PSL deputies and two Poland 2050 centrists withhold confidence.?][? if candidate_psl_votes > 0 and candidate_p2050_votes = 0: Up to twelve PSL deputies withhold confidence.?][? if candidate_psl_votes = 0 and candidate_p2050_votes > 0: Up to two Poland 2050 centrists withhold confidence.?][? if candidate_psl_votes = 0 and candidate_p2050_votes = 0 and ministry_ko_in_cabinet = 1: KO keeps its confidence whip, but the deadlines raise coalition tension.?][? if candidate_psl_votes = 0 and candidate_p2050_votes = 0 and ministry_ko_in_cabinet = 0: No supporting party withholds; the Left closes ranks around the deadlines.?]
view-if: formation_pis_player_coalition = 0
on-arrival: {!
Q.cabinet_program = "Front-loaded social and equality deadlines";
Q.cabinet_ko_loss = 0;
Q.cabinet_p2050_loss = Math.min(2, Math.max(0, Q.candidate_p2050_votes));
Q.cabinet_psl_loss = Math.min(12, Math.max(0, Q.candidate_psl_votes));
Q.cabinet_left_loss = 0;
if (Q.cabinet_psl_loss > 0) {
    if (Q.ministry_psl_in_cabinet) {
        Q.psl_coalition_dissent += Q.cabinet_psl_loss;
    } else {
        Q.psl_relation -= Math.min(6, Q.cabinet_psl_loss);
    }
}
if (Q.cabinet_p2050_loss > 0) {
    if (Q.ministry_p2050_in_cabinet) {
        Q.p2050_coalition_dissent += Q.cabinet_p2050_loss;
    } else {
        Q.p2050_relation -= Math.min(3, Q.cabinet_p2050_loss);
    }
}
if (Q.ministry_ko_in_cabinet) Q.ko_coalition_dissent += 4;
Q.party_unity += 5;
Q.feminist_trust += 5;
Q.labor_credibility += 4;
Q.news_headline = "The exposé turns coalition aspirations into dates";
!}
go-to: cabinet_confidence_roll

@cabinet_minimum_text
title: Reduce the programme to institutional repair
subtitle: [? if razem_seats > 0 and candidate_left_votes > 0: Razem withholds its available votes.?][? if ministry_psl_in_cabinet = 1 or ministry_p2050_in_cabinet = 1 or ministry_ko_in_cabinet = 1: The cabinet's institutional wing relaxes.?][? if razem_seats = 0 and ministry_psl_in_cabinet = 0 and ministry_p2050_in_cabinet = 0 and ministry_ko_in_cabinet = 0: The social floor gives way to a narrow constitutional programme.?]
