    economy: ["PSL", "Krzysztof Hetman"],
    agriculture: ["PSL", "Czesław Siekierski"],
    defence: ["PSL", "Władysław Kosiniak-Kamysz"]
};
for (const portfolio of Object.keys(restoredPSLPortfolios)) {
