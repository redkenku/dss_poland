title: Legacy dated-event desk
call: poland_normalize
on-arrival: {!
Q.poland_legacy_event_phase = 1;
const queueScene =
    this.game.scenes["poland_legacy_event_desk.events_choice"];
const compiled = this._compileChoices(queueScene) || [];
const rootId = this.state.rootSceneId;
const pendingEvents = compiled.filter(function(choice) {
    return choice.id !== rootId;
});
Q.poland_legacy_event_queue_count = pendingEvents.length;
Q.poland_legacy_event_queue_titles = pendingEvents.map(function(choice) {
    return choice.title;
}).join(" · ");
!}
go-to: events_choice if poland_legacy_event_queue_count > 0; complete if poland_legacy_event_queue_count = 0

@events_choice
title: Legacy events on the desk
new-page: true

= [+ date_label +] — legacy events on the desk

[? if poland_legacy_event_queue_count = 1: One dated decision must be resolved before the table reopens.?]
[? if poland_legacy_event_queue_count > 1: **[+ poland_legacy_event_queue_count +] dated decisions** remain in this month. Resolve every one before returning to the table.?]

