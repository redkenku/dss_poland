title: Legacy dated-event desk
call: poland_normalize
on-arrival: {!
const previousScene = this.state.prevSceneId || "";
const returningFromEvent =
    Q.poland_legacy_event_phase == 1 &&
    previousScene != "root" &&
    previousScene != "poland_legacy_event_desk" &&
    previousScene.indexOf("poland_legacy_event_desk.") != 0;
Q.poland_legacy_event_phase = 1;
const queueScene =
    this.game.scenes["poland_legacy_event_desk.events_choice"];
const compiled = this._compileChoices(queueScene) || [];
const rootId = this.state.rootSceneId;
const pendingEvents = compiled.filter(function(choice) {
    return choice.id !== rootId;
});
Q.poland_legacy_event_queue_count = pendingEvents.length;
Q.poland_legacy_event_queue_titles = pendingEvents.map(function(choice) {
    return choice.title;
}).join(" · ");
Q.poland_legacy_event_return_beat = returningFromEvent ? 1 : 0;
!}
go-to: complete if poland_legacy_event_return_beat = 1 and poland_legacy_event_queue_count = 0; afterword if poland_legacy_event_return_beat = 1 and poland_legacy_event_queue_count > 0; events_choice if poland_legacy_event_return_beat = 0 and poland_legacy_event_queue_count > 0; complete if poland_legacy_event_return_beat = 0 and poland_legacy_event_queue_count = 0

@afterword
title: File the consequence

**[+ news_headline +]**

[? if poland_legacy_event_queue_count = 0: The legacy desk clears for this month.?]
[? if poland_legacy_event_queue_count = 1: One legacy-dated file still needs resolution.?]
[? if poland_legacy_event_queue_count > 1: **[+ poland_legacy_event_queue_count +] legacy-dated files** are still waiting on the desk.?]

- @afterword_desk
- @afterword_complete

@afterword_desk
title: Return to the legacy desk
view-if: poland_legacy_event_queue_count > 0
go-to: events_choice

@afterword_complete
title: Return to monthly routing
view-if: poland_legacy_event_queue_count = 0
go-to: complete

@events_choice
title: Legacy events on the desk
new-page: true

= [+ date_label +] — legacy events on the desk

[? if poland_legacy_event_queue_count = 1: One dated decision must be resolved before the table reopens.?]
[? if poland_legacy_event_queue_count > 1: **[+ poland_legacy_event_queue_count +] dated decisions** remain in this month. Resolve every one before returning to the table.?]

