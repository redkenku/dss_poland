title: Ukraine and the Eastern Flank
subtitle: A common allied request, routed through party, coalition, ministry, cabinet, caretaker or presidential authority.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 105
view-if: month_actions < max_month_actions and ukraine_invasion_event_done = 1 and poland_eastern_flank_timer <= 0
call: poland_normalize
on-arrival: month_actions += 1; poland_eastern_flank_timer = 5; foreign_cards_resolved += 1; foreign_pressure += 2; foreign_authority_last_issue = "Ukraine and the eastern flank"
card-image: img/poland/cards/crisis-compact.webp

= Ukraine and the eastern flank ask for a position

Ukraine and Poland's eastern allies want durable political support, reliable
logistics and a credible European future. Polish shelters, rail, hospitals,
energy reserves and refugee services remain part of resilience. Procurement,
operational command and Palace diplomacy stay in their separate channels; this
file sets only the foreign-policy line available to Lewica's present office.

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].
Ukraine solidarity **[+ ukraine_solidarity +]** · eastern coalition **[+
eu_eastern_coalition +]** · escalation risk **[+ war_escalation_risk +]**.

- @solidarity
- @resilience
- @restraint

@solidarity
title: [? if foreign_authority_role = "ordinary_opposition": Publish a shadow Ukraine doctrine and move a Sejm resolution for sustained support?][? if foreign_authority_role = "confidence_opposition": Condition budget and confidence support on a bounded Ukraine-and-enlargement commitment?][? if foreign_authority_role = "junior_no_mfa": Demand an eastern-flank line in coalition council and trade support for it?][? if foreign_authority_role = "junior_mfa": Convene eastern partners within the Prime Minister's agreed Ukraine mandate?][? if foreign_authority_role = "lead_no_mfa": Set cabinet strategy and direct the Foreign Minister to convene an eastern coalition?][? if foreign_authority_role = "lead_mfa": Initiate, negotiate and implement an eastern diplomatic compact?][? if foreign_authority_role = "caretaker": Reaffirm existing Ukraine commitments and consult every parliamentary club?][? if foreign_authority_role = "left_president": Represent Poland's existing commitments and scrutinise future ratification without directing operations?]
subtitle: [? if foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa": Cost: 1 party resource; no national military pledge is created.?][? if foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa": Cost: 1 budget capacity; coalition or portfolio friction remains.?][? if foreign_authority_role = "lead_mfa": Cost: 2 budget capacity; full diplomatic initiative and responsibility.?][? if foreign_authority_role = "caretaker": Continuity only, with irreversible commitments deferred.?][? if foreign_authority_role = "left_president": Representation and ratification scrutiny, never operational command.?]
choose-if: ((foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa") and resources >= 1) or ((foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa") and budget >= 1) or (foreign_authority_role = "lead_mfa" and budget >= 2) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.resources -= 1; Q.ukraine_solidarity += 3;
    Q.eu_eastern_coalition += 2; Q.media_capacity += 2;
    Q.foreign_authority_last_outcome = "Opposition publishes a Ukraine doctrine and seeks a Sejm resolution, not an executive pledge";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.ukraine_solidarity += 4;
    Q.eu_eastern_coalition += 3; Q.government_coalition_dissent += 2;
    Q.fiscal_stress += 1;
    Q.foreign_authority_last_outcome = "A bounded Ukraine and enlargement line becomes a condition of support";
} else if (role == "junior_no_mfa") {
    Q.resources -= 1; Q.ukraine_solidarity += 4;
    Q.eu_eastern_coalition += 3; Q.government_delivery += 1;
    Q.government_coalition_dissent += 3;
    Q.foreign_authority_last_outcome = "Coalition council adopts an eastern line carried by another party's minister";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.ukraine_solidarity += 5;
    Q.eu_eastern_coalition += 5; Q.eu_influence += 3;
    Q.government_delivery += 3; Q.foreign_ministry_override_risk += 3;
    Q.foreign_authority_last_outcome = "The Foreign Ministry convenes eastern partners inside the Prime Minister's mandate";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.ukraine_solidarity += 5;
    Q.eu_eastern_coalition += 5; Q.eu_influence += 3;
    Q.government_delivery += 3; Q.foreign_portfolio_resistance += 4;
    Q.foreign_authority_last_outcome = "Cabinet sets the eastern strategy and directs the coalition Foreign Minister";
} else if (role == "lead_mfa") {
    Q.budget -= 2; Q.ukraine_solidarity += 7;
    Q.eu_eastern_coalition += 7; Q.eu_influence += 5;
    Q.government_delivery += 5; Q.foreign_pressure -= 4;
    Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome = "The government initiates, negotiates and implements the eastern diplomatic compact";
} else if (role == "caretaker") {
    Q.ukraine_solidarity += 2; Q.eu_eastern_coalition += 1;
    Q.foreign_pressure -= 1;
    Q.foreign_authority_last_outcome = "The caretaker reaffirms inherited commitments and defers any new undertaking";
} else {
    Q.ukraine_solidarity += 3; Q.eu_eastern_coalition += 2;
    Q.constitutional_restraint += 2; Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The President represents existing commitments and reserves new undertakings to cabinet and Sejm";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@resilience
title: [? if foreign_authority_role = "ordinary_opposition": Question ministers and publish a shadow civil-resilience standard?][? if foreign_authority_role = "confidence_opposition": Make a limited resilience appropriation a budget condition?][? if foreign_authority_role = "junior_no_mfa": Demand a coalition resilience annex and trade support for it?][? if foreign_authority_role = "junior_mfa": Add civilian resilience to diplomatic coordination while cabinet controls delivery?][? if foreign_authority_role = "lead_no_mfa": Set a cross-cabinet resilience strategy and direct its foreign coordination?][? if foreign_authority_role = "lead_mfa": Implement the diplomatic and cross-border part of a funded resilience strategy?][? if foreign_authority_role = "caretaker": Audit continuity plans and hand the incoming cabinet a public gap list?][? if foreign_authority_role = "left_president": Convene services and local government and press cabinet for a constitutional continuity plan?]
subtitle: Domestic services and Defence keep their own chains of command; foreign authority changes coordination, conditions and accountability.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.public_trust += 2; Q.local_network += 2; Q.media_capacity += 1;
    Q.foreign_authority_last_outcome = "Opposition questions ministers and publishes a shadow resilience standard";
} else if (role == "confidence_opposition") {
    Q.household_policy_pressure += 2; Q.local_network += 2; Q.fiscal_stress += 1;
    Q.government_coalition_dissent += 2;
    Q.last_policy_stage = "Negotiated concession";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "A limited resilience appropriation becomes a condition of budget support";
} else if (role == "junior_no_mfa") {
    Q.household_security += 2; Q.local_network += 2;
    Q.government_delivery += 1; Q.government_coalition_dissent += 3;
    Q.foreign_authority_last_outcome = "Coalition council adds a resilience annex while operational ministries retain command";
} else if (role == "junior_mfa") {
    Q.public_trust += 3; Q.local_network += 3; Q.household_security += 2;
    Q.eu_eastern_coalition += 3; Q.government_delivery += 2;
    Q.foreign_ministry_override_risk += 1;
    Q.foreign_authority_last_outcome = "Foreign Affairs coordinates the cross-border layer while service ministries deliver";
} else if (role == "lead_no_mfa") {
    Q.public_trust += 3; Q.local_network += 3; Q.household_security += 3;
    Q.eu_eastern_coalition += 3; Q.government_delivery += 3;
    Q.foreign_portfolio_resistance += 2;
    Q.foreign_authority_last_outcome = "Cabinet sets a cross-government resilience strategy without absorbing operational commands";
} else if (role == "lead_mfa") {
    Q.public_trust += 4; Q.local_network += 4; Q.household_security += 3;
    Q.health_capacity += 2; Q.refugee_service_capacity += 2;
    Q.eu_eastern_coalition += 4; Q.government_delivery += 4;
    Q.foreign_policy_responsibility += 4;
    Q.foreign_authority_last_outcome = "Government funds coordination and owns delivery while Defence and services keep their commands";
} else if (role == "caretaker") {
    Q.public_trust += 2; Q.local_network += 1; Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker audits continuity plans and defers new structures";
} else {
    Q.public_trust += 3; Q.local_network += 2; Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The President convenes a continuity table and leaves implementation to cabinet and local services";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@restraint
title: [? if foreign_authority_role = "ordinary_opposition": Publish a shadow doctrine against open-ended commitments and demand hearings?][? if foreign_authority_role = "confidence_opposition": Withhold support from any unbounded commitment?][? if foreign_authority_role = "junior_no_mfa": Dissent publicly and demand coalition red lines?][? if foreign_authority_role = "junior_mfa": Enter diplomatic red lines and risk being overruled?][? if foreign_authority_role = "lead_no_mfa": Set cabinet limits and direct the minister to communicate them?][? if foreign_authority_role = "lead_mfa": Narrow Poland's diplomatic commitment and own the allied consequences?][? if foreign_authority_role = "caretaker": Reaffirm existing limits and defer any expansion or withdrawal?][? if foreign_authority_role = "left_president": Counsel restraint and scrutinise ratification without ordering a withdrawal?]
subtitle: A warning about escalation is credible; only executive routes alter Poland's line, and none of these choices commands Defence.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.war_escalation_risk -= 2; Q.progressive_credibility += 2;
    Q.ukraine_solidarity -= 1; Q.left_atlanticist_dissent += 2;
    Q.foreign_authority_last_outcome = "A shadow restraint doctrine starts hearings but changes no national commitment";
} else if (role == "confidence_opposition") {
    Q.war_escalation_risk -= 3; Q.ukraine_solidarity -= 2;
    Q.government_coalition_dissent += 4; Q.left_atlanticist_dissent += 3;
    Q.foreign_authority_last_outcome = "Lewica withholds support from an unbounded commitment";
} else if (role == "junior_no_mfa") {
    Q.war_escalation_risk -= 3; Q.ukraine_solidarity -= 2;
    Q.government_coalition_dissent += 5; Q.left_atlanticist_dissent += 3;
    Q.foreign_authority_last_outcome = "Public dissent forces coalition red lines without commanding the ministry";
} else if (role == "junior_mfa") {
    Q.war_escalation_risk -= 4; Q.ukraine_solidarity -= 3;
    Q.eu_eastern_coalition -= 3; Q.foreign_ministry_override_risk += 6;
    Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "The Foreign Minister enters red lines the Prime Minister may overrule";
} else if (role == "lead_no_mfa") {
    Q.war_escalation_risk -= 4; Q.ukraine_solidarity -= 3;
    Q.eu_eastern_coalition -= 3; Q.foreign_portfolio_resistance += 5;
    Q.foreign_authority_last_outcome = "Cabinet narrows the line and directs a resistant portfolio owner";
} else if (role == "lead_mfa") {
    Q.war_escalation_risk -= 5; Q.ukraine_solidarity -= 4;
    Q.eu_eastern_coalition -= 5; Q.foreign_pressure += 3;
    Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome = "The government narrows Poland's line and owns the allied loss of confidence";
} else if (role == "caretaker") {
    Q.war_escalation_risk -= 1; Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker freezes the inherited line and defers expansion or withdrawal";
} else {
    Q.war_escalation_risk -= 2; Q.constitutional_restraint += 2;
    Q.left_atlanticist_dissent += 1;
    Q.foreign_authority_last_outcome = "The President counsels restraint and reserves binding change to cabinet and Sejm";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish
