title: Ukraine After the Invasion
subtitle: Opposition can build consent and scrutiny; government can commit money, logistics and diplomacy.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 115
view-if: month_actions < max_month_actions and ukraine_invasion_event_done = 1 and poland_eastern_flank_timer <= 0
call: poland_normalize
on-arrival: month_actions += 1; poland_eastern_flank_timer = 5; foreign_cards_resolved += 1; foreign_authority_last_issue = "Ukraine after the invasion"
card-image: img/poland/cards/presidential-channel.webp

= Ukraine after the invasion

**Our position:** [+ foreign_authority_label +].
Ukraine partnership **[+ ukraine_solidarity +]/100** · war fatigue **[+
war_fatigue +]/100** · escalation risk **[+ war_escalation_risk +]/100**.

War makes foreign policy material: weapons and rail capacity, refugees and
schools, sanctions and energy bills. Opposition votes, visits and aid networks
can change Polish consent. Only a government can order deliveries or fund a
national programme.

- @support
- @accession
- @reconstruction
- @neutrality
- @presidential

@support
title: [? if not left_in_government: Commit Lewica's votes to Ukrainian self-defence with published oversight?][? if left_in_government: Fund sustained military and logistical support with parliamentary oversight?]
subtitle: [? if not left_in_government: Cost: 1 party resource; this creates consent and scrutiny, not an executive order.?][? if left_in_government: Cost: 1 budget capacity; cabinet owns delivery and the fiscal trade-off.?]
choose-if: (left_in_government = 0 and resources >= 1) or (left_in_government = 1 and budget >= 1 and caretaker_government = 0)
unavailable-subtitle: The chosen role lacks the stated party or budget capacity.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
if (executive) {
    Q.budget -= 1;
    Q.ukraine_solidarity += 7;
    Q.military_trust += 4;
    Q.government_delivery += 4;
    Q.fiscal_stress += 2;
    Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome =
        "Government funds sustained Ukraine support and owns its delivery";
} else {
    Q.resources -= 1;
    Q.ukraine_solidarity += 5;
    Q.military_trust += 2;
    Q.constitutional_restraint += 2;
    Q.last_policy_stage = "Parliamentary security commitment";
    Q.last_policy_authority = "Lewica opposition caucus";
    Q.last_policy_implementation = 0;
    Q.foreign_authority_last_outcome =
        "Opposition commits votes and oversight without issuing orders to the state";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@accession
title: [? if not left_in_government: Build an opposition coalition for Ukraine's EU path?][? if left_in_government: Put Ukraine's accession and reconstruction into Poland's EU mandate?]
subtitle: A political route for opposition; a negotiating mandate for government.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
if (!Q.eu_eastern_mission) {
    Q.eu_eastern_mission = 1;
    Q.eu_campaign_progress += 1;
}
Q.ukraine_solidarity += executive ? 6 : 4;
Q.eu_influence += executive ? 5 : 3;
Q.eu_institutional_trust += 2;
if (executive) {
    Q.government_coalition_dissent += 2;
    Q.foreign_policy_responsibility += 3;
    Q.foreign_authority_last_outcome =
        "Cabinet makes Ukraine's EU path part of the Polish negotiating mandate";
} else {
    Q.media_capacity += 1;
    Q.last_policy_stage = "Opposition accession doctrine";
    Q.last_policy_authority = "Lewica, MEPs and Ukrainian partners";
    Q.last_policy_implementation = 0;
    Q.foreign_authority_last_outcome =
        "Opposition builds parliamentary and party support for Ukraine's EU path";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@reconstruction
title: [? if not left_in_government: Prepare a social reconstruction plan with unions, cities and Ukrainian partners?][? if left_in_government: Commit Poland to a labour-standard and public-services reconstruction plan?]
subtitle: Opposition writes the offer; government can fund and negotiate it.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
Q.ukraine_solidarity += executive ? 5 : 3;
Q.labor_credibility += 3;
Q.eu_left_network += 3;
if (executive && Q.budget >= 1) {
    Q.budget -= 1;
    Q.government_delivery += 3;
    Q.foreign_policy_responsibility += 3;
    Q.foreign_authority_last_outcome =
        "Government funds a social reconstruction mandate for Ukraine";
} else if (executive) {
    Q.last_policy_stage = "Unfunded cabinet reconstruction framework";
    Q.last_policy_authority = "Council of Ministers";
    Q.last_policy_implementation = 0;
    Q.foreign_policy_responsibility += 2;
    Q.foreign_authority_last_outcome =
        "Cabinet adopts a reconstruction framework but cannot fund it";
} else {
    Q.last_policy_stage = "Reconstruction proposal";
    Q.last_policy_authority = "Opposition and local-government network";
    Q.last_policy_implementation = 0;
    Q.foreign_authority_last_outcome =
        "Opposition prepares a social reconstruction offer for a future government";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@neutrality
title: Demand an end to arms support and Polish neutrality
subtitle: Lowers immediate escalation pressure; isolates Lewica from Ukraine and most democratic parties.
on-arrival: ukraine_solidarity -= 8; war_escalation_risk -= 3; military_trust -= 6; public_trust -= 3; konf_poll_momentum += 0.3; far_right_agenda += 3; government_coalition_dissent += 5 if left_in_government = 1; foreign_policy_responsibility += 4 if left_in_government = 1; foreign_authority_last_outcome = "Lewica chooses neutrality and breaks with the Ukraine consensus"; news_headline = foreign_authority_last_outcome

- #poland_card_finish

@presidential
title: Convene cabinet, Parliament and Ukrainian representatives at the Palace
subtitle: Representation and consultation only; the President cannot order deliveries.
view-if: foreign_left_presidential_channel = 1
on-arrival: ukraine_solidarity += 3; constitutional_restraint += 3; president_relation += 2; foreign_authority_last_outcome = "The President convenes a Ukraine council without directing cabinet operations"; news_headline = foreign_authority_last_outcome

- #poland_card_finish
