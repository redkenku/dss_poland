title: The Eastern Flank Asks for a Commitment
subtitle: Deterrence, Ukraine and civil resilience compete for the same political capital.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 105
view-if: month_actions < max_month_actions and ukraine_invasion_event_done = 1 and poland_eastern_flank_timer <= 0
on-arrival: month_actions += 1; poland_eastern_flank_timer = 5; foreign_cards_resolved += 1; foreign_pressure += 2
