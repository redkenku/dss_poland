title: Washington Wants One Polish Answer
subtitle: The same American request reaches different Polish offices; no party can borrow authority it does not hold.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 95
view-if: month_actions < max_month_actions and us_election_2020_done = 1 and poland_white_house_pressure_timer <= 0
call: poland_normalize
on-arrival: month_actions += 1; poland_white_house_pressure_timer = 6; foreign_cards_resolved += 1; foreign_pressure += 2; foreign_authority_last_issue = "Washington alliance pressure"
card-image: img/poland/cards/presidential-channel.webp

= Washington wants one Polish answer

The **[+ us_president +]** administration wants visible Polish alignment.
[? if us_administration = "Democratic": It joins NATO and Ukraine coordination
to democratic institutions and a common European line.?][? if
us_administration != "Democratic": It emphasises spending, bilateral loyalty
and access while treating EU coordination as a competitor.?] The White House,
State Department, Congress, Defence and the Polish Palace remain separate
channels; success in one is not national command over the others.

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].
Alliance reliability **[+ us_alliance_reliability +]** · ambassador **[+
us_ambassador_channel +]** · Congress **[+ us_congress_channel +]**.

- @institutions
- @bilateral
- @european

@institutions
title: [? if foreign_authority_role = "ordinary_opposition": Ask committee questions, send a party delegation and publish a shadow institutional doctrine?][? if foreign_authority_role = "confidence_opposition": Condition support on cabinet reporting while committee chairs maintain Congress contacts?][? if foreign_authority_role = "junior_no_mfa": Demand coalition reporting and pressure the minister to diversify State Department contacts?][? if foreign_authority_role = "junior_mfa": Direct State Department diplomacy inside mandate while committees and Defence keep their own channels?][? if foreign_authority_role = "lead_no_mfa": Set cabinet diversification strategy and direct the Foreign Minister to execute it?][? if foreign_authority_role = "lead_mfa": Run a full diplomatic diversification strategy and accept responsibility for results?][? if foreign_authority_role = "caretaker": Maintain every inherited working contact and consult the incoming majority?][? if foreign_authority_role = "left_president": Represent Poland in Washington and protect constitutional coordination without directing ministries or committees?]
subtitle: The route uses Foreign Affairs, party or constitutional authority only; Defence, Palace and parliamentary channels retain separate ownership.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.us_congress_channel += 4; Q.media_capacity += 2;
    Q.us_alliance_reliability += 1; Q.constitutional_restraint += 1;
    Q.foreign_authority_last_outcome = "Questions, a committee motion and party diplomacy widen opposition contacts";
} else if (role == "confidence_opposition") {
    Q.us_congress_channel += 5; Q.us_alliance_reliability += 2;
    Q.constitutional_restraint += 2; Q.government_coalition_dissent += 2;
    Q.foreign_authority_last_outcome = "Cabinet reporting becomes a support condition while Parliament maintains its own channel";
} else if (role == "junior_no_mfa") {
    Q.us_ambassador_channel += 2; Q.us_alliance_reliability += 2;
    Q.government_coalition_dissent += 3; Q.government_delivery += 1;
    Q.foreign_authority_last_outcome = "Coalition council orders reporting and pressures the portfolio owner to diversify diplomacy";
} else if (role == "junior_mfa") {
    Q.us_ambassador_channel += 4; Q.us_alliance_reliability += 4;
    Q.eu_influence += 2; Q.government_delivery += 3;
    Q.foreign_pressure -= 3; Q.foreign_ministry_override_risk += 3;
    Q.foreign_authority_last_outcome = "Foreign Affairs diversifies State Department contacts inside the coalition mandate";
} else if (role == "lead_no_mfa") {
    Q.us_ambassador_channel += 4; Q.us_alliance_reliability += 4;
    Q.eu_influence += 2; Q.government_delivery += 3;
    Q.foreign_pressure -= 3; Q.foreign_portfolio_resistance += 4;
    Q.foreign_authority_last_outcome = "Cabinet sets the diversification strategy and directs the coalition Foreign Minister";
} else if (role == "lead_mfa") {
    Q.us_ambassador_channel += 6; Q.us_alliance_reliability += 5;
    Q.eu_influence += 3; Q.government_delivery += 5;
    Q.foreign_pressure -= 5; Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome = "The government runs and owns a full diplomatic diversification strategy";
} else if (role == "caretaker") {
    Q.us_ambassador_channel += 2; Q.us_alliance_reliability += 1;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker preserves inherited contacts and makes no new alignment";
} else {
    Q.us_ambassador_channel += 3; Q.us_alliance_reliability += 2;
    Q.constitutional_restraint += 3; Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The President represents Poland and protects coordination without directing cabinet, Defence or committees";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@bilateral
title: [? if foreign_authority_role = "ordinary_opposition": Demand disclosure of Washington's requested pledge and publish opposition red lines?][? if foreign_authority_role = "confidence_opposition": Negotiate support for one limited, costed commitment with parliamentary review?][? if foreign_authority_role = "junior_no_mfa": Trade coalition support for limits and pressure the minister to carry them?][? if foreign_authority_role = "junior_mfa": Negotiate a bounded bilateral commitment within the Prime Minister's mandate?][? if foreign_authority_role = "lead_no_mfa": Set the national mandate and direct the Foreign Minister to negotiate it?][? if foreign_authority_role = "lead_mfa": Give, implement and answer for a national bilateral commitment?][? if foreign_authority_role = "caretaker": Reaffirm only existing assurances and defer the requested new pledge?][? if foreign_authority_role = "left_president": Give constitutional representation and seek cabinet authority before any national pledge?]
subtitle: [? if foreign_authority_role = "ordinary_opposition": Opposition cannot give Washington a national pledge; it can expose terms and define a shadow line.?][? if foreign_authority_role = "confidence_opposition": Cost: 1 party resource. The negotiated commitment is limited and conditional.?][? if foreign_authority_role = "junior_no_mfa": Cost: 1 party resource and coalition friction; another party's minister negotiates.?][? if foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa": Cost: 1 budget capacity, with override or portfolio resistance.?][? if foreign_authority_role = "lead_mfa": Cost: 2 budget capacity and full responsibility.?][? if foreign_authority_role = "caretaker": No new or irreversible pledge.?][? if foreign_authority_role = "left_president": The President may represent and ratify; routine cabinet commitments still require government authority.?]
choose-if: foreign_authority_role = "ordinary_opposition" or (foreign_authority_role = "confidence_opposition" and resources >= 1) or (foreign_authority_role = "junior_no_mfa" and resources >= 1) or ((foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa") and budget >= 1) or (foreign_authority_role = "lead_mfa" and budget >= 2) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.media_capacity += 3; Q.constitutional_restraint += 2;
    Q.us_ambassador_channel += 1;
    Q.foreign_authority_last_outcome = "Opposition exposes the requested terms and issues red lines without giving a national pledge";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.us_alliance_reliability += 2;
    Q.us_ambassador_channel += 2; Q.foreign_pressure -= 1;
    Q.fiscal_stress += 1; Q.government_coalition_dissent += 2;
    Q.foreign_authority_last_outcome = "Conditional support permits one limited and reviewable cabinet commitment";
} else if (role == "junior_no_mfa") {
    Q.resources -= 1; Q.us_alliance_reliability += 2;
    Q.us_ambassador_channel += 2; Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "Lewica trades coalition support for limits another party's minister must negotiate";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.us_alliance_reliability += 4;
    Q.us_ambassador_channel += 5; Q.foreign_pressure -= 3;
    Q.government_delivery += 3; Q.fiscal_stress += 2;
    Q.foreign_ministry_override_risk += 4;
    Q.foreign_authority_last_outcome = "The Foreign Minister negotiates a bounded pledge inside the Prime Minister's mandate";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.us_alliance_reliability += 4;
    Q.us_ambassador_channel += 5; Q.foreign_pressure -= 3;
    Q.government_delivery += 3; Q.fiscal_stress += 2;
    Q.foreign_portfolio_resistance += 5;
    Q.foreign_authority_last_outcome = "Cabinet sets the national pledge and directs a resistant coalition Foreign Minister";
} else if (role == "lead_mfa") {
    Q.budget -= 2; Q.us_alliance_reliability += 6;
    Q.us_ambassador_channel += 7; Q.foreign_pressure -= 5;
    Q.government_delivery += 5; Q.fiscal_stress += 4;
    Q.eu_influence -= 2; Q.foreign_policy_responsibility += 7;
    Q.foreign_authority_last_outcome = "The government gives and implements the national pledge and owns every concession";
} else if (role == "caretaker") {
    Q.us_alliance_reliability += 1; Q.us_ambassador_channel += 1;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker reaffirms existing assurances and defers Washington's new request";
} else {
    Q.us_ambassador_channel += 3; Q.constitutional_restraint += 3;
    Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The President represents Poland and requests cabinet authority before any national pledge";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@european
title: [? if foreign_authority_role = "ordinary_opposition": Build party diplomacy and a shadow doctrine for a European pillar?][? if foreign_authority_role = "confidence_opposition": Condition support on one limited European-coordination commitment?][? if foreign_authority_role = "junior_no_mfa": Demand a European answer in coalition council and dissent if the minister refuses?][? if foreign_authority_role = "junior_mfa": Negotiate a European pillar within the coalition's Atlantic mandate?][? if foreign_authority_role = "lead_no_mfa": Set European coordination as cabinet strategy and direct the minister?][? if foreign_authority_role = "lead_mfa": Build and implement the European pillar as national strategy?][? if foreign_authority_role = "caretaker": Continue EU consultation without changing the inherited alliance line?][? if foreign_authority_role = "left_president": Represent Poland in European councils while leaving cabinet strategy to government?]
subtitle: Strategic autonomy can be a party doctrine, a support condition or state policy; the gains and alliance costs scale with authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.eu_influence += 3; Q.eu_left_network += 2;
    Q.left_atlanticist_dissent += 2;
    Q.foreign_authority_last_outcome = "Party diplomacy gives the opposition a European shadow doctrine";
} else if (role == "confidence_opposition") {
    Q.eu_influence += 4; Q.eu_eastern_coalition += 3;
    Q.left_atlanticist_dissent += 3; Q.government_coalition_dissent += 2;
    Q.foreign_authority_last_outcome = "A limited European-coordination commitment becomes a condition of support";
} else if (role == "junior_no_mfa") {
    Q.eu_influence += 4; Q.eu_eastern_coalition += 3;
    Q.left_atlanticist_dissent += 3; Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "Coalition council adopts a European answer after Lewica threatens public dissent";
} else if (role == "junior_mfa") {
    Q.eu_influence += 6; Q.eu_eastern_coalition += 4;
    Q.germany_relation += 2; Q.france_relation += 2;
    Q.us_ambassador_channel -= 1; Q.foreign_ministry_override_risk += 3;
    Q.foreign_authority_last_outcome = "The ministry negotiates a European pillar within the coalition's Atlantic limits";
} else if (role == "lead_no_mfa") {
    Q.eu_influence += 6; Q.eu_eastern_coalition += 4;
    Q.germany_relation += 2; Q.france_relation += 2;
    Q.us_ambassador_channel -= 1; Q.foreign_portfolio_resistance += 4;
    Q.foreign_authority_last_outcome = "Cabinet makes European coordination national strategy and directs the minister";
} else if (role == "lead_mfa") {
    Q.eu_influence += 8; Q.eu_eastern_coalition += 6;
    Q.germany_relation += 3; Q.france_relation += 3;
    Q.us_ambassador_channel -= 2; Q.government_delivery += 4;
    Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome = "The government builds and implements the European pillar as national strategy";
} else if (role == "caretaker") {
    Q.eu_influence += 2; Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker continues EU consultation without changing the alliance line";
} else {
    Q.eu_influence += 3; Q.germany_relation += 1; Q.france_relation += 1;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The President represents Poland in Europe without setting routine cabinet strategy";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish
