title: The United States
subtitle: Separate America from one president—and democratic solidarity from automatic obedience.
new-page: true
is-card: true
tags: poland_party_card
frequency: 110
view-if: month_actions < max_month_actions and poland_white_house_pressure_timer <= 0
call: poland_normalize
on-arrival: month_actions += 1; poland_white_house_pressure_timer = 5; foreign_cards_resolved += 1; foreign_authority_last_issue = "United States"
card-image: img/poland/cards/presidential-channel.webp

= The United States

**President:** [+ us_president +] · **administration:** [+ us_administration +].
US relationship **[+ us_alliance_reliability +]/100** · Congress **[+
us_congress_channel +]/100** · White House and embassy **[+
us_ambassador_channel +]/100**.

[? if us_administration = "America First": PiS and the Palace claim that
personal access to a Republican president is Poland's safest route. Lewica can
borrow it, or build ties to Congress, institutions and democratic America that
do not vanish with one election.?]
[? if us_administration = "Democratic": Democratic administrations connect
security to courts and political standards. That strengthens the opposition's
case under PiS, but KO will own the relationship unless Lewica gives it a
distinct programme.?]

- @democratic
- @institutions
- @white_house
- @presidential

@democratic
title: [? if us_administration = "Democratic": Build a joint democratic and rule-of-law channel?][? if us_administration != "Democratic": Work with democratic America outside the White House?]
subtitle: Strongest for opposition; government must still deal with the administration in office.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
Q.us_congress_channel += 5;
Q.constitutional_restraint += 3;
Q.us_rule_of_law_pressure += Q.us_administration == "Democratic" ? 5 : 2;
Q.us_alliance_reliability += Q.us_administration == "Democratic" ? 4 : 1;
if (executive) {
    Q.government_coalition_dissent += Q.us_administration == "Democratic" ? 1 : 3;
    Q.foreign_policy_responsibility += 2;
    Q.foreign_authority_last_outcome =
        "Cabinet widens the American relationship beyond presidential access";
} else {
    Q.media_capacity += 2;
    Q.ko_relation += 2;
    Q.pis_relation -= 3;
    Q.last_policy_stage = "Democratic international advocacy";
    Q.last_policy_authority = "Opposition, Congress and civil society";
    Q.last_policy_implementation = 0;
    Q.foreign_authority_last_outcome =
        "Opposition uses American democratic channels to reinforce its case in Poland";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@institutions
title: Put Congress, NATO and professional institutions before personal access
subtitle: A durable security channel available to opposition and government alike.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
Q.us_congress_channel += 6;
Q.us_defence_channel += 4;
Q.us_alliance_reliability += 3;
Q.military_trust += 2;
Q.constitutional_restraint += 2;
if (executive) {
    Q.government_delivery += 2;
    Q.foreign_policy_responsibility += 3;
    Q.foreign_authority_last_outcome =
        "Government anchors the alliance in institutions that can survive elections";
} else {
    Q.last_policy_stage = "Parliamentary security doctrine";
    Q.last_policy_authority = "Sejm opposition and congressional committees";
    Q.last_policy_implementation = 0;
    Q.foreign_authority_last_outcome =
        "Opposition builds an institutional American channel without pledging the state";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@white_house
title: [? if not left_in_government and us_administration = "America First": Borrow the PiS–Palace route to the White House?][? if not left_in_government and us_administration = "Democratic": Join KO's direct administration channel?][? if left_in_government: Negotiate directly with the administration in office?]
subtitle: [? if not left_in_government: Political access only; opposition cannot give a national pledge.?][? if left_in_government: Cost: 1 budget capacity. Direct access brings direct concessions and responsibility.?]
choose-if: left_in_government = 0 or caretaker_government = 1 or budget >= 1
unavailable-subtitle: A government negotiation needs one budget point.
on-arrival: {!
const executive = Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government;
if (executive) {
    Q.budget -= 1;
    Q.us_ambassador_channel += 7;
    Q.us_alliance_reliability += 5;
    Q.government_delivery += 4;
    Q.fiscal_stress += Q.us_administration == "America First" ? 4 : 2;
    Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome =
        "Government negotiates directly with Washington and owns the concessions";
} else {
    Q.us_ambassador_channel += 4;
    Q.pis_relation += Q.us_administration == "America First" ? 4 : -1;
    Q.ko_relation += Q.us_administration == "Democratic" ? 3 : -1;
    Q.party_unity -= 2;
    Q.foreign_authority_last_outcome =
        "Opposition gains political access without giving a national pledge";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@presidential
title: Use the Left President's separate American channel
subtitle: The Palace can represent and convene; cabinet and Sejm retain policy and spending.
view-if: foreign_left_presidential_channel = 1
on-arrival: us_ambassador_channel += 4; us_congress_channel += 2; constitutional_restraint += 3; foreign_authority_last_outcome = "The President represents Poland and convenes consultation without directing ministries"; news_headline = foreign_authority_last_outcome

- #poland_card_finish
