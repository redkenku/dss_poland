title: Europe's Radical Right Shares a Stage
subtitle: One transnational breakthrough, answered through the authority Lewica really holds.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 80
view-if: month_actions < max_month_actions and poland_european_right_shock_done = 1 and poland_european_right_response_done != 1
call: poland_normalize
on-arrival: month_actions += 1; poland_european_right_response_done = 1; foreign_cards_resolved += 1; foreign_authority_last_issue = "European radical-right infrastructure"
card-image: img/poland/cards/national-left-rally.webp

= Europe's radical right shares a stage

Election gains and coalition breakthroughs abroad have already delivered
networks, donors, speakers and a language of inevitability to Polish allies.
Climate obstruction, migration panic and Ukraine fatigue now travel through
shared European infrastructure. This response does not manufacture that
breakthrough a second time.

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].

- @social
- @firewall
- @imitate

@social
title: [? if foreign_authority_role = "ordinary_opposition": Build a cross-border party and union campaign around wages and security?][? if foreign_authority_role = "confidence_opposition": Add a bounded social-security condition to budget support and build party diplomacy?][? if foreign_authority_role = "junior_no_mfa": Demand a coalition social answer and trade support while organising independently?][? if foreign_authority_role = "junior_mfa": Use the ministry to convene a social-democratic network within the coalition mandate?][? if foreign_authority_role = "lead_no_mfa": Make the social answer cabinet strategy and direct the Foreign Minister to convene it?][? if foreign_authority_role = "lead_mfa": Initiate, fund and implement a European social-security coalition?][? if foreign_authority_role = "caretaker": Maintain civil-society contacts and defer new funding commitments?][? if foreign_authority_role = "left_president": Represent a democratic social answer and apply pluralist standards to diplomatic appointments?]
subtitle: [? if foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa": Cost: 1 party resource; party networks grow, while cabinet delivery stays limited.?][? if foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa": Cost: 1 budget capacity with coalition or portfolio friction.?][? if foreign_authority_role = "lead_mfa": Cost: 2 budget capacity and full delivery responsibility.?][? if foreign_authority_role = "caretaker": Continuity only.?][? if foreign_authority_role = "left_president": Representation and appointment influence, not programme spending.?]
choose-if: ((foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa") and resources >= 1) or ((foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa") and budget >= 1) or (foreign_authority_role = "lead_mfa" and budget >= 2) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.resources -= 1; Q.labor_credibility += 4;
    Q.eu_left_network += 4; Q.workers_support += 2;
    Q.far_right_agenda -= 1;
    Q.foreign_authority_last_outcome = "Opposition parties and unions build a cross-border social campaign";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.labor_credibility += 4;
    Q.eu_left_network += 5; Q.household_policy_pressure += 1;
    Q.government_coalition_dissent += 2; Q.far_right_agenda -= 1;
    Q.last_policy_stage = "Conditional social-security mandate";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "A bounded social-security condition joins party diplomacy to cabinet leverage";
} else if (role == "junior_no_mfa") {
    Q.resources -= 1; Q.labor_credibility += 4;
    Q.eu_left_network += 5; Q.household_policy_pressure += 1;
    Q.government_coalition_dissent += 3; Q.far_right_agenda -= 1;
    Q.last_policy_stage = "Coalition social-security demand";
    Q.last_policy_authority = "Junior coalition party without Foreign Affairs";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Coalition council records a social answer for cabinet while Lewica organises independently";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.labor_credibility += 5;
    Q.eu_left_network += 6; Q.eu_influence += 3;
    Q.far_right_agenda -= 2; Q.foreign_ministry_override_risk += 2;
    Q.foreign_authority_last_outcome = "The ministry convenes a social-democratic network inside the coalition mandate";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.labor_credibility += 5;
    Q.eu_left_network += 6; Q.eu_influence += 3;
    Q.far_right_agenda -= 2; Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome = "Cabinet makes social security its European strategy and directs the minister";
} else if (role == "lead_mfa") {
    Q.budget -= 2; Q.labor_credibility += 6;
    Q.eu_left_network += 8; Q.eu_influence += 5;
    Q.household_security += 3; Q.far_right_agenda -= 3;
    Q.government_delivery += 4; Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome = "Government funds, convenes and owns the European social coalition";
} else if (role == "caretaker") {
    Q.eu_left_network += 2; Q.far_right_agenda -= 1;
    Q.foreign_authority_last_outcome = "The caretaker preserves civil-society contacts and makes no new funding promise";
} else {
    Q.eu_left_network += 3; Q.public_trust += 2;
    Q.constitutional_restraint += 2; Q.far_right_agenda -= 1;
    Q.foreign_authority_last_outcome = "The President represents a democratic social answer and applies pluralist appointment standards";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@firewall
title: [? if foreign_authority_role = "ordinary_opposition": Move parliamentary motions and party agreements for a democratic firewall?][? if foreign_authority_role = "confidence_opposition": Condition support on democratic appointment and voting rules?][? if foreign_authority_role = "junior_no_mfa": Demand a coalition firewall and threaten public dissent over defections?][? if foreign_authority_role = "junior_mfa": Negotiate democratic coordination within the coalition's European mandate?][? if foreign_authority_role = "lead_no_mfa": Set cabinet firewall strategy and direct the minister while managing resistance?][? if foreign_authority_role = "lead_mfa": Negotiate and implement a government-wide democratic firewall?][? if foreign_authority_role = "caretaker": Consult all democratic clubs and preserve existing voting commitments?][? if foreign_authority_role = "left_president": Use representation, appointments and ratification scrutiny to defend democratic standards?]
subtitle: The firewall can block capture, but broader authority also makes Lewica more responsible for alliances that blur its programme.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.eu_institutional_trust += 2; Q.ko_relation += 2;
    Q.media_capacity += 1; Q.party_unity -= 1;
    Q.foreign_authority_last_outcome = "Parliamentary motions and party agreements construct an opposition firewall";
} else if (role == "confidence_opposition") {
    Q.eu_institutional_trust += 3; Q.ko_relation += 3;
    Q.government_coalition_dissent += 2; Q.party_unity -= 1;
    Q.foreign_authority_last_outcome = "Democratic appointment rules become a condition of support";
} else if (role == "junior_no_mfa") {
    Q.eu_institutional_trust += 3; Q.ko_relation += 3;
    Q.government_coalition_dissent += 3; Q.party_unity -= 2;
    Q.foreign_authority_last_outcome = "A coalition firewall is adopted under threat of Lewica dissent";
} else if (role == "junior_mfa") {
    Q.eu_institutional_trust += 5; Q.eu_influence += 3;
    Q.ko_relation += 3; Q.party_unity -= 2;
    Q.foreign_ministry_override_risk += 2;
    Q.foreign_authority_last_outcome = "Foreign Affairs negotiates democratic coordination within coalition limits";
} else if (role == "lead_no_mfa") {
    Q.eu_institutional_trust += 5; Q.eu_influence += 3;
    Q.ko_relation += 3; Q.party_unity -= 2;
    Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome = "Cabinet sets firewall strategy and directs the coalition minister";
} else if (role == "lead_mfa") {
    Q.eu_institutional_trust += 6; Q.eu_influence += 5;
    Q.ko_relation += 4; Q.constitutional_restraint += 3;
    Q.party_unity -= 3; Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome = "Government negotiates and implements the firewall and owns its compromises";
} else if (role == "caretaker") {
    Q.eu_institutional_trust += 2; Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker preserves existing voting commitments after cross-party consultation";
} else {
    Q.eu_institutional_trust += 3; Q.constitutional_restraint += 4;
    Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The President uses representation, appointments and ratification scrutiny to defend democratic standards";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@imitate
title: [? if foreign_authority_role = "ordinary_opposition": Shift the party's migration and climate line under public pressure?][? if foreign_authority_role = "confidence_opposition": Make cabinet support conditional on a harder line?][? if foreign_authority_role = "junior_no_mfa": Demand a harder coalition line and dissent publicly if refused?][? if foreign_authority_role = "junior_mfa": Reframe ministry diplomacy toward restriction and risk being overruled?][? if foreign_authority_role = "lead_no_mfa": Set a harder cabinet line and direct the portfolio owner to carry it?][? if foreign_authority_role = "lead_mfa": Implement a harder national line and accept responsibility for its effects?][? if foreign_authority_role = "caretaker": Keep inherited policy and defer a partisan turn?][? if foreign_authority_role = "left_president": Echo restriction in presidential representation without ordering border or climate policy?]
subtitle: The harder line receives attention; rights, climate capacity and far-right agenda costs scale with actual state authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.media_capacity += 2; Q.refugee_empathy -= 2;
    Q.far_right_agenda += 3;
    Q.foreign_authority_last_outcome = "Opposition rhetoric hardens and validates the radical right without changing state policy";
} else if (role == "confidence_opposition") {
    Q.border_security_confidence += 2; Q.refugee_empathy -= 3;
    Q.far_right_agenda += 3; Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "A harder line becomes a condition of support and shifts cabinet incentives";
} else if (role == "junior_no_mfa") {
    Q.border_security_confidence += 2; Q.refugee_empathy -= 3;
    Q.far_right_agenda += 4; Q.government_coalition_dissent += 5;
    Q.foreign_authority_last_outcome = "Lewica publicly pressures coalition policy toward the radical right's terrain";
} else if (role == "junior_mfa") {
    Q.border_security_confidence += 3; Q.refugee_empathy -= 4;
    Q.climate_policy_pressure -= 3; Q.far_right_agenda += 5;
    Q.foreign_ministry_override_risk += 5;
    Q.foreign_authority_last_outcome = "The Foreign Minister reframes diplomacy and risks a coalition override";
} else if (role == "lead_no_mfa") {
    Q.border_security_confidence += 3; Q.refugee_empathy -= 4;
    Q.climate_state_capacity -= 3; Q.far_right_agenda += 5;
    Q.foreign_portfolio_resistance += 5;
    Q.foreign_authority_last_outcome = "Cabinet orders a harder line over the portfolio owner's resistance";
} else if (role == "lead_mfa") {
    Q.border_security_confidence += 4; Q.refugee_empathy -= 5;
    Q.minority_safety -= 4; Q.climate_state_capacity -= 4;
    Q.far_right_agenda += 6; Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome = "The government implements the harder line and owns its rights and climate costs";
} else if (role == "caretaker") {
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The caretaker keeps inherited policy and defers a partisan turn";
} else {
    Q.border_security_confidence += 1; Q.refugee_empathy -= 2;
    Q.far_right_agenda += 2; Q.constitutional_restraint += 1;
    Q.foreign_authority_last_outcome = "Presidential rhetoric hardens while border and climate policy remain with cabinet";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish
