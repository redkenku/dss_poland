title: A Brussels Conditionality File
subtitle: The facts are common; Lewica's available verbs depend on the office it actually holds.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 100
view-if: month_actions < max_month_actions and year >= 2020 and poland_brussels_pressure_timer <= 0
call: poland_normalize
on-arrival: month_actions += 1; poland_brussels_pressure_timer = 6; foreign_cards_resolved += 1; foreign_pressure += 2; foreign_authority_last_issue = "Brussels conditionality"
card-image: img/poland/cards/government-affairs.webp

= A Brussels conditionality file

The Commission has published legal and spending benchmarks tied to European
funds. Meeting them can release money and institutional trust; contesting them
can preserve domestic room while prolonging the hold. The cabinet owns Polish
implementation, and the factual file does not change with Lewica's position.

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].
Institutional trust **[+ eu_institutional_trust +]/100** · external pressure
**[+ foreign_pressure +]/100**.

- @benchmarks
- @social_clause
- @sovereignty
- @presidential_channel

@benchmarks
title: [? if foreign_authority_role = "ordinary_opposition": File questions and a committee motion for a public benchmark timetable?][? if foreign_authority_role = "confidence_opposition": Make budget and confidence support conditional on a limited benchmark timetable?][? if foreign_authority_role = "junior_no_mfa": Demand that the coalition council instruct the Foreign Minister to negotiate published benchmarks?][? if foreign_authority_role = "junior_mfa": Negotiate a benchmark timetable inside the Prime Minister's coalition mandate?][? if foreign_authority_role = "lead_no_mfa": Set the cabinet timetable and direct the coalition Foreign Minister to carry it?][? if foreign_authority_role = "lead_mfa": Table, negotiate and implement Poland's benchmark timetable?][? if foreign_authority_role = "caretaker": Maintain technical compliance talks and defer new political commitments?][? if foreign_authority_role = "left_president": Represent constitutional compliance and require a cabinet briefing without commanding implementation?]
subtitle: [? if foreign_authority_role = "ordinary_opposition": Cost: 1 party resource. Scrutiny and a shadow timetable, not implementation.?][? if foreign_authority_role = "confidence_opposition": Cost: 1 party resource. A bounded condition can move the cabinet; Lewica still does not execute it.?][? if foreign_authority_role = "junior_no_mfa": Cost: 1 party resource and coalition friction. The portfolio owner keeps the negotiating pen.?][? if foreign_authority_role = "junior_mfa": Cost: 1 budget capacity. Strong delivery with a visible override risk.?][? if foreign_authority_role = "lead_no_mfa": Cost: 1 budget capacity and portfolio-owner resistance.?][? if foreign_authority_role = "lead_mfa": Cost: 2 budget capacity. Full gains and full responsibility.?][? if foreign_authority_role = "caretaker": Continuity only; no new fiscal or irreversible undertaking.?][? if foreign_authority_role = "left_president": Representation and constitutional influence only; the cabinet retains command.?]
choose-if: (foreign_authority_role = "ordinary_opposition" and resources >= 1) or (foreign_authority_role = "confidence_opposition" and resources >= 1) or (foreign_authority_role = "junior_no_mfa" and resources >= 1) or (foreign_authority_role = "junior_mfa" and budget >= 1) or (foreign_authority_role = "lead_no_mfa" and budget >= 1) or (foreign_authority_role = "lead_mfa" and budget >= 2) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.resources -= 1; Q.eu_institutional_trust += 3;
    Q.constitutional_restraint += 2; Q.media_capacity += 2;
    Q.foreign_authority_last_outcome = "Opposition questions and a committee motion publish a shadow benchmark timetable";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.eu_institutional_trust += 4;
    Q.constitutional_restraint += 2;
    Q.government_coalition_dissent += 2; Q.budget_promises += 1;
    Q.last_policy_stage = "Conditional benchmark timetable";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "A limited benchmark timetable becomes a condition of budget and confidence support";
} else if (role == "junior_no_mfa") {
    Q.resources -= 1; Q.eu_institutional_trust += 4;
    Q.eu_influence += 2; Q.government_coalition_dissent += 3;
    Q.last_policy_stage = "Coalition benchmark demand";
    Q.last_policy_authority = "Junior coalition party without Foreign Affairs";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "The coalition council records a benchmark demand for the portfolio owner to negotiate";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.eu_institutional_trust += 6;
    Q.eu_influence += 3; Q.government_delivery += 3;
    Q.foreign_pressure -= 4; Q.foreign_ministry_override_risk += 3;
    Q.government_coalition_dissent += 2;
    Q.foreign_authority_last_outcome = "The Foreign Ministry negotiates a timetable inside the coalition mandate";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.eu_institutional_trust += 6;
    Q.eu_influence += 4; Q.government_delivery += 3;
    Q.foreign_pressure -= 4; Q.foreign_portfolio_resistance += 4;
    Q.government_coalition_dissent += 2;
    Q.foreign_authority_last_outcome = "The Prime Minister sets the line and directs a resistant coalition Foreign Minister";
} else if (role == "lead_mfa") {
    Q.budget -= 2; Q.eu_institutional_trust += 8;
    Q.eu_influence += 5; Q.constitutional_restraint += 3;
    Q.government_delivery += 5; Q.foreign_pressure -= 6;
    Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome = "A Lewica-led cabinet tables, negotiates and implements the national timetable";
} else if (role == "caretaker") {
    Q.eu_institutional_trust += 2; Q.constitutional_restraint += 2;
    Q.foreign_pressure -= 1;
    Q.foreign_authority_last_outcome = "Caretaker officials preserve technical compliance and defer the political bargain";
} else {
    Q.eu_institutional_trust += 3; Q.constitutional_restraint += 4;
    Q.public_trust += 2;
    Q.foreign_authority_last_outcome = "The President represents constitutional compliance and requests a cabinet account";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

The resulting influence is real, but only cabinet actors have changed the
implementation timetable. Opposition, caretaker and presidential routes have
created leverage or continuity instead.

- #poland_card_finish

@social_clause
title: [? if foreign_authority_role = "ordinary_opposition": Publish a shadow social-investment clause and campaign for it?][? if foreign_authority_role = "confidence_opposition": Trade limited support for a costed social-investment safeguard?][? if foreign_authority_role = "junior_no_mfa": Put the safeguard to coalition council and trade Lewica's support for it?][? if foreign_authority_role = "junior_mfa": Negotiate the safeguard, subject to the cabinet's agreed fiscal ceiling?][? if foreign_authority_role = "lead_no_mfa": Order a cabinet social safeguard and send the Foreign Minister to negotiate it?][? if foreign_authority_role = "lead_mfa": Commit and implement a funded social safeguard in the European settlement?][? if foreign_authority_role = "caretaker": Preserve existing social exemptions and consult the incoming majority?][? if foreign_authority_role = "left_president": Use representation and ratification scrutiny to defend a social safeguard?]
subtitle: [? if foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition": Cost: 1 party resource; influence grows without executive spending.?][? if foreign_authority_role = "junior_no_mfa": Coalition support is traded; the minister still negotiates.?][? if foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa" or foreign_authority_role = "lead_mfa": Cost: 1 budget capacity and fiscal stress; executive responsibility applies.?][? if foreign_authority_role = "caretaker": No new spending; only inherited safeguards can be preserved.?][? if foreign_authority_role = "left_president": No cabinet spending power; constitutional scrutiny and representation only.?]
choose-if: (foreign_authority_role = "ordinary_opposition" and resources >= 1) or (foreign_authority_role = "confidence_opposition" and resources >= 1) or foreign_authority_role = "junior_no_mfa" or ((foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa" or foreign_authority_role = "lead_mfa") and budget >= 1) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.resources -= 1; Q.eu_left_network += 4;
    Q.labor_credibility += 3; Q.media_capacity += 1;
    Q.foreign_authority_last_outcome = "The opposition publishes a costed social safeguard and recruits European allies";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.eu_left_network += 5;
    Q.labor_credibility += 4; Q.household_policy_pressure += 1;
    Q.government_coalition_dissent += 2;
    Q.last_policy_stage = "Negotiated concession";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Conditional support buys one limited social-investment safeguard";
} else if (role == "junior_no_mfa") {
    Q.eu_left_network += 5; Q.labor_credibility += 4;
    Q.household_policy_pressure += 1; Q.government_coalition_dissent += 3;
    Q.last_policy_stage = "Coalition safeguard demand";
    Q.last_policy_authority = "Junior coalition party without Foreign Affairs";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Lewica trades coalition support for a safeguard the portfolio owner must negotiate";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.eu_left_network += 6; Q.eu_influence += 3;
    Q.labor_credibility += 4; Q.household_policy_pressure += 2;
    Q.fiscal_stress += 2; Q.foreign_ministry_override_risk += 2;
    Q.last_policy_stage = "Ministry-negotiated safeguard";
    Q.last_policy_authority = "Junior coalition party holding Foreign Affairs";
    Q.last_policy_implementation = "Domestic funding pending cabinet execution";
    Q.foreign_authority_last_outcome = "The Foreign Ministry negotiates a funded safeguard within the coalition ceiling";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.eu_left_network += 6; Q.eu_influence += 3;
    Q.labor_credibility += 4; Q.household_security += 2;
    Q.fiscal_stress += 2; Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome = "Cabinet directs the social safeguard over the portfolio owner's objections";
} else if (role == "lead_mfa") {
    Q.budget -= 1; Q.eu_left_network += 7; Q.eu_influence += 4;
    Q.labor_credibility += 5; Q.household_security += 3;
    Q.fiscal_stress += 3; Q.government_delivery += 4;
    Q.foreign_policy_responsibility += 4;
    Q.foreign_authority_last_outcome = "The government negotiates, funds and owns the social safeguard";
} else if (role == "caretaker") {
    Q.eu_left_network += 1; Q.household_security += 1;
    Q.foreign_authority_last_outcome = "The caretaker preserves inherited exemptions and leaves new spending to its successor";
} else {
    Q.eu_left_network += 2; Q.constitutional_restraint += 2;
    Q.labor_credibility += 1;
    Q.foreign_authority_last_outcome = "The President defends the safeguard in representation and ratification scrutiny";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

