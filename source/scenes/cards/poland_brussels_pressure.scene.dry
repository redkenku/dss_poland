@presidential_channel
title: Require a Palace briefing and preserve ratification scrutiny
subtitle: Constitutional influence only; the cabinet retains the negotiating pen and implementation burden.
view-if: foreign_left_presidential_channel = 1
on-arrival: eu_institutional_trust += 2; constitutional_restraint += 2; public_trust += 1; foreign_authority_last_outcome = "The President requires a cabinet briefing and reserves lawful ratification scrutiny without commanding the negotiation"; news_headline = foreign_authority_last_outcome

