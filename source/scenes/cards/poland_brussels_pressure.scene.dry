@sovereignty
title: [? if foreign_authority_role = "ordinary_opposition": Lead public pressure against the file while demanding the cabinet disclose its alternative?][? if foreign_authority_role = "confidence_opposition": Withhold confidence for any implementation law that accepts the file unchanged?][? if foreign_authority_role = "junior_no_mfa": Dissent publicly and force a coalition-council vote on resistance?][? if foreign_authority_role = "junior_mfa": Enter a formal reservation and risk being overruled by the Prime Minister?][? if foreign_authority_role = "lead_no_mfa": Direct the Foreign Minister to reopen the file despite portfolio-owner resistance?][? if foreign_authority_role = "lead_mfa": Reject the file and own the financial and legal consequences?][? if foreign_authority_role = "caretaker": Record legal objections and defer rejection to a cabinet with confidence?][? if foreign_authority_role = "left_president": Refer disputed implementing law and represent Poland's objections without ordering cabinet policy?]
subtitle: The political cost follows the authority used: protest, coalition rupture, executive liability, caretaker delay or constitutional review.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.media_capacity += 3; Q.pis_relation += 2;
    Q.eu_institutional_trust -= 2; Q.far_right_agenda += 2;
    Q.foreign_authority_last_outcome = "Opposition pressure attacks the file but cannot reject it for Poland";
} else if (role == "confidence_opposition") {
    Q.party_unity += 2; Q.government_coalition_dissent += 5;
    Q.eu_institutional_trust -= 3; Q.foreign_pressure += 2;
    Q.foreign_authority_last_outcome = "Lewica withholds confidence from unchanged implementation and leaves the cabinet to choose";
} else if (role == "junior_no_mfa") {
    Q.party_unity += 1; Q.government_coalition_dissent += 6;
    Q.eu_institutional_trust -= 3; Q.foreign_pressure += 2;
    Q.foreign_authority_last_outcome = "Public dissent forces a coalition vote without pretending Lewica controls the ministry";
} else if (role == "junior_mfa") {
    Q.eu_institutional_trust -= 4; Q.foreign_pressure += 3;
    Q.foreign_ministry_override_risk += 7;
    Q.government_coalition_dissent += 5;
    Q.foreign_authority_last_outcome = "The Foreign Minister records a reservation the Prime Minister may overrule";
} else if (role == "lead_no_mfa") {
    Q.eu_institutional_trust -= 5; Q.foreign_pressure += 4;
    Q.foreign_portfolio_resistance += 7;
    Q.government_coalition_dissent += 5;
    Q.foreign_authority_last_outcome = "Cabinet orders the file reopened and absorbs the portfolio owner's resistance";
} else if (role == "lead_mfa") {
    Q.eu_institutional_trust -= 7; Q.eu_influence -= 4;
    Q.foreign_pressure += 5; Q.far_right_agenda += 3;
    Q.foreign_policy_responsibility += 7; Q.government_delivery -= 3;
    Q.foreign_authority_last_outcome = "The government rejects the file and owns the frozen money and litigation";
} else if (role == "caretaker") {
    Q.constitutional_restraint += 2; Q.foreign_pressure += 1;
    Q.foreign_authority_last_outcome = "The caretaker records objections but defers an irreversible rejection";
} else {
    Q.constitutional_restraint += 3; Q.eu_institutional_trust -= 1;
    Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The President sends disputed legislation to constitutional scrutiny without commanding the negotiation";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish
