title: The German Order Book Contracts
subtitle: The same industrial shock reaches different instruments of opposition, coalition, cabinet, caretaker and President.
new-page: true
is-card: true
tags: poland_foreign_card
frequency: 85
view-if: month_actions < max_month_actions and poland_berlin_order_shock_done = 1 and poland_berlin_response_done != 1
call: poland_normalize
on-arrival: month_actions += 1; poland_berlin_response_done = 1; foreign_cards_resolved += 1; foreign_authority_last_issue = "German industrial contraction"
card-image: img/poland/cards/workers-public-services.webp

= The German order book contracts

German manufacturers have already cut orders from Silesian factories,
logistics firms and component suppliers. The dated shock has already reduced
growth and raised unemployment; opening this file does not apply it again.
Berlin remains both a commercial partner and a convenient political target.

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].

- @workers
- @investment
- @blame
- @presidential_channel

@workers
title: [? if foreign_authority_role = "ordinary_opposition": Table a worker-protection motion and organise public pressure on the cabinet?][? if foreign_authority_role = "confidence_opposition": Condition budget support on a limited wage-and-hours shield?][? if foreign_authority_role = "junior_no_mfa": Demand the shield in coalition council and trade support for its inclusion?][? if foreign_authority_role = "junior_mfa": Negotiate German consultation while asking cabinet for a bounded worker shield?][? if foreign_authority_role = "lead_no_mfa": Set the cabinet's industrial shield and direct the Foreign Minister to open German talks?][? if foreign_authority_role = "lead_mfa": Launch the shield and negotiate its cross-border industrial terms?][? if foreign_authority_role = "caretaker": Continue statutory support and consult unions without creating a new programme?][? if foreign_authority_role = "left_president": Convene labour, industry and cabinet and represent the case for a shield?]
subtitle: [? if foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa": Cost: 1 party resource; any material delivery remains bounded or belongs to cabinet.?][? if foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa": Cost: 1 budget capacity; cabinet friction remains.?][? if foreign_authority_role = "lead_mfa": Cost: 2 budget capacity; strongest delivery and full responsibility.?][? if foreign_authority_role = "caretaker": Existing continuity only.?][? if foreign_authority_role = "left_president": Convening and representation, not expenditure or ministerial orders.?]
choose-if: ((foreign_authority_role = "ordinary_opposition" or foreign_authority_role = "confidence_opposition" or foreign_authority_role = "junior_no_mfa") and resources >= 1) or ((foreign_authority_role = "junior_mfa" or foreign_authority_role = "lead_no_mfa") and budget >= 1) or (foreign_authority_role = "lead_mfa" and budget >= 2) or foreign_authority_role = "caretaker" or foreign_authority_role = "left_president"
unavailable-subtitle: The selected route lacks the party or cabinet capacity stated for this authority.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.resources -= 1; Q.labor_credibility += 4; Q.workers_support += 3;
    Q.media_capacity += 2;
    Q.foreign_authority_last_outcome = "Opposition tables a worker-protection motion and organises affected plants";
} else if (role == "confidence_opposition") {
    Q.resources -= 1; Q.labor_credibility += 4; Q.household_policy_pressure += 2;
    Q.fiscal_stress += 1; Q.government_coalition_dissent += 2;
    Q.last_policy_stage = "Negotiated concession";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "A limited industrial shield becomes the price of budget support";
} else if (role == "junior_no_mfa") {
    Q.resources -= 1; Q.labor_credibility += 4;
    Q.household_policy_pressure += 2; Q.government_coalition_dissent += 3;
    Q.last_policy_stage = "Coalition demand accepted in principle";
    Q.last_policy_authority = "Junior coalition party without Foreign Affairs";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Coalition council records a bounded shield that cabinet still has to execute";
} else if (role == "junior_mfa") {
    Q.budget -= 1; Q.labor_credibility += 4; Q.household_policy_pressure += 3;
    Q.germany_relation += 3; Q.government_delivery += 2;
    Q.fiscal_stress += 1; Q.foreign_ministry_override_risk += 2;
    Q.last_policy_stage = "Ministry consultation and cabinet request";
    Q.last_policy_authority = "Junior coalition party holding Foreign Affairs";
    Q.last_policy_implementation = "Worker shield pending cabinet execution";
    Q.foreign_authority_last_outcome = "The ministry opens German consultations while cabinet considers the bounded shield";
} else if (role == "lead_no_mfa") {
    Q.budget -= 1; Q.labor_credibility += 5; Q.household_security += 3;
    Q.germany_relation += 3; Q.government_delivery += 3;
    Q.fiscal_stress += 2; Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome = "Cabinet sets the industrial shield and directs the coalition minister abroad";
} else if (role == "lead_mfa") {
    Q.budget -= 2; Q.labor_credibility += 6; Q.workers_support += 4;
    Q.household_security += 4; Q.germany_relation += 4;
    Q.government_delivery += 5; Q.fiscal_stress += 3;
    Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome = "Government launches the shield and owns both funding and German negotiation";
} else if (role == "caretaker") {
    Q.labor_credibility += 1; Q.household_security += 1;
    Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The caretaker continues statutory support and leaves a costed option for its successor";
} else {
    Q.public_trust += 2; Q.labor_credibility += 2;
    Q.germany_relation += 1;
    Q.foreign_authority_last_outcome = "The President convenes workers, employers and cabinet without promising state expenditure";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@presidential_channel
title: Convene labour, industry and cabinet at the Palace
subtitle: Presidential convening and representation only; contracts and spending remain with government.
view-if: foreign_left_presidential_channel = 1
on-arrival: germany_relation += 2; labor_credibility += 2; public_trust += 1; constitutional_restraint += 1; foreign_authority_last_outcome = "The Palace convenes the affected sides and represents their case without manufacturing contracts or ordering ministers"; news_headline = foreign_authority_last_outcome

- #poland_card_finish

@investment
title: [? if foreign_authority_role = "ordinary_opposition": Publish a shadow EU industrial-investment plan and build party diplomacy around it?][? if foreign_authority_role = "confidence_opposition": Offer limited support for a costed European investment mandate?][? if foreign_authority_role = "junior_no_mfa": Pressure the minister to take an investment mandate and trade coalition support?][? if foreign_authority_role = "junior_mfa": Open an EU industrial table within the coalition programme?][? if foreign_authority_role = "lead_no_mfa": Direct Foreign Affairs and Economy to pursue a cabinet investment mandate?][? if foreign_authority_role = "lead_mfa": Propose, negotiate and implement the European industrial coalition?][? if foreign_authority_role = "caretaker": Keep existing EU projects moving and defer new guarantees?][? if foreign_authority_role = "left_president": Represent the investment case and scrutinise any treaty or guarantee?]
subtitle: Executive routes can restore orders; opposition, caretaker and presidential routes build leverage or preserve continuity without manufacturing contracts.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.eu_influence += 2; Q.germany_relation += 2;
    Q.media_capacity += 2; Q.labor_dissent += 1;
    Q.foreign_authority_last_outcome = "A shadow investment plan gives party diplomacy a concrete industrial offer";
} else if (role == "confidence_opposition") {
    Q.eu_influence += 3; Q.germany_relation += 3;
    Q.budget_promises += 1; Q.government_coalition_dissent += 1;
    Q.last_policy_stage = "Conditional investment mandate";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Limited support offers cabinet a narrow European investment mandate";
} else if (role == "junior_no_mfa") {
    Q.eu_influence += 3; Q.germany_relation += 3;
    Q.budget_promises += 1; Q.government_coalition_dissent += 2;
    Q.last_policy_stage = "Coalition investment demand";
    Q.last_policy_authority = "Junior coalition party without Foreign Affairs";
    Q.last_policy_implementation = "Pending cabinet execution";
    Q.foreign_authority_last_outcome = "Coalition council records an investment mandate for the portfolio owner to execute";
} else if (role == "junior_mfa") {
    Q.eu_influence += 4; Q.germany_relation += 5;
    Q.budget_promises += 1; Q.government_delivery += 2;
    Q.foreign_ministry_override_risk += 2;
    Q.last_policy_stage = "Ministry investment initiative";
    Q.last_policy_authority = "Junior coalition party holding Foreign Affairs";
    Q.last_policy_implementation = "Domestic investment pending cabinet execution";
    Q.foreign_authority_last_outcome = "The ministry opens an EU industrial table within the coalition programme";
} else if (role == "lead_no_mfa") {
    Q.eu_influence += 4; Q.germany_relation += 5;
    Q.economic_growth += 0.3; Q.government_delivery += 3;
    Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome = "Cabinet directs the economic and foreign portfolios to pursue one mandate";
} else if (role == "lead_mfa") {
    Q.eu_influence += 6; Q.germany_relation += 6;
    Q.eu_institutional_trust += 3; Q.economic_growth += 0.5;
    Q.government_delivery += 4; Q.foreign_policy_responsibility += 4;
    Q.foreign_authority_last_outcome = "The government negotiates and begins implementing the industrial coalition";
} else if (role == "caretaker") {
    Q.eu_influence += 1; Q.germany_relation += 1;
    Q.foreign_authority_last_outcome = "The caretaker keeps signed projects moving and offers no new guarantee";
} else {
    Q.eu_influence += 2; Q.germany_relation += 2;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome = "The President represents the investment case while reserving guarantees to cabinet and parliament";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish

@blame
title: [? if foreign_authority_role = "ordinary_opposition": Make Berlin and the cabinet answer in public hearings for the lost shifts?][? if foreign_authority_role = "confidence_opposition": Threaten to withdraw support unless cabinet confronts Berlin?][? if foreign_authority_role = "junior_no_mfa": Dissent publicly and demand the minister summon the German ambassador?][? if foreign_authority_role = "junior_mfa": Summon the ambassador within mandate and risk a prime-ministerial correction?][? if foreign_authority_role = "lead_no_mfa": Order a formal protest over the portfolio owner's objections?][? if foreign_authority_role = "lead_mfa": Launch a cabinet confrontation and own the commercial retaliation?][? if foreign_authority_role = "caretaker": Record concern, consult industry and defer confrontation?][? if foreign_authority_role = "left_president": Voice national concern while refusing to substitute the Palace for cabinet diplomacy?]
subtitle: Salience is immediate; damage grows with the authority capable of turning rhetoric into state policy.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.media_capacity += 3; Q.germany_relation -= 2;
    Q.far_right_agenda += 2;
    Q.foreign_authority_last_outcome = "Public hearings attack Berlin and cabinet but create no national retaliation";
} else if (role == "confidence_opposition") {
    Q.government_coalition_dissent += 4; Q.germany_relation -= 3;
    Q.foreign_pressure += 1; Q.party_unity += 1;
    Q.foreign_authority_last_outcome = "A support threat pushes cabinet toward confrontation";
} else if (role == "junior_no_mfa") {
    Q.government_coalition_dissent += 5; Q.germany_relation -= 4;
    Q.public_trust += 1; Q.far_right_agenda += 2;
    Q.foreign_authority_last_outcome = "Public coalition dissent forces the minister to hear Lewica's protest";
} else if (role == "junior_mfa") {
    Q.germany_relation -= 6; Q.eu_influence -= 2;
    Q.foreign_ministry_override_risk += 6; Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "The Foreign Minister summons the ambassador and risks being corrected by the Prime Minister";
} else if (role == "lead_no_mfa") {
    Q.germany_relation -= 7; Q.eu_influence -= 2;
    Q.foreign_portfolio_resistance += 6; Q.government_coalition_dissent += 4;
    Q.foreign_authority_last_outcome = "Cabinet orders a protest over the coalition portfolio owner's objections";
} else if (role == "lead_mfa") {
    Q.germany_relation -= 9; Q.eu_influence -= 4;
    Q.economic_growth -= 0.2; Q.foreign_pressure += 3;
    Q.far_right_agenda += 4; Q.foreign_policy_responsibility += 6;
    Q.foreign_authority_last_outcome = "The government launches the confrontation and owns the commercial retaliation";
} else if (role == "caretaker") {
    Q.germany_relation -= 1; Q.public_trust += 1;
    Q.foreign_authority_last_outcome = "The caretaker records concern and defers a diplomatic confrontation";
} else {
    Q.germany_relation -= 2; Q.public_trust += 1;
    Q.constitutional_restraint += 1;
    Q.foreign_authority_last_outcome = "The President voices concern without claiming the cabinet's power to retaliate";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}

- #poland_card_finish
