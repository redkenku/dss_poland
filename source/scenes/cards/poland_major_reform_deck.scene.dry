title: Major Reforms
subtitle: Build a mandate in opposition, then spend coalition and presidential capital to turn it into law.
is-deck: true
view-if: major_reforms_complete = 0 and month_actions < max_month_actions and reform_pressure_pending = 0 and ((abortion_reform_settled = 0 and poland_abortion_reform_timer <= 0) or (marriage_reform_settled = 0 and poland_marriage_reform_timer <= 0) or (labor_reform_settled = 0 and poland_labor_reform_timer <= 0))
card-image: img/poland/cards/programme-convention.webp

