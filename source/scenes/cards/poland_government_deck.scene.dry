title: Government Affairs
subtitle: Ministries, delivery and coalition responsibility.
is-deck: true
view-if: left_in_government = 1 and government_has_confidence = 1 and caretaker_government = 0 and month_actions < max_month_actions and ((labor_minister_party = "Lewica" and poland_labor_inspection_timer <= 0 and (labor_credibility < 85 or workers_support < 75)) or (housing_minister_party = "Lewica" and poland_housing_fund_timer <= 0 and household_security < 85) or (equality_minister_party = "Lewica" and poland_equality_bill_timer <= 0 and minority_safety < 90) or (health_minister_party = "Lewica" and poland_health_compact_timer <= 0 and (health_capacity < 85 or pandemic_deaths_pressure > 0)))
card-image: img/poland/deck_parliament.svg

- #poland_government_card
