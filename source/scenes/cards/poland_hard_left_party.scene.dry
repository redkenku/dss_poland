@forgotten_poland
title: The Forgotten Poland
subtitle: Make depopulation and ruined towns a question of ownership, not regional branding.
new-page: true
is-card: true
tags: poland_party_card
frequency: 175
view-if: hard_left_turn_open = 1 and month_actions < max_month_actions and poland_forgotten_poland_timer = 0
