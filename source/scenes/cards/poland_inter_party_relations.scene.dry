title: Inter-Party Relations
subtitle: Build one political relationship without pretending that cooperation is free.
new-page: true
is-card: true
tags: poland_party_card
frequency: 200
view-if: month_actions < max_month_actions and poland_inter_party_relations_timer <= 0
on-arrival: {!
const active = function(value) {
    return !!value;
};
const joinNames = function(names, fallback) {
    if (!names.length) return fallback;
    if (names.length == 1) return names[0];
    if (names.length == 2) return names[0] + " and " + names[1];
    return names.slice(0, -1).join(", ") + ", and " + names[names.length - 1];
};

const centristPartners = [];
const thirdWayJoint = active(Q.p2050_emerged) &&
    (active(Q.third_way_active) || active(Q.third_way_2023_done)) &&
    !active(Q.third_way_split);
if (thirdWayJoint) {
    centristPartners.push("Trzecia Droga");
} else {
    if (active(Q.psl_seats) || active(Q.psl_poll)) centristPartners.push("PSL");
    if (
        !active(Q.p2050_joined_left) &&
        (active(Q.p2050_seats) || active(Q.p2050_poll) || active(Q.p2050_emerged))
    ) {
        centristPartners.push("Polska 2050");
    }
}
if (active(Q.unia_centrum_formed) || active(Q.centrum_seats) || active(Q.centrum_poll)) {
    centristPartners.push("Centrum");
}
if (active(Q.porozumienie_exit_done) && active(Q.porozumienie_active)) {
    centristPartners.push("Porozumienie");
}
if (
    active(Q.rozwoj_party_formed) &&
    !active(Q.rozwoj_internal_pis) &&
    !active(Q.rozwoj_joined_left)
) {
    centristPartners.push("Rozwój+");
}
Q.inter_party_centrist_targets = joinNames(centristPartners, "the active centrist parties");

const koSplitters = [];
if (active(Q.ko_splinter_active)) {
    koSplitters.push((Q.ko_splinter_type || "Independent") + " KO splinter");
}
const greens = (Q.rival_group_records || []).find(function(record) {
    return record.id == "greens";
});
if (greens && active(greens.active) && !active(Q.greens_joined_left)) {
    koSplitters.push(greens.name || "Zieloni");
}
Q.inter_party_ko_targets = joinNames(koSplitters, "no independent KO splinter");

const radicalRight = [];
if (active(Q.konf_seats) || active(Q.konf_poll)) radicalRight.push("Konfederacja");
if (active(Q.far_right_split) || active(Q.korona_seats) || active(Q.korona_poll)) {
    radicalRight.push("Korona");
}
if (
    active(Q.suwerenna_walkout) ||
    String(Q.suwerenna_merger_result || "") == "Merger refused"
) {
    radicalRight.push("Suwerenna Polska");
}
Q.inter_party_radical_right_targets = joinNames(radicalRight, "the active radical-right parties");
Q.inter_party_pis_targets = active(Q.rozwoj_party_formed) &&
    !active(Q.rozwoj_internal_pis) &&
    !active(Q.rozwoj_joined_left)
    ? "PiS's social-solidarist current and Rozwój+"
    : "PiS's social-solidarist current";
month_actions += 1;
poland_inter_party_relations_timer = 6;
!}
card-image: img/poland/cards/coalition-council.webp

= Inter-party relations

Lewica cannot govern alone. It can invest in one relationship this month, but
every durable channel tells other parties—and Lewica's own currents—something
about the coalition it may prefer later.

- @ko
- @third_way
- @pis_solidarists
- @konf
- @breakaways
- @stand_alone

@ko
title: Strengthen the working relationship with KO; keep an eye on [+ inter_party_ko_targets +]
subtitle: Cost: 1 resource. KO relation +8; socialist dissent rises while [+ inter_party_ko_targets +] remain outside the main channel.
view-if: ko_seats > 0 or ko_poll > 0
choose-if: resources >= 1
unavailable-subtitle: A permanent parliamentary liaison requires one resource.
on-arrival: resources -= 1; poland_inter_party_focus = "KO"; ko_relation += 8; p2050_relation += 1; constitutional_restraint += 2; judicial_legitimacy += 2; razem_dissent += 4; labor_dissent += 2; party_unity -= 1; news_headline = "Lewica and KO strengthen their permanent parliamentary channel"

Procedure, courts and European policy provide quick common ground with KO.
[+ inter_party_ko_targets +] make the liberal camp less unified, so the socialist
wing warns that coordination with the largest liberal party can become dependence.

- #poland_card_finish


@third_way
title: Build a rural and state-capacity channel with [+ inter_party_centrist_targets +]
subtitle: Cost: 1 resource. Strengthens relations with [+ inter_party_centrist_targets +].
view-if: psl_seats > 0 or psl_poll > 0 or p2050_seats > 0 or p2050_poll > 0 or p2050_emerged = 1 or unia_centrum_formed = 1 or centrum_seats > 0 or centrum_poll > 0
choose-if: resources >= 1
unavailable-subtitle: Rural, local-government and parliamentary liaison requires one resource.
on-arrival: {!
Q.resources -= 1;
const partners = [];
if ((Number(Q.psl_seats) || 0) > 0 || (Number(Q.psl_poll) || 0) > 0) {
    Q.psl_relation += 7;
    partners.push("PSL");
}
if (
    !Q.p2050_joined_left &&
    (
        (Number(Q.p2050_seats) || 0) > 0 ||
        (Number(Q.p2050_poll) || 0) > 0 ||
        Q.p2050_emerged
    )
) {
    Q.p2050_relation += 7;
    partners.push("Polska 2050");
}
if (
    Q.unia_centrum_formed ||
    (Number(Q.centrum_seats) || 0) > 0 ||
    (Number(Q.centrum_poll) || 0) > 0
) {
    if (Number.isFinite(Number(Q.centrum_relation))) {
        Q.centrum_relation += 6;
    } else {
        Q.centrum_parent_relation =
            (Number(Q.centrum_parent_relation) || 34) + 6;
    }
    partners.push("Unia Centrum");
}
Q.poland_inter_party_focus = partners.length
    ? partners.join(" and ")
    : "centrist and rural channel";
Q.local_network += 2;
Q.public_trust += 1;
Q.progressives_dissent += 4;
Q.spring_dissent += 2;
Q.news_headline = partners.length
    ? "Lewica opens a permanent channel to " + partners.join(" and ")
    : "Lewica opens a centrist and rural liaison channel";
!}

The talks with [+ inter_party_centrist_targets +] begin with clinics, transport,
local finance and administrative capacity. Rights policy is not abandoned; it
is also not permitted to lead the meeting.

- #poland_card_finish


@pis_solidarists
title: Open a working channel to [+ inter_party_pis_targets +]
subtitle: Cost: 1 resource. Bargaining capital +6 and PiS relation +8; Rozwój+ is also part of the political arithmetic when it is independent.
view-if: pis_seats > 0 or pis_poll > 0
choose-if: resources >= 1
unavailable-subtitle: A serious social-policy channel requires one resource.
on-arrival: {!
Q.resources -= 1;
Q.poland_inter_party_focus = "PiS social solidarists";
Q.negotiation_capital += 6;
Q.pis_relation += 8;
if (Q.government_party == "pis") {
    Q.government_negotiation_hostility -= 10;
}
Q.pis_negotiation_hostility_relief += 10;
Q.pis_solidarist_share += 5;
Q.pis_market_hardliner_share -= 5;
Q.pis_accept_social += 5;
Q.ko_relation -= 4;
Q.p2050_relation -= 3;
Q.psl_relation -= 2;
Q.government_coalition_dissent += 4;
Q.united_right_cohesion -= 4;
Q.progressives_dissent += 3;
Q.razem_dissent += 2;
for (const id of ["solidarna", "pis_security", "pis_culture"]) {
    const current = (Q.rival_group_records || []).find(function(record) {
        return record.id == id;
    });
    if (current) {
        current.cohesion -= 3;
        current.grievance_memory += 8;
        if (id == "solidarna") Q.suwerenna_merge_dissent += 4;
    }
}
const welfare = (Q.rival_group_records || []).find(function(record) {
    return record.id == "pis_welfare";
});
if (welfare) {
    welfare.relation += 8;
    welfare.cohesion += 2;
}
Q.news_headline =
    "Lewica reconciles with PiS solidarists and divides both larger camps";
!}

Pensions, wages, public services and state investment provide a real basis for
conversation with [+ inter_party_pis_targets +]. KO, Poland 2050 and PSL see an
attack on the capitalist centre. The PiS market, security and culture-war
currents see the social wing acquire an outside partner and record their dissent.

- #poland_card_finish


@konf
title: Open a narrow anti-privatisation channel to [+ inter_party_radical_right_targets +]
subtitle: Cost: 1 resource. Improves relations with [+ inter_party_radical_right_targets +]; democratic and progressive relationships suffer.
view-if: konf_seats > 0 or konf_poll > 0 or p0_formed = 1 or p0_seats > 0 or p0_poll > 0 or far_right_split = 1 or korona_seats > 0 or korona_poll > 0
choose-if: resources >= 1
unavailable-subtitle: Vetting a narrow parliamentary channel requires one resource.
on-arrival: {!
Q.resources -= 1;
const channels = [];
if ((Number(Q.konf_seats) || 0) > 0 || (Number(Q.konf_poll) || 0) > 0) {
    Q.konf_relation += 6;
    channels.push("Konfederacja");
}
if (Q.p0_formed || (Number(Q.p0_seats) || 0) > 0 || (Number(Q.p0_poll) || 0) > 0) {
    Q.p0_parent_relation = (Number(Q.p0_parent_relation) || 24) + 8;
    channels.push(Q.p0_name || "Partia Zero");
}
if (Q.far_right_split || (Number(Q.korona_seats) || 0) > 0 || (Number(Q.korona_poll) || 0) > 0) {
    Q.korona_parent_relation = (Number(Q.korona_parent_relation) || 20) + 6;
    channels.push("Korona");
}
Q.poland_inter_party_focus = channels.length
    ? "a narrow channel to " + channels.join(" and ")
    : "a narrow Konfederacja channel";
Q.ko_relation -= 3;
Q.p2050_relation -= 2;
Q.pis_relation -= 1;
Q.progressive_credibility -= 3;
Q.progressives_dissent += 7;
Q.razem_dissent += 4;
Q.far_right_agenda += 2;
Q.news_headline = channels.length
    ? "A narrow anti-privatisation vote opens channels to " + channels.join(" and ")
    : "A narrow anti-privatisation vote opens an argument across Lewica";
!}

One vote on public ownership does not erase the programmes of
[+ inter_party_radical_right_targets +]. Many inside Lewica regard even a
bounded channel as normalisation.

- #poland_card_finish


@breakaways
title: Rebuild channels with active Left breakaway parties
subtitle: Cost: 1 resource. Improve relations with all active Left breakaways and reduce fragmentation pressure.
view-if: barons_party_formed = 1 or social_patriot_party_formed = 1 or spring_party_formed = 1 or labor_party_formed = 1 or progressives_party_formed = 1 or razem_party_formed = 1 or pps_party_formed = 1 or tak_dla_rozwoju_party_formed = 1
choose-if: resources >= 1
unavailable-subtitle: Reconciliation talks require one resource.
on-arrival: {!
Q.resources -= 1;
const rebuilt = [];
if (Q.barons_party_formed) {
    Q.barons_party_relation += 8;
    rebuilt.push(Q.barons_party_name || "SLD breakaway");
}
if (Q.social_patriot_party_formed) {
    Q.social_patriot_party_relation += 8;
    rebuilt.push(Q.social_patriot_party_name || "Lewica Patriotyczna");
}
if (Q.spring_party_formed) {
    Q.spring_party_relation += 8;
    rebuilt.push(Q.spring_party_name || "Spring breakaway");
}
if (Q.labor_party_formed) {
    Q.labor_party_relation += 8;
    rebuilt.push(Q.labor_party_name || "Labour Left");
}
if (Q.progressives_party_formed) {
    Q.progressives_party_relation += 8;
    rebuilt.push(Q.progressives_party_name || "Young Left");
}
if (Q.razem_party_formed) {
    Q.razem_party_relation += 8;
    rebuilt.push(Q.razem_party_name || "Razem");
}
if (Q.pps_party_formed) {
    Q.pps_party_relation += 8;
    rebuilt.push(Q.pps_party_name || "PPS");
}
if (Q.tak_dla_rozwoju_party_formed) {
    Q.tak_rozwoj_parent_relation =
        (Number(Q.tak_rozwoj_parent_relation) || 30) + 8;
    rebuilt.push(Q.tak_rozwoj_party_name || "Tak! Dla Rozwoju");
}
Q.poland_inter_party_focus = rebuilt.length
    ? "Left-breakaway reconciliation"
    : "party autonomy";
Q.party_unity += 3;
Q.left_right_score -= 1;
Q.progressives_dissent -= 2;
Q.barons_dissent -= 2;
Q.news_headline = rebuilt.length
    ? "Lewica rebuilds channels with breakaway parties: " + rebuilt.join(", ")
    : "Lewica attempts breakaway reconciliation";
!}

Bridging channels with breakaways rarely produces instant reunification, but it
can stop avoidable seat leakage and reopen list talks before the campaign hardens.

- #poland_card_finish


@stand_alone
title: Lewica can stand alone for now
subtitle: Spend nothing and preserve autonomy; no relationship improves.
on-arrival: poland_inter_party_focus = "party autonomy"; party_unity += 1; media_capacity += 1; news_headline = "Lewica invests in its own line instead of another party relationship"

Whether because it cannot or will not, the party builds no external tie this
month.

- #poland_card_finish
