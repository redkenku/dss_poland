title: The Senate Docket
subtitle: A procedural fallback is always available; full negotiations refresh every three months.
new-page: true
is-card: true
tags: poland_party_card
view-if: month_actions < max_month_actions and poland_senate_docket_timer <= 0 and senate_left_seats > 0 and caretaker_government = 0 and formation_in_progress = 0
frequency: 80
card-image: img/poland/cards/senate-docket.webp
on-arrival: {!
Q.month_actions += 1;

if (!Number.isFinite(Number(Q.poland_senate_docket_timer))) {
    Q.poland_senate_docket_timer = 0;
}
Q.senate_docket_ready =
    Q.poland_senate_docket_timer <= 0 ? 1 : 0;
if (Q.senate_docket_ready) {
    Q.poland_senate_docket_timer = 3;
}

if (!Number.isFinite(Number(Q.senate_total))) Q.senate_total = 100;
if (!Number.isFinite(Number(Q.senate_pis_seats))) Q.senate_pis_seats = 48;
if (!Number.isFinite(Number(Q.senate_ko_seats))) Q.senate_ko_seats = 43;
if (!Number.isFinite(Number(Q.senate_psl_seats))) Q.senate_psl_seats = 3;
if (!Number.isFinite(Number(Q.senate_left_seats))) Q.senate_left_seats = 2;
if (!Number.isFinite(Number(Q.senate_independent_seats))) {
    Q.senate_independent_seats = 4;
}
if (!Number.isFinite(Number(Q.senate_cohesion))) Q.senate_cohesion = 52;
if (!Number.isFinite(Number(Q.senate_left_leverage))) {
    Q.senate_left_leverage = 18;
}
if (!Number.isFinite(Number(Q.senate_amendment_credit))) {
    Q.senate_amendment_credit = 0;
}

Q.senate_pending_bill_type = "ordinary";
Q.senate_pending_bill = "The government's current ordinary statute";
Q.senate_bill_topic =
    Q.year >= 2020
        ? "emergency administration and parliamentary oversight"
        : "institutional procedure and local-government safeguards";
!}
go-to: poland_senate.ordinary_bill
