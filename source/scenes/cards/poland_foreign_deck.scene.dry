title: Foreign Affairs
subtitle: Build a European position—or answer pressure from allies, markets and rivals.
is-deck: true
view-if: month_actions < max_month_actions and ((poland_european_campaign_timer <= 0 and eu_campaign_complete = 0) or (year >= 2020 and poland_brussels_pressure_timer <= 0) or (year >= 2020 and poland_berlin_pressure_timer <= 0) or (ukraine_invasion_event_done = 1 and poland_eastern_flank_timer <= 0) or (us_election_2020_done = 1 and poland_white_house_pressure_timer <= 0) or (year >= 2023 and poland_european_right_timer <= 0))
card-image: img/poland/cards/presidential-channel.webp

