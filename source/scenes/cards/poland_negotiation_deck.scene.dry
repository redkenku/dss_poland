title: Negotiate with Government
subtitle: Opposition bargains, crisis compacts and enforceable concessions.
is-deck: true
view-if: left_in_government = 0 and government_has_confidence = 1 and caretaker_government = 0 and month_actions < max_month_actions and (poland_oversight_bargain_timer <= 0 or (poland_crisis_compact_timer <= 0 and national_crisis_pressure >= 25) or (poland_palace_mediation_timer <= 0 and president_name = "Rafał Trzaskowski" and government_party = "pis" and national_crisis_pressure >= 25))
