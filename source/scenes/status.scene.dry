[? if status_budget_2019_done or status_budget_2020_done: <div class="ledger-note">In opposition this measures a common voting line, not control of state spending.</div></div>?]

[? if status_annual_budget_year > 0: <div class="ledger-section"><div class="ledger-title">Latest state budget</div><div class="ledger-row"><span>Vote</span><b>December [+ status_annual_budget_year +] · [+ status_annual_budget_result +]</b></div><div class="ledger-row"><span>[+ status_left_party_name +] posture</span><b>[+ status_annual_budget_posture +]</b></div>[? if status_annual_budget_concession != "No concession negotiated": <div class="ledger-row"><span>Negotiated clause</span><b>[+ status_annual_budget_concession +]</b></div>?][? if not annual_budget_left_cabinet_authority: <div class="ledger-row"><span>Priorities</span><b>[+ status_opposition_budget_priority_1 +] · [+ status_opposition_budget_priority_2 +]</b></div><div class="ledger-row"><span>Tactic</span><b>[+ status_opposition_budget_tactic +]</b></div>?][? if status_budget_deadline_active: <div class="ledger-subrow meter-warning">Constitutional deadline: [+ status_budget_deadline_label +].</div>?][? if status_opposition_budget_audit_pending: <div class="ledger-subrow">Performance audit due next year.</div>?][? if not status_opposition_budget_audit_pending and status_opposition_budget_audit_result != "No audit yet": <div class="ledger-subrow">Audit: [+ status_opposition_budget_audit_result +].</div>?]</div>?]

[? if status_confidence_mode != "None" or status_confidence_present > 0: <div class="ledger-section"><div class="ledger-title">Cabinet confidence</div><div class="ledger-row"><span>Procedure</span><b>[+ status_confidence_mode +]</b></div><div class="ledger-row"><span>Candidate</span><b>[+ status_confidence_candidate +]</b></div><div class="ledger-row"><span>Roll call</span><b>[+ status_confidence_yes +] yes · [+ status_confidence_no +] no · [+ status_confidence_abstain +] abstain</b></div><div class="ledger-row"><span>Threshold</span><b>[+ status_confidence_threshold +] of [+ status_confidence_present +]</b></div></div>?]

