[? if status_p0_visible: <div class="ledger-row"><span class="party"><b>[+ status_p0_short_name +]</b></span><span>[+ status_p0_leader +]</span></div><div class="ledger-subrow">[+ status_p0_ideology +]</div>?]
</div>

[? if status_left_breakaways_visible: <div class="ledger-section"><div class="ledger-title">Left successor and breakaway parties</div>?]
[? if barons_party_formed: <div class="faction-row"><span class="party party-sld"><b>[+ status_barons_party_name +]</b></span><span>[+ status_sld_breakaway_seats +] seats · [+ status_sld_breakaway_poll +]% · [+ status_barons_departed +] departed / [+ status_barons_retained +] stayed</span></div>?]
[? if social_patriot_party_formed: <div class="faction-row"><span class="party party-social-patriot"><b>[+ status_social_patriot_party_name +]</b></span><span>[+ status_social_patriot_seats +] seats · [+ status_social_patriot_poll +]% · [+ status_social_patriot_electoral_strategy +]</span></div>?]
[? if spring_party_formed: <div class="faction-row"><span class="party party-wiosna"><b>[+ status_spring_party_name +]</b></span><span>[+ status_spring_breakaway_seats +] seats · [+ status_spring_breakaway_poll +]% · [+ status_spring_departed +] departed / [+ status_spring_retained +] stayed</span></div>?]
[? if labor_party_formed: <div class="faction-row"><span class="party party-left-labor"><b>[+ status_labor_party_name +]</b></span><span>[+ status_labor_left_seats +] seats · [+ status_labor_left_poll +]% · [+ status_labor_departed +] departed / [+ status_labor_retained +] stayed</span></div>?]
[? if progressives_party_formed: <div class="faction-row"><span class="party party-progressive"><b>[+ status_progressives_party_name +]</b></span><span>[+ status_young_left_seats +] seats · [+ status_young_left_poll +]% · [+ status_progressives_departed +] departed / [+ status_progressives_retained +] stayed</span></div>?]
[? if razem_party_formed: <div class="faction-row"><span class="party party-razem"><b>[+ status_razem_party_name +]</b></span><span>[+ status_razem_party_seats +] seats · [+ status_razem_poll +]% · [+ status_razem_departed +] departed / [+ status_razem_retained +] stayed</span></div>?]
[? if pps_party_formed: <div class="faction-row"><span class="party party-pps"><b>[+ status_pps_party_name +]</b></span><span>[+ status_pps_party_seats +] seats · [+ status_pps_poll +]% · [+ status_pps_departed +] departed / [+ status_pps_retained +] stayed</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="faction-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span>[+ status_tak_rozwoj_seats +] seats · [+ status_tak_rozwoj_poll +]%</span></div>?]
[? if status_left_breakaways_visible and status_successor_ai_visible: <div class="ledger-subrow">Current strategies: [+ status_successor_ai_summary +]</div>?]
[? if status_left_breakaways_visible: </div>?]

[? if status_nowa_solidarnosc_visible or status_p0_visible or status_centrum_visible or status_rozwoj_visible or status_tak_rozwoj_visible or status_korona_visible: <div class="ledger-section"><div class="ledger-title">Emergent organisations</div>?]
