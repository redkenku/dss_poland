    "No hostile cohabitation"
);

Q.status_pis_poll = statusOneDecimal(Q.pis_poll, 43.6);
Q.status_ko_poll = statusOneDecimal(Q.ko_poll, 27.4);
Q.status_psl_poll = statusOneDecimal(Q.psl_poll, 8.6);
Q.status_konf_poll = statusOneDecimal(Q.konf_poll, 6.8);
Q.status_p2050_poll = statusOneDecimal(Q.p2050_poll, 0);
Q.status_p0_poll = statusOneDecimal(Q.p0_poll, 0);
Q.status_other_poll = statusOneDecimal(Q.other_poll, 1.0);
Q.status_nowa_solidarnosc_visible =
    Q.nowa_solidarnosc_formed && !Q.nowa_solidarnosc_dissolved ? 1 : 0;
const dynamicElectionParties = [
    "sld_breakaway",
    "social_patriot",
    "spring_breakaway",
    "labor_left",
    "young_left",
    "razem",
    "pps",
    "tak_rozwoj",
