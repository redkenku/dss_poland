    : [];
const statusParliamentaryPartyRecords = Array.isArray(
    Q.parliamentary_party_records
) ? Q.parliamentary_party_records : [];
const statusParliamentaryParty = function(id) {
    return statusParliamentaryPartyRecords.find(function(record) {
        return record && record.id == id;
    }) || {};
};
const statusKoIndependentParliamentarians = statusParliamentaryParty(
    "ko_independent_parliamentarians"
);
Q.status_ko_independent_sejm = statusWhole(
