<div class="poll-row"><span>Others</span><span>[+ status_other_poll +]%</span><span>list-specific</span></div>
<div class="ledger-subrow">[+ status_poll_sample +] likely voters · ±[+ status_poll_margin +] points · updated [+ status_poll_updated +]</div></div>

[? if status_pres_2020_visible: <div class="ledger-section"><div class="ledger-title">Presidential election</div><div class="ledger-row"><span>Phase</span><b>[+ status_pres_phase +]</b></div><div class="ledger-row"><span>[+ status_left_party_name +] candidate</span>[+ status_candidate_display +]</div>?]
[? if status_pres_2020_visible and status_pres_r1_complete: <div class="ledger-row"><span>First ballot</span><b>[+ status_pres_r1_leader +] · [+ status_pres_r1_runner +]</b></div><div class="ledger-subrow">[+ status_left_party_name +]: [+ status_pres_left_r1 +]%</div>?]
[? if status_pres_2020_visible and status_pres_r1_complete and not status_pres_runoff_complete: <div class="ledger-row"><span>Runoff</span><b>[+ status_pres_finalist_a +] · [+ status_pres_finalist_b +]</b></div><div class="ledger-subrow">Party line: [+ status_pres_endorsement +]</div>?]
[? if status_pres_2020_visible and status_pres_runoff_complete: <div class="ledger-row"><span>[+ status_pres_result_label +]</span><b>[+ status_pres_winner +]</b></div><div class="ledger-subrow">[+ status_pres_finalist_a +] [+ status_pres_runoff_a +]% · [+ status_pres_finalist_b +] [+ status_pres_runoff_b +]%</div>?]
[? if status_pres_2020_visible: </div>?]

[? if status_pres_2025_active: <div class="ledger-section"><div class="ledger-title">Presidential election</div><div class="ledger-row"><span>Phase</span><b>[+ status_pres_2025_phase +]</b></div><div class="ledger-row"><span>[+ status_left_party_name +] candidate</span>[+ status_pres_2025_candidate_display +]</div>?]
[? if status_pres_2025_active and status_pres_2025_done: <div class="ledger-row"><span>First ballot</span><b>[+ status_pres_2025_candidate_result +]%</b></div><div class="ledger-subrow">Total Left field: [+ status_pres_2025_field_result +]%</div><div class="ledger-row"><span>Runoff</span><b>[+ status_pres_2025_finalist_a +] · [+ status_pres_2025_finalist_b +]</b></div>?]
[? if status_pres_2025_active and status_pres_2025_runoff_done: <div class="ledger-row"><span>Winner</span><b>[+ status_pres_2025_winner +]</b></div>?]
[? if status_pres_2025_active and status_pres_2025_oath_visible: <div class="ledger-row"><span>Oath</span><b>[+ status_pres_2025_oath +]</b></div>?]
[? if status_pres_2025_active: </div>?]

<div class="ledger-section compact-party-list"><div class="ledger-title">Current Sejm</div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span></span><span>[+ status_pis_seats +] seats</span></div>
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span></span><span>[+ status_ko_seats +] seats</span></div>
<div class="poll-row"><span class="party party-lewica" data-short-label="Lewica" aria-label="Lewica"><b>[+ status_left_party_name +]</b></span><span></span><span>[+ status_left_seats +] seats</span></div>
[? if barons_party_formed: <div class="poll-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span></span><span>[+ status_sld_breakaway_seats +] seats</span></div>?]
[? if social_patriot_party_formed: <div class="poll-row"><span class="party party-social-patriot"><b>[+ social_patriot_party_name +]</b></span><span></span><span>[+ status_social_patriot_seats +] seats</span></div>?]
[? if spring_party_formed: <div class="poll-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span></span><span>[+ status_spring_breakaway_seats +] seats</span></div>?]
[? if labor_party_formed: <div class="poll-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span></span><span>[+ status_labor_left_seats +] seats</span></div>?]
[? if progressives_party_formed: <div class="poll-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span></span><span>[+ status_young_left_seats +] seats</span></div>?]
[? if razem_party_formed: <div class="poll-row"><span class="party party-razem"><b>Razem</b></span><span></span><span>[+ status_razem_party_seats +] seats</span></div>?]
[? if pps_party_formed: <div class="poll-row"><span class="party party-pps"><b>PPS</b></span><span></span><span>[+ status_pps_party_seats +] seats</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="poll-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span></span><span>[+ status_tak_rozwoj_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span></span><span>[+ status_psl_seats +] seats</span></div>
[? if status_p2050_visible: <div class="poll-row"><span class="party party-p2050"><b>Poland 2050</b></span><span></span><span>[+ status_p2050_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-konf" data-short-label="Konf." aria-label="Konfederacja"><b>Konfederacja</b></span><span></span><span>[+ status_konf_seats +] seats</span></div>
[? if status_p0_visible and status_p0_projection > 0: <div class="poll-row"><span><b>[+ p0_name +]</b></span><span></span><span>[+ status_p0_projection +] projected seats</span></div>?]
[? if unia_centrum_formed or status_centrum_seats > 0: <div class="poll-row"><span class="party party-centrum"><b>Unia Centrum</b></span><span></span><span>[+ status_centrum_seats +] seats</span></div>?]
[? if rozwoj_party_formed and not rozwoj_joined_left: <div class="poll-row"><span class="party party-rozwoj"><b>Rozwój Plus</b></span><span></span><span>[+ status_rozwoj_seats +] seats</span></div>?]
[? if far_right_split > 0: <div class="poll-row"><span class="party party-korona"><b>Korona</b></span><span></span><span>[+ status_korona_seats +] seats</span></div>?]
[? if status_other_seats > 0: <div class="poll-row"><span>Others</span><span></span><span>[+ status_other_seats +] seats</span></div>?]
</div>

<details class="ledger-disclosure"><summary>Voter blocs</summary>
<div class="ledger-section"><div class="faction-row"><span><b>Metropolitan liberals</b></span><span>[+ status_metropolitan_liberals_size +]% electorate · [+ status_left_party_name +] [+ status_metropolitan_liberals_left +]% · [+ status_metropolitan_liberals_leader +] leads</span></div>
<div class="faction-row"><span><b>Liberal professionals</b></span><span>[+ status_liberal_professionals_size +]% · [+ status_left_party_name +] [+ status_liberal_professionals_left +]% · [+ status_liberal_professionals_leader +] leads</span></div>
<div class="faction-row"><span><b>Public-service families</b></span><span>[+ status_public_service_families_size +]% · [+ status_left_party_name +] [+ status_public_service_families_left +]% · [+ status_public_service_families_leader +] leads</span></div>
<div class="faction-row"><span><b>Industrial and logistics</b></span><span>[+ status_industrial_logistics_size +]% · [+ status_left_party_name +] [+ status_industrial_logistics_left +]% · [+ status_industrial_logistics_leader +] leads</span></div>
<div class="faction-row"><span><b>Provincial welfare voters</b></span><span>[+ status_provincial_welfare_size +]% · [+ status_left_party_name +] [+ status_provincial_welfare_left +]% · [+ status_provincial_welfare_leader +] leads</span></div>
<div class="faction-row"><span><b>Rural localists</b></span><span>[+ status_rural_localists_size +]% · [+ status_left_party_name +] [+ status_rural_localists_left +]% · [+ status_rural_localists_leader +] leads</span></div>
<div class="faction-row"><span><b>Older welfare households</b></span><span>[+ status_older_welfare_households_size +]% · [+ status_left_party_name +] [+ status_older_welfare_households_left +]% · [+ status_older_welfare_households_leader +] leads</span></div>
<div class="faction-row"><span><b>Anti-establishment youth</b></span><span>[+ status_anti_establishment_youth_size +]% · [+ status_left_party_name +] [+ status_anti_establishment_youth_left +]% · [+ status_anti_establishment_youth_leader +] leads</span></div></div>
</details>

<details class="ledger-disclosure"><summary>Campaign posture</summary>
<div class="ledger-section"><div class="ledger-row"><span>Public trust</span><b>[+ status_public_trust_band +]</b></div>
<div class="ledger-row"><span>Labour credibility</span><b>[+ status_labor_credibility_band +]</b></div>
<div class="ledger-row"><span>Progressive credibility</span><b>[+ status_progressive_credibility_band +]</b></div>
<div class="ledger-row"><span>Feminist trust</span><b>[+ status_feminist_trust_band +]</b></div>
<div class="ledger-row"><span>Media operation</span><b>[+ status_media_capacity_band +]</b></div>
<div class="ledger-row"><span>Local network</span><b>[+ status_local_network_band +]</b></div></div>
</details>

@polls_archive
title: Indicators
new-page: true
is-special: true
call: status

= Indicators

<div class="ledger-section ledger-section-first"><div class="ledger-title">Likely-voter poll</div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span>[+ status_pis_poll +]%</span><span>[+ status_pis_projection +] projected</span></div>
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span>[+ status_ko_poll +]%</span><span>[+ status_ko_projection +] projected</span></div>
<div class="poll-row"><span class="party party-lewica"><b>[+ status_left_party_name +]</b></span><span>[+ status_left_poll +]%</span><span>[+ status_left_projection +] projected</span></div>
[? if status_nowa_solidarnosc_visible: <div class="poll-row"><span class="party party-nowa-solidarnosc"><b>Nowa Solidarność</b></span><span>&lt;0.1%</span><span>0 projected</span></div>?]
[? if barons_party_formed: <div class="poll-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span>[+ status_sld_breakaway_poll +]%</span><span>[+ status_sld_breakaway_projection +] projected</span></div>?]
[? if spring_party_formed: <div class="poll-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span>[+ status_spring_breakaway_poll +]%</span><span>[+ status_spring_breakaway_projection +] projected</span></div>?]
[? if labor_party_formed: <div class="poll-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span>[+ status_labor_left_poll +]%</span><span>[+ status_labor_left_projection +] projected</span></div>?]
[? if progressives_party_formed: <div class="poll-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span>[+ status_young_left_poll +]%</span><span>[+ status_young_left_projection +] projected</span></div>?]
[? if razem_party_formed: <div class="poll-row"><span class="party party-razem"><b>Razem</b></span><span>[+ status_razem_poll +]%</span><span>[+ status_razem_projection +] projected</span></div>?]
[? if pps_party_formed: <div class="poll-row"><span class="party party-pps"><b>PPS</b></span><span>[+ status_pps_poll +]%</span><span>[+ status_pps_projection +] projected</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="poll-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span>[+ status_tak_rozwoj_poll +]%</span><span>[+ status_tak_rozwoj_projection +] projected</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span>[+ status_psl_poll +]%</span><span>[+ status_psl_projection +] projected</span></div>
[? if status_p2050_visible: <div class="poll-row"><span class="party party-p2050"><b>PL2050</b></span><span>[+ status_p2050_poll +]%</span><span>[+ status_p2050_projection +] projected</span></div>?]
<div class="poll-row"><span class="party party-konf"><b>Konf.</b></span><span>[+ status_konf_poll +]%</span><span>[+ status_konf_projection +] projected</span></div>
[? if status_p0_visible: <div class="poll-row"><span><b>[+ p0_short_name +]</b></span><span>[+ status_p0_poll +]%</span><span>[+ status_p0_projection +] projected</span></div>?]
[? if unia_centrum_formed: <div class="poll-row"><span class="party party-centrum"><b>Unia Centrum</b></span><span>[+ status_centrum_poll +]%</span><span>[+ status_centrum_projection +] projected</span></div>?]
[? if rozwoj_party_formed and not rozwoj_joined_left: <div class="poll-row"><span class="party party-rozwoj"><b>Rozwój Plus</b></span><span>[+ status_rozwoj_poll +]%</span><span>[+ status_rozwoj_projection +] projected</span></div>?]
[? if far_right_split > 0: <div class="poll-row"><span class="party party-korona"><b>Korona</b></span><span>[+ status_korona_poll +]%</span><span>[+ status_korona_projection +] projected</span></div>?]
<div class="poll-row"><span>Others</span><span>[+ status_other_poll +]%</span><span>below/list-specific</span></div>
<div class="ledger-subrow">[+ status_poll_sample +] likely voters · ±[+ status_poll_margin +] points · updated [+ status_poll_updated +]</div></div>

[? if status_pres_visible: <div class="ledger-section"><div class="ledger-title">Presidential election</div>?]
[? if status_pres_visible: <div class="ledger-row"><span>Phase</span><b>[+ status_pres_phase +]</b></div>?]
[? if status_pres_visible: <div class="ledger-row"><span>Lewica candidate</span>[+ status_candidate_display +]</div>?]
[? if status_pres_r1_complete: <div class="ledger-row"><span>First ballot</span><b>[+ status_pres_r1_leader +] · [+ status_pres_r1_runner +]</b></div><div class="ledger-subrow">Lewica [+ status_pres_left_r1 +]%</div>?]
[? if status_pres_r1_complete and not status_pres_runoff_complete: <div class="ledger-row"><span>Runoff</span><b>[+ status_pres_finalist_a +] · [+ status_pres_finalist_b +]</b></div><div class="ledger-subrow">Left line: [+ status_pres_endorsement +]</div>?]
[? if status_pres_runoff_complete: <div class="ledger-row"><span>[+ status_pres_result_label +]</span><b>[+ status_pres_winner +]</b></div><div class="ledger-subrow">[+ status_pres_finalist_a +] [+ status_pres_runoff_a +]% · [+ status_pres_finalist_b +] [+ status_pres_runoff_b +]%</div>?]
[? if status_trz_route_visible: <div class="ledger-row"><span>Certification</span><b>[+ status_trz_inauguration +]</b></div>?]
[? if status_trz_route_visible and trz_oath_crisis_launched: <div class="ledger-subrow">[+ status_trz_oath_crisis +]</div>?]
[? if status_trz_route_visible and trz_inaugurated: <div class="ledger-row"><span>War of the Powers</span><b>[+ status_trz_temperature +] pressure · [+ status_trz_vetoes +] vetoes</b></div><div class="ledger-subrow">United Right fracture [+ status_trz_fragmentation +] · right backlash [+ status_trz_backlash +]</div><div class="ledger-subrow">Abortion: [+ status_trz_abortion +] · marriage: [+ status_trz_marriage +]</div>?]
[? if status_pres_visible: </div>?]

<div class="ledger-section"><div class="ledger-title">Current Sejm</div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span></span><span>[+ status_pis_seats +] seats</span></div>
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span></span><span>[+ status_ko_seats +] seats</span></div>
<div class="poll-row"><span class="party party-lewica"><b>[+ status_left_party_name +]</b></span><span></span><span>[+ status_left_seats +] seats</span></div>
[? if barons_party_formed: <div class="poll-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span></span><span>[+ status_sld_breakaway_seats +] seats</span></div>?]
[? if spring_party_formed: <div class="poll-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span></span><span>[+ status_spring_breakaway_seats +] seats</span></div>?]
[? if labor_party_formed: <div class="poll-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span></span><span>[+ status_labor_left_seats +] seats</span></div>?]
[? if progressives_party_formed: <div class="poll-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span></span><span>[+ status_young_left_seats +] seats</span></div>?]
[? if razem_party_formed: <div class="poll-row"><span class="party party-razem"><b>Razem</b></span><span></span><span>[+ status_razem_party_seats +] seats</span></div>?]
[? if pps_party_formed: <div class="poll-row"><span class="party party-pps"><b>PPS</b></span><span></span><span>[+ status_pps_party_seats +] seats</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="poll-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span></span><span>[+ status_tak_rozwoj_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span></span><span>[+ status_psl_seats +] seats</span></div>
[? if status_p2050_visible: <div class="poll-row"><span class="party party-p2050"><b>PL2050</b></span><span></span><span>[+ status_p2050_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-konf"><b>Konf.</b></span><span></span><span>[+ status_konf_seats +] seats</span></div>
[? if unia_centrum_formed or status_centrum_seats > 0: <div class="poll-row"><span class="party party-centrum"><b>Unia Centrum</b></span><span></span><span>[+ status_centrum_seats +] seats</span></div>?]
[? if rozwoj_party_formed and not rozwoj_joined_left: <div class="poll-row"><span class="party party-rozwoj"><b>Rozwój Plus</b></span><span></span><span>[+ status_rozwoj_seats +] seats</span></div>?]
[? if far_right_split > 0: <div class="poll-row"><span class="party party-korona"><b>Korona</b></span><span></span><span>[+ status_korona_seats +] seats</span></div>?]
<div class="poll-row"><span>Others</span><span></span><span>[+ status_other_seats +] seat</span></div>
</div>

<div class="ledger-section"><div class="ledger-title">Projected governing arithmetic</div>
<div class="faction-row"><span>KO · democratic centre · Left parties</span><span>[+ status_coalition_democratic_seats +] seats · compatibility [+ status_coalition_democratic_score +]/100</span></div>
<div class="faction-row"><span>KO · PL2050 · PSL</span><span>[+ status_coalition_center_seats +] · [+ status_coalition_center_score +]/100</span></div>
<div class="faction-row"><span>PiS · Konfederacja</span><span>[+ status_coalition_right_seats +] · [+ status_coalition_right_score +]/100</span></div>
<div class="faction-row"><span>PiS · PSL</span><span>[+ status_coalition_pis_psl_seats +] · [+ status_coalition_pis_psl_score +]/100</span></div></div>

<div class="ledger-section"><div class="ledger-title">Mutually exclusive voter blocs</div>
<div class="faction-row"><span><b>Metropolitan liberals</b></span><span>[+ status_metropolitan_liberals_size +]% electorate · Lewica [+ status_metropolitan_liberals_left +]% (prior [+ status_metropolitan_liberals_left_previous +]%) · [+ status_metropolitan_liberals_turnout +]% turnout · [+ status_metropolitan_liberals_leader +] leads</span></div>
<div class="faction-row"><span><b>Liberal professionals</b></span><span>[+ status_liberal_professionals_size +]% · Lewica [+ status_liberal_professionals_left +]% (prior [+ status_liberal_professionals_left_previous +]%) · [+ status_liberal_professionals_turnout +]% turnout · [+ status_liberal_professionals_leader +] leads</span></div>
<div class="faction-row"><span><b>Public-service families</b></span><span>[+ status_public_service_families_size +]% · Lewica [+ status_public_service_families_left +]% (prior [+ status_public_service_families_left_previous +]%) · [+ status_public_service_families_turnout +]% turnout · [+ status_public_service_families_leader +] leads</span></div>
<div class="faction-row"><span><b>Industrial and logistics</b></span><span>[+ status_industrial_logistics_size +]% · Lewica [+ status_industrial_logistics_left +]% (prior [+ status_industrial_logistics_left_previous +]%) · [+ status_industrial_logistics_turnout +]% turnout · [+ status_industrial_logistics_leader +] leads</span></div>
<div class="faction-row"><span><b>Provincial welfare voters</b></span><span>[+ status_provincial_welfare_size +]% · Lewica [+ status_provincial_welfare_left +]% (prior [+ status_provincial_welfare_left_previous +]%) · [+ status_provincial_welfare_turnout +]% turnout · [+ status_provincial_welfare_leader +] leads</span></div>
<div class="faction-row"><span><b>Rural localists</b></span><span>[+ status_rural_localists_size +]% · Lewica [+ status_rural_localists_left +]% (prior [+ status_rural_localists_left_previous +]%) · [+ status_rural_localists_turnout +]% turnout · [+ status_rural_localists_leader +] leads</span></div>
<div class="faction-row"><span><b>Older welfare households</b></span><span>[+ status_older_welfare_households_size +]% · Lewica [+ status_older_welfare_households_left +]% (prior [+ status_older_welfare_households_left_previous +]%) · [+ status_older_welfare_households_turnout +]% turnout · [+ status_older_welfare_households_leader +] leads</span></div>
<div class="faction-row"><span><b>Anti-establishment youth</b></span><span>[+ status_anti_establishment_youth_size +]% · Lewica [+ status_anti_establishment_youth_left +]% (prior [+ status_anti_establishment_youth_left_previous +]%) · [+ status_anti_establishment_youth_turnout +]% turnout · [+ status_anti_establishment_youth_leader +] leads</span></div>
<div class="ledger-note">These eight groups are the complete electorate and sum to 100. The Lewica share is recalculated after every month from choices, rival actions, issue fit and turnout.</div></div>

<div class="ledger-section"><div class="ledger-title">Campaign capacity</div>
<div class="ledger-row"><span>Public trust</span><b>[+ status_public_trust +]/100</b></div>
<div class="ledger-row"><span>Labour credibility</span><b>[+ status_labor_credibility +]/100</b></div>
<div class="ledger-row"><span>Progressive credibility</span><b>[+ status_progressive_credibility +]/100</b></div>
<div class="ledger-row"><span>Feminist trust</span><b>[+ status_feminist_trust +]/100</b></div>
<div class="ledger-row"><span>Media capacity</span><b>[+ status_media_capacity +]/100</b></div>
<div class="ledger-row"><span>Local network</span><b>[+ status_local_network +]/100</b></div></div>

[? if status_pres_feedback_visible: <div class="ledger-section"><div class="ledger-title">Presidential performance feedback</div>
<div class="ledger-row"><span>[+ status_pres_feedback_source +]</span><b>[+ status_pres_feedback_band +]</b></div>
