title: Polish Red Autumn status
new-page: true
is-special: true
on-arrival: {!
const statusNumber = function(value, fallback) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
};
const statusText = function(value, fallback) {
    return typeof value === "string" && value.trim().length
        ? value
        : fallback;
};
const statusOneDecimal = function(value, fallback) {
    return Math.round(statusNumber(value, fallback) * 10) / 10;
};

// The sidebar owns display-only aliases. It deliberately does not normalise or
// repair substantive campaign state merely because the player changed tabs.
Q.status_started = Q.started ? 1 : 0;
Q.status_date = statusText(Q.date_label, "October 2019");
Q.status_headline = statusText(
    Q.news_headline,
    "The Left prepares its return to the Sejm"
);
Q.status_difficulty = statusText(Q.difficulty_name, "Precarious");
Q.status_position = statusText(Q.position, "Parliamentary opposition");
Q.status_project = statusText(
    Q.left_project,
    "Lewica parliamentary alliance"
);
Q.status_candidate = statusText(Q.presidential_candidate, "Undecided");
Q.status_pres_phase = statusText(Q.pres_2020_phase, "Not begun");
Q.status_pres_visible =
    Q.pres_2020_active || Q.pres_first_round_complete ? 1 : 0;
Q.status_pres_r1_complete = Q.pres_first_round_complete ? 1 : 0;
Q.status_pres_runoff_complete = Q.pres_runoff_complete ? 1 : 0;
Q.status_pres_left_r1 = statusOneDecimal(Q.presidential_result, 0);
Q.status_pres_r1_leader = statusText(Q.pres_r1_leader_name, "—");
Q.status_pres_r1_runner = statusText(Q.pres_r1_runner_name, "—");
Q.status_pres_finalist_a = statusText(Q.pres_finalist_a_name, "—");
Q.status_pres_finalist_b = statusText(Q.pres_finalist_b_name, "—");
Q.status_pres_runoff_a = statusOneDecimal(Q.pres_runoff_display_a, 0);
Q.status_pres_runoff_b = statusOneDecimal(Q.pres_runoff_display_b, 0);
Q.status_pres_winner = statusText(Q.pres_runoff_winner_name, "—");
Q.status_pres_feedback_visible =
    Q.pres_feedback_active || Q.pres_first_round_complete ||
    Q.pres_2025_round_one_done ? 1 : 0;
Q.status_pres_feedback_source = statusText(
    Q.pres_feedback_source,
    "No presidential verdict"
);
Q.status_pres_feedback_band = Q.pres_2025_round_one_done
    ? statusText(Q.pres_2025_candidate_band, "Not yet judged")
    : statusText(Q.pres_performance_band, "Not yet judged");
Q.status_pres_feedback_consideration = statusOneDecimal(
    Q.pres_feedback_consideration_current,
    0
);
Q.status_pres_feedback_turnout = statusOneDecimal(
    Q.pres_feedback_turnout_current,
    0
);
Q.status_pres_feedback_months = Math.max(
    0,
    Math.round(statusNumber(Q.pres_feedback_months_remaining, 0))
);
Q.status_pres_feedback_duration = Math.max(
    0,
    Math.round(statusNumber(Q.pres_feedback_duration, 0))
);
Q.status_pres_feedback_leadership = Math.round(
    statusNumber(Q.pres_feedback_leadership_pressure, 0)
);
Q.status_pres_feedback_tactical = statusOneDecimal(
    Q.pres_feedback_tactical_current,
    0
);
Q.status_pres_feedback_certainty = Math.round(
    statusNumber(Q.pres_feedback_base_certainty, 0)
);
Q.status_pres_2025_done = Q.pres_2025_round_one_done ? 1 : 0;
Q.status_pres_2025_candidate = statusText(
    Q.pres_2025_left_candidate,
    "Undecided"
);
Q.status_pres_2025_candidate_result = statusOneDecimal(
    Q.pres_2025_player_result,
    0
);
Q.status_pres_2025_field_result = statusOneDecimal(
    Q.pres_2025_field_result,
    0
);
Q.status_pres_2025_field_band = statusText(
    Q.pres_2025_field_band,
    "Not yet judged"
);
Q.status_pres_2025_leadership_defeat =
    Q.pres_2025_leadership_defeat ? 1 : 0;
Q.status_pres_result_label = Q.trz_blocked
    ? "Certified winner"
    : (Q.trzaskowski_won && !Q.trz_inaugurated
        ? "President-elect"
        : "President");
Q.status_trz_route_visible = Q.trzaskowski_won ? 1 : 0;
Q.status_trz_inauguration = statusText(
    Q.trz_inauguration_status,
    "Certification pending"
);
Q.status_trz_temperature = Math.round(
    statusNumber(Q.trz_cohabitation_temperature, 0)
);
Q.status_trz_backlash = Math.round(
    statusNumber(Q.trz_right_backlash, 0)
);
Q.status_trz_fragmentation = Math.round(
    statusNumber(Q.trz_right_fragmentation, 0)
);
Q.status_trz_vetoes = Math.round(statusNumber(Q.trz_vetoes, 0));
Q.status_trz_abortion = statusText(
    Q.trz_abortion_veto_policy,
    "No commitment"
);
Q.status_trz_marriage = statusText(
    Q.trz_marriage_veto_policy,
    "No commitment"
);
Q.status_pres_endorsement = statusText(
    Q.pres_runoff_endorsement,
    "Not chosen"
);
Q.status_budget_strategy = statusText(Q.budget_strategy, "Unsettled");
Q.status_next_budget = statusText(Q.next_budget_label, "December 2019");

Q.status_resources = statusNumber(Q.resources, 0);
Q.status_party_income = statusNumber(Q.party_income, 0);
Q.status_member_dues = statusNumber(Q.member_dues, 2);
Q.status_seat_subvention = statusNumber(Q.seat_subvention, 0);
Q.status_subvention_seats = statusNumber(Q.seat_subvention_seats, 0);
Q.status_last_annual_payout = statusNumber(Q.last_annual_payout, 0);
Q.status_last_annual_payout_label = statusText(
    Q.last_annual_payout_label,
    "No annual payout yet"
);
Q.status_fundraising_timer = Math.max(
    0,
    statusNumber(Q.emergency_fundraising_timer, 0)
);
Q.status_budget = statusNumber(Q.budget, 0);
Q.status_budget_authority = statusText(
    Q.budget_authority,
    "Opposition — no state spending authority"
);
Q.status_month_actions = statusNumber(Q.month_actions, 0);
Q.status_max_month_actions = statusNumber(Q.max_month_actions, 1);
Q.status_month_actions_remaining = Math.max(
    0,
    Q.status_max_month_actions - Q.status_month_actions
);
Q.status_advisor_timer = Math.max(
    0,
    statusNumber(Q.advisor_action_timer, 0)
);
Q.status_reshuffle_timer = Math.max(
    0,
    statusNumber(Q.leadership_reshuffle_timer, 0)
);
Q.status_advisors = statusNumber(Q.n_advisors, 3);
const activeAdvisorNames = [];
const advisorStatusRoster = [
    ["czarzasty", "Włodzimierz Czarzasty"],
    ["biedron", "Robert Biedroń"],
    ["zandberg", "Adrian Zandberg"],
    ["dziemianowicz_bak", "Agnieszka Dziemianowicz-Bąk"],
    ["zukowska", "Anna-Maria Żukowska"],
    ["kotula", "Katarzyna Kotula"],
    ["biejat", "Magdalena Biejat"],
    ["wieczorek", "Dariusz Wieczorek"],
    ["gawkowski", "Krzysztof Gawkowski"],
    ["nowicka", "Wanda Nowicka"],
    ["zawisza", "Marcelina Zawisza"],
    ["matysiak", "Paulina Matysiak"]
];
for (const advisor of advisorStatusRoster) {
    if (Number(Q[advisor[0] + "_advisor"]) === 1) {
        activeAdvisorNames.push(advisor[1]);
    }
}
Q.status_active_advisors = activeAdvisorNames.length
    ? activeAdvisorNames.join(" · ")
    : "Vacant bureau";
Q.status_barons_advisors = statusNumber(Q.barons_advisor_count, 0);
Q.status_spring_advisors = statusNumber(Q.spring_advisor_count, 0);
Q.status_labor_advisors = statusNumber(Q.labor_advisor_count, 0);
Q.status_progressives_advisors =
    statusNumber(Q.progressives_advisor_count, 0);
Q.status_razem_advisors = statusNumber(Q.razem_advisor_count, 0);
Q.status_pps_advisors = statusNumber(Q.pps_advisor_count, 0);
Q.status_leadership_actions = statusNumber(
    Q.leadership_actions_taken,
    0
);
Q.status_party_unity = Math.round(statusNumber(Q.party_unity, 58));
Q.status_left_poll = statusOneDecimal(Q.left_poll, 12.6);
Q.status_left_seats = statusNumber(Q.left_seats, 49);
Q.status_public_trust = Math.round(statusNumber(Q.public_trust, 43));
Q.status_media_capacity = Math.round(statusNumber(Q.media_capacity, 16));
Q.status_local_network = Math.round(statusNumber(Q.local_network, 42));

Q.status_president = statusText(Q.president_name, "Andrzej Duda");
Q.status_prime_minister = statusText(
    Q.prime_minister,
    "Mateusz Morawiecki"
);
Q.status_government = statusText(
    Q.government_name,
    "PiS–United Right majority"
);
Q.status_sejm_speaker = statusText(Q.sejm_speaker, "Elżbieta Witek");
if (Q.caretaker_government) {
    Q.status_left_role = Q.left_in_government
        ? "Caretaker cabinet — executive action suspended"
        : "Outside the caretaker cabinet";
} else if (Q.left_in_government) {
    Q.status_left_role =
        "Government — ministers and collective cabinet responsibility";
} else if (
    String(Q.position || "").toLowerCase().includes("confidence")
) {
    Q.status_left_role =
        "Outside government — confidence-and-supply only";
} else {
    Q.status_left_role =
        "Opposition — no ministers or state-budget authority";
}
const primeMinisterParty = function(name, government) {
    const combined = (name + " " + government).toLowerCase();
    if (
        combined.includes("morawiecki") ||
        combined.includes("szydło") ||
        combined.includes("szydlo") ||
        combined.includes("czarnek") ||
        combined.includes("pis")
    ) {
        return "pis";
    }
    if (
        combined.includes("tusk") ||
        combined.includes("trzaskowski") ||
        combined.includes("nowacka") ||
        combined.includes("sikorski") ||
        combined.includes("kierwiński") ||
        combined.includes("kierwinski") ||
        combined.includes("ko-led")
    ) {
        return "ko";
    }
    if (
        combined.includes("dziemianowicz-bąk") ||
        combined.includes("dziemianowicz-bak") ||
        combined.includes("biedroń") ||
        combined.includes("biedron") ||
        combined.includes("zandberg") ||
        combined.includes("lewica")
    ) {
        return "lewica";
    }
    if (
        combined.includes("kosiniak-kamysz") ||
        combined.includes("psl")
    ) {
        return "psl";
    }
    if (
        combined.includes("hołownia") ||
        combined.includes("holownia") ||
        combined.includes("poland 2050")
    ) {
        return "p2050";
    }
    return "other";
};
Q.status_prime_minister_party =
    typeof Q.government_party == "string" && Q.government_party.length
        ? Q.government_party
        : primeMinisterParty(
            Q.status_prime_minister,
            Q.status_government
        );
Q.status_government_party = Q.status_prime_minister_party;
Q.status_negotiation_leverage = Math.round(
    statusNumber(Q.negotiation_leverage, 0)
);
Q.status_crisis_pressure = Math.round(
    statusNumber(Q.national_crisis_pressure, 0)
);
Q.status_government_hostility = Math.round(
    statusNumber(Q.government_negotiation_hostility, 50)
);
Q.status_negotiation_forecast = statusText(
    Q.negotiation_forecast,
    "No government negotiation forecast"
);
Q.status_negotiation_last = statusText(
    Q.negotiation_last_result,
    "No negotiation attempted"
);
Q.status_negotiation_successes = statusNumber(
    Q.negotiation_successes,
    0
);
Q.status_pis_cohabitation_stress = Math.round(
    statusNumber(Q.pis_cohabitation_stress, 0)
);
Q.status_pis_cohabitation_rally = Math.round(
    statusNumber(Q.pis_cohabitation_rally, 0)
);
Q.status_pis_cohabitation_state = statusText(
    Q.pis_cohabitation_state,
    "No hostile cohabitation"
);

Q.status_pis_poll = statusOneDecimal(Q.pis_poll, 43.6);
Q.status_ko_poll = statusOneDecimal(Q.ko_poll, 27.4);
Q.status_psl_poll = statusOneDecimal(Q.psl_poll, 8.6);
Q.status_konf_poll = statusOneDecimal(Q.konf_poll, 6.8);
Q.status_p2050_poll = statusOneDecimal(Q.p2050_poll, 0);
Q.status_other_poll = statusOneDecimal(Q.other_poll, 1.0);
const dynamicElectionParties = [
    "sld_breakaway",
    "spring_breakaway",
    "labor_left",
    "young_left",
    "razem",
    "pps",
    "centrum",
    "rozwoj",
    "korona",
    "ko_splinter"
];
for (const party of dynamicElectionParties) {
    Q["status_" + party + "_poll"] =
        statusOneDecimal(Q[party + "_poll"], 0);
    Q["status_" + party + "_intent"] =
        statusOneDecimal(Q[party + "_vote_intent"], 0);
    Q["status_" + party + "_projection"] =
        statusNumber(Q[party + "_projected_seats"], 0);
}
Q.status_sld_breakaway_seats =
    statusNumber(Q.sld_breakaway_seats, 0);
Q.status_spring_breakaway_seats =
    statusNumber(Q.spring_breakaway_seats, 0);
Q.status_labor_left_seats = statusNumber(Q.labor_left_seats, 0);
Q.status_young_left_seats = statusNumber(Q.young_left_seats, 0);
Q.status_razem_party_seats = statusNumber(Q.razem_party_seats, 0);
Q.status_pps_party_seats = statusNumber(Q.pps_party_seats, 0);
Q.status_centrum_seats = statusNumber(Q.centrum_seats, 0);
Q.status_rozwoj_seats = statusNumber(Q.rozwoj_seats, 0);
Q.status_korona_seats = statusNumber(Q.korona_seats, 0);
Q.status_ko_splinter_seats = statusNumber(Q.ko_splinter_seats, 0);
Q.status_porozumienie_seats = statusNumber(Q.porozumienie_seats, 0);
Q.status_pis_seats = statusNumber(Q.pis_seats, 235);
Q.status_ko_seats = statusNumber(Q.ko_seats, 134);
Q.status_psl_seats = statusNumber(Q.psl_seats, 30);
Q.status_konf_seats = statusNumber(Q.konf_seats, 11);
Q.status_p2050_seats = statusNumber(Q.p2050_seats, 0);
Q.status_other_seats = statusNumber(Q.other_seats, 1);
Q.status_left_intent = statusOneDecimal(Q.left_vote_intent, 12.6);
Q.status_pis_intent = statusOneDecimal(Q.pis_vote_intent, 43.6);
Q.status_ko_intent = statusOneDecimal(Q.ko_vote_intent, 27.4);
Q.status_psl_intent = statusOneDecimal(Q.psl_vote_intent, 8.6);
Q.status_konf_intent = statusOneDecimal(Q.konf_vote_intent, 6.8);
Q.status_p2050_intent = statusOneDecimal(Q.p2050_vote_intent, 0);
Q.status_other_intent = statusOneDecimal(Q.other_vote_intent, 1.0);
Q.status_left_projection = statusNumber(Q.left_projected_seats, 49);
Q.status_pis_projection = statusNumber(Q.pis_projected_seats, 235);
Q.status_ko_projection = statusNumber(Q.ko_projected_seats, 134);
Q.status_psl_projection = statusNumber(Q.psl_projected_seats, 30);
Q.status_konf_projection = statusNumber(Q.konf_projected_seats, 11);
Q.status_p2050_projection = statusNumber(
    Q.p2050_projected_seats,
    0
);
Q.status_other_projection = statusNumber(Q.other_projected_seats, 0);
Q.status_poll_sample = statusNumber(Q.poll_sample_size, 1400);
Q.status_poll_margin = statusOneDecimal(Q.poll_margin_error, 2.6);
Q.status_poll_updated = statusText(Q.poll_last_updated, "Opening baseline");
Q.status_poll_total = statusOneDecimal(
    Q.status_left_poll +
        Q.status_pis_poll +
        Q.status_ko_poll +
        Q.status_psl_poll +
        Q.status_konf_poll +
        Q.status_p2050_poll +
        Q.status_other_poll +
        dynamicElectionParties.reduce(function(total, party) {
            return total + Q["status_" + party + "_poll"];
        }, 0),
    100
);
Q.status_p2050_visible =
    Q.p2050_emerged || Q.status_p2050_poll > 0 ? 1 : 0;

Q.status_pis_leader = statusText(Q.pis_leader, "Jarosław Kaczyński");
Q.status_ko_leader = statusText(Q.ko_leader, "Grzegorz Schetyna");
Q.status_psl_leader = statusText(
    Q.psl_leader,
    "Władysław Kosiniak-Kamysz"
);
Q.status_konf_leader = statusText(
    Q.konf_leader,
    "Kulesza–Korwin–Braun"
);
Q.status_p2050_leader = statusText(
    Q.p2050_leader,
    "Movement not yet formed"
);
Q.status_pis_ideology = statusText(
    Q.pis_ideology,
    "National-conservative · welfare-statist"
);
Q.status_ko_ideology = statusText(
    Q.ko_ideology,
    "Broad-tent liberal · pro-European"
);
Q.status_psl_ideology = statusText(
    Q.psl_ideology,
    "Agrarian centrist · socially cautious"
);
Q.status_konf_ideology = statusText(
    Q.konf_ideology,
    "Radical-right federation"
);
Q.status_p2050_ideology = statusText(
    Q.p2050_ideology,
    "Centrist institutionalism"
);
const leftPoleIntent = statusNumber(
    Q.left_vote_intent,
    statusNumber(Q.left_poll, 12.6)
);
const konfPoleIntent = statusNumber(
    Q.konf_vote_intent,
    statusNumber(Q.konf_poll, 6.8)
);
let fallbackPartySystemClimate =
    "The centre is balancing between social and radical-right pressure";
if (leftPoleIntent >= konfPoleIntent + 4) {
    fallbackPartySystemClimate =
        "The Left is setting the competitive agenda";
} else if (konfPoleIntent >= leftPoleIntent + 4) {
    fallbackPartySystemClimate =
        "Konfederacja is pulling the party system to the right";
}
Q.status_party_system_climate = statusText(
    Q.party_system_climate,
    fallbackPartySystemClimate
);
const civicPatriotism = statusNumber(Q.civic_patriotism, 10);
const farRightStreetCapacity = statusNumber(
    Q.far_right_street_capacity,
    25
);
Q.status_independence_field =
    civicPatriotism >= farRightStreetCapacity + 8
        ? "A civic-patriotic counter-tradition is taking root"
        : (
            farRightStreetCapacity >= civicPatriotism + 15
                ? "The radical right dominates the Independence Day street"
                : (
                    farRightStreetCapacity >= civicPatriotism + 5
                        ? "The radical right retains the street advantage"
                        : "Independence Day remains politically contested"
                )
        );
const wingFallbacks = {
    pis: "Social-solidarist apparatus",
    ko: "Broad-tent liberal centre",
    psl: "Agrarian and local-government brokers",
    konf: "Libertarian-nationalist federation",
    p2050: "Institutional reformers"
};
for (const party of ["pis", "ko", "psl", "konf", "p2050"]) {
    Q["status_" + party + "_org_resources"] = statusNumber(
        Q[party + "_org_resources"],
        0
    );
    Q["status_" + party + "_org_income"] = statusNumber(
        Q[party + "_org_income"],
        0
    );
    Q["status_" + party + "_dominant_wing"] = statusText(
        Q[party + "_dominant_wing"],
        wingFallbacks[party]
    );
    Q["status_" + party + "_ideology_drift"] = statusText(
        Q[party + "_ideology_drift"],
        "No clear ideological drift"
    );
    Q["status_" + party + "_ai_headline"] = statusText(
        Q[party + "_ai_headline"],
        "No background action"
    );
}
Q.status_rival_month_headline = statusText(
    Q.rival_month_headline,
    "Rival parties have not acted yet"
);
Q.status_rival_coalition_signal = statusText(
    Q.rival_coalition_signal,
    "Coalition channels are still being mapped"
);
Q.status_rival_group_month_action = statusText(
    Q.rival_group_month_action,
    "No component organisation has acted yet"
);
const statusRivalGroupIds = [
    "pis_apparatus", "porozumienie", "solidarna", "morawiecki",
    "pis_welfare", "pis_security", "pis_culture", "rozwoj_plus",
    "po", "nowoczesna", "ipl", "greens", "ko_party", "ko_splinter"
];
for (const id of statusRivalGroupIds) {
    const record = (Q.rival_group_records || []).find(function(candidate) {
        return candidate && candidate.id == id;
    }) || {};
    Q["status_rival_" + id + "_name"] = statusText(record.name, id);
    Q["status_rival_" + id + "_legal"] = statusText(
        record.legal_status,
        "unrecorded"
    );
    Q["status_rival_" + id + "_active"] = record.active ? 1 : 0;
    Q["status_rival_" + id + "_org"] = statusNumber(
        record.organisation,
        0
    );
    Q["status_rival_" + id + "_cohesion"] = statusNumber(
        record.cohesion,
        0
    );
    Q["status_rival_" + id + "_relation"] = statusNumber(
        record.relation,
        0
    );
    Q["status_rival_" + id + "_mps"] = statusNumber(
        record.mp_count,
        0
    );
    Q["status_rival_" + id + "_seats"] = statusNumber(
        record.exclusive_seats,
        0
    );
}

Q.status_barons_strength = statusNumber(Q.barons_strength, 28);
Q.status_barons_dissent = statusNumber(Q.barons_dissent, 12);
Q.status_spring_strength = statusNumber(Q.spring_strength, 20);
Q.status_spring_dissent = statusNumber(Q.spring_dissent, 16);
Q.status_labor_strength = statusNumber(Q.labor_strength, 14);
Q.status_labor_dissent = statusNumber(Q.labor_dissent, 18);
Q.status_progressives_strength = statusNumber(
    Q.progressives_strength,
    18
);
Q.status_progressives_dissent = statusNumber(
    Q.progressives_dissent,
    14
);
Q.status_razem_strength = statusNumber(Q.razem_strength, 20);
Q.status_razem_dissent = statusNumber(Q.razem_dissent, 28);
Q.status_pps_strength = statusNumber(Q.pps_strength, 2);
Q.status_pps_dissent = statusNumber(Q.pps_dissent, 20);
Q.status_barons_active = Q.barons_active ? 1 : 0;
Q.status_spring_active = Q.spring_active ? 1 : 0;
Q.status_labor_active = Q.labor_active ? 1 : 0;
Q.status_progressives_active = Q.progressives_active ? 1 : 0;
Q.status_razem_active = Q.razem_active ? 1 : 0;
Q.status_pps_active = Q.pps_active ? 1 : 0;
Q.status_barons_name = statusText(Q.barons_name, "SLD organisation");
Q.status_spring_name = statusText(Q.spring_name, "Wiosna");
Q.status_labor_name = statusText(Q.labor_name, "Labour Left");
Q.status_progressives_name = statusText(
    Q.progressives_name,
    "Younger progressives"
);
Q.status_razem_name = statusText(Q.razem_name, "Razem");
Q.status_pps_name = statusText(Q.pps_name, "PPS");
for (const caucus of [
    "barons", "spring", "labor", "progressives", "razem", "pps"
]) {
    Q["status_" + caucus + "_escalation"] = statusText(
        Q[caucus + "_escalation_label"],
        "Contained bargaining"
    );
    Q["status_" + caucus + "_defections"] = statusNumber(
        Q[caucus + "_individual_defections"],
        0
    );
    Q["status_" + caucus + "_retained"] = statusNumber(
        Q[caucus + "_mp_retained"],
        Q[caucus + "_estimated_mps"]
    );
    Q["status_" + caucus + "_departed"] = statusNumber(
