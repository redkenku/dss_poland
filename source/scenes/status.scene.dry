    ["tak_rozwoj", Q.status_tak_rozwoj_party_name, !!Q.tak_dla_rozwoju_party_formed],
    ["korona", "Korona", !!Q.far_right_split],
    ["sld_breakaway", Q.barons_party_name || "SLD breakaway", !!Q.barons_party_formed],
    ["social_patriot", Q.social_patriot_party_name || "Lewica Patriotyczna", !!Q.social_patriot_party_formed],
    ["spring_breakaway", Q.spring_party_name || "Wiosna", !!Q.spring_party_formed],
    ["labor_left", Q.labor_party_name || "Independent Labour Left", !!Q.labor_party_formed],
    ["young_left", Q.progressives_party_name || "Young Left", !!Q.progressives_party_formed],
    ["razem", Q.razem_party_name || "Razem", !!Q.razem_party_formed],
    ["pps", Q.pps_party_name || "PPS", !!Q.pps_party_formed]
].filter(function(party) { return party[2]; });
