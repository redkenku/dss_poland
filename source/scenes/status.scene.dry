);
for (const id of statusRivalGroupIds) {
    const record = statusRivalGroupRecords.find(function(candidate) {
        return candidate && candidate.id == id;
    }) || {};
    Q["status_rival_" + id + "_name"] = statusText(record.name, id);
    Q["status_rival_" + id + "_short_name"] = statusText(
        record.short_name,
        Q["status_rival_" + id + "_name"]
    );
    Q["status_rival_" + id + "_long_name"] = statusText(
        record.long_name,
        Q["status_rival_" + id + "_name"]
    );
    Q["status_rival_" + id + "_legal"] = statusText(
        record.legal_status,
        "unrecorded"
    );
    Q["status_rival_" + id + "_active"] = record.active ? 1 : 0;
    const rivalIsExternalParty = record.active && record.kind == "party";
    const rivalListCommittee = String(record.list_committee || "");
    Q["status_rival_" + id + "_in_zp"] =
        rivalIsExternalParty && rivalListCommittee == "pis" ? 1 : 0;
    Q["status_rival_" + id + "_in_ko"] =
        rivalIsExternalParty && rivalListCommittee == "ko" ? 1 : 0;
    Q["status_rival_" + id + "_in_kp"] =
        rivalIsExternalParty &&
        ["psl", "third_way"].includes(rivalListCommittee) ? 1 : 0;
    Q["status_rival_" + id + "_in_konf"] =
        rivalIsExternalParty && rivalListCommittee == "konf" ? 1 : 0;
    Q["status_rival_" + id + "_org"] = statusNumber(
        record.organisation,
        0
    );
    Q["status_rival_" + id + "_cohesion"] = statusNumber(
        record.cohesion,
        0
    );
    Q["status_rival_" + id + "_relation"] = statusNumber(
        record.relation,
        0
    );
    Q["status_rival_" + id + "_mps"] = statusNumber(
        record.mp_count,
        0
    );
    const parliamentaryRecord = statusParliamentaryPartyRecords.find(
        function(candidate) { return candidate && candidate.id == id; }
    ) || {};
    Q["status_rival_" + id + "_sejm"] = statusWhole(
        parliamentaryRecord.sejm_mps,
        0
    );
    Q["status_rival_" + id + "_senate"] = statusWhole(
        parliamentaryRecord.senators,
        0
    );
    Q["status_rival_" + id + "_seats"] = statusNumber(
        record.exclusive_seats,
        0
    );
    Q["status_rival_" + id + "_org_band"] = statusCapacityBand(
        record.organisation
    );
    Q["status_rival_" + id + "_cohesion_band"] = statusCohesionBand(
        record.cohesion
    );
}

