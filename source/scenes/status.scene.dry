title: Polish Red Autumn status
new-page: true
is-special: true
on-arrival: {!
const statusNumber = function(value, fallback) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
};
const statusText = function(value, fallback) {
    return typeof value === "string" && value.trim().length
        ? value
        : fallback;
};
const statusDisplayName = function(value, fallback, partyKey) {
    const raw = typeof value === "string" && value.trim().length
        ? value.trim()
        : fallback;
    if (!partyKey || partyKey === "other") {
        return "<b>" + raw + "</b>";
    }
    return '<span class="party party-' + partyKey + '"><b>' + raw + '</b></span>';
};
const normalizeStatusPartyKey = function(value) {
    if (typeof value !== "string") {
        return "";
    }
    const normalized = value.trim().toLowerCase();
    if (!normalized) {
        return "";
    }
    if (
        normalized.includes("pis") ||
        normalized.includes("united right") ||
        normalized.includes("prawdobor")
    ) {
        return "pis";
    }
    if (
        normalized.includes("ko") ||
        normalized.includes("platforma obywatelska") ||
        normalized.includes("civic")
    ) {
        return "ko";
    }
    if (
        normalized.includes("lewica") ||
        normalized.includes("left")
    ) {
        return "lewica";
    }
    if (normalized.includes("psl")) {
        return "psl";
    }
    if (
        normalized.includes("p2050") ||
        normalized.includes("2050")
    ) {
        return "p2050";
    }
    if (
        normalized.includes("konf") ||
        normalized.includes("konfederacja")
    ) {
        return "konf";
    }
    if (normalized.includes("korona")) {
        return "korona";
    }
    if (normalized.includes("razem")) {
        return "razem";
    }
    return "";
};
const statusPersonParty = function(name, partyHint) {
    const explicitPartyKey = normalizeStatusPartyKey(partyHint);
    if (explicitPartyKey) {
        return explicitPartyKey;
    }
    const normalized = (name || "").toLowerCase();
    if (
        normalized.includes("morawiecki") ||
        normalized.includes("kaczyński") ||
        normalized.includes("kaczynski") ||
        normalized.includes("szydło") ||
        normalized.includes("szydlo") ||
        normalized.includes("sasin") ||
        normalized.includes("pis")
    ) {
        return "pis";
    }
    if (
        normalized.includes("tusk") ||
        normalized.includes("trzaskowski") ||
        normalized.includes("nowacka") ||
        normalized.includes("sikorski") ||
        normalized.includes("kierwiński") ||
        normalized.includes("kierwinski") ||
        normalized.includes("ko")
    ) {
        return "ko";
    }
    if (
        normalized.includes("biejat") ||
        normalized.includes("dziemianowicz") ||
        normalized.includes("zandberg") ||
        normalized.includes("kotula") ||
        normalized.includes("biedroń") ||
        normalized.includes("biedron") ||
        normalized.includes("czarzasty") ||
        normalized.includes("lewica")
    ) {
        return "lewica";
    }
    if (
        normalized.includes("kosiniak-kamysz") ||
        normalized.includes("psl")
    ) {
        return "psl";
    }
    if (
        normalized.includes("hołownia") ||
        normalized.includes("holownia") ||
        normalized.includes("p2050") ||
        normalized.includes("poland 2050")
    ) {
        return "p2050";
    }
    if (
        normalized.includes("mentzen") ||
        normalized.includes("braun") ||
        normalized.includes("konf")
    ) {
        return "konf";
    }
    if (normalized.includes("korona")) {
        return "korona";
    }
    return "other";
};
const statusOneDecimal = function(value, fallback) {
    const rounded = Math.round(statusNumber(value, fallback) * 10) / 10;
    return Object.is(rounded, -0) ? 0 : rounded;
};
const statusWhole = function(value, fallback) {
    return Math.round(statusNumber(value, fallback));
};
const statusCapacityBand = function(value) {
    const number = statusNumber(value, 0);
    if (number < 25) return "weak";
    if (number < 45) return "limited";
    if (number < 65) return "credible";
    if (number < 80) return "strong";
    return "formidable";
};
const statusCohesionBand = function(value) {
    const number = statusNumber(value, 0);
    if (number < 25) return "fractured";
    if (number < 45) return "divided";
    if (number < 65) return "negotiated";
    if (number < 80) return "cohesive";
    return "disciplined";
};
const statusRiskBand = function(value) {
    const number = statusNumber(value, 0);
    if (number < 20) return "quiet";
    if (number < 40) return "contained";
    if (number < 60) return "active";
    if (number < 80) return "high";
    return "critical";
};
const statusConsensusBand = function(value) {
    const number = statusNumber(value, 0);
    if (number < 25) return "fragmented";
    if (number < 45) return "contested";
    if (number < 65) return "partial agreement";
    if (number < 80) return "broad agreement";
    return "strong consensus";
};
const statusFormationBand = function(value) {
    const number = statusNumber(value, 0);
    if (number < 6) return "latent";
    if (number < 12) return "gathering";
    if (number < 18) return "near formation";
    return "organised";
};
const statusMovementBand = function(value) {
    const number = statusNumber(value, 0);
    if (number <= -1) return "clear loss";
    if (number < -0.1) return "slight loss";
    if (number <= 0.1) return "no visible movement";
    if (number < 1) return "slight gain";
    return "clear gain";
};

// The sidebar owns display-only aliases. It deliberately does not normalise or
// repair substantive campaign state merely because the player changed tabs.
Q.status_started = Q.started ? 1 : 0;
Q.status_date = statusText(Q.date_label, "October 2019");
Q.status_headline = statusText(
    Q.news_headline,
    "The Left prepares its return to the Sejm"
);
Q.status_difficulty = statusText(Q.difficulty_name, "Precarious");
Q.status_position = statusText(Q.position, "Parliamentary opposition");
Q.status_project = statusText(
    Q.left_project,
    "Lewica parliamentary alliance"
);
Q.status_candidate = statusText(Q.presidential_candidate, "Undecided");
Q.status_candidate_display = statusDisplayName(
    Q.status_candidate,
    "Undecided",
    statusPersonParty(
        Q.status_candidate,
        Q.candidate_party || Q.presidential_candidate_party
    )
);
Q.status_pres_phase = statusText(Q.pres_2020_phase, "Not begun");
const statusYear = statusWhole(Q.year, 2019);
const statusMonth = statusWhole(Q.month, 10);
Q.status_year = statusYear;
Q.status_pres_2020_visible =
    Q.pres_2020_active ||
    (statusYear == 2020 && statusMonth >= 5 && statusMonth <= 9) ? 1 : 0;
Q.status_pres_2025_active =
    (statusYear == 2024 && statusMonth >= 11) ||
    (statusYear == 2025 && statusMonth <= 8) ? 1 : 0;
Q.status_pres_visible =
    Q.status_pres_2020_visible || Q.status_pres_2025_active ? 1 : 0;
Q.status_pres_r1_complete = Q.pres_first_round_complete ? 1 : 0;
Q.status_pres_runoff_complete = Q.pres_runoff_complete ? 1 : 0;
Q.status_pres_left_r1 = statusOneDecimal(Q.presidential_result, 0);
Q.status_pres_r1_leader = statusText(Q.pres_r1_leader_name, "—");
Q.status_pres_r1_runner = statusText(Q.pres_r1_runner_name, "—");
Q.status_pres_finalist_a = statusText(Q.pres_finalist_a_name, "—");
Q.status_pres_finalist_b = statusText(Q.pres_finalist_b_name, "—");
Q.status_pres_runoff_a = statusOneDecimal(Q.pres_runoff_display_a, 0);
Q.status_pres_runoff_b = statusOneDecimal(Q.pres_runoff_display_b, 0);
Q.status_pres_winner = statusText(Q.pres_runoff_winner_name, "—");
Q.status_pres_feedback_visible =
    Q.pres_feedback_active || Q.pres_first_round_complete ||
    Q.pres_2025_round_one_done ? 1 : 0;
Q.status_pres_feedback_source = statusText(
    Q.pres_feedback_source,
    "No presidential verdict"
);
Q.status_pres_feedback_band = Q.pres_2025_round_one_done
    ? statusText(Q.pres_2025_candidate_band, "Not yet judged")
    : statusText(Q.pres_performance_band, "Not yet judged");
Q.status_pres_feedback_consideration = statusOneDecimal(
    Q.pres_feedback_consideration_current,
    0
);
Q.status_pres_feedback_turnout = statusOneDecimal(
    Q.pres_feedback_turnout_current,
    0
);
Q.status_pres_feedback_months = Math.max(
    0,
    Math.round(statusNumber(Q.pres_feedback_months_remaining, 0))
);
Q.status_pres_feedback_duration = Math.max(
    0,
    Math.round(statusNumber(Q.pres_feedback_duration, 0))
);
Q.status_pres_feedback_leadership = Math.round(
    statusNumber(Q.pres_feedback_leadership_pressure, 0)
);
Q.status_pres_feedback_tactical = statusOneDecimal(
    Q.pres_feedback_tactical_current,
    0
);
Q.status_pres_feedback_certainty = Math.round(
    statusNumber(Q.pres_feedback_base_certainty, 0)
);
Q.status_pres_2025_done = Q.pres_2025_round_one_done ? 1 : 0;
Q.status_pres_2025_runoff_done = Q.pres_2025_runoff_done ? 1 : 0;
Q.status_pres_2025_candidate = statusText(
    Q.pres_2025_left_candidate,
    "Undecided"
);
Q.status_pres_2025_candidate_display = statusDisplayName(
    Q.status_pres_2025_candidate,
    "Undecided",
    statusPersonParty(
        Q.status_pres_2025_candidate,
        Q.pres_2025_candidate_party
    )
);
Q.status_pres_2025_phase = Q.pres_2025_inaugurated
    ? "In office"
    : (Number(Q.pres_2025_oath_crisis) == 2
        ? "Oath crisis"
        : (Q.pres_2025_runoff_done
            ? "President-elect"
            : (Q.pres_2025_round_one_done ? "Runoff" : "Campaign")));
Q.status_pres_2025_oath_visible = Q.pres_2025_oath_crisis ? 1 : 0;
Q.status_pres_2025_oath = Number(Q.pres_2025_oath_crisis) == 3
    ? "Delay collapsed · " + Q.pres_2025_oath_strategy
    : statusText(Q.pres_2025_oath_strategy, "No oath challenge");
Q.status_pres_2025_finalist_a = statusText(
    Q.pres_2025_finalist_a,
    "Undecided"
);
Q.status_pres_2025_finalist_b = statusText(
    Q.pres_2025_finalist_b,
    "Undecided"
);
Q.status_pres_2025_winner = statusText(Q.pres_2025_winner, "Undecided");
Q.status_pres_2025_candidate_result = statusOneDecimal(
    Q.pres_2025_player_result,
    0
);
Q.status_pres_2025_field_result = statusOneDecimal(
    Q.pres_2025_field_result,
    0
);
Q.status_pres_2025_field_band = statusText(
    Q.pres_2025_field_band,
    "Not yet judged"
);
Q.status_pres_2025_leadership_defeat =
    Q.pres_2025_leadership_defeat ? 1 : 0;
Q.status_pres_result_label = Q.trz_repeat_election_pending
    ? "Certified winner"
    : (Q.trz_oath_crisis_launched && Q.trz_repeat_winner == "Andrzej Duda"
        ? "First result"
    : (Q.pres_runoff_complete &&
        Q.pres_runoff_winner_key != "duda" &&
        (
            Q.trzaskowski_won && !Q.trz_inaugurated ||
            !Q.trzaskowski_won && !Q.pres_generic_inauguration_done
        )
        ? "President-elect"
        : "President"));
Q.status_trz_route_visible = Q.trzaskowski_won ? 1 : 0;
Q.status_trz_inauguration = statusText(
    Q.trz_inauguration_status,
    "Certification pending"
);
Q.status_trz_oath_crisis = statusText(
    Q.trz_oath_crisis_outcome,
    "No Witek interregnum"
);
Q.status_trz_temperature = Math.round(
    statusNumber(Q.trz_cohabitation_temperature, 0)
);
Q.status_trz_backlash = Math.round(
    statusNumber(Q.trz_right_backlash, 0)
);
Q.status_trz_fragmentation = Math.round(
    statusNumber(Q.trz_right_fragmentation, 0)
);
Q.status_trz_vetoes = Math.round(statusNumber(Q.trz_vetoes, 0));
Q.status_trz_abortion = statusText(
    Q.trz_abortion_veto_policy,
    "No commitment"
);
Q.status_trz_marriage = statusText(
    Q.trz_marriage_veto_policy,
    "No commitment"
);
Q.status_pres_endorsement = statusText(
    Q.pres_runoff_endorsement,
    "Not chosen"
);
Q.status_budget_strategy = statusText(Q.budget_strategy, "Unsettled");
Q.status_next_budget = statusText(Q.next_budget_label, "December 2019");

Q.status_resources = statusWhole(Q.resources, 0);
Q.status_party_income = statusWhole(Q.party_income, 0);
Q.status_member_dues = statusWhole(Q.member_dues, 2);
Q.status_seat_subvention = statusWhole(Q.seat_subvention, 0);
Q.status_subvention_seats = statusWhole(Q.seat_subvention_seats, 0);
Q.status_last_annual_payout = statusWhole(Q.last_annual_payout, 0);
Q.status_last_annual_payout_label = statusText(
    Q.last_annual_payout_label,
    "No annual payout yet"
);
Q.status_fundraising_timer = Math.max(
    0,
    statusNumber(Q.emergency_fundraising_timer, 0)
);
Q.status_budget = statusNumber(Q.budget, 0);
Q.status_budget_authority = statusText(
    Q.budget_authority,
    "Opposition — no state spending authority"
);
Q.status_month_actions = statusNumber(Q.month_actions, 0);
Q.status_max_month_actions = statusNumber(Q.max_month_actions, 1);
Q.status_month_actions_remaining = Math.max(
    0,
    Q.status_max_month_actions - Q.status_month_actions
);
Q.status_advisor_timer = Math.max(
    0,
    statusNumber(Q.advisor_action_timer, 0)
);
Q.status_reshuffle_timer = Math.max(
    0,
    statusNumber(Q.leadership_reshuffle_timer, 0)
);
Q.status_advisors = statusNumber(Q.n_advisors, 3);
const activeAdvisorNames = [];
const advisorStatusRoster = [
    ["miller", "Leszek Miller"],
    ["czarzasty", "Włodzimierz Czarzasty"],
    ["biedron", "Robert Biedroń"],
    ["zandberg", "Adrian Zandberg"],
    ["dziemianowicz_bak", "Agnieszka Dziemianowicz-Bąk"],
    ["zukowska", "Anna-Maria Żukowska"],
    ["kotula", "Katarzyna Kotula"],
    ["biejat", "Magdalena Biejat"],
    ["wieczorek", "Dariusz Wieczorek"],
    ["gawkowski", "Krzysztof Gawkowski"],
    ["nowicka", "Wanda Nowicka"],
    ["zawisza", "Marcelina Zawisza"],
    ["matysiak", "Paulina Matysiak"],
    ["konieczny", "Wojciech Konieczny"],
    ["morawska_stanecka", "Gabriela Morawska-Stanecka"],
    ["kwiatkowski", "Robert Kwiatkowski"],
    ["pelczynska_nalecz", "Katarzyna Pełczyńska-Nałęcz"],
    ["hennig_kloska", "Paulina Hennig-Kloska"],
    ["zielinska", "Urszula Zielińska"],
    ["morawiecki", "Mateusz Morawiecki"],
    ["holownia", "Szymon Hołownia"],
    ["tracz", "Małgorzata Tracz"],
    ["spurek", "Sylwia Spurek"],
    ["semieniuk", "Olga Semeniuk-Patkowska"],
    ["cieszynski", "Janusz Cieszyński"]
];
for (const advisor of advisorStatusRoster) {
    if (Number(Q[advisor[0] + "_advisor"]) === 1) {
        activeAdvisorNames.push(advisor[1]);
    }
}
Q.status_active_advisors = activeAdvisorNames.length
    ? activeAdvisorNames.join(" · ")
    : "Vacant bureau";
Q.status_slot_1_lock = Number(Q.advisor_slot_1_locked) === 1
    ? "Locked"
    : "Open";
Q.status_slot_1_lock_reason = statusText(
    Q.advisor_slot_1_lock_reason,
    "No lock"
);
Q.status_barons_advisors = statusNumber(Q.barons_advisor_count, 0);
Q.status_spring_advisors = statusNumber(Q.spring_advisor_count, 0);
Q.status_labor_advisors = statusNumber(Q.labor_advisor_count, 0);
Q.status_progressives_advisors =
    statusNumber(Q.progressives_advisor_count, 0);
Q.status_razem_advisors = statusNumber(Q.razem_advisor_count, 0);
Q.status_pps_advisors = statusNumber(Q.pps_advisor_count, 0);
Q.status_social_patriot_advisors = statusNumber(
    Q.social_patriot_advisor_count,
    0
);
Q.status_leadership_actions = statusNumber(
