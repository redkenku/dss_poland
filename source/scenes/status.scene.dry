<details class="ledger-disclosure"><summary>Independent parties</summary>
<div class="ledger-section">
[? if independent_bucket_count = 0: <div class="ledger-subrow">No independent party currently holds a Sejm seat.</div>?]
[? if independent_bucket_count > 0: <div class="faction-row"><span class="party party-independent"><b>Independent</b></span><span>[+ independent_bucket_count +] parties</span></div><div class="ledger-subrow">[+ independent_bucket_members +].</div>?]
[? if independent_bucket_seats > 0 or independent_bucket_senators > 0: <div class="ledger-row"><span>Parliamentarians</span><b>[+ independent_bucket_seats +] independent Sejm · [+ independent_bucket_senators +] independent Senate</b></div>?]
</div></details>


@institutions
title: Institutions
new-page: true
is-special: true
call: status

= Institutions

<div class="ledger-section ledger-section-first"><div class="ledger-title">Constitutional order</div>
<div class="ledger-row"><span>Judicial legitimacy</span><b>[+ status_judicial_legitimacy +]/100</b></div>
<div class="ledger-row"><span>Procedural restraint</span><b>[+ status_constitutional_restraint +]/100</b></div>
<div class="ledger-row"><span>Legal dualism</span><b>[+ status_legal_dualism +]/100</b></div>
<div class="ledger-row"><span>Repair mandate</span><b>[+ status_judicial_repair_mandate +]/100</b></div>
<div class="ledger-subrow">[? if status_judicial_legitimacy < 30: <span class="meter-critical">constitutional crisis</span>?][? if status_judicial_legitimacy >= 30 and status_judicial_legitimacy < 50: <span class="meter-warning">deeply contested</span>?][? if status_judicial_legitimacy >= 50 and status_judicial_legitimacy < 70: <span class="meter-steady">strained legitimacy</span>?][? if status_judicial_legitimacy >= 70: <span class="meter-good">broad legitimacy</span>?]</div></div>

<div class="ledger-section"><div class="ledger-title">Constitutional Tribunal</div>
<div class="ledger-row"><span>Composition legality</span><b>[+ status_tribunal_legality +]/100</b></div>
<div class="ledger-row"><span>Domestic recognition</span><b>[+ status_tribunal_recognition +]/100</b></div>
<div class="ledger-subrow">[+ status_tribunal_reform +]</div></div>

<div class="ledger-section"><div class="ledger-title">Appointments and courts</div>
<div class="ledger-row"><span>KRS independence / accountability</span><b>[+ status_krs_independence +] / [+ status_krs_accountability +]</b></div>
<div class="ledger-subrow">[+ status_krs_reform +]</div>
<div class="ledger-row"><span>Supreme Court recognition</span><b>[+ status_supreme_court_recognition +]/100</b></div>
<div class="ledger-row"><span>Vacancies / backlog</span><b>[+ status_judicial_vacancies +] / [+ status_court_backlog +]</b></div>
<div class="ledger-row"><span>Court-user trust</span><b>[+ status_court_user_trust +]/100</b></div></div>

<div class="ledger-section"><div class="ledger-title">Prosecution and Europe</div>
<div class="ledger-row"><span>Prosecutor independence</span><b>[+ status_prosecution_independence +]/100</b></div>
<div class="ledger-row"><span>Command clarity</span><b>[+ status_prosecution_command +]/100</b></div>
<div class="ledger-subrow">[+ status_prosecution +]</div>
<div class="ledger-row"><span>European judgments</span><b>[+ status_european_compliance +]/100</b></div>
<div class="ledger-subrow">[+ status_rule_of_law_eu +]</div>
<div class="ledger-row"><span>Palace cooperation</span><b>[+ status_president_judiciary +]/100</b></div></div>

<div class="ledger-section"><div class="ledger-title">Senate</div>
<div class="ledger-row"><span>Marshal</span><b>[+ status_senate_marshal +]</b></div>
<div class="ledger-row"><span>Control</span><b>[+ status_senate_control +]</b></div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span>[+ status_senate_pis +]</span><span>senators</span></div>
[? if status_senate_konf > 0: <div class="poll-row"><span class="party party-konf"><b>Konfederacja</b></span><span>[+ status_senate_konf +]</span><span>senators</span></div>?]
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span>[+ status_senate_ko +]</span><span>senators</span></div>
[? if status_senate_p2050 > 0: <div class="poll-row"><span class="party party-p2050"><b>Polska 2050</b></span><span>[+ status_senate_p2050 +]</span><span>senators</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span>[+ status_senate_psl +]</span><span>senators</span></div>
<div class="poll-row"><span class="party party-lewica"><b>Left</b></span><span>[+ status_senate_left +]</span><span>senators</span></div>
<div class="poll-row"><span>Independent</span><span>[+ status_senate_independent +]</span><span>senators</span></div>
<div class="ledger-row"><span>Deliverable democratic votes</span><b>[+ status_senate_working_votes +]/[+ status_senate_total +]</b></div>
<div class="ledger-row"><span>Pact cohesion</span><b>[+ status_senate_cohesion +]/100</b></div>
<div class="ledger-row"><span>Left leverage / amendment credit</span><b>[+ status_senate_left_leverage +]/100 · [+ status_senate_credit +]</b></div>
<div class="ledger-subrow">Last vote: [+ status_senate_last_vote +]</div></div>

<div class="ledger-section"><div class="ledger-title">State capacity</div>
<div class="ledger-row"><span>Health service</span><b>[+ status_health_capacity +]/100</b></div>
<div class="ledger-row"><span>Household security</span><b>[+ status_household_security +]/100</b></div>
<div class="ledger-row"><span>Police confidence</span><b>[+ status_police_trust +]/100</b></div>
<div class="ledger-row"><span>Military confidence</span><b>[+ status_military_trust +]/100</b></div>
<div class="ledger-row"><span>Border confidence</span><b>[+ status_border_confidence +]/100</b></div></div>

<div class="ledger-section"><div class="ledger-title">Democratic climate</div>
<div class="ledger-row"><span>Minority safety</span><b>[+ status_minority_safety +]/100</b></div>
<div class="ledger-row"><span>Far-right agenda power</span><b>[+ status_far_right_agenda +]/100</b></div>
<div class="ledger-note">Police and military values measure professional public confidence—not partisan loyalty, militancy or coup power.</div></div>

@paramilitaries
