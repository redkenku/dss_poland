}
Q.status_sld_breakaway_seats =
    statusWhole(Q.sld_breakaway_seats, 0);
Q.status_social_patriot_seats = statusWhole(Q.social_patriot_seats, 0);
Q.status_spring_breakaway_seats =
    statusWhole(Q.spring_breakaway_seats, 0);
