const publicOpinionStatusDefinitions = {
    abortion_rights: "Abortion rights",
    refugee_solidarity: "Refugee and asylum solidarity",
    border_security: "Eastern-border security",
    vaccination: "Vaccination and public health",
    social_spending: "Social spending and public services",
    lgbt_equality: "LGBT equality",
    secular_state: "Secular state and schools",
    rule_of_law: "Rule-of-law repair",
    national_security: "Defence and allied security"
};
const publicSupportBand = function(value) {
    if (value < 35) {
        return "minority position";
    }
    if (value < 47) {
        return "weak plurality";
    }
    if (value < 55) {
        return "closely contested";
    }
    if (value < 65) {
        return "working majority";
    }
    return "broadly popular";
};
const publicSalienceBand = function(value) {
    if (value < 30) {
        return "low attention";
    }
    if (value < 55) {
        return "active concern";
    }
    if (value < 75) {
        return "high salience";
    }
    return "public panic";
};
const publicBacklashBand = function(value) {
    if (value < 30) {
        return "limited backlash";
    }
    if (value < 55) {
        return "organised opposition";
    }
    if (value < 75) {
        return "polarised";
    }
    return "explosive backlash";
};
const publicClimateBand = function(support, salience, backlash) {
    if (salience >= 75 && backlash >= 70) {
        return "Panic and polarisation dominate every move";
    }
    if (support >= 65 && backlash < 55) {
        return "A broad mandate is available";
    }
    if (support >= 55 && backlash >= 65) {
        return "Popular, but capable of a severe counter-mobilisation";
    }
    if (support < 40 && salience >= 55) {
        return "A hostile high-attention climate";
    }
    if (support >= 47 && support < 55) {
        return "The electorate is almost evenly divided";
    }
    if (salience < 30) {
        return "Public attitudes are latent rather than politically urgent";
    }
    if (support >= 55) {
        return "Favourable terrain with an active opposition";
    }
    return "Difficult terrain, but not a settled verdict";
};
for (const issue of Object.keys(publicOpinionStatusDefinitions)) {
    const support = Math.round(statusNumber(Q[issue + "_support"], 50));
    const salience = Math.round(statusNumber(Q[issue + "_salience"], 40));
    const backlash = Math.round(statusNumber(Q[issue + "_backlash"], 40));
    Q["status_" + issue + "_label"] =
        publicOpinionStatusDefinitions[issue];
    Q["status_" + issue + "_support"] = support;
    Q["status_" + issue + "_salience"] = salience;
    Q["status_" + issue + "_backlash"] = backlash;
    Q["status_" + issue + "_support_band"] =
        publicSupportBand(support);
    Q["status_" + issue + "_salience_band"] =
        publicSalienceBand(salience);
    Q["status_" + issue + "_backlash_band"] =
        publicBacklashBand(backlash);
    Q["status_" + issue + "_climate"] =
        publicClimateBand(support, salience, backlash);
}
