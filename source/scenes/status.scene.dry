        Q[group + "_left"]
    );
}
!}

= Campaign pulse

<div class="ledger-masthead"><b>[+ status_date +]</b><span>[+ status_difficulty +]</span></div>
<div class="ledger-headline">[+ status_headline +]</div>
[? if not status_started: <div class="ledger-notice">Preview of the October 2019 starting position. Begin a campaign to activate the ledger.</div>?]

<div class="pulse-panel">
<div class="pulse-heading"><span class="party party-lewica">Lewica</span><span class="role-badge">[+ status_position +]</span></div>

<div class="pulse-grid">
<div class="pulse-card pulse-poll" data-meter="100" data-tone="party" data-threshold="5">
<span class="pulse-label">Poll</span>
<div><strong class="pulse-number">[+ status_left_poll +]%</strong><span class="seat-badge">[+ status_left_seats +] seats</span></div>
</div>

<div class="pulse-card pulse-unity" data-meter="100" data-tone="positive">
<span class="pulse-label">Unity</span>
<div><strong>[? if status_party_unity < 30: Fracturing?][? if status_party_unity >= 30 and status_party_unity < 50: Brittle?][? if status_party_unity >= 50 and status_party_unity < 70: Negotiated?][? if status_party_unity >= 70: Cohesive?]</strong><span class="pulse-number">[+ status_party_unity +]</span></div>
</div>

[? if status_started: <div class="pulse-card pulse-resources">?]
[? if status_started: <span class="pulse-label">Resources</span>?]
[? if status_started: <div><strong class="pulse-number">[+ status_resources +]</strong><span class="flow-badge">+[+ status_party_income +]/yr</span></div>?]
[? if status_started: </div>?]

[? if status_started: <div class="pulse-card pulse-pressure" data-meter="100" data-tone="risk">?]
[? if status_started: <span class="pulse-label">Public pressure</span>?]
[? if status_started: <div><strong>[+ status_public_panic_band +]</strong><span class="pulse-number">[+ status_public_panic +]</span></div>?]
[? if status_started: </div>?]
</div>

[? if status_started and scenario_mode != "formation_2023": <div class="readiness-grid" aria-label="Available campaign actions">?]
[? if status_started and scenario_mode != "formation_2023" and status_month_actions_remaining > 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Monthly</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_month_actions_remaining = 0: <div class="readiness-item is-spent"><span class="readiness-mark" aria-hidden="true"></span><span>Monthly</span><b>Spent</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_advisor_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Advisor</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_advisor_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Advisor</span><b>[+ status_advisor_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_reshuffle_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Reshuffle</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_reshuffle_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Reshuffle</span><b>[+ status_reshuffle_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_fundraising_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Appeal</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_fundraising_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Appeal</span><b>[+ status_fundraising_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023": </div>?]

<div class="power-strip">
<span><small>Cabinet</small><b>[? if status_government_party = "pis": <span class="party party-pis">[+ status_government +]</span>?][? if status_government_party = "ko": <span class="party party-ko">[+ status_government +]</span>?][? if status_government_party = "lewica": <span class="party party-lewica">[+ status_government +]</span>?][? if status_government_party = "psl": <span class="party party-psl">[+ status_government +]</span>?][? if status_government_party = "p2050": <span class="party party-p2050">[+ status_government +]</span>?][? if status_government_party = "other": <span class="party">[+ status_government +]</span>?]</b></span>
<span><small>Next test</small><b>[+ status_next_budget +]</b></span>
</div>
</div>

<details class="ledger-disclosure">
<summary><span>Leadership bureau</span><b>[+ status_advisors +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Active slate</span><b>[+ status_active_advisors +]</b></div>
<div class="faction-mix">[? if status_barons_active: <span class="party-sld" title="[+ status_barons_name +]">[+ status_barons_advisors +]</span>?][? if status_spring_active: <span class="party-wiosna" title="[+ status_spring_name +]">[+ status_spring_advisors +]</span>?][? if status_labor_active: <span class="party-left-labor" title="[+ status_labor_name +]">[+ status_labor_advisors +]</span>?][? if status_progressives_active: <span class="party-progressive" title="[+ status_progressives_name +]">[+ status_progressives_advisors +]</span>?][? if status_razem_active: <span class="party-razem" title="Razem">[+ status_razem_advisors +]</span>?][? if status_pps_active: <span class="party-pps" title="PPS">[+ status_pps_advisors +]</span>?]</div>
<div class="ledger-row"><span>Campaign</span><b>[+ status_leadership_actions +] of 87 months</b></div>
<div class="ledger-note">[+ status_left_family_name +] · only active caucuses are shown</div>
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Government detail</span><b class="disclosure-state">[+ status_prime_minister +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>President</span><b>[+ status_president +]</b></div>
<div class="ledger-row"><span>Prime Minister</span><b>[? if status_prime_minister_party = "pis": <span class="party party-pis">[+ status_prime_minister +]</span>?][? if status_prime_minister_party = "ko": <span class="party party-ko">[+ status_prime_minister +]</span>?][? if status_prime_minister_party = "lewica": <span class="party party-lewica">[+ status_prime_minister +]</span>?][? if status_prime_minister_party = "psl": <span class="party party-psl">[+ status_prime_minister +]</span>?][? if status_prime_minister_party = "p2050": <span class="party party-p2050">[+ status_prime_minister +]</span>?][? if status_prime_minister_party = "other": <span class="party">[+ status_prime_minister +]</span>?]</b></div>
<div class="ledger-row"><span>Lewica's role</span><b>[+ status_left_role +]</b></div>
<div class="ledger-row"><span>Sejm Marshal</span><b>[+ status_sejm_speaker +]</b></div>
<div class="ledger-row"><span>Coalition</span><b>[+ status_coalition_status +]</b></div>
<div class="ledger-row" data-polarity="risk"><span>Coalition dissent</span><b>[+ status_government_coalition_dissent +]/100</b></div>
[? if not left_in_government and government_has_confidence and not caretaker_government: <div class="ledger-row"><span>Negotiating position</span><b>[+ status_negotiation_leverage +] leverage · [+ status_government_hostility +] hostility</b></div><div class="ledger-subrow">Crisis pressure [+ status_crisis_pressure +]/100 · [+ status_negotiation_forecast +]</div><div class="ledger-subrow">Last result: [+ status_negotiation_last +] · [+ status_negotiation_successes +] agreements</div>?]
[? if status_president = "Rafał Trzaskowski" and status_government_party = "pis": <div class="ledger-row"><span>PiS cohabitation</span><b>stress [+ status_pis_cohabitation_stress +] · rally [+ status_pis_cohabitation_rally +]</b></div><div class="ledger-subrow">[+ status_pis_cohabitation_state +]</div>?]
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Political line</span><b class="disclosure-state">[+ status_budget_strategy +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Project</span><b>[+ status_project +]</b></div>
[? if scenario_mode != "formation_2023": <div class="ledger-row"><span>President 2020</span><b>[+ status_candidate +]</b></div>?]
<div class="ledger-row"><span>Budget line</span><b>[+ status_budget_strategy +]</b></div>
[? if scenario_mode != "formation_2023": <div class="ledger-row" data-polarity="risk"><span>Public pressure</span><b>[+ status_public_panic +]/100</b></div><div class="ledger-subrow">Hottest: [+ status_public_hottest +]</div>?]
[? if left_in_government: <div class="ledger-row"><span>State-budget capacity</span><b>[+ status_budget +]</b></div><div class="ledger-subrow">[+ status_budget_authority +]</div>?]
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Economy</span><b class="disclosure-state">[+ status_economic_growth +]% growth</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Real growth</span><b>[+ status_economic_growth +]%</b></div>
<div class="ledger-row"><span>Inflation</span><b>[+ status_inflation +]%</b></div>
<div class="ledger-row"><span>Registered unemployment</span><b>[+ status_unemployment +]%</b></div>
<div class="ledger-row"><span>Public debt</span><b>[+ status_public_debt +]% GDP</b></div>
<div class="ledger-row"><span>Budget balance</span><b>[+ status_budget_balance +]% GDP</b></div>
</div>
</details>

@politics
title: Parties
new-page: true
is-special: true
call: status

= Parties and caucuses

<div class="ledger-section ledger-section-first"><div class="ledger-title">Active caucuses of [+ status_left_party_name +]</div>
<div class="ledger-row"><span>Player organisation</span><b>[+ status_strategic_centre +]</b></div>
<div class="ledger-subrow">[+ status_fragmentation +]</div>
[? if status_barons_active: <div class="faction-row"><span class="party party-sld tooltip-text" title="Regional machinery and the organisational establishment"><b>[+ status_barons_name +]</b></span><span>[+ status_barons_strength : strength +] · dissent [+ status_barons_dissent : dissent +] · [+ status_barons_escalation +]</span></div>?]
[? if status_spring_active: <div class="faction-row"><span class="party party-wiosna tooltip-text" title="Wiosna leadership, activists and candidate network"><b>[+ status_spring_name +]</b></span><span>[+ status_spring_strength : strength +] · dissent [+ status_spring_dissent : dissent +] · [+ status_spring_escalation +]</span></div>?]
[? if status_labor_active: <div class="faction-row"><span class="party party-left-labor tooltip-text" title="Trade-union, workplace and public-service social democrats"><b>[+ status_labor_name +]</b></span><span>[+ status_labor_strength : strength +] · dissent [+ status_labor_dissent : dissent +] · [+ status_labor_escalation +]</span></div>?]
[? if status_progressives_active: <div class="faction-row"><span class="party party-progressive tooltip-text" title="The younger, women-led secular and equality current"><b>[+ status_progressives_name +]</b></span><span>[+ status_progressives_strength : strength +] · dissent [+ status_progressives_dissent : dissent +] · [+ status_progressives_escalation +]</span></div>?]
[? if status_razem_active: <div class="faction-row"><span class="party party-razem tooltip-text" title="Razem remains legally autonomous while it belongs to the common caucus"><b>[+ status_razem_name +]</b></span><span>[+ status_razem_strength : strength +] · dissent [+ status_razem_dissent : dissent +] · [+ status_razem_escalation +]</span></div>?]
[? if status_pps_active: <div class="faction-row"><span class="party party-pps tooltip-text" title="A tiny PPS partner with symbolic and programme influence"><b>[+ status_pps_name +]</b></span><span>[+ status_pps_strength : strength +] · dissent [+ status_pps_dissent : dissent +] · [+ status_pps_escalation +]</span></div>?]
<div class="ledger-row"><span>Weighted internal dissent</span><b>[+ status_internal_dissent +]/100</b></div>
<div class="ledger-row"><span>Active caucus vetoes</span><b>[+ status_faction_vetoes +]</b></div>
<div class="ledger-row"><span>Razem cooperation</span><b>[+ status_razem_cooperation +]/100</b></div>
<div class="ledger-row"><span>Separate Left seats</span><b>[+ status_left_splinter_seats +]</b></div>
<div class="ledger-subrow">Fragmentation leakage in the current poll: [+ status_left_fragmentation_loss +] points</div>
<div class="ledger-row"><span>Failed whips · adviser resignations</span><b>[+ status_failed_whips +] · [+ status_adviser_resignations +]</b></div>
<div class="ledger-row"><span>Individual defections · parliamentary clubs</span><b>[+ status_individual_defections +] · [+ status_parliamentary_circles +]</b></div>
<div class="ledger-row"><span>Contradictory appearances · campaign capacity lost</span><b>[+ status_contradictory_media +] · [+ status_campaign_capacity_loss +]</b></div>
<div class="ledger-row"><span>Dues lost · organised splits</span><b>[+ status_lost_dues +] · [+ status_organised_splits +]</b></div>
<div class="ledger-row"><span>Left electoral family</span><b>[+ status_left_family_intent +]% across [+ status_left_lists +] lists</b></div>
<div class="ledger-subrow">[+ status_left_lists_above_threshold +] clear 5% · [+ status_left_threshold_waste +] points currently wasted below thresholds</div></div>

<div class="ledger-section"><div class="ledger-title">Breakaway parties</div>
[? if barons_party_formed: <div class="faction-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span>[+ status_sld_breakaway_seats +] seats · [+ status_barons_departed +] departed / [+ status_barons_retained +] stayed</span></div>?]
[? if spring_party_formed: <div class="faction-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span>[+ status_spring_breakaway_seats +] seats · [+ status_spring_departed +] departed / [+ status_spring_retained +] stayed</span></div>?]
[? if labor_party_formed: <div class="faction-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span>[+ status_labor_left_seats +] seats · [+ status_labor_departed +] departed / [+ status_labor_retained +] stayed</span></div>?]
[? if progressives_party_formed: <div class="faction-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span>[+ status_young_left_seats +] seats · [+ status_progressives_departed +] departed / [+ status_progressives_retained +] stayed</span></div>?]
[? if razem_party_formed: <div class="faction-row"><span class="party party-razem"><b>[+ razem_party_name +]</b></span><span>[+ status_razem_party_seats +] seats · [+ status_razem_departed +] departed / [+ status_razem_retained +] stayed</span></div>?]
[? if pps_party_formed: <div class="faction-row"><span class="party party-pps"><b>[+ pps_party_name +]</b></span><span>[+ status_pps_party_seats +] seats · [+ status_pps_departed +] departed / [+ status_pps_retained +] stayed</span></div>?]
[? if not barons_party_formed and not spring_party_formed and not labor_party_formed and not progressives_party_formed and not razem_party_formed and not pps_party_formed: <div class="ledger-subrow">No Left caucus currently contests against the main list.</div>?]</div>

<div class="ledger-section"><div class="ledger-title">PiS and United Right organisations</div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_pis_apparatus_name +]</b></span><span>[+ status_rival_pis_apparatus_legal +] · org [+ status_rival_pis_apparatus_org +] · cohesion [+ status_rival_pis_apparatus_cohesion +]</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_porozumienie_name +]</b></span><span>[+ status_rival_porozumienie_legal +] · [+ status_rival_porozumienie_seats +] exclusive seats · relation [+ status_rival_porozumienie_relation +]</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_solidarna_name +]</b></span><span>[+ status_rival_solidarna_legal +] · org [+ status_rival_solidarna_org +] · cohesion [+ status_rival_solidarna_cohesion +]</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_morawiecki_name +]</b></span><span>[+ status_rival_morawiecki_legal +] · affinity [+ status_rival_morawiecki_mps +] MPs</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_pis_welfare_name +]</b></span><span>affinity [+ status_rival_pis_welfare_mps +] · relation [+ status_rival_pis_welfare_relation +]</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_pis_security_name +]</b></span><span>affinity [+ status_rival_pis_security_mps +] · relation [+ status_rival_pis_security_relation +]</span></div>
<div class="faction-row"><span class="party party-pis"><b>[+ status_rival_pis_culture_name +]</b></span><span>affinity [+ status_rival_pis_culture_mps +] · relation [+ status_rival_pis_culture_relation +]</span></div>
[? if status_rival_rozwoj_plus_active: <div class="faction-row"><span class="party party-pis"><b>[+ status_rival_rozwoj_plus_name +]</b></span><span>[+ status_rival_rozwoj_plus_legal +] · [+ status_rival_rozwoj_plus_seats +] exclusive seats / [+ status_rival_rozwoj_plus_mps +] claimed MPs</span></div>?]
<div class="ledger-subrow">Affinity estimates for cross-cutting currents overlap. Only exclusive seats change Sejm arithmetic.</div></div>

<div class="ledger-section"><div class="ledger-title">KO component organisations</div>
<div class="faction-row"><span class="party party-ko"><b>[+ status_rival_po_name +]</b></span><span>[+ status_rival_po_legal +] · org [+ status_rival_po_org +] · cohesion [+ status_rival_po_cohesion +]</span></div>
<div class="faction-row"><span class="party party-ko"><b>[+ status_rival_nowoczesna_name +]</b></span><span>[+ status_rival_nowoczesna_legal +] · org [+ status_rival_nowoczesna_org +] · cohesion [+ status_rival_nowoczesna_cohesion +]</span></div>
<div class="faction-row"><span class="party party-ko"><b>[+ status_rival_ipl_name +]</b></span><span>[+ status_rival_ipl_legal +] · org [+ status_rival_ipl_org +] · cohesion [+ status_rival_ipl_cohesion +]</span></div>
<div class="faction-row"><span class="party party-ko"><b>[+ status_rival_greens_name +]</b></span><span>[+ status_rival_greens_legal +] · org [+ status_rival_greens_org +] · relation [+ status_rival_greens_relation +]</span></div>
[? if status_rival_ko_party_active: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_ko_party_name +]</b></span><span>[+ status_rival_ko_party_legal +] · org [+ status_rival_ko_party_org +]</span></div>?]
[? if status_rival_ko_splinter_active: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_ko_splinter_name +]</b></span><span>[+ status_rival_ko_splinter_legal +] · [+ status_rival_ko_splinter_seats +] seats</span></div>?]
<div class="ledger-subrow">2025 convention: [+ ko_merger_result +]. Greens remain a separate record in every outcome.</div></div>

<div class="ledger-section"><div class="ledger-title">Relations</div>
<div class="ledger-row"><span class="party party-ko"><b>KO</b></span><span>[+ status_ko_relation : relationships +] · [+ status_ko_relation +]</span></div>
<div class="ledger-row"><span class="party party-psl"><b>PSL</b></span><span>[+ status_psl_relation : relationships +] · [+ status_psl_relation +]</span></div>
[? if status_p2050_visible: <div class="ledger-row"><span class="party party-p2050"><b>Poland 2050</b></span><span>[+ status_p2050_relation : relationships +] · [+ status_p2050_relation +]</span></div>?]
<div class="ledger-row"><span class="party party-pis"><b>PiS</b></span><span>[+ status_pis_relation : relationships +] · [+ status_pis_relation +]</span></div>
<div class="ledger-row"><span class="party party-konf"><b>Konfederacja</b></span><span>[+ status_konf_relation : relationships +] · [+ status_konf_relation +]</span></div>
<div class="ledger-row"><span>President [+ status_president +]</span><span>[+ status_president_relation : relationships +] · [+ status_president_relation +]</span></div></div>

<div class="ledger-section"><div class="ledger-title">Other party leadership</div>
<div class="ledger-row"><span class="party party-pis"><b>PiS</b></span><span>[+ status_pis_leader +]</span></div>
<div class="ledger-subrow">[+ status_pis_ideology +]</div>
<div class="ledger-row"><span class="party party-ko"><b>KO</b></span><span>[+ status_ko_leader +]</span></div>
<div class="ledger-subrow">[+ status_ko_ideology +]</div>
<div class="ledger-row"><span class="party party-psl"><b>PSL</b></span><span>[+ status_psl_leader +]</span></div>
<div class="ledger-subrow">[+ status_psl_ideology +]</div>
<div class="ledger-row"><span class="party party-konf"><b>Konf.</b></span><span>[+ status_konf_leader +]</span></div>
<div class="ledger-subrow">[+ status_konf_ideology +]</div>
[? if status_p2050_visible: <div class="ledger-row"><span class="party party-p2050"><b>PL2050</b></span><span>[+ status_p2050_leader +]</span></div><div class="ledger-subrow">[+ status_p2050_ideology +]</div>?]</div>

<div class="ledger-section"><div class="ledger-title">Rival party activity</div>
<div class="ledger-subrow">[+ status_rival_month_headline +]</div>
<div class="ledger-subrow">[+ status_rival_group_month_action +]</div>
<div class="ledger-subrow">[+ status_party_system_climate +]</div>
<div class="ledger-subrow">Independence Day: [+ status_independence_field +]</div>
<div class="ledger-row"><span class="party party-pis"><b>PiS</b> · [+ status_pis_dominant_wing +]</span><span>[+ status_pis_org_resources +] (+[+ status_pis_org_income +]/yr) · [+ status_pis_ideology_drift +]</span></div>
<div class="ledger-subrow">[+ status_pis_ai_headline +]</div>
<div class="ledger-row"><span class="party party-ko"><b>KO</b> · [+ status_ko_dominant_wing +]</span><span>[+ status_ko_org_resources +] (+[+ status_ko_org_income +]/yr) · [+ status_ko_ideology_drift +]</span></div>
<div class="ledger-subrow">[+ status_ko_ai_headline +]</div>
<div class="ledger-row"><span class="party party-psl"><b>PSL</b> · [+ status_psl_dominant_wing +]</span><span>[+ status_psl_org_resources +] (+[+ status_psl_org_income +]/yr) · [+ status_psl_ideology_drift +]</span></div>
<div class="ledger-subrow">[+ status_psl_ai_headline +]</div>
<div class="ledger-row"><span class="party party-konf"><b>Konf.</b> · [+ status_konf_dominant_wing +]</span><span>[+ status_konf_org_resources +] (+[+ status_konf_org_income +]/yr) · [+ status_konf_ideology_drift +]</span></div>
<div class="ledger-subrow">[+ status_konf_ai_headline +]</div>
[? if status_p2050_visible: <div class="ledger-row"><span class="party party-p2050"><b>PL2050</b> · [+ status_p2050_dominant_wing +]</span><span>[+ status_p2050_org_resources +] (+[+ status_p2050_org_income +]/yr) · [+ status_p2050_ideology_drift +]</span></div><div class="ledger-subrow">[+ status_p2050_ai_headline +]</div>?]
<div class="ledger-subrow">[+ status_rival_coalition_signal +]</div></div>

@institutions
title: Institutions
new-page: true
is-special: true
call: status

= Institutions

<div class="ledger-section ledger-section-first"><div class="ledger-title">Constitutional order</div>
<div class="ledger-row"><span>Judicial legitimacy</span><b>[+ status_judicial_legitimacy +]/100</b></div>
<div class="ledger-row"><span>Procedural restraint</span><b>[+ status_constitutional_restraint +]/100</b></div>
<div class="ledger-row"><span>Legal dualism</span><b>[+ status_legal_dualism +]/100</b></div>
<div class="ledger-row"><span>Repair mandate</span><b>[+ status_judicial_repair_mandate +]/100</b></div>
<div class="ledger-subrow">[? if status_judicial_legitimacy < 30: <span class="meter-critical">constitutional crisis</span>?][? if status_judicial_legitimacy >= 30 and status_judicial_legitimacy < 50: <span class="meter-warning">deeply contested</span>?][? if status_judicial_legitimacy >= 50 and status_judicial_legitimacy < 70: <span class="meter-steady">strained legitimacy</span>?][? if status_judicial_legitimacy >= 70: <span class="meter-good">broad legitimacy</span>?]</div></div>

<div class="ledger-section"><div class="ledger-title">Constitutional Tribunal</div>
<div class="ledger-row"><span>Composition legality</span><b>[+ status_tribunal_legality +]/100</b></div>
<div class="ledger-row"><span>Domestic recognition</span><b>[+ status_tribunal_recognition +]/100</b></div>
<div class="ledger-subrow">[+ status_tribunal_reform +]</div></div>

<div class="ledger-section"><div class="ledger-title">Appointments and courts</div>
<div class="ledger-row"><span>KRS independence / accountability</span><b>[+ status_krs_independence +] / [+ status_krs_accountability +]</b></div>
<div class="ledger-subrow">[+ status_krs_reform +]</div>
<div class="ledger-row"><span>Supreme Court recognition</span><b>[+ status_supreme_court_recognition +]/100</b></div>
<div class="ledger-row"><span>Vacancies / backlog</span><b>[+ status_judicial_vacancies +] / [+ status_court_backlog +]</b></div>
<div class="ledger-row"><span>Court-user trust</span><b>[+ status_court_user_trust +]/100</b></div></div>

<div class="ledger-section"><div class="ledger-title">Prosecution and Europe</div>
<div class="ledger-row"><span>Prosecutor independence</span><b>[+ status_prosecution_independence +]/100</b></div>
<div class="ledger-row"><span>Command clarity</span><b>[+ status_prosecution_command +]/100</b></div>
<div class="ledger-subrow">[+ status_prosecution +]</div>
<div class="ledger-row"><span>European judgments</span><b>[+ status_european_compliance +]/100</b></div>
