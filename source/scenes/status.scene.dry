[? if status_progressives_active: <div class="faction-row"><span class="party party-progressive tooltip-text" title="The younger, women-led secular and equality current"><b>[+ status_progressives_name +]</b></span><span>[+ status_progressives_strength : strength +] · dissent [+ status_progressives_dissent : dissent +] · [+ status_progressives_escalation +]</span></div>?]
[? if status_razem_active: <div class="faction-row"><span class="party party-razem tooltip-text" title="Razem remains legally autonomous while it belongs to the common caucus"><b>[+ status_razem_name +]</b></span><span>[+ status_razem_strength : strength +] · dissent [+ status_razem_dissent : dissent +] · [+ status_razem_escalation +]</span></div>?]
[? if status_pps_active: <div class="faction-row"><span class="party party-pps tooltip-text" title="A tiny PPS partner with symbolic and programme influence"><b>[+ status_pps_name +]</b></span><span>[+ status_pps_strength : strength +] · dissent [+ status_pps_dissent : dissent +] · [+ status_pps_escalation +]</span></div>?]
