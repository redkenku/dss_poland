);
Q.status_senate_total = statusNumber(Q.senate_total, 100);
Q.status_senate_pis = statusNumber(Q.senate_pis_seats, 48);
Q.status_senate_konf = statusNumber(Q.senate_konf_seats, 0);
Q.status_senate_ko = statusNumber(Q.senate_ko_seats, 43);
Q.status_senate_p2050 = statusNumber(Q.senate_p2050_seats, 0);
Q.status_senate_psl = statusNumber(Q.senate_psl_seats, 3);
Q.status_senate_left = statusNumber(Q.senate_left_seats, 2);
Q.status_senate_independent = statusNumber(
    Q.senate_independent_seats,
    4
);
Q.status_senate_working_votes = statusNumber(
    Q.senate_working_votes,
    51
);
Q.status_senate_cohesion = Math.round(
    statusNumber(Q.senate_cohesion, 52)
);
Q.status_senate_left_leverage = Math.round(
    statusNumber(Q.senate_left_leverage, 18)
);
Q.status_senate_credit = statusNumber(Q.senate_amendment_credit, 0);
Q.status_senate_marshal = statusText(Q.senate_marshal, "Tomasz Grodzki");
Q.status_senate_control = statusText(
    Q.senate_control,
    "Fragile opposition pact"
);
Q.status_senate_last_vote = statusText(
    Q.senate_last_vote,
    "No common vote yet"
);
Q.status_coalition_status = statusText(
    Q.coalition_status,
    "PiS majority government"
);
Q.status_government_coalition_dissent = Math.round(
    statusNumber(Q.government_coalition_dissent, 16)
);
const statusGovernmentGoals = [
    ["government_goal_health", "public health"],
    ["government_goal_housing", "housing and tenants"],
    ["government_goal_labor", "labour rights"],
    ["government_goal_welfare", "social welfare"],
    ["government_goal_equality", "equality"]
];
const statusCompletedGovernmentGoals = statusGovernmentGoals.filter(
    function(goal) {
        return statusNumber(Q[goal[0]], 0) >= 1;
    }
).map(function(goal) {
    return goal[1];
});
Q.status_government_burden_active = Q.government_burden_active ? 1 : 0;
Q.status_government_burden_review =
    Q.government_burden_review_pending ? 1 : 0;
Q.status_government_burden_timer = Math.max(
    0,
    Math.round(statusNumber(Q.government_burden_timer, 0))
);
Q.status_government_burden_completed =
    statusCompletedGovernmentGoals.length;
Q.status_government_burden_required = Math.max(
    1,
    Math.round(statusNumber(Q.government_burden_required, 2))
);
Q.status_government_burden_goals = statusCompletedGovernmentGoals.length
    ? statusCompletedGovernmentGoals.join(" · ")
    : "None yet";
Q.status_government_burden_breached =
    Q.government_burden_breached ? 1 : 0;
Q.status_government_achievements = Math.max(
    0,
    Math.round(statusNumber(Q.government_achievements, 0))
);
Q.status_government_burden_failures = Math.max(
    0,
    Math.round(statusNumber(Q.government_burden_failures, 0))
);
Q.status_government_burden_last = statusText(
    Q.government_burden_last_result,
    "No government record yet"
);
Q.status_coalition_seats = statusNumber(Q.coalition_seats, 0);
Q.status_confidence_mode = statusText(Q.confidence_mode, "None");
Q.status_confidence_candidate = statusText(
    Q.confidence_candidate,
    "None"
);
Q.status_confidence_present = statusNumber(Q.confidence_present, 0);
Q.status_confidence_threshold = statusNumber(Q.confidence_threshold, 0);
Q.status_confidence_yes = statusNumber(Q.confidence_yes, 0);
Q.status_confidence_no = statusNumber(Q.confidence_no, 0);
Q.status_confidence_abstain = statusNumber(Q.confidence_abstain, 0);
Q.status_primary_electorate = statusText(
    Q.primary_electorate,
    "Not chosen"
);
Q.status_primary_rules = statusText(Q.primary_rules, "Not chosen");
Q.status_primary_campaign = statusText(Q.primary_campaign, "Not chosen");
Q.status_primary_winner = statusText(Q.primary_winner, "Undecided");
for (const coalition of [
    "democratic", "right", "center", "pis_psl"
]) {
    Q["status_coalition_" + coalition + "_seats"] = statusNumber(
        Q["coalition_" + coalition + "_seats"],
        0
    );
    Q["status_coalition_" + coalition + "_score"] = Math.round(
        statusNumber(Q["coalition_" + coalition + "_score"], 0)
    );
}
const voterGroupsForStatus = [
    "metropolitan_liberals",
    "liberal_professionals",
    "public_service_families",
    "industrial_logistics",
    "provincial_welfare",
    "rural_localists",
    "older_welfare_households",
    "anti_establishment_youth"
];
for (const group of voterGroupsForStatus) {
    Q["status_" + group + "_size"] = statusWhole(
        Q[group + "_size"],
        0
    );
    Q["status_" + group + "_turnout"] = Math.round(
        statusNumber(Q[group + "_turnout"], 0)
    );
    Q["status_" + group + "_leader"] = statusText(
        Q[group + "_leader"],
        "Unsettled"
    );
    Q["status_" + group + "_runner"] = statusText(
        Q[group + "_runner"],
        "Unsettled"
    );
    Q["status_" + group + "_margin"] = statusOneDecimal(
        Q[group + "_margin"],
        0
    );
    Q["status_" + group + "_left"] = statusOneDecimal(
        Q[group + "_left"],
        0
    );
    Q["status_" + group + "_left_previous"] = statusOneDecimal(
        Q[group + "_left_previous"],
        Q[group + "_left"]
    );
}
!}

= Campaign pulse

<div class="ledger-masthead"><b>[+ status_date +]</b><span>[+ status_difficulty +]</span></div>
<div class="ledger-headline">[+ status_headline +]</div>
[? if not status_started: <div class="ledger-notice">Preview of the October 2019 starting position. Begin a campaign to activate the ledger.</div>?]

<div class="pulse-panel">
<div class="pulse-heading"><span class="party party-lewica pulse-party-name">[+ status_left_party_name +]</span><span class="role-badge">[+ status_position +]</span></div>

<div class="pulse-grid">
<div class="pulse-card pulse-poll" data-meter="100" data-tone="party" data-threshold="5">
<span class="pulse-label">Poll</span>
<div><strong class="pulse-number">[+ status_left_poll +]%</strong><span class="seat-badge">[+ status_left_seats +] seats</span></div>
</div>

<div class="pulse-card pulse-unity" data-meter="100" data-tone="positive">
<span class="pulse-label">Unity</span>
<div><strong>[? if status_party_unity < 30: Fracturing?][? if status_party_unity >= 30 and status_party_unity < 50: Brittle?][? if status_party_unity >= 50 and status_party_unity < 70: Negotiated?][? if status_party_unity >= 70: Cohesive?]</strong><span class="pulse-number">[+ status_party_unity +]</span></div>
</div>

[? if status_started: <div class="pulse-card pulse-resources">?]
[? if status_started: <span class="pulse-label">Resources</span>?]
[? if status_started: <div><strong class="pulse-number">[+ status_resources +]</strong><span class="flow-badge">+[+ status_party_income +] Jan/Jul</span></div>?]
[? if status_started: </div>?]

[? if status_started: <div class="pulse-card pulse-pressure" data-meter="100" data-tone="risk">?]
[? if status_started: <span class="pulse-label">Public pressure</span>?]
[? if status_started: <div><strong>[+ status_public_panic_band +]</strong><span class="pulse-number">[+ status_public_panic +]</span></div>?]
[? if status_started: </div>?]
</div>

[? if status_started and scenario_mode != "formation_2023": <div class="readiness-grid" aria-label="Available campaign actions">?]
[? if status_started and scenario_mode != "formation_2023" and status_month_actions_remaining > 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Monthly</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_month_actions_remaining = 0: <div class="readiness-item is-spent"><span class="readiness-mark" aria-hidden="true"></span><span>Monthly</span><b>Spent</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_advisor_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Advisor</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_advisor_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Advisor</span><b>[+ status_advisor_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_reshuffle_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Reshuffle</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_reshuffle_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Reshuffle</span><b>[+ status_reshuffle_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_fundraising_timer = 0: <div class="readiness-item is-ready"><span class="readiness-mark" aria-hidden="true"></span><span>Appeal</span><b>Ready</b></div>?]
[? if status_started and scenario_mode != "formation_2023" and status_fundraising_timer > 0: <div class="readiness-item is-cooling"><span class="readiness-mark" aria-hidden="true"></span><span>Appeal</span><b>[+ status_fundraising_timer +] mo.</b></div>?]
[? if status_started and scenario_mode != "formation_2023": </div>?]

<div class="power-strip">
<span><small>Cabinet</small><b>[? if status_government_party = "pis": <span class="party party-pis">[+ status_government +]</span>?][? if status_government_party = "ko": <span class="party party-ko">[+ status_government +]</span>?][? if status_government_party = "lewica": <span class="party party-lewica">[+ status_government +]</span>?][? if status_government_party = "psl": <span class="party party-psl">[+ status_government +]</span>?][? if status_government_party = "p2050": <span class="party party-p2050">[+ status_government +]</span>?][? if status_government_party = "other": <span class="party">[+ status_government +]</span>?]</b></span>
<span><small>Next test</small><b>[+ status_next_budget +]</b></span>
</div>
</div>

<details class="ledger-disclosure">
<summary><span>Leadership bureau</span><b>[+ status_advisors +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Active slate</span><b>[+ status_active_advisors +]</b></div>
<div class="ledger-row"><span>Slot 1 lock</span><b>[+ status_slot_1_lock +] · [+ status_slot_1_lock_reason +]</b></div>
<div class="faction-mix">[? if status_barons_active: <span class="party-sld" title="[+ status_barons_name +]">[+ status_barons_advisors +]</span>?][? if status_spring_active: <span class="party-wiosna" title="[+ status_spring_name +]">[+ status_spring_advisors +]</span>?][? if status_labor_active: <span class="party-left-labor" title="[+ status_labor_name +]">[+ status_labor_advisors +]</span>?][? if status_progressives_active: <span class="party-progressive" title="[+ status_progressives_name +]">[+ status_progressives_advisors +]</span>?][? if status_razem_active: <span class="party-razem" title="Razem">[+ status_razem_advisors +]</span>?][? if status_pps_active: <span class="party-pps" title="PPS">[+ status_pps_advisors +]</span>?][? if status_social_patriot_active: <span class="party-social-patriot" title="[+ status_social_patriot_name +]">[+ status_social_patriot_advisors +]</span>?]</div>
<div class="ledger-row"><span>Campaign</span><b>[+ status_leadership_actions +] of 87 months</b></div>
<div class="ledger-note">[+ status_left_family_name +] · only active caucuses are shown</div>
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Government detail</span><b class="disclosure-state">[+ status_prime_minister +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>President</span>[+ status_president_display +]</div>
<div class="ledger-row"><span>Prime Minister</span>[+ status_prime_minister_display +]</div>
<div class="ledger-row"><span>Lewica's role</span><b>[+ status_left_role +]</b></div>
<div class="ledger-row"><span>Sejm Marshal</span>[+ status_sejm_speaker_display +]</div>
<div class="ledger-row"><span>Coalition</span><b>[+ status_coalition_status +]</b></div>
<div class="ledger-row" data-polarity="risk"><span>Coalition dissent</span><b>[+ status_government_coalition_dissent +]/100</b></div>
[? if left_in_government and status_government_burden_active: <div class="ledger-row"><span>Government burden</span><b>[+ status_government_burden_completed +] / [+ status_government_burden_required +] goals · [? if status_government_burden_review: review due?][? if not status_government_burden_review: [+ status_government_burden_timer +] months?]</b></div><div class="ledger-subrow">Completed: [+ status_government_burden_goals +].[? if status_government_burden_breached: <span class="meter-warning"> Current window breached by an anti-social settlement.</span>?]</div><div class="ledger-subrow">Record: [+ status_government_achievements +] met · [+ status_government_burden_failures +] missed. [+ status_government_burden_last +].</div>?]
[? if not left_in_government and government_has_confidence and not caretaker_government: <div class="ledger-row"><span>Negotiating position</span><b>[+ status_negotiation_leverage +] leverage · [+ status_negotiation_capital +] built capital · [+ status_government_hostility +] hostility</b></div><div class="ledger-subrow">Crisis pressure [+ status_crisis_pressure +]/100 · [+ status_negotiation_forecast +]</div><div class="ledger-subrow">Last result: [+ status_negotiation_last +] · [+ status_negotiation_successes +] agreements</div>?]
[? if status_president = "Rafał Trzaskowski" and status_government_party = "pis": <div class="ledger-row"><span>PiS cohabitation</span><b>stress [+ status_pis_cohabitation_stress +] · rally [+ status_pis_cohabitation_rally +]</b></div><div class="ledger-subrow">[+ status_pis_cohabitation_state +]</div>?]
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Political line</span><b class="disclosure-state">[+ status_budget_strategy +]</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Project</span><b>[+ status_project +]</b></div>
[? if status_pres_2020_visible: <div class="ledger-row"><span>Presidential candidate</span>[+ status_candidate_display +]</div>?]
[? if status_pres_2025_active: <div class="ledger-row"><span>Presidential candidate</span>[+ status_pres_2025_candidate_display +]</div>?]
<div class="ledger-row"><span>Budget line</span><b>[+ status_budget_strategy +]</b></div>
[? if scenario_mode != "formation_2023": <div class="ledger-row" data-polarity="risk"><span>Public pressure</span><b>[+ status_public_panic +]/100</b></div><div class="ledger-subrow">Hottest: [+ status_public_hottest +]</div>?]
[? if left_in_government: <div class="ledger-row"><span>State-budget capacity</span><b>[+ status_budget +]</b></div><div class="ledger-subrow">[+ status_budget_authority +]</div>?]
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Economy</span><b class="disclosure-state">[+ status_economic_growth +]% growth</b></summary>
<div class="disclosure-body">
<div class="ledger-row"><span>Real growth</span><b>[+ status_economic_growth +]%</b></div>
<div class="ledger-row"><span>Inflation</span><b>[+ status_inflation +]%</b></div>
<div class="ledger-row"><span>Registered unemployment</span><b>[+ status_unemployment +]%</b></div>
<div class="ledger-row"><span>Public debt</span><b>[+ status_public_debt +]% GDP</b></div>
<div class="ledger-row"><span>Budget balance</span><b>[+ status_budget_balance +]% GDP</b></div>
</div>
</details>

<details class="ledger-disclosure">
<summary><span>Parliament seats</span><b class="disclosure-state">Sejm 460 · Senate [+ status_senate_total +]</b></summary>
<div class="disclosure-body">
<div class="ledger-title">Sejm</div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span></span><span>[+ status_pis_seats +] seats</span></div>
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span></span><span>[+ status_ko_seats +] seats</span></div>
<div class="poll-row"><span class="party party-lewica"><b>[+ status_left_party_name +]</b></span><span></span><span>[+ status_left_seats +] seats</span></div>
[? if barons_party_formed: <div class="poll-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span></span><span>[+ status_sld_breakaway_seats +] seats</span></div>?]
[? if social_patriot_party_formed: <div class="poll-row"><span class="party party-social-patriot"><b>[+ social_patriot_party_name +]</b></span><span></span><span>[+ status_social_patriot_seats +] seats</span></div>?]
[? if spring_party_formed: <div class="poll-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span></span><span>[+ status_spring_breakaway_seats +] seats</span></div>?]
[? if labor_party_formed: <div class="poll-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span></span><span>[+ status_labor_left_seats +] seats</span></div>?]
[? if progressives_party_formed: <div class="poll-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span></span><span>[+ status_young_left_seats +] seats</span></div>?]
[? if razem_party_formed: <div class="poll-row"><span class="party party-razem"><b>Razem</b></span><span></span><span>[+ status_razem_party_seats +] seats</span></div>?]
[? if pps_party_formed: <div class="poll-row"><span class="party party-pps"><b>PPS</b></span><span></span><span>[+ status_pps_party_seats +] seats</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="poll-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span></span><span>[+ status_tak_rozwoj_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span></span><span>[+ status_psl_seats +] seats</span></div>
[? if status_p2050_visible: <div class="poll-row"><span class="party party-p2050"><b>PL2050</b></span><span></span><span>[+ status_p2050_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-konf"><b>Konf.</b></span><span></span><span>[+ status_konf_seats +] seats</span></div>
[? if unia_centrum_formed or status_centrum_seats > 0: <div class="poll-row"><span class="party party-centrum"><b>Unia Centrum</b></span><span></span><span>[+ status_centrum_seats +] seats</span></div>?]
[? if rozwoj_party_formed and not rozwoj_joined_left: <div class="poll-row"><span class="party party-rozwoj"><b>Rozwój Plus</b></span><span></span><span>[+ status_rozwoj_seats +] seats</span></div>?]
[? if far_right_split > 0: <div class="poll-row"><span class="party party-korona"><b>Korona</b></span><span></span><span>[+ status_korona_seats +] seats</span></div>?]
<div class="poll-row"><span>Others</span><span></span><span>[+ status_other_seats +] seats</span></div>

<div class="ledger-title">Senate</div>
<div class="ledger-row"><span>Control</span><b>[+ status_senate_control +]</b></div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span></span><span>[+ status_senate_pis +] seats</span></div>
[? if status_senate_konf > 0: <div class="poll-row"><span class="party party-konf"><b>Konfederacja</b></span><span></span><span>[+ status_senate_konf +] seats</span></div>?]
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span></span><span>[+ status_senate_ko +] seats</span></div>
[? if status_senate_p2050 > 0: <div class="poll-row"><span class="party party-p2050"><b>Polska 2050</b></span><span></span><span>[+ status_senate_p2050 +] seats</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span></span><span>[+ status_senate_psl +] seats</span></div>
<div class="poll-row"><span class="party party-lewica"><b>Left</b></span><span></span><span>[+ status_senate_left +] seats</span></div>
<div class="poll-row"><span>Independent</span><span></span><span>[+ status_senate_independent +] seats</span></div>
</div>
</details>

@politics
title: Internal relations
new-page: true
is-special: true
call: status

= Internal relations

<div class="ledger-section ledger-section-first"><div class="ledger-title">Faction balance</div>
<div class="ledger-subrow">[+ status_fragmentation +]</div>
[? if status_barons_active: <div class="faction-row"><span class="party party-sld"><b>[+ status_barons_name +]</b></span><span>[+ status_barons_strength : strength +] · [+ status_barons_dissent : dissent +] dissent · [+ status_barons_escalation +]</span></div>?]
[? if status_spring_active: <div class="faction-row"><span class="party party-wiosna"><b>[+ status_spring_name +]</b></span><span>[+ status_spring_strength : strength +] · [+ status_spring_dissent : dissent +] dissent · [+ status_spring_escalation +]</span></div>?]
[? if status_labor_active: <div class="faction-row"><span class="party party-left-labor"><b>[+ status_labor_name +]</b></span><span>[+ status_labor_strength : strength +] · [+ status_labor_dissent : dissent +] dissent · [+ status_labor_escalation +]</span></div>?]
[? if status_progressives_active: <div class="faction-row"><span class="party party-progressive"><b>[+ status_progressives_name +]</b></span><span>[+ status_progressives_strength : strength +] · [+ status_progressives_dissent : dissent +] dissent · [+ status_progressives_escalation +]</span></div>?]
[? if status_razem_active: <div class="faction-row"><span class="party party-razem"><b>[+ status_razem_name +]</b></span><span>[+ status_razem_strength : strength +] · [+ status_razem_dissent : dissent +] dissent · [+ status_razem_escalation +]</span></div>?]
[? if status_pps_active: <div class="faction-row"><span class="party party-pps"><b>[+ status_pps_name +]</b></span><span>[+ status_pps_strength : strength +] · [+ status_pps_dissent : dissent +] dissent · [+ status_pps_escalation +]</span></div>?]
[? if status_social_patriot_active: <div class="faction-row"><span class="party party-social-patriot"><b>[+ status_social_patriot_name +]</b></span><span>[+ status_social_patriot_strength : strength +] · [+ status_social_patriot_dissent : dissent +] dissent · [+ status_social_patriot_referrals +] referrals · [+ status_social_patriot_escalation +]</span></div>?]
[? if trzaskowski_joined_left and status_left_trzaskowski_current_seats > 0: <div class="faction-row"><span class="party party-progressive"><b>Rafał Trzaskowski · [+ trzaskowski_current_name +]</b></span><span>[+ status_left_trzaskowski_current_seats +] seats integrated into the Left caucus</span></div>?]
[? if ipl_joined_left and status_left_ipl_current_seats > 0: <div class="faction-row"><span class="party party-ko"><b>Inicjatywa Polska current</b></span><span>[+ status_left_ipl_current_seats +] seats integrated into the Left caucus</span></div>?]
[? if (p2050_joined_left or p2050_social_joined_left) and status_left_p2050_current_seats > 0: <div class="faction-row"><span class="party party-p2050"><b>Polska 2050 current</b></span><span>[+ status_left_p2050_current_seats +] seats integrated into the Left caucus</span></div>?]
[? if greens_joined_left and status_left_green_current_seats > 0: <div class="faction-row"><span class="party party-ko"><b>Zieloni current</b></span><span>[+ status_left_green_current_seats +] seats integrated into the Left caucus</span></div>?]
[? if rozwoj_joined_left and status_left_rozwoj_current_seats > 0: <div class="faction-row"><span class="party party-rozwoj"><b>Rozwój+ current</b></span><span>[+ status_left_rozwoj_current_seats +] seats integrated into the Left caucus</span></div>?]
[? if not status_social_patriot_active and status_social_patriot_support > 0: <div class="ledger-subrow">Social-Patriot current: [+ status_social_patriot_formation +].</div>?]
[? if status_market_liberal_active: <div class="faction-row"><span class="party party-centrum"><b>Market caucus</b></span><span>[+ status_market_liberal_strength : strength +] · [+ status_market_liberal_dissent : dissent +] dissent</span></div>?]
[? if not status_market_liberal_active and status_market_liberal_support > 0: <div class="ledger-subrow">Market current: [+ status_market_liberal_formation +].</div>?]
</div>

<div class="ledger-section"><div class="ledger-title">Party condition</div>
<div class="ledger-row"><span>Internal climate</span><b>[+ status_internal_dissent_band +]</b></div>
<div class="ledger-row"><span>Campaign discipline</span><b>[+ status_action_discipline_band +]</b></div>
<div class="ledger-row"><span>Active caucus vetoes</span><b>[? if status_faction_vetoes = 0: none?][? if status_faction_vetoes > 0: [+ status_faction_vetoes +]?]</b></div>
<div class="ledger-row"><span>Razem cooperation</span><b>[+ status_razem_cooperation_band +]</b></div>
<div class="ledger-subrow">Razem government role: [+ status_razem_government_role +].</div>
<div class="ledger-row"><span>[+ status_left_party_name +] electoral family</span><b>[+ status_left_family_intent +]% · [+ status_left_lists +] list[? if status_left_lists != 1: s?]</b></div>
[? if status_left_splinter_seats > 0: <div class="ledger-row"><span>Separate seats</span><b>[+ status_left_splinter_seats +]</b></div>?]
[? if status_left_threshold_waste > 0: <div class="ledger-subrow meter-warning">[+ status_left_threshold_waste +] polling points are currently stranded below filed thresholds.</div>?]
</div>

[? if status_failed_whips > 0 or status_adviser_resignations > 0 or status_individual_defections > 0 or status_parliamentary_circles > 0 or status_contradictory_media > 0 or status_campaign_capacity_loss > 0 or status_lost_dues > 0 or status_organised_splits > 0: <div class="ledger-section"><div class="ledger-title">Visible damage</div>?]
[? if status_failed_whips > 0: <div class="ledger-row"><span>Failed whips</span><b>[+ status_failed_whips +]</b></div>?]
[? if status_adviser_resignations > 0: <div class="ledger-row"><span>Adviser resignations</span><b>[+ status_adviser_resignations +]</b></div>?]
[? if status_individual_defections > 0: <div class="ledger-row"><span>Individual defections</span><b>[+ status_individual_defections +]</b></div>?]
[? if status_parliamentary_circles > 0: <div class="ledger-row"><span>Breakaway parliamentary clubs</span><b>[+ status_parliamentary_circles +]</b></div>?]
[? if status_contradictory_media > 0: <div class="ledger-row"><span>Contradictory appearances</span><b>[+ status_contradictory_media +]</b></div>?]
[? if status_campaign_capacity_loss > 0: <div class="ledger-row"><span>Campaign capacity lost</span><b>[+ status_campaign_capacity_loss +]</b></div>?]
[? if status_lost_dues > 0: <div class="ledger-row"><span>Dues lost</span><b>[+ status_lost_dues +]</b></div>?]
[? if status_organised_splits > 0: <div class="ledger-row"><span>Organised splits</span><b>[+ status_organised_splits +]</b></div>?]
[? if status_failed_whips > 0 or status_adviser_resignations > 0 or status_individual_defections > 0 or status_parliamentary_circles > 0 or status_contradictory_media > 0 or status_campaign_capacity_loss > 0 or status_lost_dues > 0 or status_organised_splits > 0: </div>?]

[? if status_sejm_list_negotiation_done or status_year >= 2023: <div class="ledger-section"><div class="ledger-title">Sejm list arrangement</div><div class="ledger-row"><span>Filed committee</span><b>[+ status_sejm_list_result +]</b></div><div class="ledger-row"><span>Legal form</span><b>[+ status_sejm_list_structure +] · [+ status_sejm_list_threshold +]% threshold</b></div><div class="ledger-subrow">[+ status_sejm_list_members +]. [+ status_sejm_list_control +].</div><div class="ledger-row"><span>Razem alliance</span><b>[+ status_razem_alliance_members +]</b></div></div>?]

[? if barons_party_formed or social_patriot_party_formed or spring_party_formed or labor_party_formed or progressives_party_formed or razem_party_formed or pps_party_formed or tak_dla_rozwoju_party_formed: <div class="ledger-section"><div class="ledger-title">Breakaway parties</div>?]
[? if barons_party_formed: <div class="faction-row"><span class="party party-sld"><b>[+ barons_party_name +]</b></span><span>[+ status_sld_breakaway_seats +] seats</span></div>?]
[? if social_patriot_party_formed: <div class="faction-row"><span class="party party-social-patriot"><b>[+ social_patriot_party_name +]</b></span><span>[+ status_social_patriot_seats +] seats</span></div>?]
[? if spring_party_formed: <div class="faction-row"><span class="party party-wiosna"><b>[+ spring_party_name +]</b></span><span>[+ status_spring_breakaway_seats +] seats</span></div>?]
[? if labor_party_formed: <div class="faction-row"><span class="party party-left-labor"><b>[+ labor_party_name +]</b></span><span>[+ status_labor_left_seats +] seats</span></div>?]
[? if progressives_party_formed: <div class="faction-row"><span class="party party-progressive"><b>[+ progressives_party_name +]</b></span><span>[+ status_young_left_seats +] seats</span></div>?]
[? if razem_party_formed: <div class="faction-row"><span class="party party-razem"><b>[+ razem_party_name +]</b></span><span>[+ status_razem_party_seats +] seats</span></div>?]
[? if pps_party_formed: <div class="faction-row"><span class="party party-pps"><b>[+ pps_party_name +]</b></span><span>[+ status_pps_party_seats +] seats</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="faction-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span>[+ status_tak_rozwoj_seats +] seats</span></div>?]
[? if barons_party_formed or social_patriot_party_formed or spring_party_formed or labor_party_formed or progressives_party_formed or razem_party_formed or pps_party_formed or tak_dla_rozwoju_party_formed: </div>?]

<details class="ledger-disclosure"><summary>Leadership and organisation</summary>
<div class="ledger-section"><div class="ledger-row"><span>Coordinating centre</span><b>[+ status_strategic_centre +]</b></div>
<div class="ledger-row"><span>Party leadership</span><b>[+ status_left_leader +]</b></div><div class="ledger-subrow">[+ status_left_leadership_result +]</div>
<div class="ledger-row"><span>Razem leadership</span><b>[+ status_razem_leader +]</b></div><div class="ledger-subrow">[+ status_razem_leadership_result +]</div>
<div class="ledger-subrow">Paulina Matysiak: [+ status_matysiak +]</div>
<div class="ledger-subrow">Realignment: [+ status_left_realign +]</div></div>
</details>

@party_archive
title: Parties
new-page: true
is-special: true
call: status

= Parties and caucuses

<div class="ledger-section ledger-section-first"><div class="ledger-title">Active caucuses of [+ status_left_party_name +]</div>
<div class="ledger-row"><span>Player organisation</span><b>[+ status_strategic_centre +]</b></div>
<div class="ledger-row"><span>Party leadership</span><b>[+ status_left_leader +]</b></div>
<div class="ledger-subrow">[+ status_left_leadership_result +]</div>
<div class="ledger-row"><span>Razem leadership</span><b>[+ status_razem_leader +]</b></div>
<div class="ledger-subrow">[+ status_razem_ideology +] · [+ status_razem_leadership_result +]</div>
<div class="ledger-subrow">Paulina Matysiak: [+ status_matysiak +]</div>
<div class="ledger-subrow">Realignment: [+ status_left_realign +]</div>
<div class="ledger-subrow">[+ status_fragmentation +]</div>
[? if status_barons_active: <div class="faction-row"><span class="party party-sld tooltip-text" title="Regional machinery and the organisational establishment"><b>[+ status_barons_name +]</b></span><span>[+ status_barons_strength : strength +] · dissent [+ status_barons_dissent : dissent +] · [+ status_barons_escalation +]</span></div>?]
[? if status_spring_active: <div class="faction-row"><span class="party party-wiosna tooltip-text" title="Wiosna leadership, activists and candidate network"><b>[+ status_spring_name +]</b></span><span>[+ status_spring_strength : strength +] · dissent [+ status_spring_dissent : dissent +] · [+ status_spring_escalation +]</span></div>?]
