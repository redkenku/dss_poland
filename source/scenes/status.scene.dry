    "story_last_messenger_credibility", "story_last_issue_salience",
    "story_last_left_credibility", "story_last_signal",
    "story_persuasion", "story_backlash", "story_mobilisation",
    "story_abstention", "story_issue_ownership", "story_salience_memory",
    "story_distrust_memory", "story_backlash_memory",
    "story_reputation_memory"
]) {
    Q["status_" + quality] = statusOneDecimal(Q[quality], 0);
}
for (const quality of [
    "womens_strike_activist_mobilisation",
    "womens_strike_public_sympathy",
    "womens_strike_party_conversion",
    "womens_strike_conservative_backlash",
    "migration_empathy", "migration_border_competence",
    "migration_local_service_capacity", "migration_welfare_competition",
    "migration_disinformation"
]) {
    Q["status_" + quality] = Math.round(statusNumber(Q[quality], 0));
}

Q.status_economic_growth = statusOneDecimal(Q.economic_growth, 4.5);
Q.status_inflation = statusOneDecimal(Q.inflation, 2.6);
Q.status_unemployment = statusOneDecimal(Q.unemployment, 5.1);
