for (const attitude of [
    "capitalism_acceptance", "welfare_expectation",
    "cultural_conservatism", "order_threat_sensitivity",
    "universal_solidarity", "institutional_trust", "change_appetite"
]) {
    Q["status_" + attitude] = Math.round(statusNumber(Q[attitude], 50));
}
for (const quality of [
    "electoral_viability", "winner_reputation", "issue_ownership",
    "leadership_authority", "coalition_blur", "media_access",
