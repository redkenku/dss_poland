[? if pps_party_formed: <div class="ledger-row"><span class="party party-pps"><b>[+ status_pps_party_name +]</b></span><b>[+ status_pps_party_relation : relationships +]</b></div>?]
<div class="ledger-row"><span>President [+ status_president +]</span><b>[+ status_president_relation : relationships +]</b></div>
</div>

