Q.status_centrum_visible =
    Q.unia_centrum_formed || Q.status_centrum_seats > 0 ||
    Q.status_centrum_poll > 0 ? 1 : 0;
Q.status_rozwoj_visible =
    (Q.rozwoj_party_formed && !Q.rozwoj_joined_left) ||
