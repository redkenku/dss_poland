[? if status_pres_2020_visible and status_pres_r1_complete: <div class="ledger-row"><span>First ballot</span><b>[+ status_pres_r1_leader +] · [+ status_pres_r1_runner +]</b></div><div class="ledger-subrow">Lewica [+ status_pres_left_r1 +]%</div>?]
[? if status_pres_2020_visible and status_pres_r1_complete and not status_pres_runoff_complete: <div class="ledger-row"><span>Runoff</span><b>[+ status_pres_finalist_a +] · [+ status_pres_finalist_b +]</b></div><div class="ledger-subrow">Left line: [+ status_pres_endorsement +]</div>?]
[? if status_pres_2020_visible and status_pres_runoff_complete: <div class="ledger-row"><span>[+ status_pres_result_label +]</span><b>[+ status_pres_winner +]</b></div><div class="ledger-subrow">[+ status_pres_finalist_a +] [+ status_pres_runoff_a +]% · [+ status_pres_finalist_b +] [+ status_pres_runoff_b +]%</div>?]
[? if status_pres_2020_visible and status_trz_route_visible: <div class="ledger-row"><span>Certification</span><b>[+ status_trz_inauguration +]</b></div>?]
[? if status_pres_2020_visible and status_trz_route_visible and trz_oath_crisis_launched: <div class="ledger-subrow">[+ status_trz_oath_crisis +]</div>?]
[? if status_pres_2020_visible and status_trz_route_visible and trz_inaugurated: <div class="ledger-row"><span>War of the Powers</span><b>[+ status_trz_temperature +] pressure · [+ status_trz_vetoes +] vetoes</b></div><div class="ledger-subrow">United Right fracture [+ status_trz_fragmentation +] · right backlash [+ status_trz_backlash +]</div><div class="ledger-subrow">Abortion: [+ status_trz_abortion +] · marriage: [+ status_trz_marriage +]</div>?]
[? if status_pres_2020_visible: </div>?]

[? if status_pres_2025_active: <div class="ledger-section"><div class="ledger-title">2025 presidential election</div><div class="ledger-row"><span>Phase</span><b>[+ status_pres_2025_phase +]</b></div><div class="ledger-row"><span>Lewica candidate</span>[+ status_pres_2025_candidate_display +]</div>?]
[? if status_pres_2025_active and status_pres_2025_done: <div class="ledger-row"><span>First ballot</span><b>[+ status_pres_2025_candidate_result +]%</b></div><div class="ledger-subrow">Total Left field: [+ status_pres_2025_field_result +]% · [+ status_pres_2025_field_band +]</div><div class="ledger-row"><span>Runoff</span><b>[+ status_pres_2025_finalist_a +] · [+ status_pres_2025_finalist_b +]</b></div>?]
[? if status_pres_2025_active and status_pres_2025_runoff_done: <div class="ledger-row"><span>Winner</span><b>[+ status_pres_2025_winner +]</b></div>?]
[? if status_pres_2025_active and status_pres_2025_oath_visible: <div class="ledger-row"><span>Oath</span><b>[+ status_pres_2025_oath +]</b></div>?]
[? if status_pres_2025_active: </div>?]

<div class="ledger-section"><div class="ledger-title">Current Sejm</div>
<div class="poll-row"><span class="party party-pis"><b>PiS</b></span><span></span><span>[+ status_pis_seats +] seats</span></div>
<div class="poll-row"><span class="party party-ko"><b>KO</b></span><span></span><span>[+ status_ko_seats +] seats</span></div>
<div class="poll-row"><span class="party party-lewica"><b>[+ status_left_party_name +]</b></span><span></span><span>[+ status_left_seats +] seats</span></div>
[? if barons_party_formed: <div class="poll-row"><span class="party party-sld"><b>[+ status_barons_party_name +]</b></span><span></span><span>[+ status_sld_breakaway_seats +] seats</span></div>?]
[? if spring_party_formed: <div class="poll-row"><span class="party party-wiosna"><b>[+ status_spring_party_name +]</b></span><span></span><span>[+ status_spring_breakaway_seats +] seats</span></div>?]
[? if labor_party_formed: <div class="poll-row"><span class="party party-left-labor"><b>[+ status_labor_party_name +]</b></span><span></span><span>[+ status_labor_left_seats +] seats</span></div>?]
[? if progressives_party_formed: <div class="poll-row"><span class="party party-progressive"><b>[+ status_progressives_party_name +]</b></span><span></span><span>[+ status_young_left_seats +] seats</span></div>?]
[? if razem_party_formed: <div class="poll-row"><span class="party party-razem"><b>Razem</b></span><span></span><span>[+ status_razem_party_seats +] seats</span></div>?]
[? if pps_party_formed: <div class="poll-row"><span class="party party-pps"><b>PPS</b></span><span></span><span>[+ status_pps_party_seats +] seats</span></div>?]
[? if tak_dla_rozwoju_party_formed: <div class="poll-row"><span class="party party-razem"><b>[+ status_tak_rozwoj_party_name +]</b></span><span></span><span>[+ status_tak_rozwoj_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-psl"><b>PSL</b></span><span></span><span>[+ status_psl_seats +] seats</span></div>
[? if status_p2050_visible: <div class="poll-row"><span class="party party-p2050"><b>PL2050</b></span><span></span><span>[+ status_p2050_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-konf"><b>Konf.</b></span><span></span><span>[+ status_konf_seats +] seats</span></div>
[? if unia_centrum_formed or status_centrum_seats > 0: <div class="poll-row"><span class="party party-centrum"><b>Unia Centrum</b></span><span></span><span>[+ status_centrum_seats +] seats</span></div>?]
[? if rozwoj_party_formed and not rozwoj_joined_left: <div class="poll-row"><span class="party party-rozwoj"><b>Rozwój Plus</b></span><span></span><span>[+ status_rozwoj_seats +] seats</span></div>?]
[? if far_right_split > 0: <div class="poll-row"><span class="party party-korona"><b>Korona</b></span><span></span><span>[+ status_korona_seats +] seats</span></div>?]
<div class="poll-row"><span class="party party-independent"><b>[+ status_other_name +]</b></span><span></span><span>[+ status_other_seats +] seat[? if status_other_seats != 1: s?]</span></div>
</div>

<div class="ledger-section"><div class="ledger-title">Projected governing arithmetic</div>
<div class="faction-row"><span>KO · democratic centre · Left parties</span><span>[+ status_coalition_democratic_seats +] seats · compatibility [+ status_coalition_democratic_score +]/100</span></div>
<div class="faction-row"><span>KO · PL2050 · PSL</span><span>[+ status_coalition_center_seats +] · [+ status_coalition_center_score +]/100</span></div>
<div class="faction-row"><span>PiS · Konfederacja</span><span>[+ status_coalition_right_seats +] · [+ status_coalition_right_score +]/100</span></div>
<div class="faction-row"><span>PiS · PSL</span><span>[+ status_coalition_pis_psl_seats +] · [+ status_coalition_pis_psl_score +]/100</span></div></div>

<div class="ledger-section"><div class="ledger-title">Mutually exclusive voter blocs</div>
<div class="faction-row"><span><b>Metropolitan liberals</b></span><span>[+ status_metropolitan_liberals_size +]% electorate · Lewica [+ status_metropolitan_liberals_left +]% (prior [+ status_metropolitan_liberals_left_previous +]%) · [+ status_metropolitan_liberals_turnout +]% turnout · [+ status_metropolitan_liberals_leader +] leads</span></div>
<div class="faction-row"><span><b>Liberal professionals</b></span><span>[+ status_liberal_professionals_size +]% · Lewica [+ status_liberal_professionals_left +]% (prior [+ status_liberal_professionals_left_previous +]%) · [+ status_liberal_professionals_turnout +]% turnout · [+ status_liberal_professionals_leader +] leads</span></div>
<div class="faction-row"><span><b>Public-service families</b></span><span>[+ status_public_service_families_size +]% · Lewica [+ status_public_service_families_left +]% (prior [+ status_public_service_families_left_previous +]%) · [+ status_public_service_families_turnout +]% turnout · [+ status_public_service_families_leader +] leads</span></div>
<div class="faction-row"><span><b>Industrial and logistics</b></span><span>[+ status_industrial_logistics_size +]% · Lewica [+ status_industrial_logistics_left +]% (prior [+ status_industrial_logistics_left_previous +]%) · [+ status_industrial_logistics_turnout +]% turnout · [+ status_industrial_logistics_leader +] leads</span></div>
<div class="faction-row"><span><b>Provincial welfare voters</b></span><span>[+ status_provincial_welfare_size +]% · Lewica [+ status_provincial_welfare_left +]% (prior [+ status_provincial_welfare_left_previous +]%) · [+ status_provincial_welfare_turnout +]% turnout · [+ status_provincial_welfare_leader +] leads</span></div>
<div class="faction-row"><span><b>Rural localists</b></span><span>[+ status_rural_localists_size +]% · Lewica [+ status_rural_localists_left +]% (prior [+ status_rural_localists_left_previous +]%) · [+ status_rural_localists_turnout +]% turnout · [+ status_rural_localists_leader +] leads</span></div>
<div class="faction-row"><span><b>Older welfare households</b></span><span>[+ status_older_welfare_households_size +]% · Lewica [+ status_older_welfare_households_left +]% (prior [+ status_older_welfare_households_left_previous +]%) · [+ status_older_welfare_households_turnout +]% turnout · [+ status_older_welfare_households_leader +] leads</span></div>
<div class="faction-row"><span><b>Anti-establishment youth</b></span><span>[+ status_anti_establishment_youth_size +]% · Lewica [+ status_anti_establishment_youth_left +]% (prior [+ status_anti_establishment_youth_left_previous +]%) · [+ status_anti_establishment_youth_turnout +]% turnout · [+ status_anti_establishment_youth_leader +] leads</span></div>
<div class="ledger-note">These eight groups are the complete electorate and sum to 100. The Lewica share is recalculated after every month from choices, rival actions, issue fit and turnout.</div></div>

<div class="ledger-section"><div class="ledger-title">Campaign capacity</div>
<div class="ledger-row"><span>Public trust</span><b>[+ status_public_trust +]/100</b></div>
<div class="ledger-row"><span>Labour credibility</span><b>[+ status_labor_credibility +]/100</b></div>
<div class="ledger-row"><span>Progressive credibility</span><b>[+ status_progressive_credibility +]/100</b></div>
<div class="ledger-row"><span>Feminist trust</span><b>[+ status_feminist_trust +]/100</b></div>
<div class="ledger-row"><span>Media capacity</span><b>[+ status_media_capacity +]/100</b></div>
<div class="ledger-row"><span>Local network</span><b>[+ status_local_network +]/100</b></div></div>

[? if status_pres_feedback_visible: <div class="ledger-section"><div class="ledger-title">Presidential performance feedback</div>
<div class="ledger-row"><span>[+ status_pres_feedback_source +]</span><b>[+ status_pres_feedback_band +]</b></div>
[? if status_pres_2025_done: <div class="ledger-row"><span>[+ status_pres_2025_candidate +] / total Left field</span><b>[+ status_pres_2025_candidate_result +]% / [+ status_pres_2025_field_result +]%</b></div><div class="ledger-subrow">Field verdict: [+ status_pres_2025_field_band +][? if status_pres_2025_leadership_defeat:  · candidate lost the Left leadership contest?]</div>?]
<div class="ledger-row"><span>Current voter recalculation</span><b>consideration [? if status_pres_feedback_consideration >= 0: +?][+ status_pres_feedback_consideration +] · turnout [? if status_pres_feedback_turnout >= 0: +?][+ status_pres_feedback_turnout +]</b></div>
<div class="ledger-subrow">[+ status_pres_feedback_months +] of [+ status_pres_feedback_duration +] monthly rebuilds remain. Leadership pressure [+ status_pres_feedback_leadership +]/100 · tactical flight [+ status_pres_feedback_tactical +] · base certainty [+ status_pres_feedback_certainty +]/100.</div></div>?]

@opinion
title: Public mood
new-page: true
is-special: true
call: status

= Public mood

<div class="ledger-section ledger-section-first"><div class="ledger-title">National climate</div>
<div class="ledger-row"><span>Direction of travel</span><b>[+ status_public_climate_direction +]</b></div>
<div class="ledger-subrow">Terrain [+ status_public_climate_band +] · rights and solidarity support [+ status_public_progressive_index +]/100 · Left owns the field [+ status_public_field_ownership +]/100</div>
<div class="ledger-subrow">National ownership: progressive [+ status_public_progressive_ownership +] · centre [+ status_public_centrist_ownership +] · conservative [+ status_public_conservative_ownership +]</div>
[? if status_public_climate_media != 0: <div class="ledger-subrow">Media weather: [+ status_public_climate_media +] to the reach of every story we tell.</div>?]
<div class="ledger-row"><span>Issue pressure</span><b>[+ status_public_panic_band +]</b></div>
<div class="ledger-subrow">Hottest field: [+ status_public_hottest +]</div>
<div class="ledger-row"><span>Cross-issue consensus</span><b>[+ status_public_consensus_band +]</b></div>
[? if status_public_bridge_pressure > 0: <div class="ledger-row"><span>Legacy-event pressure</span><b>[+ status_public_bridge_band +]</b></div>?]
<div class="ledger-subrow">Updated [+ status_public_updated +]</div>
</div>

<div class="ledger-section"><div class="ledger-title">Reform slate</div>
<div class="ledger-row"><span>Fields chosen</span><b>[+ status_reform_slate_count +] of [+ status_reform_slate_max +]</b></div>
[? if status_reform_slate_count = 0: <div class="ledger-subrow">No reform fields chosen yet.</div>?]
[? if abortion_on_slate: <div class="faction-row"><span>Reproductive rights</span><span>[? if abortion_reform_settled: settled?][? if not abortion_reform_settled: chosen?]</span></div>?]
[? if marriage_on_slate: <div class="faction-row"><span>Legal recognition and equal marriage</span><span>[? if marriage_reform_settled: settled?][? if not marriage_reform_settled: chosen?]</span></div>?]
[? if church_on_slate: <div class="faction-row"><span>Church, school and the secular state</span><span>[? if church_reform_settled: settled?][? if not church_reform_settled: chosen?]</span></div>?]
[? if asylum_on_slate: <div class="faction-row"><span>Asylum and refugee reception</span><span>[? if asylum_reform_settled: settled?][? if not asylum_reform_settled: chosen?]</span></div>?]
[? if border_on_slate: <div class="faction-row"><span>The eastern-border regime</span><span>[? if border_reform_settled: settled?][? if not border_reform_settled: chosen?]</span></div>?]
[? if defence_on_slate: <div class="faction-row"><span>Defence and allied security</span><span>[? if defence_reform_settled: settled?][? if not defence_reform_settled: chosen?]</span></div>?]
[? if labor_on_slate: <div class="faction-row"><span>Labour-law reconstruction</span><span>[? if labor_reform_settled: settled?][? if not labor_reform_settled: chosen?]</span></div>?]
[? if health_on_slate: <div class="faction-row"><span>Public health service reconstruction</span><span>[? if health_reform_settled: settled?][? if not health_reform_settled: chosen?]</span></div>?]
[? if courts_on_slate: <div class="faction-row"><span>Rule-of-law repair</span><span>[? if courts_reform_settled: settled?][? if not courts_reform_settled: chosen?]</span></div>?]
<div class="ledger-row"><span>Settled</span><b>[+ status_reform_slate_settled +]</b></div>
<div class="ledger-subrow">[? if status_reform_slate_left > 0: [+ status_reform_slate_left +] slot(s) still open. A pick is permanent and a settlement — even a bad one — closes that field.?][? if status_reform_slate_left <= 0: The slate is closed for the rest of the campaign.?]</div>
</div>

[? if status_public_last_issue != "None": <div class="ledger-section"><div class="ledger-title">Latest public test</div><div class="ledger-row"><span>[+ status_public_last_action +]</span><b>[+ status_public_last_reception +]</b></div><div class="ledger-row"><span>Public movement</span><b>[+ status_public_last_movement +]</b></div><div class="ledger-subrow">Issue field: [+ status_public_last_issue +]</div></div>?]

<details class="ledger-disclosure" open><summary>Rights, family and church</summary>
<div class="ledger-section"><div class="faction-row"><span><b>Abortion rights</b></span><span>[+ status_abortion_rights_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_abortion_rights_support +]/[+ status_abortion_rights_salience +]/[+ status_abortion_rights_backlash +] · [+ status_abortion_rights_support_band +] · [+ status_abortion_rights_salience_band +] · [+ status_abortion_rights_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_abortion_rights_progressive_ownership +]/[+ status_abortion_rights_centrist_ownership +]/[+ status_abortion_rights_conservative_ownership +] · Left credit [+ status_abortion_rights_left_ownership +]</div>
<div class="faction-row"><span><b>LGBT equality</b></span><span>[+ status_lgbt_equality_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_lgbt_equality_support +]/[+ status_lgbt_equality_salience +]/[+ status_lgbt_equality_backlash +] · [+ status_lgbt_equality_support_band +] · [+ status_lgbt_equality_salience_band +] · [+ status_lgbt_equality_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_lgbt_equality_progressive_ownership +]/[+ status_lgbt_equality_centrist_ownership +]/[+ status_lgbt_equality_conservative_ownership +] · Left credit [+ status_lgbt_equality_left_ownership +]</div>
<div class="faction-row"><span><b>Secular state and schools</b></span><span>[+ status_secular_state_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_secular_state_support +]/[+ status_secular_state_salience +]/[+ status_secular_state_backlash +] · [+ status_secular_state_support_band +] · [+ status_secular_state_salience_band +] · [+ status_secular_state_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_secular_state_progressive_ownership +]/[+ status_secular_state_centrist_ownership +]/[+ status_secular_state_conservative_ownership +] · Left credit [+ status_secular_state_left_ownership +]</div></div>
</details>

<details class="ledger-disclosure" open><summary>Borders, refugees and security</summary>
<div class="ledger-section"><div class="faction-row"><span><b>Refugee and asylum solidarity</b></span><span>[+ status_refugee_solidarity_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_refugee_solidarity_support +]/[+ status_refugee_solidarity_salience +]/[+ status_refugee_solidarity_backlash +] · [+ status_refugee_solidarity_support_band +] · [+ status_refugee_solidarity_salience_band +] · [+ status_refugee_solidarity_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_refugee_solidarity_progressive_ownership +]/[+ status_refugee_solidarity_centrist_ownership +]/[+ status_refugee_solidarity_conservative_ownership +] · Left credit [+ status_refugee_solidarity_left_ownership +]</div>
<div class="faction-row"><span><b>Eastern-border security</b></span><span>[+ status_border_security_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_border_security_support +]/[+ status_border_security_salience +]/[+ status_border_security_backlash +] · [+ status_border_security_support_band +] · [+ status_border_security_salience_band +] · [+ status_border_security_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_border_security_progressive_ownership +]/[+ status_border_security_centrist_ownership +]/[+ status_border_security_conservative_ownership +] · Left credit [+ status_border_security_left_ownership +]</div>
<div class="faction-row"><span><b>Defence and allied security</b></span><span>[+ status_national_security_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_national_security_support +]/[+ status_national_security_salience +]/[+ status_national_security_backlash +] · [+ status_national_security_support_band +] · [+ status_national_security_salience_band +] · [+ status_national_security_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_national_security_progressive_ownership +]/[+ status_national_security_centrist_ownership +]/[+ status_national_security_conservative_ownership +] · Left credit [+ status_national_security_left_ownership +]</div></div>
</details>

<details class="ledger-disclosure" open><summary>Material, health and institutions</summary>
<div class="ledger-section"><div class="faction-row"><span><b>Social spending and services</b></span><span>[+ status_social_spending_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_social_spending_support +]/[+ status_social_spending_salience +]/[+ status_social_spending_backlash +] · [+ status_social_spending_support_band +] · [+ status_social_spending_salience_band +] · [+ status_social_spending_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_social_spending_progressive_ownership +]/[+ status_social_spending_centrist_ownership +]/[+ status_social_spending_conservative_ownership +] · Left credit [+ status_social_spending_left_ownership +]</div>
<div class="faction-row"><span><b>Vaccination and public health</b></span><span>[+ status_vaccination_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_vaccination_support +]/[+ status_vaccination_salience +]/[+ status_vaccination_backlash +] · [+ status_vaccination_support_band +] · [+ status_vaccination_salience_band +] · [+ status_vaccination_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_vaccination_progressive_ownership +]/[+ status_vaccination_centrist_ownership +]/[+ status_vaccination_conservative_ownership +] · Left credit [+ status_vaccination_left_ownership +]</div>
<div class="faction-row"><span><b>Rule-of-law repair</b></span><span>[+ status_rule_of_law_climate +]</span></div><div class="ledger-subrow">S/S/B [+ status_rule_of_law_support +]/[+ status_rule_of_law_salience +]/[+ status_rule_of_law_backlash +] · [+ status_rule_of_law_support_band +] · [+ status_rule_of_law_salience_band +] · [+ status_rule_of_law_backlash_band +]</div><div class="ledger-subrow">Ownership P/C/K [+ status_rule_of_law_progressive_ownership +]/[+ status_rule_of_law_centrist_ownership +]/[+ status_rule_of_law_conservative_ownership +] · Left credit [+ status_rule_of_law_left_ownership +]</div></div>
</details>

<div class="ledger-note">Issue summaries read public support · salience · backlash. They are separate signals, not parts of one score.</div>

@opinion_archive
title: Public mood
new-page: true
is-special: true
call: status

= Public mood

<div class="ledger-section ledger-section-first"><div class="ledger-title">National pressure</div>
<div class="ledger-row"><span>Panic / issue pressure</span><b>[+ status_public_panic +]/100</b></div>
<div class="ledger-subrow">[+ status_public_panic_band +] · hottest field: [+ status_public_hottest +]</div>
<div class="ledger-row"><span>Cross-issue consensus</span><b>[+ status_public_consensus +]/100</b></div>
<div class="ledger-row"><span>Legacy-event pressure this month</span><b>[+ status_public_bridge_pressure +]/100</b></div>
<div class="ledger-subrow">Updated [+ status_public_updated +]</div></div>

<div class="ledger-section"><div class="ledger-title">Latent attitudes</div>
<div class="ledger-row"><span>Acceptance of capitalism and market hierarchy</span><b>[+ status_capitalism_acceptance +]/100</b></div>
<div class="ledger-row"><span>Expectation of transfers and public services</span><b>[+ status_welfare_expectation +]/100</b></div>
<div class="ledger-row"><span>Cultural conservatism</span><b>[+ status_cultural_conservatism +]/100</b></div>
<div class="ledger-row"><span>Order and threat sensitivity</span><b>[+ status_order_threat_sensitivity +]/100</b></div>
<div class="ledger-row"><span>Universal solidarity</span><b>[+ status_universal_solidarity +]/100</b></div>
