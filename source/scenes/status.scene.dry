    "No negotiation attempted"
);
Q.status_negotiation_successes = statusNumber(
    Q.negotiation_successes,
    0
);
Q.status_pis_cohabitation_stress = Math.round(
    statusNumber(Q.pis_cohabitation_stress, 0)
);
Q.status_pis_cohabitation_rally = Math.round(
    statusNumber(Q.pis_cohabitation_rally, 0)
);
Q.status_pis_cohabitation_state = statusText(
    Q.pis_cohabitation_state,
    "No hostile cohabitation"
);

Q.status_pis_poll = statusOneDecimal(Q.pis_poll, 43.6);
Q.status_ko_poll = statusOneDecimal(Q.ko_poll, 27.4);
Q.status_suwerenna_poll = statusOneDecimal(Q.suwerenna_poll, 0);
Q.status_porozumienie_poll = statusOneDecimal(Q.porozumienie_poll, 0);
Q.status_third_way_visible =
    Q.p2050_emerged &&
    (Q.third_way_active || Q.third_way_2023_done) &&
    !Q.third_way_split &&
    String(Q.sejm_list_outcome || "left_5") != "third_host_5" ? 1 : 0;
Q.status_third_way_poll = statusOneDecimal(
    Q.third_way_poll,
    Q.status_third_way_visible
        ? statusOneDecimal(Q.third_way_vote_intent, 0)
        : 0
);
Q.status_psl_poll = statusOneDecimal(
    Q.status_third_way_visible ? 0 : Q.psl_poll,
    8.6
);
Q.status_konf_poll = statusOneDecimal(Q.konf_poll, 6.8);
Q.status_p2050_poll = statusOneDecimal(
    Q.status_third_way_visible ? 0 : Q.p2050_poll,
    0
);
Q.status_p0_poll = statusOneDecimal(Q.p0_poll, 0);
Q.status_other_poll = statusOneDecimal(Q.other_poll, 1.0);
Q.status_nowa_solidarnosc_visible =
    Q.nowa_solidarnosc_formed && !Q.nowa_solidarnosc_dissolved ? 1 : 0;
const dynamicElectionParties = [
    "sld_breakaway",
    "social_patriot",
    "spring_breakaway",
    "labor_left",
    "young_left",
    "razem",
    "pps",
    "tak_rozwoj",
    "centrum",
    "rozwoj",
    "korona",
    "ko_splinter",
