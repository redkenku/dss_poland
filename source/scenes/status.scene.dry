[? if status_rival_republikanie_in_zp: <div class="faction-row"><span class="party party-republicans"><b>[+ status_rival_republikanie_short_name +]</b></span><span>[+ status_rival_republikanie_legal +] · [+ status_rival_republikanie_sejm +] Sejm · [+ status_rival_republikanie_senate +] Senate</span></div>?]
[? if status_rival_odnowa_in_zp: <div class="faction-row"><span class="party party-odnowa"><b>[+ status_rival_odnowa_short_name +]</b></span><span>[+ status_rival_odnowa_legal +] · [+ status_rival_odnowa_sejm +] Sejm · [+ status_rival_odnowa_senate +] Senate</span></div>?]
[? if status_rival_kukiz15_in_zp: <div class="faction-row"><span class="party party-kukiz"><b>Kukiz\'15</b></span><span>independent party on the PiS list · [+ status_rival_kukiz15_sejm +] Sejm · [+ status_rival_kukiz15_senate +] Senate</span></div>?]
<div class="ledger-subrow">PiS electoral committee: [+ pis_list_members +].</div>
</div></details>

<details class="ledger-disclosure"><summary>Koalicja Obywatelska component organisations</summary>
<div class="ledger-section">
[? if status_rival_po_in_ko: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_po_name +]</b></span><span>[+ status_rival_po_org_band +] organisation · [+ status_rival_po_cohesion_band +] · [+ status_rival_po_sejm +] Sejm · [+ status_rival_po_senate +] Senate</span></div>?]
[? if status_rival_nowoczesna_in_ko: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_nowoczesna_name +]</b></span><span>[+ status_rival_nowoczesna_org_band +] organisation · [+ status_rival_nowoczesna_cohesion_band +] · [+ status_rival_nowoczesna_sejm +] Sejm · [+ status_rival_nowoczesna_senate +] Senate</span></div>?]
[? if status_rival_ipl_in_ko: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_ipl_name +]</b></span><span>[+ status_rival_ipl_org_band +] organisation · [+ status_rival_ipl_cohesion_band +] · [+ status_rival_ipl_sejm +] Sejm · [+ status_rival_ipl_senate +] Senate</span></div>?]
[? if status_rival_ko_party_in_ko: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_ko_party_name +]</b></span><span>[+ status_rival_ko_party_org_band +] organisation · [+ status_rival_ko_party_sejm +] Sejm · [+ status_rival_ko_party_senate +] Senate</span></div>?]
[? if status_rival_greens_in_ko: <div class="faction-row"><span class="party party-ko"><b>[+ status_rival_greens_name +]</b></span><span>[+ status_rival_greens_org_band +] organisation · relation [+ status_rival_greens_relation : relationships +] · [+ status_rival_greens_sejm +] Sejm · [+ status_rival_greens_senate +] Senate</span></div>?]
[? if status_ko_independent_sejm > 0 or status_ko_independent_senate > 0: <div class="faction-row"><span>KO-affiliated independents</span><span>[+ status_ko_independent_sejm +] Sejm · [+ status_ko_independent_senate +] Senate</span></div>?]
[? if ko_consolidated: <div class="ledger-subrow">PO, Nowoczesna and IPL now operate as internal KO currents instead of separate party slots.</div>?]
[? if status_ko_convention_visible: <div class="ledger-subrow">2025 convention: [+ status_ko_merger_result +]. Greens remain a separate record in every outcome.</div>?]
[? if ko_collapsed: <div class="ledger-subrow">Split: [+ ko_collapse_result +]. [+ ko_break_leader +] leads the breakaway; [+ ko_leader +] leads the rump.</div>?]
[? if not ko_collapsed: <div class="ledger-subrow">KO's condition: [+ ko_condition_label +].</div>?]
</div></details>

<details class="ledger-disclosure"><summary>[+ kp_committee_name +] component organisations</summary>
<div class="ledger-section">
[? if status_rival_psl_party_in_kp: <div class="faction-row"><span class="party party-psl"><b>[+ status_rival_psl_party_name +]</b></span><span>[+ status_rival_psl_party_legal +] · [+ status_rival_psl_party_org_band +] organisation · [+ status_rival_psl_party_sejm +] Sejm · [+ status_rival_psl_party_senate +] Senate</span></div>?]
[? if status_rival_p2050_party_in_kp: <div class="faction-row"><span class="party party-p2050"><b>[+ status_rival_p2050_party_name +]</b></span><span>[+ status_rival_p2050_party_legal +] · [+ status_rival_p2050_party_org_band +] organisation · [+ status_rival_p2050_party_sejm +] Sejm · [+ status_rival_p2050_party_senate +] Senate</span></div>?]
[? if status_rival_kukiz15_in_kp: <div class="faction-row"><span class="party party-kukiz"><b>[+ status_rival_kukiz15_name +]</b></span><span>[+ status_rival_kukiz15_legal +] · [+ status_rival_kukiz15_sejm +] Sejm · [+ status_rival_kukiz15_senate +] Senate</span></div>?]
[? if status_rival_kp_partners_in_kp: <div class="faction-row"><span class="party party-ued"><b>[+ status_rival_kp_partners_name +]</b></span><span>[+ status_rival_kp_partners_legal +] · [+ status_rival_kp_partners_sejm +] Sejm · [+ status_rival_kp_partners_senate +] Senate</span></div>?]
[? if status_kp_independent_sejm > 0 or status_kp_independent_senate > 0: <div class="faction-row"><span>KP-affiliated independents</span><span>[+ status_kp_independent_sejm +] Sejm · [+ status_kp_independent_senate +] Senate</span></div><div class="ledger-subrow">Marek Biernacki, Jacek Tomczak and Radosław Lubczyk.</div>?]
[? if status_rival_kp_committee_active: <div class="ledger-subrow">Shared committee: [+ kp_list_members +].</div>?]
[? if status_rival_kp_committee_active = 0: <div class="ledger-subrow">No shared committee: the components are filing separately.</div>?]
</div></details>

<details class="ledger-disclosure"><summary>[+ konf_committee_name +] component organisations</summary>
<div class="ledger-section">
[? if status_rival_nowa_nadzieja_in_konf: <div class="faction-row"><span class="party party-new-hope"><b>[+ status_rival_nowa_nadzieja_name +]</b></span><span>[+ status_rival_nowa_nadzieja_legal +] · [+ status_rival_nowa_nadzieja_sejm +] Sejm · [+ status_rival_nowa_nadzieja_senate +] Senate</span></div>?]
[? if status_rival_ruch_narodowy_in_konf: <div class="faction-row"><span class="party party-national-movement"><b>[+ status_rival_ruch_narodowy_name +]</b></span><span>[+ status_rival_ruch_narodowy_legal +] · [+ status_rival_ruch_narodowy_sejm +] Sejm · [+ status_rival_ruch_narodowy_senate +] Senate</span></div>?]
[? if status_rival_kkp_in_konf: <div class="faction-row"><span class="party party-kkp"><b>[+ status_rival_kkp_name +]</b></span><span>[+ status_rival_kkp_legal +] · [+ status_rival_kkp_sejm +] Sejm · [+ status_rival_kkp_senate +] Senate</span></div>?]
<div class="ledger-subrow">Konfederacja committee: [+ konf_list_members +].</div>
[? if konf_succession_2022_done = 0: <div class="ledger-subrow">The libertarian component currently trades as [+ konf_libertarian_party_name +] under [+ konf_libertarian_leader +].</div>?]
[? if konf_succession_2022_done = 1: <div class="ledger-subrow">After the congress the libertarian component trades as [+ konf_libertarian_party_name +] under [+ konf_libertarian_leader +].</div>?]
</div></details>

<details class="ledger-disclosure"><summary>Independent parties</summary>
<div class="ledger-section">
[? if independent_bucket_count = 0: <div class="ledger-subrow">No independent party currently holds a Sejm seat.</div>?]
[? if independent_bucket_count > 0: <div class="faction-row"><span class="party party-independent"><b>Independent</b></span><span>[+ independent_bucket_count +] parties</span></div><div class="ledger-subrow">[+ independent_bucket_members +].</div>?]
[? if independent_bucket_seats > 0 or independent_bucket_senators > 0: <div class="ledger-row"><span>Parliamentarians</span><b>[+ independent_bucket_seats +] independent Sejm · [+ independent_bucket_senators +] independent Senate</b></div>?]
</div></details>

<div class="ledger-note">Internal Left control, adviser representation and faction pressure are tracked in Leadership and factions. Bilateral relations and monthly rival actions are tracked in Party relations.</div>

@relations
title: Party relations
new-page: true
is-special: true
call: status

= Party relations

<div class="ledger-section ledger-section-first"><div class="ledger-title">Working relationships</div>
<div class="ledger-row"><span class="party party-ko"><b>KO</b></span><b>[+ status_ko_relation : relationships +]</b></div>
[? if status_rival_greens_active and not greens_joined_left: <div class="ledger-row"><span class="party party-ko"><b>[+ status_rival_greens_name +]</b></span><b>[+ status_rival_greens_relation : relationships +]</b></div>?]
[? if status_rival_ipl_active and ko_splinter_active = 1 and ko_break_leader = "Barbara Nowacka" and ko_splinter_type = "Progressive": <div class="ledger-row"><span class="party party-ko"><b>[+ status_rival_ipl_name +]</b></span><b>[+ status_rival_ipl_relation : relationships +]</b></div>?]
[? if status_rival_ko_splinter_active: <div class="ledger-row"><span class="party [+ ko_splinter_class +]"><b>[+ status_rival_ko_splinter_name +]</b></span><b>[+ status_rival_ko_splinter_relation : relationships +]</b></div>?]
<div class="ledger-row"><span class="party party-psl"><b>PSL</b></span><b>[+ status_psl_relation : relationships +]</b></div>
[? if status_rival_kukiz15_active and kukiz_left_kp = 1: <div class="ledger-row"><span class="party party-kukiz"><b>[+ status_rival_kukiz15_name +]</b></span><b>[+ status_rival_kukiz15_relation : relationships +]</b></div>?]
[? if status_p2050_visible: <div class="ledger-row"><span class="party party-p2050"><b>Poland 2050</b></span><b>[+ status_p2050_relation : relationships +]</b></div>?]
<div class="ledger-row"><span class="party party-pis"><b>PiS</b></span><b>[+ status_pis_relation : relationships +]</b></div>
[? if suwerenna_walkout or suwerenna_merger_result = "Merger refused": <div class="ledger-row"><span class="party party-sovereign-poland"><b>Suwerenna Polska</b></span><b>[+ status_rival_solidarna_relation : relationships +]</b></div>?]
[? if porozumienie_exit_done and status_rival_porozumienie_active: <div class="ledger-row"><span class="party party-agreement"><b>[+ status_rival_porozumienie_name +]</b></span><b>[+ status_rival_porozumienie_relation : relationships +]</b></div>?]
[? if status_rival_republikanie_active: <div class="ledger-row"><span class="party party-republicans"><b>[+ status_rival_republikanie_short_name +]</b></span><b>[+ status_rival_republikanie_relation : relationships +]</b></div>?]
[? if status_rival_odnowa_active: <div class="ledger-row"><span class="party party-odnowa"><b>[+ status_rival_odnowa_short_name +]</b></span><b>[+ status_rival_odnowa_relation : relationships +]</b></div>?]
[? if status_konf_visible: <div class="ledger-row"><span class="party party-konf"><b>Konfederacja</b></span><b>[+ status_konf_relation : relationships +]</b></div>?]
[? if status_p0_visible: <div class="ledger-row"><span class="party"><b>[+ status_p0_short_name +]</b></span><b>[+ status_p0_relation : relationships +]</b></div>?]
[? if status_korona_visible: <div class="ledger-row"><span class="party"><b>Korona</b></span><b>[+ status_korona_relation : relationships +]</b></div>?]
[? if status_centrum_visible: <div class="ledger-row"><span class="party"><b>Unia Centrum</b></span><b>[+ status_centrum_relation : relationships +]</b></div>?]
[? if status_rozwoj_visible: <div class="ledger-row"><span class="party party-rozwoj"><b>Rozwój+</b></span><b>[+ status_rozwoj_relation : relationships +]</b></div>?]
[? if status_tak_rozwoj_visible: <div class="ledger-row"><span class="party"><b>[+ status_tak_rozwoj_party_name +]</b></span><b>[+ status_tak_rozwoj_relation : relationships +]</b></div>?]
[? if barons_party_formed: <div class="ledger-row"><span class="party party-sld"><b>[+ status_barons_party_name +]</b></span><b>[+ status_barons_party_relation : relationships +]</b></div>?]
[? if social_patriot_party_formed: <div class="ledger-row"><span class="party party-social-patriot"><b>[+ status_social_patriot_party_name +]</b></span><b>[+ status_social_patriot_party_relation : relationships +]</b></div>?]
[? if spring_party_formed: <div class="ledger-row"><span class="party party-wiosna"><b>[+ status_spring_party_name +]</b></span><b>[+ status_spring_party_relation : relationships +]</b></div>?]
[? if labor_party_formed: <div class="ledger-row"><span class="party party-left-labor"><b>[+ status_labor_party_name +]</b></span><b>[+ status_labor_party_relation : relationships +]</b></div>?]
[? if progressives_party_formed: <div class="ledger-row"><span class="party party-progressive"><b>[+ status_progressives_party_name +]</b></span><b>[+ status_progressives_party_relation : relationships +]</b></div>?]
