[? if status_rozwoj_visible: <div class="faction-row"><span class="party party-rozwoj"><b>Rozwój+</b></span><span>[+ status_rozwoj_poll +]% · resources [+ status_rozwoj_org_resources +] · [+ status_rozwoj_ideology_drift +]</span></div><div class="ledger-subrow">[+ status_rozwoj_ai_headline +]</div>?]
[? if status_tak_rozwoj_visible: <div class="faction-row"><span class="party"><b>[+ status_tak_rozwoj_party_name +]</b></span><span>[+ status_tak_rozwoj_poll +]% · resources [+ status_tak_rozwoj_org_resources +] · [+ status_tak_rozwoj_ideology_drift +]</span></div><div class="ledger-subrow">[+ status_tak_rozwoj_ai_headline +]</div>?]
[? if status_korona_visible: <div class="faction-row"><span class="party party-korona"><b>Korona</b></span><span>[+ status_korona_poll +]% · resources [+ status_korona_org_resources +] · [+ status_korona_ideology_drift +]</span></div><div class="ledger-subrow">[+ status_korona_ai_headline +]</div>?]
[? if status_nowa_solidarnosc_visible or status_p0_visible or status_centrum_visible or status_rozwoj_visible or status_tak_rozwoj_visible or status_korona_visible: </div>?]

