    (Number(Q.constitutional_restraint) || 0) + 4;
Q.psl_relation = (Number(Q.psl_relation) || 0) - 5;
Q.rural_support = (Number(Q.rural_support) || 0) - 4;
Q.party_unity = (Number(Q.party_unity) || 0) - 2;
