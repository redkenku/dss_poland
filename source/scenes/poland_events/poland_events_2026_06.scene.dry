    0, majority - Q.culture_crisis_without_left
);
Q.culture_crisis_konf_seats = konfFamily;
Q.culture_crisis_walkout_seats = walkoutSeats;
Q.culture_crisis_right_reserve = konfFamily + walkoutSeats;
// The mirror of the Konfederacja question on the KO path. Here the bloc that
