on-arrival: {!
Q.justice_crisis_2026_done = 1;
Q.justice_crisis_incumbent = Q.justice_minister;
const total = Math.max(1, Math.round(Number(Q.sejm_total) || 460));
const majority = Math.floor(total / 2) + 1;
const leftSeats = Math.max(0, Math.round(Number(Q.left_seats) || 0));
const cabinetSeats = Math.max(
    0, Math.round(Number(Q.coalition_seats) || 0)
);
const konfFamily = Q.mentzen_bosak_split == 1
    ? Math.max(0, Number(Q.new_hope_seats) || 0) +
        Math.max(0, Number(Q.national_movement_seats) || 0)
