@pis_named_loyalties_2026
title: The first declarations resolve individually
new-page: true
on-arrival: {!
const unresolved = Math.max(
    0,
    (Number(Q.rozwoj_association_members) || 0) -
        (Number(Q.rozwoj_definitive_departures) || 0)
);
const firstBatch = Math.min(
    unresolved,
    Math.max(0, Number(Q.pis_seats) || 0),
    Math.max(3, Math.min(8, Math.round(
        (Number(Q.rozwoj_departure_pressure) || 0) / 8
    )))
);
Q.rozwoj_first_departure_batch = firstBatch;
Q.rozwoj_definitive_departures += firstBatch;
Q.rozwoj_cases_resolved += firstBatch + 1;
Q.pis_seats = Math.max(0, (Number(Q.pis_seats) || 0) - firstBatch);
if (
    Q.government_party == "pis" && Q.government_has_confidence &&
    !Q.caretaker_government
) {
    Q.government_support_seats = Math.max(
        0,
        (Number(Q.government_support_seats) || 0) - firstBatch
    );
    Q.coalition_seats = Math.max(
        0,
        (Number(Q.coalition_seats) || 0) - firstBatch
    );
}
Q.rozwoj_pending_seats =
    Math.max(0, Number(Q.rozwoj_pending_seats) || 0) + firstBatch;
Q.other_seats = Math.max(0, Number(Q.other_seats) || 0) + firstBatch;
const association = (Q.rival_group_records || []).find(function(record) {
    return record.id == "rozwoj_plus";
});
if (association) {
    association.exclusive_seats = Q.rozwoj_pending_seats;
    association.legal_status = "association with individual ex-PiS MPs";
}
Q.news_headline = firstBatch +
    " MPs complete individual departures; the rest remain under review";
!}

= A first batch, not a forty-seat transfer

**[+ rozwoj_first_departure_batch +] MPs** have now completed individual
departures. **[+ rozwoj_definitive_departures +] seats** sit outside PiS, still
short of an automatically recognised club. Grzegorz Lorek remains recorded as
PiS-loyal; the named Rozwój+ cases remain visible in the person ledger.

- @pis_loyalties_finish

