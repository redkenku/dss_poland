Q.braun_procedure_score = Math.round(
    Q.braun_legal_preparation +
    Math.max(0, Number(Q.prosecution_independence) || 0) * 0.08 +
    Math.max(0, Number(Q.government_procedural_restraint) || 0) * 0.05 -
    Math.max(0, Number(Q.braun_martyrdom) || 0) * 0.10
);
Q.braun_martyrdom += 2;
Q.braun_stage = Math.max(Number(Q.braun_stage) || 0, 1);
Q.braun_due_time = Math.max(Number(Q.time) + 1, Number(Q.braun_due_time) || -1);
Q.braun_outcome = "Immunity and compelled appearance pending";
Q.public_mood_pending_rule_of_law_salience += 12;
Q.public_mood_pending_rule_of_law_support += 7;
