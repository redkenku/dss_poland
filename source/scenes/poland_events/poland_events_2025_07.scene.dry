on-arrival: government_delivery += 2; ko_relation += 4; barons_dissent -= 3; progressives_dissent += 2; razem_cooperation -= 2; progressive_credibility -= 2; public_trust -= 2; news_headline = "The Left preserves office inside a smaller cabinet"

Our ministers keep their desks and the delivery files already under way. KO
gets the consolidated cabinet it wanted; Razem and the progressive wing see us
choose continuity before renegotiating its purpose.

- @poland_event_queue: Record the consolidated cabinet

@reshuffle_trade
title: Reopen the portfolio table around labour, housing and justice deadlines
subtitle: Return an office to recover its leverage, then complete a real cabinet trade.
view-if: government_has_confidence = 1 and left_in_government = 1
on-arrival: budget_promises += 3; labor_credibility += 4; ko_relation -= 2; party_unity += 2; barons_dissent += 5; government_delivery += 2; left_cabinet_committed = 1; ministry_allocation_mode = "event_reshuffle"; ministry_return_mode = "event_queue"; ministry_reshuffle_previous_count = ministry_count; news_headline = "The July negotiation reopens the whole cabinet table"

We surrender the comfort of the current allocation and price each returned
office in labour, housing and justice deadlines. The factions unite around the
programme; office-holders prepare to defend their ministries at the next table.

- @poland_ministries: Open the cabinet table

@reshuffle_exit
title: Leave the cabinet and offer confidence from outside
subtitle: Give up every ministry, preserve the cabinet and recover an opposition voice.
view-if: government_has_confidence = 1 and left_in_government = 1
on-arrival: {!
Q.left_in_government = 0;
Q.razem_in_government = 0;
Q.left_cabinet_committed = 0;
Q.left_cabinet_model = "Confidence and supply from opposition";
Q.budget = 0;
Q.budget_authority = "Opposition — no state spending authority";
Q.position = "Confidence-and-supply opposition";
Q.coalition_status = "Minority democratic cabinet";
// Cabinet membership survives a portfolio trade. A prior resignation clears
// the party's membership flag even if an old office label survives elsewhere.
const pslStillInCabinet = Boolean(Q.ministry_psl_in_cabinet);
const p2050StillInCabinet = Boolean(Q.ministry_p2050_in_cabinet);
Q.party_unity -= 3;
Q.razem_cooperation += 5;
Q.ko_relation -= 10;
const exitCabinet = {
    labor: ["KO", "Marzena Okła-Drewnowicz"],
    equality: ["KO", "Monika Rosa"],
    housing: ["KO", "Krystyna Sibińska"],
    health: ["KO", "Izabela Leszczyna"],
    digital: p2050StillInCabinet
        ? ["Poland 2050", "Michał Gramatyka"]
        : ["KO", "Jan Grabiec"],
    science: ["KO", "Barbara Nowacka"],
    interior: ["KO", "Marcin Kierwiński"],
    finance: ["KO", "Andrzej Domański"],
    economy: pslStillInCabinet
        ? ["PSL", "Krzysztof Hetman"]
        : ["KO", "Borys Budka"],
    justice: ["KO", "Adam Bodnar"],
    foreign: ["KO", "Radosław Sikorski"],
    agriculture: pslStillInCabinet
        ? ["PSL", "Czesław Siekierski"]
        : ["KO", "Dorota Niedziela"],
    defence: pslStillInCabinet
        ? ["PSL", "Władysław Kosiniak-Kamysz"]
        : ["KO", "Tomasz Siemoniak"]
};
for (const portfolio of Object.keys(exitCabinet)) {
    Q[portfolio + "_minister_party"] = exitCabinet[portfolio][0];
    Q[portfolio + "_minister"] = exitCabinet[portfolio][1];
}
// coalition_seats is cabinet-party membership, not the confidence-and-supply
// tally.  Centrum and the departing Left remain outside unless they hold an
// actual Council of Ministers portfolio.
Q.coalition_seats = Math.min(
    Number(Q.sejm_total) || 460,
    Math.max(0, Number(Q.ko_seats) || 0) +
        (p2050StillInCabinet
            ? Math.max(0, Number(Q.p2050_seats) || 0)
            : 0) +
        (pslStillInCabinet
            ? Math.max(0, Number(Q.psl_seats) || 0)
            : 0)
);
Q.government_support_seats = Q.coalition_seats;
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;
Q.ministry_count = 0;
Q.ministries_finalized = 1;
Q.ministry_allocation_mode = "settled";
Q.news_headline =
    "The Left leaves ministries without immediately bringing down the cabinet";
!}

Our ministers hand their portfolios back and our MPs move outside the cabinet
without toppling it that night. Razem welcomes the distance; KO inherits the
offices and calls the departure a breach of coalition responsibility.

- @poland_event_queue: Record the exit from cabinet

@reshuffle_opposition_audit
title: Stay outside and publish a ministry-by-ministry audit
subtitle: Judge each appointment from opposition and refuse imaginary ownership.
view-if: government_has_confidence = 1 and left_in_government = 0
on-arrival: media_capacity += 3; public_trust += 2; ko_relation -= 2; labor_credibility += 2; news_headline = "Lewica audits the reshuffle from opposition instead of inventing ministries"

We publish who controls every file, deadline and broken promise. The audit
earns trust because it claims no office; KO dislikes having its renewed cabinet
measured by a party outside it.

- @poland_event_queue: Publish the opposition audit

@reshuffle_opposition_entry
title: Negotiate entry around labour, housing and equality
subtitle: Requires a workable KO relationship; opens the real portfolio table.
view-if: government_has_confidence = 1 and left_in_government = 0
choose-if: ko_relation >= 45
unavailable-subtitle: KO will not reopen cabinet posts at the current relationship.
on-arrival: {!
Q.left_in_government = 1;
Q.razem_in_government = 0;
Q.left_cabinet_committed = 1;
Q.coalition_broken = 0;
Q.caretaker_government = 0;
Q.left_cabinet_model =
    "New Left ministers · Razem external support";
Q.position = "Coalition government";
Q.coalition_status = "Reconstituted democratic coalition";
const entryPortfolios = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
const entryPartySeats = {
    KO: Math.max(0, Number(Q.ko_seats) || 0),
    PSL: Math.max(0, Number(Q.psl_seats) || 0),
    "Poland 2050": Math.max(0, Number(Q.p2050_seats) || 0)
};
const entryCabinetParties = [];
for (const portfolio of entryPortfolios) {
    const party = Q[portfolio + "_minister_party"];
    if (
        Object.prototype.hasOwnProperty.call(entryPartySeats, party) &&
        entryCabinetParties.indexOf(party) < 0
    ) {
        entryCabinetParties.push(party);
    }
}
Q.coalition_seats = Math.min(
    Number(Q.sejm_total) || 460,
    entryCabinetParties.reduce(function(total, party) {
        return total + entryPartySeats[party];
    }, 0)
);
Q.budget = Math.max(2, Number(Q.budget) || 0);
Q.budget_authority =
    "Governing coalition — negotiated fiscal capacity";
Q.ministries_finalized = 0;
Q.ministry_allocation_mode = "event_reshuffle";
Q.ministry_return_mode = "event_queue";
Q.ministry_reshuffle_previous_count = 0;
Q.ko_relation -= 2;
Q.party_unity -= 2;
Q.news_headline =
    "Lewica opens a transparent negotiation to enter the surviving cabinet";
!}

We offer entry around labour, housing and equality, then send the actual
portfolios to a transparent allocation. KO gains a possible majority partner;
our opposition wing demands proof that ministries will buy more than titles.

- @poland_ministries: Open the cabinet-entry table

@formation_return_2025
title: Re-enter a rebuilt democratic cabinet under a written delivery protocol
subtitle: Offer cabinet entry and Left confidence votes; the nominee must still win investiture.
view-if: government_has_confidence = 0
on-arrival: {!
const total = Math.max(1, Number(Q.sejm_total) || 460);
const committed = Number(Q.left_committed_seats);
Q.formation_2025_left_pool = Math.max(
    0,
    Math.min(
        total,
        Number.isFinite(committed)
            ? Math.round(committed)
            : Math.round(Number(Q.left_seats) || 0)
    )
);
Q.formation_2025_mode = "Return to cabinet";
Q.formation_2025_candidate =
    Q.prime_minister && Q.prime_minister != "None"
        ? Q.prime_minister
        : (Q.ko_leader || "KO nominee");
Q.formation_2025_left_yes = Q.formation_2025_left_pool;
Q.formation_2025_left_no = 0;
Q.formation_2025_left_abstain = 0;
Q.formation_2025_left_cabinet = 1;
Q.formation_in_progress = 1;
Q.budget_promises += 3;
Q.government_coalition_dissent += 3;
Q.ko_relation += 5;
Q.razem_cooperation -= 4;
Q.news_headline =
    "A written protocol becomes Lewica's proposal to the Palace";
if (typeof polandCoalitionModel != "undefined") {
    polandCoalitionModel.reconcile(Q);
    polandCoalitionModel.initialise(Q, {
        mode: "reformation", candidate: Q.formation_2025_candidate,
        candidate_family: "ko", sponsor: "ko", seed_current: true,
        roles: {ko: "cabinet", p2050: "cabinet", psl: "cabinet",
            lewica: "cabinet"},
        submit_scene: "formation_designation_2025",
        submit_label: "Take this cabinet agreement to the Palace"
    });
}
!}

We propose returning to cabinet under a dated delivery protocol and commit our
votes to the nominee. The Palace must still designate and the Sejm must still
invest; Razem sees us rebuilding the arrangement that just failed.

{!<div class="coalition-builder-host" data-coalition-mode="reformation"></div>!}

- @formation_designation_2025: Take the proposal to the Palace

