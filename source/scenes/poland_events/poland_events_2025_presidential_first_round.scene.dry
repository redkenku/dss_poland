);
if (Q.pres_2025_stanowski_breakout) {
    Q.kanal_zero_capacity += 4;
    Q.p2050_coalition_dissent += 2;
}
const displayTotal = Object.keys(raw).reduce(function(sum, key) {
    return sum + (Number(Q["pres_2025_r1_display_" + key]) || 0);
}, 0);
Q.pres_2025_r1_display_other = Math.round(
