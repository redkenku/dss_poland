        Q.party_unity += candidateLevel == 1 ? 3 :
            (candidateLevel == 2 ? 4 : 6);
        Q.organiser_energy += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 3 : 5);
        Q.media_capacity += candidateLevel == 1 ? 1 :
            (candidateLevel == 2 ? 2 : 4);
        Q.media_access += candidateLevel == 1 ? 1 :
            (candidateLevel == 2 ? 2 : 4);
        Q.leadership_authority += candidateLevel == 1 ? 3 :
            (candidateLevel == 2 ? 4 : 6);
        Q.list_confidence += candidateLevel == 1 ? 5 :
            (candidateLevel == 2 ? 6 : 8);
        Q.winner_reputation += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 4 : 6);
        Q.electoral_viability += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 3 : 5);
        Q.tactical_desertion_to_ko = Math.max(
            0,
            Q.tactical_desertion_to_ko - (candidateLevel == 1 ? 2 : 4)
        );
        Q.tactical_desertion_to_abstention = Math.max(
            0,
            Q.tactical_desertion_to_abstention -
                (candidateLevel == 1 ? 1 : 3)
        );
        Q.barons_dissent -= candidateLevel == 1 ? 1 : 2;
        Q.spring_dissent -= candidateLevel == 1 ? 1 : 2;
        Q.progressives_dissent -= candidateLevel == 1 ? 1 : 2;
    }
    Q.pres_feedback_tactical_current =
        Q.pres_feedback_tactical_flight;
    if (Q.pres_2025_zandberg_claim) {
        Q.razem_strength += 2;
    }
    Q.pres_2025_feedback_applied = 1;
}
// The Status column belongs to this table, so it is written here rather than a
// fortnight later by the runoff. The second ballot overwrites only its own two.
for (const key of [
    "ko", "right", "left", "razem", "mentzen",
    "braun", "holownia", "stanowski"
]) {
    let status25 = "eliminated";
    if (firstRoundWinnerKey == key) {
        status25 = "elected";
    } else if (!firstRoundWinnerKey &&
        (ranked[0] == key || ranked[1] == key)) {
        status25 = "runoff";
    }
    if (key == "razem" && Q.pres_2025_united_left) {
        status25 = "no candidate";
    }
    Q["pres_2025_status_" + key] = status25;
}
Q.pres_2025_round_one_done = 1;
const presidentialMapModel25 = (typeof window !== "undefined"
    ? window : globalThis).polandElectionModel;
presidentialMapModel25.archivePresident(Q,
    presidentialMapModel25.allocatePresident({
        state: Q,
        key: "2025-05-r1",
        label: "2025 presidential election — first round",
        round: 1,
        candidates: [
            {id: "ko", name: Q.pres_2025_ko_candidate, family: "ko",
                share: Q.pres_2025_r1_display_ko},
            {id: "right", name: Q.pres_2025_right_candidate, family: "pis",
                share: Q.pres_2025_r1_display_right},
            {id: "left", name: Q.pres_2025_left_candidate, family: "left",
                share: Q.pres_2025_r1_display_left},
            {id: "razem", name: Q.pres_2025_razem_candidate, family: "left",
                share: Q.pres_2025_united_left ? 0 : Q.pres_2025_r1_display_razem},
            {id: "mentzen", name: Q.pres_2025_konf_candidate, family: "konf",
                share: Q.pres_2025_r1_display_mentzen},
            {id: "braun", name: "Grzegorz Braun", family: "konf",
                share: Q.pres_2025_r1_display_braun},
            {id: "holownia", name: Q.pres_2025_centre_candidate,
                family: "p2050", share: Q.pres_2025_r1_display_holownia},
            {id: "stanowski", name: "Krzysztof Stanowski", family: "other",
                share: Q.pres_2025_r1_display_stanowski},
            {id: "other", name: "Other candidates", family: "other",
                share: Q.pres_2025_r1_display_other}
        ]
    })
);
Q.news_headline = Q.pres_2025_first_round_winner
    ? Q.pres_2025_winner + " wins the presidency in the first round"
    : Q.pres_2025_finalist_a + " and " +
        Q.pres_2025_finalist_b + " reach the runoff";
!}

