@oct21_razem
title: Ratify Razem's lead with protected internal currents
subtitle: Available only while Razem still commands the merger and holds a bureau seat.
view-if: razem_merged = 1
choose-if: merger_leader = "Razem" and (zandberg_advisor = 1 or biejat_advisor = 1 or zawisza_advisor = 1 or matysiak_advisor = 1)
unavailable-subtitle: Razem no longer has both the mandate and bureau control needed to force ratification.
on-arrival: {!
Q.merger_leader = "Razem";
Q.left_project = "Ratified Razem-led Nowa Lewica";
Q.razem_dissent -= 8;
Q.razem_escalation_stage = 0;
Q.razem_grievance_memory = 0;
Q.razem_defection_readiness = 0;
Q.razem_demand_answered = 1;
Q.party_unity += 5;
Q.barons_dissent += 6;
Q.spring_dissent -= 3;
if (!Q.spring_transfer_complete) {
    const springTransfer = Math.max(0, Number(Q.spring_strength) || 0);
    const laborTransfer = springTransfer * 0.40;
    const progressivesTransfer = springTransfer - laborTransfer;
    const springMps = Math.max(
        0,
        Math.round(Number(Q.spring_estimated_mps) || 0)
    );
    const laborMps = Math.round(springMps * 0.40);
    Q.labor_strength += laborTransfer;
    Q.progressives_strength += progressivesTransfer;
    Q.labor_estimated_mps += laborMps;
    Q.progressives_estimated_mps += springMps - laborMps;
    Q.spring_exit_strength = springTransfer;
    Q.spring_transfer_labor = laborTransfer;
    Q.spring_transfer_progressives = progressivesTransfer;
    Q.spring_transfer_complete = 1;
    Q.spring_strength = 0;
    Q.spring_estimated_mps = 0;
    Q.spring_active = 0;
    Q.spring_in_left = 0;
    Q.spring_merged = 1;
    Q.factions = Q.factions.filter(function(caucus) {
        return caucus !== "spring";
    });
}
Q.barons_name = "Nowa Lewica establishment";
Q.labor_name = "Lewica Pracy parliamentary network";
Q.progressives_name = "New Left progressives";
Q.progressives_leader = "Robert Biedroń";
Q.progressives_broker =
    "Krzysztof Śmiszek, Katarzyna Kotula, Krzysztof Gawkowski, " +
    "Wanda Nowicka and the former Wiosna candidate network";
Q.left_party_name = "Lewica Razem";
Q.news_headline =
    "Congress ratifies Razem's lead over one party with protected currents";
!}

= The congress leaves a new party centre

The vote leaves a new centre of gravity inside the party. The leaders who lost
control now have to answer the new map from outside the chairmanship.

