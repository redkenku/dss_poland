view-if: continuous_campaign = 1 and year = 2026 and month = 5 and caretaker_government = 0 and marriage_reform_settled = 0
on-arrival: {!
let pslSupportShare =
    0.08 + Math.max(0, Number(Q.psl_relation) || 0) / 125;
Q.partnership_strategy =
    "Open roll call without a prior social-rights bargain";
if (
    Q.psl_protocol_2025 ==
    "Rural services and farm bargaining; no new social-policy veto"
) {
    pslSupportShare += 0.18;
    Q.partnership_strategy =
        "Rural-social protocol with no additional rights veto";
}
if (
    Q.psl_protocol_2025 ==
    "Published bill-by-bill support ledger"
) {
    pslSupportShare += 0.10;
    Q.partnership_strategy =
        "Published bill-by-bill partnership bargain";
}
if (
    Q.psl_protocol_2025 ==
    "No renegotiation beyond the 2023 agreement"
) {
    pslSupportShare -= 0.12;
    Q.partnership_strategy =
        "No renewed PSL bargain";
}
pslSupportShare = Math.max(
    0.04,
    Math.min(0.82, pslSupportShare)
);
const partnershipRoll =
    Math.floor((this.random.uint32() / 4294967296) * 9) - 4;
const leftVotes =
    Math.max(0, Number(Q.left_seats) || 0) +
    Math.max(0, Number(Q.left_splinter_support_votes) || 0);
const koVotes = Math.round(
    Math.max(0, Number(Q.ko_seats) || 0) * 0.82
);
const centreVotes = Math.round(
    (
        Math.max(0, Number(Q.p2050_seats) || 0) +
        Math.max(0, Number(Q.centrum_seats) || 0)
    ) * 0.62
);
const pslVotes = Math.round(
    Math.max(0, Number(Q.psl_seats) || 0) * pslSupportShare
);
Q.partnership_sejm_yes = Math.max(
    0,
    Math.min(
        460,
        leftVotes + koVotes + centreVotes +
        pslVotes + partnershipRoll
    )
);
Q.partnership_sejm_no = Math.max(
    0,
    Math.min(
        460 - Q.partnership_sejm_yes,
        Math.round(
            (Number(Q.pis_seats) || 0) +
            (Number(Q.konf_seats) || 0) +
            (Number(Q.korona_seats) || 0) +
            Math.max(
                0,
                (Number(Q.psl_seats) || 0) - pslVotes
            ) +
            Math.max(
                0,
                (Number(Q.ko_seats) || 0) - koVotes
            )
        )
    )
);
Q.partnership_sejm_abstain = Math.max(
    0,
    460 - Q.partnership_sejm_yes - Q.partnership_sejm_no
);
Q.partnership_sejm_passed =
    Q.partnership_sejm_yes > Q.partnership_sejm_no ? 1 : 0;
Q.public_mood_pending_lgbt_equality_salience += 14;
Q.public_mood_pending_lgbt_equality_support += 9;
Q.public_mood_pending_lgbt_equality_backlash += 7;
Q.news_headline = Q.partnership_sejm_passed
    ? "The partnership compromise passes " +
        Q.partnership_sejm_yes + "–" + Q.partnership_sejm_no
    : "The partnership compromise fails " +
        Q.partnership_sejm_yes + "–" + Q.partnership_sejm_no;
!}

= May 2026 — Increment or ceiling

<span class="party-lewica"><b>Katarzyna Kotula</b></span>, Lewica's equality advocate, brings the Sejm a limited
legal status for couples rather than marriage equality. **Władysław
Kosiniak-Kamysz**, the PSL president, has released some of his deputies and
held others back; KO and the centrist clubs are divided less noisily. The
strategy behind the bill was **[+ partnership_strategy +]**.

Now the board records **[+ partnership_sejm_yes +] yes · [+
partnership_sejm_no +] no · [+ partnership_sejm_abstain +] abstain**.

[? if partnership_sejm_passed: The limited legal status now goes to the
President. It is a parliamentary victory, not yet a law: Lewica must decide
whether to defend the compromise, call it a floor or work directly for the
signature.?]
[? if not partnership_sejm_passed: No new status has been enacted. Lewica can
make the dissenters answer at home, reopen a narrower bargain with PSL or leave
Parliament and rebuild the equality coalition.?]

- @partnership_claim
- @partnership_pressure
- @partnership_palace
- @partnership_failed_rollcall
- @partnership_failed_bargain
- @partnership_failed_movement

@partnership_claim
title: Claim a durable partial right and prepare implementation
