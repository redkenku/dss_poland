view-if: continuous_campaign = 1 and year = 2023 and month = 10 and defence_command_2023_done = 0
on-arrival: {!
Q.defence_command_2023_done = 1;
Q.defence_readiness = Math.max(
    0, (Number(Q.defence_readiness) || 50) - 8
);
Q.civil_military_trust = Math.max(
    0, (Number(Q.civil_military_trust) || 50) - 14
