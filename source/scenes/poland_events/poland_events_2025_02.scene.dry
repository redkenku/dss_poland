Q.reckoning_pm_pressure = 10 + 6 * Q.reckoning_fugitives;
Q.institutional_trust = Math.max(
    0, (Number(Q.institutional_trust) || 0) - 2
);
Q.public_mood_pending_rule_of_law_salience += 10;
Q.public_mood_pending_rule_of_law_backlash += 6;
