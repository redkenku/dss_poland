@snap_attempt_two_vote
title: Second-attempt confidence vote
new-page: true
on-arrival: {!
const attemptTwoRoll =
    Math.floor((this.random.uint32() / 4294967296) * 7) - 3;
Q.snap_formation_variance = attemptTwoRoll;
Q.confidence_candidate = Q.snap_formation_candidate;
Q.confidence_yes = Math.max(
    0,
    Math.min(
        460,
        Q.snap_formation_base +
        (Number(Q.snap_formation_left_votes) || 0) +
        attemptTwoRoll
    )
);
Q.confidence_abstain = Math.max(
    0,
    Math.min(20, 460 - Q.confidence_yes)
);
Q.confidence_no = Math.max(
    0,
    460 - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present = 460;
Q.confidence_threshold = 231;
Q.government_has_confidence =
    Q.confidence_yes >= 231 ? 1 : 0;
Q.snap_formation_attempt = 2;
!}

**[+ confidence_yes +] yes · [+ confidence_no +] no · [+
confidence_abstain +] abstain.**

- @snap_formation_success
- @snap_formation_attempt_three

@snap_formation_attempt_three
title: Third formation attempt — simple majority
new-page: true
view-if: government_has_confidence = 0
call: poland_normalize
on-arrival: {!
const incumbentPresident = String(Q.president_name || "");
const electedPresidentIsInOffice =
    incumbentPresident.length > 0 &&
    incumbentPresident == String(Q.pres_2025_winner || "");
/*
 * Before the August 2025 inauguration, the election result describes the
 * president-elect, not the office-holder exercising Article 155. Duda and the
 * drawn PiS-backed winner are right-aligned incumbents; otherwise the election
 * result flag matters only once that winner's name is actually in the Palace.
 */
const hostileThird =
    incumbentPresident == "Andrzej Duda" ||
    incumbentPresident == String(Q.pres_2025_right_candidate || "") ||
    (
        electedPresidentIsInOffice &&
        Boolean(Q.pres_2025_hostile_president)
    );
Q.snap_third_player_nomination_authority =
    Boolean(Q.left_president) && electedPresidentIsInOffice ? 1 : 0;
if (hostileThird) {
    Q.snap_third_hostile_nominee = 1;
    Q.snap_formation_candidate =
        Q.pis_split ? "Mateusz Morawiecki" : "Beata Szydło";
    const thirdKonfPledge =
        Q.coalition_viable_pis_konf &&
    (Number(Q.rival_relation_pis_konf) || 0) >= 50
            ? Math.max(0, Number(Q.konf_seats) || 0)
            : 0;
    const thirdPslRightPledge =
        Q.coalition_viable_pis_psl &&
    (Number(Q.rival_relation_pis_psl) || 0) >= 55 &&
        (Number(Q.psl_coalition_dissent) || 0) < 65
            ? Math.max(0, Number(Q.psl_seats) || 0)
            : 0;
    Q.snap_formation_base =
        Math.max(0, Number(Q.pis_seats) || 0) + thirdKonfPledge +
        thirdPslRightPledge;
    Q.snap_formation_pledge_basis =
        "PiS" + (thirdKonfPledge ? " · Konfederacja pact" : "") +
        (thirdPslRightPledge ? " · PSL pact" : "");
    Q.snap_psl_cabinet_committed =
        thirdPslRightPledge > 0 ? 1 : 0;
    Q.snap_p2050_cabinet_committed = 0;
    Q.snap_centrum_cabinet_committed = 0;
    Q.snap_third_nomination_reason =
        "A hostile Palace tests a right-wing nominee under Article 155.";
} else {
    Q.snap_third_hostile_nominee = 0;
    const thirdPslPledge =
        Q.coalition_viable_ko_psl &&
    (Number(Q.rival_relation_ko_psl) || 0) >= 55 &&
        (Number(Q.psl_coalition_dissent) || 0) < 65
            ? Math.max(0, Number(Q.psl_seats) || 0)
            : 0;
    const thirdP2050Pledge =
        Q.coalition_viable_ko_p2050 &&
    (Number(Q.rival_relation_ko_p2050) || 0) >= 55 &&
        (Number(Q.p2050_coalition_dissent) || 0) < 65
            ? Math.max(0, Number(Q.p2050_seats) || 0)
            : 0;
    const thirdCentrumPledge =
        (Number(Q.centrum_relation) || 0) >= 55
            ? Math.max(0, Number(Q.centrum_seats) || 0)
            : 0;
    Q.snap_formation_base =
        Math.max(0, Number(Q.ko_seats) || 0) + thirdPslPledge +
        thirdP2050Pledge + thirdCentrumPledge;
    Q.snap_formation_pledge_basis =
        "KO" + (thirdPslPledge ? " · PSL pact" : "") +
        (thirdP2050Pledge ? " · Poland 2050 pact" : "") +
        (thirdCentrumPledge ? " · Centrum pact" : "");
    Q.snap_psl_cabinet_committed = thirdPslPledge > 0 ? 1 : 0;
    Q.snap_p2050_cabinet_committed =
        thirdP2050Pledge > 0 ? 1 : 0;
    Q.snap_centrum_cabinet_committed =
        thirdCentrumPledge > 0 ? 1 : 0;
    if (Q.snap_third_player_nomination_authority) {
        Q.snap_formation_candidate = "Undecided compromise nominee";
        Q.snap_third_nomination_reason =
            "A Lewica President holds the Article 155 nomination power.";
    } else if (incumbentPresident == "Szymon Hołownia") {
        Q.snap_formation_candidate = "Katarzyna Pełczyńska-Nałęcz";
        Q.snap_third_nomination_reason =
            "President Hołownia chooses his party's institutional compromise candidate.";
    } else if (incumbentPresident == "Adrian Zandberg") {
        Q.snap_formation_candidate = "Magdalena Biejat";
        Q.snap_third_nomination_reason =
            "President Zandberg chooses a social candidate able to seek wider support.";
    } else if (incumbentPresident == "Rafał Trzaskowski") {
        Q.snap_formation_candidate =
            Number(Q.psl_seats) >= Number(Q.p2050_seats)
                ? "Władysław Kosiniak-Kamysz"
                : "Katarzyna Pełczyńska-Nałęcz";
        Q.snap_third_nomination_reason =
            "President Trzaskowski chooses the stronger available centrist bridge; Lewica may respond but not substitute its nominee.";
    } else if (Number(Q.p2050_seats) > Number(Q.psl_seats)) {
        Q.snap_formation_candidate = "Katarzyna Pełczyńska-Nałęcz";
        Q.snap_third_nomination_reason =
            "The Palace selects the larger centrist partner's compromise candidate.";
    } else if (Number(Q.psl_seats) > 0) {
        Q.snap_formation_candidate = "Władysław Kosiniak-Kamysz";
        Q.snap_third_nomination_reason =
            "The Palace selects the agrarian compromise with the stronger parliamentary base.";
    } else {
        Q.snap_formation_candidate = "Magdalena Biejat";
        Q.snap_third_nomination_reason =
            "With no centrist bridge left, the Palace tests a social compromise nominee.";
    }
}
Q.snap_formation_base = Math.max(
    0,
    Math.min(460, Math.round(Q.snap_formation_base))
);
Q.snap_formation_left_votes = 0;
Q.snap_formation_left_abstentions = 0;
Q.snap_left_cabinet_commitment = 0;
Q.news_headline =
    hostileThird
        ? Q.president_name + " names " +
            Q.snap_formation_candidate + " for the third attempt"
        : (Q.snap_third_player_nomination_authority
            ? "The Lewica President must name an Article 155 nominee"
            : Q.president_name + " independently names " +
                Q.snap_formation_candidate);
!}

The available nominee begins with **[+ snap_formation_base +]** expected yes
votes from **[+ snap_formation_pledge_basis +]**. [? if
snap_third_player_nomination_authority: President **[+ president_name +]** must
now choose the Article 155 nominee.?]
[? if not snap_third_player_nomination_authority: **[+
snap_third_nomination_reason +]** Lewica controls only its response.?]
Unlike the first two stages, this vote uses a simple majority of votes cast
with at least half of Deputies present. Lewica may support, oppose or abstain.

