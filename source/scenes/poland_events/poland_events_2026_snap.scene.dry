[? if snap_election_common_centre_2027_seats > 0: <div class="election-table-row election-tree-row--committee election-tree-row--broad"><span class="party party-ko">Wspólne Centrum 2027</span><span>[+ snap_election_common_centre_2027_vote +]%</span><b>[+ snap_election_common_centre_2027_seats +]</b><span>one certified coalition list</span></div>?]
[? if snap_election_third_way_2027_seats > 0: <div class="election-table-row election-tree-row--committee election-tree-row--broad"><span class="party party-third-way">Trzecia Droga 2027</span><span>[+ snap_election_third_way_2027_vote +]%</span><b>[+ snap_election_third_way_2027_seats +]</b><span>one certified coalition list</span></div>?]
<div class="election-table-row [+ result_snap_ko_row_class +]"><span class="party party-ko">Koalicja Obywatelska</span><span>[+ snap_election_ko_vote +]%</span><b>[+ ko_seats +]</b><span>[? if snap_result_broad_list or snap_election_common_centre_2027_seats > 0: common-list component?][? if not snap_result_broad_list and snap_election_common_centre_2027_seats = 0: certified committee?]</span></div>
[? if result_member_po_sejm > 0 and result_member_po_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-ko">[+ result_member_po_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_po_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_nowoczesna_sejm > 0 and result_member_nowoczesna_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-ko">[+ result_member_nowoczesna_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_nowoczesna_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_ipl_sejm > 0 and result_member_ipl_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-ko">[+ result_member_ipl_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ipl_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_greens_sejm > 0 and result_member_greens_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-ko">[+ result_member_greens_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_greens_sejm +]</b><span>KO member party</span></div>?]
[? if result_member_ko_party_sejm > 0 and result_member_ko_party_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-ko">[+ result_member_ko_party_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ko_party_sejm +]</b><span>consolidated KO party</span></div>?]
[? if result_member_porozumienie_sejm > 0 and result_member_porozumienie_family = "ko": <div class="election-table-row [+ result_snap_ko_member_class +]"><span class="party party-agreement">[+ result_member_porozumienie_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_porozumienie_sejm +]</b><span>KO list partner</span></div>?]
[? if result_member_ko_independent_parliamentarians_sejm > 0: <div class="election-table-row [+ result_snap_ko_member_class +]"><span>KO-affiliated independents</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_ko_independent_parliamentarians_sejm +]</b><span>non-party nominees</span></div>?]
[? if snap_third_way_joint_list = 1 and snap_election_third_way_2027_seats = 0 and snap_election_common_centre_2027_seats = 0 and not result_prawica_member_psl: <div class="election-table-row [+ result_snap_third_way_row_class +]"><span class="party party-third-way">Trzecia Droga</span><span>[+ snap_election_third_way_vote +]%</span><b>[+ p2050_seats + psl_seats +]</b><span>[? if snap_result_broad_list: common-list component?][? if not snap_result_broad_list: joint committee?]</span></div><div class="election-table-row [+ result_snap_third_way_member_class +]"><span class="party party-p2050">Polska 2050</span><span>[+ snap_election_p2050_vote +]%</span><b>[+ result_member_p2050_party_sejm +]</b><span>Third Way member</span></div><div class="election-table-row [+ result_snap_third_way_member_class +]"><span class="party party-psl">PSL</span><span>[+ snap_election_psl_vote +]%</span><b>[+ result_member_psl_party_sejm +]</b><span>Third Way member</span></div>?]
[? if result_member_kukiz15_sejm > 0 and result_member_kukiz15_family = "kp": <div class="election-table-row [+ result_snap_third_way_member_class +]"><span class="party party-kukiz">[+ result_member_kukiz15_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kukiz15_sejm +]</b><span>member party</span></div>?]
[? if result_member_kp_partners_sejm > 0 and result_member_kp_partners_family = "kp": <div class="election-table-row [+ result_snap_third_way_member_class +]"><span class="party party-ued">[+ result_member_kp_partners_name +]</span><span aria-label="no separate ballot share">—</span><b>[+ result_member_kp_partners_sejm +]</b><span>member party</span></div>?]
