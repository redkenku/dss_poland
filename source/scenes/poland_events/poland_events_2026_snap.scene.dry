- @snap_attempt_two_reject

@snap_attempt_two_support
title: Supply confidence to the Sejm nominee without taking ministries
view-if: snap_formation_nominee_is_left = 0
on-arrival: snap_formation_left_votes = left_committed_seats; snap_left_cabinet_commitment = 0; ko_relation += 4; party_unity += 1; news_headline = "Lewica supplies the second-attempt majority from outside cabinet"
