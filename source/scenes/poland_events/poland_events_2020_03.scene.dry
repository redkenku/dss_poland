title: March 2020

@covid
# prose-audit: Grade A — The lockdown is framed from Lewica's opposition role, with distinct social, legal, unity and liberty costs.
title: The first lockdown
face-image: img/poland/events/covid-lockdown-2020.webp
new-page: true
on-arrival: {!
Q.covid_event_done = 1;
Q.pandemic_deaths_pressure += 5;
const covidGovernment = Q.government_party == "lewica"
    ? "left"
    : (["independent", "other"].includes(Q.government_party)
        ? "other" : String(Q.government_party || ""));
const covidGovernmentMomentum = covidGovernment + "_poll_momentum";
if (Number.isFinite(Number(Q[covidGovernmentMomentum]))) {
    Q[covidGovernmentMomentum] =
        (Number(Q[covidGovernmentMomentum]) || 0) - 2;
    Q.government_coalition_dissent += 4;
}
Q.united_right_cohesion -= 3;
Q.covid_anti_system_pressure += 10;
Q.konf_org_resources += 3;
Q.konf_org_income += 1;
