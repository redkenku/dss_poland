Q.far_right_agenda += trustedVaccination ? 1 : 3;
Q.public_mood_pending_vaccination_support += -8;
Q.public_mood_pending_vaccination_salience += 8;
Q.news_headline = gowinLeft
    ? "Gowin leaves government as Konfederacja recruits from pandemic anger"
    : "The coalition holds as Konfederacja recruits from pandemic anger";
