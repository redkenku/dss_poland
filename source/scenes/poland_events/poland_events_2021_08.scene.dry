    Math.max(0, Math.round(Number(Q.p2050_seats) || 0)) +
    leftCommitted;
const porozumienieSupport = Math.min(
    460,
    Math.max(0, Math.round(Number(Q.porozumienie_seats) || 0))
);
Q.aug21_vonc_left_can_sponsor = leftCommitted >= 46 ? 1 : 0;
Q.aug21_vonc_left_sponsors = leftCommitted;
Q.aug21_vonc_left_votes = leftCommitted;
Q.aug21_vonc_democratic_base = democraticBase;
Q.aug21_vonc_porozumienie_support = porozumienieSupport;
Q.aug21_vonc_other_support = Math.max(
    0,
    Math.round(Number(Q.other_seats) || 0)
);
const konfSeats = Math.max(0, Math.round(Number(Q.konf_seats) || 0));
Q.aug21_vonc_konf_support = Math.min(
    konfSeats,
    Math.max(
        0,
        Math.round(konfSeats * 0.25) +
            (Number(Q.far_right_agenda) >= 60 ? 1 : 0)
    )
);
Q.aug21_technical_cabinet = 0;
!}

= Article 158 — dismissal requires a successor

President **[+ president_name +]** cannot file, vote on or order a Sejm
motion. Under Article 158 the Palace must appoint a successor only if at least
46 deputies sponsor one named candidate and 231 deputies actually elect that
person.

The democratic clubs and Porozumienie currently declare **[+
aug21_vonc_democratic_base +] + [+ aug21_vonc_porozumienie_support +] + [+
aug21_vonc_other_support +]** votes. Konfederacja's **[+
aug21_vonc_konf_support +]** potentially available deputies are a bounded
free-vote estimate, not the whole caucus assigned to a PSL prime minister.

[? if aug21_vonc_left_can_sponsor: Lewica still controls the 46 signatures
needed to force its own motion.?]
[? if not aug21_vonc_left_can_sponsor: Lewica's divided parliamentary family
cannot supply 46 signatures. KO will file the motion instead.?]

- @aug21_vonc_file
- @aug21_vonc_compact
- @aug21_vonc_ai

