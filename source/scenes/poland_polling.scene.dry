// Every competing branch for those months carries `legacy_congestion_pending
// = 0`, because Dendry resolves simultaneously-true go-to branches at random.
const openFiles = function(flags) {
    return flags.reduce(function(count, open) {
        return count + (open ? 1 : 0);
    }, 0);
};
const may2020Open = openFiles([
    !Q.ko_candidate_replacement_2020_done,
