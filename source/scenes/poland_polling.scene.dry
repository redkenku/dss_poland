title: Rebuild the nationwide likely-voter poll
new-page: true
call: poland_normalize
on-arrival: {!
const finitePolling = function(value, fallback) {
    if (value === null || value === undefined) return fallback;
    if (typeof value == "string" && value.trim() == "") return fallback;
    const numericValue = Number(value);
    return Number.isFinite(numericValue) ? numericValue : fallback;
};
const clampPolling = function(value, low, high) {
    return Math.max(low, Math.min(high, finitePolling(value, low)));
};
const publicMoodPolling = (typeof window !== "undefined"
    ? window : globalThis).polandPublicMoodModel;
if (publicMoodPolling) {
    publicMoodPolling.resolve(Q, {advance: false, finalize: true});
}
const pollMonthKey =
    finitePolling(Q.year, 2019) * 100 + finitePolling(Q.month, 1);
const pollMonthIndex =
    finitePolling(Q.year, 2019) * 12 + finitePolling(Q.month, 1);
const shouldRefreshPolling =
    finitePolling(Q.poll_state_month_key, -1) != pollMonthKey;

// Several dated-event and election-readiness routes can revisit this scene in
// one calendar month. The electorate, sample, momentum decay and danger clock
// are monthly state, so only the first visit may rebuild them.
if (shouldRefreshPolling) {
const partyIds = [
    "left", "pis", "ko", "psl", "konf", "p2050", "p0", "other"
];
const namedPartyIds = [
    "left", "pis", "ko", "psl", "konf", "p2050", "p0"
];
const dynamicPartyIds = [
    "sld_breakaway",
    "social_patriot",
    "spring_breakaway",
    "labor_left",
    "young_left",
    "razem",
    "pps",
    "left_coalition",
    "democratic_list",
    "third_way",
    "tak_rozwoj",
    "centrum",
    "rozwoj",
    "korona",
    "ko_splinter",
    "suwerenna",
    "porozumienie",
    "republikanie",
    "odnowa",
    "kukiz",
    "new_hope",
    "national_movement",
    "duda",
    "social_conservative",
    "right_2027",
    "common_centre_2027",
    "third_way_2027",
    "social_conservative_2027"
];
const electionPartyIds = partyIds.concat(dynamicPartyIds);
const partyNames = {
    left: "Lewica",
    pis: "PiS",
    ko: "KO",
    psl: "PSL",
    konf: "Konfederacja",
    p2050: "Polska 2050",
    p0: "Partia Zero",
    other: "Inni"
};
const isFormationEra = Q.scenario_mode == "formation_2023";
const activeParty = function(id) {
    if (id == "p0") {
        return !!Q.p0_formed;
    }
    return id != "p2050" ||
        (!!Q.p2050_emerged && !Q.p2050_joined_left);
};

// These are societal segments, not mutually exclusive Left constituencies.
// Their authored sizes sum to 100. Every active party receives an explicit
// score and share inside every segment.
const groupDefinitions = [
    {
        id: "metropolitan_liberals",
        size: 12,
        turnout: 72,
        economicIdeal: 44,
        culturalIdeal: 20,
        scores: {
            left: 24, pis: 10, ko: 44, psl: 2,
            konf: 6, p2050: 14, p0: 5, other: 5
        }
    },
    {
        id: "liberal_professionals",
        size: 11,
        turnout: 74,
        economicIdeal: 64,
        culturalIdeal: 35,
        scores: {
            left: 12, pis: 16, ko: 52, psl: 5,
            konf: 8, p2050: 18, p0: 6, other: 5
        }
    },
    {
        id: "public_service_families",
        size: 12,
        turnout: 69,
        economicIdeal: 35,
        culturalIdeal: 46,
        scores: {
            left: 20, pis: 38, ko: 28, psl: 7,
            konf: 4, p2050: 9, p0: 4, other: 5
        }
    },
    {
        id: "industrial_logistics",
        size: 13,
        turnout: 63,
        economicIdeal: 32,
        culturalIdeal: 66,
        scores: {
            left: 18, pis: 48, ko: 18, psl: 7,
            konf: 9, p2050: 5, p0: 8, other: 3
        }
    },
    {
        id: "provincial_welfare",
        size: 15,
        turnout: 60,
        economicIdeal: 30,
        culturalIdeal: 75,
        scores: {
            left: 9, pis: 55, ko: 15, psl: 10,
            konf: 9, p2050: 7, p0: 9, other: 3
        }
    },
    {
        id: "rural_localists",
        size: 15,
        turnout: 65,
        economicIdeal: 36,
        culturalIdeal: 80,
        scores: {
            left: 5, pis: 55, ko: 9, psl: 22,
            konf: 7, p2050: 6, p0: 8, other: 2
        }
    },
    {
        id: "older_welfare_households",
        size: 12,
        turnout: 74,
        economicIdeal: 24,
        culturalIdeal: 82,
        scores: {
            left: 6, pis: 61, ko: 18, psl: 11,
            konf: 2, p2050: 4, p0: 3, other: 2
        }
    },
    {
        id: "anti_establishment_youth",
        size: 10,
        turnout: 51,
        economicIdeal: 72,
        culturalIdeal: 51,
        scores: {
            left: 14, pis: 18, ko: 15, psl: 3,
            konf: 40, p2050: 12, p0: 26, other: 6
        }
    }
];
Q.voter_groups = groupDefinitions.map(function(group) {
    return group.id;
});

const campaignAudienceBaseline = {
    workers_support: 15,
    public_sector_support: 18,
    young_support: 20,
    women_support: 15,
    urban_progressive_support: 27,
    rural_support: 5,
    pensioner_support: 6,
    turnout_readiness: 58,
    party_unity: 58,
    public_trust: 43,
    media_capacity: 16,
    local_network: 42,
    labor_credibility: 46,
    progressive_credibility: 50,
    feminist_trust: 44,
    household_security: 45,
    government_delivery: 0,
    kpo_public_credit: 0,
    far_right_agenda: 32,
    minority_safety: 56,
    judicial_legitimacy: 36,
    electoral_viability: 62,
    winner_reputation: 54,
    issue_ownership: 42,
    leadership_authority: 53,
    coalition_blur: 8,
    media_access: 31,
    list_confidence: 61,
    economic_growth: 4.5,
    inflation: 2.6,
    unemployment: 5.1,
    national_turnout_climate: 61
};
const formationAudienceBaseline = {
    workers_support: 20,
    public_sector_support: 24,
    young_support: 17,
    women_support: 19,
    urban_progressive_support: 22,
    rural_support: 8,
    pensioner_support: 8,
    turnout_readiness: 67,
    party_unity: 51,
    public_trust: 39,
    media_capacity: 20,
    local_network: 48,
    labor_credibility: 48,
    progressive_credibility: 52,
    feminist_trust: 47,
    household_security: 40,
    government_delivery: 0,
    kpo_public_credit: 0,
    far_right_agenda: 47,
    minority_safety: 51,
    judicial_legitimacy: 36,
    electoral_viability: 50,
    winner_reputation: 38,
    issue_ownership: 36,
    leadership_authority: 43,
    coalition_blur: 14,
    media_access: 27,
    list_confidence: 49,
    economic_growth: 0.2,
    inflation: 11.4,
    unemployment: 5.0,
    national_turnout_climate: 74
};
const audienceBaseline =
    isFormationEra ? formationAudienceBaseline : campaignAudienceBaseline;
let presidentialFeedbackScale = 0;
if (Q.pres_feedback_active &&
    finitePolling(Q.pres_feedback_months_remaining, 0) > 0) {
    presidentialFeedbackScale = clampPolling(
        finitePolling(Q.pres_feedback_months_remaining, 0) /
            Math.max(1, finitePolling(Q.pres_feedback_duration, 1)),
        0,
        1
    );
    Q.pres_feedback_decay_factor = Math.round(
        presidentialFeedbackScale * 100
    ) / 100;
    Q.pres_feedback_consideration_current = Math.round(
        finitePolling(Q.pres_feedback_consideration, 0) *
            presidentialFeedbackScale * 100
    ) / 100;
    Q.pres_feedback_turnout_current = Math.round(
        finitePolling(Q.pres_feedback_turnout, 0) *
            presidentialFeedbackScale * 100
    ) / 100;
    Q.pres_feedback_tactical_current = Math.round(
        finitePolling(Q.pres_feedback_tactical_flight, 0) *
            presidentialFeedbackScale * 100
    ) / 100;
} else {
    Q.pres_feedback_active = 0;
    Q.pres_feedback_decay_factor = 0;
    Q.pres_feedback_consideration_current = 0;
    Q.pres_feedback_turnout_current = 0;
    Q.pres_feedback_tactical_current = 0;
}
const economicDefaults = {
    left: isFormationEra ? 51.7 : 52,
    pis: 31,
    ko: 60,
    psl: 49,
    konf: 86,
    p2050: 55,
    p0: 92
};
const culturalDefaults = {
    left: isFormationEra ? 50.3 : 52.3,
    pis: 86,
    ko: 43,
    psl: 68,
    konf: 91,
    p2050: 51,
    p0: 74
};

if (!Number.isFinite(finitePolling(Q.national_turnout_climate, NaN))) {
    Q.national_turnout_climate =
        audienceBaseline.national_turnout_climate;
}
if (!Number.isFinite(finitePolling(Q.left_economic_position, NaN))) {
    Q.left_economic_position = economicDefaults.left;
}
if (!Number.isFinite(finitePolling(Q.left_cultural_position, NaN))) {
    Q.left_cultural_position = culturalDefaults.left;
}
for (const id of ["pis", "ko", "psl", "konf", "p2050", "p0"]) {
    if (!Number.isFinite(finitePolling(Q[id + "_economic_position"], NaN))) {
        Q[id + "_economic_position"] = economicDefaults[id];
    }
    if (!Number.isFinite(finitePolling(Q[id + "_cultural_position"], NaN))) {
        Q[id + "_cultural_position"] = culturalDefaults[id];
    }
}
for (const group of groupDefinitions) {
    for (const id of namedPartyIds) {
        const key = group.id + "_" + id + "_affinity";
        Q[key] = finitePolling(Q[key], 0);
    }
}

// Authored poll changes remain meaningful. They become momentum before this
// month is rebuilt, rather than being overwritten by the electorate model.
for (const id of electionPartyIds) {
    const current = finitePolling(Q[id + "_poll"], 0);
    const previous = finitePolling(Q["poll_last_model_" + id], current);
    Q[id + "_poll_momentum"] =
        finitePolling(Q[id + "_poll_momentum"], 0) +
        current - previous;
}

const monthKeyNow = Math.round(finitePolling(pollMonthKey, -1));
const monthIndexNow = Math.round(finitePolling(pollMonthIndex, 0));
if (
    !Q.p0_formed &&
    !Q.p0_formation_checked &&
    monthKeyNow >= 202506 &&
    finitePolling(Q.stanowski_trigger_score, 0) > 1.24
) {
    const triggerSupport =
        finitePolling(Q.stanowski_trigger_score, 0) - 1.24;
    const channelFactor = Math.max(
        0,
        finitePolling(Q.kanal_zero_capacity, 12) - 12
    );
    const emergenceChance = clampPolling(
        0.14 + triggerSupport * 0.22 + channelFactor * 0.005,
        0.14,
        0.68
    );
    Q.p0_formation_checked = 1;
    if ((this.random.uint32() / 4294967296) <= emergenceChance) {
        const peakRoll = this.random.uint32() / 4294967296;
        Q.p0_peak = peakRoll < 0.30
            ? 3
            : (peakRoll < 0.60 ? 6 : (peakRoll < 0.90 ? 11 : 6));
        Q.p0_peak_band = Q.p0_peak == 3
            ? "minor"
            : (Q.p0_peak == 6 ? "mid" : "major");
        Q.p0_formed = 1;
        Q.p0_emergence_month_key = monthKeyNow;
        Q.p0_emergence_month_index = monthIndexNow;
        Q.p0_alert_stage = 0;
        Q.p0_alert_event_done = 0;
        Q.p0_pressure = 1;
        Q.p0_org_resources = Math.max(3, finitePolling(Q.p0_org_resources, 3));
        Q.p0_org_income = Math.max(2, finitePolling(Q.p0_org_income, 2));
        Q.p0_ai_actions = Math.max(0, finitePolling(Q.p0_ai_actions, 0));
        Q.p0_ai_headline =
            "Partia Zero launches from the Kanał Zero electorate";
        Q.p0_ai_strategy =
            "Convert a media electorate into a right-libertarian committee";
        Q.news_headline =
            "Stanowski's presidential electorate starts a new party project";
    }
}

const positionFitChange = function(group, party) {
    if (party == "other") {
        return 0;
    }
    const currentEconomic =
        finitePolling(
            Q[party + "_economic_position"],
            economicDefaults[party]
        );
    const currentCultural =
        finitePolling(
            Q[party + "_cultural_position"],
            culturalDefaults[party]
        );
    const defaultEconomic = economicDefaults[party];
    const defaultCultural = culturalDefaults[party];
    const defaultDistance =
        Math.abs(defaultEconomic - group.economicIdeal) * 0.11 +
        Math.abs(defaultCultural - group.culturalIdeal) * 0.09;
    const currentDistance =
        Math.abs(currentEconomic - group.economicIdeal) * 0.11 +
        Math.abs(currentCultural - group.culturalIdeal) * 0.09;
    return defaultDistance - currentDistance;
};
const delta = function(id) {
    return finitePolling(Q[id], audienceBaseline[id]) -
        audienceBaseline[id];
};
const presidentialConsiderationWeight = function(groupId) {
    if (groupId == "metropolitan_liberals") return 1.20;
    if (groupId == "liberal_professionals") return 1.15;
    if (groupId == "public_service_families") return 1.00;
    if (groupId == "industrial_logistics") return 0.95;
    if (groupId == "provincial_welfare") return 0.80;
    if (groupId == "rural_localists") return 0.70;
    if (groupId == "older_welfare_households") return 0.80;
    return 1.20;
};
const publicIssueLean = function(groupId, issue) {
    const group = groupDefinitions.find(function(entry) {
        return entry.id == groupId;
    }) || {economicIdeal: 50, culturalIdeal: 50};
    if (["abortion_rights", "refugee_solidarity", "lgbt_equality",
        "secular_state"].includes(issue)) {
        return clampPolling((50 - group.culturalIdeal) / 45, -1, 1);
    }
    if (issue == "social_spending") {
        return clampPolling((55 - group.economicIdeal) / 45, -1, 1);
    }
    if (["border_security", "national_security"].includes(issue)) {
        return clampPolling((group.culturalIdeal - 45) / 55, -1, 1);
    }
    return clampPolling(1 - Math.abs(group.culturalIdeal - 45) / 55, -1, 1);
};
const leftIssueReception = function(groupId) {
    const issues = [
        "abortion_rights", "refugee_solidarity", "border_security",
        "vaccination", "social_spending", "lgbt_equality",
        "secular_state", "rule_of_law", "national_security"
    ];
    let weightedReception = 0;
    let totalWeight = 0;
    for (const issue of issues) {
        const salience = clampPolling(Q[issue + "_salience"], 0, 100);
        const ownership = clampPolling(
            Q[issue + "_left_ownership"],
            0,
            100
        );
        const support = clampPolling(Q[issue + "_support"], 0, 100);
        const backlash = clampPolling(Q[issue + "_backlash"], 0, 100);
        const association = ownership / 100;
        weightedReception += salience * association * (
            (support - 50) / 50 -
            Math.max(0, backlash - 35) / 100 +
            publicIssueLean(groupId, issue) * 0.45
        );
        totalWeight += salience;
    }
    const currentReception = clampPolling(
        weightedReception * 6 / Math.max(1, totalWeight),
        -2.5,
        2.5
    );
    if (
        !Number.isFinite(finitePolling(
            Q["left_issue_reception_baseline_" + groupId], NaN
        ))
    ) {
        Q["left_issue_reception_baseline_" + groupId] = currentReception;
    }
    return clampPolling(
        currentReception - Number(
            Q["left_issue_reception_baseline_" + groupId]
        ),
        -2.5,
        2.5
    );
};
const partyIssueReception = function(group, id) {
    const partyBloc = id == "pis" || id == "konf"
        ? "conservative"
        : (id == "psl"
            ? (finitePolling(Q.psl_conservative_share, 30) >= 45
                ? "conservative" : "centrist")
            : (id == "ko"
                ? (finitePolling(Q.ko_social_liberal_share, 50) >=
                    finitePolling(Q.ko_classical_liberal_share, 50)
                        ? "progressive" : "centrist")
                : (id == "left" ? "progressive" : "centrist")));
    const issues = [
        "abortion_rights", "refugee_solidarity", "border_security",
        "vaccination", "social_spending", "lgbt_equality",
        "secular_state", "rule_of_law", "national_security"
    ];
    let weighted = 0;
    let total = 0;
    for (const issue of issues) {
        const salience = clampPolling(Q[issue + "_salience"], 0, 100);
        const support = clampPolling(Q[issue + "_support"], 0, 100);
        const backlash = clampPolling(Q[issue + "_backlash"], 0, 100);
        const ownership = clampPolling(
            Q[issue + "_" + partyBloc + "_ownership"], 0, 100
        ) / 100;
        let direction = publicIssueLean(group.id, issue);
        if (partyBloc == "conservative" && [
            "abortion_rights", "refugee_solidarity", "vaccination",
            "lgbt_equality", "secular_state", "rule_of_law"
        ].includes(issue)) {
            direction *= -1;
        } else if (partyBloc == "centrist") {
            direction = 1 - Math.abs(direction) * 0.45;
        }
        weighted += salience * ownership * (
            direction * 0.55 + (support - 50) / 100 -
            Math.max(0, backlash - 55) / 180
        );
        total += salience;
    }
    const current = clampPolling(weighted * 5 / Math.max(1, total), -2.5, 2.5);
    const baselineKey = "party_issue_reception_baseline_" + group.id + "_" + id;
    if (!Number.isFinite(Number(Q[baselineKey]))) Q[baselineKey] = current;
    return clampPolling(current - Number(Q[baselineKey]), -2.5, 2.5);
};
const leftStructuralHeadwind = function(groupId) {
    if (pollMonthKey > 202310) {
        return 0;
    }
    const rollingLeftPoll = finitePolling(Q.left_poll, 8.6);
    let headwind =
        2.6 +
        Math.max(0, finitePolling(Q.opposition_list_pressure, 35) - 35) * 0.020 +
        Math.max(
            0,
            55 - finitePolling(
                Q.electoral_viability,
                audienceBaseline.electoral_viability
            )
        ) * 0.015 +
        Math.max(
            0,
            finitePolling(Q.coalition_blur, audienceBaseline.coalition_blur) - 18
        ) * 0.020 +
        Math.max(0, finitePolling(Q.internal_dissent, 18) - 18) * 0.020 -
        Math.max(0, delta("local_network")) * 0.030 -
        Math.max(0, delta("workers_support")) * 0.020 -
        Math.max(0, delta("issue_ownership")) * 0.025 +
        Math.max(0, rollingLeftPoll - 10.5) * 0.18 -
        Math.max(0, 8.3 - rollingLeftPoll) * 0.30;
    if (groupId == "anti_establishment_youth") headwind += 0.35;
    if (groupId == "rural_localists") headwind += 0.20;
    if (groupId == "metropolitan_liberals") headwind -= 0.10;
    return clampPolling(headwind, 0.5, 4.6);
};
const baselineLeftStructuralHeadwind = function(groupId) {
    if (pollMonthKey > 202310) return 0;
    const rollingLeftPoll = finitePolling(Q.poll_reference_left, 12.6);
    let headwind =
        2.6 +
        Math.max(0, 55 - audienceBaseline.electoral_viability) * 0.015 +
        Math.max(0, audienceBaseline.coalition_blur - 18) * 0.020 +
        Math.max(0, rollingLeftPoll - 10.5) * 0.18 -
        Math.max(0, 8.3 - rollingLeftPoll) * 0.30;
    if (groupId == "anti_establishment_youth") headwind += 0.35;
    if (groupId == "rural_localists") headwind += 0.20;
    if (groupId == "metropolitan_liberals") headwind -= 0.10;
    return clampPolling(headwind, 0.5, 4.6);
};
const trustConversionFactor = function(groupId) {
    if (groupId == "metropolitan_liberals") return 1.05;
    if (groupId == "liberal_professionals") return 0.95;
    if (groupId == "public_service_families") return 0.92;
    if (groupId == "industrial_logistics") return 0.78;
    if (groupId == "provincial_welfare") return 0.66;
    if (groupId == "rural_localists") return 0.62;
    if (groupId == "older_welfare_households") return 0.70;
    if (groupId == "anti_establishment_youth") return 0.58;
    return 1;
};
const sldPartocracyReception = function(groupId) {
    if (Q.sld_populist_route_active) return 0;
    if (finitePolling(Q.sld_partocracy_stage, 0) < 3) return 0;
    const organisation = clampPolling(
        (finitePolling(Q.barons_strength, 28) - 28) * 0.012 +
            (finitePolling(Q.local_network, 35) - 35) * 0.010 +
            (finitePolling(Q.list_confidence, 61) - 61) * 0.009,
        -0.6,
        1.8
    );
    const activistCost = Math.max(
        0,
        50 - finitePolling(Q.organiser_energy, 50)
    ) * 0.012;
    const exposureCost =
        finitePolling(Q.sld_patronage_exposure, 0) * 0.012;
    if (Q.sld_partocracy_doctrine == "orthodox") {
        if (groupId == "older_welfare_households") {
            return organisation * 0.65 + 0.75 - activistCost * 0.15;
        }
        if (groupId == "public_service_families") {
            return organisation * 0.50 + 0.40;
        }
        if (groupId == "industrial_logistics") {
            return organisation * 0.45 + 0.20;
        }
        if (groupId == "anti_establishment_youth") {
            return organisation * 0.20 - 0.55 - activistCost;
        }
        return organisation * 0.35 - activistCost * 0.35;
    }
    if (Q.sld_partocracy_doctrine == "market_apparatus") {
        const competence = clampPolling(
            finitePolling(Q.administrative_capacity, 0) * 0.018,
            0,
            0.8
        );
        if (groupId == "liberal_professionals") {
            return organisation * 0.45 + competence + 0.65;
        }
        if (groupId == "metropolitan_liberals") {
            return organisation * 0.35 + competence * 0.6 + 0.30;
        }
        if (["industrial_logistics", "public_service_families"].includes(groupId)) {
            return organisation * 0.25 - 0.45 - activistCost * 0.4;
        }
        return organisation * 0.30 + competence * 0.25 - activistCost * 0.25;
    }
    if (["provincial_welfare", "rural_localists", "older_welfare_households"]
        .includes(groupId)) {
        return organisation * 0.80 + 0.45 - exposureCost * 0.45;
    }
    if (groupId == "anti_establishment_youth") {
        return organisation * 0.15 - 0.75 - activistCost - exposureCost;
    }
    if (groupId == "metropolitan_liberals") {
        return organisation * 0.25 - 0.40 - exposureCost * 0.8;
    }
    return organisation * 0.45 - activistCost * 0.5 - exposureCost * 0.65;
};
const leftBlocChange = function(groupId) {
    const failedNegotiations = Math.max(
        0,
        finitePolling(Q.negotiation_attempts, 0) -
            finitePolling(Q.negotiation_successes, 0)
    );
    const governingPenalty = Q.left_in_government
        ? Math.max(
            0,
            finitePolling(Q.government_coalition_dissent, 30) - 35
        ) * 0.025
        : 0;
    const common =
        delta("party_unity") * 0.055 +
        delta("public_trust") * 0.055 * trustConversionFactor(groupId) +
        delta("media_capacity") * 0.030 +
        delta("electoral_viability") * 0.045 +
        delta("winner_reputation") * 0.035 +
        delta("issue_ownership") * 0.040 +
        delta("leadership_authority") * 0.025 -
        delta("coalition_blur") * 0.030 +
        delta("media_access") * 0.025 +
        delta("list_confidence") * 0.035 +
        (Q.left_in_government || Q.government_party == "lewica"
            ? delta("government_delivery") * 0.080
            : 0) +
        delta("kpo_public_credit") * 0.120 +
        finitePolling(Q.pres_feedback_consideration_current, 0) *
            presidentialConsiderationWeight(groupId) +
        finitePolling(Q.negotiation_successes, 0) * 0.35 -
        failedNegotiations * 0.12 -
        governingPenalty +
        leftIssueReception(groupId) +
        sldPartocracyReception(groupId) -
        leftStructuralHeadwind(groupId) -
        Math.max(0, finitePolling(Q.internal_dissent, 18) - 18) * 0.04;
    if (groupId == "metropolitan_liberals") {
        return common +
            delta("young_support") * 0.10 +
            delta("women_support") * 0.08 +
            delta("urban_progressive_support") * 0.12 +
            delta("progressive_credibility") * 0.07;
    }
    if (groupId == "liberal_professionals") {
        return common +
            delta("urban_progressive_support") * 0.08 +
            delta("progressive_credibility") * 0.05 +
            delta("public_trust") * 0.05 * trustConversionFactor(groupId);
    }
    if (groupId == "public_service_families") {
        return common +
            delta("public_sector_support") * 0.12 +
            delta("women_support") * 0.05 +
            delta("labor_credibility") * 0.06;
    }
    if (groupId == "industrial_logistics") {
        return common +
            delta("workers_support") * 0.14 +
            delta("labor_credibility") * 0.08 +
            delta("local_network") * 0.04;
    }
    if (groupId == "provincial_welfare") {
        return common +
            delta("workers_support") * 0.07 +
            delta("rural_support") * 0.07 +
            delta("local_network") * 0.07 +
            delta("household_security") * 0.04;
    }
    if (groupId == "rural_localists") {
        return common +
            delta("rural_support") * 0.15 +
            delta("local_network") * 0.08 +
            delta("pensioner_support") * 0.04;
    }
    if (groupId == "older_welfare_households") {
        return common +
            delta("pensioner_support") * 0.14 +
            delta("household_security") * 0.06 +
            delta("public_sector_support") * 0.03;
    }
    return common +
        delta("young_support") * 0.12 +
        delta("progressive_credibility") * 0.06 +
        delta("turnout_readiness") * 0.05;
};

const partyBlocChange = function(group, id) {
    if (id == "left") {
        return leftBlocChange(group.id);
    }
    if (id == "pis") {
        let change =
            (Q.government_party == "pis"
                ? delta("government_delivery") * 0.045
                : 0);
        if (
            ["industrial_logistics", "provincial_welfare",
            "rural_localists", "older_welfare_households"].includes(group.id)
        ) {
            change +=
                delta("household_security") * 0.035;
        }
        return change;
    }
    if (id == "ko") {
        const institutionalOpportunity = Math.max(
            0,
            audienceBaseline.judicial_legitimacy -
            finitePolling(
                Q.judicial_legitimacy,
                audienceBaseline.judicial_legitimacy
            )
        ) * 0.055;
        const delivery = Q.government_party == "ko"
            ? delta("government_delivery") * 0.035
            : 0;
        return delivery + ([
            "metropolitan_liberals",
            "liberal_professionals",
            "public_service_families"
        ].includes(group.id) ? institutionalOpportunity : 0);
    }
    if (id == "psl") {
        const leftRuralCompetition = Math.max(
            0,
            delta("rural_support")
        );
        return (Q.government_party == "psl"
            ? delta("government_delivery") * 0.025
            : 0) + (["rural_localists", "provincial_welfare"].includes(group.id)
            ? -leftRuralCompetition * 0.045
            : 0);
    }
    if (id == "konf") {
        const agendaChange =
            delta("far_right_agenda") * 0.055 -
            delta("minority_safety") * 0.025;
        return ["anti_establishment_youth", "provincial_welfare",
            "rural_localists"].includes(group.id) ? agendaChange : 0;
    }
    if (id == "p2050") {
        return Q.p2050_emerged
            ? Math.min(2.5, finitePolling(Q.p2050_ai_actions, 0) * 0.04) +
                (Q.government_party == "p2050"
                    ? delta("government_delivery") * 0.030
                    : 0)
            : 0;
    }
    if (id == "p0") {
        if (!Q.p0_formed) return 0;
        const monthsSinceLaunch = Math.max(
            0,
            monthIndexNow - Math.max(
                0,
                finitePolling(Q.p0_emergence_month_index, monthIndexNow)
            )
        );
        const launchScale = clampPolling(monthsSinceLaunch / 16, 0, 1);
        const antiSystemTailwind = clampPolling(
            finitePolling(Q.covid_anti_system_pressure, 0) * 0.012,
            0,
            1.6
        );
        return launchScale * 1.2 +
            antiSystemTailwind +
            Math.min(1.4, finitePolling(Q.p0_ai_actions, 0) * 0.06);
    }
    return 0;
};

const totals = {};
for (const id of partyIds) {
    totals[id] = 0;
}
let effectiveElectorate = 0;
for (const group of groupDefinitions) {
    const salienceTurnout =
        (
            finitePolling(Q.economic_issue_salience, 38) +
            finitePolling(Q.cultural_issue_salience, 24) +
            finitePolling(Q.institutional_issue_salience, 42) -
            104
        ) * 0.018;
    const leftAbstentionWeight = Math.min(
        1.25,
        group.scores.left / 20
    );
    const turnout = clampPolling(
        group.turnout +
            (
                Q.national_turnout_climate -
                audienceBaseline.national_turnout_climate
            ) * 0.18 +
            salienceTurnout -
            finitePolling(Q.tactical_desertion_to_abstention, 0) *
                0.34 * leftAbstentionWeight,
        35,
        90
    );
    const scores = {};
    const leftParticipationFactor = clampPolling(
        1 +
            delta("turnout_readiness") * 0.004 +
            delta("local_network") * 0.002 +
            finitePolling(Q.pres_feedback_turnout_current, 0) * 0.012,
        0.60,
        1.50
    );
    for (const id of partyIds) {
        if (!activeParty(id)) {
            scores[id] = 0;
            continue;
        }
        let score = group.scores[id] + (
            id == "left" && Q.p2050_joined_left
                ? group.scores.p2050 * 0.90
                : 0
        );
        if (id != "other") {
            score += positionFitChange(group, id);
            score += partyBlocChange(group, id);
            score += partyIssueReception(group, id);
            score += finitePolling(
                Q[group.id + "_" + id + "_affinity"],
                0
            );
        }
        if (id == "left") {
            const pre2023TacticalSqueeze = pollMonthKey <= 202310
                ? Math.max(0, finitePolling(Q.opposition_list_pressure, 35) - 35) * 0.08
                : 0;
            const pre2023BaselineDrag = 0;
            score *= leftParticipationFactor;
            score *= clampPolling(
                1 - (
                    finitePolling(Q.tactical_desertion_to_ko, 0) +
                    finitePolling(Q.tactical_desertion_to_p2050, 0) +
                    finitePolling(Q.tactical_desertion_to_abstention, 0) * 0.45 +
                    finitePolling(Q.pres_feedback_tactical_current, 0) +
                    pre2023TacticalSqueeze +
                    pre2023BaselineDrag
                ) / 88,
                0.35,
                1
            );
        }
        if (id == "ko") {
            score += group.scores.left *
                (
                    finitePolling(Q.tactical_desertion_to_ko, 0) +
                    finitePolling(Q.pres_feedback_tactical_current, 0) * 0.70
                ) / 100;
        }
        if (id == "p2050" && Q.p2050_emerged) {
            score += group.scores.left *
                (
                    finitePolling(Q.tactical_desertion_to_p2050, 0) +
                    finitePolling(Q.pres_feedback_tactical_current, 0) * 0.15
                ) / 100;
        }
        scores[id] = Math.max(0.05, score);
    }
    const scoreTotal = partyIds.reduce(function(total, id) {
        return total + scores[id];
    }, 0);
    const electorateWeight = group.size * turnout / 100;
    effectiveElectorate += electorateWeight;

    let leader = activeParty("left") ? "left" : "pis";
    const roundedShares = {};
    for (const id of partyIds) {
        const share = scores[id] * 100 / Math.max(1, scoreTotal);
        totals[id] += electorateWeight * share / 100;
        roundedShares[id] = Math.round(share * 10) / 10;
        if (scores[id] > scores[leader]) {
            leader = id;
        }
    }
    const groupRoundedTotal = partyIds.reduce(function(total, id) {
        return total + roundedShares[id];
    }, 0);
    const groupResidual =
        Math.round((100 - groupRoundedTotal) * 10) / 10;
    let residualParty = "other";
    if (roundedShares.other + groupResidual < 0) {
        residualParty = leader;
    }
    roundedShares[residualParty] = Math.round(
        (roundedShares[residualParty] + groupResidual) * 10
    ) / 10;

    const rankedParties = partyIds.filter(activeParty).sort(function(a, b) {
        return roundedShares[b] - roundedShares[a];
    });
    const runner = rankedParties[1] || rankedParties[0];
    const previousLeftShare = finitePolling(
        Q[group.id + "_left"],
        NaN
    );
    Q[group.id + "_left_previous"] =
        Number.isFinite(previousLeftShare)
            ? Math.round(previousLeftShare * 10) / 10
            : roundedShares.left;
    Q[group.id + "_size"] = group.size;
    Q[group.id + "_turnout"] = Math.round(turnout);
    Q[group.id + "_left_turnout"] = Math.round(
        clampPolling(turnout * leftParticipationFactor, 0, 100)
    );
    Q[group.id + "_leader"] = partyNames[leader];
    Q[group.id + "_runner"] = partyNames[runner];
    Q[group.id + "_margin"] = Math.round(
        (
            roundedShares[rankedParties[0]] -
            roundedShares[runner]
        ) * 10
    ) / 10;
    for (const id of partyIds) {
        Q[group.id + "_" + id] = roundedShares[id];
    }
    // Retain the compatibility alias used by the current left ledger.
    Q[group.id + "_left"] = roundedShares.left;
}

const rawIntent = {};
for (const id of partyIds) {
    rawIntent[id] =
        totals[id] * 100 / Math.max(1, effectiveElectorate);
}

// Opening calibration maps the transparent bloc model to the authored
// historical snapshot. It is calculated from static bloc scores, so player
// choices and rival actions already taken this month are not calibrated away.
if (!Q.nationwide_poll_model_initialized) {
    const baselineTotals = {};
    const fullP2050Totals = {};
    for (const id of partyIds) {
        baselineTotals[id] = 0;
        fullP2050Totals[id] = 0;
    }
    let baselineElectorate = 0;
    for (const group of groupDefinitions) {
        const electorateWeight = group.size * group.turnout / 100;
        baselineElectorate += electorateWeight;
        let activeTotal = 0;
        let fullTotal = 0;
        const baselineScores = {};
        for (const id of partyIds) {
            baselineScores[id] = id == "left"
                ? Math.max(
                    0.05,
                    group.scores[id] -
                        baselineLeftStructuralHeadwind(group.id)
                )
                : group.scores[id];
            if (activeParty(id)) {
                activeTotal += baselineScores[id];
            }
            fullTotal += baselineScores[id];
        }
        for (const id of partyIds) {
            if (activeParty(id)) {
                baselineTotals[id] +=
                    electorateWeight *
                    baselineScores[id] /
                    Math.max(1, activeTotal);
            }
            fullP2050Totals[id] +=
                electorateWeight *
                baselineScores[id] /
                Math.max(1, fullTotal);
        }
    }
    for (const id of partyIds) {
        const baselineIntent =
            baselineTotals[id] * 100 / Math.max(1, baselineElectorate);
        Q["poll_calibration_" + id] =
            finitePolling(Q["poll_reference_" + id], 0) -
            baselineIntent;
    }
    if (!Q.p2050_emerged) {
        Q.poll_calibration_p2050 =
            -fullP2050Totals.p2050 *
            100 /
            Math.max(1, baselineElectorate);
    }
    if (!Q.p0_formed) {
        Q.poll_calibration_p0 =
            -fullP2050Totals.p0 *
            100 /
            Math.max(1, baselineElectorate);
    }
    Q.nationwide_poll_model_initialized = 1;
    Q.nationwide_poll_model_era = isFormationEra ? "2023" : "2019";
    Q.poll_model_initialized = 1;
}

const activeBudgetYear = Math.round(
    finitePolling(Q.annual_budget_year, Q.year)
);
const activeBudgetCrisis =
    Boolean(Q.budget_deadline_active) &&
    Boolean(Q["annual_budget_done_" + activeBudgetYear]) &&
    !Boolean(Q["annual_budget_passed_" + activeBudgetYear]);
const rawBudgetOwner = String(Q.government_party || "");
const governmentOwner = rawBudgetOwner == "lewica"
    ? "left"
    : (["independent", "other"].includes(rawBudgetOwner)
        ? "other" : rawBudgetOwner);
const inflationPain = Math.max(
    0,
    finitePolling(Q.inflation, 3) - 3
) * 0.55;
const unemploymentPain = Math.max(
    0,
    finitePolling(Q.unemployment, audienceBaseline.unemployment) -
        audienceBaseline.unemployment
) * 0.45;
const contractionPain = Math.max(
    0,
    1.5 - finitePolling(Q.economic_growth, 1.5)
) * 0.70;
const householdPain = Math.max(
    0,
    42 - finitePolling(Q.household_security, 42)
) * 0.10;
const governmentEconomicPenalty = clampPolling(
    inflationPain + unemploymentPain + contractionPain + householdPain,
    0,
    12
);
const extremistEconomicBonus = clampPolling(
    inflationPain * 0.54 + unemploymentPain * 0.36 +
        contractionPain * 0.28 + householdPain * 0.16,
    0,
    4.8
);
Q.government_economic_poll_penalty =
    Math.round(governmentEconomicPenalty * 100) / 100;
Q.economic_extremist_poll_bonus =
    Math.round(extremistEconomicBonus * 100) / 100;
// Budget failure is collective, but the prime minister's party owns the bill.
const budgetCrisisPenalty = function(id) {
    if (!activeBudgetCrisis) return 0;
    if (id == governmentOwner) return 12;
    if (id == "left" && Q.left_in_government) return 4;
    if (id == "ko" && Q.ministry_ko_in_cabinet) return 4;
    if (id == "psl" && Q.ministry_psl_in_cabinet) return 4;
    if (id == "p2050" && Q.ministry_p2050_in_cabinet) return 4;
    return 0;
};
const economyCorrection = function(id) {
    if (id == governmentOwner) return -governmentEconomicPenalty;
    if (id == "konf") return extremistEconomicBonus;
    return 0;
};
const corrected = {};
for (const id of partyIds) {
    if (!activeParty(id)) {
        corrected[id] = 0;
        continue;
    }
    corrected[id] = Math.max(
        0.05,
        rawIntent[id] +
            finitePolling(Q["poll_calibration_" + id], 0) +
            finitePolling(Q[id + "_poll_momentum"], 0) -
            budgetCrisisPenalty(id) + economyCorrection(id)
    );
}
corrected.suwerenna = 0;
corrected.porozumienie = 0;

// Radicalisation.
//
// Economic pain and unanswered demands do not only punish the incumbent: they
// move votes out of the whole governing-and-alternating centre and toward
// parties that promise a break. The radical right takes most of it, an
// anti-establishment left takes a little, and a share goes to new committees
// and unaffiliated lists. Establishment parties donate in proportion to how
// much of the system they are seen to own, so the governing party pays double.
//
// This runs before the family splits below, which is deliberate: Korona takes
// its share of the Konfederacja family and a separate Razem takes its share of
// the Left family through the same committee arithmetic as every other vote.
const radicalisationIndex = clampPolling(
    finitePolling(Q.radicalisation_index, 0),
    0,
    100
);
const radicalTransferBudget = clampPolling(
    radicalisationIndex * 0.034,
    0,
    3.4
);
Q.radicalisation_transfer_last = 0;
if (radicalTransferBudget > 0.05) {
    const leftIsGoverning = Boolean(Q.left_in_government);
    // A separate Razem, or an opposition Left, can still collect part of the
    // anti-establishment vote. A governing Left cannot: that anger leaves for
    // abstention instead.
    const leftFamilyCollects =
        Boolean(Q.razem_party_formed) ||
        Boolean(Q.labor_party_formed) ||
        Boolean(Q.progressives_party_formed) ||
        !leftIsGoverning;
    const recipients = [];
    if (activeParty("konf")) recipients.push({id: "konf", weight: 0.46});
    if (Q.p0_formed && activeParty("p0")) {
        recipients.push({id: "p0", weight: 0.12});
    }
    recipients.push({id: "other", weight: Q.p0_formed ? 0.18 : 0.24});
    if (leftFamilyCollects) {
        recipients.push({id: "left", weight: 0.12});
    }
    const donorWeights = {
        left: leftIsGoverning ? 0.8 : 0.2,
        pis: governmentOwner == "pis" ? 2.0 : 0.5,
        ko: governmentOwner == "ko" ? 2.0 : 1.2,
        psl: governmentOwner == "psl" ? 2.0 : 1.0,
        p2050: governmentOwner == "p2050" ? 2.0 : 1.0,
        konf: 0,
        p0: 0,
        other: 0.3
    };
    if (governmentOwner == "left") {
        donorWeights.left = 2.0;
    }
    const recipientIds = recipients.map(function(entry) {
        return entry.id;
    });
    const donors = partyIds.filter(function(id) {
        return activeParty(id) &&
            recipientIds.indexOf(id) < 0 &&
            (donorWeights[id] || 0) > 0;
    });
    const donorMass = donors.reduce(function(total, id) {
        return total +
            Math.max(0, corrected[id] - 0.05) * donorWeights[id];
    }, 0);
    const availableMass = donors.reduce(function(total, id) {
        return total + Math.max(0, corrected[id] - 0.05);
    }, 0);
    const appliedTransfer = Math.min(radicalTransferBudget, availableMass);
    if (appliedTransfer > 0 && donorMass > 0) {
        for (const id of donors) {
            const share =
                Math.max(0, corrected[id] - 0.05) * donorWeights[id] /
                donorMass;
            corrected[id] = Math.max(
                0.05,
                corrected[id] - appliedTransfer * share
            );
        }
        const recipientWeight = recipients.reduce(function(total, entry) {
            return total + entry.weight;
        }, 0);
        for (const entry of recipients) {
            corrected[entry.id] +=
                appliedTransfer * entry.weight /
                Math.max(0.01, recipientWeight);
        }
        Q.radicalisation_transfer_last =
            Math.round(appliedTransfer * 100) / 100;
    }
    // A governing Left watches the same anger leave the polling station.
    if (!leftFamilyCollects) {
        Q.tactical_desertion_to_abstention =
            finitePolling(Q.tactical_desertion_to_abstention, 0) +
            appliedTransfer * 0.10;
    }
}

if (Q.p0_formed) {
    const peakTarget = Math.max(3, finitePolling(Q.p0_peak, 6));
    const launchIndex = Math.max(
        0,
        finitePolling(Q.p0_emergence_month_index, monthIndexNow)
    );
    const monthsSinceLaunch = Math.max(0, monthIndexNow - launchIndex);
    const growthWindow = clampPolling(monthsSinceLaunch / 22, 0, 1);
    const desiredShare = clampPolling(
        peakTarget * (0.32 + growthWindow * 0.68),
        0.9,
        peakTarget
    );
    const requestedChange = clampPolling(
        desiredShare - corrected.p0,
        -0.3,
        0.85
    );
    if (requestedChange != 0) {
        const donors = [
            {id: "pis", weight: 0.45},
            {id: "konf", weight: 0.35},
            {id: "ko", weight: 0.20}
        ];
        if (requestedChange > 0) {
            let remainingTransfer = requestedChange;
            for (const donor of donors) {
                const requested = requestedChange * donor.weight;
                const taken = Math.min(
                    Math.max(0, corrected[donor.id] - 0.05),
                    requested
                );
                corrected[donor.id] -= taken;
                remainingTransfer -= taken;
            }
            if (remainingTransfer > 0) {
                const availableTotal = donors.reduce(function(total, donor) {
                    return total + Math.max(0, corrected[donor.id] - 0.05);
                }, 0);
                const extraTransfer = Math.min(
                    remainingTransfer,
                    availableTotal
                );
                if (extraTransfer > 0 && availableTotal > 0) {
                    for (const donor of donors) {
                        const available = Math.max(
                            0,
                            corrected[donor.id] - 0.05
                        );
                        const taken = extraTransfer * available / availableTotal;
                        corrected[donor.id] -= taken;
                    }
                    remainingTransfer -= extraTransfer;
                }
            }
            const appliedTransfer = Math.max(
                0,
                requestedChange - remainingTransfer
            );
            corrected.p0 += appliedTransfer;
        } else {
            const releasedVote = Math.min(
                Math.abs(requestedChange),
                Math.max(0, corrected.p0 - 0.1)
            );
            corrected.p0 -= releasedVote;
            for (const donor of donors) {
                corrected[donor.id] += releasedVote * donor.weight;
            }
        }
    }
    Q.p0_pressure = Math.round(
        clampPolling((corrected.p0 / Math.max(0.1, peakTarget)) * 100, 0, 140)
    );
    Q.p0_alert_stage = corrected.p0 >= 9
        ? 3
        : (corrected.p0 >= 5 ? 2 : (corrected.p0 >= 2.5 ? 1 : 0));
}

// Splits are committees, not flavour flags. First calculate the electoral
// family produced by the electorate model, then divide it among the main list
// and every organisation that has actually left. Fragmentation leaks a small
// part of the family vote to KO and unaffiliated lists before thresholds apply.
const leftBreakaways = [
    {
        id: "sld_breakaway",
        caucus: "barons",
        active: !!Q.barons_party_formed,
        retention: 0.74
    },
    {
        id: "social_patriot",
        caucus: "social_patriot",
        active: !!Q.social_patriot_party_formed,
        retention: 0.76
    },
    {
        id: "spring_breakaway",
        caucus: "spring",
        active: !!Q.spring_party_formed,
        retention: 0.68
    },
    {
        id: "labor_left",
        caucus: "labor",
        active: !!Q.labor_party_formed,
        retention: 0.78
    },
    {
        id: "young_left",
        caucus: "progressives",
        active: !!Q.progressives_party_formed,
        retention: 0.72
    },
    {
        id: "razem",
        caucus: "razem",
        active: !!Q.razem_party_formed,
        retention: 0.88
    },
    {
        id: "pps",
        caucus: "pps",
        active: !!Q.pps_party_formed,
        retention: 0.62
    }
];
const activeLeftBreakaways = leftBreakaways.filter(function(entry) {
    return entry.active;
});
const plannedLeftCommittee = function(entry) {
    const qualities = {
        spring_breakaway: "spring_list_committee",
        labor_left: "labor_list_committee",
        young_left: "progressives_list_committee",
        razem: "razem_list_committee",
        social_patriot: "social_patriot_list_committee"
    };
    return qualities[entry.id]
        ? String(Q[qualities[entry.id]] || entry.id)
        : entry.id;
};
const mainLeftCommittee = {
    left_coalition_8: "left_coalition",
    razem_5: "razem",
    democratic_8: "democratic_list",
    ko_5: "ko",
    third_way_8: "third_way",
    third_host_5: String(Q.sejm_list_host || "psl"),
    pis_5: "pis",
    konf_5: "konf"
}[String(Q.sejm_list_outcome || "left_5")] || "left";
const plannedLeftCommittees = [mainLeftCommittee];
for (const entry of activeLeftBreakaways) {
    const committee = plannedLeftCommittee(entry);
    if (!plannedLeftCommittees.includes(committee)) {
        plannedLeftCommittees.push(committee);
    }
}
for (const id of dynamicPartyIds) corrected[id] = 0;

if (activeLeftBreakaways.length) {
    const familyBeforeSplit = Math.max(0, corrected.left);
    const hostility = activeLeftBreakaways.reduce(function(total, entry) {
        return total + Math.max(
            0,
