title: Rebuild the nationwide likely-voter poll
new-page: true
call: poland_normalize
on-arrival: {!
const finitePolling = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const clampPolling = function(value, low, high) {
    return Math.max(low, Math.min(high, finitePolling(value, low)));
};
const pollMonthKey =
    finitePolling(Q.year, 2019) * 100 + finitePolling(Q.month, 1);
const shouldRefreshPolling =
    finitePolling(Q.poll_state_month_key, -1) != pollMonthKey;

// Several dated-event and election-readiness routes can revisit this scene in
// one calendar month. The electorate, sample, momentum decay and danger clock
// are monthly state, so only the first visit may rebuild them.
if (shouldRefreshPolling) {
const partyIds = [
    "left", "pis", "ko", "psl", "konf", "p2050", "other"
];
const namedPartyIds = ["left", "pis", "ko", "psl", "konf", "p2050"];
const partyNames = {
    left: "Lewica",
    pis: "PiS",
    ko: "KO",
    psl: "PSL",
    konf: "Konfederacja",
    p2050: "Polska 2050",
    other: "Inni"
};
const isFormationEra =
    Q.scenario_mode == "formation_2023" ||
    finitePolling(Q.year, 2019) >= 2023;
const activeParty = function(id) {
    return id != "p2050" || !!Q.p2050_emerged;
};

// These are societal segments, not mutually exclusive Left constituencies.
// Their authored sizes sum to 100. Every active party receives an explicit
// score and share inside every segment.
const groupDefinitions = [
    {
        id: "metropolitan_liberals",
        size: 12,
        turnout: 72,
        economicIdeal: 44,
        culturalIdeal: 20,
        scores: {
            left: 24, pis: 10, ko: 44, psl: 2,
            konf: 6, p2050: 14, other: 5
        }
    },
    {
        id: "liberal_professionals",
        size: 11,
        turnout: 74,
        economicIdeal: 64,
        culturalIdeal: 35,
        scores: {
            left: 12, pis: 16, ko: 52, psl: 5,
            konf: 8, p2050: 18, other: 5
        }
    },
    {
        id: "public_service_families",
        size: 12,
        turnout: 69,
        economicIdeal: 35,
        culturalIdeal: 46,
        scores: {
            left: 20, pis: 38, ko: 28, psl: 7,
            konf: 4, p2050: 9, other: 5
        }
    },
    {
        id: "industrial_logistics",
        size: 13,
        turnout: 63,
        economicIdeal: 32,
        culturalIdeal: 66,
        scores: {
            left: 18, pis: 48, ko: 18, psl: 7,
            konf: 9, p2050: 5, other: 3
        }
    },
    {
        id: "provincial_welfare",
        size: 15,
        turnout: 60,
        economicIdeal: 30,
        culturalIdeal: 75,
        scores: {
            left: 9, pis: 55, ko: 15, psl: 10,
            konf: 9, p2050: 7, other: 3
        }
    },
    {
        id: "rural_localists",
        size: 15,
        turnout: 65,
        economicIdeal: 36,
        culturalIdeal: 80,
        scores: {
            left: 5, pis: 55, ko: 9, psl: 22,
            konf: 7, p2050: 6, other: 2
        }
    },
    {
        id: "older_welfare_households",
        size: 12,
        turnout: 74,
        economicIdeal: 24,
        culturalIdeal: 82,
        scores: {
            left: 6, pis: 61, ko: 18, psl: 11,
            konf: 2, p2050: 4, other: 2
        }
    },
    {
        id: "anti_establishment_youth",
        size: 10,
        turnout: 51,
        economicIdeal: 72,
        culturalIdeal: 51,
        scores: {
            left: 14, pis: 18, ko: 15, psl: 3,
            konf: 40, p2050: 12, other: 6
        }
    }
];
Q.voter_groups = groupDefinitions.map(function(group) {
    return group.id;
});

const campaignAudienceBaseline = {
    workers_support: 15,
    public_sector_support: 18,
    young_support: 20,
    women_support: 15,
    urban_progressive_support: 27,
    rural_support: 5,
    pensioner_support: 6,
    turnout_readiness: 58,
    party_unity: 58,
    public_trust: 43,
    media_capacity: 16,
    local_network: 42,
    labor_credibility: 46,
    progressive_credibility: 50,
    feminist_trust: 44,
    household_security: 45,
    government_delivery: 0,
    far_right_agenda: 32,
    minority_safety: 56,
    judicial_legitimacy: 36,
    economic_growth: 4.5,
    inflation: 2.6,
    unemployment: 5.1,
    national_turnout_climate: 61
};
const formationAudienceBaseline = {
    workers_support: 20,
    public_sector_support: 24,
    young_support: 17,
    women_support: 19,
    urban_progressive_support: 22,
    rural_support: 8,
    pensioner_support: 8,
    turnout_readiness: 67,
    party_unity: 51,
    public_trust: 39,
    media_capacity: 20,
    local_network: 48,
    labor_credibility: 48,
    progressive_credibility: 52,
    feminist_trust: 47,
    household_security: 40,
    government_delivery: 0,
    far_right_agenda: 47,
    minority_safety: 51,
    judicial_legitimacy: 36,
    economic_growth: 0.2,
    inflation: 11.4,
    unemployment: 5.0,
    national_turnout_climate: 74
};
const audienceBaseline =
    isFormationEra ? formationAudienceBaseline : campaignAudienceBaseline;
const economicDefaults = {
    left: isFormationEra ? 51.7 : 52,
    pis: 31,
    ko: 60,
    psl: 49,
    konf: 86,
    p2050: 55
};
const culturalDefaults = {
    left: isFormationEra ? 50.3 : 52.3,
    pis: 86,
    ko: 43,
    psl: 68,
    konf: 91,
    p2050: 51
};

if (!Number.isFinite(Number(Q.national_turnout_climate))) {
    Q.national_turnout_climate =
        audienceBaseline.national_turnout_climate;
}
if (!Number.isFinite(Number(Q.left_economic_position))) {
    Q.left_economic_position = economicDefaults.left;
}
if (!Number.isFinite(Number(Q.left_cultural_position))) {
    Q.left_cultural_position = culturalDefaults.left;
}
for (const id of ["pis", "ko", "psl", "konf", "p2050"]) {
    if (!Number.isFinite(Number(Q[id + "_economic_position"]))) {
        Q[id + "_economic_position"] = economicDefaults[id];
    }
    if (!Number.isFinite(Number(Q[id + "_cultural_position"]))) {
        Q[id + "_cultural_position"] = culturalDefaults[id];
    }
}
for (const group of groupDefinitions) {
    for (const id of namedPartyIds) {
        const key = group.id + "_" + id + "_affinity";
        Q[key] = finitePolling(Q[key], 0);
    }
}

// Authored poll changes remain meaningful. They become momentum before this
// month is rebuilt, rather than being overwritten by the electorate model.
for (const id of partyIds) {
    const current = finitePolling(Q[id + "_poll"], 0);
    const previous = finitePolling(Q["poll_last_model_" + id], current);
    Q[id + "_poll_momentum"] =
        finitePolling(Q[id + "_poll_momentum"], 0) +
        current - previous;
}

const positionFitChange = function(group, party) {
    if (party == "other") {
        return 0;
    }
    const currentEconomic =
        finitePolling(
            Q[party + "_economic_position"],
            economicDefaults[party]
        );
    const currentCultural =
        finitePolling(
            Q[party + "_cultural_position"],
            culturalDefaults[party]
        );
    const defaultEconomic = economicDefaults[party];
    const defaultCultural = culturalDefaults[party];
    const defaultDistance =
        Math.abs(defaultEconomic - group.economicIdeal) * 0.11 +
        Math.abs(defaultCultural - group.culturalIdeal) * 0.09;
    const currentDistance =
        Math.abs(currentEconomic - group.economicIdeal) * 0.11 +
        Math.abs(currentCultural - group.culturalIdeal) * 0.09;
    return defaultDistance - currentDistance;
};
const delta = function(id) {
    return finitePolling(Q[id], audienceBaseline[id]) -
        audienceBaseline[id];
};
const leftBlocChange = function(groupId) {
    const failedNegotiations = Math.max(
        0,
        finitePolling(Q.negotiation_attempts, 0) -
            finitePolling(Q.negotiation_successes, 0)
    );
    const governingPenalty = Q.left_in_government
        ? Math.max(
            0,
            finitePolling(Q.government_coalition_dissent, 30) - 35
        ) * 0.025
        : 0;
    const common =
        delta("party_unity") * 0.055 +
        delta("public_trust") * 0.055 +
        delta("media_capacity") * 0.030 +
        delta("government_delivery") * 0.040 +
        finitePolling(Q.negotiation_successes, 0) * 0.35 -
        failedNegotiations * 0.12 -
        governingPenalty;
    if (groupId == "metropolitan_liberals") {
        return common +
            delta("young_support") * 0.10 +
            delta("women_support") * 0.08 +
            delta("urban_progressive_support") * 0.12 +
            delta("progressive_credibility") * 0.07;
    }
    if (groupId == "liberal_professionals") {
        return common +
            delta("urban_progressive_support") * 0.08 +
            delta("progressive_credibility") * 0.05 +
            delta("public_trust") * 0.05;
    }
    if (groupId == "public_service_families") {
        return common +
            delta("public_sector_support") * 0.12 +
            delta("women_support") * 0.05 +
            delta("labor_credibility") * 0.06;
    }
    if (groupId == "industrial_logistics") {
        return common +
            delta("workers_support") * 0.14 +
            delta("labor_credibility") * 0.08 +
            delta("local_network") * 0.04;
    }
    if (groupId == "provincial_welfare") {
        return common +
            delta("workers_support") * 0.07 +
            delta("rural_support") * 0.07 +
            delta("local_network") * 0.07 +
            delta("household_security") * 0.04;
    }
    if (groupId == "rural_localists") {
        return common +
            delta("rural_support") * 0.15 +
            delta("local_network") * 0.08 +
            delta("pensioner_support") * 0.04;
    }
    if (groupId == "older_welfare_households") {
        return common +
            delta("pensioner_support") * 0.14 +
            delta("household_security") * 0.06 +
            delta("public_sector_support") * 0.03;
    }
    return common +
        delta("young_support") * 0.12 +
        delta("progressive_credibility") * 0.06 +
        delta("turnout_readiness") * 0.05;
};

const partyBlocChange = function(group, id) {
    if (id == "left") {
        return leftBlocChange(group.id);
    }
    if (id == "pis") {
        let change =
            delta("government_delivery") * 0.045 -
            Math.max(
                0,
                finitePolling(Q.inflation, audienceBaseline.inflation) -
                audienceBaseline.inflation
            ) * 0.055 -
            Math.max(
                0,
                audienceBaseline.economic_growth -
                finitePolling(Q.economic_growth, audienceBaseline.economic_growth)
            ) * 0.09;
        if (
            ["industrial_logistics", "provincial_welfare",
            "rural_localists", "older_welfare_households"].includes(group.id)
        ) {
            change +=
                delta("household_security") * 0.035;
        }
        return change;
    }
    if (id == "ko") {
        const institutionalOpportunity = Math.max(
            0,
            audienceBaseline.judicial_legitimacy -
            finitePolling(
                Q.judicial_legitimacy,
                audienceBaseline.judicial_legitimacy
            )
        ) * 0.055;
        return [
            "metropolitan_liberals",
            "liberal_professionals",
            "public_service_families"
        ].includes(group.id) ? institutionalOpportunity : 0;
    }
    if (id == "psl") {
        const leftRuralCompetition = Math.max(
            0,
            delta("rural_support")
        );
        return ["rural_localists", "provincial_welfare"].includes(group.id)
            ? -leftRuralCompetition * 0.045
            : 0;
    }
    if (id == "konf") {
        const agendaChange =
            delta("far_right_agenda") * 0.055 -
            delta("minority_safety") * 0.025;
        return ["anti_establishment_youth", "provincial_welfare",
            "rural_localists"].includes(group.id) ? agendaChange : 0;
    }
    if (id == "p2050") {
        return Q.p2050_emerged
            ? Math.min(2.5, finitePolling(Q.p2050_ai_actions, 0) * 0.04)
            : 0;
    }
    return 0;
};

const totals = {};
for (const id of partyIds) {
    totals[id] = 0;
}
let effectiveElectorate = 0;
for (const group of groupDefinitions) {
    const salienceTurnout =
        (
            finitePolling(Q.economic_issue_salience, 38) +
            finitePolling(Q.cultural_issue_salience, 24) +
            finitePolling(Q.institutional_issue_salience, 42) -
            104
        ) * 0.018;
    const turnout = clampPolling(
        group.turnout +
            (
                Q.national_turnout_climate -
                audienceBaseline.national_turnout_climate
            ) * 0.18 +
            salienceTurnout,
        35,
        90
    );
    const scores = {};
    for (const id of partyIds) {
        if (!activeParty(id)) {
            scores[id] = 0;
            continue;
        }
        let score = group.scores[id];
        if (id != "other") {
            score += positionFitChange(group, id);
            score += partyBlocChange(group, id);
            score += finitePolling(
                Q[group.id + "_" + id + "_affinity"],
                0
            );
        }
        if (id == "left") {
            score *= clampPolling(
                1 +
                    delta("turnout_readiness") * 0.004 +
                    delta("local_network") * 0.002,
                0.65,
                1.45
            );
        }
        scores[id] = Math.max(0.05, score);
    }
    const scoreTotal = partyIds.reduce(function(total, id) {
        return total + scores[id];
    }, 0);
    const electorateWeight = group.size * turnout / 100;
    effectiveElectorate += electorateWeight;

    let leader = activeParty("left") ? "left" : "pis";
    const roundedShares = {};
    for (const id of partyIds) {
        const share = scores[id] * 100 / Math.max(1, scoreTotal);
        totals[id] += electorateWeight * share / 100;
        roundedShares[id] = Math.round(share * 10) / 10;
        if (scores[id] > scores[leader]) {
            leader = id;
        }
    }
    const groupRoundedTotal = partyIds.reduce(function(total, id) {
        return total + roundedShares[id];
    }, 0);
    const groupResidual =
        Math.round((100 - groupRoundedTotal) * 10) / 10;
    let residualParty = "other";
    if (roundedShares.other + groupResidual < 0) {
        residualParty = leader;
    }
    roundedShares[residualParty] = Math.round(
        (roundedShares[residualParty] + groupResidual) * 10
    ) / 10;

    const rankedParties = partyIds.filter(activeParty).sort(function(a, b) {
        return roundedShares[b] - roundedShares[a];
    });
    const runner = rankedParties[1] || rankedParties[0];
    const previousLeftShare = Number(
        Q[group.id + "_left"]
    );
    Q[group.id + "_left_previous"] =
        Number.isFinite(previousLeftShare)
            ? Math.round(previousLeftShare * 10) / 10
            : roundedShares.left;
    Q[group.id + "_size"] = group.size;
    Q[group.id + "_turnout"] = Math.round(turnout);
    Q[group.id + "_leader"] = partyNames[leader];
    Q[group.id + "_runner"] = partyNames[runner];
    Q[group.id + "_margin"] = Math.round(
        (
            roundedShares[rankedParties[0]] -
            roundedShares[runner]
        ) * 10
    ) / 10;
    for (const id of partyIds) {
        Q[group.id + "_" + id] = roundedShares[id];
    }
    // Retain the compatibility alias used by the current left ledger.
    Q[group.id + "_left"] = roundedShares.left;
}

const rawIntent = {};
for (const id of partyIds) {
    rawIntent[id] =
        totals[id] * 100 / Math.max(1, effectiveElectorate);
}

// Opening calibration maps the transparent bloc model to the authored
// historical snapshot. It is calculated from static bloc scores, so player
// choices and rival actions already taken this month are not calibrated away.
if (!Q.nationwide_poll_model_initialized) {
    const baselineTotals = {};
    const fullP2050Totals = {};
    for (const id of partyIds) {
        baselineTotals[id] = 0;
        fullP2050Totals[id] = 0;
    }
    let baselineElectorate = 0;
    for (const group of groupDefinitions) {
        const electorateWeight = group.size * group.turnout / 100;
        baselineElectorate += electorateWeight;
        let activeTotal = 0;
        let fullTotal = 0;
        for (const id of partyIds) {
            if (activeParty(id)) {
                activeTotal += group.scores[id];
            }
            fullTotal += group.scores[id];
        }
        for (const id of partyIds) {
            if (activeParty(id)) {
                baselineTotals[id] +=
                    electorateWeight *
                    group.scores[id] /
                    Math.max(1, activeTotal);
            }
            fullP2050Totals[id] +=
                electorateWeight *
                group.scores[id] /
                Math.max(1, fullTotal);
        }
    }
    for (const id of partyIds) {
        const baselineIntent =
            baselineTotals[id] * 100 / Math.max(1, baselineElectorate);
        Q["poll_calibration_" + id] =
            finitePolling(Q["poll_reference_" + id], 0) -
            baselineIntent;
    }
    if (!Q.p2050_emerged) {
        Q.poll_calibration_p2050 =
            -fullP2050Totals.p2050 *
            100 /
            Math.max(1, baselineElectorate);
    }
    Q.nationwide_poll_model_initialized = 1;
    Q.nationwide_poll_model_era = isFormationEra ? "2023" : "2019";
    Q.poll_model_initialized = 1;
}

const corrected = {};
for (const id of partyIds) {
    if (!activeParty(id)) {
        corrected[id] = 0;
        continue;
    }
    corrected[id] = Math.max(
        0.05,
        rawIntent[id] +
            finitePolling(Q["poll_calibration_" + id], 0) +
            finitePolling(Q[id + "_poll_momentum"], 0)
    );
}

// Splits are committees, not flavour flags. First calculate the electoral
// family produced by the electorate model, then divide it among the main list
// and every organisation that has actually left. Fragmentation leaks a small
// part of the family vote to KO and unaffiliated lists before thresholds apply.
const leftBreakaways = [
    {
        id: "sld_breakaway",
        caucus: "barons",
        active: !!Q.barons_party_formed,
        retention: 0.74
    },
    {
        id: "spring_breakaway",
        caucus: "spring",
        active: !!Q.spring_party_formed,
        retention: 0.68
    },
    {
        id: "labor_left",
        caucus: "labor",
        active: !!Q.labor_party_formed,
        retention: 0.78
    },
    {
        id: "young_left",
        caucus: "progressives",
        active: !!Q.progressives_party_formed,
        retention: 0.72
    },
    {
        id: "razem",
        caucus: "razem",
        active: !!Q.razem_party_formed,
        retention: 0.88
    },
    {
        id: "pps",
        caucus: "pps",
        active: !!Q.pps_party_formed,
        retention: 0.62
    }
];
const activeLeftBreakaways = leftBreakaways.filter(function(entry) {
    return entry.active;
});
const dynamicPartyIds = [
    "sld_breakaway",
    "spring_breakaway",
    "labor_left",
    "young_left",
    "razem",
    "pps",
    "centrum",
    "rozwoj",
    "korona"
];
const electionPartyIds = partyIds.concat(dynamicPartyIds);
for (const id of dynamicPartyIds) corrected[id] = 0;

if (activeLeftBreakaways.length) {
    const familyBeforeSplit = Math.max(0, corrected.left);
    const hostility = activeLeftBreakaways.reduce(function(total, entry) {
        return total + Math.max(
            0,
            35 - finitePolling(
                Q[entry.caucus + "_party_relation"],
                20
            )
        ) / 700;
    }, 0);
    const fragmentationLossRate = Math.min(
        0.24,
        activeLeftBreakaways.length * 0.035 + hostility
    );
    const fragmentationLoss =
        familyBeforeSplit * fragmentationLossRate;
    const familyAfterLeakage =
        Math.max(0, familyBeforeSplit - fragmentationLoss);
    corrected.ko += fragmentationLoss * 0.58;
    corrected.other += fragmentationLoss * 0.42;

    let mainWeight = 12;
    for (const caucus of (Q.caucus_ids || [])) {
        if (Q[caucus + "_active"] && Q[caucus + "_in_left"]) {
            mainWeight += Math.max(
                0,
                finitePolling(Q[caucus + "_strength"], 0)
            );
        }
    }
    const breakawayWeights = {};
    let familyWeight = mainWeight;
    for (const entry of activeLeftBreakaways) {
        const exitStrength = Math.max(
            1,
            finitePolling(
                Q[entry.caucus + "_exit_strength"],
                5
            )
        );
        const relationPenalty = Math.max(
            0.62,
            1 -
                Math.max(
                    0,
                    finitePolling(
                        Q[entry.caucus + "_party_relation"],
                        20
                    ) - 45
                ) * 0.004
        );
        breakawayWeights[entry.id] =
            exitStrength * entry.retention * relationPenalty;
        familyWeight += breakawayWeights[entry.id];
    }
    corrected.left =
        familyAfterLeakage * mainWeight / Math.max(1, familyWeight);
    for (const entry of activeLeftBreakaways) {
        corrected[entry.id] =
            familyAfterLeakage *
            breakawayWeights[entry.id] /
            Math.max(1, familyWeight);
    }
    Q.left_fragmentation_loss =
        Math.round(fragmentationLoss * 100) / 100;
} else {
    Q.left_fragmentation_loss = 0;
}

if (Q.unia_centrum_formed) {
    const centrumShare = clampPolling(
        0.18 +
            Math.max(0, finitePolling(Q.centrum_relation, 35) - 35) *
                0.002,
        0.15,
        0.34
    );
    corrected.centrum = corrected.p2050 * centrumShare;
    corrected.p2050 -= corrected.centrum;
}
if (Q.pis_split) {
    const pisSeatsNow = Math.max(1, finitePolling(Q.pis_seats, 194));
    const rozwojShare = clampPolling(
        finitePolling(Q.pis_morawiecki_camp, 38) /
            (pisSeatsNow + finitePolling(Q.pis_morawiecki_camp, 38)),
        0.12,
        0.32
    );
    corrected.rozwoj = corrected.pis * rozwojShare;
    corrected.pis -= corrected.rozwoj;
}
if (Q.far_right_split) {
    const koronaShare = clampPolling(
        0.10 +
            finitePolling(Q.braun_martyrdom, 0) * 0.004 +
            finitePolling(Q.konf_braunist_share, 18) * 0.003,
        0.12,
        0.42
    );
    corrected.korona = corrected.konf * koronaShare;
    corrected.konf -= corrected.korona;
}

const thirdWayJoint =
    !!Q.p2050_emerged &&
    (!!Q.third_way_active || !!Q.third_way_2023_done) &&
    !Q.third_way_split;
const activeElectionParty = function(id) {
    if (id == "third_way") return thirdWayJoint;
    if (partyIds.includes(id)) return activeParty(id);
    if (id == "centrum") return !!Q.unia_centrum_formed;
    if (id == "rozwoj") return !!Q.pis_split;
    if (id == "korona") return !!Q.far_right_split;
    return activeLeftBreakaways.some(function(entry) {
        return entry.id == id;
    });
};
const correctedTotal = electionPartyIds.reduce(function(total, id) {
    return total + corrected[id];
}, 0);
for (const id of electionPartyIds) {
    Q[id + "_vote_intent"] =
        corrected[id] * 100 / Math.max(1, correctedTotal);
}
Q.third_way_joint_list = thirdWayJoint ? 1 : 0;
Q.third_way_vote_intent = thirdWayJoint
    ? Q.psl_vote_intent + Q.p2050_vote_intent
    : 0;
Q.third_way_threshold = thirdWayJoint ? 8 : 0;

// The published poll is a seeded sample, not omniscience. Noise is applied to
// every active party and then conserved back to exactly 100 after rounding.
const sampled = {};
for (const id of electionPartyIds) {
    if (!activeElectionParty(id)) {
        sampled[id] = 0;
        continue;
    }
    const noise =
        (this.random.uint32() / 4294967296 - 0.5) * 0.9;
    sampled[id] = Math.max(
        0.05,
        Q[id + "_vote_intent"] + noise
    );
}
const sampledTotal = electionPartyIds.reduce(function(total, id) {
    return total + sampled[id];
}, 0);
for (const id of electionPartyIds) {
    Q[id + "_poll"] = Math.round(
        sampled[id] * 1000 / Math.max(1, sampledTotal)
    ) / 10;
}
const roundedTotal = electionPartyIds.reduce(function(total, id) {
    return total + Q[id + "_poll"];
}, 0);
const roundingResidual = Math.round((100 - roundedTotal) * 10) / 10;
let residualParty = "other";
if (Q.other_poll + roundingResidual < 0) {
    residualParty = namedPartyIds.filter(activeParty).sort(function(a, b) {
        return Q[b + "_poll"] - Q[a + "_poll"];
    })[0];
}
Q[residualParty + "_poll"] = Math.round(
    (Q[residualParty + "_poll"] + roundingResidual) * 10
) / 10;

// National d'Hondt is deliberately an indicator rather than a claim to have
// simulated 41 district lists. Thresholds reflect the list forms used here.
const thresholds = {
    left: 5,
    pis: 5,
    ko: 8,
    psl: 5,
    konf: 5,
    p2050: 5,
    sld_breakaway: 5,
    spring_breakaway: 5,
    labor_left: 5,
    young_left: 5,
    razem: 5,
    pps: 5,
    centrum: 5,
    rozwoj: 5,
    korona: 5,
    third_way: 8
};
const seatPartyIds = (
    thirdWayJoint
        ? namedPartyIds.filter(function(id) {
            return id != "psl" && id != "p2050";
        }).concat(["third_way"])
        : namedPartyIds
).concat(dynamicPartyIds);
const committeeVoteIntent = function(id) {
    return id == "third_way"
        ? Q.third_way_vote_intent
        : Q[id + "_vote_intent"];
};
const seatParties = seatPartyIds.filter(function(id) {
    return activeElectionParty(id) &&
        committeeVoteIntent(id) >= thresholds[id];
});
if (!seatParties.length) {
    const fallback = seatPartyIds.filter(activeElectionParty).sort(function(a, b) {
        return committeeVoteIntent(b) - committeeVoteIntent(a);
    })[0];
    seatParties.push(fallback);
}
const seatProjection = {
    left: 0,
    pis: 0,
    ko: 0,
    psl: 0,
    konf: 0,
    p2050: 0,
    sld_breakaway: 0,
    spring_breakaway: 0,
    labor_left: 0,
    young_left: 0,
    razem: 0,
    pps: 0,
    centrum: 0,
    rozwoj: 0,
    korona: 0,
    third_way: 0
};
for (let seat = 0; seat < 460; seat += 1) {
    let winner = seatParties[0];
    let bestQuotient = -1;
    for (const id of seatParties) {
        const quotient =
            committeeVoteIntent(id) /
            (seatProjection[id] + 1);
        if (quotient > bestQuotient) {
            bestQuotient = quotient;
            winner = id;
        }
    }
    seatProjection[winner] += 1;
}
if (thirdWayJoint) {
    const jointSeats = seatProjection.third_way;
    const jointVote = Math.max(
        0.01,
        Q.psl_vote_intent + Q.p2050_vote_intent
    );
    const pslExact = jointSeats * Q.psl_vote_intent / jointVote;
    seatProjection.psl = Math.floor(pslExact);
    seatProjection.p2050 = jointSeats - seatProjection.psl;
} else {
    seatProjection.third_way = 0;
}
for (const id of Object.keys(seatProjection)) {
    Q[id + "_projected_seats"] = seatProjection[id];
}
Q.other_projected_seats = 0;

// Coalition worksheets consume projected seats and compatibility summaries.
// The exact pairwise relations remain hidden simulation state.
Q.left_splinter_projected_seats =
    Q.sld_breakaway_projected_seats +
    Q.spring_breakaway_projected_seats +
    Q.labor_left_projected_seats +
    Q.young_left_projected_seats +
    Q.razem_projected_seats +
    Q.pps_projected_seats;
Q.left_family_projected_seats =
    Q.left_projected_seats + Q.left_splinter_projected_seats;
Q.left_splinter_support_projected_seats =
    (Q.barons_party_relation >= 45
        ? Q.sld_breakaway_projected_seats : 0) +
    (Q.spring_party_relation >= 45
        ? Q.spring_breakaway_projected_seats : 0) +
    (Q.labor_party_relation >= 45
        ? Q.labor_left_projected_seats : 0) +
    (Q.progressives_party_relation >= 45
        ? Q.young_left_projected_seats : 0) +
    (Q.razem_party_relation >= 45
        ? Q.razem_projected_seats : 0) +
    (Q.pps_party_relation >= 45
        ? Q.pps_projected_seats : 0);
Q.left_committed_projected_seats =
    Q.left_projected_seats + Q.left_splinter_support_projected_seats;
Q.coalition_democratic_seats =
    Q.ko_projected_seats + Q.psl_projected_seats +
    Q.left_committed_projected_seats +
    (Q.p2050_emerged ? Q.p2050_projected_seats : 0) +
    Q.centrum_projected_seats;
Q.coalition_right_seats =
    Q.pis_projected_seats + Q.konf_projected_seats +
    Q.rozwoj_projected_seats + Q.korona_projected_seats;
Q.coalition_center_seats =
    Q.ko_projected_seats + Q.psl_projected_seats +
    (Q.p2050_emerged ? Q.p2050_projected_seats : 0) +
    Q.centrum_projected_seats;
Q.coalition_pis_psl_seats =
    Q.pis_projected_seats + Q.psl_projected_seats;
const democraticCompatibilityParts = [
    finitePolling(Q.rival_relation_ko_psl, 50),
    finitePolling(Q.ko_relation, 40),
    finitePolling(Q.psl_relation, 25)
];
if (Q.p2050_emerged) {
    democraticCompatibilityParts.push(
        finitePolling(Q.rival_relation_ko_p2050, 50),
        finitePolling(Q.rival_relation_psl_p2050, 50),
        finitePolling(Q.p2050_relation, 30)
    );
}
const democraticRelationScore =
    democraticCompatibilityParts.reduce(function(total, value) {
        return total + value;
    }, 0) / democraticCompatibilityParts.length;
const democraticPolicyParts = [
    100 - Math.abs(
        finitePolling(Q.ko_right_score, 50) -
        finitePolling(Q.left_right_score, 32)
    ),
    100 - Math.abs(
        finitePolling(Q.psl_right_score, 62) -
        finitePolling(Q.left_right_score, 32)
    )
];
const democraticOpennessParts = [
    finitePolling(Q.ko_coalition_openness, 45),
    finitePolling(Q.psl_coalition_openness, 35)
];
if (Q.p2050_emerged) {
    democraticPolicyParts.push(
        100 - Math.abs(
            finitePolling(Q.p2050_right_score, 52) -
            finitePolling(Q.left_right_score, 32)
        )
    );
    democraticOpennessParts.push(
        finitePolling(Q.p2050_coalition_openness, 40)
    );
}
const democraticPolicyScore =
    democraticPolicyParts.reduce(function(total, value) {
        return total + value;
    }, 0) / democraticPolicyParts.length;
const democraticOpennessScore =
    democraticOpennessParts.reduce(function(total, value) {
        return total + value;
    }, 0) / democraticOpennessParts.length;
Q.coalition_democratic_score = Math.round(clampPolling(
    democraticRelationScore * 0.55 +
        democraticPolicyScore * 0.25 +
        democraticOpennessScore * 0.20,
    0,
    100
));
const rightPolicyCompatibility =
    (
        100 - Math.abs(
            finitePolling(Q.pis_economic_position, 31) -
            finitePolling(Q.konf_economic_position, 86)
        ) +
        100 - Math.abs(
            finitePolling(Q.pis_cultural_position, 86) -
            finitePolling(Q.konf_cultural_position, 91)
        )
    ) / 2;
const konfNormalisation =
    42 +
    finitePolling(Q.konf_nationalist_share, 35) * 0.35 +
    finitePolling(Q.konf_mentzenite_share, 47) * 0.08 -
    finitePolling(Q.konf_braunist_share, 18) * 0.55;
Q.coalition_right_score = Math.round(clampPolling(
    finitePolling(Q.rival_relation_pis_konf, 30) * 0.52 +
        rightPolicyCompatibility * 0.28 +
        konfNormalisation * 0.20,
    0,
    100
));
const centerRelationScore = Q.p2050_emerged
    ? (
        finitePolling(Q.rival_relation_ko_psl, 50) +
        finitePolling(Q.rival_relation_ko_p2050, 50) +
        finitePolling(Q.rival_relation_psl_p2050, 50)
    ) / 3
    : finitePolling(Q.rival_relation_ko_psl, 50);
const centerPolicyScore = Q.p2050_emerged
    ? (
        100 - Math.abs(
            finitePolling(Q.ko_right_score, 50) -
            finitePolling(Q.psl_right_score, 62)
        ) +
        100 - Math.abs(
            finitePolling(Q.ko_right_score, 50) -
            finitePolling(Q.p2050_right_score, 52)
        ) +
        100 - Math.abs(
            finitePolling(Q.psl_right_score, 62) -
            finitePolling(Q.p2050_right_score, 52)
        )
    ) / 3
    : 100 - Math.abs(
        finitePolling(Q.ko_right_score, 50) -
        finitePolling(Q.psl_right_score, 62)
    );
Q.coalition_center_score = Math.round(clampPolling(
    centerRelationScore * 0.68 +
        centerPolicyScore * 0.22 +
        finitePolling(Q.third_way_cohesion, 50) * 0.10,
    0,
    100
));
const pisPslPolicyBridge =
    (
        finitePolling(Q.pis_solidarist_share, 58) +
        finitePolling(Q.psl_agrarian_pragmatist_share, 45) +
        finitePolling(Q.psl_conservative_share, 35)
    ) / 3;
Q.coalition_pis_psl_score = Math.round(clampPolling(
    finitePolling(Q.rival_relation_pis_psl, 30) * 0.62 +
        pisPslPolicyBridge * 0.28 +
        finitePolling(Q.psl_coalition_manager_share, 20) * 0.10,
    0,
    100
));

for (const id of electionPartyIds) {
    Q["poll_last_model_" + id] = Q[id + "_poll"];
    Q[id + "_poll_momentum"] =
        finitePolling(Q[id + "_poll_momentum"], 0) * 0.86;
}
Q.poll_last_updated = Q.date_label;
if (Q.left_vote_intent < 5) {
    Q.poll_danger_months =
        Math.max(0, finitePolling(Q.poll_danger_months, 0)) + 1;
} else {
    Q.poll_danger_months = 0;
}
Q.poll_state_month_key = pollMonthKey;
}
Q.polling_has_dated_route =
    (
        Q.year == 2019 && Q.month == 11 && !Q.candidate_event_done
    ) ||
    (
        Q.year == 2019 && Q.month == 12 && !Q.budget_2019_done
    ) ||
    (
        Q.year == 2020 && Q.month == 1 && !Q.media_event_done
    ) ||
    (Q.year == 2020 && Q.month == 2) ||
    (
        Q.year == 2020 && Q.month == 3 && !Q.covid_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 4 && !Q.postal_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 5 && !Q.shield_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 6 && !Q.election_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 7 && !Q.reckoning_event_done
    ) ||
    (Q.year == 2020 && Q.month == 8) ||
    (
        Q.year == 2020 && Q.month == 9 && !Q.merger_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 10 && !Q.abortion_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 11 && !Q.strike_event_done
    ) ||
    (
        Q.year == 2020 && Q.month == 12 && !Q.budget_2020_done
    ) ||
    (
        Q.year == 2021 && Q.month == 1 && !Q.vaccine_event_done
    ) ||
    (Q.year == 2021 && Q.month == 2) ||
    (
        Q.year == 2021 && Q.month == 3 && !Q.rename_event_done
    ) ||
    (Q.year == 2021 && Q.month == 4) ||
    (
        Q.year == 2021 && Q.month == 5 && !Q.recovery_fund_event_done
    ) ||
    (
        Q.year == 2021 && Q.month == 6 && !Q.opposition_reset_event_done
    ) ||
    (
        Q.year == 2021 && Q.month == 7 && !Q.left_revolt_event_done
    ) ||
    (
        Q.year == 2021 && Q.month >= 8
    ) ||
    Q.year == 2022 ||
    (
        Q.year == 2023 && Q.month <= 7
    ) ||
    (
        (Q.year == 2023 && Q.month >= 8) ||
        Q.year == 2024 ||
        Q.year == 2025 ||
        Q.year == 2026
    ) ? 1 : 0;
!}
