                Q.spring_active && Q.spring_in_left
            ) ||
            !Q.czajka_2020_done || !Q.animals_2020_done ||
            !Q.fiore_braun_2020_done ||
            !Q.emilewicz_left_porozumienie
        )
    ) ||
    (
        Q.year == 2020 && Q.month == 10 &&
        (!Q.abortion_event_done || !Q.gowin_return_resolved)
    ) ||
    (
        Q.year == 2020 && Q.month == 11 &&
        (
            !Q.strike_event_done || !Q.churches_2020_done ||
            !Q.eu_budget_veto_2020_done
        )
    ) ||
    (
        Q.year == 2020 && Q.month == 12 && !Q.budget_2020_done
    ) ||
    (
        Q.year == 2021 && Q.month == 1 && !Q.vaccine_event_done
    ) ||
    (Q.year == 2021 && Q.month == 2) ||
    (
        Q.year == 2021 && Q.month == 3 &&
        (!Q.rename_event_done || !Q.bielan_rebellion_done)
    ) ||
    (Q.year == 2021 && Q.month == 4) ||
    (
        Q.year == 2021 && Q.month == 5 &&
        (!Q.recovery_fund_event_done || !Q.republikanie_event_done ||
            Q.last_labor_day_year < 2021)
    ) ||
    (
        Q.year == 2021 && Q.month == 6 &&
        (!Q.opposition_reset_event_done || !Q.kp_rupture_done ||
            Q.last_pride_year < 2021)
    ) ||
    (
        Q.year == 2021 && Q.month == 7 &&
        (!Q.tusk_return_2021_done || !Q.left_revolt_event_done ||
            !Q.kukiz_negotiation_done)
    ) ||
    (
        Q.year == 2021 && Q.month >= 8
    ) ||
    Q.year == 2022 ||
    (
        Q.year == 2023 && Q.month <= 7
    ) ||
    (
        (Q.year == 2023 && Q.month >= 8) ||
        Q.year == 2024 ||
        Q.year == 2025 ||
        Q.year == 2026 ||
        Q.year == 2027
    ) ? 1 : 0;
const historicalChainMonth =
    (Q.year == 2020 && [1, 2, 6, 8, 10].includes(Q.month)) ||
    (Q.year == 2021 && [3, 5, 6, 7].includes(Q.month));
if (Q.year < 2023 || (Q.year == 2023 && Q.month <= 7)) {
    Q.poland_historical_event_phase =
        historicalChainMonth && Q.polling_has_dated_route ? 1 : 0;
}
// A faction deadline remains live, but it may not win the dispatch race
// against a dated route. Normalisation keeps deriving the raw deadline from
// the untouched faction stages and exposes it again once this lock is clear.
Q.caucus_crisis_deferred = Q.polling_has_dated_route ? 1 : 0;
!}
