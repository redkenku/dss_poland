    Q.public_trust -= 3;
    Q.presidential_campaign_bonus = (Q.presidential_campaign_bonus || 0) - 0.2;
    Q.news_headline = "A campaign without a ballot or a broadcast plan drifts";
}
!}

[? if media_capacity >= 25: We keep the legal objection clear while our digital
campaign reaches voters confined at home. Defiance looks like preparation, not
denial. ?]

[? if media_capacity < 25: We insist that we are competing, but cannot explain
how supporters should vote or why the procedure is legitimate. Defiance looks
like drift. ?]

- @poland_hub: Return to the campaign

@shield
