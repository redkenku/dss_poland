Q.anti_establishment_youth_konf_affinity += 1.5;
Q.economic_growth = -2.0;
Q.inflation = 3.4;
Q.unemployment = 5.4;
Q.public_debt = 55.0;
Q.budget_balance = -7.0;
Q.story_queue = Array.isArray(Q.story_queue) ? Q.story_queue : [];
Q.story_queue.push({
