!}
go-to: internal_ratification

@finance_spending_restraint
title: Freeze administrative growth and trim untargeted subsidies
subtitle: Cuts the deficit, but weakens wage and service guarantees rather than creating free money.
on-arrival: {!
Q.annual_budget_financing = "Administrative and subsidy restraint";
Q.annual_budget_market_cuts = 1;
Q.annual_budget_public_wage_guarantee = 0;
Q.annual_budget_social_share = Math.round(
    Math.max(14, Number(Q.annual_budget_social_share) - 0.8) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 1.1) * 10
) / 10;
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_demands_text +=
    "; financed through an administrative freeze and subsidy cuts";
Q.news_headline = "The budget saves money by narrowing its own public promise";
!}
go-to: internal_ratification

@internal_ratification
title: The party reads the actual numbers
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const budgetModel = (typeof window !== "undefined"
    ? window : globalThis).polandBudgetModel;
const activeBudgetFactions = budgetModel.activeFactions(Q);
const factionTargets = budgetModel.factions;
const social = Number(Q.annual_budget_social_share) || 17;
const defence = Number(Q.annual_budget_defence_share) || 4.6;
const deficit = Number(Q.annual_budget_deficit_share) || 4.5;
/* A current can live with a frame it dislikes. It cannot live with one that
 * breaks a commitment its own people were told was already funded. */
const socialFloor = Number(Q.annual_budget_social_floor) || 0;
const socialFloorBreach = Math.max(0, socialFloor - social);
let weightedBacking = 0;
let activeStrength = 0;
let angryLabels = [];
let concernLabels = [];
let satisfiedLabels = [];
let redLineVetoes = 0;
for (const faction of [
    "barons", "spring", "labor", "progressives",
    "razem", "pps", "social_patriot"
]) {
    Q["annual_budget_" + faction + "_active"] = 0;
    Q["annual_budget_" + faction + "_backing"] = 100;
}

for (const faction of activeBudgetFactions) {
    Q["annual_budget_" + faction + "_active"] = 1;
    const target = factionTargets[faction] || factionTargets.barons;
    const support = budgetModel.factionBacking(Q, faction);
    Q["annual_budget_" + faction + "_backing"] = support;
    const strength = Math.max(0, Number(Q[faction + "_strength"]) || 0);
    weightedBacking += support * strength;
    activeStrength += strength;

    if (support < 30 && strength >= 2) {
        angryLabels.push(target.label);
        redLineVetoes += 1;
    } else if (support < 60 && strength >= 2) {
        concernLabels.push(target.label);
    } else if (support >= 70 && strength >= 2) {
        satisfiedLabels.push(target.label);
    }
}

Q.annual_budget_internal_backing = Math.round(
    weightedBacking / Math.max(1, activeStrength)
);
Q.annual_budget_internal_vetoes = redLineVetoes;
Q.annual_budget_angry_factions = angryLabels.length
    ? angryLabels.join(", ") : "None";
Q.annual_budget_concerned_factions = concernLabels.length
    ? concernLabels.join(", ") : "None";
Q.annual_budget_satisfied_factions = satisfiedLabels.length
    ? satisfiedLabels.join(", ") : "None";
Q.annual_budget_party_goal_report =
    "Social " + social + "% · Defence " + defence +
    "% · Deficit " + deficit + "% GDP";
const envelopeBreaches = [];
if (socialFloorBreach > 0) {
    envelopeBreaches.push(
        "the social floor by " + Math.round(socialFloorBreach * 10) / 10
    );
}
if (defence < (Number(Q.annual_budget_defence_floor) || 0)) {
    envelopeBreaches.push(
        "the defence floor by " +
        Math.round((Q.annual_budget_defence_floor - defence) * 10) / 10
    );
}
if (deficit > (Number(Q.annual_budget_deficit_ceiling) || 99)) {
    envelopeBreaches.push(
        "the deficit ceiling by " +
        Math.round((deficit - Q.annual_budget_deficit_ceiling) * 10) / 10
    );
}
Q.annual_budget_envelope_status = envelopeBreaches.length
    ? "This text breaks " + envelopeBreaches.join(" and ") +
        " points of GDP. Somebody was promised that money."
    : "This text clears every floor and the deficit ceiling.";
!}

= A current—or the labour movement—has to object to something real

Current frame: **[+ annual_budget_party_goal_report +]**. Financing:
**[+ annual_budget_financing +]**.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Internal and movement backing</div>
<div class="ledger-row"><span>Weighted backing</span><b>[+ annual_budget_internal_backing +]%</b></div>
<div class="ledger-row"><span>Red-line vetoes</span><b>[+ annual_budget_internal_vetoes +]</b></div>
<div class="ledger-row"><span>Angry</span><b>[+ annual_budget_angry_factions +]</b></div>
<div class="ledger-row"><span>Uneasy</span><b>[+ annual_budget_concerned_factions +]</b></div>
<div class="ledger-row"><span>Satisfied</span><b>[+ annual_budget_satisfied_factions +]</b></div>
<div class="ledger-subrow">[+ annual_budget_envelope_status +]</div></div>

[? if annual_budget_barons_active: SLD establishment: **[+ annual_budget_barons_backing +]%**.?]
[? if annual_budget_spring_active: Wiosna: **[+ annual_budget_spring_backing +]%**.?]
[? if annual_budget_labor_active: Lewica Pracy: **[+ annual_budget_labor_backing +]%**.?]
[? if annual_budget_progressives_active: Younger progressives: **[+ annual_budget_progressives_backing +]%**.?]
[? if annual_budget_razem_active: Razem: **[+ annual_budget_razem_backing +]%**.?]
[? if annual_budget_pps_active: PPS: **[+ annual_budget_pps_backing +]%**.?]
[? if annual_budget_social_patriot_active: Social patriots: **[+ annual_budget_social_patriot_backing +]%**.?]

No party current or movement partner gains conflict merely because a budget
exists. It becomes hostile when the numbers or a named deal cross its own red
line; final effects apply only to the text that actually survives the Senate.

- @internal_restore_wages
- @internal_green_care
- @internal_deficit_limit
- @internal_lock

@internal_restore_wages
title: Restore a funded wage and staffing guarantee
subtitle: Cost: 1 governing-capacity point. Raises social spending and repairs a concrete labour objection.
view-if: annual_budget_internal_revision_used = 0 and annual_budget_public_wage_guarantee = 0 and ((annual_budget_labor_active and annual_budget_labor_backing < 50) or (annual_budget_razem_active and annual_budget_razem_backing < 45) or (annual_budget_pps_active and annual_budget_pps_backing < 50))
choose-if: budget >= 1
unavailable-subtitle: The cabinet has no capacity left to reopen the staffing schedules.
on-arrival: {!
Q.budget -= 1;
Q.annual_budget_internal_revision_used = 1;
Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_market_cuts = 0;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.3) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.2) * 10
) / 10;
Q.annual_budget_demands_text += "; funded wage and staffing guarantee restored";
Q.news_headline = "The cabinet restores the wage line before asking its caucuses to vote";
!}
go-to: internal_ratification

@internal_green_care
