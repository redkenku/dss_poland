@annual_budget
title: The annual budget council
new-page: true
call: poland_normalize
on-arrival: {!
const budgetNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const budgetClamp = function(value, low, high) {
    return Math.max(low, Math.min(high, budgetNum(value, low)));
};
const budgetRound = function(value) {
    return Math.round(Number(value) * 10) / 10;
};
const budgetMove = function(current, target, step) {
    const start = budgetNum(current, target);
    if (Math.abs(target - start) <= step) return target;
    return start + (target > start ? step : -step);
};

Q.annual_budget_fiscal_year =
    budgetNum(Q.annual_budget_year, budgetNum(Q.year, 0)) + 1;
Q.annual_budget_passed = 0;
Q.annual_budget_vote_round = 1;
Q.annual_budget_margin = 0;
Q.annual_budget_internal_backing = 0;
Q.annual_budget_internal_vetoes = 0;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.annual_budget_government_yes = 0;
Q.annual_budget_government_abstain = 0;
Q.annual_budget_package_code = 0;
Q.annual_budget_negotiation_outcome = 0;
Q.annual_budget_recorded_defectors = 0;
Q.annual_budget_revision_pending = 0;
Q.annual_budget_cabinet_response = "No revision submitted";
Q.budget_rescue_bonus = 0;
Q.annual_budget_shortfall = 0;
Q.annual_budget_threshold = 0;
Q.annual_budget_present = 0;
Q.annual_budget_yes = 0;
Q.annual_budget_no = 0;
Q.annual_budget_abstain = 0;
Q.annual_budget_strategy = "No package selected";
Q.annual_budget_financing = "No financing selected";
Q.annual_budget_posture = "Unsettled";
Q.annual_budget_concession = "None";
Q.annual_budget_concession_code = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_internal_revision_used = 0;
Q.annual_budget_external_deal_used = 0;
Q.annual_budget_external_deal_target = "None";
Q.annual_budget_external_votes_committed = 0;
Q.annual_budget_external_votes_live = 0;
Q.annual_budget_external_votes_available = 0;
Q.annual_budget_whip_used = 0;
Q.annual_budget_whip_bonus = 0;
Q.annual_budget_rescue_used = 0;
Q.annual_budget_rescue_kind = "None";
Q.annual_budget_senate_stage_done = 0;
Q.annual_budget_senate_corrections_pending = 0;
Q.annual_budget_senate_corrections_accepted = 0;
Q.annual_budget_senate_result = "No Senate review yet";
Q.annual_budget_senate_correction = "No amendment package pending";
Q.annual_budget_senate_delta_social = 0;
Q.annual_budget_senate_delta_defence = 0;
Q.annual_budget_senate_delta_deficit = 0;
Q.annual_budget_senate_override_yes = 0;
Q.annual_budget_senate_override_no = 0;
Q.annual_budget_senate_override_abstain = 0;
Q.annual_budget_senate_override_threshold = 0;
Q.annual_budget_senate_override_passed = 0;
Q.annual_budget_finalised = 0;
Q.annual_budget_effects_applied = 0;
Q.budget_confidence_triggered = 0;
Q.budget_rescue_attempted = 0;

Q.annual_budget_public_wage_guarantee = 0;
Q.annual_budget_progressive_revenue = 0;
Q.annual_budget_kpo_cofinance = 0;
Q.annual_budget_green_investment = 0;
Q.annual_budget_local_compact = 0;
Q.annual_budget_market_cuts = 0;
Q.annual_budget_family_defence_deal = 0;
Q.annual_budget_delivery_register = 0;
Q.annual_budget_deficit_rule = 0;
Q.annual_budget_reconstruction_fund = 0;
Q.annual_budget_right_deal = 0;
Q.annual_budget_opposition_offer_made = 0;
Q.annual_budget_opposition_offer_strength = 0;

Q.annual_budget_left_cabinet_authority =
    Q.left_in_government &&
    Q.government_has_confidence &&
    !Q.caretaker_government ? 1 : 0;
const financeCode = String(Q.finance_minister_party || "").toLowerCase();
Q.annual_budget_finance_control =
    Q.annual_budget_left_cabinet_authority &&
    (financeCode.includes("lewic") || financeCode == "left") ? 1 : 0;

/* The draft is normally submitted at the end of September.  The December
 * scene is the political settlement and first Sejm roll call. */
Q.budget_submission_time = Math.max(0, budgetNum(Q.time, 0) - 3);
Q.budget_submission_year = budgetNum(Q.year, Q.annual_budget_year);
Q.budget_submission_month = 9;
Q.budget_deadline_time = Q.budget_submission_time + 4;
const budgetDeadlineIndex =
    Q.budget_submission_year * 12 +
    Math.max(0, Q.budget_submission_month - 1) + 4;
Q.budget_deadline_year = Math.floor(budgetDeadlineIndex / 12);
Q.budget_deadline_month = budgetDeadlineIndex % 12 + 1;
const budgetMonthNames = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];
Q.budget_deadline_label =
    budgetMonthNames[Q.budget_deadline_month - 1] +
    " " + Q.budget_deadline_year;
Q.budget_deadline_active = 1;

const governmentTargets = {
    pis: {social: 18.7, defence: 5.0, deficit: 5.7},
    ko: {social: 17.8, defence: 4.8, deficit: 4.5},
    psl: {social: 17.3, defence: 5.0, deficit: 4.2},
    p2050: {social: 17.5, defence: 4.7, deficit: 4.1},
    konf: {social: 15.9, defence: 5.0, deficit: 3.4},
    lewica: {social: 19.2, defence: 4.5, deficit: 5.1},
    left: {social: 19.2, defence: 4.5, deficit: 5.1},
    default: {social: 17.8, defence: 4.7, deficit: 4.6}
};
const governmentTarget =
    governmentTargets[String(Q.government_party || "").toLowerCase()] ||
    governmentTargets.default;

let inheritedSocial;
let inheritedDefence;
let inheritedDeficit;
if (
    budgetNum(Q.annual_budget_enacted_fiscal_year, 0) ==
        Q.annual_budget_fiscal_year - 1
) {
    inheritedSocial = budgetNum(
        Q.annual_budget_enacted_social_share,
        governmentTarget.social
    );
    inheritedDefence = budgetNum(
        Q.annual_budget_enacted_defence_share,
        governmentTarget.defence
    );
    inheritedDeficit = budgetNum(
        Q.annual_budget_enacted_deficit_share,
        governmentTarget.deficit
    );
} else if (budgetNum(Q.annual_budget_year, 0) == 2023) {
    /* The incoming post-election cabinet inherits the outgoing government's
     * submitted 2024 frame instead of magically writing a new September draft. */
    inheritedSocial = 18.6;
    inheritedDefence = 4.9;
    inheritedDeficit = 5.8;
} else {
    inheritedSocial = governmentTarget.social;
    inheritedDefence = governmentTarget.defence;
    inheritedDeficit = governmentTarget.deficit;
}

Q.annual_budget_previous_social_share = budgetRound(inheritedSocial);
Q.annual_budget_previous_defence_share = budgetRound(inheritedDefence);
Q.annual_budget_previous_deficit_share = budgetRound(inheritedDeficit);

let draftSocial = budgetMove(inheritedSocial, governmentTarget.social, 0.5);
let draftDefence = budgetMove(inheritedDefence, governmentTarget.defence, 0.4);
let draftDeficit = budgetMove(inheritedDeficit, governmentTarget.deficit, 0.5);

const inflation = budgetNum(Q.inflation, 4.0);
const fiscalStress = budgetNum(Q.fiscal_stress, 25);
const debt = budgetNum(Q.public_debt, 50);
Q.annual_budget_cost_pressure = budgetClamp(
    Math.max(0, inflation - 3) * 4 +
        Math.max(0, fiscalStress - 30) * 0.35 +
        Math.max(0, debt - 55) * 0.25,
    0,
    35
);
Q.annual_budget_reconstruction_pressure =
    budgetNum(Q.annual_budget_year, 0) == 2024 ? 1 : 0;
Q.annual_budget_election_pressure =
    budgetNum(Q.annual_budget_year, 0) == 2026 ? 1 : 0;
Q.annual_budget_cohabitation_pressure =
    budgetNum(Q.annual_budget_year, 0) >= 2025 &&
    Q.government_party != "pis" &&
    (Q.pres_2025_hostile_president || [
        "Andrzej Duda", String(Q.pres_2025_right_candidate || ""),
        "Sławomir Mentzen",
        "Grzegorz Braun"
    ].includes(Q.president_name)) ? 1 : 0;

if (Q.annual_budget_reconstruction_pressure) {
    draftSocial += 0.2;
    draftDeficit += 0.2;
    Q.annual_budget_reconstruction_fund = 1;
}
if (Q.annual_budget_cost_pressure >= 18) {
    draftSocial += 0.2;
    draftDeficit += 0.2;
}
if (Q.annual_budget_election_pressure) {
    draftSocial += 0.1;
    draftDeficit += 0.1;
}

/* The envelope.  A budget is not a blank sheet of preferences: statutory
 * indexation, the reforms already on the slate and the alliance commitments
 * are claims on next year's money before any minister writes a wish.  These
 * three lines are what the year has already spent, and what a package has to
 * clear before its politics matter.  Breaking one is allowed — it is simply
 * a decision with a named victim rather than an accounting rounding. */
const onSlate = function(issue) {
    return Q[issue + "_on_slate"] &&
        budgetNum(Q[issue + "_reform_stage"], 0) > 0 ? 1 : 0;
};
const indexation = Math.max(0, inflation - 2.5) * 0.14;
let socialFloor = inheritedSocial + indexation;
const socialClaims = [];
if (indexation >= 0.05) {
    socialClaims.push(
        "statutory indexation at " + budgetRound(inflation) + "% inflation (+" +
        budgetRound(indexation) + ")"
    );
}
if (onSlate("labor")) {
    socialFloor += 0.4;
    socialClaims.push("the labour reform already on the slate (+0.4)");
}
if (onSlate("health")) {
    socialFloor += 0.4;
    socialClaims.push("the health reform already on the slate (+0.4)");
}
if (Q.annual_budget_wage_guarantee_owed) {
    socialFloor += 0.3;
    socialClaims.push("last year's enacted public-wage guarantee (+0.3)");
}
if (Q.razem_budget_support_pact || Q.razem_in_government) {
    socialFloor += 0.3;
    socialClaims.push("Razem's written supply terms (+0.3)");
}
if (Q.annual_budget_reconstruction_pressure) {
    socialFloor += 0.3;
    socialClaims.push("flood reconstruction already under contract (+0.3)");
}

const threat = budgetClamp(
    Math.max(
        budgetNum(Q.war_escalation_risk, 0),
        budgetNum(Q.ukraine_solidarity, 0) * 0.5
    ),
    0,
    100
);
let defenceFloor = 4.0 + threat / 100 * 1.2;
const defenceClaims = [
    "the NATO floor and signed procurement (" + budgetRound(4.0) + ")"
];
if (threat >= 20) {
    defenceClaims.push(
        "the eastern threat assessment (+" +
        budgetRound(threat / 100 * 1.2) + ")"
    );
}
if (onSlate("defence")) {
    defenceFloor += 0.3;
    defenceClaims.push("the defence reform already on the slate (+0.3)");
}

let deficitCeiling = 5.6 -
    Math.max(0, debt - 46) * 0.16 -
    Math.max(0, fiscalStress - 20) * 0.03;
deficitCeiling = Math.max(3.0, deficitCeiling);
const deficitClaims = ["the excessive-deficit procedure's own arithmetic"];
if (debt > 52) {
    deficitClaims.push("public debt at " + budgetRound(debt) + "% of GDP");
}
if (fiscalStress > 40) {
    deficitClaims.push("the cost of servicing what is already borrowed");
}

Q.annual_budget_social_floor = budgetRound(socialFloor);
Q.annual_budget_defence_floor = budgetRound(defenceFloor);
Q.annual_budget_deficit_ceiling = budgetRound(deficitCeiling);
Q.annual_budget_social_claims = socialClaims.length
    ? socialClaims.join("; ") : "no new statutory claim this year";
Q.annual_budget_defence_claims = defenceClaims.join("; ");
Q.annual_budget_deficit_claims = deficitClaims.join("; ");
Q.annual_budget_claimed_room = budgetRound(
    Math.max(0, socialFloor - inheritedSocial)
);

/* The ministry does not submit an illegal draft: the September frame already
 * meets the claims.  What the player chooses is what happens above them. */
draftSocial = Math.max(draftSocial, socialFloor);
draftDefence = Math.max(draftDefence, defenceFloor);

Q.annual_budget_draft_social_share = budgetRound(draftSocial);
Q.annual_budget_draft_defence_share = budgetRound(draftDefence);
Q.annual_budget_draft_deficit_share = budgetRound(draftDeficit);
Q.annual_budget_social_share = Q.annual_budget_draft_social_share;
Q.annual_budget_defence_share = Q.annual_budget_draft_defence_share;
Q.annual_budget_deficit_share = Q.annual_budget_draft_deficit_share;
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;

const sejmTotal = Math.max(1, Math.round(budgetNum(Q.sejm_total, 460)));
const leftSeats = Math.max(
    0,
    Math.min(sejmTotal, Math.round(budgetNum(Q.left_seats, 0)))
);
let governmentSeats = Math.round(budgetNum(Q.coalition_seats, 0));
if (governmentSeats <= 0) {
    governmentSeats = Math.round(budgetNum(Q.government_support_seats, 0));
}
if (governmentSeats <= 0) {
    governmentSeats =
        (Q.government_party == "pis" || Q.ministry_pis_in_cabinet
            ? Math.round(budgetNum(Q.pis_seats, 0)) : 0) +
        (Q.government_party == "ko" || Q.ministry_ko_in_cabinet
            ? Math.round(budgetNum(Q.ko_seats, 0)) : 0) +
        (Q.government_party == "psl" || Q.ministry_psl_in_cabinet
            ? Math.round(budgetNum(Q.psl_seats, 0)) : 0) +
        (Q.government_party == "p2050" || Q.ministry_p2050_in_cabinet
            ? Math.round(budgetNum(Q.p2050_seats, 0)) : 0) +
        (Q.government_party == "konf" || Q.ministry_konf_in_cabinet
            ? Math.round(budgetNum(Q.konf_seats, 0)) : 0) +
        (Q.left_in_government ? leftSeats : 0);
}
governmentSeats = Math.max(0, Math.min(sejmTotal, governmentSeats));
Q.annual_budget_government_seats = governmentSeats;
Q.annual_budget_left_seats = leftSeats;
Q.annual_budget_left_is_pivotal =
    Q.annual_budget_left_cabinet_authority
        ? governmentSeats - leftSeats < Math.floor(sejmTotal / 2) + 1
        : governmentSeats < Math.floor(sejmTotal / 2) + 1 &&
            governmentSeats + leftSeats >= Math.floor(sejmTotal / 2) + 1;

const annualBudgetPowerBase =
    Math.max(0, budgetNum(Q.negotiation_leverage, 0)) * 0.42 +
    leftSeats * 0.30 +
    Math.max(0, budgetNum(Q.ko_relation, 0)) * 0.10 +
    Math.max(0, budgetNum(Q.psl_relation, 0)) * 0.10 +
    Math.max(0, budgetNum(Q.p2050_relation, 0)) * 0.08 +
    (Q.annual_budget_left_is_pivotal ? 14 : 0) +
    (Q.annual_budget_finance_control ? 12 : 0);
Q.annual_budget_player_power = Math.round(
    budgetClamp(annualBudgetPowerBase / 1.8, 0, 100)
);

Q.annual_budget_preview_government_yes = governmentSeats;
Q.annual_budget_preview_other_no = Math.max(
    0,
    sejmTotal - governmentSeats - (Q.left_in_government ? 0 : leftSeats)
);
Q.annual_budget_preview_left_seats = leftSeats;
Q.annual_budget_demands_text = "No amendment written";
Q.annual_budget_result = "Drafting open";
!}

= December [+ annual_budget_year +] — fiscal year [+ annual_budget_fiscal_year +]

The submitted frame is not a blank sheet. It carries last year's commitments,
this year's prices and the political priorities of the ministry that wrote it.
The constitutional clock expires in **[+ budget_deadline_label +]**.

<div class="ledger-section ledger-section-first"><div class="ledger-title">Submitted fiscal frame (% of GDP)</div>
<div class="ledger-row"><span>Social and public services</span><b>[+ annual_budget_social_share +]%</b></div>
<div class="ledger-row"><span>Defence</span><b>[+ annual_budget_defence_share +]%</b></div>
<div class="ledger-row"><span>Deficit</span><b>[+ annual_budget_deficit_share +]%</b></div>
<div class="ledger-subrow">Previous enacted frame: social [+ annual_budget_previous_social_share +]% · defence [+ annual_budget_previous_defence_share +]% · deficit [+ annual_budget_previous_deficit_share +]%.</div></div>

<div class="ledger-section"><div class="ledger-title">Already spoken for before anybody chooses</div>
<div class="ledger-row"><span>Social floor</span><b>[+ annual_budget_social_floor +]%</b></div>
<div class="ledger-subrow">Claimed by [+ annual_budget_social_claims +].</div>
<div class="ledger-row"><span>Defence floor</span><b>[+ annual_budget_defence_floor +]%</b></div>
<div class="ledger-subrow">Claimed by [+ annual_budget_defence_claims +].</div>
<div class="ledger-row"><span>Deficit ceiling</span><b>[+ annual_budget_deficit_ceiling +]%</b></div>
<div class="ledger-subrow">Set by [+ annual_budget_deficit_claims +].</div>
<div class="ledger-subrow">[+ annual_budget_claimed_room +] points of GDP of next year's social spending were committed before this meeting opened. A package may still break a floor — it will name the people it breaks it on.</div></div>

[? if annual_budget_reconstruction_pressure: Flood reconstruction has already
added pressure before any discretionary promise is written.?]
[? if annual_budget_cohabitation_pressure: A hostile Palace cannot veto the
budget, but every disputed institution makes delay and implementation more
expensive.?]
[? if annual_budget_election_pressure: Every partner is reading the fiscal
frame as its last full campaign offer before the election.?]

[? if annual_budget_left_cabinet_authority and annual_budget_finance_control:
Lewica controls Finance and is responsible for the full fiscal frame. Expected
bargaining power is **[+ annual_budget_player_power +]/100**. The first choice
sets the package; the next must explain how it is financed.?]
[? if annual_budget_left_cabinet_authority and not annual_budget_finance_control:
Lewica is responsible for the coalition vote but does not control Finance.
Expected bargaining power is **[+ annual_budget_player_power +]/100**; weak
leverage scales down the first amendment before financing is chosen.?]
[? if not annual_budget_left_cabinet_authority: **[+ government_owner +]**
owns the bill. Lewica may force a written deal only if its votes are actually
needed; otherwise it chooses how to oppose, tolerate or monitor the text.?]

- @government_social_protocol
- @government_rural_compact
- @government_minimum
- @government_dare
- @poland_opposition_budget.start
- @poland_opposition_budget.audit: Audit last year's written opposition concession

@government_social_protocol
title: Make public services the organising promise
subtitle: Raise health, care, housing and public-sector capacity; the financing decision still follows.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const power = Q.annual_budget_finance_control
    ? 1
    : Math.max(0.25, Math.min(0.85, Number(Q.annual_budget_player_power) / 100));
Q.annual_budget_strategy = "Public-services expansion";
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_draft_social_share) + 1.5 + 0.7 * power) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_draft_defence_share) - 0.3) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_draft_deficit_share) + 1.0) * 10
) / 10;
Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_demands_text =
    "Health, care, housing and a funded public-wage guarantee";
Q.news_headline = "Lewica makes public services the budget's organising promise";
!}
go-to: budget_financing

@government_rural_compact
title: Build a reconstruction and local-investment coalition
subtitle: Protect social spending, raise defence and give counties visible capital projects.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const power = Q.annual_budget_finance_control
    ? 1
    : Math.max(0.25, Math.min(0.85, Number(Q.annual_budget_player_power) / 100));
Q.annual_budget_strategy = "Reconstruction and local investment";
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_draft_social_share) + 0.6 + 0.4 * power) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_draft_defence_share) + 0.8) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_draft_deficit_share) + 0.7) * 10
) / 10;
Q.annual_budget_local_compact = 1;
Q.annual_budget_reconstruction_fund = 1;
Q.annual_budget_demands_text =
    "County reconstruction, local transport and defence procurement";
Q.news_headline = "The coalition budget is organised around reconstruction and counties";
!}
go-to: budget_financing

@government_minimum
title: Write a moderate social-investment budget
subtitle: Leaves room for progressive revenue, KPO co-financing or a more cautious funding choice.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const power = Q.annual_budget_finance_control
    ? 1
    : Math.max(0.25, Math.min(0.85, Number(Q.annual_budget_player_power) / 100));
Q.annual_budget_strategy = "Moderate social investment";
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_draft_social_share) + 0.8 + 0.3 * power) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_draft_defence_share) + 0.1) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_draft_deficit_share) + 0.2) * 10
) / 10;
Q.annual_budget_demands_text =
    "Moderate public investment with financing still to be chosen";
Q.news_headline = "Lewica writes a moderate social-investment frame before choosing its financing";
!}
go-to: budget_financing

@government_dare
title: Protect the coalition with a restraint budget
subtitle: Lower the deficit now; public wages and movement promises bear the political risk.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
Q.annual_budget_strategy = "Coalition restraint budget";
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_draft_social_share) - 0.9) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_draft_defence_share) + 0.2) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_draft_deficit_share) - 1.2) * 10
) / 10;
Q.annual_budget_market_cuts = 1;
Q.annual_budget_deficit_rule = 1;
Q.annual_budget_demands_text =
    "Deficit reduction, administrative restraint and protected statutory benefits";
Q.news_headline = "The cabinet chooses fiscal restraint before the coalition vote";
!}
