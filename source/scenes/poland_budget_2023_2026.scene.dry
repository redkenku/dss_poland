subtitle: Cost: 1 governing-capacity point. Gives Wiosna and progressives a deliverable rather than a slogan.
view-if: annual_budget_internal_revision_used = 0 and annual_budget_green_investment = 0 and ((annual_budget_progressives_active and annual_budget_progressives_backing < 50) or (annual_budget_spring_active and annual_budget_spring_backing < 50))
choose-if: budget >= 1
unavailable-subtitle: The project pipeline lacks the capacity for another funded line.
on-arrival: {!
Q.budget -= 1;
Q.annual_budget_internal_revision_used = 1;
Q.annual_budget_green_investment = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.2) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.1) * 10
) / 10;
Q.annual_budget_demands_text += "; green care, housing and municipal energy line";
Q.news_headline = "A green care-and-housing line repairs the progressive side of the budget";
!}
go-to: internal_ratification

@internal_deficit_limit
title: Bind the package to a mid-year deficit review
subtitle: Trims the deficit without pretending that a review itself funds services.
view-if: annual_budget_internal_revision_used = 0 and annual_budget_deficit_rule = 0 and ((annual_budget_barons_active and annual_budget_barons_backing < 50) or (annual_budget_social_patriot_active and annual_budget_social_patriot_backing < 50)) and annual_budget_deficit_share > 4.5
on-arrival: {!
Q.annual_budget_internal_revision_used = 1;
Q.annual_budget_deficit_rule = 1;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 0.3) * 10
) / 10;
Q.annual_budget_social_share = Math.round(
    Math.max(14, Number(Q.annual_budget_social_share) - 0.1) * 10
) / 10;
Q.annual_budget_demands_text += "; binding mid-year deficit review";
Q.news_headline = "The party accepts a deficit review before the coalition whip";
!}
go-to: internal_ratification

@internal_lock
title: Authorise the coalition whip
subtitle: Freeze the internal text and count the parties that must carry it.
on-arrival: annual_budget_internal_locked = 1; news_headline = "Lewica authorises a real coalition whip on the budget"
go-to: coalition_whip

@coalition_whip
title: The coalition whip has names and numbers
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const whipNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const whipClamp = function(value, low, high) {
    return Math.max(low, Math.min(high, whipNum(value, low)));
};
const sejmTotal = Math.max(1, Math.round(whipNum(Q.sejm_total, 460)));
let governmentSeats = Math.round(whipNum(Q.coalition_seats, 0));
if (governmentSeats <= 0) {
    governmentSeats = Math.round(whipNum(Q.government_support_seats, 0));
}
if (governmentSeats <= 0) {
    governmentSeats = Math.round(whipNum(Q.annual_budget_government_seats, 0));
}
governmentSeats = Math.max(0, Math.min(sejmTotal, governmentSeats));

const leftCabinetSeats = Math.max(
    0,
    Math.min(
        governmentSeats,
        Math.round(
            whipNum(
                Q.ministry_left_cabinet_seats,
                whipNum(Q.left_seats, 0)
            )
        )
    )
);
const leftBacking = whipClamp(Q.annual_budget_internal_backing, 0, 100);
let leftRebels = Math.round(
    leftCabinetSeats * Math.max(0, 55 - leftBacking) / 100
) + Math.max(0, Math.round(whipNum(Q.annual_budget_internal_vetoes, 0)));
leftRebels = Math.min(leftCabinetSeats, leftRebels);

const partySeats = function(id) {
    return Math.max(0, Math.round(whipNum(Q[id + "_seats"], 0)));
};
const inCabinet = function(id) {
    return Q.government_party == id || Boolean(Q["ministry_" + id + "_in_cabinet"]);
};
const partyRelation = function(id) {
    return whipNum(Q[id + "_relation"], 35);
};
const partyDissent = function(id) {
    return whipNum(Q[id + "_coalition_dissent"], 20);
};
const social = whipNum(Q.annual_budget_social_share, 17);
const defence = whipNum(Q.annual_budget_defence_share, 4.6);
const deficit = whipNum(Q.annual_budget_deficit_share, 4.5);

/* A partner forgives a frame it dislikes more readily than one that breaks a
 * floor it signed. Each breach is charged to the party that owns the claim. */
const socialFloor = whipNum(Q.annual_budget_social_floor, 0);
const defenceFloor = whipNum(Q.annual_budget_defence_floor, 4.0);
const deficitCeiling = whipNum(Q.annual_budget_deficit_ceiling, 5.6);
const socialFloorBreach = Math.max(0, socialFloor - social);
const defenceFloorBreach = Math.max(0, defenceFloor - defence);
const deficitCeilingBreach = Math.max(0, deficit - deficitCeiling);

const satisfaction = function(id) {
    let score = 52 + (partyRelation(id) - 40) * 0.28 -
        Math.max(0, partyDissent(id) - 20) * 0.30;
    score -= defenceFloorBreach * (id == "pis" ? 22 : 12);
    score -= deficitCeilingBreach * (id == "ko" || id == "p2050" ? 16 : 9);
    score -= socialFloorBreach * (id == "psl" ? 8 : 5);
    if (id == "ko") {
        score += Math.max(-12, (4.8 - deficit) * 9);
        score += Q.annual_budget_green_investment ? 5 : 0;
        score += Q.annual_budget_delivery_register ? 4 : 0;
        score += Q.annual_budget_deficit_rule ? 5 : 0;
        score += Q.annual_budget_market_cuts ? 4 : 0;
        score -= Q.annual_budget_family_defence_deal ? 8 : 0;
        score -= social > 20.5 ? (social - 20.5) * 6 : 0;
    } else if (id == "psl") {
        score += Q.annual_budget_local_compact ? 16 : 0;
        score += defence >= 4.8 ? 6 : -3;
        score += deficit <= 5.2 ? 5 : -(deficit - 5.2) * 8;
        score += Q.annual_budget_reconstruction_fund ? 5 : 0;
        score -= Q.annual_budget_progressive_revenue ? 3 : 0;
    } else if (id == "p2050") {
        score += Q.annual_budget_green_investment ? 12 : 0;
        score += Q.annual_budget_kpo_cofinance ? 7 : 0;
        score += Q.annual_budget_delivery_register ? 6 : 0;
        score += deficit <= 4.8 ? 6 : -(deficit - 4.8) * 9;
        score -= Q.annual_budget_family_defence_deal ? 8 : 0;
    } else if (id == "pis") {
        score += social >= 18.0 ? 7 : -6;
        score += defence >= 4.8 ? 8 : -5;
        score += Q.annual_budget_family_defence_deal ? 16 : 0;
        score -= Q.annual_budget_progressive_revenue ? 9 : 0;
        score -= Q.annual_budget_green_investment ? 2 : 0;
    } else if (id == "konf") {
        score += Q.annual_budget_market_cuts ? 16 : -5;
        score += deficit <= 4.0 ? 8 : -(deficit - 4.0) * 10;
        score -= Q.annual_budget_progressive_revenue ? 15 : 0;
        score -= social > 18.5 ? (social - 18.5) * 8 : 0;
        score += Q.annual_budget_deficit_rule ? 5 : 0;
    }
    return whipClamp(score, 0, 100);
};

let partnerDefectors = 0;
let partnerReport = [];
for (const id of ["ko", "psl", "p2050", "pis", "konf"]) {
    if (!inCabinet(id)) continue;
    const seats = partySeats(id);
    if (seats <= 0) continue;
    const fit = satisfaction(id);
    Q["annual_budget_" + id + "_cabinet_support"] = Math.round(fit);
    const defectionRate = Math.min(0.28, Math.max(0, 50 - fit) / 115);
    const defectors = Math.min(seats, Math.round(seats * defectionRate));
    partnerDefectors += defectors;
    partnerReport.push(
        id.toUpperCase() + " " + Math.round(fit) + "% (" + defectors + " at risk)"
    );
}
const genericStress =
    whipNum(Q.government_coalition_dissent, 0) +
    (Q.third_way_split ? 6 : 0) +
    (Q.p2050_split ? 5 : 0) +
    (Q.coalition_break_threat ? 8 : 0);
const genericDefectors = Math.max(0, Math.round((genericStress - 38) / 9));
partnerDefectors = Math.min(
    Math.max(0, governmentSeats - leftCabinetSeats),
    partnerDefectors + genericDefectors
);

const malcontents = Math.min(
    governmentSeats,
    leftRebels + partnerDefectors
);
let externalVotes = Math.max(
    0,
    Math.round(whipNum(Q.annual_budget_external_votes_committed, 0))
);
const externalTarget = String(Q.annual_budget_external_deal_target || "None");
if (externalTarget == "razem" && (social < 18.5 || !Q.annual_budget_public_wage_guarantee)) {
    externalVotes = 0;
}
if (externalTarget == "psl" && !Q.annual_budget_local_compact) {
    externalVotes = 0;
}
if ((externalTarget == "ko" || externalTarget == "p2050") &&
    !Q.annual_budget_delivery_register && !Q.annual_budget_green_investment) {
    externalVotes = 0;
}
if (externalTarget == "pis" && !Q.annual_budget_family_defence_deal) {
    externalVotes = 0;
}
if (externalTarget == "konf" && !Q.annual_budget_market_cuts) {
    externalVotes = 0;
}
Q.annual_budget_external_votes_live = externalVotes;

/* Rebellion is priced by pivotality, on our own benches as much as anyone
 * else's.  A comfortable majority makes a protest vote free, so every
 * malcontent takes it; a bill that could actually fall brings all but the
 * red-line rebels home.  A large majority therefore does not buy a quiet
 * budget, it buys a noisy one that still passes. */
const oppositionNo = Math.max(0, sejmTotal - governmentSeats - externalVotes);
const budgetModel = (typeof window !== "undefined"
    ? window : globalThis).polandBudgetModel;
const whipBonus = Math.max(
    0,
    Math.round(whipNum(Q.annual_budget_whip_bonus, 0))
);
const forecastOptions = {
    sejmTotal: sejmTotal,
    quorum: Q.sejm_quorum_floor,
    governmentSeats: governmentSeats,
    malcontents: malcontents,
    externalYes: externalVotes,
    externalNo: oppositionNo,
    whipBonus: whipBonus,
    partyUnity: Q.party_unity
};
const forecast = budgetModel.forecast(forecastOptions);
const expected = forecast.centre;
const loyalMargin = expected.loyalMargin;
Q.annual_budget_malcontents = malcontents;
Q.annual_budget_rebel_pressure = loyalMargin >= 30
    ? "Comfortable — a protest vote costs a coalition backbencher nothing"
    : (loyalMargin >= 10
        ? "Tight — a rebel has to weigh the consequences of a defeat"
        : "Knife-edge — a rebel would be voting down their own government");
Q.annual_budget_predicted_left_rebels = leftRebels;
Q.annual_budget_predicted_partner_defectors = partnerDefectors;
Q.annual_budget_partner_report = partnerReport.length
    ? partnerReport.join(" · ") : "No non-Left cabinet party recorded";
Q.annual_budget_predicted_defectors = expected.defectors;
Q.annual_budget_predicted_yes = expected.yes;
Q.annual_budget_predicted_no = expected.no;
Q.annual_budget_predicted_abstain = expected.abstain;
Q.annual_budget_predicted_threshold = expected.threshold;
Q.annual_budget_forecast_defectors_low = forecast.defectors.low;
Q.annual_budget_forecast_defectors_high = forecast.defectors.high;
Q.annual_budget_forecast_yes_low = forecast.yes.low;
Q.annual_budget_forecast_yes_high = forecast.yes.high;
Q.annual_budget_forecast_no_low = forecast.no.low;
Q.annual_budget_forecast_no_high = forecast.no.high;
Q.annual_budget_forecast_abstain_low = forecast.abstain.low;
Q.annual_budget_forecast_abstain_high = forecast.abstain.high;
Q.annual_budget_forecast_threshold_low = forecast.no.low + 1;
Q.annual_budget_forecast_threshold_high = forecast.no.high + 1;
Q.annual_budget_forecast_width = forecast.width;
Q.annual_budget_forecast_government_seats = governmentSeats;
Q.annual_budget_forecast_external_yes = externalVotes;
Q.annual_budget_forecast_external_no = oppositionNo;
Q.annual_budget_forecast_yes_range = forecast.yes.low == forecast.yes.high
    ? String(forecast.yes.low)
    : forecast.yes.low + "–" + forecast.yes.high;
Q.annual_budget_forecast_no_range = forecast.no.low == forecast.no.high
    ? String(forecast.no.low)
    : forecast.no.low + "–" + forecast.no.high;
Q.annual_budget_forecast_abstain_range =
    forecast.abstain.low == forecast.abstain.high
        ? String(forecast.abstain.low)
        : forecast.abstain.low + "–" + forecast.abstain.high;
Q.annual_budget_forecast_threshold_range =
    Q.annual_budget_forecast_threshold_low ==
        Q.annual_budget_forecast_threshold_high
        ? String(Q.annual_budget_forecast_threshold_low)
        : Q.annual_budget_forecast_threshold_low + "–" +
            Q.annual_budget_forecast_threshold_high;
Q.annual_budget_forecast_defectors_range =
    forecast.defectors.low == forecast.defectors.high
        ? String(forecast.defectors.low)
        : forecast.defectors.low + "–" + forecast.defectors.high;
Q.annual_budget_predicted_passed =
    forecast.yes.low > forecast.no.high ? 1 : 0;
Q.annual_budget_predicted_shortfall = Q.annual_budget_predicted_passed
    ? 0
    : Math.max(
        0,
        forecast.no.high + 1 - forecast.yes.low
    );
Q.annual_budget_forecast_status = Q.annual_budget_predicted_passed
    ? "The whole published range clears an ordinary majority."
    : (forecast.yes.high > forecast.no.low
        ? "The range crosses the line: the whip cannot call the result."
        : "Even the top of the range is short of an ordinary majority.");
!}

= The first honest whip range

