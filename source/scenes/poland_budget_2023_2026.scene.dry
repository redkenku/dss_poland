unavailable-subtitle: The opposition lacks the staff for line-by-line negotiation.
on-arrival: resources -= 1; annual_budget_strategy = "Conditional abstention"; annual_budget_internal_backing = 56; government_delivery += 2; household_security += 2; court_backlog -= 2; ko_relation += 4; pis_relation += 2; razem_dissent += 4; public_trust += 1; news_headline = "Targeted amendments buy a Left abstention"
go-to: opposition_result

@opposition_favour
title: Support the budget to open a channel with the government
subtitle: A costly favour whose return is uncertain.
view-if: left_in_government = 0
on-arrival: annual_budget_strategy = "Confidence favour"; annual_budget_internal_backing = 42; party_unity -= 5; public_trust -= 2; barons_dissent -= 3; razem_dissent += 9; government_delivery += 4; ko_relation += 6; pis_relation += 6; news_headline = "The Left lends votes without entering the cabinet"
