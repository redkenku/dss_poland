@senate_budget_override
title: Ask the Sejm to reject the Senate amendment package
subtitle: Uses an absolute majority of votes cast with quorum; amendment-friendly governing MPs may abstain.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_senate_corrections_pending = 1
on-arrival: {!
const present = Math.max(
    Math.round(Number(Q.annual_budget_present) || 0),
    Math.max(1, Number(Q.sejm_quorum_floor) || 230)
);
let attraction =
    2 + Math.max(1, Number(Q.annual_budget_senate_correction_strength) || 1) * 2;
if (
    Q.annual_budget_senate_correction_flag == "local" &&
    (Q.ministry_psl_in_cabinet || Q.government_party == "psl")
) attraction += Math.max(1, Math.round((Number(Q.psl_seats) || 0) * 0.08));
if (
    Q.annual_budget_senate_correction_flag == "wages" &&
    Number(Q.annual_budget_internal_backing) < 60
) attraction += 2;
if (
    Q.annual_budget_senate_correction_flag == "green_register" &&
    (Q.ministry_p2050_in_cabinet || Q.government_party == "p2050")
) attraction += 2;
const liveOutsideVotes = Math.max(
    0,
    Math.round(Number(Q.annual_budget_external_votes_live) || 0)
);
let outsideOverrideVotes = liveOutsideVotes;
const outsideTarget = String(Q.annual_budget_external_deal_target || "None");
if (outsideTarget == "psl" && Q.annual_budget_senate_correction_flag == "local") {
    outsideOverrideVotes = 0;
}
if (outsideTarget == "razem" && Q.annual_budget_senate_correction_flag == "wages") {
    outsideOverrideVotes = 0;
}
if ((outsideTarget == "ko" || outsideTarget == "p2050") &&
    Q.annual_budget_senate_correction_flag == "green_register") {
    outsideOverrideVotes = 0;
}
if (outsideTarget == "pis" && Q.annual_budget_senate_correction_flag == "family_defence") {
    outsideOverrideVotes = 0;
}
if (outsideTarget == "konf" && Q.annual_budget_senate_correction_flag == "market") {
    outsideOverrideVotes = 0;
}
const cabinetCoreYes = Math.max(
    0,
    Math.round(Number(Q.annual_budget_yes) || 0) - liveOutsideVotes
);
Q.annual_budget_senate_override_yes = Math.max(
    0,
    cabinetCoreYes + outsideOverrideVotes - attraction
);
Q.annual_budget_senate_override_abstain = Math.max(
    0,
    Math.round(Number(Q.annual_budget_abstain) || 0) + attraction
);
Q.annual_budget_senate_override_no = Math.max(
    0,
    present - Q.annual_budget_senate_override_yes -
        Q.annual_budget_senate_override_abstain
);
Q.annual_budget_senate_override_threshold = Math.floor(present / 2) + 1;
Q.annual_budget_senate_override_passed =
    Q.annual_budget_senate_override_yes >=
        Q.annual_budget_senate_override_threshold ? 1 : 0;
!}
go-to: senate_budget_override_result

@senate_budget_override_result
title: The Sejm answers the Senate
new-page: true
view-if: annual_budget_senate_corrections_pending = 1 and annual_budget_left_cabinet_authority = 1
on-arrival: {!
Q.annual_budget_senate_stage_done = 1;
if (Q.annual_budget_senate_override_passed) {
    Q.annual_budget_senate_corrections_accepted = 0;
    Q.annual_budget_senate_result =
        "Sejm rejected the Senate amendments by absolute majority";
    Q.annual_budget_result += " — Senate amendments rejected";
    Q.government_coalition_dissent += 3;
    Q.news_headline = "The coalition finds an absolute majority against the Senate package";
} else {
    Q.annual_budget_senate_corrections_accepted = 1;
    Q.annual_budget_social_share = Math.round(
        (Number(Q.annual_budget_social_share) +
            Number(Q.annual_budget_senate_delta_social)) * 10
    ) / 10;
    Q.annual_budget_defence_share = Math.round(
        (Number(Q.annual_budget_defence_share) +
            Number(Q.annual_budget_senate_delta_defence)) * 10
    ) / 10;
    Q.annual_budget_deficit_share = Math.round(
        (Number(Q.annual_budget_deficit_share) +
            Number(Q.annual_budget_senate_delta_deficit)) * 10
    ) / 10;
    if (Q.annual_budget_senate_correction_flag == "wages") {
        Q.annual_budget_public_wage_guarantee = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "local") {
        Q.annual_budget_local_compact = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "green_register") {
        Q.annual_budget_green_investment = 1;
        Q.annual_budget_delivery_register = 1;
        Q.annual_budget_deficit_rule = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "family_defence") {
        Q.annual_budget_family_defence_deal = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "market") {
        Q.annual_budget_market_cuts = 1;
        Q.annual_budget_deficit_rule = 1;
    }
    Q.annual_budget_senate_result =
        "Failed Sejm rejection left the Senate amendments in force";
    Q.annual_budget_result += " — Senate amendments entered after failed rejection";
    Q.government_coalition_dissent += 7;
    Q.public_trust -= 1;
    Q.news_headline = "A failed absolute-majority whip leaves the Senate package in the budget";
}
!}

**Yes [+ annual_budget_senate_override_yes +] · No [+
annual_budget_senate_override_no +] · Abstain [+
annual_budget_senate_override_abstain +] · Absolute majority [+
annual_budget_senate_override_threshold +]**

[? if annual_budget_senate_override_passed: The Senate package is removed.?]
[? if not annual_budget_senate_override_passed: The amendments are deemed
accepted and the final fiscal frame changes accordingly.?]

- @budget_enact: Present the final text for signature

@senate_budget_opposition_resolution
title: The cabinet chooses whether to fight the Senate
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_senate_corrections_pending = 1
on-arrival: {!
const present = Math.max(
    Math.round(Number(Q.annual_budget_present) || 0),
    Math.max(1, Number(Q.sejm_quorum_floor) || 230)
);
const threshold = Math.floor(present / 2) + 1;
const attraction =
    2 + Math.max(1, Number(Q.annual_budget_senate_correction_strength) || 1) * 2;
const governmentCoreYes = Math.max(
    0,
    Math.round(Number(Q.annual_budget_government_yes) || 0)
);
let lewicaOverrideVotes = 0;
if (
    Q.annual_budget_senate_correction_flag == "market" ||
    Q.annual_budget_senate_correction_flag == "family_defence"
) {
    lewicaOverrideVotes = Math.max(
        0,
        Math.round(Number(Q.annual_budget_left_yes) || 0)
    );
}
const possibleOverrideYes = Math.max(
    0,
    governmentCoreYes + lewicaOverrideVotes - attraction
);
Q.annual_budget_senate_stage_done = 1;
Q.annual_budget_senate_override_threshold = threshold;
Q.annual_budget_senate_override_yes = possibleOverrideYes;
if (possibleOverrideYes >= threshold + 1) {
    Q.annual_budget_senate_override_passed = 1;
    Q.annual_budget_senate_corrections_accepted = 0;
    Q.annual_budget_senate_result =
        "The government rejected the Senate amendments without Lewica controlling the decision";
    Q.news_headline = "The cabinet uses its Sejm majority to reject the Senate package";
} else {
    Q.annual_budget_senate_override_passed = 0;
    Q.annual_budget_senate_corrections_accepted = 1;
    Q.annual_budget_social_share = Math.round(
        (Number(Q.annual_budget_social_share) +
            Number(Q.annual_budget_senate_delta_social)) * 10
    ) / 10;
    Q.annual_budget_defence_share = Math.round(
        (Number(Q.annual_budget_defence_share) +
            Number(Q.annual_budget_senate_delta_defence)) * 10
    ) / 10;
    Q.annual_budget_deficit_share = Math.round(
        (Number(Q.annual_budget_deficit_share) +
            Number(Q.annual_budget_senate_delta_deficit)) * 10
    ) / 10;
    if (Q.annual_budget_senate_correction_flag == "wages") {
        Q.annual_budget_public_wage_guarantee = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "local") {
        Q.annual_budget_local_compact = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "green_register") {
        Q.annual_budget_green_investment = 1;
        Q.annual_budget_delivery_register = 1;
        Q.annual_budget_deficit_rule = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "family_defence") {
        Q.annual_budget_family_defence_deal = 1;
    }
    if (Q.annual_budget_senate_correction_flag == "market") {
        Q.annual_budget_market_cuts = 1;
        Q.annual_budget_deficit_rule = 1;
    }
    Q.annual_budget_senate_result =
        "The government lacked an absolute majority and incorporated the Senate amendments";
    Q.news_headline = "The cabinet incorporates a Senate package it cannot reject";
}
!}

Lewica did not choose for the cabinet. The government's recorded Sejm votes
were either sufficient for an absolute-majority rejection or they were not.

- @budget_enact: Present the final text for signature

@senate_budget_unchanged
title: Record the unchanged Senate return
view-if: annual_budget_senate_corrections_pending = 0
on-arrival: {! 
Q.annual_budget_senate_stage_done = 1;
Q.annual_budget_senate_result = "Senate returned the budget unchanged";
Q.annual_budget_result += " — Senate returned it unchanged";
Q.news_headline = "The Senate returns the annual budget without amendments";
!}
go-to: budget_enact

@budget_enact
title: The final budget becomes law
new-page: true
view-if: annual_budget_passed = 1 and annual_budget_senate_stage_done = 1
on-arrival: {!
if (!Q.annual_budget_effects_applied) {
    const finalNum = function(value, fallback) {
        return Number.isFinite(Number(value)) ? Number(value) : fallback;
    };
    const social = finalNum(Q.annual_budget_social_share, 17);
    const defence = finalNum(Q.annual_budget_defence_share, 4.6);
    const deficit = finalNum(Q.annual_budget_deficit_share, 4.5);
    const previousSocial = finalNum(Q.annual_budget_previous_social_share, 17);
    const previousDefence = finalNum(Q.annual_budget_previous_defence_share, 4.6);
    const socialChange = social - previousSocial;
    const defenceChange = defence - previousDefence;

    /* What the envelope said was owed, measured against what was enacted.
     * A breach is not a rounding error: somebody named was promised this
     * money and is not getting it. */
    const socialFloor = finalNum(
        Q.annual_budget_social_floor,
        previousSocial
    );
    const defenceFloor = finalNum(Q.annual_budget_defence_floor, 4.0);
    const deficitCeiling = finalNum(Q.annual_budget_deficit_ceiling, 5.6);
    const socialBreach = Math.max(0, socialFloor - social);
    const defenceBreach = Math.max(0, defenceFloor - defence);
    const deficitBreach = Math.max(0, deficit - deficitCeiling);
    Q.annual_budget_social_breach = Math.round(socialBreach * 10) / 10;
    Q.annual_budget_defence_breach = Math.round(defenceBreach * 10) / 10;
    Q.annual_budget_deficit_breach = Math.round(deficitBreach * 10) / 10;

    const householdChange =
        Math.round(socialChange * 4) +
        (Q.annual_budget_public_wage_guarantee ? 2 : 0) -
        (Q.annual_budget_market_cuts ? 2 : 0) -
        Math.round(socialBreach * 5);
    const militaryChange =
        Math.round(defenceChange * 3.2) +
        (Q.annual_budget_family_defence_deal ? 1 : 0) -
        Math.round(defenceBreach * 6);
    let fiscalChange = Math.round(
        (deficit - 4.2) * 2.2 +
        deficitBreach * 6 +
        finalNum(Q.annual_budget_cost_pressure, 0) / 18
    );
    if (Q.annual_budget_progressive_revenue) fiscalChange -= 1;
    if (Q.annual_budget_kpo_cofinance) fiscalChange -= 1;
    let growthImpulse =
        socialChange * 0.10 +
        defenceChange * 0.04 +
        (Q.annual_budget_local_compact ? 0.10 : 0) +
        (Q.annual_budget_green_investment ? 0.10 : 0) +
        (Q.annual_budget_reconstruction_fund ? 0.08 : 0) -
        (Q.annual_budget_market_cuts ? 0.05 : 0) -
        Math.max(0, deficit - 5.5) * 0.06;
    growthImpulse = Math.round(growthImpulse * 10) / 10;

    Q.household_security += householdChange;
    Q.military_trust += militaryChange;
    Q.fiscal_stress = Math.max(
        0,
        finalNum(Q.fiscal_stress, 0) + fiscalChange
    );
    Q.public_debt = Math.max(
        0,
        finalNum(Q.public_debt, 0) + Math.round((deficit - 3.5) * 7) / 10
    );
    Q.economic_growth += growthImpulse;
    Q.budget_balance = Math.round(-deficit * 10) / 10;
    Q.government_delivery +=
        2 +
        (Q.annual_budget_local_compact ? 1 : 0) +
        (Q.annual_budget_green_investment ? 1 : 0) +
        (Q.annual_budget_public_wage_guarantee ? 1 : 0);
    if (Q.annual_budget_public_wage_guarantee) {
        Q.public_sector_support += 3;
        Q.labor_credibility += 2;
        Q.union_trust += 3;
        Q.opzz_cooperation += 2;
        Q.labor_mobilization += 2;
        Q.labor_dissent -= 3;
    }
    if (Q.annual_budget_market_cuts) {
        Q.union_trust -= 4;
        Q.opzz_cooperation -= 3;
        Q.labor_dissent += 4;
    }
    if (Q.annual_budget_green_investment) {
        Q.local_network += 1;
        Q.progressive_credibility += 1;
    }
    if (Q.annual_budget_local_compact) {
        Q.local_network += 2;
        Q.rural_support += 1;
    }
    if (Q.annual_budget_delivery_register) Q.public_trust += 1;
    if (Q.annual_budget_right_deal) Q.public_trust -= 1;
    if (Q.annual_budget_margin >= 12) Q.public_trust += 1;

    /* Every breached floor has a constituency that was promised the money
     * and can read the enacted table. */
    const breachVictims = [];
    if (socialBreach > 0) {
        Q.union_trust -= Math.round(socialBreach * 8);
        Q.opzz_cooperation -= Math.round(socialBreach * 6);
        Q.labor_dissent += Math.round(socialBreach * 9);
        Q.razem_dissent += Math.round(socialBreach * 9);
        Q.labor_credibility -= Math.round(socialBreach * 5);
        Q.public_trust -= 1;
        breachVictims.push(
            "the indexed benefits and staffing schedules (" +
            Q.annual_budget_social_breach + " points short)"
        );
    }
    if (defenceBreach > 0) {
        Q.military_trust -= Math.round(defenceBreach * 4);
        Q.defence_readiness -= Math.round(defenceBreach * 6);
        Q.pis_relation -= Math.round(defenceBreach * 6);
        breachVictims.push(
            "signed procurement and the alliance floor (" +
            Q.annual_budget_defence_breach + " points short)"
        );
    }
    if (deficitBreach > 0) {
        Q.public_debt = finalNum(Q.public_debt, 0) + deficitBreach;
        Q.ko_relation -= Math.round(deficitBreach * 5);
        Q.p2050_relation -= Math.round(deficitBreach * 5);
        Q.public_trust -= 1;
        breachVictims.push(
            "the deficit ceiling (" + Q.annual_budget_deficit_breach +
            " points over)"
        );
    }
    Q.annual_budget_breach_report = breachVictims.length
        ? "Broken this year: " + breachVictims.join("; ") + "."
        : "The budget met every claim the year had already made on it.";

    /* A wage guarantee is a recurring commitment, so it becomes next year's
     * floor rather than a one-year gesture. */
    Q.annual_budget_wage_guarantee_owed =
        Q.annual_budget_public_wage_guarantee ? 1 : 0;

    /* A budget carried over your own deputies' recorded objections is still
     * carried, but the roll call is published and the names are remembered. */
    const recordedRebels = Math.max(
        0,
        Math.round(finalNum(Q.annual_budget_recorded_defectors, 0))
    );
    if (recordedRebels > 0) {
        Q.government_coalition_dissent = Math.min(
            100,
            finalNum(Q.government_coalition_dissent, 0) +
                Math.min(8, Math.ceil(recordedRebels / 3))
        );
        if (Q.annual_budget_left_cabinet_authority) {
            Q.party_unity -= Math.min(5, Math.ceil(recordedRebels / 6));
            if (recordedRebels >= 12) Q.public_trust -= 1;
        }
    }

    if (Q.annual_budget_left_cabinet_authority) {
        const budgetModel = (typeof window !== "undefined"
            ? window : globalThis).polandBudgetModel;
        const activeFactions = budgetModel.activeFactions(Q);
        const targets = budgetModel.factions;
        let finalAngry = [];
        for (const faction of activeFactions) {
            const target = targets[faction] || targets.barons;
            const support = budgetModel.factionBacking(Q, faction);
            Q["annual_budget_" + faction + "_final_backing"] = support;
            const strength = Math.max(0, finalNum(Q[faction + "_strength"], 0));
            if (strength >= 2) {
                if (support < 30) {
                    Q[faction + "_dissent"] =
                        finalNum(Q[faction + "_dissent"], 0) + 6;
                    finalAngry.push(target.label);
                } else if (support < 45) {
                    Q[faction + "_dissent"] =
                        finalNum(Q[faction + "_dissent"], 0) + 3;
                    finalAngry.push(target.label);
                } else if (support >= 75) {
                    Q[faction + "_dissent"] = Math.max(
                        0,
                        finalNum(Q[faction + "_dissent"], 0) - 2
                    );
                }
            }
            if (faction == "labor") {
                if (support < 30) {
                    Q.union_trust -= 5;
                    Q.opzz_cooperation -= 4;
                    Q.labor_mobilization += 3;
                } else if (support >= 75) {
                    Q.union_trust += 3;
                    Q.opzz_cooperation += 2;
                }
            }
        }
        Q.annual_budget_final_angry_factions = finalAngry.length
            ? finalAngry.join(", ") : "None";

        if (
            finalNum(Q.annual_budget_razem_final_backing, 100) < 30 &&
            (Q.razem_in_government || Q.razem_budget_support_pact) &&
            !Q.razem_breakaway_protected &&
            !Q.razem_red_line_broken
        ) {
            const razemSeats = Math.max(0, Math.round(finalNum(Q.razem_seats, 0)));
            const wasInGovernment = Boolean(Q.razem_in_government);
            Q.razem_red_line_broken = 1;
            Q.razem_in_government = 0;
            Q.razem_budget_support_pact = 0;
            Q.razem_government_role = "Opposition after the final budget breached its red line";
            Q.razem_dissent += 12;
            Q.razem_cooperation -= 15;
            Q.party_unity -= 4;
            if (wasInGovernment) {
                Q.coalition_seats = Math.max(
                    0,
                    finalNum(Q.coalition_seats, 0) - razemSeats
                );
                Q.ministry_left_cabinet_seats = Math.max(
                    0,
                    finalNum(Q.ministry_left_cabinet_seats, 0) - razemSeats
                );
            }
            if (finalNum(Q.coalition_seats, 0) < finalNum(Q.sejm_statutory_majority, 231)) {
                Q.coalition_break_threat = 1;
            }
        }
    } else {
        const posture = String(Q.annual_budget_posture || "");
        if (
            posture.includes("without a written concession") ||
            posture.includes("Unconditional")
        ) {
            if (social < 18.0 || Q.annual_budget_market_cuts) {
                Q.labor_dissent += 5;
                Q.razem_dissent += 6;
                Q.party_unity -= 2;
                Q.labor_credibility -= 2;
            }
        } else if (Number(Q.annual_budget_concession_strength) >= 2) {
            Q.labor_dissent = Math.max(0, finalNum(Q.labor_dissent, 0) - 2);
            Q.razem_dissent = Math.max(0, finalNum(Q.razem_dissent, 0) - 2);
            Q.progressives_dissent = Math.max(0, finalNum(Q.progressives_dissent, 0) - 1);
            Q.labor_credibility += 2;
        } else if (posture.includes("Abstain") && social < 18.0) {
            Q.razem_dissent += 2;
        }
    }

    Q.annual_budget_enacted_fiscal_year = Q.annual_budget_fiscal_year;
    Q.annual_budget_enacted_social_share = Math.round(social * 10) / 10;
    Q.annual_budget_enacted_defence_share = Math.round(defence * 10) / 10;
    Q.annual_budget_enacted_deficit_share = Math.round(deficit * 10) / 10;
    Q.annual_budget_finalised = 1;
    Q.annual_budget_effects_applied = 1;
    Q.budget_deadline_active = 0;
    Q.next_budget_label = "December " + (Number(Q.annual_budget_year) + 1);
    Q.annual_budget_result +=
        " — final frame social " + social + "% / defence " + defence +
        "% / deficit " + deficit + "%";
    Q.news_headline = "The final annual budget is signed after the complete parliamentary procedure";
}
!}

= The enacted fiscal frame

<div class="ledger-section ledger-section-first"><div class="ledger-title">Final budget</div>
<div class="ledger-row"><span>Social and public services</span><b>[+ annual_budget_enacted_social_share +]%</b></div>
<div class="ledger-row"><span>Defence</span><b>[+ annual_budget_enacted_defence_share +]%</b></div>
<div class="ledger-row"><span>Deficit</span><b>[+ annual_budget_enacted_deficit_share +]%</b></div>
<div class="ledger-row"><span>Senate result</span><b>[+ annual_budget_senate_result +]</b></div>
<div class="ledger-subrow">Against the envelope: social floor [+ annual_budget_social_floor +]% · defence floor [+ annual_budget_defence_floor +]% · deficit ceiling [+ annual_budget_deficit_ceiling +]%.</div>
<div class="ledger-subrow">[+ annual_budget_breach_report +]</div></div>

The final numbers—not an obsolete package code—now determine household
security, military confidence, debt, fiscal stress and growth. They also become
the inherited starting frame for next year's budget.

[? if annual_budget_left_cabinet_authority: Final internal opponents: **[+
annual_budget_final_angry_factions +]**. Factions outside that list were not
punished merely for participating in an annual vote.?]
[? if not annual_budget_left_cabinet_authority and annual_budget_negotiation_success:
Lewica's written concession is enacted but still requires next year's delivery
audit.?]

- @return_queue: Return to the remaining events

@confidence_article160
title: Ask the Sejm for confidence under Article 160
subtitle: A separate simple-majority vote; surviving it does not enact the defeated budget.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: budget_confidence_triggered = 1; news_headline = "The prime minister separates cabinet confidence from the defeated budget"
go-to: confidence_roll

@confidence_resign
title: Resign and open a new government-formation sequence
subtitle: Creates a caretaker cabinet and constitutional formation attempts, not an automatic election.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
Q.government_has_confidence = 0;
Q.caretaker_government = 1;
Q.left_in_government = 0;
Q.formation_in_progress = 1;
Q.budget = 0;
Q.budget_authority = "Caretaker — no new governing-spend actions";
Q.position = "Caretaker cabinet and formation talks";
Q.coalition_status = "Cabinet resigned after budget defeat";
Q.coalition_seats = 0;
Q.annual_budget_result = "Budget failed — cabinet resigned into formation talks";
Q.early_election_risk = Math.max(65, Number(Q.early_election_risk) || 0);
Q.news_headline = "The prime minister resigns; the Sejm must attempt another cabinet";
!}

The Palace and Sejm now begin government formation. The budget deadline still
runs, but no election has yet been requested or called.

- @formation_after_budget_loss: Begin the first formation attempt

@confidence_snap
title: Move a real two-thirds self-dissolution resolution
subtitle: The motion requires 307 votes in a 460-seat Sejm, including support beyond the governing coalition.
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const snapNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const total = Math.max(1, Math.round(snapNum(Q.sejm_total, 460)));
const threshold = Math.ceil(total * 2 / 3);
let governmentSeats = Math.round(snapNum(Q.coalition_seats, 0));
if (governmentSeats <= 0) governmentSeats = Math.round(snapNum(Q.government_support_seats, 0));
governmentSeats = Math.max(0, Math.min(total, governmentSeats));
const governmentStress =
    snapNum(Q.government_coalition_dissent, 0) +
    (Q.coalition_break_threat ? 10 : 0);
const governmentDefectors = Math.min(
    governmentSeats,
    Math.max(0, Math.round((governmentStress - 30) / 6))
);
let yes = Math.max(0, governmentSeats - governmentDefectors);
let abstain = Math.ceil(governmentDefectors * 0.60);
let no = Math.max(0, total - yes - abstain);

const outsidePartySupport = function(id, baseRate) {
    const inCabinet =
        Q.government_party == id || Boolean(Q["ministry_" + id + "_in_cabinet"]);
    if (inCabinet) return 0;
    const seats = Math.max(0, Math.round(snapNum(Q[id + "_seats"], 0)));
    const momentum = snapNum(Q[id + "_poll_momentum"], 0);
    const risk = snapNum(Q.early_election_risk, 0);
    const rate = Math.max(
        0.10,
        Math.min(0.90, baseRate + Math.max(0, momentum) * 0.10 + risk / 350)
    );
    return Math.min(seats, Math.round(seats * rate));
};
const oppositionYes =
    outsidePartySupport("pis", Q.government_party == "pis" ? 0.10 : 0.38) +
    outsidePartySupport("ko", Q.government_party == "ko" ? 0.10 : 0.34) +
    outsidePartySupport("psl", Q.government_party == "psl" ? 0.10 : 0.22) +
    outsidePartySupport("p2050", Q.government_party == "p2050" ? 0.10 : 0.24) +
    outsidePartySupport("konf", 0.55);
const movedFromNo = Math.min(no, oppositionYes);
yes += movedFromNo;
no -= movedFromNo;
Q.snap_self_dissolution_yes = yes;
Q.snap_self_dissolution_no = no;
Q.snap_self_dissolution_abstain = Math.max(0, total - yes - no);
Q.snap_self_dissolution_threshold = threshold;
Q.snap_self_dissolution_support = yes;
Q.snap_self_dissolution_passed = yes >= threshold ? 1 : 0;
Q.news_headline = "The Sejm counts an actual self-dissolution resolution";
!}
go-to: snap_dissolution_result

@snap_dissolution_result
title: The chamber votes on its own term
new-page: true
view-if: annual_budget_left_cabinet_authority = 1

**Yes [+ snap_self_dissolution_yes +] · No [+ snap_self_dissolution_no +] ·
Abstain [+ snap_self_dissolution_abstain +] · Required [+
snap_self_dissolution_threshold +]**

[? if snap_self_dissolution_passed: Two thirds of the statutory Sejm vote to
shorten the term. The election route now exists because the resolution passed.?]
[? if not snap_self_dissolution_passed: The resolution fails. A defeated
budget and a failed dissolution motion still do not dismiss the cabinet.?]

- @snap_dissolution_launch
- @snap_dissolution_failed

@snap_dissolution_launch
title: Launch the snap-election campaign
view-if: snap_self_dissolution_passed = 1
on-arrival: {!
Q.snap_election_requested = 0;
Q.snap_election_request_time = Number(Q.time) || 0;
Q.snap_election_request_year = Number(Q.year) || Q.annual_budget_year;
Q.snap_election_request_month = Number(Q.month) || 12;
Q.snap_election_reason = "Budget defeat — successful Sejm self-dissolution";
Q.snap_election_trigger = "Two-thirds self-dissolution resolution";
Q.position = "Snap-election campaign";
Q.coalition_status = "Budget defeated; Sejm votes to shorten its term";
Q.early_election_risk = 100;
Q.annual_budget_result = "Budget failed — Sejm self-dissolution passed";
Q.party_unity -= 4;
Q.public_trust -= 2;
Q.left_poll -= 0.8;
if (Q.government_party == "pis") {
    Q.pis_poll -= 1.5;
} else {
    Q.ko_poll -= 1.0;
    Q.psl_poll -= 0.3;
    Q.p2050_poll -= 0.3;
}
Q.konf_poll += 0.8;
Q.konf_vote_intent += 0.8;
Q.konf_poll_momentum += 0.3;
Q.far_right_agenda += 3;
Q.news_headline = "The two-thirds dissolution vote launches a snap election";
!}
go-to: poland_events_2026.snap_campaign_launch

@snap_dissolution_failed
title: The two-thirds motion fails
view-if: snap_self_dissolution_passed = 0
on-arrival: {! 
Q.early_election_risk += 5;
Q.public_trust -= 1;
Q.annual_budget_result += " — self-dissolution failed";
Q.news_headline = "The coalition fails to assemble 307 votes for self-dissolution";
!}

The cabinet may still test confidence, resign or leave the Article 225 clock
running. The failed motion created no election.

- @confidence_article160
- @confidence_resign
- @confidence_kept_return: Keep the cabinet in office and return to the deadline

@confidence_roll
title: Confidence in the sitting prime minister
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const confNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const total = Math.max(1, Math.round(confNum(Q.sejm_total, 460)));
let governmentSeats = Math.round(confNum(Q.coalition_seats, 0));
if (governmentSeats <= 0) governmentSeats = Math.round(confNum(Q.government_support_seats, 0));
governmentSeats = Math.max(0, Math.min(total, governmentSeats));
const stress =
    confNum(Q.government_coalition_dissent, 0) +
    Math.max(0, 45 - confNum(Q.ko_relation, 45)) * 0.20 +
    Math.max(0, 42 - confNum(Q.psl_relation, 42)) * 0.25 +
    Math.max(0, 42 - confNum(Q.p2050_relation, 42)) * 0.20 +
    (Q.coalition_break_threat ? 8 : 0);
const defectors = Math.min(
    governmentSeats,
    Math.max(0, Math.round((stress - 32) / 6))
);
let externalConfidence = 0;
if (
    !Q.razem_in_government &&
    Q.razem_budget_support_pact &&
    !Q.razem_red_line_broken
) {
    externalConfidence = Math.max(0, Math.round(confNum(Q.razem_seats, 0)));
}
Q.confidence_yes = Math.min(
    total,
    Math.max(0, governmentSeats - defectors + externalConfidence)
);
Q.confidence_abstain = Math.min(
    total - Q.confidence_yes,
    Math.ceil(defectors * 0.55)
);
Q.confidence_no = Math.max(
    0,
    total - Q.confidence_yes - Q.confidence_abstain
);
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.confidence_mode =
    "Article 160 prime-ministerial confidence — simple majority";
Q.confidence_candidate = Q.prime_minister;
Q.government_has_confidence =
    Q.confidence_present >= Math.max(1, confNum(Q.sejm_quorum_floor, 230)) &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
if (Q.government_has_confidence) {
    Q.annual_budget_result =
        "Budget defeated; cabinet retained confidence " +
        Q.confidence_yes + " to " + Q.confidence_no;
    Q.government_coalition_dissent = Math.max(
        0,
        confNum(Q.government_coalition_dissent, 0) - 4
    );
    Q.early_election_risk = Math.max(0, confNum(Q.early_election_risk, 0) - 10);
    Q.budget_deadline_active = 1;
    Q.news_headline = "The cabinet survives confidence but still lacks an enacted budget";
} else {
    Q.coalition_broken = 1;
    Q.caretaker_government = 1;
    Q.left_in_government = 0;
    Q.formation_in_progress = 1;
    Q.budget = 0;
    Q.budget_authority = "Caretaker — no new governing-spend actions";
    Q.position = "Caretaker cabinet and formation talks";
    Q.coalition_status = "Prime minister lost Article 160 confidence";
    Q.coalition_seats = 0;
    Q.early_election_risk = Math.max(75, confNum(Q.early_election_risk, 0));
    Q.annual_budget_result =
        "Budget defeated; cabinet lost confidence " +
        Q.confidence_yes + " to " + Q.confidence_no;
    Q.budget_deadline_active = 1;
    Q.news_headline = "The prime minister loses confidence and opens formation talks";
}
!}

= Confidence roll call

**Yes [+ confidence_yes +] · No [+ confidence_no +] · Abstain [+
confidence_abstain +]**

[? if government_has_confidence: The cabinet survives. The budget remains
defeated and the deadline remains active.?]
[? if not government_has_confidence: The cabinet becomes caretaker and a new
formation sequence begins. No election has been called merely by losing
confidence.?]

- @confidence_kept_return
- @formation_after_budget_loss

@confidence_kept_return
title: Return with the cabinet still in office
view-if: government_has_confidence = 1
on-arrival: budget_deadline_active = 1
go-to: return_queue

@formation_after_budget_loss
title: Begin the first constitutional formation attempt
view-if: government_has_confidence = 0 and caretaker_government = 1
on-arrival: snap_formation_context = "Cabinet loss after annual budget"; snap_formation_attempt = 1; formation_in_progress = 1; news_headline = "The caretaker cabinet enters the first constitutional formation attempt"
go-to: poland_events_2026.snap_formation_attempt_one

@return_queue
go-to: poland_event_queue
