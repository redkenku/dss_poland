Q.annual_budget_strategy = "Technical revision rejected";
Q.annual_budget_posture = "Oppose revised bill";
Q.annual_budget_concession = "Revision rejected by Lewica";
Q.annual_budget_concession_code = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_abstain = 0;
Q.annual_budget_left_no = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
