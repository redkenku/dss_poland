@annual_budget
title: The annual budget council
new-page: true
call: poland_normalize
on-arrival: {!
Q.annual_budget_passed = 0;
Q.annual_budget_fiscal_year =
    (Number(Q.annual_budget_year) || Number(Q.year) || 0) + 1;
Q.annual_budget_internal_backing = 0;
Q.annual_budget_internal_vetoes = 0;
Q.annual_budget_margin = 0;
Q.annual_budget_shortfall = 0;
Q.annual_budget_threshold = 0;
Q.annual_budget_present = 0;
Q.annual_budget_strategy = "Unsettled";
Q.annual_budget_posture = "Unsettled";
Q.annual_budget_concession = "None";
Q.annual_budget_concession_code = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_negotiation_outcome = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_cabinet_response =
    "No amendment has been put to the cabinet";
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.annual_budget_government_yes = 0;
Q.annual_budget_government_abstain = 0;
Q.budget_confidence_triggered = 0;
Q.budget_rescue_bonus = 0;
Q.budget_rescue_attempted = 0;
Q.annual_budget_senate_stage_done = 0;
Q.annual_budget_senate_corrections_pending = 0;
Q.annual_budget_senate_corrections_accepted = 0;
Q.annual_budget_senate_correction_strength = 0;
Q.annual_budget_senate_correction = "No Senate correction pending";
Q.annual_budget_senate_result = "No Senate review yet";
Q.annual_budget_senate_government_votes = 0;
Q.annual_budget_senate_hostile_votes = 0;
Q.annual_budget_senate_override_yes = 0;
Q.annual_budget_senate_override_no = 0;
Q.annual_budget_senate_override_abstain = 0;
Q.annual_budget_senate_override_threshold = 0;
Q.annual_budget_senate_override_passed = 0;
Q.annual_budget_left_cabinet_authority =
    Q.left_in_government &&
    Q.government_has_confidence &&
    !Q.caretaker_government ? 1 : 0;
/*
 * The December scene is the parliamentary decision, not the moment when the
 * Council of Ministers first submitted the draft.  Model the constitutional
 * clock from the normal end-of-September submission, three monthly turns
 * before this vote.
 */
Q.budget_submission_time = Math.max(
    0,
    (Number(Q.time) || 0) - 3
);
Q.budget_submission_year = Number(Q.year) || Q.annual_budget_year;
Q.budget_submission_month = 9;
Q.budget_deadline_time = Q.budget_submission_time + 4;
const budgetDeadlineIndex =
    Q.budget_submission_year * 12 +
    Math.max(0, Q.budget_submission_month - 1) + 4;
Q.budget_deadline_year = Math.floor(budgetDeadlineIndex / 12);
Q.budget_deadline_month = budgetDeadlineIndex % 12 + 1;
const budgetMonthNames = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];
Q.budget_deadline_label =
    budgetMonthNames[Q.budget_deadline_month - 1] +
    " " + Q.budget_deadline_year;
Q.budget_deadline_active = 1;
const previewTotal = Math.max(
    1,
    Math.round(Number(Q.sejm_total) || 460)
);
const previewLeft = Math.max(
    0,
    Math.min(
        previewTotal,
        Math.round(Number(Q.left_seats) || 0)
    )
);
let previewGovernment = Math.round(
    Number(Q.government_support_seats) ||
    Number(Q.coalition_seats) || 0
);
if (previewGovernment <= 0) {
    if (Q.government_party == "pis") {
        previewGovernment = Math.round(Number(Q.pis_seats) || 0);
    } else if (Q.government_party == "ko") {
        previewGovernment =
            Math.round(Number(Q.ko_seats) || 0) +
            Math.round(Number(Q.p2050_seats) || 0) +
            Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "psl") {
        previewGovernment =
            Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "p2050") {
        previewGovernment =
            Math.round(Number(Q.p2050_seats) || 0);
    } else {
        previewGovernment = Math.round(
            Number(Q.government_support_seats) || 0
        );
    }
}
previewGovernment = Math.max(
    0,
    Math.min(previewTotal - previewLeft, previewGovernment)
);
const previewStress =
    (Number(Q.government_coalition_dissent) || 0) +
    (Q.caretaker_government ? 12 : 0) +
    (!Q.government_has_confidence ? 8 : 0);
const previewDefections = Math.min(
    previewGovernment,
    Math.max(0, Math.round((previewStress - 35) / 8))
);
Q.annual_budget_preview_government_yes =
    previewGovernment - previewDefections;
Q.annual_budget_preview_government_abstain = previewDefections;
Q.annual_budget_preview_other_no = Math.max(
    0,
    previewTotal - previewGovernment - previewLeft
);
Q.annual_budget_preview_left_seats = previewLeft;
Q.annual_budget_preview_reject_no =
    Q.annual_budget_preview_other_no + previewLeft;
Q.annual_budget_preview_support_yes =
    Q.annual_budget_preview_government_yes + previewLeft;
const budgetDraftProfiles = {
    pis: {social: 18.6, defence: 4.9, deficit: 5.8},
    ko: {social: 17.4, defence: 4.8, deficit: 4.5},
    psl: {social: 16.8, defence: 5.0, deficit: 4.0},
    p2050: {social: 16.9, defence: 4.6, deficit: 3.9},
    default: {social: 17.2, defence: 4.7, deficit: 4.6}
};
const budgetDraft =
    budgetDraftProfiles[Q.government_party] ||
    budgetDraftProfiles.default;
const roundBudgetShare = function(value) {
    return Math.round(Number(value) * 10) / 10;
};
Q.annual_budget_draft_social_share = roundBudgetShare(budgetDraft.social);
Q.annual_budget_draft_defence_share = roundBudgetShare(budgetDraft.defence);
Q.annual_budget_draft_deficit_share = roundBudgetShare(budgetDraft.deficit);
Q.annual_budget_social_share = Q.annual_budget_draft_social_share;
Q.annual_budget_defence_share = Q.annual_budget_draft_defence_share;
Q.annual_budget_deficit_share = Q.annual_budget_draft_deficit_share;
Q.annual_budget_projected_balance =
    roundBudgetShare(-Q.annual_budget_deficit_share);
Q.annual_budget_finance_control =
    Q.annual_budget_left_cabinet_authority &&
    Q.finance_minister_party == "Lewica" ? 1 : 0;
const annualBudgetPowerBase =
    Math.max(0, Math.round(Number(Q.negotiation_leverage) || 0)) * 0.40 +
    Math.max(0, Math.round(Number(Q.left_seats) || 0)) * 0.22 +
    Math.max(0, Math.round(Number(Q.ko_relation) || 0)) * 0.10 +
    Math.max(0, Math.round(Number(Q.psl_relation) || 0)) * 0.12 +
    (Q.annual_budget_left_is_pivotal ? 10 : 0);
Q.annual_budget_player_power = Math.max(
    0,
    Math.min(100, Math.round(annualBudgetPowerBase / 2.4))
);
Q.annual_budget_bargain_points = 0;
Q.annual_budget_demands_text = "No demands filed";
Q.annual_budget_outrageous_support = 0;
Q.annual_budget_pandemic_social_exception =
    Number(Q.annual_budget_year) == 2020 ? 1 : 0;
!}

= December [+ annual_budget_year +] — fiscal year [+ annual_budget_fiscal_year +]

[? if annual_budget_left_cabinet_authority: A budget is the coalition agreement
with numbers attached. Every governing caucus wants proof that office
purchased delivery, while every partner also wants room for its own electoral
identity. The President cannot use an ordinary veto to erase an adopted
budget, but delay and constitutional conflict can still weaponise the
process.?]

[? if not annual_budget_left_cabinet_authority: **[+ government_owner +]**
owns this bill. Lewica has no state-budget capacity: it can oppose, negotiate a
published concession, tolerate the bill for stability, or lend conditional
support. Party resources pay for drafting, whips and monitoring—not state
programmes. The government's text must still win an ordinary Sejm majority;
it does not pass automatically because Lewica is outside cabinet.?]

[? if not annual_budget_left_cabinet_authority:
<div class="ledger-section ledger-section-first"><div class="ledger-title">Current whip estimate</div>
<div class="ledger-row"><span>Cabinet yes</span><b>[+ annual_budget_preview_government_yes +]</b></div>
<div class="ledger-row"><span>Other opposition no</span><b>[+ annual_budget_preview_other_no +]</b></div>
<div class="ledger-row"><span>Lewica controls</span><b>[+ annual_budget_preview_left_seats +] votes</b></div>
<div class="ledger-subrow">Vote no: [+ annual_budget_preview_government_yes +] yes · [+ annual_budget_preview_reject_no +] no. Abstain: [+ annual_budget_preview_government_yes +] yes · [+ annual_budget_preview_other_no +] no. Support: [+ annual_budget_preview_support_yes +] yes · [+ annual_budget_preview_other_no +] no.</div></div>
An ordinary bill passes only when yes exceeds no with a quorum. The estimate
shows the direct consequence of each posture before any agreement is signed.?]

<div class="ledger-section"><div class="ledger-title">Draft fiscal frame (% of GDP)</div>
<div class="ledger-row"><span>Social spending</span><b>[+ annual_budget_social_share +]%</b></div>
<div class="ledger-row"><span>Defence spending</span><b>[+ annual_budget_defence_share +]%</b></div>
<div class="ledger-row"><span>Deficit</span><b>[+ annual_budget_deficit_share +]%</b></div>
<div class="ledger-subrow">Party goals: Left and PiS seek higher social; PiS, KO and PSL seek higher defence; KO, PSL and Konfederacja seek lower deficit.</div></div>

[? if annual_budget_left_cabinet_authority and annual_budget_finance_control: Lewica controls Finance and can set the three shares directly through a budget profile.?]
[? if annual_budget_left_cabinet_authority and not annual_budget_finance_control: Lewica does not control Finance and can only make demands. Expected bargaining power this round: **[+ annual_budget_player_power +]/100**.?]

The draft was recorded as submitted in **September [+ budget_submission_year
+]**, so the constitutional budget clock expires in **[+ budget_deadline_label
+]**. A defeat today does not itself dismiss the cabinet or dissolve the Sejm.

- @government_social_protocol
- @government_rural_compact
- @government_minimum
- @government_dare
- @government_demand_social_floor
- @government_demand_defence_trade
- @government_demand_debt_guardrail
- @government_accept_draft
- @poland_opposition_budget.audit: Audit last year's enacted opposition clauses
- @poland_opposition_budget.start: Read the government draft and open the four-step opposition process

@government_social_protocol
title: Set profile: High social investment
subtitle: Finance control only. Raises social share; accepts a wider deficit.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 1 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
choose-if: annual_budget_left_cabinet_authority = 1 and budget >= 3
unavailable-subtitle: The governing reserve cannot finance the protocol.
on-arrival: {!
Q.budget -= 3;
Q.annual_budget_strategy = "Finance profile — high social";
Q.annual_budget_package_code = 1;
Q.annual_budget_social_share = 20.6;
Q.annual_budget_defence_share = 4.4;
Q.annual_budget_deficit_share = 5.6;
Q.annual_budget_projected_balance = -5.6;
Q.annual_budget_bargain_points = 6;
Q.annual_budget_demands_text =
    "Health, housing and social floor prioritised";
Q.labor_credibility += 6;
Q.progressive_credibility += 3;
Q.razem_cooperation += 5;
Q.psl_relation -= 4;
Q.ko_relation -= 2;
Q.news_headline =
    "Lewica's Finance ministry sets a social-heavy GDP budget profile";
!}
go-to: internal_ratification

@government_rural_compact
title: Set profile: Coalition security balance
subtitle: Finance control only. Keeps social and defence both high enough for coalition partners.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 1 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
choose-if: annual_budget_left_cabinet_authority = 1 and budget >= 2
unavailable-subtitle: The governing reserve cannot carry both sides of the bargain.
on-arrival: {!
Q.budget -= 2;
Q.annual_budget_strategy = "Finance profile — coalition security";
Q.annual_budget_package_code = 2;
Q.annual_budget_social_share = 19.3;
Q.annual_budget_defence_share = 5.0;
Q.annual_budget_deficit_share = 4.8;
Q.annual_budget_projected_balance = -4.8;
Q.annual_budget_bargain_points = 8;
Q.annual_budget_demands_text =
    "Defence uplift tied to social and local guarantees";
Q.psl_relation += 8;
Q.rural_support += 4;
Q.progressives_dissent += 3;
Q.razem_dissent += 4;
Q.news_headline =
    "Lewica sets a coalition budget with high defence and social floors";
!}
go-to: internal_ratification

@government_minimum
title: Set profile: Debt-brake year
subtitle: Finance control only. Narrows deficit to satisfy KO/PSL debt hawks.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 1 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
choose-if: annual_budget_left_cabinet_authority = 1 and budget >= 1
unavailable-subtitle: Even the minimum package lacks a reserve.
on-arrival: {!
Q.budget -= 1;
Q.annual_budget_strategy = "Finance profile — debt brake";
Q.annual_budget_package_code = 3;
Q.annual_budget_social_share = 17.8;
Q.annual_budget_defence_share = 4.8;
Q.annual_budget_deficit_share = 3.3;
Q.annual_budget_projected_balance = -3.3;
Q.annual_budget_bargain_points = 5;
Q.annual_budget_demands_text =
    "Debt-first settlement with protected core spending";
Q.ko_relation += 5;
Q.psl_relation += 3;
Q.labor_credibility -= 4;
Q.razem_cooperation -= 7;
Q.budget_breaches += 2;
Q.news_headline =
    "Lewica's Finance profile prioritises lower debt over expansion";
!}
go-to: internal_ratification

@government_dare
title: Set profile: Maximal Left ask
subtitle: Finance control only. Highest social target and sharp coalition friction.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 1 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
on-arrival: {!
Q.annual_budget_strategy = "Finance profile — maximal Left";
Q.annual_budget_package_code = 4;
Q.annual_budget_social_share = 21.2;
Q.annual_budget_defence_share = 4.2;
Q.annual_budget_deficit_share = 6.1;
Q.annual_budget_projected_balance = -6.1;
Q.annual_budget_bargain_points = 3;
Q.annual_budget_demands_text =
    "Left programme first; coalition must adapt";
Q.party_unity += 2;
Q.psl_relation -= 12;
Q.ko_relation -= 8;
Q.government_coalition_dissent += 14;
Q.coalition_break_threat = 1;
Q.news_headline =
    "Lewica tables a maximal social GDP budget and dares partners to revolt";
!}
go-to: internal_ratification

@government_demand_social_floor
title: Demand a social floor in the budget
subtitle: No Finance control. Prioritise social share and acceptable pandemic protection.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 0 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
on-arrival: {!
const demandPower = Math.max(0, Math.min(1, Number(Q.annual_budget_player_power) / 100));
const roundDemandShare = function(value) {
    return Math.round(value * 10) / 10;
};
Q.annual_budget_strategy = "Demand mode — social floor";
Q.annual_budget_package_code = 1;
Q.annual_budget_social_share = roundDemandShare(
    Number(Q.annual_budget_draft_social_share) + 0.6 + 1.1 * demandPower
);
Q.annual_budget_defence_share = roundDemandShare(
    Number(Q.annual_budget_draft_defence_share) - 0.1 + 0.2 * demandPower
);
Q.annual_budget_deficit_share = roundDemandShare(
    Number(Q.annual_budget_draft_deficit_share) + 0.2 + 0.6 * demandPower
);
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_bargain_points = Math.round(3 + 5 * demandPower);
Q.annual_budget_demands_text =
    "Social spending floor and health shielding";
Q.labor_credibility += 3;
Q.razem_cooperation += 2;
Q.psl_relation -= 2;
Q.news_headline =
    "Lewica demands a social GDP floor from a Finance ministry it does not control";
!}
go-to: internal_ratification

@government_demand_defence_trade
title: Trade support for defence and local guarantees
subtitle: No Finance control. Improves defence line while preserving a moderate social floor.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 0 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
on-arrival: {!
const demandPower = Math.max(0, Math.min(1, Number(Q.annual_budget_player_power) / 100));
const roundDemandShare = function(value) {
    return Math.round(value * 10) / 10;
};
Q.annual_budget_strategy = "Demand mode — defence trade";
Q.annual_budget_package_code = 2;
Q.annual_budget_social_share = roundDemandShare(
    Number(Q.annual_budget_draft_social_share) + 0.3 + 0.6 * demandPower
);
Q.annual_budget_defence_share = roundDemandShare(
    Number(Q.annual_budget_draft_defence_share) + 0.4 + 0.8 * demandPower
);
Q.annual_budget_deficit_share = roundDemandShare(
    Number(Q.annual_budget_draft_deficit_share) - 0.1 + 0.3 * demandPower
);
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_bargain_points = Math.round(4 + 6 * demandPower);
Q.annual_budget_demands_text =
    "Defence and local funding tied to social guarantees";
Q.psl_relation += 4;
Q.ko_relation += 2;
Q.progressives_dissent += 1;
Q.news_headline =
    "Lewica trades support for a defence-heavy budget plus social guarantees";
!}
go-to: internal_ratification

@government_demand_debt_guardrail
title: Demand a debt guardrail before support
subtitle: No Finance control. Reduce deficit and keep enough social legitimacy.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 0 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
on-arrival: {!
const demandPower = Math.max(0, Math.min(1, Number(Q.annual_budget_player_power) / 100));
const roundDemandShare = function(value) {
    return Math.round(value * 10) / 10;
};
Q.annual_budget_strategy = "Demand mode — debt guardrail";
Q.annual_budget_package_code = 3;
Q.annual_budget_social_share = roundDemandShare(
    Number(Q.annual_budget_draft_social_share) - 0.2 + 0.5 * demandPower
);
Q.annual_budget_defence_share = roundDemandShare(
    Number(Q.annual_budget_draft_defence_share) + 0.1 + 0.4 * demandPower
);
Q.annual_budget_deficit_share = roundDemandShare(
    Number(Q.annual_budget_draft_deficit_share) - 0.4 - 0.6 * demandPower
);
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_bargain_points = Math.round(2 + 4 * demandPower);
Q.annual_budget_demands_text =
    "Lower annual deficit with preserved core social services";
Q.ko_relation += 3;
Q.psl_relation += 3;
Q.labor_credibility -= 2;
Q.news_headline =
    "Lewica conditions support on a lower-deficit annual budget";
!}
go-to: internal_ratification

@government_accept_draft
title: Accept the cabinet draft with minimal changes
subtitle: No Finance control. Fastest route, but own the political cost.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_finance_control = 0 and (opposition_budget_audit_pending = 0 or opposition_budget_audit_year >= annual_budget_year)
on-arrival: {!
Q.annual_budget_strategy = "Demand mode — accept cabinet draft";
Q.annual_budget_package_code = 4;
Q.annual_budget_social_share = Number(Q.annual_budget_draft_social_share);
Q.annual_budget_defence_share = Number(Q.annual_budget_draft_defence_share);
Q.annual_budget_deficit_share = Number(Q.annual_budget_draft_deficit_share);
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_bargain_points = 0;
Q.annual_budget_demands_text =
    "No additional demand beyond coalition stability";
Q.annual_budget_outrageous_support =
    Q.annual_budget_social_share < 17.0 &&
    Q.annual_budget_deficit_share > 5.4 ? 1 : 0;
if (Q.annual_budget_outrageous_support) {
    Q.party_unity -= 4;
    Q.public_trust -= 3;
    Q.razem_dissent += 8;
    Q.labor_credibility -= 4;
}
Q.news_headline = Q.annual_budget_outrageous_support
    ? "Lewica backs an austerity-leaning budget and pays an immediate movement cost"
    : "Lewica backs the cabinet draft for coalition stability";
!}
go-to: internal_ratification

@internal_ratification
title: Active Left caucuses count their deputies
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
call: poland_normalize
on-arrival: {!
const clampInternalBudget = function(value) {
    return Math.max(0, Math.min(100, Math.round(value)));
};
const razemBudgetSeats = Math.max(
    0,
    Math.round(Number(Q.razem_seats) || 0)
);
const razemRedLineCrossed =
    (Number(Q.annual_budget_social_share) || 0) < 18.0 ||
    Boolean(Q.government_burden_breached);
if (
    razemRedLineCrossed &&
    !Q.razem_red_line_broken &&
    !Q.razem_breakaway_protected &&
    (Q.razem_in_government || Q.razem_budget_support_pact)
) {
    const wasInGovernment = Boolean(Q.razem_in_government);
    Q.razem_red_line_broken = 1;
    Q.razem_in_government = 0;
    Q.razem_budget_support_pact = 0;
    Q.razem_government_role = "Opposition after a red-line breach";
    Q.razem_join_vote_result = "Razem withdraws over a breached red line";
    Q.razem_dissent += 20;
    Q.razem_cooperation -= 20;
    Q.party_unity -= 5;
    if (wasInGovernment) {
        Q.coalition_seats = Math.max(
            0,
            (Number(Q.coalition_seats) || 0) - razemBudgetSeats
        );
        Q.ministry_left_cabinet_seats = Math.max(
            0,
            (Number(Q.ministry_left_cabinet_seats) || 0) -
                razemBudgetSeats
        );
        Q.left_cabinet_model =
            "New Left ministers · Razem opposition after red-line exit";
    }
    if (
        (Number(Q.coalition_seats) || 0) <
        (Number(Q.sejm_statutory_majority) || 231)
    ) {
        Q.coalition_break_threat = 1;
    }
}
const caucusTargets = {
    barons: {social: 17.2, defence: 4.8, deficit: 4.2},
    spring: {social: 19.5, defence: 4.2, deficit: 5.0},
    labor: {social: 20.2, defence: 4.0, deficit: 5.6},
    progressives: {social: 19.2, defence: 4.1, deficit: 5.1},
    razem: {social: 20.6, defence: 3.9, deficit: 5.8},
    pps: {social: 19.6, defence: 4.3, deficit: 5.3},
    social_patriot: {social: 16.8, defence: 5.1, deficit: 3.7}
};
const socialShare = Number(Q.annual_budget_social_share) || 17;
const defenceShare = Number(Q.annual_budget_defence_share) || 4.6;
const deficitShare = Number(Q.annual_budget_deficit_share) || 4.5;
Q.annual_budget_outrageous_support =
    (socialShare < 16.8 && deficitShare > 5.4) ||
    (socialShare < 17.2 && defenceShare > 5.6)
        ? 1 : Q.annual_budget_outrageous_support;
let weightedBacking = 0;
let activeStrength = 0;
let vetoes = 0;
for (const caucus of Q.factions) {
    const target = caucusTargets[caucus] || caucusTargets.barons;
    const distancePenalty =
        Math.abs(socialShare - target.social) * 14 +
        Math.abs(defenceShare - target.defence) * 22 +
        Math.abs(deficitShare - target.deficit) * 12;
    const demandBonus = Number(Q.annual_budget_bargain_points) || 0;
    let support = clampInternalBudget(
        100 - distancePenalty +
            demandBonus +
            (Number(Q.party_unity) || 0) * 0.12 -
            (Number(Q[caucus + "_dissent"]) || 0) * 0.42
    );
    if (
        caucus == "razem" &&
        Q.razem_in_government &&
        Q.razem_pivotal_to_coalition &&
        !razemRedLineCrossed
    ) {
        support = 100;
    }
    const strength = Math.max(
        0,
        Number(Q[caucus + "_strength"]) || 0
    );
    Q["annual_budget_" + caucus + "_backing"] = support;
    weightedBacking += support * strength;
    activeStrength += strength;
    if (support < 35 && strength >= 2) vetoes += 1;
}
Q.annual_budget_party_goal_report =
    "Social " + socialShare + "% · Defence " + defenceShare +
    "% · Deficit " + deficitShare + "% GDP";
Q.annual_budget_internal_backing = Math.round(
    weightedBacking / Math.max(1, activeStrength)
);
Q.annual_budget_internal_vetoes = vetoes;
!}

= The active caucus roll call

The package receives **[+ annual_budget_internal_backing +]% weighted
backing** from the caucuses that still belong to **[+ left_party_name +]**.
There are **[+ annual_budget_internal_vetoes +] active red-line vetoes**.
Current frame: **[+ annual_budget_party_goal_report +]**.
Merged and departed organisations cast no votes here; their independent MPs
enter the Sejm arithmetic under their own party agreements.
[? if razem_red_line_broken: Razem has withdrawn from cabinet responsibility
and its support pact after the budget crossed its recorded red line.?]

- @budget_vote: Count the chamber

@opposition_roll
title: The government's budget reaches the Sejm
new-page: true
view-if: annual_budget_left_cabinet_authority = 0
on-arrival: {!
const oppositionSejmTotal = Math.max(
    1,
    Math.round(Number(Q.sejm_total) || 460)
);
const oppositionLeftSeats = Math.max(
    0,
    Math.min(
        oppositionSejmTotal,
        Math.round(Number(Q.left_seats) || 0)
    )
);
let declaredGovernmentSeats = Math.round(
    Number(Q.government_support_seats) ||
    Number(Q.coalition_seats) || 0
);
const storedOppositionGovernmentSeats = Math.round(
    Number(Q.opposition_budget_government_seats) || 0
);
if (storedOppositionGovernmentSeats > 0) {
    declaredGovernmentSeats = storedOppositionGovernmentSeats;
}
if (declaredGovernmentSeats <= 0) {
    if (Q.government_party == "pis") {
        declaredGovernmentSeats =
            Math.round(Number(Q.pis_seats) || 0);
    } else if (Q.government_party == "ko") {
        declaredGovernmentSeats =
            Math.round(Number(Q.ko_seats) || 0) +
            Math.round(Number(Q.p2050_seats) || 0) +
            Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "psl") {
        declaredGovernmentSeats =
            Math.round(Number(Q.psl_seats) || 0);
    } else if (Q.government_party == "p2050") {
        declaredGovernmentSeats =
            Math.round(Number(Q.p2050_seats) || 0);
    }
}
declaredGovernmentSeats = Math.max(
    0,
    Math.min(
        oppositionSejmTotal - oppositionLeftSeats,
        declaredGovernmentSeats
    )
);
const governmentStress =
    (Number(Q.government_coalition_dissent) || 0) +
    (Q.caretaker_government ? 12 : 0) +
    (!Q.government_has_confidence ? 8 : 0);
let governmentDefections = Math.min(
    declaredGovernmentSeats,
    Math.max(0, Math.round((governmentStress - 35) / 8))
);
if (Q.budget_rescue_attempted) {
    governmentDefections = Math.max(
        0,
        governmentDefections - 4
    );
}
Q.annual_budget_government_yes =
    declaredGovernmentSeats - governmentDefections;
Q.annual_budget_government_abstain = governmentDefections;
const leftYes = Math.max(
    0,
    Math.min(
        oppositionLeftSeats,
        Math.round(Number(Q.annual_budget_left_yes) || 0)
    )
);
const leftNo = Math.max(
    0,
    Math.min(
        oppositionLeftSeats - leftYes,
        Math.round(Number(Q.annual_budget_left_no) || 0)
    )
);
const leftAbstain = Math.max(
    0,
    oppositionLeftSeats - leftYes - leftNo
);
Q.annual_budget_left_yes = leftYes;
Q.annual_budget_left_no = leftNo;
Q.annual_budget_left_abstain = leftAbstain;
let otherOppositionNo = Math.max(
    0,
    oppositionSejmTotal -
        declaredGovernmentSeats - oppositionLeftSeats
);
const technicalCrossbenchAbstentions = Q.budget_rescue_attempted
    ? Math.min(4, otherOppositionNo)
    : 0;
otherOppositionNo -= technicalCrossbenchAbstentions;
Q.annual_budget_yes =
    Q.annual_budget_government_yes + leftYes;
Q.annual_budget_no = otherOppositionNo + leftNo;
Q.annual_budget_abstain =
    Q.annual_budget_government_abstain + leftAbstain +
    technicalCrossbenchAbstentions;
Q.annual_budget_present =
    Q.annual_budget_yes +
    Q.annual_budget_no +
    Q.annual_budget_abstain;
Q.annual_budget_threshold = Q.annual_budget_no + 1;
Q.annual_budget_passed =
    Q.annual_budget_present >=
        Math.max(1, Number(Q.sejm_quorum_floor) || 230) &&
    Q.annual_budget_yes > Q.annual_budget_no ? 1 : 0;
Q.annual_budget_margin =
    Q.annual_budget_passed
        ? Q.annual_budget_yes - Q.annual_budget_no
        : 0;
Q.annual_budget_shortfall = Q.annual_budget_passed
    ? 0
    : Math.max(0, Q.annual_budget_no + 1 - Q.annual_budget_yes);
Q["annual_budget_done_" + Q.annual_budget_year] = 1;
Q["annual_budget_passed_" + Q.annual_budget_year] =
    Q.annual_budget_passed;
Q.budget_deadline_active = Q.annual_budget_passed ? 0 : 1;
!}

= Ordinary-majority roll call

<div class="ledger-section ledger-section-first"><div class="ledger-title">The
government's bill</div>
<div class="ledger-row"><span>Lewica posture</span><b>[+ annual_budget_posture +]</b></div>
<div class="ledger-row"><span>Concession</span><b>[+ annual_budget_concession +]</b></div>
<div class="ledger-row"><span>Yes</span><b>[+ annual_budget_yes +]</b></div>
<div class="ledger-row"><span>No</span><b>[+ annual_budget_no +]</b></div>
<div class="ledger-row"><span>Abstain</span><b>[+ annual_budget_abstain +]</b></div>
<div class="ledger-row"><span>Required</span><b>[+ annual_budget_threshold +]</b></div></div>

Abstentions count toward quorum but not against the bill. Passage requires
more yes than no—not 231 yes votes.

- @opposition_roll_continue: Record the result

@opposition_roll_continue
view-if: annual_budget_left_cabinet_authority = 0
go-to: opposition_budget_passed if annual_budget_passed = 1; opposition_budget_failed if annual_budget_passed = 0

@opposition_budget_passed
title: The government carries its budget
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_passed = 1
on-arrival: {!
Q.budget_deadline_active = 0;
Q.annual_budget_result =
    Q.annual_budget_strategy + " — budget passed " +
    Q.annual_budget_yes + " to " + Q.annual_budget_no;
Q.next_budget_label =
    "December " + (Number(Q.annual_budget_year) + 1);
if (Q.annual_budget_negotiation_success) {
    Q.opposition_budget_audit_pending = 1;
    Q.opposition_budget_audit_done = 0;
    Q.opposition_budget_audit_year = Q.annual_budget_year;
    Q.opposition_budget_audit_fiscal_year = Q.annual_budget_fiscal_year;
    Q.opposition_budget_audit_budget_passed = 1;
    Q.opposition_budget_audit_enacted = 1;
    Q.opposition_budget_audit_priority_1_enacted = 1;
    Q.opposition_budget_audit_tactic = Q.annual_budget_strategy;
    Q.opposition_budget_audit_amendment_1 =
        Q.annual_budget_concession + " — enacted; delivery not yet audited";
    Q.opposition_budget_audit_result = "Audit due next year";
}
Q.news_headline = Q.annual_budget_negotiation_success
    ? "The government's budget passes with its written Lewica concession"
    : "The government carries its budget without a Lewica concession";
!}

The cabinet—not Lewica—now implements the budget. No public-capacity score is
awarded at passage. [? if
annual_budget_negotiation_success: The published **[+
annual_budget_concession +]** is part of that government text, so Lewica can
audit delivery next year.?][? if not
annual_budget_negotiation_success: Lewica secured no state programme through
this vote. Its result is the political posture **[+ annual_budget_strategy
+]**.?]

- @return_queue: Return to the remaining events

@opposition_budget_failed
title: The government loses its budget vote
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_passed = 0
on-arrival: {!
Q.budget_deadline_active = 1;
Q.annual_budget_result =
    Q.annual_budget_strategy + " — budget defeated by " +
    Q.annual_budget_shortfall;
if (!Q.budget_rescue_attempted) {
    Q.early_election_risk += Q.caretaker_government ? 18 : 10;
    Q.public_trust -= 2;
    Q.government_coalition_dissent += 6;
} else {
    Q.early_election_risk += Q.caretaker_government ? 12 : 7;
    Q.public_trust -= 1;
    Q.government_coalition_dissent += 4;
}
Q.news_headline = Q.caretaker_government
    ? "The caretaker cabinet cannot assemble a budget majority"
    : "The government loses its budget but not an automatic confidence vote";
!}

The bill is **[+ annual_budget_shortfall +] vote(s)** short. The cabinet has
not automatically fallen and no election has automatically begun. The
recorded budget deadline remains **[+ budget_deadline_label +]**.

[? if caretaker_government: A caretaker without a budget remains a formation
and deadline problem. Lewica cannot convert the defeat into executive
authority.?]
[? if not caretaker_government: The government may revise the text, test
confidence separately or seek a lawful election route. Lewica remains
opposition throughout.?]

- @opposition_revision_hearing
- @opposition_deadline_demand
- @opposition_hold_deadline
- @opposition_caretaker_formation

@opposition_revision_hearing
title: Review the cabinet's one technical revision
subtitle: One second ordinary vote; the cabinet offers reporting and deadlines, not a blank cheque.
view-if: caretaker_government = 0 and budget_rescue_attempted = 0
on-arrival: {!
Q.budget_rescue_attempted = 1;
Q.annual_budget_revision_pending = 1;
Q.annual_budget_cabinet_response =
    "Cabinet tables a technical revision with a delivery register";
Q.news_headline =
    "The cabinet returns once with a narrower budget and a delivery register";
!}
go-to: opposition_revision_response

@opposition_revision_response
title: The technical revision
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_revision_pending = 1

The first bill failed **[+ annual_budget_yes +]–[+ annual_budget_no +]**. The
cabinet now offers a quarterly delivery register and fixed implementation
dates. It does not hand Lewica expenditure authority.

Lewica may accept that written clause and abstain, or vote no again. Either
choice produces a second ordinary-majority roll call; a second defeat closes
this revision route.

- @opposition_revision_abstain
- @opposition_revision_reject

@opposition_revision_abstain
title: Accept the register and abstain on the revision
subtitle: No Lewica yes votes; the cabinet still has to beat the remaining no votes.
on-arrival: {!
Q.annual_budget_revision_pending = 0;
Q.annual_budget_strategy =
    "Technical revision — written register for abstention";
Q.annual_budget_posture = "Abstain on revised bill";
Q.annual_budget_concession =
    "Quarterly delivery register and fixed implementation dates";
Q.annual_budget_concession_code = 2;
Q.annual_budget_concession_strength = 1;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.government_coalition_dissent -= 4;
Q.party_unity -= 3;
Q.razem_dissent += 5;
Q.news_headline =
    "Lewica accepts a monitored revision without joining the cabinet";
!}
go-to: opposition_roll

@opposition_revision_reject
title: Vote no on the revision
subtitle: The budget deadline remains active and no third identical vote is offered.
on-arrival: {!
Q.annual_budget_revision_pending = 0;
Q.annual_budget_strategy = "Technical revision rejected";
Q.annual_budget_posture = "Oppose revised bill";
Q.annual_budget_concession = "Revision rejected by Lewica";
Q.annual_budget_concession_code = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_abstain = 0;
Q.annual_budget_left_no = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.party_unity += 2;
Q.news_headline =
    "Lewica rejects the cabinet's only technical revision";
!}
go-to: opposition_roll

@opposition_deadline_demand
title: Demand talks on a lawful early-election route
subtitle: Records a political demand; it neither dissolves the Sejm nor dismisses the cabinet.
on-arrival: {!
Q.snap_election_requested = 1;
Q.snap_election_request_time = Number(Q.time) || 0;
Q.snap_election_request_year =
    Number(Q.year) || Q.annual_budget_year;
Q.snap_election_request_month = Number(Q.month) || 12;
Q.snap_election_reason =
    "Opposition demand after a defeated annual budget";
Q.snap_event_deferred_time = -1;
Q.early_election_risk = Math.max(70, Q.early_election_risk);
Q.annual_budget_result += " — lawful election talks requested";
Q.news_headline =
    "Lewica demands a constitutional election route without declaring one into existence";
!}
go-to: return_queue

@opposition_hold_deadline
title: Keep opposing and let the constitutional budget clock run
subtitle: No election demand; the President's Article 225 decision appears only if the four-month deadline expires.
view-if: caretaker_government = 0
on-arrival: {!
Q.annual_budget_revision_pending = 0;
Q.budget_deadline_active = 1;
Q.annual_budget_result += " — deadline remains active";
Q.news_headline =
    "The cabinet remains in office while the budget deadline runs";
!}
go-to: return_queue

@opposition_caretaker_formation
title: Proceed to the caretaker government's formation vote
subtitle: A caretaker without confidence must test all constitutional formation stages.
view-if: caretaker_government = 1
on-arrival: snap_formation_context = "Budget-defeat caretaker formation"; snap_formation_attempt = 1; snap_election_requested = 0; news_headline = "The caretaker budget defeat moves into a real cabinet-formation vote"
go-to: poland_events_2026.snap_formation_attempt_one

@budget_vote
title: Caucus whips count the chamber
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
const recordedLeftCabinetSeats = Math.max(
    0,
    Number(Q.ministry_left_cabinet_seats) || 0
);
const leftSeats = recordedLeftCabinetSeats > 0
    ? recordedLeftCabinetSeats
    : Math.max(0, Number(Q.left_seats) || 0);
const dependableNonLeftSupport = Math.max(
    0,
    Math.round(Number(Q.government_support_seats) || 0)
);
let governingSeats = dependableNonLeftSupport > 0
    ? dependableNonLeftSupport + leftSeats
    : Number(Q.coalition_seats);
if (!Number.isFinite(governingSeats) || governingSeats <= 0) {
    governingSeats =
        (Number(Q.ko_seats) || 0) +
        (Number(Q.psl_seats) || 0) +
        (Number(Q.p2050_seats) || 0) +
        leftSeats;
}
governingSeats = Math.max(0, Math.min(sejmTotal, Math.round(governingSeats)));
const externalRazemYes =
    !Q.razem_in_government &&
    Q.razem_budget_support_pact &&
    !Q.razem_red_line_broken &&
    governingSeats < (Number(Q.sejm_statutory_majority) || 231)
        ? Math.max(0, Math.round(Number(Q.razem_seats) || 0))
        : 0;
if (externalRazemYes > 0) {
    Q.razem_pivotal_to_coalition = 1;
    Q.razem_government_role =
        "Confidence and supply · pivotal budget votes";
}
const leftBacking = Math.max(
    0,
    Math.min(100, Number(Q.annual_budget_internal_backing) || 0)
);
const leftRebels = Math.min(
    leftSeats,
    Math.round(leftSeats * (100 - leftBacking) / 100) +
        Math.max(0, Number(Q.annual_budget_internal_vetoes) || 0)
);
const coalitionStress =
    (Number(Q.government_coalition_dissent) || 0) +
    Math.max(0, 45 - (Number(Q.ko_relation) || 0)) * 0.35 +
    Math.max(0, 40 - (Number(Q.psl_relation) || 0)) * 0.55 +
    (Q.third_way_split ? 5 : 0) +
    (Q.p2050_split ? 4 : 0);
const partnerDefections = Math.max(
    0,
    Math.round((coalitionStress - 34) / 5)
);
const coalitionGoalPenalty =
    Math.max(0, (Number(Q.annual_budget_deficit_share) || 0) - 4.4) * 2.2 +
    Math.max(0, 4.5 - (Number(Q.annual_budget_defence_share) || 0)) * 2.0;
const leftProgrammePenalty =
    Math.max(0, 18.8 - (Number(Q.annual_budget_social_share) || 0)) * 2.8;
const fiscalCredibilityBonus =
    Math.max(0, 4.2 - (Number(Q.annual_budget_deficit_share) || 0)) * 1.8;
const initialDefectors = Math.min(
    governingSeats,
    leftRebels + partnerDefections +
        Math.max(
            0,
            Math.round(
                coalitionGoalPenalty + leftProgrammePenalty -
                fiscalCredibilityBonus
            )
        )
);
const strategyBonus = Math.max(
    0,
    Math.round(
        (Number(Q.annual_budget_bargain_points) || 0) / 2 +
        ((Number(Q.annual_budget_player_power) || 0) - 50) / 20
    )
);
const recoveredDefectors = Math.min(
    initialDefectors,
    Math.max(0, strategyBonus)
);
Q.annual_budget_recorded_defectors =
    initialDefectors - recoveredDefectors;
Q.annual_budget_yes = Math.max(
    0,
    Math.min(
        sejmTotal,
        governingSeats - Q.annual_budget_recorded_defectors +
            externalRazemYes
    )
);
Q.annual_budget_abstain = Math.max(
    0,
    Math.min(
        sejmTotal - Q.annual_budget_yes,
        Math.ceil(Q.annual_budget_recorded_defectors / 2)
    )
);
Q.annual_budget_no =
    sejmTotal - Q.annual_budget_yes - Q.annual_budget_abstain;
Q.annual_budget_present =
    Q.annual_budget_yes +
    Q.annual_budget_no +
    Q.annual_budget_abstain;
Q.annual_budget_threshold = Q.annual_budget_no + 1;
Q.annual_budget_passed =
    Q.annual_budget_present >=
        Math.max(1, Number(Q.sejm_quorum_floor) || 230) &&
    Q.annual_budget_yes > Q.annual_budget_no ? 1 : 0;
Q.annual_budget_margin = Q.annual_budget_passed
    ? Q.annual_budget_yes - Q.annual_budget_no
    : 0;
Q.annual_budget_shortfall = Q.annual_budget_passed
    ? 0
    : Math.max(0, Q.annual_budget_no + 1 - Q.annual_budget_yes);
Q.annual_budget_result = Q.annual_budget_passed
    ? "Passed " + Q.annual_budget_yes + " to " + Q.annual_budget_no
    : "Failed " + Q.annual_budget_shortfall + " votes short";
Q["annual_budget_done_" + Q.annual_budget_year] = 1;
Q["annual_budget_passed_" + Q.annual_budget_year] =
    Q.annual_budget_passed;
Q.budget_deadline_active = Q.annual_budget_passed ? 0 : 1;
!}

= Sejm roll call

**Yes [+ annual_budget_yes +] · No [+ annual_budget_no +] · Abstain
[+ annual_budget_abstain +]**

Frame: **Social [+ annual_budget_social_share +]% · Defence [+ annual_budget_defence_share +]% · Deficit [+ annual_budget_deficit_share +]% GDP**.
[? if annual_budget_demands_text != "No demands filed": Demand/bargain line: **[+ annual_budget_demands_text +]**.?]

[? if annual_budget_passed: The budget carries with **[+
annual_budget_margin +] more yes than no**.?]
[? if not annual_budget_passed: The bill falls **[+
annual_budget_shortfall +]** votes short. A fiscal defeat is now a coalition
crisis, not an automatic no-confidence vote.?]

Required on this roll call: **[+ annual_budget_threshold +] yes**, because
abstentions do not count against an ordinary bill.

- @budget_passed
- @budget_failed

@budget_passed
title: Ratify the result
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_passed = 1
on-arrival: {!
Q.budget_deadline_active = 0;
Q.government_delivery += 4;
const socialShare = Number(Q.annual_budget_social_share) || 17;
const defenceShare = Number(Q.annual_budget_defence_share) || 4.6;
const deficitShare = Number(Q.annual_budget_deficit_share) || 4.5;
const socialImpulse = socialShare - 17.0;
const defenceImpulse = defenceShare - 4.4;
const deficitImpulse = deficitShare - 4.2;
Q.household_security += Math.round(Math.max(0, socialImpulse * 1.4));
Q.military_trust += Math.round(Math.max(0, defenceImpulse * 1.8));
Q.fiscal_stress +=
    Math.round(deficitImpulse * 2 + Math.max(0, socialImpulse) * 0.8);
Q.budget_balance = Math.round(-deficitShare * 10) / 10;
Q.public_debt += Math.round((deficitShare - 3.4) * 7) / 10;
Q.economic_growth +=
    Math.round((socialImpulse * 0.06 + defenceImpulse * 0.04 - deficitImpulse * 0.05) * 10) / 10;
if (Q.annual_budget_outrageous_support) {
    Q.party_unity -= 2;
    Q.public_trust -= 2;
    Q.razem_dissent += 5;
}
Q.public_trust += 2;
Q.government_coalition_dissent -= 3;
Q.next_budget_label =
    "December " + (Number(Q.annual_budget_year) + 1);
Q.news_headline =
    "The annual budget passes after a full caucus count";
!}

= The government lives another year

The Sejm majority has survived the annual vote. The enacted wording is not
final until the Senate has used—or declined—its twenty-day amendment window.

- @senate_budget_review: Send the budget to the Senate

@senate_budget_review
title: The Senate reviews the annual budget
new-page: true
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_passed = 1 and annual_budget_senate_stage_done = 0
call: poland_senate.refresh
on-arrival: {!
const senateTotal = Math.max(
    1,
    Math.round(Number(Q.senate_total) || 100)
);
const independents = Math.max(
    0,
    Math.round(Number(Q.senate_independent_seats) || 0)
);
// `call:` scenes run after this arrival block.  Derive the live cabinet bloc
// here instead of reading the previous refresh's cached government total.
const cabinetPartySenators = Math.max(
    0,
    Math.min(
        senateTotal - independents,
        (Q.government_party == "pis"
            ? Math.round(Number(Q.senate_pis_seats) || 0) : 0) +
        (
            Q.government_party == "ko" || Q.ministry_ko_in_cabinet
                ? Math.round(Number(Q.senate_ko_seats) || 0) : 0
        ) +
        (
            Q.government_party == "p2050" || Q.ministry_p2050_in_cabinet
                ? Math.round(Number(Q.senate_p2050_seats) || 0) : 0
        ) +
        (
            Q.government_party == "psl" || Q.ministry_psl_in_cabinet
                ? Math.round(Number(Q.senate_psl_seats) || 0) : 0
        ) +
        (
            Q.government_party == "lewica" || Q.left_in_government
                ? Math.round(Number(Q.senate_left_seats) || 0) : 0
        )
    )
);
const cohesion = Math.max(
    0,
    Math.min(100, Number(Q.senate_cohesion) || 0)
);
const governmentIndependentVotes = Math.round(
    independents * cohesion / 100
);
Q.annual_budget_senate_government_votes = Math.min(
    senateTotal,
    cabinetPartySenators + governmentIndependentVotes
);
Q.annual_budget_senate_hostile_votes = Math.max(
    0,
    senateTotal - Q.annual_budget_senate_government_votes
);
Q.annual_budget_senate_corrections_pending =
    Q.annual_budget_senate_hostile_votes >=
        Math.floor(senateTotal / 2) + 1 ? 1 : 0;
Q.annual_budget_senate_correction_strength =
    Q.annual_budget_senate_corrections_pending
        ? Math.min(
            3,
            1 + Math.floor(
                (Q.annual_budget_senate_hostile_votes - 51) / 8
            )
        )
        : 0;
const correctionPackages = {
    1: "deficit limits and regional investment reallocations",
    2: "county roads, defence and agricultural reallocations",
    3: "family-policy and local-government reallocations",
    4: "line-item spending caps and implementation reports"
};
Q.annual_budget_senate_correction =
    Q.annual_budget_senate_corrections_pending
        ? correctionPackages[Number(Q.annual_budget_package_code) || 4]
        : "No correction adopted";
Q.annual_budget_senate_result =
    Q.annual_budget_senate_corrections_pending
        ? "An unfriendly Senate adopted " +
            Q.annual_budget_senate_correction
        : "The Senate returned the budget without corrections";
Q.senate_last_vote = Q.annual_budget_senate_result;
Q.budget_deadline_active = 1;
!}

= Twenty days in the upper chamber

Government-aligned votes: **[+ annual_budget_senate_government_votes +]**.
Votes available to an unfriendly majority: **[+
annual_budget_senate_hostile_votes +]**.

[? if annual_budget_senate_corrections_pending: The Senate adopts **[+
annual_budget_senate_correction +]**. The Senate cannot reject the budget, but
its correction is accepted unless the Sejm rejects it by an absolute majority.
That is a harder whip than the ordinary-majority vote which first carried the
budget.?]

[? if not annual_budget_senate_corrections_pending: No hostile majority can
assemble around a correction. The budget returns unchanged and the coalition
does not need a second Sejm whip.?]

- @senate_budget_accept
- @senate_budget_compromise
- @senate_budget_override
- @senate_budget_unchanged

@senate_budget_accept
title: Incorporate the Senate corrections into the government budget
subtitle: Adhere in full; lower fiscal stress, but lose programme delivery and coalition ownership.
view-if: annual_budget_senate_corrections_pending = 1
on-arrival: {!
Q.annual_budget_senate_stage_done = 1;
Q.annual_budget_senate_corrections_accepted = 1;
Q.government_delivery -= Q.annual_budget_senate_correction_strength;
Q.fiscal_stress -= Q.annual_budget_senate_correction_strength * 2;
Q.labor_credibility -= Q.annual_budget_senate_correction_strength;
Q.government_coalition_dissent += 3;
Q.annual_budget_senate_result =
    "Government incorporated the Senate corrections";
Q.annual_budget_result += " — Senate corrections incorporated";
Q.budget_deadline_active = 0;
Q.news_headline =
    "The cabinet adheres to the Senate's corrected budget";
!}
go-to: return_queue

@senate_budget_compromise
title: Negotiate a narrower correction and incorporate it
subtitle: Cost: 1 party resource. The accepted correction is smaller, but still binds the cabinet.
view-if: annual_budget_senate_corrections_pending = 1
choose-if: resources >= 1
unavailable-subtitle: A cross-chamber negotiating team requires one party resource.
on-arrival: {!
Q.resources -= 1;
Q.annual_budget_senate_stage_done = 1;
Q.annual_budget_senate_corrections_accepted = 1;
Q.annual_budget_senate_correction_strength = Math.max(
    1,
    Q.annual_budget_senate_correction_strength - 1
);
Q.government_delivery -= 1;
Q.fiscal_stress -= Q.annual_budget_senate_correction_strength;
Q.government_coalition_dissent += 1;
Q.public_trust += 1;
Q.annual_budget_senate_result =
    "Government negotiated and incorporated a narrower Senate correction";
Q.annual_budget_result += " — narrow Senate correction incorporated";
Q.budget_deadline_active = 0;
Q.news_headline =
    "The coalition adheres to a narrowed Senate correction";
!}
go-to: return_queue

@senate_budget_override
title: Ask the Sejm to reject every Senate correction
subtitle: Requires an absolute majority; coalition partners attracted by the correction may abstain.
view-if: annual_budget_senate_corrections_pending = 1
on-arrival: {!
const overridePresent = Math.max(
    Math.round(Number(Q.annual_budget_present) || 0),
    Math.round(Number(Q.sejm_quorum_floor) || 230)
);
const correctionDefections = Math.min(
    Math.max(0, Math.round(Number(Q.annual_budget_yes) || 0)),
    2 + Q.annual_budget_senate_correction_strength * 2 +
        Math.max(
            0,
            Math.round(((Number(Q.psl_coalition_dissent) || 0) - 20) / 10)
        )
);
Q.annual_budget_senate_override_yes = Math.max(
    0,
    Math.round(Number(Q.annual_budget_yes) || 0) - correctionDefections
);
Q.annual_budget_senate_override_abstain = Math.max(
    0,
    Math.round(Number(Q.annual_budget_abstain) || 0) + correctionDefections
);
Q.annual_budget_senate_override_no = Math.max(
    0,
    overridePresent - Q.annual_budget_senate_override_yes -
        Q.annual_budget_senate_override_abstain
);
Q.annual_budget_senate_override_threshold =
    Math.floor(overridePresent / 2) + 1;
Q.annual_budget_senate_override_passed =
    Q.annual_budget_senate_override_yes >=
        Q.annual_budget_senate_override_threshold ? 1 : 0;
!}
go-to: senate_budget_override_result

@senate_budget_override_result
title: The Sejm answers the Senate corrections
new-page: true
view-if: annual_budget_senate_corrections_pending = 1
on-arrival: {!
Q.annual_budget_senate_stage_done = 1;
Q.budget_deadline_active = 0;
if (Q.annual_budget_senate_override_passed) {
    Q.annual_budget_senate_corrections_accepted = 0;
    Q.annual_budget_senate_result =
        "Sejm rejected the Senate corrections by absolute majority";
    Q.annual_budget_result += " — Senate corrections overridden";
    Q.government_coalition_dissent += 4;
    Q.psl_relation -= 2;
    Q.news_headline =
        "The coalition finds an absolute majority against the Senate";
} else {
    Q.annual_budget_senate_corrections_accepted = 1;
    Q.annual_budget_senate_result =
        "Sejm failed to reject the Senate corrections; they entered the budget";
    Q.annual_budget_result +=
        " — failed override left Senate corrections in force";
    Q.government_delivery -= Q.annual_budget_senate_correction_strength;
    Q.fiscal_stress -= Q.annual_budget_senate_correction_strength;
    Q.government_coalition_dissent += 12;
    Q.coalition_break_threat = 1;
    Q.public_trust -= 2;
    Q.news_headline =
        "A failed Senate override deadlocks the governing coalition";
}
!}

**Yes [+ annual_budget_senate_override_yes +] · No [+
annual_budget_senate_override_no +] · Abstain [+
annual_budget_senate_override_abstain +] · Absolute majority [+
annual_budget_senate_override_threshold +]**

