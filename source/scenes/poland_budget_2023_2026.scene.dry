@budget_whip_operation
title: Spend one party resource on a named final whip operation
subtitle: Recovers at most a few recorded rebels; it cannot replace a missing coalition partner.
view-if: annual_budget_whip_used = 0
choose-if: resources >= 1
unavailable-subtitle: The party lacks the staff and political capital for another whip operation.
on-arrival: {!
Q.resources -= 1;
Q.annual_budget_whip_used = 1;
Q.annual_budget_whip_bonus = Math.max(
    2,
    Math.min(
        5,
        2 + Math.round((Number(Q.party_unity) || 50) / 35) +
            Math.round((Number(Q.negotiation_leverage) || 0) / 40)
    )
);
Q.news_headline = "A named whip team works the recorded budget rebels";
!}
go-to: coalition_whip

@budget_deal_market
title: The price of a majority
new-page: true
view-if: annual_budget_predicted_passed = 0 and annual_budget_external_deal_used = 0 and annual_budget_vote_round = 1

= The government opens the locked rooms

The package is **[+ annual_budget_predicted_shortfall +] vote(s)** short. No
party receives free anonymous votes. Every available bargain changes the bill,
names a beneficiary and returns through Lewica's internal caucuses before the
roll call.

A deal can be lucrative without being a suitcase of cash: ring-fenced county
capital, funded public wages, committee control, procurement guarantees or a
written regulatory concession all create constituencies with something to
lose if the agreement collapses.

- @deal_coalition_rewrite
- @deal_psl_counties
- @deal_razem_public_services
- @deal_democratic_green_register
- @deal_pis_family_defence
- @deal_konf_market
- @deal_refuse

@deal_coalition_rewrite
title: Reopen the coalition agreement around county capital and a deficit review
subtitle: Cost: 1 governing-capacity point. Repairs governing-partner defections but adds no outside MPs.
view-if: annual_budget_predicted_partner_defectors > 0
choose-if: budget >= 1
unavailable-subtitle: The cabinet lacks capacity to rewrite appropriations and implementation schedules.
on-arrival: {!
Q.budget -= 1;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = "Coalition partners";
Q.annual_budget_external_votes_committed = 0;
Q.annual_budget_local_compact = 1;
Q.annual_budget_deficit_rule = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.1) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 0.1) * 10
) / 10;
Q.government_coalition_dissent = Math.max(
    0,
    Number(Q.government_coalition_dissent) - 8
);
Q.psl_relation += 4;
Q.p2050_relation += 3;
Q.ko_relation += 2;
Q.annual_budget_concession =
    "County capital schedule and binding mid-year deficit review";
Q.annual_budget_concession_code = 1;
Q.news_headline = "The coalition rewrites the budget around county capital and a deficit review";
!}
go-to: internal_ratification

@deal_psl_counties
title: Offer PSL a ring-fenced county capital fund and implementation board
subtitle: Cost: 2 governing-capacity points. Buys identifiable PSL votes; local investment and deficit both rise.
view-if: government_party != "psl" and not ministry_psl_in_cabinet and psl_seats > 0
choose-if: budget >= 2
unavailable-subtitle: The government cannot staff and finance the county compact.
on-arrival: {!
const seats = Math.max(0, Math.round(Number(Q.psl_seats) || 0));
const relation = Math.max(0, Math.min(100, Number(Q.psl_relation) || 25));
const cohort = Math.max(1, Math.round(seats * (0.35 + relation / 250)));
Q.budget -= 2;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = "psl";
Q.annual_budget_external_votes_committed = Math.min(
    seats,
    cohort,
    Math.max(1, Number(Q.annual_budget_predicted_shortfall) + 4)
);
Q.annual_budget_local_compact = 1;
Q.annual_budget_reconstruction_fund = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.1) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.2) * 10
) / 10;
Q.annual_budget_concession =
    "Ring-fenced county capital fund with a PSL-chaired implementation board";
Q.annual_budget_concession_code = 2;
Q.annual_budget_negotiation_success = 1;
Q.psl_relation += 7;
Q.news_headline = "PSL receives a county capital compact in exchange for named budget votes";
!}
go-to: internal_ratification

@deal_razem_public_services
title: Guarantee public wages, housing and care to external Razem deputies
subtitle: Cost: 2 governing-capacity points. Raises the social and deficit lines; the commitment is written into the bill.
view-if: not razem_in_government and razem_seats > 0
choose-if: budget >= 2
unavailable-subtitle: A funded social guarantee requires two governing-capacity points.
on-arrival: {!
const seats = Math.max(0, Math.round(Number(Q.razem_seats) || 0));
const cooperation = Math.max(0, Math.min(100, Number(Q.razem_cooperation) || 35));
const cohort = Math.max(1, Math.round(seats * (0.60 + cooperation / 300)));
Q.budget -= 2;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = "razem";
Q.annual_budget_external_votes_committed = Math.min(
    seats,
    cohort,
    Math.max(1, Number(Q.annual_budget_predicted_shortfall) + 3)
);
Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.4) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.2) * 10
) / 10;
Q.annual_budget_concession =
    "Funded public-wage, housing and care guarantee";
Q.annual_budget_concession_code = 3;
Q.annual_budget_negotiation_success = 1;
Q.razem_cooperation += 8;
Q.news_headline = "A funded public-services guarantee brings external Razem votes to the table";
!}
go-to: internal_ratification

@deal_democratic_green_register
title: Offer the democratic centre a green fund and statutory delivery register
subtitle: Cost: 1 party resource. Attracts KO or Polska 2050 votes without handing Lewica's ministries away.
view-if: (government_party != "ko" and not ministry_ko_in_cabinet and ko_seats > 0) or (government_party != "p2050" and not ministry_p2050_in_cabinet and p2050_seats > 0)
choose-if: resources >= 1
unavailable-subtitle: The parliamentary and legal team cannot write and police the agreement.
on-arrival: {!
const koSeats = Math.max(0, Math.round(Number(Q.ko_seats) || 0));
const pSeats = Math.max(0, Math.round(Number(Q.p2050_seats) || 0));
const koAvailable = Q.government_party != "ko" && !Q.ministry_ko_in_cabinet;
const pAvailable = Q.government_party != "p2050" && !Q.ministry_p2050_in_cabinet;
const target = pAvailable && (!koAvailable || Number(Q.p2050_relation) >= Number(Q.ko_relation))
    ? "p2050" : "ko";
const seats = target == "p2050" ? pSeats : koSeats;
const relation = target == "p2050"
    ? Number(Q.p2050_relation) || 30
    : Number(Q.ko_relation) || 35;
const cohort = Math.max(1, Math.round(seats * (0.22 + Math.max(0, relation) / 320)));
Q.resources -= 1;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = target;
Q.annual_budget_external_votes_committed = Math.min(
    seats,
    cohort,
    Math.max(1, Number(Q.annual_budget_predicted_shortfall) + 3)
);
Q.annual_budget_green_investment = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_deficit_rule = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.1) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 0.1) * 10
) / 10;
Q.annual_budget_concession =
    "Green municipal fund and statutory quarterly delivery register";
Q.annual_budget_concession_code = 4;
Q.annual_budget_negotiation_success = 1;
Q.public_trust += 1;
Q.news_headline = target == "p2050"
    ? "Polska 2050 trades votes for a green fund and delivery register"
    : "KO trades votes for a green fund and delivery register";
!}
go-to: internal_ratification

@deal_pis_family_defence
title: Offer PiS a family-transfer and defence-procurement accord
subtitle: Cost: 2 governing-capacity points. A solidarist PiS cohort may cross over; the economic and cultural Left will notice exactly what was bought.
view-if: government_party != "pis" and not ministry_pis_in_cabinet and pis_seats > 0
choose-if: budget >= 2
unavailable-subtitle: The cabinet cannot finance the family and procurement guarantees.
on-arrival: {!
const seats = Math.max(0, Math.round(Number(Q.pis_seats) || 0));
const solidarists = Math.max(20, Math.min(80, Number(Q.pis_solidarist_share) || 50));
const relation = Math.max(0, Math.min(100, Number(Q.pis_relation) || 10));
const cohort = Math.max(
    1,
    Math.round(seats * solidarists / 100 * (0.10 + relation / 450))
);
Q.budget -= 2;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = "pis";
Q.annual_budget_external_votes_committed = Math.min(
    seats,
    cohort,
    Math.max(1, Number(Q.annual_budget_predicted_shortfall) + 5)
);
Q.annual_budget_family_defence_deal = 1;
Q.annual_budget_right_deal = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.2) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_defence_share) + 0.3) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.4) * 10
) / 10;
Q.annual_budget_concession =
    "Family-transfer guarantee and protected domestic defence procurement";
Q.annual_budget_concession_code = 5;
Q.annual_budget_negotiation_success = 1;
Q.pis_relation += 5;
Q.news_headline = "The government buys a PiS cohort with family and defence guarantees";
!}
go-to: internal_ratification

@deal_konf_market
title: Offer Konfederacja a deregulation and tax-expenditure review
subtitle: Cost: 1 governing-capacity point. Buys only a factional cohort and directly cuts the social frame.
view-if: government_party != "konf" and not ministry_konf_in_cabinet and konf_seats > 0
choose-if: budget >= 1
unavailable-subtitle: The cabinet lacks capacity to rewrite the regulatory and tax schedules.
on-arrival: {!
const seats = Math.max(0, Math.round(Number(Q.konf_seats) || 0));
const relation = Math.max(0, Math.min(100, Number(Q.konf_relation) || 5));
const cohort = Math.max(1, Math.round(seats * (0.14 + relation / 500)));
Q.budget -= 1;
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_external_deal_target = "konf";
Q.annual_budget_external_votes_committed = Math.min(
    seats,
    cohort,
    Math.max(1, Number(Q.annual_budget_predicted_shortfall) + 2)
);
Q.annual_budget_market_cuts = 1;
Q.annual_budget_right_deal = 1;
Q.annual_budget_social_share = Math.round(
    Math.max(14, Number(Q.annual_budget_social_share) - 0.2) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 0.2) * 10
) / 10;
Q.annual_budget_concession =
    "Deregulation package and tax-expenditure review";
Q.annual_budget_concession_code = 6;
Q.annual_budget_negotiation_success = 1;
Q.news_headline = "A Konfederacja cohort prices its votes in deregulation and cuts";
!}
go-to: internal_ratification

@deal_refuse
title: Refuse side deals and put the coalition bill to a vote
subtitle: The shortfall remains real; a defeat opens only one emergency revision.
on-arrival: annual_budget_external_deal_used = 1; annual_budget_external_deal_target = "None"; annual_budget_external_votes_committed = 0; annual_budget_concession = "No outside bargain"; news_headline = "The cabinet refuses to buy a majority before the vote"
go-to: budget_vote

@opposition_budget_open
title: The government counts Lewica's votes
new-page: true
view-if: annual_budget_left_cabinet_authority = 0
on-arrival: {!
const oppNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const total = Math.max(1, Math.round(oppNum(Q.sejm_total, 460)));
const left = Math.max(0, Math.min(total, Math.round(oppNum(Q.left_seats, 0))));
let government = Math.round(oppNum(Q.coalition_seats, 0));
if (government <= 0) government = Math.round(oppNum(Q.government_support_seats, 0));
if (government <= 0) {
    government =
        (Q.government_party == "pis" || Q.ministry_pis_in_cabinet
            ? Math.round(oppNum(Q.pis_seats, 0)) : 0) +
        (Q.government_party == "ko" || Q.ministry_ko_in_cabinet
            ? Math.round(oppNum(Q.ko_seats, 0)) : 0) +
        (Q.government_party == "psl" || Q.ministry_psl_in_cabinet
            ? Math.round(oppNum(Q.psl_seats, 0)) : 0) +
        (Q.government_party == "p2050" || Q.ministry_p2050_in_cabinet
            ? Math.round(oppNum(Q.p2050_seats, 0)) : 0) +
        (Q.government_party == "konf" || Q.ministry_konf_in_cabinet
            ? Math.round(oppNum(Q.konf_seats, 0)) : 0);
}
government = Math.max(0, Math.min(total - left, government));
const stress =
    oppNum(Q.government_coalition_dissent, 0) +
    (Q.caretaker_government ? 12 : 0) +
    (!Q.government_has_confidence ? 8 : 0);
const budgetModel = (typeof window !== "undefined"
    ? window : globalThis).polandBudgetModel;
const malcontents = budgetModel.malcontents(stress, government);
/* Published for the baseline in which Lewica abstains.  Rebellion is priced
 * by pivotality: while the cabinet is comfortable a protest costs its own
 * backbenchers nothing, so this number is the maximum, not a constant.  A
 * Lewica no shrinks the margin and brings the same MPs home. */
const otherNo = Math.max(0, total - government - left);
const rollFor = function(leftYes, leftNo, leftAbstain) {
    return budgetModel.rollCall({
        sejmTotal: total,
        quorum: Q.sejm_quorum_floor,
        governmentSeats: government,
        malcontents: malcontents,
        leftYes: leftYes,
        leftNo: leftNo,
        leftAbstain: leftAbstain,
        externalNo: otherNo
    });
};
const abstainRoll = rollFor(0, 0, left);
Q.annual_budget_opposition_malcontents = malcontents;
Q.annual_budget_opposition_government_yes = abstainRoll.governmentYes;
Q.annual_budget_opposition_government_abstain = abstainRoll.governmentAbstain;
Q.annual_budget_opposition_other_no = otherNo;
Q.annual_budget_opposition_left_seats = left;
/* The same pricing run forward for each posture Lewica can take, so the
 * trade is visible before it is made: withholding votes disciplines the
 * cabinet's own side, lending them frees it to split in public. */
const noRoll = rollFor(0, left, 0);
const yesRoll = rollFor(left, 0, 0);
Q.annual_budget_opposition_no_left_yes = noRoll.yes;
Q.annual_budget_opposition_no_left_no = noRoll.no;
Q.annual_budget_opposition_no_left_rebels = noRoll.defectors;
Q.annual_budget_opposition_abstain_yes = abstainRoll.yes;
Q.annual_budget_opposition_abstain_rebels = abstainRoll.defectors;
Q.annual_budget_opposition_support_yes = yesRoll.yes;
Q.annual_budget_opposition_support_no = yesRoll.no;
Q.annual_budget_opposition_support_rebels = yesRoll.defectors;
Q.annual_budget_opposition_shortfall = abstainRoll.shortfall;
Q.annual_budget_opposition_pivotal =
    Q.annual_budget_opposition_shortfall > 0 &&
    Q.annual_budget_opposition_shortfall <= left ? 1 : 0;
Q.annual_budget_left_is_pivotal = Q.annual_budget_opposition_pivotal;
const needShare = left > 0
    ? Q.annual_budget_opposition_shortfall / left
    : 1;
Q.annual_budget_opposition_offer_strength = Q.annual_budget_opposition_pivotal
    ? Math.max(1, Math.min(3, Math.ceil(needShare * 3)))
    : 0;
Q.annual_budget_opposition_offer_made =
    Q.annual_budget_opposition_pivotal ? 1 : 0;
if (Q.annual_budget_opposition_pivotal) {
    Q.annual_budget_player_power = Math.min(
        100,
        Math.max(0, Number(Q.annual_budget_player_power) || 0) + 15
    );
}
Q.annual_budget_opposition_offer_text =
    Q.annual_budget_opposition_offer_strength >= 3
        ? "A funded public-services package, quarterly delivery register and named implementation dates"
        : (Q.annual_budget_opposition_offer_strength == 2
            ? "A funded social amendment and quarterly delivery register"
            : "A quarterly delivery register with one protected social line");
!}

= The bill belongs to the cabinet; the leverage belongs to the chamber

<div class="ledger-section ledger-section-first"><div class="ledger-title">Whip before Lewica chooses</div>
<div class="ledger-row"><span>Cabinet yes</span><b>[+ annual_budget_opposition_government_yes +]</b></div>
<div class="ledger-row"><span>Other opposition no</span><b>[+ annual_budget_opposition_other_no +]</b></div>
<div class="ledger-row"><span>Lewica controls</span><b>[+ annual_budget_opposition_left_seats +] votes</b></div>
<div class="ledger-row"><span>Government shortfall</span><b>[+ annual_budget_opposition_shortfall +]</b></div>
<div class="ledger-subrow">Coalition deputies known to be unhappy with this bill: [+ annual_budget_opposition_malcontents +].</div></div>

Frame: **Social [+ annual_budget_social_share +]% · Defence [+
annual_budget_defence_share +]% · Deficit [+ annual_budget_deficit_share +]%**.

[? if annual_budget_opposition_malcontents > 0: A coalition backbencher only
rebels when a rebellion is free. Lewica's own line therefore sets how many of
them dare to break ranks.?]

[? if annual_budget_opposition_malcontents > 0: <div class="ledger-section"><div class="ledger-title">What each Lewica line does to the cabinet's own side</div>
<div class="ledger-row"><span>Lewica votes no</span><b>[+ annual_budget_opposition_no_left_rebels +] coalition rebels · [+ annual_budget_opposition_no_left_yes +]–[+ annual_budget_opposition_no_left_no +]</b></div>
<div class="ledger-row"><span>Lewica abstains</span><b>[+ annual_budget_opposition_abstain_rebels +] coalition rebels · [+ annual_budget_opposition_abstain_yes +]–[+ annual_budget_opposition_other_no +]</b></div>
<div class="ledger-row"><span>Lewica votes yes</span><b>[+ annual_budget_opposition_support_rebels +] coalition rebels · [+ annual_budget_opposition_support_yes +]–[+ annual_budget_opposition_support_no +]</b></div>
<div class="ledger-subrow">A hard Lewica line closes the coalition's ranks; a soft one lets its malcontents protest for free.</div></div>?]

[? if annual_budget_opposition_pivotal: The cabinet cannot carry the bill
without at least some Lewica votes. It offers **[+
annual_budget_opposition_offer_text +]**. The offer is written because the
shortfall is real, not because relations are warm.?]
[? if not annual_budget_opposition_pivotal: The cabinet currently has no need
to purchase Lewica's votes. The party can still seek a monitorable amendment,
but it cannot pretend that opposition resources allocate state spending.?]

- @opposition_accept_offer
- @opposition_demand_stronger
- @opposition_monitor_abstain
- @opposition_support_without_deal
- @opposition_reject

@opposition_accept_offer
title: Accept the funded offer and supply the required votes
subtitle: The concession enters the government text; Lewica owns the bargain, not implementation.
view-if: annual_budget_opposition_pivotal = 1
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
const needed = Math.max(1, Math.round(Number(Q.annual_budget_opposition_shortfall) || 1));
const strength = Math.max(1, Math.min(3, Number(Q.annual_budget_opposition_offer_strength) || 1));
Q.annual_budget_strategy = "Conditional opposition support";
Q.annual_budget_posture = "Supply votes for a written fiscal concession";
Q.annual_budget_concession = Q.annual_budget_opposition_offer_text;
Q.annual_budget_concession_code = 7;
Q.annual_budget_concession_strength = strength;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.1 * strength) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.05 * strength) * 10
) / 10;
if (strength >= 3) Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_left_yes = Math.min(left, needed + 2);
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = Math.max(0, left - Q.annual_budget_left_yes);
Q.news_headline = "The government purchases Lewica votes with a written public-services package";
!}
go-to: opposition_roll

@opposition_demand_stronger
title: Spend one party resource and demand a fully funded social amendment
subtitle: Available only with real leverage. The stronger clause raises the social and deficit lines and receives a full Lewica whip.
view-if: annual_budget_opposition_pivotal = 1
choose-if: resources >= 1 and (annual_budget_player_power >= 40 or annual_budget_opposition_shortfall >= 5)
unavailable-subtitle: The government does not believe Lewica can sustain the stronger demand, or the party lacks a drafting team.
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
Q.resources -= 1;
Q.annual_budget_strategy = "Strong conditional opposition support";
Q.annual_budget_posture = "Vote yes for a fully funded social amendment";
Q.annual_budget_concession =
    "Funded public wages, housing and care with quarterly delivery reports";
Q.annual_budget_concession_code = 8;
Q.annual_budget_concession_strength = 3;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.5) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.2) * 10
) / 10;
Q.annual_budget_left_yes = left;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.news_headline = "Lewica forces a fully funded social amendment into the government's budget";
!}
go-to: opposition_roll

@opposition_monitor_abstain
title: Take a delivery register and abstain
subtitle: No Lewica yes votes. The cabinet must still beat the remaining no votes on its own.
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
Q.annual_budget_strategy = "Monitored abstention";
Q.annual_budget_posture = "Abstain for a statutory delivery register";
Q.annual_budget_concession =
    "Quarterly delivery register and named implementation dates";
Q.annual_budget_concession_code = 9;
Q.annual_budget_concession_strength = 1;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = left;
Q.news_headline = "Lewica takes a monitored abstention without joining the cabinet";
!}
go-to: opposition_roll

@opposition_support_without_deal
title: Support the cabinet draft for immediate stability
subtitle: No concession. Low social spending or market cuts will create a real internal cost.
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
Q.annual_budget_strategy = "Unconditional opposition support";
Q.annual_budget_posture = "Vote yes without a written concession";
Q.annual_budget_concession = "None";
Q.annual_budget_concession_code = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_left_yes = left;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.news_headline = "Lewica lends the cabinet unconditional budget support";
!}
go-to: opposition_roll

@opposition_reject
title: Vote no and leave the cabinet to find its own majority
subtitle: The defeat risk is constitutional and political; it does not transfer executive authority to Lewica.
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
Q.annual_budget_strategy = "Opposition rejection";
Q.annual_budget_posture = "Vote no";
Q.annual_budget_concession = "None";
Q.annual_budget_concession_code = 0;
Q.annual_budget_concession_strength = 0;
Q.annual_budget_negotiation_success = 0;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = left;
Q.annual_budget_left_abstain = 0;
Q.news_headline = "Lewica rejects the government's budget and records the roll call";
!}
go-to: opposition_roll

@opposition_roll
title: The government's budget reaches the Sejm
new-page: true
view-if: annual_budget_left_cabinet_authority = 0
on-arrival: {!
const rollNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const total = Math.max(1, Math.round(rollNum(Q.sejm_total, 460)));
const leftSeats = Math.max(0, Math.min(total, Math.round(rollNum(Q.left_seats, 0))));
let governmentSeats = Math.round(rollNum(Q.coalition_seats, 0));
if (governmentSeats <= 0) governmentSeats = Math.round(rollNum(Q.government_support_seats, 0));
if (governmentSeats <= 0) governmentSeats = Math.round(rollNum(Q.annual_budget_government_seats, 0));
governmentSeats = Math.max(0, Math.min(total - leftSeats, governmentSeats));
const leftYes = Math.max(
    0,
    Math.min(leftSeats, Math.round(rollNum(Q.annual_budget_left_yes, 0)))
);
const leftNo = Math.max(
    0,
    Math.min(
        leftSeats - leftYes,
        Math.round(rollNum(Q.annual_budget_left_no, 0))
    )
);
const leftAbstain = Math.max(0, leftSeats - leftYes - leftNo);
const otherOppositionNo = Math.max(0, total - governmentSeats - leftSeats);

/* Rebellion is priced by pivotality, so it is counted only after Lewica has
 * declared.  While the cabinet is safe its malcontents pay nothing for a
 * public protest; once the margin is thin the same MPs come home rather than
 * bring down their own government.  Withholding Lewica's votes is therefore
 * what buys the cabinet its discipline. */
const stress =
    rollNum(Q.government_coalition_dissent, 0) +
    (Q.caretaker_government ? 12 : 0) +
    (!Q.government_has_confidence ? 8 : 0);
const budgetModel = (typeof window !== "undefined"
    ? window : globalThis).polandBudgetModel;
let malcontents = budgetModel.malcontents(stress, governmentSeats);
if (Q.budget_rescue_attempted) {
    malcontents = Math.max(0, malcontents - 3);
}
const roll = budgetModel.rollCall({
    sejmTotal: total,
    quorum: Q.sejm_quorum_floor,
    governmentSeats: governmentSeats,
    malcontents: malcontents,
    leftYes: leftYes,
    leftNo: leftNo,
    leftAbstain: leftAbstain,
    externalNo: otherOppositionNo
});
const governmentDefections = roll.defectors;
Q.annual_budget_government_yes = roll.governmentYes;
Q.annual_budget_government_no = roll.governmentNo;
Q.annual_budget_government_abstain = roll.governmentAbstain;
Q.annual_budget_recorded_defectors = roll.defectors;
Q.annual_budget_left_yes = leftYes;
Q.annual_budget_left_no = leftNo;
Q.annual_budget_left_abstain = leftAbstain;
Q.annual_budget_yes = roll.yes;
Q.annual_budget_no = roll.no;
Q.annual_budget_abstain = roll.abstain;
Q.annual_budget_present = roll.present;
Q.annual_budget_threshold = roll.threshold;
Q.annual_budget_passed = roll.passed;
Q.annual_budget_margin = roll.margin;
Q.annual_budget_shortfall = roll.shortfall;
Q["annual_budget_done_" + Q.annual_budget_year] = 1;
Q["annual_budget_passed_" + Q.annual_budget_year] = Q.annual_budget_passed;
Q.budget_deadline_active = Q.annual_budget_passed ? 0 : 1;

/* A visible split is the opposition's actual return: the cabinet can keep
 * its budget and still lose cohesion over it. */
if (governmentDefections > 0) {
    Q.government_coalition_dissent = Math.min(
        100,
        rollNum(Q.government_coalition_dissent, 0) +
            Math.min(8, Math.ceil(governmentDefections / 3))
    );
}
Q.annual_budget_split_note = governmentDefections > 0
    ? governmentDefections + " coalition deputies broke ranks: " +
        roll.governmentNo + " against, " + roll.governmentAbstain + " abstaining."
    : (malcontents > 0
        ? "The coalition's " + malcontents + " malcontents came home. The " +
            "margin was too thin to protest against their own government."
        : "The coalition had no recorded malcontents to lose.");
!}

= Ordinary-majority roll call

<div class="ledger-section ledger-section-first"><div class="ledger-title">The government's bill</div>
<div class="ledger-row"><span>Lewica posture</span><b>[+ annual_budget_posture +]</b></div>
<div class="ledger-row"><span>Written concession</span><b>[+ annual_budget_concession +]</b></div>
<div class="ledger-row"><span>Yes</span><b>[+ annual_budget_yes +]</b></div>
<div class="ledger-row"><span>No</span><b>[+ annual_budget_no +]</b></div>
<div class="ledger-row"><span>Abstain</span><b>[+ annual_budget_abstain +]</b></div>
<div class="ledger-row"><span>Required</span><b>[+ annual_budget_threshold +]</b></div>
<div class="ledger-subrow">Cabinet bloc: [+ annual_budget_government_yes +] yes · [+ annual_budget_government_no +] no · [+ annual_budget_government_abstain +] abstain.</div>
<div class="ledger-subrow">[+ annual_budget_split_note +]</div></div>

Abstentions satisfy quorum but do not count against an ordinary bill.

- @opposition_roll_continue: Record the result

@opposition_roll_continue
view-if: annual_budget_left_cabinet_authority = 0
go-to: opposition_budget_passed if annual_budget_passed = 1; opposition_budget_failed if annual_budget_passed = 0

@opposition_budget_passed
title: The government carries its budget
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_passed = 1
on-arrival: {!
Q.annual_budget_result =
    Q.annual_budget_strategy + " — budget passed " +
    Q.annual_budget_yes + " to " + Q.annual_budget_no;
if (Q.annual_budget_negotiation_success) {
    Q.opposition_budget_audit_pending = 1;
    Q.opposition_budget_audit_done = 0;
    Q.opposition_budget_audit_year = Q.annual_budget_year;
    Q.opposition_budget_audit_fiscal_year = Q.annual_budget_fiscal_year;
    Q.opposition_budget_audit_budget_passed = 1;
    Q.opposition_budget_audit_enacted = 1;
    Q.opposition_budget_audit_priority_1_enacted = 1;
    Q.opposition_budget_audit_tactic = Q.annual_budget_strategy;
    Q.opposition_budget_audit_amendment_1 =
        Q.annual_budget_concession + " — enacted text; delivery not yet audited";
    Q.opposition_budget_audit_result = "Audit due next year";
}
Q.news_headline = Q.annual_budget_negotiation_success
    ? "The budget passes with a written Lewica concession"
    : "The government carries its budget without buying Lewica's terms";
!}

The cabinet still owns implementation. The bill now enters the same Senate
procedure as every other adopted budget; opposition involvement does not make
the upper chamber disappear.

- @senate_budget_review: Send the adopted budget to the Senate

@opposition_budget_failed
title: The government loses its budget vote
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_passed = 0
on-arrival: {!
Q.budget_deadline_active = 1;
Q.annual_budget_result =
    Q.annual_budget_strategy + " — budget defeated by " +
    Q.annual_budget_shortfall;
if (!Q.budget_rescue_attempted) {
    Q.early_election_risk += Q.caretaker_government ? 18 : 10;
    Q.public_trust -= 2;
    Q.government_coalition_dissent += 6;
} else {
    Q.early_election_risk += Q.caretaker_government ? 12 : 7;
    Q.public_trust -= 1;
    Q.government_coalition_dissent += 4;
}
Q.news_headline = Q.caretaker_government
    ? "The caretaker cabinet cannot assemble a budget majority"
    : "The government loses its budget but not an automatic confidence vote";
!}

The bill is **[+ annual_budget_shortfall +] vote(s)** short. Under Article 225,
the deadline is **[+ budget_deadline_label +]**.

- @opposition_revision_hearing
- @opposition_deadline_demand
- @opposition_hold_deadline
- @opposition_caretaker_formation

@opposition_revision_hearing
title: Hear the cabinet's one revised offer
subtitle: The cabinet returns with a funded revision while the Article 225 clock runs.
view-if: caretaker_government = 0 and budget_rescue_attempted = 0
on-arrival: {!
Q.budget_rescue_attempted = 1;
Q.annual_budget_revision_pending = 1;
Q.annual_budget_cabinet_response =
    "Cabinet offers a funded implementation line and quarterly register";
Q.news_headline = "The cabinet returns once with a funded revision and delivery register";
!}
go-to: opposition_revision_response

@opposition_revision_response
title: The revised government bill
new-page: true
view-if: annual_budget_left_cabinet_authority = 0 and annual_budget_revision_pending = 1

The first bill failed **[+ annual_budget_yes +]–[+ annual_budget_no +]**. The
cabinet now adds a small funded implementation line and a quarterly register.
It still owns expenditure authority.

- @opposition_revision_support
- @opposition_revision_abstain
- @opposition_revision_reject

@opposition_revision_support
title: Accept the funded revision and supply only the required votes
subtitle: A narrow yes vote enacts the clause and preserves Lewica's opposition role.
on-arrival: {!
const left = Math.max(0, Math.round(Number(Q.left_seats) || 0));
const needed = Math.max(1, Math.round(Number(Q.annual_budget_shortfall) || 1));
Q.annual_budget_revision_pending = 0;
Q.annual_budget_strategy = "Funded technical revision supported";
Q.annual_budget_posture = "Supply required votes on revised bill";
Q.annual_budget_concession =
    "Funded implementation line and quarterly delivery register";
Q.annual_budget_concession_strength = 2;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.2) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.1) * 10
) / 10;
Q.annual_budget_left_yes = Math.min(left, needed + 2);
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = Math.max(0, left - Q.annual_budget_left_yes);
Q.news_headline = "Lewica supplies the votes for a funded technical revision";
!}
go-to: opposition_roll

@opposition_revision_abstain
title: Accept the register and abstain on the revision
subtitle: No Lewica yes votes; the cabinet still has to beat the remaining no votes.
on-arrival: {!
Q.annual_budget_revision_pending = 0;
Q.annual_budget_strategy = "Technical revision — monitored abstention";
Q.annual_budget_posture = "Abstain on revised bill";
Q.annual_budget_concession =
    "Quarterly delivery register and fixed implementation dates";
Q.annual_budget_concession_strength = 1;
Q.annual_budget_negotiation_success = 1;
Q.annual_budget_delivery_register = 1;
Q.annual_budget_left_yes = 0;
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.news_headline = "Lewica accepts a monitored revision without supplying yes votes";
