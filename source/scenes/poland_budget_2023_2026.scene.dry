@government_social_protocol
title: Bind housing, health, labour inspection and wages into one protocol
subtitle: Cost: 3 budget capacity. Strongest Left settlement; hardest PSL–KO negotiation.
view-if: annual_budget_left_cabinet_authority = 1
choose-if: annual_budget_left_cabinet_authority = 1 and budget >= 3
unavailable-subtitle: The governing reserve cannot finance the protocol.
on-arrival: {!
Q.budget -= 3;
Q.annual_budget_strategy = "Funded social protocol";
Q.annual_budget_package_code = 1;
Q.labor_credibility += 6;
Q.progressive_credibility += 3;
Q.razem_cooperation += 5;
Q.psl_relation -= 4;
Q.ko_relation -= 2;
Q.news_headline = "The Left turns its coalition promises into costed budget lines";
!}
go-to: internal_ratification

