unavailable-subtitle: No unlocked KPO block remains for co-financing.
on-arrival: {!
Q.annual_budget_financing = "KPO co-financing";
Q.annual_budget_kpo_cofinance = 1;
Q.kpo_funds_spent = Math.max(0, Number(Q.kpo_funds_spent) || 0) + 1;
Q.kpo_uncommitted = Math.max(0, (Number(Q.kpo_uncommitted) || 0) - 1);
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 0.8) * 10
) / 10;
Q.annual_budget_projected_balance = -Q.annual_budget_deficit_share;
Q.annual_budget_demands_text +=
    "; eligible capital spending matched with KPO";
Q.news_headline = "An unlocked KPO block reduces domestic financing pressure";
!}
go-to: internal_ratification

