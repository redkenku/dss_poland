@confidence_roll
title: Confidence in the sitting prime minister
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
on-arrival: {!
const confidenceTotal = Math.max(
    1,
    Math.round(Number(Q.sejm_total) || 460)
);
let startingYes = Math.max(
    0,
    Math.min(
        confidenceTotal,
        Math.round(Number(Q.annual_budget_yes) || 0)
    )
);
let startingNo = Math.max(
    0,
    Math.min(
        confidenceTotal - startingYes,
        Math.round(Number(Q.annual_budget_no) || 0)
    )
);
let startingAbstain = Math.max(
    0,
    confidenceTotal - startingYes - startingNo
);
let confidenceRecovery = Math.max(
    0,
    4 +
    Math.round(((Number(Q.party_unity) || 0) - 50) / 10) +
    Math.round(
        (
            (Number(Q.ko_relation) || 0) +
            (Number(Q.psl_relation) || 0) +
            (Number(Q.p2050_relation) || 0) - 120
        ) / 30
    )
);
confidenceRecovery = Math.min(
    confidenceTotal - startingYes,
    confidenceRecovery
);
const confidenceFromAbstain = Math.min(
    startingAbstain,
    confidenceRecovery
);
startingAbstain -= confidenceFromAbstain;
startingYes += confidenceFromAbstain;
confidenceRecovery -= confidenceFromAbstain;
const confidenceFromNo = Math.min(startingNo, confidenceRecovery);
startingNo -= confidenceFromNo;
startingYes += confidenceFromNo;
Q.confidence_yes = startingYes;
Q.confidence_no = startingNo;
Q.confidence_abstain = startingAbstain;
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_threshold = Q.confidence_no + 1;
Q.confidence_mode =
    "Article 160 prime-ministerial confidence — simple majority";
Q.confidence_candidate = Q.prime_minister;
Q.government_has_confidence =
    Q.confidence_present >=
        Math.max(1, Number(Q.sejm_quorum_floor) || 230) &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
if (Q.government_has_confidence) {
    Q.annual_budget_result =
        "Budget defeated; cabinet retained confidence " +
        Q.confidence_yes + " to " + Q.confidence_no;
    Q.government_coalition_dissent -= 5;
    Q.early_election_risk = Math.max(0, Q.early_election_risk - 15);
    Q.budget_deadline_active = 1;
    Q.news_headline =
        "The cabinet survives confidence but still lacks an enacted budget";
} else {
    Q.coalition_broken = 1;
    Q.caretaker_government = 1;
    Q.left_in_government = 0;
    Q.formation_in_progress = 1;
    Q.budget = 0;
    Q.budget_authority =
        "Caretaker — no new governing-spend actions";
    Q.position = "Caretaker cabinet and formation talks";
    Q.coalition_status = "Prime minister lost Article 160 confidence";
    Q.coalition_seats = 0;
    Q.early_election_risk = Math.max(75, Q.early_election_risk);
    Q.annual_budget_result =
        "Budget defeated; cabinet lost confidence " +
        Q.confidence_yes + " to " + Q.confidence_no;
    Q.budget_deadline_active = 1;
    Q.news_headline =
        "The prime minister loses confidence and opens formation talks";
}
!}

= Confidence roll call

**Yes [+ confidence_yes +] · No [+ confidence_no +] · Abstain [+
confidence_abstain +]**

[? if government_has_confidence: More deputies vote yes than no. The cabinet
survives, but the defeated budget remains defeated and the deadline remains
active.?]
[? if not government_has_confidence: More deputies vote no than yes. The
cabinet becomes caretaker and a new formation sequence begins; that is not
the same as calling an election.?]

- @confidence_kept_return
- @formation_after_budget_loss

@confidence_kept_return
title: Return with the cabinet still in office
view-if: government_has_confidence = 1
go-to: return_queue

@formation_after_budget_loss
title: Begin the first constitutional formation attempt
view-if: government_has_confidence = 0 and caretaker_government = 1
on-arrival: snap_formation_context = "Cabinet loss after annual budget"; snap_formation_attempt = 1; formation_in_progress = 1; news_headline = "The caretaker cabinet enters the first constitutional formation attempt"
go-to: poland_events_2026.snap_formation_attempt_one

@return_queue
go-to: poland_event_queue
