Q.news_headline = "The Left turns the budget into a roll-call on coalition survival";
!}
go-to: internal_ratification

@internal_ratification
title: Active Left caucuses count their deputies
new-page: true
view-if: annual_budget_left_cabinet_authority = 1
call: poland_normalize
on-arrival: {!
const clampInternalBudget = function(value) {
    return Math.max(0, Math.min(100, Math.round(value)));
};
const profiles = {
    1: {
        barons: 66, spring: 86, labor: 92,
        progressives: 89, razem: 94, pps: 90
    },
    2: {
        barons: 82, spring: 70, labor: 80,
        progressives: 63, razem: 64, pps: 84
    },
    3: {
        barons: 86, spring: 46, labor: 32,
        progressives: 28, razem: 17, pps: 38
    },
    4: {
        barons: 58, spring: 68, labor: 75,
        progressives: 78, razem: 82, pps: 76
    }
};
const profile =
    profiles[Number(Q.annual_budget_package_code) || 4];
let weightedBacking = 0;
let activeStrength = 0;
let vetoes = 0;
for (const caucus of Q.factions) {
    const support = clampInternalBudget(
        profile[caucus] +
            (Number(Q.party_unity) || 0) * 0.12 -
            (Number(Q[caucus + "_dissent"]) || 0) * 0.42
    );
    const strength = Math.max(
        0,
        Number(Q[caucus + "_strength"]) || 0
    );
    Q["annual_budget_" + caucus + "_backing"] = support;
    weightedBacking += support * strength;
    activeStrength += strength;
    if (support < 35 && strength >= 2) vetoes += 1;
}
Q.annual_budget_internal_backing = Math.round(
    weightedBacking / Math.max(1, activeStrength)
);
Q.annual_budget_internal_vetoes = vetoes;
!}

= The active caucus roll call

The package receives **[+ annual_budget_internal_backing +]% weighted
backing** from the caucuses that still belong to **[+ left_party_name +]**.
There are **[+ annual_budget_internal_vetoes +] active red-line vetoes**.
Merged and departed organisations cast no votes here; their independent MPs
enter the Sejm arithmetic under their own party agreements.

- @budget_vote: Count the chamber

@opposition_shadow
title: Vote no and table a costed opposition programme
subtitle: The normal opposition line: all Lewica deputies vote no.
view-if: annual_budget_left_cabinet_authority = 0
on-arrival: {!
Q.annual_budget_strategy = "Costed opposition programme";
Q.annual_budget_posture = "Oppose";
Q.annual_budget_left_no = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.party_unity += 3;
Q.labor_credibility += 3;
Q.media_capacity += 2;
Q.ko_relation -= Q.government_party == "ko" ? 3 : 1;
Q.pis_relation -= Q.government_party == "pis" ? 3 : 1;
Q.news_headline =
    "Lewica rejects the government's budget and prices its alternative";
!}
go-to: opposition_roll

@opposition_bargain
title: Propose one written amendment, then decide the vote
subtitle: First choose the demand; after the cabinet answers, choose no, abstention or conditional support.
view-if: annual_budget_left_cabinet_authority = 0
go-to: opposition_bargaining_table

@opposition_tolerate
title: Abstain with no deal and let the cabinet own the bill
subtitle: The bill gets no Lewica yes votes and Lewica receives no policy concession.
view-if: annual_budget_left_cabinet_authority = 0
on-arrival: {!
Q.annual_budget_strategy = "Unconditional toleration";
Q.annual_budget_posture = "Abstain";
Q.annual_budget_left_abstain = Math.max(
    0,
    Math.round(Number(Q.left_seats) || 0)
);
Q.party_unity -= 4;
Q.razem_dissent += 7;
Q.barons_dissent -= 2;
Q.public_trust += Q.caretaker_government ? 1 : -1;
if (Q.government_party == "pis") Q.pis_relation += 3;
else if (Q.government_party == "ko") Q.ko_relation += 3;
else if (Q.government_party == "psl") Q.psl_relation += 3;
else Q.p2050_relation += 3;
Q.news_headline =
    "Lewica abstains for stability and receives no policy concession";
!}
go-to: opposition_roll

@opposition_bargaining_table
title: The price of opposition votes
new-page: true
view-if: annual_budget_left_cabinet_authority = 0

= A bounded negotiation, not a shadow cabinet

Current leverage is **[+ negotiation_leverage +]/100**. Government hostility
is **[+ government_negotiation_hostility +]/100**.

Every option states its score and threshold. A party-resource cost represents
drafting, negotiations and post-vote monitoring. No state programme begins
unless the cabinet accepts the clause **and its budget actually passes**.

- @opposition_social_floor
- @opposition_oversight
- @opposition_support_pact
- @opposition_bargain_walk

@opposition_social_floor
title: Offer abstention for a wage, care and housing floor
subtitle: Cost: 1 resource · score +10 · requires 58 under PiS, 46 otherwise.
view-if: annual_budget_left_cabinet_authority = 0
choose-if: annual_budget_left_cabinet_authority = 0 and resources >= 1
unavailable-subtitle: A costed amendment and monitoring team require one party resource.
on-arrival: {!
Q.resources -= 1;
Q.negotiation_attempts += 1;
Q.negotiation_last_score =
    Math.round((Number(Q.negotiation_leverage) || 0) + 10);
Q.negotiation_last_threshold =
    Q.government_party == "pis" ? 58 : 46;
Q.annual_budget_negotiation_outcome =
    Q.negotiation_last_score >= Q.negotiation_last_threshold
        ? 2
        : (
            Q.negotiation_last_score >=
                Q.negotiation_last_threshold - 8
                ? 1
                : 0
        );
Q.annual_budget_negotiation_success =
    Q.annual_budget_negotiation_outcome > 0 ? 1 : 0;
Q.negotiation_success = Q.annual_budget_negotiation_success;
Q.annual_budget_strategy =
    Q.annual_budget_negotiation_outcome == 2
        ? "Full social-floor offer"
        : (
            Q.annual_budget_negotiation_outcome == 1
                ? "Narrow social-floor counteroffer"
                : "Social-floor offer refused"
        );
Q.annual_budget_concession =
    Q.annual_budget_negotiation_outcome == 2
        ? "Written wage, care and housing floor"
        : (
            Q.annual_budget_negotiation_outcome == 1
                ? "Narrow wage floor and care-delivery report"
                : "None — government refused the social floor"
        );
Q.annual_budget_concession_code =
    Q.annual_budget_negotiation_success ? 1 : 0;
Q.annual_budget_concession_strength =
    Q.annual_budget_negotiation_outcome;
Q.annual_budget_posture = "Decision pending";
Q.annual_budget_cabinet_response =
    Q.annual_budget_negotiation_outcome == 2
        ? "Cabinet accepts the full social-floor amendment"
        : (
            Q.annual_budget_negotiation_outcome == 1
                ? "Cabinet offers a narrower, enforceable social floor"
                : "Cabinet rejects the social-floor amendment"
        );
Q.negotiation_last_result = Q.annual_budget_cabinet_response;
if (Q.annual_budget_negotiation_success) {
    Q.negotiation_successes += 1;
    Q.negotiation_capital += 2;
    Q.public_trust += 1;
} else {
    Q.negotiation_capital -= 1;
    Q.public_trust -= 1;
}
Q.news_headline = Q.negotiation_last_result;
!}
go-to: opposition_negotiation_result

@opposition_oversight
