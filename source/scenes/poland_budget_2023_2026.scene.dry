    Math.round(Number(Q.left_seats) || 0)
);
Q.annual_budget_left_no = 0;
Q.annual_budget_left_abstain = 0;
Q.party_unity -= 5;
Q.razem_dissent += 8;
Q.barons_dissent -= 3;
if (Q.government_party == "pis") Q.pis_relation += 4;
else if (Q.government_party == "ko") Q.ko_relation += 4;
else if (Q.government_party == "psl") Q.psl_relation += 4;
else Q.p2050_relation += 4;
Q.news_headline =
    "Lewica signs the full amendment and whips conditional yes votes";
!}
go-to: opposition_roll

