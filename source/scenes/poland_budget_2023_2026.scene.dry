new-page: true
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_passed = 0 and annual_budget_vote_round = 1
on-arrival: {!
Q.budget_deadline_active = 1;
Q.coalition_break_threat = 1;
Q.government_coalition_dissent += 10;
Q.public_trust -= 3;
Q.early_election_risk += 15;
Q.news_headline = "Budget defeat opens one revision window without dismissing the cabinet";
!}
go-to: confidence_council

@confidence_council
title: Budget defeat — the locked rooms reopen
new-page: true
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_vote_round = 1

= Revision is not confidence; confidence is not dissolution

The first text failed **[+ annual_budget_yes +]–[+ annual_budget_no +]**. The
cabinet may write one materially different bill. Every revision changes the
fiscal frame and returns through the party and coalition whips. A new majority
must be negotiated from the MPs and clubs whose demands the first text failed
to satisfy.

The Article 225 clock expires in **[+ budget_deadline_label +]**.

- @confidence_psl_deal
- @confidence_left_redline
- @confidence_technical_revision
- @confidence_article160
- @confidence_resign
- @confidence_snap

@confidence_psl_deal
title: Write the county compact into an emergency revision
subtitle: Cost: 2 governing-capacity points. Raises local/social investment and deficit; may recover PSL or county-oriented votes.
choose-if: budget >= 2
unavailable-subtitle: The cabinet cannot finance and administer the emergency county compact.
on-arrival: {!
const pslOutside = Q.government_party != "psl" && !Q.ministry_psl_in_cabinet;
const seats = Math.max(0, Math.round(Number(Q.psl_seats) || 0));
const relation = Math.max(0, Math.min(100, Number(Q.psl_relation) || 25));
Q.budget -= 2;
Q.budget_rescue_attempted = 1;
Q.annual_budget_rescue_used = 1;
Q.annual_budget_vote_round = 2;
Q.annual_budget_rescue_kind = "Emergency county compact";
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_local_compact = 1;
Q.annual_budget_reconstruction_fund = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.2) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.2) * 10
) / 10;
if (pslOutside) {
    Q.annual_budget_external_deal_target = "psl";
    Q.annual_budget_external_votes_committed = Math.max(
        Number(Q.annual_budget_external_votes_committed) || 0,
        Math.min(
            seats,
            Math.max(1, Math.round(seats * (0.40 + relation / 250)))
        )
    );
}
Q.psl_relation += 10;
Q.government_coalition_dissent = Math.max(
    0,
    Number(Q.government_coalition_dissent) - 6
);
Q.annual_budget_concession =
    "Emergency county capital compact with published project dates";
Q.news_headline = "The defeated budget returns with a funded county compact";
!}
go-to: internal_ratification

@confidence_left_redline
title: Rebuild the revision around public wages, housing and care
subtitle: Raises social spending and deficit; external Razem or labour MPs can support what is actually written.
on-arrival: {!
const razemOutside = !Q.razem_in_government;
const seats = Math.max(0, Math.round(Number(Q.razem_seats) || 0));
Q.budget_rescue_attempted = 1;
Q.annual_budget_rescue_used = 1;
Q.annual_budget_vote_round = 2;
Q.annual_budget_rescue_kind = "Funded Left revision";
Q.annual_budget_external_deal_used = 1;
Q.annual_budget_public_wage_guarantee = 1;
Q.annual_budget_market_cuts = 0;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) + 0.5) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) + 0.3) * 10
) / 10;
if (razemOutside && seats > 0) {
    Q.annual_budget_external_deal_target = "razem";
    Q.annual_budget_external_votes_committed = Math.max(
        Number(Q.annual_budget_external_votes_committed) || 0,
        Math.min(seats, Math.max(1, Number(Q.annual_budget_shortfall) + 2))
    );
}
Q.annual_budget_concession =
    "Funded public wages, housing and care in the revised text";
Q.party_unity += 2;
Q.labor_credibility += 3;
Q.ko_relation -= 3;
Q.psl_relation -= 3;
Q.news_headline = "The cabinet rewrites the defeated budget around a funded Left protocol";
!}
go-to: internal_ratification

@confidence_technical_revision
