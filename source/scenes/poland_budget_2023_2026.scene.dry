    Math.max(14, Number(Q.annual_budget_social_share) - 0.7) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    Math.max(2.5, Number(Q.annual_budget_deficit_share) - 1.0) * 10
) / 10;
Q.annual_budget_concession =
    "Hard deficit rule and removal of disputed discretionary lines";
Q.ko_relation += 5;
Q.psl_relation += 4;
Q.p2050_relation += 4;
