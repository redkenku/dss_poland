@senate_budget_review
title: The Senate amends; it does not reject
new-page: true
call: poland_senate.refresh
view-if: annual_budget_passed = 1 and annual_budget_senate_stage_done = 0
on-arrival: {!
const senateNum = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const senateRound = function(value) {
    return Math.round(Number(value) * 10) / 10;
};
const senateTotal = Math.max(1, Math.round(senateNum(Q.senate_total, 100)));
const independents = Math.max(
    0,
    Math.min(senateTotal, Math.round(senateNum(Q.senate_independent_seats, 0)))
);
const inCabinet = function(id) {
    if (id == "left") return Boolean(Q.left_in_government);
    return Q.government_party == id || Boolean(Q["ministry_" + id + "_in_cabinet"]);
};
const senateSeats = function(id) {
    return Math.max(0, Math.round(senateNum(Q["senate_" + id + "_seats"], 0)));
};
let cabinetVotes = 0;
for (const id of ["pis", "ko", "psl", "p2050", "left", "konf"]) {
    if (inCabinet(id)) cabinetVotes += senateSeats(id);
}
const cohesion = Math.max(0, Math.min(100, senateNum(Q.senate_cohesion, 50)));
const independentGovernmentVotes = Math.round(independents * cohesion / 100);
cabinetVotes = Math.max(
    0,
    Math.min(senateTotal, cabinetVotes + independentGovernmentVotes)
);
const hostileVotes = Math.max(0, senateTotal - cabinetVotes);
const senateMajority = Math.floor(senateTotal / 2) + 1;
Q.annual_budget_senate_government_votes = cabinetVotes;
Q.annual_budget_senate_hostile_votes = hostileVotes;
Q.annual_budget_senate_corrections_pending =
    hostileVotes >= senateMajority ? 1 : 0;

let amendmentLeader = "none";
let amendmentLeaderSeats = -1;
for (const id of ["pis", "ko", "psl", "p2050", "left", "konf"]) {
    if (inCabinet(id)) continue;
    const seats = senateSeats(id);
    if (seats > amendmentLeaderSeats) {
        amendmentLeader = id;
        amendmentLeaderSeats = seats;
    }
}
Q.annual_budget_senate_amendment_leader = amendmentLeader;
const senateLeaderNames = {
    pis: "PiS", ko: "KO", psl: "PSL", p2050: "Polska 2050",
    left: "Lewica", konf: "Konfederacja", none: "None"
};
Q.annual_budget_senate_amendment_leader_name =
    senateLeaderNames[amendmentLeader] || amendmentLeader;
Q.annual_budget_senate_correction_strength =
    Q.annual_budget_senate_corrections_pending
        ? Math.max(
            1,
            Math.min(3, 1 + Math.floor((hostileVotes - senateMajority) / 8))
        )
        : 0;
const scale = 1 + Math.max(0, Q.annual_budget_senate_correction_strength - 1) * 0.35;
let deltaSocial = 0;
let deltaDefence = 0;
let deltaDeficit = 0;
let correction = "No amendment package adopted";
let flag = "none";
if (Q.annual_budget_senate_corrections_pending) {
    if (amendmentLeader == "pis") {
        deltaSocial = 0.2 * scale;
        deltaDefence = 0.2 * scale;
        deltaDeficit = 0.3 * scale;
        correction = "family transfers, domestic defence procurement and county investment";
        flag = "family_defence";
    } else if (amendmentLeader == "ko") {
        deltaSocial = 0.1 * scale;
        deltaDeficit = -0.3 * scale;
        correction = "green municipal investment, delivery reports and a lower deficit ceiling";
        flag = "green_register";
    } else if (amendmentLeader == "psl") {
        deltaSocial = 0.2 * scale;
        deltaDefence = 0.1 * scale;
        deltaDeficit = 0.2 * scale;
        correction = "county roads, agricultural investment and local co-financing";
        flag = "local";
    } else if (amendmentLeader == "p2050") {
        deltaSocial = 0.2 * scale;
        deltaDeficit = -0.2 * scale;
        correction = "green public investment and a statutory implementation register";
        flag = "green_register";
    } else if (amendmentLeader == "left") {
        deltaSocial = 0.4 * scale;
        deltaDefence = -0.1 * scale;
        deltaDeficit = 0.2 * scale;
        correction = "public wages, care and municipal housing";
        flag = "wages";
    } else if (amendmentLeader == "konf") {
        deltaSocial = -0.2 * scale;
        deltaDeficit = -0.3 * scale;
        correction = "subsidy cuts, deregulation and a lower deficit ceiling";
        flag = "market";
    }
}
Q.annual_budget_senate_delta_social = senateRound(deltaSocial);
Q.annual_budget_senate_delta_defence = senateRound(deltaDefence);
Q.annual_budget_senate_delta_deficit = senateRound(deltaDeficit);
Q.annual_budget_senate_correction = correction;
Q.annual_budget_senate_correction_flag = flag;
Q.annual_budget_senate_result = Q.annual_budget_senate_corrections_pending
    ? "The Senate adopted " + correction
    : "The Senate returned the budget without amendments";
Q.senate_last_vote = Q.annual_budget_senate_result;
Q.budget_deadline_active = 1;
!}

= Twenty days in the upper chamber

<div class="ledger-section ledger-section-first"><div class="ledger-title">Senate alignment</div>
<div class="ledger-row"><span>Government-aligned</span><b>[+ annual_budget_senate_government_votes +]</b></div>
<div class="ledger-row"><span>Outside the cabinet</span><b>[+ annual_budget_senate_hostile_votes +]</b></div>
<div class="ledger-row"><span>Amendment leader</span><b>[+ annual_budget_senate_amendment_leader_name +]</b></div></div>

[? if annual_budget_senate_corrections_pending: The Senate adopts **[+
annual_budget_senate_correction +]**. If incorporated, the final frame changes
by **social [+ annual_budget_senate_delta_social +] · defence [+
annual_budget_senate_delta_defence +] · deficit [+
annual_budget_senate_delta_deficit +]** points of GDP. The Sejm may reject the
package only by an absolute majority with quorum.?]
[? if not annual_budget_senate_corrections_pending: No majority adopts an
amendment. The Senate cannot reject or veto the budget; the unchanged text
proceeds to signature.?]

- @senate_budget_accept
- @senate_budget_compromise
- @senate_budget_override
- @senate_budget_opposition_resolution
- @senate_budget_unchanged

@senate_budget_accept
title: Incorporate the Senate amendment package
subtitle: The amendments alter the final fiscal frame; no second Sejm whip is required.
view-if: annual_budget_left_cabinet_authority = 1 and annual_budget_senate_corrections_pending = 1
on-arrival: {!
Q.annual_budget_senate_stage_done = 1;
Q.annual_budget_senate_corrections_accepted = 1;
Q.annual_budget_social_share = Math.round(
    (Number(Q.annual_budget_social_share) +
        Number(Q.annual_budget_senate_delta_social)) * 10
) / 10;
Q.annual_budget_defence_share = Math.round(
    (Number(Q.annual_budget_defence_share) +
        Number(Q.annual_budget_senate_delta_defence)) * 10
) / 10;
Q.annual_budget_deficit_share = Math.round(
    (Number(Q.annual_budget_deficit_share) +
        Number(Q.annual_budget_senate_delta_deficit)) * 10
) / 10;
if (Q.annual_budget_senate_correction_flag == "wages") {
    Q.annual_budget_public_wage_guarantee = 1;
}
if (Q.annual_budget_senate_correction_flag == "local") {
    Q.annual_budget_local_compact = 1;
}
if (Q.annual_budget_senate_correction_flag == "green_register") {
    Q.annual_budget_green_investment = 1;
    Q.annual_budget_delivery_register = 1;
    Q.annual_budget_deficit_rule = 1;
}
if (Q.annual_budget_senate_correction_flag == "family_defence") {
    Q.annual_budget_family_defence_deal = 1;
}
if (Q.annual_budget_senate_correction_flag == "market") {
    Q.annual_budget_market_cuts = 1;
    Q.annual_budget_deficit_rule = 1;
}
Q.annual_budget_senate_result = "Government incorporated the Senate amendments";
Q.annual_budget_result += " — Senate amendments incorporated";
Q.news_headline = "The cabinet incorporates a Senate amendment package into the final budget";
!}
go-to: budget_enact

