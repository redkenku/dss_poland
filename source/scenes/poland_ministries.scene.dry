title: Cabinet portfolios
new-page: true
on-arrival: {!
const model = String(Q.left_cabinet_model || "");
const mode = String(Q.ministry_allocation_mode || "formation");
const preserveExisting =
    mode == "reshuffle" || mode == "event_reshuffle";
const maximalMandate =
    model == "Programme-bound Left cabinet entry" ||
    model == "Programme-bound cooperating Left entry";
const wholeLeftMandate =
    model == "Whole Left coalition delegation" ||
    model == "Whole cooperating Left coalition delegation";
const baseLeverage =
    maximalMandate ? 18 :
    wholeLeftMandate ? 16 :
    model == "New Left ministers · Razem external support" ? 13 :
    (Q.left_cabinet_committed ? 13 : 0);
const pslInCabinet =
    Math.max(0, Number(Q.psl_seats) || 0) > 0 &&
    !Q.coalition_broken;
const p2050InCabinet =
    Math.max(0, Number(Q.p2050_seats) || 0) > 0;
const defaults = {
    labor: ["KO", "Coalition social-policy nominee"],
    equality: ["KO", "Coalition equality nominee"],
    housing: ["KO", "Coalition housing nominee"],
    health: ["KO", "Izabela Leszczyna"],
    digital: p2050InCabinet
        ? ["Poland 2050", "Coalition digital nominee"]
        : ["KO", "Coalition digital nominee"],
    science: ["KO", "Coalition science nominee"],
    interior: ["KO", "Marcin Kierwiński"],
    finance: ["KO", "Andrzej Domański"],
    economy: pslInCabinet
        ? ["PSL", "Krzysztof Hetman"]
        : ["KO", "Coalition development nominee"],
    justice: ["KO", "Adam Bodnar"],
    foreign: ["KO", "Radosław Sikorski"],
    agriculture: pslInCabinet
        ? ["PSL", "Czesław Siekierski"]
        : ["KO", "Coalition agriculture nominee"],
    defence: pslInCabinet
        ? ["PSL", "Władysław Kosiniak-Kamysz"]
        : ["KO", "Coalition defence nominee"]
};
const costs = {
    labor: 5,
    equality: 3,
    housing: 6,
    health: 7,
    digital: 4,
    science: 4,
    interior: 5,
    finance: 10,
    economy: 10,
    justice: 10,
    foreign: 10,
    agriculture: 10,
    defence: 15
};
const portfolios = Object.keys(defaults);

Q.ministries_finalized = 0;
Q.ministry_maximal_mandate = maximalMandate ? 1 : 0;
Q.ministry_whole_left_mandate = wholeLeftMandate ? 1 : 0;
Q.ministry_base_leverage = baseLeverage;
Q.ministry_reshuffle_changes = 0;

for (const portfolio of portfolios) {
    const partyKey = portfolio + "_minister_party";
    const ministerKey = portfolio + "_minister";
    const missing =
        typeof Q[partyKey] != "string" ||
        !Q[partyKey].length ||
        Q[partyKey] == "Unassigned";
    if (!preserveExisting || missing) {
        Q[partyKey] = defaults[portfolio][0];
        Q[ministerKey] = defaults[portfolio][1];
    }
}
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;

Q.ministry_count = portfolios.reduce(function(total, portfolio) {
    return total +
        (Q[portfolio + "_minister_party"] == "Lewica" ? 1 : 0);
}, 0);
const investedLeverage = portfolios.reduce(function(total, portfolio) {
    return total +
        (Q[portfolio + "_minister_party"] == "Lewica"
            ? costs[portfolio]
            : 0);
}, 0);
Q.ministry_leverage = preserveExisting
    ? Math.max(0, baseLeverage - investedLeverage)
    : baseLeverage;
if (preserveExisting) {
    Q.ministry_reshuffle_previous_count = Q.ministry_count;
}
!}
go-to: menu if left_cabinet_committed = 1; opposition_allocation if left_cabinet_committed = 0

@menu
title: Allocate the whole cabinet
new-page: true

= The cabinet table

Lewica has **[+ ministry_leverage +] leverage**. Every portfolio below has its
own Government Affairs card when Lewica controls it. Untaken offices remain
with the named coalition partner.

[? if ministry_allocation_mode = "reshuffle" or ministry_allocation_mode =
"event_reshuffle": This is a live reshuffle. Existing Lewica offices remain in
place; return one to recover its leverage, then bargain for another.?]

KO treats Finance and Foreign Affairs as senior claims. Finance opens only
under the strongest programme-bound mandate; Foreign Affairs also needs a
broad, credible Left delegation. PSL treats Agriculture as a hard coalition
red line. Defence is available only in an exceptionally strong negotiation.

<div class="ministry-grid">
<div><span>Labour & Social Policy</span><b>[+ labor_minister_party +] · [+ labor_minister +]</b></div>
<div><span>Equality</span><b>[+ equality_minister_party +] · [+ equality_minister +]</b></div>
<div><span>Housing</span><b>[+ housing_minister_party +] · [+ housing_minister +]</b></div>
<div><span>Health</span><b>[+ health_minister_party +] · [+ health_minister +]</b></div>
<div><span>Digital Affairs</span><b>[+ digital_minister_party +] · [+ digital_minister +]</b></div>
<div><span>Science</span><b>[+ science_minister_party +] · [+ science_minister +]</b></div>
<div><span>Interior & Administration</span><b>[+ interior_minister_party +] · [+ interior_minister +]</b></div>
<div><span>Finance</span><b>[+ finance_minister_party +] · [+ finance_minister +]</b></div>
<div><span>Development & Technology</span><b>[+ economy_minister_party +] · [+ economy_minister +]</b></div>
<div><span>Justice</span><b>[+ justice_minister_party +] · [+ justice_minister +]</b></div>
<div><span>Foreign Affairs</span><b>[+ foreign_minister_party +] · [+ foreign_minister +]</b></div>
<div><span>Agriculture & Rural Development</span><b>[+ agriculture_minister_party +] · [+ agriculture_minister +]</b></div>
<div><span>National Defence</span><b>[+ defence_minister_party +] · [+ defence_minister +]</b></div>
</div>

- #poland_ministry_take
- #poland_ministry_drop
- @finalize

