@drop_labor
title: Return Labour & Social Policy
tags: poland_ministry_drop
view-if: labor_minister_party = "Lewica"
on-arrival: ministry_leverage += 5; ministry_count -= 1; labor_minister_party = "KO"; labor_minister = "Coalition nominee"
go-to: menu

