title: Cabinet portfolios
new-page: true
on-arrival: {!
Q.ministries_finalized = 0;
Q.ministry_count = 0;
Q.ministry_leverage =
    Q.left_cabinet_model == "Programme-bound Left cabinet entry" ? 18 :
    Q.left_cabinet_model == "Whole Left coalition delegation" ? 16 :
    Q.left_cabinet_model == "New Left ministers · Razem external support" ? 13 :
    0;

Q.labor_minister_party = "KO";
Q.labor_minister = "Coalition nominee";
Q.equality_minister_party = "KO";
Q.equality_minister = "Coalition nominee";
Q.housing_minister_party = "KO";
Q.housing_minister = "Coalition nominee";
Q.health_minister_party = "KO";
Q.health_minister = "Coalition nominee";
Q.digital_minister_party = "Poland 2050";
Q.digital_minister = "Coalition nominee";
Q.science_minister_party = "KO";
Q.science_minister = "Coalition nominee";
!}
go-to: menu if left_cabinet_committed = 1; opposition_allocation if left_cabinet_committed = 0

@menu
title: Allocate Lewica's ministries
new-page: true

= Ministries

Lewica has **[+ ministry_leverage +] leverage**. Several portfolios unlock
government cards in their policy area; the rest shape the cabinet record.

<div class="ministry-grid">
<div><span>Labour & Social Policy</span><b>[+ labor_minister_party +] · [+ labor_minister +]</b></div>
<div><span>Equality</span><b>[+ equality_minister_party +] · [+ equality_minister +]</b></div>
<div><span>Housing</span><b>[+ housing_minister_party +] · [+ housing_minister +]</b></div>
<div><span>Health</span><b>[+ health_minister_party +] · [+ health_minister +]</b></div>
<div><span>Digital Affairs</span><b>[+ digital_minister_party +] · [+ digital_minister +]</b></div>
<div><span>Science</span><b>[+ science_minister_party +] · [+ science_minister +]</b></div>
</div>

- #poland_ministry_take
- #poland_ministry_drop
- @finalize

@take_labor
title: Take Labour & Social Policy
subtitle: 5 leverage · Agnieszka Dziemianowicz-Bąk
tags: poland_ministry_take
view-if: labor_minister_party != "Lewica"
choose-if: ministry_leverage >= 5
unavailable-subtitle: Requires five leverage.
on-arrival: ministry_leverage -= 5; ministry_count += 1; labor_minister_party = "Lewica"; labor_minister = "Agnieszka Dziemianowicz-Bąk"
go-to: menu

