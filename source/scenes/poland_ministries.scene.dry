@finalize
title: Finalise the cabinet allocation
subtitle: Unspent leverage buys goodwill from actual cabinet partners; taking only a token office can anger the Left.
choose-if: ministry_count >= 1 and ministry_leverage_debt = 0
unavailable-subtitle: A governing Lewica delegation must take at least one portfolio and clear all leverage debt.
on-arrival: {!
const finiteMinistry = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const normalizePartyCode = function(value) {
    const text = String(value || "").trim().toLowerCase();
    if (text == "pis") return "pis";
    if (text == "ko" || text.includes("obywatelsk")) return "ko";
    if (text == "psl") return "psl";
    if (text == "p2050" || text.includes("2050")) return "p2050";
    if (text == "lewica" || text == "left" || text.includes("lewica")) return "lewica";
    if (text == "cabinet" || text == "independent") return "cabinet";
    return "";
};
const finalPortfolioKeys = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
const finalCosts = {
    labor: 5, equality: 3, housing: 6, health: 7, digital: 4,
    science: 4, interior: 5, finance: 10, economy: 10,
    justice: 10, foreign: 10, agriculture: 10, defence: 15
};
const isLeftOffice = function(portfolio) {
    return normalizePartyCode(Q[portfolio + "_minister_party"]) == "lewica";
};
Q.ministry_count = finalPortfolioKeys.reduce(function(total, portfolio) {
    return total + (isLeftOffice(portfolio) ? 1 : 0);
}, 0);
Q.ministry_invested_leverage = finalPortfolioKeys.reduce(
    function(total, portfolio) {
        return total + (isLeftOffice(portfolio) ? finalCosts[portfolio] : 0);
    },
    0
);
const unspent = Math.max(0, finiteMinistry(Q.ministry_leverage, 0));
const expectedValue = Math.max(
    3,
    finiteMinistry(Q.ministry_minimum_expected_value, 3)
);
const socialCore = ["labor", "housing", "health"].filter(isLeftOffice).length;
const rightsCore = ["equality", "justice"].filter(isLeftOffice).length;
const economicCore = ["finance", "economy"].filter(isLeftOffice).length;
Q.ministry_underclaim_penalty = 0;
if (finiteMinistry(Q.ministry_base_leverage, 0) >= 15 && socialCore == 0) {
    if (!Q.labor_party_formed) Q.labor_dissent = finiteMinistry(Q.labor_dissent, 0) + 4;
    if (!Q.razem_party_formed) Q.razem_dissent = finiteMinistry(Q.razem_dissent, 0) + 3;
    if (!Q.pps_party_formed) Q.pps_dissent = finiteMinistry(Q.pps_dissent, 0) + 3;
    Q.party_unity = finiteMinistry(Q.party_unity, 50) - 2;
    Q.ministry_underclaim_penalty += 2;
}
if (finiteMinistry(Q.ministry_base_leverage, 0) >= 12 && rightsCore == 0) {
    if (!Q.progressives_party_formed) Q.progressives_dissent = finiteMinistry(Q.progressives_dissent, 0) + 3;
    if (!Q.spring_party_formed) Q.spring_dissent = finiteMinistry(Q.spring_dissent, 0) + 2;
    Q.ministry_underclaim_penalty += 1;
}
if (
    Q.ministry_invested_leverage < expectedValue ||
    (Q.ministry_count == 1 && finiteMinistry(Q.ministry_base_leverage, 0) >= 18)
) {
    const tokenPenalty = Math.min(
        4,
        Math.max(1, Math.floor(unspent / 7))
    );
    Q.party_unity = finiteMinistry(Q.party_unity, 50) - tokenPenalty;
    Q.barons_dissent = finiteMinistry(Q.barons_dissent, 0) + Math.min(3, tokenPenalty);
    Q.ministry_underclaim_penalty += tokenPenalty;
}
if (socialCore >= 2) {
    Q.labor_dissent = Math.max(0, finiteMinistry(Q.labor_dissent, 0) - 2);
    Q.razem_dissent = Math.max(0, finiteMinistry(Q.razem_dissent, 0) - 1);
}
if (rightsCore >= 1) {
    Q.progressives_dissent = Math.max(
        0,
        finiteMinistry(Q.progressives_dissent, 0) - 1
    );
    Q.spring_dissent = Math.max(0, finiteMinistry(Q.spring_dissent, 0) - 1);
}
if (economicCore >= 1) {
    Q.barons_dissent = Math.max(0, finiteMinistry(Q.barons_dissent, 0) - 1);
}

const partnerCodes = [];
if (Q.ministry_pis_in_cabinet) partnerCodes.push("pis");
if (Q.ministry_ko_in_cabinet) partnerCodes.push("ko");
if (Q.ministry_p2050_in_cabinet) partnerCodes.push("p2050");
if (Q.ministry_psl_in_cabinet) partnerCodes.push("psl");
const goodwillPool = Math.floor(unspent / 3);
const goodwillEach = partnerCodes.length
    ? Math.floor(goodwillPool / partnerCodes.length)
    : 0;
for (const code of partnerCodes) {
    if (goodwillEach > 0) {
        Q[code + "_relation"] = finiteMinistry(Q[code + "_relation"], 0) +
            goodwillEach;
        Q[code + "_coalition_dissent"] = Math.max(
            0,
            finiteMinistry(Q[code + "_coalition_dissent"], 0) -
                Math.max(1, Math.floor(goodwillEach / 2))
        );
    }
}
Q.government_coalition_dissent = Math.max(
    0,
    finiteMinistry(Q.government_coalition_dissent, 0) -
        Math.floor(goodwillPool / 2)
);

for (const portfolio of finalPortfolioKeys) {
    const currentCode = normalizePartyCode(Q[portfolio + "_minister_party"]);
    if (currentCode == "lewica") {
        Q["ministry_" + portfolio + "_source_party_code"] = String(
            Q["ministry_" + portfolio + "_taken_from_code"] ||
            Q["ministry_" + portfolio + "_source_party_code"] ||
            Q["ministry_" + portfolio + "_baseline_owner_code"] ||
            "cabinet"
        );
    } else {
        Q["ministry_" + portfolio + "_source_party_code"] =
            currentCode || "cabinet";
    }
}
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;
Q.ministries_finalized = 1;
Q.cabinet_roster_finalized = 1;
Q.cabinet_roster_government_party =
    normalizePartyCode(Q.government_party) || Q.ministry_cabinet_leader_code;
Q.cabinet_roster_prime_minister = String(Q.prime_minister || "");
Q.cabinet_roster_date = String(Q.date_label || "");
Q.cabinet_roster_left_portfolios = Q.ministry_count;
Q.cabinet_commitments_recorded = 1;

if (Q.ministry_return_mode == "pis_coalition") {
    Q.news_headline =
        "The PiS agreement gives Lewica " +
        Q.ministry_count + " cabinet portfolios";
} else if (
    Q.ministry_return_mode == "card_finish" ||
    Q.ministry_return_mode == "event_queue"
) {
    Q.news_headline =
        "The reshuffle leaves Lewica with " +
        Q.ministry_count + " cabinet portfolios";
} else {
    Q.news_headline =
        "Lewica takes " + Q.ministry_count +
        " cabinet portfolios from an explicit coalition settlement";
}
Q.ministry_leverage = 0;
Q.ministry_leverage_debt = 0;
Q.ministry_allocation_mode = "settled";
!}
go-to: poland_events_2021_2023.aug21_cabinet_result if ministry_return_mode = "pis_coalition"; poland_card_finish if ministry_return_mode = "card_finish"; poland_event_queue if ministry_return_mode = "event_queue"; poland_government_formation.governing_agreement if ministry_return_mode = "governing_agreement"; poland_government_formation.cabinet_program if ministry_return_mode != "pis_coalition" and ministry_return_mode != "card_finish" and ministry_return_mode != "event_queue" and ministry_return_mode != "governing_agreement"

@opposition_allocation
title: Confidence without ministries
new-page: true
on-arrival: {!
const normalizePartyCode = function(value) {
    const text = String(value || "").trim().toLowerCase();
    if (text == "pis") return "pis";
    if (text == "ko" || text.includes("obywatelsk")) return "ko";
    if (text == "psl") return "psl";
    if (text == "p2050" || text.includes("2050")) return "p2050";
    if (text == "lewica" || text == "left" || text.includes("lewica")) return "lewica";
    return "";
};
Q.ministries_finalized = 1;
Q.ministry_count = 0;
Q.ministry_leverage = 0;
Q.ministry_leverage_debt = 0;
Q.ministry_allocation_mode = "settled";
Q.cabinet_roster_finalized = 1;
Q.cabinet_roster_government_party =
    normalizePartyCode(Q.government_party) || Q.ministry_cabinet_leader_code;
Q.cabinet_roster_prime_minister = String(Q.prime_minister || "");
Q.cabinet_roster_date = String(Q.date_label || "");
Q.cabinet_roster_left_portfolios = 0;
!}

= No ministries

Lewica promised confidence and supply, not cabinet service. The parties that
explicitly accepted cabinet responsibility allocate the portfolios recorded
above; a confidence vote alone does not make every supporting party a ministerial
partner.

- @opposition_allocation_continue: Continue

@opposition_allocation_continue
go-to: poland_events_2021_2023.aug21_cabinet_result if ministry_return_mode = "pis_coalition"; poland_card_finish if ministry_return_mode = "card_finish"; poland_event_queue if ministry_return_mode = "event_queue"; poland_government_formation.governing_agreement if ministry_return_mode = "governing_agreement"; poland_government_formation.cabinet_program if ministry_return_mode != "pis_coalition" and ministry_return_mode != "card_finish" and ministry_return_mode != "event_queue" and ministry_return_mode != "governing_agreement"