title: Cabinet portfolios
new-page: true
face-image: img/poland/cards/negotiate-government.webp
on-arrival: {!
const model = String(Q.left_cabinet_model || "");
const mode = String(Q.ministry_allocation_mode || "formation");
const preserveExisting =
    mode == "reshuffle" || mode == "event_reshuffle";
const maximalMandate =
    model == "Programme-bound Left cabinet entry" ||
    model == "Programme-bound cooperating Left entry";
const wholeLeftMandate =
    model == "Whole Left coalition delegation" ||
    model == "Whole cooperating Left coalition delegation";
const portfolioKeys = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
const rosterHas = function(party) {
    return portfolioKeys.some(function(portfolio) {
        return Q[portfolio + "_minister_party"] == party;
    });
};
const razemAlreadyExcluded = model.includes("Razem external");
const externalRazemSeats =
    Q.razem_in_government || razemAlreadyExcluded ||
    wholeLeftMandate || maximalMandate
    ? 0
    : Math.max(0, Number(Q.razem_seats) || 0);
const leftCabinetSeats = Math.max(
    0,
    Number(
        wholeLeftMandate || maximalMandate
            ? Q.left_committed_seats
            : (
                model.includes("Razem external")
                    ? Q.nowa_lewica_seats
                    : Q.left_seats
            )
    ) - externalRazemSeats || 0
);
const statutoryMajority = Math.max(
    1,
    Number(Q.sejm_statutory_majority) || 231
);
const leftHasMajority = leftCabinetSeats >= statutoryMajority;
const formationVotesRecorded =
    Math.max(0, Number(Q.candidate_ko_votes) || 0) +
    Math.max(0, Number(Q.candidate_p2050_votes) || 0) +
    Math.max(0, Number(Q.candidate_psl_votes) || 0) +
    Math.max(0, Number(Q.candidate_left_votes) || 0) > 0;
const snapCommitmentsRecorded = Boolean(Q.snap_cabinet_commitments_recorded);
const democraticFormation =
    String(Q.ministry_return_mode || "") == "cabinet_program";
const currentRosterRecorded = preserveExisting || (!democraticFormation &&
    Boolean(Q.government_has_confidence) &&
    !Boolean(Q.caretaker_government) &&
    String(Q.cabinet_roster_government_party || "") ==
        String(Q.government_party || "")
);
const formationPslDecision = Number(Q.formation_psl_cabinet_committed);
const pisInCabinet =
    !democraticFormation &&
    Q.government_party == "pis" &&
    !Q.caretaker_government &&
    Math.max(0, Number(Q.pis_seats) || 0) > 0;
const koInCabinet = !pisInCabinet && !leftHasMajority && Math.max(
    0,
    Number(Q.ko_seats) || 0
) > 0 && (
    preserveExisting
        ? Boolean(Q.ministry_ko_in_cabinet) || rosterHas("KO")
        : (
            snapCommitmentsRecorded
                ? Q.government_party != "pis"
                : (
                    currentRosterRecorded
                        ? Boolean(Q.ministry_ko_in_cabinet) || rosterHas("KO")
                        : (
                            formationVotesRecorded
                                ? Number(Q.candidate_ko_votes) > 0
                                : true
                        )
                )
        )
);
const p2050InCabinet = !pisInCabinet && !leftHasMajority && Math.max(
    0,
    Number(Q.p2050_seats) || 0
) > 0 && (
    preserveExisting
        ? Boolean(Q.ministry_p2050_in_cabinet) || rosterHas("Poland 2050")
        : (
            snapCommitmentsRecorded
                ? Boolean(Q.snap_p2050_cabinet_committed)
                : (
                    currentRosterRecorded
                        ? Boolean(Q.ministry_p2050_in_cabinet) ||
                            rosterHas("Poland 2050")
                        : (
                            formationVotesRecorded
                                ? Number(Q.candidate_p2050_votes) > 0
                                : true
                        )
                )
        )
);
const pslInCabinet = !pisInCabinet && !leftHasMajority &&
!Q.coalition_broken && Math.max(
    0,
    Number(Q.psl_seats) || 0
) > 0 && (
    preserveExisting
        ? Boolean(Q.ministry_psl_in_cabinet) || rosterHas("PSL")
        : (
            snapCommitmentsRecorded
                ? Boolean(Q.snap_psl_cabinet_committed)
                : (
                    currentRosterRecorded
                        ? Boolean(Q.ministry_psl_in_cabinet) || rosterHas("PSL")
                        : (
                            formationVotesRecorded
                                ? (
                                    formationPslDecision >= 0
                                        ? Boolean(formationPslDecision)
                                        : Number(Q.candidate_psl_votes) > 0
                                )
                                : true
                        )
                )
        )
);
const pisCabinetMinisters = {
    labor: "Marlena Maląg",
    equality: "Anna Schmidt",
    housing: "Piotr Uściński",
    health: "Adam Niedzielski",
    digital: "Janusz Cieszyński",
    science: "Przemysław Czarnek",
    interior: "Mariusz Kamiński",
    finance: "Tadeusz Kościński",
    economy: "Piotr Nowak",
    justice: "Zbigniew Ziobro",
    foreign: "Zbigniew Rau",
    agriculture: "Grzegorz Puda",
    defence: "Mariusz Błaszczak"
};
const independentCabinetMinisters = {
    labor: "Gertruda Uścińska",
    equality: "Zuzanna Rudzińska-Bluszcz",
    housing: "Joanna Erbel",
    health: "Maria Libura",
    digital: "Alek Tarkowski",
    science: "Michał Kleiber",
    interior: "Marek Biernacki",
    finance: "Paweł Wojciechowski",
    economy: "Jerzy Hausner",
    justice: "Ewa Łętowska",
    foreign: "Jacek Czaputowicz",
    agriculture: "Monika Stanny",
    defence: "Stanisław Koziej"
};
const coalitionDefault = function(portfolio, namedMinister) {
    if (pisInCabinet) {
        return ["PiS", pisCabinetMinisters[portfolio]];
    }
    return koInCabinet
        ? ["KO", namedMinister]
        : ["Cabinet", independentCabinetMinisters[portfolio]];
};
const defaults = {
    labor: coalitionDefault(
        "labor", "Marzena Okła-Drewnowicz"
    ),
    equality: coalitionDefault(
        "equality", "Monika Rosa"
    ),
    housing: coalitionDefault(
        "housing", "Krystyna Sibińska"
    ),
    health: coalitionDefault("health", "Izabela Leszczyna"),
    digital: pisInCabinet
        ? ["PiS", pisCabinetMinisters.digital]
        : p2050InCabinet
        ? ["Poland 2050", "Michał Gramatyka"]
        : coalitionDefault(
            "digital", "Jan Grabiec"
        ),
    science: coalitionDefault(
        "science", "Barbara Nowacka"
    ),
    interior: coalitionDefault(
        "interior", "Marcin Kierwiński"
    ),
    finance: coalitionDefault("finance", "Andrzej Domański"),
    economy: pisInCabinet
        ? ["PiS", pisCabinetMinisters.economy]
        : pslInCabinet
        ? ["PSL", "Krzysztof Hetman"]
        : coalitionDefault(
            "economy", "Borys Budka"
        ),
    justice: coalitionDefault("justice", "Adam Bodnar"),
    foreign: coalitionDefault(
        "foreign", "Radosław Sikorski"
    ),
    agriculture: pisInCabinet
        ? ["PiS", pisCabinetMinisters.agriculture]
        : pslInCabinet
        ? ["PSL", "Czesław Siekierski"]
        : coalitionDefault(
            "agriculture", "Dorota Niedziela"
        ),
    defence: pisInCabinet
        ? ["PiS", pisCabinetMinisters.defence]
        : pslInCabinet
        ? ["PSL", "Władysław Kosiniak-Kamysz"]
        : coalitionDefault("defence", "Tomasz Siemoniak")
};
const costs = {
    labor: 5,
    equality: 3,
    housing: 6,
    health: 7,
    digital: 4,
    science: 4,
    interior: 5,
    finance: 10,
    economy: 10,
    justice: 10,
    foreign: 10,
    agriculture: 10,
    defence: 15
};
const portfolios = portfolioKeys;
const totalPortfolioLeverage = portfolios.reduce(function(total, portfolio) {
    return total + costs[portfolio];
}, 0);
const cabinetSeats = Math.max(
    1,
    leftCabinetSeats +
    (pisInCabinet ? Math.max(0, Number(Q.pis_seats) || 0) : 0) +
    (koInCabinet ? Math.max(0, Number(Q.ko_seats) || 0) : 0) +
    (p2050InCabinet ? Math.max(0, Number(Q.p2050_seats) || 0) : 0) +
    (pslInCabinet ? Math.max(0, Number(Q.psl_seats) || 0) : 0)
);
const negotiationBonus = maximalMandate ? 8 : wholeLeftMandate ? 6 : 3;
const leftLedCabinet =
    Q.government_party == "lewica" ||
    Q.democratic_candidate == "Agnieszka Dziemianowicz-Bąk" ||
    Boolean(Q.snap_dem_candidate_left);
const leadershipBonus = leftLedCabinet ? 5 : 0;
const baseLeverage = Q.left_cabinet_committed
    ? Math.min(
        totalPortfolioLeverage,
        Math.round(
            totalPortfolioLeverage * leftCabinetSeats / cabinetSeats
        ) + negotiationBonus + leadershipBonus
    )
    : 0;
const eligibleNominee = function(primary, fallback) {
    return primary == Q.president_name ? fallback : primary;
};
const leftPartyIsRazem = String(Q.left_party_name || "").includes("Razem");
const dominantLeftCaucus = leftPartyIsRazem
    ? "razem"
    : (
        Q.razem_active && Q.razem_in_left &&
        (Number(Q.razem_strength) || 0) >= Math.max(
            Number(Q.barons_strength) || 0,
            Number(Q.spring_strength) || 0,
            Number(Q.labor_strength) || 0,
            Number(Q.progressives_strength) || 0,
            Number(Q.social_patriot_strength) || 0
        )
            ? "razem"
            : "default"
    );
const ministryNomineeDefaults = dominantLeftCaucus == "razem"
    ? {
        labor: "Agnieszka Dziemianowicz-Bąk",
        equality: "Katarzyna Kotula",
        housing: "Magdalena Biejat",
        health: "Marcelina Zawisza",
        digital: "Krzysztof Gawkowski",
        science: "Maciej Gdula",
        interior: "Wiesław Szczepański",
        finance: "Dariusz Standerski",
        economy: "Paulina Matysiak",
        justice: "Katarzyna Ueberhan",
        foreign: "Andrzej Szejna",
        agriculture: "Wiesław Buż",
        defence: "Marcin Kulasek"
    }
    : {
        labor: "Agnieszka Dziemianowicz-Bąk",
        equality: "Katarzyna Kotula",
        housing: "Magdalena Biejat",
        health: "Marcelina Zawisza",
        digital: "Krzysztof Gawkowski",
        science: "Dariusz Wieczorek",
        interior: "Wiesław Szczepański",
        finance: "Dariusz Standerski",
        economy: "Paulina Matysiak",
        justice: "Krzysztof Śmiszek",
        foreign: "Andrzej Szejna",
        agriculture: "Wiesław Buż",
        defence: "Marcin Kulasek"
    };
Q.ministry_labor_nominee = eligibleNominee(
    ministryNomineeDefaults.labor, "Katarzyna Ueberhan"
);
Q.ministry_equality_nominee = eligibleNominee(
    ministryNomineeDefaults.equality, "Anita Kucharska-Dziedzic"
);
Q.ministry_housing_nominee = eligibleNominee(
    pisInCabinet && !Q.razem_in_government
        ? "Joanna Scheuring-Wielgus" : ministryNomineeDefaults.housing,
    "Joanna Scheuring-Wielgus"
);
Q.ministry_health_nominee = eligibleNominee(
    pisInCabinet && !Q.razem_in_government
        ? "Marek Rutka" : ministryNomineeDefaults.health,
    "Marek Rutka"
);
Q.ministry_digital_nominee = eligibleNominee(
    ministryNomineeDefaults.digital, "Dariusz Standerski"
);
Q.ministry_science_nominee = eligibleNominee(
    ministryNomineeDefaults.science, "Maciej Gdula"
);
Q.ministry_interior_nominee = eligibleNominee(
    ministryNomineeDefaults.interior, "Tomasz Szymański"
);
Q.ministry_finance_nominee = eligibleNominee(
    ministryNomineeDefaults.finance, "Wojciech Konieczny"
);
Q.ministry_economy_nominee = eligibleNominee(
    ministryNomineeDefaults.economy, "Agnieszka Dziemianowicz-Bąk"
);
Q.ministry_justice_nominee = eligibleNominee(
    ministryNomineeDefaults.justice, "Katarzyna Ueberhan"
);
Q.ministry_foreign_nominee = eligibleNominee(
    ministryNomineeDefaults.foreign, "Marek Balt"
);
Q.ministry_agriculture_nominee = eligibleNominee(
    ministryNomineeDefaults.agriculture, "Zdzisław Wolski"
);
Q.ministry_defence_nominee = eligibleNominee(
    ministryNomineeDefaults.defence, "Andrzej Szejna"
);

Q.ministries_finalized = 0;
Q.ministry_maximal_mandate = maximalMandate ? 1 : 0;
Q.ministry_whole_left_mandate = wholeLeftMandate ? 1 : 0;
Q.ministry_base_leverage = baseLeverage;
Q.ministry_left_cabinet_seats = leftCabinetSeats;
Q.ministry_coalition_seats = cabinetSeats;
Q.ministry_pis_in_cabinet = pisInCabinet ? 1 : 0;
Q.ministry_ko_in_cabinet = koInCabinet ? 1 : 0;
Q.ministry_p2050_in_cabinet = p2050InCabinet ? 1 : 0;
Q.ministry_psl_in_cabinet = pslInCabinet ? 1 : 0;
Q.ministry_reshuffle_changes = 0;
Q.ministry_coalition_partners = [
    pisInCabinet ? "PiS" : "",
    koInCabinet ? "KO" : "",
    p2050InCabinet ? "Polska 2050" : "",
    pslInCabinet ? "PSL" : "",
    Q.left_cabinet_committed ? "Lewica" : ""
].filter(Boolean).join(" · ");

for (const portfolio of portfolios) {
    const partyKey = portfolio + "_minister_party";
    const ministerKey = portfolio + "_minister";
    const missing =
        typeof Q[partyKey] != "string" ||
        !Q[partyKey].length ||
        Q[partyKey] == "Unassigned" ||
        typeof Q[ministerKey] != "string" ||
        !Q[ministerKey].length ||
        /nominee|unassigned|development ministry/i.test(Q[ministerKey]);
    if (!preserveExisting || missing) {
        Q[partyKey] = defaults[portfolio][0];
        Q[ministerKey] = defaults[portfolio][1];
    }
    Q["ministry_" + portfolio + "_default_party"] =
        defaults[portfolio][0];
    Q["ministry_" + portfolio + "_default_minister"] =
        defaults[portfolio][1];
}
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;

Q.ministry_count = portfolios.reduce(function(total, portfolio) {
    return total +
        (Q[portfolio + "_minister_party"] == "Lewica" ? 1 : 0);
}, 0);
const investedLeverage = portfolios.reduce(function(total, portfolio) {
    return total +
        (Q[portfolio + "_minister_party"] == "Lewica"
            ? costs[portfolio]
            : 0);
}, 0);
Q.ministry_leverage = preserveExisting
    ? Math.max(0, baseLeverage - investedLeverage)
    : baseLeverage;
if (preserveExisting) {
    Q.ministry_reshuffle_previous_count = Q.ministry_count;
}
!}
go-to: menu if left_cabinet_committed = 1; opposition_allocation if left_cabinet_committed = 0

@menu
title: Allocate the whole cabinet
new-page: true

= The cabinet table

Lewica has **[+ ministry_leverage +] leverage**. Every portfolio below has its
own Government Affairs card when Lewica controls it. Untaken offices remain
with the named coalition partner.

That entitlement comes from **[+ ministry_left_cabinet_seats +] Lewica
cabinet seats out of [+ ministry_coalition_seats +] seats held by parties
sharing cabinet responsibility**, plus the negotiated programme and any
Lewica premiership.

[? if ministry_allocation_mode = "reshuffle" or ministry_allocation_mode =
"event_reshuffle": This is a live reshuffle. Existing Lewica offices remain in
place; return one to recover its leverage, then bargain for another.?]

[? if ministry_pis_in_cabinet = 1: Kaczyński will bargain over social policy,
public services, digital administration, science and the development office.
Interior, Finance, Justice, Foreign Affairs, Agriculture and Defence remain
PiS red lines in this coalition.?]
[? if ministry_pis_in_cabinet = 0: This table belongs to **[+
ministry_coalition_partners +]**. KO treats Finance and Foreign Affairs as
senior claims. PSL treats Agriculture as a hard coalition red line when it
joins the cabinet, while Defence is available only in an exceptionally strong
negotiation.?]

<div class="ministry-grid">
<div><span>Labour & Social Policy</span><b>[+ labor_minister_party +] · [+ labor_minister +]</b></div>
<div><span>Equality</span><b>[+ equality_minister_party +] · [+ equality_minister +]</b></div>
<div><span>Housing</span><b>[+ housing_minister_party +] · [+ housing_minister +]</b></div>
<div><span>Health</span><b>[+ health_minister_party +] · [+ health_minister +]</b></div>
<div><span>Digital Affairs</span><b>[+ digital_minister_party +] · [+ digital_minister +]</b></div>
<div><span>Science</span><b>[+ science_minister_party +] · [+ science_minister +]</b></div>
<div><span>Interior & Administration</span><b>[+ interior_minister_party +] · [+ interior_minister +]</b></div>
<div><span>Finance</span><b>[+ finance_minister_party +] · [+ finance_minister +]</b></div>
<div><span>Development & Technology</span><b>[+ economy_minister_party +] · [+ economy_minister +]</b></div>
<div><span>Justice</span><b>[+ justice_minister_party +] · [+ justice_minister +]</b></div>
<div><span>Foreign Affairs</span><b>[+ foreign_minister_party +] · [+ foreign_minister +]</b></div>
<div><span>Agriculture & Rural Development</span><b>[+ agriculture_minister_party +] · [+ agriculture_minister +]</b></div>
<div><span>National Defence</span><b>[+ defence_minister_party +] · [+ defence_minister +]</b></div>
</div>

- #poland_ministry_take
- #poland_ministry_drop
- @finalize

@take_labor
title: Take Labour & Social Policy
subtitle: 5 leverage · [+ ministry_labor_nominee +]
tags: poland_ministry_take
view-if: labor_minister_party != "Lewica"
choose-if: ministry_leverage >= 5
unavailable-subtitle: Requires five leverage.
on-arrival: ministry_leverage -= 5; ministry_count += 1; ministry_reshuffle_changes += 1; labor_minister_party = "Lewica"; labor_minister = ministry_labor_nominee; family_minister_party = "Lewica"; family_minister = ministry_labor_nominee
go-to: menu

@take_equality
title: Take Equality
subtitle: 3 leverage · [+ ministry_equality_nominee +]
tags: poland_ministry_take
view-if: equality_minister_party != "Lewica"
choose-if: ministry_leverage >= 3
unavailable-subtitle: Requires three leverage.
on-arrival: ministry_leverage -= 3; ministry_count += 1; ministry_reshuffle_changes += 1; equality_minister_party = "Lewica"; equality_minister = ministry_equality_nominee
go-to: menu

@take_housing
title: Take Housing
subtitle: 6 leverage · [+ ministry_housing_nominee +]
tags: poland_ministry_take
view-if: housing_minister_party != "Lewica"
choose-if: ministry_leverage >= 6
unavailable-subtitle: Requires six leverage.
on-arrival: ministry_leverage -= 6; ministry_count += 1; ministry_reshuffle_changes += 1; housing_minister_party = "Lewica"; housing_minister = ministry_housing_nominee
go-to: menu

@take_health
title: Take Health
subtitle: 7 leverage · [+ ministry_health_nominee +]
tags: poland_ministry_take
view-if: health_minister_party != "Lewica"
choose-if: ministry_leverage >= 7 and ((razem_in_left_club = 1 and razem_split = 0) or ministry_pis_in_cabinet = 1)
unavailable-subtitle: Requires seven leverage. Outside the PiS accession route, Health also requires Razem's participation in the Left delegation.
on-arrival: ministry_leverage -= 7; ministry_count += 1; ministry_reshuffle_changes += 1; health_minister_party = "Lewica"; health_minister = ministry_health_nominee
go-to: menu

@take_digital
title: Take Digital Affairs
subtitle: 4 leverage · [+ ministry_digital_nominee +]
tags: poland_ministry_take
view-if: digital_minister_party != "Lewica"
choose-if: ministry_leverage >= 4
unavailable-subtitle: Requires four leverage.
on-arrival: ministry_leverage -= 4; ministry_count += 1; ministry_reshuffle_changes += 1; digital_minister_party = "Lewica"; digital_minister = ministry_digital_nominee
go-to: menu

@take_science
title: Take Science
subtitle: 4 leverage · [+ ministry_science_nominee +]
tags: poland_ministry_take
view-if: science_minister_party != "Lewica"
choose-if: ministry_leverage >= 4
unavailable-subtitle: Requires four leverage.
on-arrival: ministry_leverage -= 4; ministry_count += 1; ministry_reshuffle_changes += 1; science_minister_party = "Lewica"; science_minister = ministry_science_nominee
go-to: menu

@take_interior
title: Take Interior & Administration
subtitle: 5 leverage · [+ ministry_interior_nominee +] · senior-partner dissent
tags: poland_ministry_take
view-if: interior_minister_party != "Lewica"
choose-if: ministry_leverage >= 5 and ministry_pis_in_cabinet = 0
unavailable-subtitle: Requires five leverage. [? if ministry_pis_in_cabinet = 1: PiS will not release Interior in the 2021 accession agreement.?][? if ministry_pis_in_cabinet = 0: [+ ministry_interior_default_party +] currently holds Interior.?]
on-arrival: ministry_leverage -= 5; ministry_count += 1; ministry_reshuffle_changes += 1; interior_minister_party = "Lewica"; interior_minister = ministry_interior_nominee; ko_relation -= 3 if ministry_ko_in_cabinet = 1; ko_coalition_dissent += 5 if ministry_ko_in_cabinet = 1; government_coalition_dissent += 2 if ministry_ko_in_cabinet = 1
go-to: menu

@take_finance
title: Demand the Finance Ministry
subtitle: 10 leverage · [+ ministry_finance_nominee +] · senior-partner veto
tags: poland_ministry_take
view-if: finance_minister_party != "Lewica"
choose-if: ministry_leverage >= 10 and ministry_pis_in_cabinet = 0 and (ministry_ko_in_cabinet = 0 or ministry_maximal_mandate = 1)
unavailable-subtitle: Requires ten leverage. [? if ministry_pis_in_cabinet = 1: PiS reserves Finance in this accession agreement.?][? if ministry_pis_in_cabinet = 0: [+ ministry_finance_default_party +] currently holds Finance; KO releases it only to the strongest programme-bound Left delegation.?]
on-arrival: ministry_leverage -= 10; ministry_count += 1; ministry_reshuffle_changes += 1; finance_minister_party = "Lewica"; finance_minister = ministry_finance_nominee; ko_relation -= 10 if ministry_ko_in_cabinet = 1; ko_coalition_dissent += 14 if ministry_ko_in_cabinet = 1; government_coalition_dissent += 6 if ministry_ko_in_cabinet = 1
go-to: menu

@take_economy
title: Take Development & Technology
subtitle: 10 leverage · [+ ministry_economy_nominee +] · senior-partner dissent
tags: poland_ministry_take
view-if: economy_minister_party != "Lewica"
choose-if: ministry_leverage >= 10
unavailable-subtitle: Requires ten leverage.
on-arrival: ministry_leverage -= 10; ministry_count += 1; ministry_reshuffle_changes += 1; economy_minister_party = "Lewica"; economy_minister = ministry_economy_nominee; psl_relation -= 4 if ministry_psl_in_cabinet = 1; psl_coalition_dissent += 8 if ministry_psl_in_cabinet = 1; government_coalition_dissent += 3 if ministry_psl_in_cabinet = 1; pis_relation -= 4 if ministry_pis_in_cabinet = 1; government_coalition_dissent += 5 if ministry_pis_in_cabinet = 1
go-to: menu

@take_justice
title: Take Justice
subtitle: 10 leverage · [+ ministry_justice_nominee +] · senior-partner veto
tags: poland_ministry_take
view-if: justice_minister_party != "Lewica"
choose-if: ministry_leverage >= 10 and ministry_pis_in_cabinet = 0
unavailable-subtitle: Requires ten leverage. [? if ministry_pis_in_cabinet = 1: PiS and Solidarna Polska will not release Justice in this accession agreement.?][? if ministry_pis_in_cabinet = 0: [+ ministry_justice_default_party +] currently holds Justice.?]
