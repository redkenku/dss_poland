title: Cabinet portfolios
new-page: true
face-image: img/poland/cards/negotiate-government.webp
on-arrival: {!
const finiteMinistry = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const clampMinistry = function(value, low, high) {
    return Math.max(low, Math.min(high, finiteMinistry(value, low)));
};
const model = String(Q.left_cabinet_model || "");
const recordedModelCode = String(Q.left_cabinet_model_code || "");
const mode = String(Q.ministry_allocation_mode || "formation");
const preserveExisting = mode == "reshuffle" || mode == "event_reshuffle";
const portfolioKeys = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
const costs = {
    labor: 5,
    equality: 3,
    housing: 6,
    health: 7,
    digital: 4,
    science: 4,
    interior: 5,
    finance: 10,
    economy: 10,
    justice: 10,
    foreign: 10,
    agriculture: 10,
    defence: 15
};
const totalPortfolioLeverage = portfolioKeys.reduce(function(total, key) {
    return total + costs[key];
}, 0);
const normalizePartyCode = function(value) {
    const text = String(value || "").trim().toLowerCase();
    if (text == "pis") return "pis";
    if (text == "ko" || text.includes("obywatelsk")) return "ko";
    if (text == "psl") return "psl";
    if (text == "p2050" || text.includes("2050")) return "p2050";
    if (text == "lewica" || text == "left" || text.includes("lewica")) {
        return "lewica";
    }
    if (text == "cabinet" || text == "independent") return "cabinet";
    return "";
};
const partyDisplay = function(code) {
    if (code == "pis") return "PiS";
    if (code == "ko") return "KO";
    if (code == "psl") return "PSL";
    if (code == "p2050") return "Polska 2050";
    if (code == "lewica") return "Lewica";
    return "Cabinet";
};
const rosterHasCode = function(code) {
    return portfolioKeys.some(function(portfolio) {
        return normalizePartyCode(Q[portfolio + "_minister_party"]) == code;
    });
};
const flagRecorded = function(key) {
    return Number.isFinite(Number(Q[key])) && Number(Q[key]) >= 0;
};
const flagValue = function(key) {
    return flagRecorded(key) ? Number(Q[key]) > 0 : false;
};

let modelCode = recordedModelCode;
if (
    model == "Programme-bound Left cabinet entry" ||
    model == "Programme-bound cooperating Left entry"
) {
    modelCode = "programme_bound";
} else if (
    model == "Whole Left coalition delegation" ||
    model == "Whole cooperating Left coalition delegation"
) {
    modelCode = "whole_left";
} else if (model.includes("Razem external")) {
    modelCode = "razem_external";
} else if (!modelCode || !preserveExisting) {
    modelCode = "ordinary_left_delegation";
}
Q.left_cabinet_model_code = modelCode;
const maximalMandate = modelCode == "programme_bound";
const wholeLeftMandate = modelCode == "whole_left";
const razemExternal = modelCode == "razem_external";

const currentGovernmentCode = normalizePartyCode(Q.government_party);
const rosterGovernmentCode = normalizePartyCode(
    Q.cabinet_roster_government_party
);
const sameGovernmentRoster =
    Boolean(Q.cabinet_roster_finalized) &&
    rosterGovernmentCode != "" &&
    rosterGovernmentCode == currentGovernmentCode;

const formationCommitmentsActive =
    Boolean(Q.formation_in_progress) ||
    ["cabinet_program", "governing_agreement", "pis_coalition"].includes(
        String(Q.ministry_return_mode || "")
    ) || Boolean(Q.formation_cabinet_commitments_recorded);
const resolveCommitment = function(code) {
    if (preserveExisting) {
        if (flagRecorded("ministry_" + code + "_in_cabinet")) {
            return flagValue("ministry_" + code + "_in_cabinet");
        }
        return rosterHasCode(code);
    }
    const formationKey = "formation_" + code + "_cabinet_committed";
    const snapKey = "snap_" + code + "_cabinet_committed";
    if (formationCommitmentsActive) {
        if (flagRecorded(formationKey)) {
            return flagValue(formationKey);
        }
        // Only PSL records an explicit formation flag. For the others, the
        // coalition contract that was just signed is the answer; falling
        // through to currentGovernmentCode would ask who leads the outgoing
        // caretaker cabinet, which is never the incoming coalition.
        const pledged = finiteMinistry(Q["candidate_" + code + "_votes"], -1);
        if (pledged >= 0) {
            return pledged > 0;
        }
    }
    if (Boolean(Q.snap_cabinet_commitments_recorded) && flagRecorded(snapKey)) {
        return flagValue(snapKey);
    }
    if (sameGovernmentRoster) {
        if (flagRecorded("ministry_" + code + "_in_cabinet")) {
            return flagValue("ministry_" + code + "_in_cabinet");
        }
        return rosterHasCode(code);
    }
    return currentGovernmentCode == code;
};

// A cabinet being formed is always allocated while the outgoing one is still
// caretaker, so the caretaker guard only applies to allocation outside a
// formation round. Without this the whole formation route hands the delegation
// zero leverage and no portfolio can be claimed.
const leftCommitted =
    Boolean(Q.left_cabinet_committed) &&
    (!Boolean(Q.caretaker_government) ||
        Q.ministry_allocation_mode == "formation");
let leftCabinetSeats = preserveExisting || sameGovernmentRoster
    ? finiteMinistry(Q.left_cabinet_delegation_seats, -1)
    : -1;
if (leftCabinetSeats < 0) {
    if (wholeLeftMandate || maximalMandate || Boolean(Q.razem_in_government)) {
        leftCabinetSeats = finiteMinistry(
            Q.left_committed_seats,
            finiteMinistry(Q.left_seats, 0)
        );
    } else if (razemExternal) {
        leftCabinetSeats = finiteMinistry(
            Q.nowa_lewica_seats,
            Math.max(
                0,
                finiteMinistry(Q.left_seats, 0) -
                    finiteMinistry(Q.razem_seats, 0)
            )
        );
    } else if (
        Number.isFinite(Number(Q.nowa_lewica_seats)) &&
        finiteMinistry(Q.nowa_lewica_seats, 0) > 0 &&
        !Boolean(Q.razem_in_government)
    ) {
        leftCabinetSeats = finiteMinistry(Q.nowa_lewica_seats, 0);
    } else {
        leftCabinetSeats = Math.max(
            0,
            finiteMinistry(Q.left_seats, 0) -
                (!Boolean(Q.razem_in_government)
                    ? finiteMinistry(Q.razem_seats, 0)
                    : 0)
        );
    }
}
leftCabinetSeats = leftCommitted ? Math.max(0, Math.round(leftCabinetSeats)) : 0;
Q.left_cabinet_delegation_seats = leftCabinetSeats;

const statutoryMajority = Math.max(
    1,
    Math.round(finiteMinistry(Q.sejm_statutory_majority, 231))
);
const leftHasMajority = leftCabinetSeats >= statutoryMajority;
const pisInCabinet =
    !Boolean(Q.caretaker_government) &&
    currentGovernmentCode == "pis" &&
    finiteMinistry(Q.pis_seats, 0) > 0;
const koInCabinet =
    !pisInCabinet && !leftHasMajority &&
    finiteMinistry(Q.ko_seats, 0) > 0 && resolveCommitment("ko");
const p2050InCabinet =
    !pisInCabinet && !leftHasMajority &&
    finiteMinistry(Q.p2050_seats, 0) > 0 && resolveCommitment("p2050");
const pslInCabinet =
    !pisInCabinet && !leftHasMajority && !Boolean(Q.coalition_broken) &&
    finiteMinistry(Q.psl_seats, 0) > 0 && resolveCommitment("psl");

let cabinetLeaderCode = normalizePartyCode(Q.prime_minister_party);
if (!cabinetLeaderCode) {
    cabinetLeaderCode = normalizePartyCode(Q.democratic_candidate_party);
}
if (!cabinetLeaderCode) cabinetLeaderCode = currentGovernmentCode;
if (leftHasMajority) cabinetLeaderCode = "lewica";
const committedCodes = [];
if (pisInCabinet) committedCodes.push("pis");
if (koInCabinet) committedCodes.push("ko");
if (p2050InCabinet) committedCodes.push("p2050");
if (pslInCabinet) committedCodes.push("psl");
if (leftCommitted) committedCodes.push("lewica");
if (!committedCodes.includes(cabinetLeaderCode)) {
    cabinetLeaderCode = committedCodes[0] || "cabinet";
}
const partyIsCommitted = function(code) {
    return code == "cabinet" || committedCodes.includes(code);
};

const ministerRosters = {
    pis: {
        labor: "Marlena Maląg",
        equality: "Anna Schmidt",
        housing: "Piotr Uściński",
        health: "Adam Niedzielski",
        digital: "Janusz Cieszyński",
        science: "Przemysław Czarnek",
        interior: "Mariusz Kamiński",
        finance: "Tadeusz Kościński",
        economy: "Piotr Nowak",
        justice: "Zbigniew Ziobro",
        foreign: "Zbigniew Rau",
        agriculture: "Grzegorz Puda",
        defence: "Mariusz Błaszczak"
    },
    ko: {
        labor: "Marzena Okła-Drewnowicz",
        equality: "Monika Rosa",
        housing: "Krystyna Sibińska",
        health: "Izabela Leszczyna",
        digital: "Jan Grabiec",
        science: "Barbara Nowacka",
        interior: "Marcin Kierwiński",
        finance: "Andrzej Domański",
        economy: "Borys Budka",
        justice: "Adam Bodnar",
        foreign: "Radosław Sikorski",
        agriculture: "Dorota Niedziela",
        defence: "Tomasz Siemoniak"
    },
    p2050: {
        labor: "Agnieszka Buczyńska",
        equality: "Aleksandra Leo",
        housing: "Michał Kobosko",
        health: "Żaneta Cwalina-Śliwowska",
        digital: "Michał Gramatyka",
        science: "Joanna Mucha",
        interior: "Mirosław Suchoń",
        finance: "Ryszard Petru",
        economy: "Katarzyna Pełczyńska-Nałęcz",
        justice: "Paweł Śliz",
        foreign: "Paweł Zalewski",
        agriculture: "Norbert Pietrykowski",
        defence: "Maciej Żywno"
    },
    psl: {
        labor: "Urszula Pasławska",
        equality: "Agnieszka Kłopotek",
        housing: "Krzysztof Paszyk",
        health: "Marek Sawicki",
        digital: "Stefan Krajewski",
        science: "Dariusz Klimczak",
        interior: "Piotr Zgorzelski",
        finance: "Janusz Piechociński",
        economy: "Krzysztof Hetman",
        justice: "Jacek Tomczak",
        foreign: "Władysław Teofil Bartoszewski",
        agriculture: "Czesław Siekierski",
        defence: "Władysław Kosiniak-Kamysz"
    },
    cabinet: {
        labor: "Gertruda Uścińska",
        equality: "Zuzanna Rudzińska-Bluszcz",
        housing: "Joanna Erbel",
        health: "Maria Libura",
        digital: "Alek Tarkowski",
        science: "Michał Kleiber",
        interior: "Marek Biernacki",
        finance: "Paweł Wojciechowski",
        economy: "Jerzy Hausner",
        justice: "Ewa Łętowska",
        foreign: "Jacek Czaputowicz",
        agriculture: "Monika Stanny",
        defence: "Stanisław Koziej"
    }
};
const ministerFor = function(code, portfolio) {
    const roster = ministerRosters[code] || ministerRosters.cabinet;
    return roster[portfolio] || ministerRosters.cabinet[portfolio];
};
const ownerForPortfolio = function(portfolio) {
    if (pisInCabinet) return "pis";
    if (portfolio == "agriculture" && pslInCabinet) return "psl";
    if (portfolio == "defence" && pslInCabinet) return "psl";
    if (portfolio == "economy" && pslInCabinet) return "psl";
    if (portfolio == "digital" && p2050InCabinet) return "p2050";
    if (
        ["interior", "finance", "justice", "foreign"].includes(portfolio) &&
        koInCabinet
    ) {
        return "ko";
    }
    if (cabinetLeaderCode != "lewica" && partyIsCommitted(cabinetLeaderCode)) {
        return cabinetLeaderCode;
    }
    if (koInCabinet) return "ko";
    if (p2050InCabinet) return "p2050";
    if (pslInCabinet) return "psl";
    return "cabinet";
};

const cabinetSeats = Math.max(
    1,
    leftCabinetSeats +
        (pisInCabinet ? Math.max(0, finiteMinistry(Q.pis_seats, 0)) : 0) +
        (koInCabinet ? Math.max(0, finiteMinistry(Q.ko_seats, 0)) : 0) +
        (p2050InCabinet ? Math.max(0, finiteMinistry(Q.p2050_seats, 0)) : 0) +
        (pslInCabinet ? Math.max(0, finiteMinistry(Q.psl_seats, 0)) : 0)
);
const negotiationBonus = maximalMandate ? 8 : wholeLeftMandate ? 6 : 3;
const leftLedCabinet =
    cabinetLeaderCode == "lewica" ||
    currentGovernmentCode == "lewica" ||
    normalizePartyCode(Q.prime_minister_party) == "lewica" ||
    normalizePartyCode(Q.democratic_candidate_party) == "lewica" ||
    Boolean(Q.snap_dem_candidate_left);
const leadershipBonus = leftLedCabinet ? 5 : 0;
let baseLeverage = leftCommitted
    ? Math.round(totalPortfolioLeverage * leftCabinetSeats / cabinetSeats) +
        negotiationBonus + leadershipBonus
    : 0;
if (leftCommitted && leftCabinetSeats > 0) baseLeverage = Math.max(3, baseLeverage);
if (leftHasMajority) baseLeverage = totalPortfolioLeverage;
baseLeverage = Math.min(totalPortfolioLeverage, Math.max(0, baseLeverage));

const factionStrength = function(id) {
    return Math.max(0, finiteMinistry(Q[id + "_strength"], 0));
};
const factionActive = function(id) {
    if (id == "barons") return !Boolean(Q.barons_party_formed);
    if (id == "spring") return !Boolean(Q.spring_party_formed);
    if (id == "labor") return !Boolean(Q.labor_party_formed);
    if (id == "progressives") return !Boolean(Q.progressives_party_formed);
    if (id == "social_patriot") return !Boolean(Q.social_patriot_party_formed);
    if (id == "pps") return !Boolean(Q.pps_party_formed);
    if (id == "razem") {
        return !Boolean(Q.razem_party_formed) &&
            (
                Boolean(Q.razem_in_left) ||
                Boolean(Q.razem_in_left_club) ||
                Boolean(Q.razem_in_government) ||
                String(Q.left_party_name || "").includes("Razem")
            );
    }
    return true;
};
const factionIds = [
    "barons", "spring", "labor", "progressives",
    "razem", "social_patriot", "pps"
];
let dominantLeftCaucus = "barons";
let dominantStrength = -1;
for (const id of factionIds) {
    const strength = factionActive(id) ? factionStrength(id) : -1;
    if (strength > dominantStrength) {
        dominantLeftCaucus = id;
        dominantStrength = strength;
    }
}

const nomineePools = {
    labor: ["Agnieszka Dziemianowicz-Bąk", "Tomasz Trela", "Katarzyna Ueberhan"],
    equality: ["Katarzyna Kotula", "Anita Kucharska-Dziedzic", "Krzysztof Śmiszek"],
    housing: ["Magdalena Biejat", "Joanna Scheuring-Wielgus", "Tomasz Trela"],
    health: ["Marcelina Zawisza", "Marek Rutka", "Wojciech Konieczny"],
    digital: ["Krzysztof Gawkowski", "Dariusz Standerski", "Łukasz Litewka"],
    science: ["Dariusz Wieczorek", "Maciej Gdula", "Łukasz Litewka"],
    interior: ["Wiesław Szczepański", "Tomasz Szymański", "Tomasz Trela"],
    finance: ["Dariusz Standerski", "Wojciech Konieczny", "Tomasz Trela"],
    economy: ["Paulina Matysiak", "Tomasz Trela", "Dariusz Wieczorek"],
    justice: ["Krzysztof Śmiszek", "Katarzyna Ueberhan", "Anita Kucharska-Dziedzic"],
    foreign: ["Andrzej Szejna", "Marek Balt", "Krzysztof Śmiszek"],
    agriculture: ["Wiesław Buż", "Zdzisław Wolski", "Wojciech Konieczny"],
    defence: ["Marcin Kulasek", "Andrzej Szejna", "Tomasz Trela"]
};
const factionPreferences = {
    barons: {
        labor: "Tomasz Trela", science: "Dariusz Wieczorek",
        interior: "Wiesław Szczepański", finance: "Dariusz Standerski",
        economy: "Dariusz Wieczorek"
    },
    spring: {
        equality: "Krzysztof Śmiszek", housing: "Joanna Scheuring-Wielgus",
        digital: "Krzysztof Gawkowski", justice: "Krzysztof Śmiszek"
    },
    labor: {
        labor: "Agnieszka Dziemianowicz-Bąk", health: "Wojciech Konieczny",
        finance: "Wojciech Konieczny", economy: "Agnieszka Dziemianowicz-Bąk",
        agriculture: "Wojciech Konieczny"
    },
    progressives: {
        labor: "Agnieszka Dziemianowicz-Bąk", equality: "Katarzyna Kotula",
        digital: "Łukasz Litewka", science: "Łukasz Litewka",
        justice: "Katarzyna Ueberhan"
    },
    razem: {
        housing: "Magdalena Biejat", health: "Marcelina Zawisza",
        science: "Maciej Gdula", economy: "Paulina Matysiak",
        justice: "Katarzyna Ueberhan"
    },
    social_patriot: {
        interior: "Tomasz Trela", foreign: "Andrzej Szejna",
        agriculture: "Zdzisław Wolski", defence: "Marcin Kulasek"
    },
    pps: {
        labor: "Tomasz Trela", health: "Wojciech Konieczny",
        finance: "Wojciech Konieczny", agriculture: "Wojciech Konieczny"
    }
};
const reservedNominees = new Set();
for (const name of [
    Q.president_name,
    Q.prime_minister,
    leftLedCabinet ? Q.democratic_candidate : ""
]) {
    if (String(name || "").trim()) reservedNominees.add(String(name));
}
if (preserveExisting) {
    for (const portfolio of portfolioKeys) {
        const existing = String(Q[portfolio + "_minister"] || "").trim();
        if (existing) reservedNominees.add(existing);
    }
}
const usedNominees = new Set(reservedNominees);
const chooseNominee = function(portfolio) {
    const preference =
        (factionPreferences[dominantLeftCaucus] || {})[portfolio];
    const candidates = [];
    if (preference) candidates.push(preference);
    for (const candidate of nomineePools[portfolio]) {
        if (!candidates.includes(candidate)) candidates.push(candidate);
    }
    candidates.push("Lewica cabinet delegate — " + portfolio);
    for (const candidate of candidates) {
        if (!usedNominees.has(candidate)) {
            usedNominees.add(candidate);
            return candidate;
        }
    }
    return "Lewica cabinet delegate — " + portfolio;
};
for (const portfolio of portfolioKeys) {
    Q["ministry_" + portfolio + "_nominee"] = chooseNominee(portfolio);
}

Q.ministries_finalized = 0;
Q.ministry_maximal_mandate = maximalMandate ? 1 : 0;
Q.ministry_whole_left_mandate = wholeLeftMandate ? 1 : 0;
Q.ministry_left_led_cabinet = leftLedCabinet ? 1 : 0;
Q.ministry_dominant_left_caucus = dominantLeftCaucus;
Q.ministry_base_leverage = baseLeverage;
Q.ministry_left_cabinet_seats = leftCabinetSeats;
Q.ministry_coalition_seats = cabinetSeats;
Q.ministry_pis_in_cabinet = pisInCabinet ? 1 : 0;
Q.ministry_ko_in_cabinet = koInCabinet ? 1 : 0;
Q.ministry_p2050_in_cabinet = p2050InCabinet ? 1 : 0;
Q.ministry_psl_in_cabinet = pslInCabinet ? 1 : 0;
Q.ministry_cabinet_leader_code = cabinetLeaderCode;
Q.ministry_reshuffle_changes = 0;
Q.ministry_coalition_partners = committedCodes
    .map(partyDisplay)
    .join(" · ");

for (const portfolio of portfolioKeys) {
    const partyKey = portfolio + "_minister_party";
    const ministerKey = portfolio + "_minister";
    const currentCode = normalizePartyCode(Q[partyKey]);
    const authoredDefaultOwner = ownerForPortfolio(portfolio);
    const storedSource = normalizePartyCode(
        Q["ministry_" + portfolio + "_source_party_code"]
    );
    let baselineOwner = authoredDefaultOwner;
    if (preserveExisting && currentCode == "lewica" && partyIsCommitted(storedSource)) {
        baselineOwner = storedSource;
    } else if (preserveExisting && currentCode && currentCode != "lewica") {
        baselineOwner = partyIsCommitted(currentCode) ? currentCode : authoredDefaultOwner;
    }
    let baselineMinister = ministerFor(baselineOwner, portfolio);
    if (preserveExisting && currentCode == baselineOwner) {
        const existingMinister = String(Q[ministerKey] || "").trim();
        if (existingMinister) baselineMinister = existingMinister;
    }
    const missing =
        !currentCode ||
        typeof Q[ministerKey] != "string" ||
        !String(Q[ministerKey]).trim() ||
        /nominee|unassigned|development ministry/i.test(String(Q[ministerKey]));
    if (!preserveExisting || missing) {
        Q[partyKey] = partyDisplay(authoredDefaultOwner);
        Q[ministerKey] = ministerFor(authoredDefaultOwner, portfolio);
    }
    const finalCurrentCode = normalizePartyCode(Q[partyKey]);
    Q["ministry_" + portfolio + "_baseline_owner_code"] = baselineOwner;
    Q["ministry_" + portfolio + "_baseline_party"] = partyDisplay(baselineOwner);
    Q["ministry_" + portfolio + "_baseline_minister"] = baselineMinister;
    Q["ministry_" + portfolio + "_default_party"] = partyDisplay(authoredDefaultOwner);
    Q["ministry_" + portfolio + "_default_minister"] =
        ministerFor(authoredDefaultOwner, portfolio);
    Q["ministry_" + portfolio + "_current_owner_code"] =
        finalCurrentCode || authoredDefaultOwner;
    if (finalCurrentCode != "lewica") {
        Q["ministry_" + portfolio + "_source_party_code"] =
            finalCurrentCode || authoredDefaultOwner;
    } else if (!storedSource) {
        Q["ministry_" + portfolio + "_source_party_code"] = baselineOwner;
    }
    if (!preserveExisting) {
        Q["ministry_" + portfolio + "_penalty_active"] = 0;
        Q["ministry_" + portfolio + "_penalty_relation"] = 0;
        Q["ministry_" + portfolio + "_penalty_partner_dissent"] = 0;
        Q["ministry_" + portfolio + "_penalty_general_dissent"] = 0;
        Q["ministry_" + portfolio + "_taken_from_code"] = "";
    }
}
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;

Q.ministry_count = portfolioKeys.reduce(function(total, portfolio) {
    return total +
        (normalizePartyCode(Q[portfolio + "_minister_party"]) == "lewica" ? 1 : 0);
}, 0);
const investedLeverage = portfolioKeys.reduce(function(total, portfolio) {
    return total +
        (normalizePartyCode(Q[portfolio + "_minister_party"]) == "lewica"
            ? costs[portfolio]
            : 0);
}, 0);
const leverageBalance = baseLeverage - investedLeverage;
Q.ministry_leverage = Math.max(0, leverageBalance);
Q.ministry_leverage_debt = Math.max(0, -leverageBalance);
Q.ministry_invested_leverage = investedLeverage;
Q.ministry_minimum_expected_value = Math.max(
    3,
    Math.round(baseLeverage * 0.35)
);
if (preserveExisting) {
    Q.ministry_reshuffle_previous_count = Q.ministry_count;
}
!}
go-to: menu if left_cabinet_committed = 1; opposition_allocation if left_cabinet_committed = 0

@menu
title: Allocate the whole cabinet
new-page: true

= The cabinet table

Lewica has **[+ ministry_leverage +] free leverage** and **[+
ministry_leverage_debt +] leverage debt**. Every portfolio below has its own
Government Affairs card when Lewica controls it. Untaken offices remain with
the named coalition partner.

The entitlement comes from **[+ ministry_left_cabinet_seats +] Lewica cabinet
seats out of [+ ministry_coalition_seats +] seats held by parties sharing
cabinet responsibility**, plus the negotiated programme and any Lewica-led
premiership. The strongest active Left caucus is **[+
ministry_dominant_left_caucus +]**; its preferred names lead the nominee list,
but no person may simultaneously serve as President, Prime Minister or two
different ministers.

[? if ministry_leverage_debt > 0: **The delegation now holds more cabinet
value than its current entitlement.** At least [+ ministry_leverage_debt +]
leverage must be recovered by returning offices before this reshuffle can be
finalised.?]
[? if ministry_allocation_mode = "reshuffle" or ministry_allocation_mode =
"event_reshuffle": This is a live reshuffle. Existing Lewica offices remain in
place, but a reduced entitlement creates real leverage debt rather than free
overrepresentation.?]

[? if ministry_pis_in_cabinet = 1: PiS will bargain over social policy, public
services, digital administration, science and development. Interior, Finance,
Justice, Foreign Affairs, Agriculture and Defence remain PiS red lines in this
accession agreement.?]
[? if ministry_pis_in_cabinet = 0: Cabinet commitments are explicit: **[+
ministry_coalition_partners +]**. KO treats Finance and Foreign Affairs as
senior claims. PSL treats Agriculture and Defence as senior claims, but those
claims can be negotiated rather than hidden behind an unreachable flag.?]

<div class="ministry-grid">
<div><span>Labour & Social Policy</span><b>[+ labor_minister_party +] · [+ labor_minister +]</b></div>
<div><span>Equality</span><b>[+ equality_minister_party +] · [+ equality_minister +]</b></div>
<div><span>Housing</span><b>[+ housing_minister_party +] · [+ housing_minister +]</b></div>
<div><span>Health</span><b>[+ health_minister_party +] · [+ health_minister +]</b></div>
<div><span>Digital Affairs</span><b>[+ digital_minister_party +] · [+ digital_minister +]</b></div>
<div><span>Science</span><b>[+ science_minister_party +] · [+ science_minister +]</b></div>
<div><span>Interior & Administration</span><b>[+ interior_minister_party +] · [+ interior_minister +]</b></div>
<div><span>Finance</span><b>[+ finance_minister_party +] · [+ finance_minister +]</b></div>
<div><span>Development & Technology</span><b>[+ economy_minister_party +] · [+ economy_minister +]</b></div>
<div><span>Justice</span><b>[+ justice_minister_party +] · [+ justice_minister +]</b></div>
<div><span>Foreign Affairs</span><b>[+ foreign_minister_party +] · [+ foreign_minister +]</b></div>
<div><span>Agriculture & Rural Development</span><b>[+ agriculture_minister_party +] · [+ agriculture_minister +]</b></div>
<div><span>National Defence</span><b>[+ defence_minister_party +] · [+ defence_minister +]</b></div>
</div>

- @negotiate_psl_agriculture_release
- #poland_ministry_take
- #poland_ministry_drop
- @finalize

@negotiate_psl_agriculture_release
title: Negotiate PSL's Agriculture claim
subtitle: 3 leverage · converts a hard claim into a ministry available for a later ten-leverage demand
view-if: ministry_psl_in_cabinet = 1 and psl_agriculture_released != 1 and agriculture_minister_party != "Lewica"
choose-if: ministry_leverage_debt = 0 and ministry_leverage >= 3 and psl_relation >= 40
unavailable-subtitle: Requires three free leverage, no leverage debt and a workable PSL relationship.
on-arrival: {!
const finiteMinistry = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
Q.ministry_leverage = finiteMinistry(Q.ministry_leverage, 0) - 3;
Q.psl_agriculture_released = 1;
Q.psl_relation = finiteMinistry(Q.psl_relation, 0) + 2;
Q.psl_coalition_dissent = Math.max(
    0,
    finiteMinistry(Q.psl_coalition_dissent, 0) - 1
);
Q.news_headline =
    "PSL accepts compensation for releasing its Agriculture claim";
!}
go-to: menu

@take_labor
title: Take Labour & Social Policy
subtitle: 5 leverage · [+ ministry_labor_nominee +]
tags: poland_ministry_take
view-if: labor_minister_party != "Lewica"
choose-if: ministry_leverage_debt = 0 and ministry_leverage >= 5
unavailable-subtitle: Requires 5 free leverage and no leverage debt.
on-arrival: {!
const finiteMinistry = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const owner = String(
    Q.ministry_labor_current_owner_code ||
    Q.ministry_labor_baseline_owner_code || "cabinet"
);
Q.ministry_labor_taken_from_code = owner;
Q.ministry_labor_penalty_active = 0;
Q.ministry_labor_penalty_relation = 0;
Q.ministry_labor_penalty_partner_dissent = 0;
Q.ministry_labor_penalty_general_dissent = 0;
if (["pis", "ko", "psl", "p2050"].includes(owner)) {
    Q[owner + "_relation"] = finiteMinistry(Q[owner + "_relation"], 0) - 1;
    Q[owner + "_coalition_dissent"] =
        finiteMinistry(Q[owner + "_coalition_dissent"], 0) + 1;
    Q.government_coalition_dissent =
        finiteMinistry(Q.government_coalition_dissent, 0) + 0;
    Q.ministry_labor_penalty_active = 1;
    Q.ministry_labor_penalty_relation = 1;
    Q.ministry_labor_penalty_partner_dissent = 1;
    Q.ministry_labor_penalty_general_dissent = 0;
}
Q.ministry_leverage -= 5;
Q.ministry_count += 1;
Q.ministry_reshuffle_changes += 1;
Q.labor_minister_party = "Lewica";
Q.labor_minister = Q.ministry_labor_nominee;
Q.ministry_labor_current_owner_code = "lewica";
Q.ministry_labor_source_party_code = owner;
Q.family_minister_party = "Lewica";
Q.family_minister = Q.ministry_labor_nominee;
!}
go-to: menu

