@drop_labor
title: Return Labour & Social Policy
tags: poland_ministry_drop
view-if: labor_minister_party = "Lewica"
on-arrival: {!
const finiteMinistry = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const debtBefore = Math.max(0, finiteMinistry(Q.ministry_leverage_debt, 0));
const debtPaid = Math.min(debtBefore, 5);
Q.ministry_leverage_debt = debtBefore - debtPaid;
Q.ministry_leverage = finiteMinistry(Q.ministry_leverage, 0) +
    (5 - debtPaid);
const owner = String(
    Q.ministry_labor_taken_from_code ||
    Q.ministry_labor_source_party_code ||
    Q.ministry_labor_baseline_owner_code || "cabinet"
);
const ownerStillPartner =
    (owner == "pis" && Q.ministry_pis_in_cabinet) ||
    (owner == "ko" && Q.ministry_ko_in_cabinet) ||
    (owner == "psl" && Q.ministry_psl_in_cabinet) ||
    (owner == "p2050" && Q.ministry_p2050_in_cabinet);
if (Q.ministry_labor_penalty_active && ownerStillPartner) {
    Q[owner + "_relation"] = finiteMinistry(Q[owner + "_relation"], 0) +
        finiteMinistry(Q.ministry_labor_penalty_relation, 0);
    Q[owner + "_coalition_dissent"] = Math.max(
        0,
        finiteMinistry(Q[owner + "_coalition_dissent"], 0) -
            finiteMinistry(Q.ministry_labor_penalty_partner_dissent, 0)
    );
    Q.government_coalition_dissent = Math.max(
        0,
        finiteMinistry(Q.government_coalition_dissent, 0) -
            finiteMinistry(Q.ministry_labor_penalty_general_dissent, 0)
    );
}
Q.labor_minister_party = Q.ministry_labor_baseline_party;
Q.labor_minister = Q.ministry_labor_baseline_minister;
Q.ministry_labor_current_owner_code =
    Q.ministry_labor_baseline_owner_code;
Q.ministry_labor_source_party_code =
    Q.ministry_labor_baseline_owner_code;
Q.ministry_labor_taken_from_code = "";
Q.ministry_labor_penalty_active = 0;
Q.ministry_labor_penalty_relation = 0;
Q.ministry_labor_penalty_partner_dissent = 0;
Q.ministry_labor_penalty_general_dissent = 0;
Q.ministry_count = Math.max(0, finiteMinistry(Q.ministry_count, 0) - 1);
Q.ministry_reshuffle_changes += 1;
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;
!}
go-to: menu

