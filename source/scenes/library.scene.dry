@polling
title: Poll tracker
go-to: menu
on-display: {!
if (
    typeof window != "undefined" &&
    typeof d3 != "undefined" &&
    typeof d3.linegraph == "function"
) {
    const svg = document.getElementById("dossier-poll-history");
    const content = document.getElementById("content");
    const records = Array.isArray(Q.poll_history) ? Q.poll_history : [];
    if (svg && content && records.length) {
        const allSeries = [
            "left", "ko", "p2050", "psl", "pis", "konf", "p0", "other"
        ];
        const activeSeries = allSeries.filter(function(party) {
            return records.some(function(record) {
                return Number(record[party]) > 0;
            });
        });
        const styles = window.getComputedStyle(document.body);
        const color = function(name, fallback) {
            return styles.getPropertyValue(name).trim() || fallback;
        };
        const colors = {
            left: color("--party-lewica", "#ac145a"),
            ko: color("--party-ko", "#cf6200"),
            p2050: color("--party-p2050", "#806200"),
            psl: color("--party-psl", "#157a32"),
            pis: color("--party-pis", "#073a76"),
            konf: color("--party-konf", "#29384f"),
            p0: color("--party-p0", "#111"),
            other: color("--party-independent", "#666")
        };
        const names = {
            left: Q.left_party_name || "Lewica",
            ko: "KO",
            p2050: "PL2050",
            psl: "PSL",
            pis: "PiS",
            konf: "Konf.",
            p0: Q.p0_short_name || "P0",
            other: "Other"
        };
        const maximum = Math.max.apply(null, records.map(function(record) {
            return Math.max.apply(null, activeSeries.map(function(party) {
                return Number(record[party]) || 0;
            }));
        }));
        const width = Math.max(300, Math.min(720, content.offsetWidth - 24));
        const height = Math.max(280, Math.round(width * 0.56));
        svg.style.height = height + "px";
        d3.select(svg).selectAll("*").remove();
        const lines = d3.linegraph(
            true,
            records.length > 24,
            activeSeries,
            colors,
            names,
            Math.max(10, Math.ceil((maximum + 3) / 5) * 5),
            0,
            2
        );
        lines.width(width).height(height);
        d3.select(svg).datum(records).call(lines);
    }
}
!}

