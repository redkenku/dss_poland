@parliament
title: Sejm and Senate
go-to: menu
on-arrival: {!
const dossierSeat = function(value) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? Math.max(0, Math.round(parsed)) : 0;
};
const dossierSeatEntry = function(id, legend, name, value) {
    return {id: id, legend: legend, name: name, seats: dossierSeat(value)};
};
const sejmEntries = [
    dossierSeatEntry("left", "Lewica", Q.left_party_name || "Lewica", Q.left_seats),
    dossierSeatEntry("sld_breakaway", "SLD", Q.barons_party_name || "SLD breakaway", Q.sld_breakaway_seats),
    dossierSeatEntry("social_patriot", "LP", Q.social_patriot_party_name || "Lewica Patriotyczna", Q.social_patriot_seats),
    dossierSeatEntry("spring_breakaway", "Wiosna", Q.spring_party_name || "Wiosna breakaway", Q.spring_breakaway_seats),
    dossierSeatEntry("labor_left", "Labour", Q.labor_party_name || "Labour Left", Q.labor_left_seats),
    dossierSeatEntry("young_left", "Young Left", Q.progressives_party_name || "Young Left", Q.young_left_seats),
    dossierSeatEntry("razem", "Razem", "Razem", Q.razem_party_seats),
    dossierSeatEntry("pps", "PPS", "PPS", Q.pps_party_seats),
    dossierSeatEntry("tak_rozwoj", "Tak!", Q.tak_rozwoj_party_name || "Tak! Dla Rozwoju", Q.tak_rozwoj_seats),
    dossierSeatEntry("ko", "KO", "Koalicja Obywatelska", Q.ko_seats),
    dossierSeatEntry("ko_splinter", "KO split", "KO breakaway", Q.ko_splinter_seats),
    dossierSeatEntry("p2050", "PL2050", "Polska 2050", Q.p2050_joined_left ? 0 : Q.p2050_seats),
    dossierSeatEntry("centrum", "Centrum", "Unia Centrum", Q.centrum_seats),
    dossierSeatEntry("psl", "PSL", "Polskie Stronnictwo Ludowe", Q.psl_seats),
    dossierSeatEntry("porozumienie", "Agreement", "Porozumienie", Q.porozumienie_seats),
    dossierSeatEntry("kukiz", "Kukiz", "Kukiz'15", Q.kukiz_seats),
    dossierSeatEntry("pis", "PiS", "Prawo i Sprawiedliwość", Q.pis_seats),
    dossierSeatEntry("rozwoj", "Rozwój+", "Rozwój Plus", Q.rozwoj_joined_left ? 0 : Q.rozwoj_seats),
    dossierSeatEntry("suwerenna", "SP", "Suwerenna Polska", Q.suwerenna_merged ? 0 : Q.suwerenna_seats),
    dossierSeatEntry("konf", "Konf.", "Konfederacja", Q.konf_seats),
    dossierSeatEntry("korona", "Korona", "Korona", Q.korona_seats),
    dossierSeatEntry("other", "Other", "Other and independent MPs", Q.other_seats)
];
Q.dossier_sejm_chart_data = sejmEntries.filter(function(entry) {
    return entry.seats > 0;
});
Q.dossier_sejm_recorded_total = Q.dossier_sejm_chart_data.reduce(
    function(total, entry) { return total + entry.seats; },
    0
);
Q.dossier_sejm_delta = Q.dossier_sejm_total - Q.dossier_sejm_recorded_total;

const senateEntries = [
    dossierSeatEntry("left", "Left", Q.left_party_name || "Left", Q.senate_left_seats),
    dossierSeatEntry("ko", "KO", "Koalicja Obywatelska", Q.senate_ko_seats),
    dossierSeatEntry("p2050", "PL2050", "Polska 2050", Q.p2050_joined_left ? 0 : Q.senate_p2050_seats),
    dossierSeatEntry("psl", "PSL", "Polskie Stronnictwo Ludowe", Q.senate_psl_seats),
    dossierSeatEntry("independent", "Independent", "Independent senators", Q.senate_independent_seats),
    dossierSeatEntry("pis", "PiS", "Prawo i Sprawiedliwość", Q.senate_pis_seats),
    dossierSeatEntry("konf", "Konf.", "Konfederacja", Q.senate_konf_seats)
];
Q.dossier_senate_chart_data = senateEntries.filter(function(entry) {
    return entry.seats > 0;
});
Q.dossier_senate_recorded_total = Q.dossier_senate_chart_data.reduce(
    function(total, entry) { return total + entry.seats; },
    0
);
Q.dossier_senate_delta = Q.dossier_senate_total -
    Q.dossier_senate_recorded_total;
!}
on-display: {!
const drawDossierParliament = function(selector, data) {
    if (
        typeof window == "undefined" ||
        typeof d3 == "undefined" ||
        typeof d3.parliament != "function"
    ) return;
    const svg = document.querySelector(selector);
    const content = document.getElementById("content");
    if (!svg || !content || !data.length) return;
    const panelWidth = svg.parentElement
        ? svg.parentElement.clientWidth - 24
        : content.offsetWidth - 32;
    const width = Math.max(240, Math.min(500, panelWidth));
    svg.style.height = Math.round(width / 2) + "px";
    d3.select(svg).selectAll("*").remove();
    const parliament = d3.parliament();
    parliament.width(width).height(width / 2).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(false).smallToBig(false);
    parliament.exit.toCenter(false).bigToSmall(false);
    d3.select(svg).datum(data).call(parliament);
};
drawDossierParliament("#dossier-sejm", Q.dossier_sejm_chart_data || []);
drawDossierParliament("#dossier-senate", Q.dossier_senate_chart_data || []);
!}

= Parliament — current seats

