title: Polish dossier
new-page: true
is-special: true
call: poland_normalize
go-to: menu

@menu
on-arrival: {!
const dossierNumber = function(value, fallback) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
};
const dossierWhole = function(value, fallback) {
    return Math.round(dossierNumber(value, fallback));
};
const dossierDecimal = function(value, fallback) {
    return Math.round(dossierNumber(value, fallback) * 10) / 10;
};
const dossierText = function(value, fallback) {
    return typeof value == "string" && value.trim().length
        ? value
        : fallback;
};

Q.dossier_date = dossierText(Q.date_label, "October 2019");
Q.dossier_headline = dossierText(
    Q.news_headline,
    "The Left returns to the Sejm"
);
Q.dossier_left_party = dossierText(Q.left_party_name, "Lewica");
Q.dossier_left_leader = dossierText(Q.left_leader, "Collective leadership");
Q.dossier_president = dossierText(Q.president_name, "Andrzej Duda");
Q.dossier_prime_minister = dossierText(
    Q.prime_minister,
    "Mateusz Morawiecki"
);
Q.dossier_government = dossierText(Q.government_name, "Government not recorded");
Q.dossier_left_role = dossierText(Q.left_role, Q.position || "Opposition");
Q.dossier_sejm_speaker = dossierText(Q.sejm_speaker, "Office not recorded");
Q.dossier_senate_marshal = dossierText(
    Q.senate_marshal,
    "Office not recorded"
);
Q.dossier_sejm_total = Math.max(1, dossierWhole(Q.sejm_total, 460));
Q.dossier_senate_total = Math.max(1, dossierWhole(Q.senate_total, 100));
Q.dossier_sejm_majority = Math.floor(Q.dossier_sejm_total / 2) + 1;
Q.dossier_senate_majority = Math.floor(Q.dossier_senate_total / 2) + 1;
Q.dossier_left_seats = Math.max(0, dossierWhole(Q.left_seats, 49));
Q.dossier_left_poll = dossierDecimal(Q.left_poll, 12.6);
Q.dossier_party_unity = dossierWhole(Q.party_unity, 58);
Q.dossier_resources = dossierWhole(Q.resources, 0);
Q.dossier_public_trust = dossierWhole(Q.public_trust, 43);
Q.dossier_ministry_count = dossierWhole(Q.ministry_count, 0);
Q.dossier_poll_updated = dossierText(Q.poll_last_updated, "Opening baseline");
Q.dossier_poll_sample = dossierWhole(Q.poll_sample_size, 1400);
Q.dossier_poll_margin = dossierDecimal(Q.poll_margin_error, 2.6);
Q.dossier_coalition_seats = Math.max(0, dossierWhole(Q.coalition_seats, 0));

const dossierPortfolioLabels = {
    labor: "Labour & Social Policy",
    equality: "Equality",
    housing: "Housing",
    health: "Health",
    digital: "Digital Affairs",
    science: "Science",
    interior: "Interior & Administration",
    finance: "Finance",
    economy: "Development & Technology",
    justice: "Justice",
    foreign: "Foreign Affairs",
    agriculture: "Agriculture & Rural Development",
    defence: "National Defence"
};
for (const portfolio of Object.keys(dossierPortfolioLabels)) {
    const minister = dossierText(Q[portfolio + "_minister"], "Unassigned");
    const party = dossierText(Q[portfolio + "_minister_party"], "Unassigned");
    const individuallyTracked = minister != "Unassigned" && party != "Unassigned";
    Q["dossier_" + portfolio + "_label"] =
        dossierPortfolioLabels[portfolio];
    Q["dossier_" + portfolio + "_minister"] = individuallyTracked
        ? minister
        : "Not individually tracked in this chapter";
    Q["dossier_" + portfolio + "_party"] = individuallyTracked
        ? party
        : "—";
}

// Old saves did not have a polling ledger. Seed one honest point instead of
// inventing a trend; future monthly poll rebuilds append to it.
if (!Array.isArray(Q.poll_history)) Q.poll_history = [];
if (!Q.poll_history.length) {
    const month = String(Math.max(1, dossierWhole(Q.month, 10)));
    Q.poll_history.push({
        date: dossierWhole(Q.year, 2019) + "-" +
            (month.length < 2 ? "0" + month : month) + "-01",
        label: Q.dossier_date,
        left: dossierDecimal(Q.left_poll, 12.6),
        pis: dossierDecimal(Q.pis_poll, 43.6),
        ko: dossierDecimal(Q.ko_poll, 27.4),
        psl: dossierDecimal(Q.psl_poll, 8.6),
        p2050: dossierDecimal(Q.p2050_poll, 0),
        p0: dossierDecimal(Q.p0_poll, 0),
        konf: dossierDecimal(Q.konf_poll, 6.8),
        other: dossierDecimal(Q.other_poll, 1)
    });
}
Q.dossier_poll_points = Q.poll_history.length;
!}

= Polish dossier

<div class="dossier-hero">
<span class="dossier-kicker">[+ dossier_date +] · live state</span>
<b>[+ dossier_headline +]</b>
<p>This dossier follows the current campaign state. Seats, officeholders,
polls and ministries update when the political simulation changes.</p>
</div>

- @overview: Situation room
- @parliament: Sejm and Senate charts
- @cabinet: Council of Ministers
- @polling: Poll tracker and seat projection
- @parties: Parties, leaders and Left caucuses
- @institutions: Constitutional institutions
- @economy: Party resources and the state budget
- @foreign: External affairs
- @rules: How the campaign works
- @backSpecialScene: Close the dossier

@overview
title: Situation room
go-to: menu

= Situation room — [+ dossier_date +]

<div class="dossier-kpi-grid">
