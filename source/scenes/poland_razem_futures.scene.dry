Q.climate_state_capacity += 3;
Q.labor_credibility += 5;
Q.union_trust += 6;
Q.opzz_cooperation += 4;
Q.workers_support += 4;
Q.rural_support += 2;
Q.budget_promises += 3;
Q.progressives_dissent -= 2;
Q.pps_dissent -= 3;
Q.barons_dissent += 3;
Q.pis_relation -= 2;
Q.ko_relation -= 2;
Q.razem_cooperation += 5;
if (Q.matysiak_project_party == "Tak! Dla Rozwoju") {
    Q.tak_rozwoj_list_committee = "left";
    Q.tak_rozwoj_parent_relation += 18;
    Q.tak_rozwoj_poll_momentum += 0.5;
    Q.tak_rozwoj_ai_strategy = "Seek a labour-development compact with the Left";
} else {
    Q.razem_poll_momentum = (Number(Q.razem_poll_momentum) || 0) + 0.5;
}
Q.matysiak_project_ai_state = "Union-backed national investment programme";
Q.news_headline =
    "Matysiak binds rail, nuclear power and regional investment to bargaining rights";
!}

Lewica Pracy, PPS and the unions sign because procurement and state aid now
carry bargaining clauses. Wspólne Jutro accepts the green-industry timetable
without endorsing Matysiak's cultural instincts. The programme gains governing
weight and an expensive implementation ledger.

- @poland_event_queue: Publish the labour-development compact

@matysiak_sovereignty
title: Build a sovereign infrastructure bloc outside liberal timetables
subtitle: Advantage: regional reach and a cross-pressure on PiS. Cost: progressive credibility and cooperation with the broader Left.
on-arrival: {!
Q.matysiak_future_decision_done = 1;
Q.matysiak_future_strategy = "Sovereign infrastructure bloc";
Q.matysiak_infrastructure_program += 7;
Q.matysiak_nuclear_program += 7;
Q.matysiak_regional_program += 6;
Q.administrative_capacity += 3;
Q.energy_security += 4;
Q.rural_support += 5;
Q.workers_support += 2;
Q.social_patriot_support += 6;
Q.progressive_credibility -= 6;
Q.feminist_trust -= 4;
Q.progressives_dissent += 8;
Q.pps_dissent += 4;
Q.union_trust -= 2;
Q.pis_relation += 6;
Q.ko_relation -= 6;
Q.razem_cooperation -= 7;
if (Q.matysiak_project_party == "Tak! Dla Rozwoju") {
    Q.tak_rozwoj_list_committee = "tak_rozwoj";
    Q.tak_rozwoj_parent_relation -= 8;
    Q.tak_rozwoj_organisation =
        (Number(Q.tak_rozwoj_organisation) || 20) + 6;
    Q.tak_rozwoj_poll_momentum += 1.0;
    Q.tak_rozwoj_ai_strategy = "Contest a sovereign development campaign";
} else {
    Q.razem_poll_momentum = (Number(Q.razem_poll_momentum) || 0) + 0.9;
}
Q.matysiak_project_ai_state = "Sovereign regional infrastructure campaign";
Q.news_headline =
    "Matysiak builds a sovereign infrastructure bloc against liberal timetables";
!}

Regional investment committees and nuclear advocates give the project an
electorate that neither PiS nor the liberal opposition can ignore. Labour stays
for the jobs case but refuses to call procurement a substitute for bargaining.
Progressives and Wspólne Jutro treat cooperation as exceptional rather than
presumed.

- @poland_event_queue: Open the sovereign infrastructure campaign

@zandberg_election_payoff
# prose-audit: Grade A — The earlier strategy returns as an authored election endpoint and hands only momentum, organisation and list form to the shared count.
title: Zandberg takes the socialist project to its next election
subtitle: Convert the movement-or-list choice into organisation, polling momentum and a final endpoint.
new-page: true
tags: poland_event
priority: 62
order: 2
max-visits: 1
view-if: continuous_campaign = 1 and zandberg_project_active = 1 and zandberg_future_decision_done = 1 and zandberg_election_payoff_done = 0 and ((snap_campaign_active = 1) or (year = 2027 and month = 9 and snap_election_cycle = 0))
on-arrival: {!
const movementRoute = Q.zandberg_future_strategy == "Movement socialist councils";
const programme =
    (Number(Q.zandberg_housing_program) || 0) +
    (Number(Q.zandberg_public_ownership_program) || 0) +
    (Number(Q.zandberg_green_industry_program) || 0);
const payoff = Math.max(
    0.4,
    Math.min(
        2.4,
        0.35 + programme * 0.055 +
            (Number(Q.labor_credibility) || 0) * 0.008 +
            (movementRoute ? (Number(Q.organiser_energy) || 0) * 0.01 : 0.35)
    )
);
Q.zandberg_election_payoff_done = 1;
Q.zandberg_election_advantage = Math.round(payoff * 100) / 100;
if (Q.zandberg_project_party == "Akcja Socjalistyczna") {
    Q.tak_rozwoj_poll_momentum += payoff;
    Q.tak_rozwoj_organisation =
        (Number(Q.tak_rozwoj_organisation) || 20) +
        (movementRoute ? 6 : 2);
    Q.zandberg_election_endpoint = movementRoute
        ? "Akcja enters the election as an organised movement on its own five-percent committee"
        : "Akcja carries a protected socialist component on the common Left list";
} else if (Q.razem_party_formed) {
    Q.razem_poll_momentum =
        (Number(Q.razem_poll_momentum) || 0) + payoff;
    Q.zandberg_election_endpoint = movementRoute
        ? "Zandberg's Razem contests as a movement-rooted independent socialist party"
        : "Zandberg's Razem enters a protected Left coalition committee";
} else {
    Q.left_poll_momentum =
        (Number(Q.left_poll_momentum) || 0) + payoff * 0.7;
    Q.snap_campaign_left_bonus += payoff * 0.35;
    Q.zandberg_election_endpoint =
        "Zandberg's socialist Razem current strengthens the common Left campaign";
}
Q.poll_state_month_key = -1;
Q.news_headline = Q.zandberg_election_endpoint;
!}

= The socialist ledger closes

**[+ zandberg_election_endpoint +].** Housing, public ownership, labour power
and green industry now produce a measurable election advantage of **[+
zandberg_election_advantage +] points** in the project's own or host committee.
[? if zandberg_future_strategy = "Movement socialist councils": The
organisation is deeper and the threshold risk remains its political cost.?]
[? if zandberg_future_strategy = "Socialist electoral compact": Protected
list access answers the survival problem and leaves activists asking how much
independence the answer consumed.?]

- @poland_event_queue: Hand the socialist project to the election system

