@right_reunification_2027
# scenario-ledger: PIS-13, PIS-14
# prose-audit: Grade A — Live organisations negotiate one committee without silently dissolving their parties; a welfare-conservative vehicle activates only from an independent current and real PSL cooperation.
title: The right attempts a 2027 reunification congress
subtitle: PiS, Rozwój+, Konfederacja and Korona bargain over one committee, list shares and a named premiership
new-page: true
tags: poland_event
priority: 38
order: 48
max-visits: 1
view-if: continuous_campaign = 1 and year = 2027 and month >= 5 and pis_alternative_stage >= 1 and election_2027_terminal = 0
on-arrival: {!
const groups = Q.rival_group_records || [];
const get = function(id) { return groups.find(function(record) { return record.id == id; }); };
const rightCongressIds = ["pis_party", "rozwoj_plus"].concat(
    Q.mentzen_bosak_split == 1
        ? ["nowa_nadzieja", "ruch_narodowy"]
        : ["konf_committee"]
).concat(["kkp"]);
const liveIds = rightCongressIds.filter(function(id) {
    const record = get(id);
    return record && record.active;
});
const namedPremier = [Q.pis_leader, "Mateusz Morawiecki", "Beata Szydło"].find(function(name) {
    return name && name != Q.president_name && name != Q.prime_minister &&
        !["Jarosław Kaczyński", "Zbigniew Ziobro", "Przemysław Czarnek"].includes(name);
}) || "Mariusz Błaszczak";
const organisation = liveIds.reduce(function(total, id) {
    return total + Number(get(id).organisation || 0);
}, 0);
const succeeds = liveIds.length >= 2 && organisation >= 95 &&
    Number(Q.far_right_fragmentation || 0) < 85;
if (succeeds) {
    for (const id of liveIds) {
        const record = get(id);
        record.list_committee = "right_2027";
        record.contesting = 1;
        record.projected_seats = 0;
        record.negotiated_list_share = Math.round(
            Math.max(1, Number(record.organisation) || 0) * 100 /
            Math.max(1, organisation)
        );
    }
    Q.right_reunification_outcome = "Shared Right 2027 committee under premier nominee " + namedPremier;
} else {
    for (const id of liveIds) {
        const record = get(id);
        record.list_committee = id;
        record.contesting = 1;
    }
    Q.right_reunification_outcome = "Reunification fails over list places and the premiership";
}
const welfare = get("pis_welfare");
if (welfare && welfare.independent && Number(Q.psl_relation || 0) >= 60) {
    welfare.kind = "party";
    welfare.active = 1;
    welfare.contesting = 1;
    welfare.ballot_name = "Solidarna Polska Społeczna";
    welfare.list_committee = "social_conservative_2027";
    welfare.coalition_openness = 58;
    welfare.exclusive_seats = Math.min(3, Number(welfare.exclusive_seats || 0));
}
Q.pis_alternative_stage = 2;
Q.news_headline = Q.right_reunification_outcome;
!}

