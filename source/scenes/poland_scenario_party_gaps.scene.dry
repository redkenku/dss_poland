title: Audited party and legal scenario chains

@mentzen_bosak_rupture
# scenario-ledger: FAR-01
# prose-audit: Grade A — The federation's live organisations and declared mandates determine the rupture before Lewica chooses its response; no choice assigns guilt, leaders or undeclared MPs.
title: Mentzen and Bosak stop sharing a federation
subtitle: New Hope and National Movement have machines of their own; the argument is now about lists and MPs
new-page: true
tags: poland_event
priority: 38
order: 40
max-visits: 1
view-if: continuous_campaign = 1 and year >= 2025 and mentzen_bosak_split = 0 and konf_seats >= 4 and election_2027_terminal = 0 and (far_right_fragmentation >= 60 or (trz_freebie_law != "" and trz_freebie_realign_pressure >= 75 and far_right_fragmentation >= 35 and (trz_freebie_konf_hegemon = 1 or ministry_konf_in_cabinet = 1 or government_party = "konf")))
on-arrival: {!
const group = function(id) {
    return (Q.rival_group_records || []).find(function(record) {
        return record.id == id;
    });
};
const newHope = group("nowa_nadzieja");
const national = group("ruch_narodowy");
const canRupture = newHope && national &&
    Number(newHope.organisation) >= 28 &&
    Number(national.organisation) >= 28;
Q.mentzen_bosak_split = canRupture ? 1 : -1;
if (canRupture) {
    const movable = Math.max(0, Math.round(Number(Q.konf_seats) || 0));
    const mentzenWeight = Math.max(1, Number(newHope.organisation) || 0);
    const bosakWeight = Math.max(1, Number(national.organisation) || 0);
    const mentzenSeats = Math.max(
        1,
        Math.min(
            movable - 1,
            Math.round(movable * mentzenWeight /
                Math.max(1, mentzenWeight + bosakWeight))
        )
    );
    const bosakSeats = movable - mentzenSeats;
    Q.konf_seats = 0;
    Q.new_hope_seats = mentzenSeats;
    Q.national_movement_seats = bosakSeats;
    Q.konf_family_seats = movable;
    newHope.active = 1;
    newHope.contesting = 1;
    newHope.leader = "Sławomir Mentzen";
    newHope.list_committee = "new_hope";
    newHope.club = "new_hope";
    newHope.exclusive_seats = mentzenSeats;
    newHope.sejm_mps = mentzenSeats;
    newHope.mp_count = mentzenSeats;
    national.active = 1;
    national.contesting = 1;
    national.list_committee = "national_movement";
    national.club = "national_movement";
    national.exclusive_seats = bosakSeats;
    national.sejm_mps = bosakSeats;
    national.mp_count = bosakSeats;
    const committee = group("konf_committee");
    if (committee) committee.contesting = 0;
    Q.far_right_fragmentation += 9;
    Q.news_headline = "Mentzen and Bosak file separate committees after a declared-MP walkout";
} else {
    Q.far_right_fragmentation -= 5;
    Q.news_headline = "The Konfederacja congress contains a rupture its component machines cannot finance";
}
!}

= [+ date_label +] — The federation counts its component parties

[? if mentzen_bosak_split = 1: **Sławomir Mentzen's New Hope** and **Krzysztof
Bosak's National Movement** file separate committees. Every remaining
Konfederacja MP signs one of the two parliamentary declarations; Korona
remains a third organisation if it previously left. The old Konfederacja
committee does not appear as an extra line beside its components.?][? if mentzen_bosak_split = -1: Both currents possess an
organisation, but not enough independent finance and signatures to survive a
three-way ballot. The congress preserves the shared committee while recording
separate list quotas.?]

