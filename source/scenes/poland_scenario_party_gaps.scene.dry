    } else {
        Q.psl_leader = "PSL regional council";
        Q.psl_leader_route = "Collective regional-machine leadership";
    }
    Q.psl_congress_route = Q.psl_leader_route;
    if (psl) psl.leader = Q.psl_leader;
}
Q.psl_outcome = Q.psl_congress_route;
Q.psl_stage = 3;
Q.psl_done = 1;
Q.news_headline = "PSL congress: " + Q.psl_congress_route;
!}

