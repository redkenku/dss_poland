} else {
    const humiliation = Number(Q.psl_poll || 0) < 5 ||
        Number(Q.psl_coalition_dissent || 0) >= 65 ||
        Number(Q.psl_bridge_votes || 0) < 231;
    if (humiliation && Number(Q.psl_relation || 0) < 42) {
        Q.psl_leader = "Piotr Zgorzelski";
        Q.psl_leader_route = "Zgorzelski conservative bridge";
    } else if (humiliation && Number(Q.rural_support || 0) >= 48) {
