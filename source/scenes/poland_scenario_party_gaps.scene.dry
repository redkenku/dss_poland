on-arrival: {!
const forbidden = ["Jarosław Kaczyński", "Zbigniew Ziobro", "Przemysław Czarnek"];
let candidate = String(Q.pis_leader || "Mateusz Morawiecki");
if (forbidden.includes(candidate)) candidate = "Beata Szydło";
const rightVotes = Math.max(0, Number(Q.pis_seats) || 0) +
    Math.max(0, Number(Q.konf_seats) || 0) +
    Math.max(0, Number(Q.psl_seats) || 0) +
    Math.max(0, Number(Q.rozwoj_seats) || 0) +
    Math.max(0, Number(Q.suwerenna_seats) || 0);
Q.psl_bridge_candidate = candidate;
Q.psl_bridge_votes = Math.round(rightVotes);
Q.psl_outcome = rightVotes >= 231
    ? "A constructive-motion draft names " + candidate + " with " + Math.round(rightVotes) + " declared votes"
    : "Centre-right talks stop at leverage with only " + Math.round(rightVotes) + " plausible votes";
Q.psl_stage = 2;
Q.psl_due_time = Number(Q.time) + 5;
Q.news_headline = Q.psl_outcome;
!}

