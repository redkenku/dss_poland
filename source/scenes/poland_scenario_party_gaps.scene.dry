    Number(morawiecki && morawiecki.relation || 0) * 0.3 -
    Math.max(0, Number(Q.pis_collapse_pressure || 0) - 60) * 0.4;
Q.pis_morawiecki_reconciled = score >= 48 ? 1 : 0;
if (morawiecki) {
    morawiecki.relation += Q.pis_morawiecki_reconciled ? 9 : -5;
    morawiecki.cohesion += Q.pis_morawiecki_reconciled ? 5 : 2;
}
if (apparatus) apparatus.relation += Q.pis_morawiecki_reconciled ? 4 : -3;
Q.pis_alternative_stage = 1;
Q.news_headline = Q.pis_morawiecki_reconciled
    ? "Morawiecki secures a pre-congress reconciliation protocol"
    : "Morawiecki's reconciliation offer fails over delegate guarantees";
!}

