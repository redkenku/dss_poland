@braun_first_instance
# scenario-ledger: FAR-07, FAR-08, FAR-09
# prose-audit: Grade A — The first-instance result and KKP succession are calculated from stored evidence and organisation before Lewica responds; the appeal is explicitly deferred to the narrative epilogue.
title: The Braun files reach first instance
subtitle: One stored evidentiary result produces a judgment, an adjournment or acquittal and fixes Korona's succession problem
new-page: true
tags: poland_event
priority: 48
order: 42
max-visits: 1
view-if: continuous_campaign = 1 and braun_stage = 3 and time >= braun_due_time and braun_done = 0 and election_2027_terminal = 0
on-arrival: {!
const evidence = Number(Q.braun_legal_preparation || 0) * 2 +
    Number(Q.prosecution_independence || 0) * 0.22 +
    Number(Q.government_procedural_restraint || 0) * 0.12 -
    Number(Q.braun_martyrdom || 0) * 0.08 +
    ((Number(Q.braun_legal_roll) || 0) - 500) / 45;
if (evidence >= 32) {
    Q.braun_outcome = "A reasoned first-instance conviction on the supported counts; unsupported counts are dismissed";
    Q.braun_appeal_status = "Conviction under appeal after the election";
} else if (evidence >= 13) {
    Q.braun_outcome = "The court adjourns the contested counts and dismisses the weakest ones";
    Q.braun_appeal_status = "Unresolved counts projected after the election";
} else {
    Q.braun_outcome = "The court acquits on the surviving record";
    Q.braun_appeal_status = "Prosecutorial appeal possible after the election";
}
const kkp = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "kkp";
});
if (kkp && (Q.braun_outcome.includes("conviction") || Q.braun_outcome.includes("adjourns") || Q.braun_outcome.includes("leaves Poland"))) {
    kkp.leader = Number(kkp.organisation || 0) >= 45
        ? "Włodzimierz Skalik"
        : "a collective Korona council";
    kkp.cohesion = Math.max(20, Number(kkp.cohesion || 0) - 9);
}
Q.braun_stage = 4;
Q.braun_done = 1;
Q.news_headline = Q.braun_outcome;
!}

