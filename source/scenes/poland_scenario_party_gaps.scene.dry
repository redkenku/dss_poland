    return record && record.id == "psl_party";
});
const p2050 = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "p2050_party";
});
const permanent = Q.third_way_active && psl && p2050 &&
    Number(Q.third_way_cohesion || 0) >= 65 &&
    !String(Q.third_way_future || "").includes("common centre") &&
