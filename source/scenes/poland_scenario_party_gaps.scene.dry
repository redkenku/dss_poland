@third_way_alternatives_2027
# scenario-ledger: TD-06, TD-09, TD-10
# prose-audit: Grade A — Absorption, a common-centre committee and permanent Third Way are mutually exclusive organisational outcomes; Hołownia returns only if the live leader has lost authority and he holds no incompatible office.
title: The centre decides whether it is a party, a federation or one ballot line
subtitle: Poland 2050, PSL, KO and Unia Centrum retain separate records even when they share a committee
new-page: true
tags: poland_event
priority: 38
order: 49
max-visits: 1
view-if: continuous_campaign = 1 and year = 2027 and month >= 4 and third_way_alternative_stage = 0 and election_2027_terminal = 0
on-arrival: {!
const groups = Q.rival_group_records || [];
const get = function(id) { return groups.find(function(record) { return record.id == id; }); };
const psl = get("psl_party");
const p2050 = get("p2050_party");
const ko = get("ko_party");
if (Q.third_way_active && Number(Q.third_way_cohesion || 0) >= 65 && psl && p2050) {
    Q.third_way_alternative_outcome = "Permanent Third Way federation behind one committee";
    psl.list_committee = "third_way_2027";
    p2050.list_committee = "third_way_2027";
    psl.contesting = 1;
    p2050.contesting = 1;
    psl.negotiated_list_share = 55;
    p2050.negotiated_list_share = 45;
} else if (p2050 && Number(Q.p2050_poll || 0) < 4 && ko && Number(Q.ko_poll || 0) >= 22) {
    const declared = Math.min(3, Math.max(0, Number(Q.p2050_seats || 0)));
    Q.p2050_seats -= declared;
    Q.ko_seats += declared;
    p2050.exclusive_seats = Math.max(0, Number(p2050.exclusive_seats || 0) - declared);
    ko.exclusive_seats = Math.max(0, Number(ko.exclusive_seats || 0) + declared);
    p2050.organisation = Math.max(0, Number(p2050.organisation || 0) - 15);
    ko.organisation = Math.min(100, Number(ko.organisation || 0) + 6);
    Q.third_way_alternative_outcome = "Poland 2050 absorption into KO with " + declared + " declared MPs";
} else {
    if (ko) {
        ko.active = 1;
        ko.legal_status = "electoral alliance component on the common-centre list";
    }
    const centreRecords = [psl, p2050, ko, get("unia_centrum"),
        get("ko_splinter")].filter(function(record) {
        return record && record.active;
    });
    const centreSeats = centreRecords.reduce(function(total, record) {
        return total + Math.max(1, Number(record.exclusive_seats) ||
            Number(record.mp_count) || 0);
    }, 0);
    for (const record of centreRecords) {
        record.list_committee = "common_centre_2027";
        record.contesting = 1;
        record.negotiated_list_share = Math.round(
            Math.max(1, Number(record.exclusive_seats) ||
                Number(record.mp_count) || 0) * 100 /
            Math.max(1, centreSeats)
        );
    }
    Q.third_way_alternative_outcome = "Common-centre list preserving autonomous components";
}
const leaderWeak = Number(Q.p2050_coalition_dissent || 0) >= 60 ||
    Number(Q.p2050_poll || 0) < 4;
if (leaderWeak && Q.sejm_speaker != "Szymon Hołownia" &&
    Q.president_name != "Szymon Hołownia" && Q.prime_minister != "Szymon Hołownia" &&
    !Q.third_way_alternative_outcome.includes("absorption")) {
    Q.p2050_leader = "Szymon Hołownia";
    if (p2050) p2050.leader = "Szymon Hołownia";
    Q.third_way_alternative_outcome += "; Hołownia returns after the successor loses authority";
}
Q.third_way_alternative_stage = 1;
Q.news_headline = Q.third_way_alternative_outcome;
!}

= [+ date_label +] — Separate organisations, one arithmetic

