title: Leadership Table
new-page: true
is-hand: true
max-cards: 3
call: poland_normalize
go-to: poland_legacy_event_desk if poland_legacy_event_phase = 1; poland_events_2026.snap_election_2026 if poland_legacy_event_phase = 0 and continuous_campaign = 1 and snap_campaign_active = 0 and year <= 2022 and snap_election_held = 0 and time > snap_event_deferred_time and (snap_election_requested = 1 or (budget_deadline_active = 1 and budget_deadline_time >= 0 and time >= budget_deadline_time))
on-arrival: {!
Q.deckDescription = "Bring a question to the table";
Q.handDescription = "Open questions";
Q.pinnedCardsDescription = "Leadership bureau and standing actions";
if (!this.polandDecksUseFrequency) {
    const unweightedDrawFromDeck = this._drawFromDeck;
    this._drawFromDeck = function(deckId) {
        const weightedDecks = [
            "poland_party_deck",
            "poland_government_deck",
            "poland_negotiation_deck",
            "poland_major_reform_deck",
            "poland_foreign_deck"
        ];
        if (weightedDecks.indexOf(deckId) < 0) {
            return unweightedDrawFromDeck.call(this, deckId);
        }

        const deck = this.game.scenes[deckId];
        const currentHand =
            (this.state.currentHands[this.state.sceneId] || []).map(function(card) {
                return card.id;
            });
        let compiledChoices = this._compileChoices(deck) || [];
        if (
            !Q.major_reforms_complete &&
            (
                deckId == "poland_government_deck" ||
                deckId == "poland_negotiation_deck"
            )
        ) {
            compiledChoices = compiledChoices.concat(
                this._compileChoices(
                    this.game.scenes.poland_major_reform_deck
                ) || []
            );
        }
        const seenCards = {};
        const cards = compiledChoices.filter(function(choice) {
            const scene = this.game.scenes[choice.id];
            if (
                !choice.canChoose || !scene.isCard ||
                currentHand.indexOf(choice.id) >= 0 ||
                seenCards[choice.id]
            ) {
                return false;
            }
            seenCards[choice.id] = true;
            return true;
        }, this);
        const cardFrequency = function(card) {
            const frequency = this.game.scenes[card.id].frequency;
            return frequency == null ? 100 : frequency;
        }.bind(this);
        const totalFrequency = cards.reduce(function(total, card) {
            return total + cardFrequency(card);
        }, 0);
        let draw = this.random.random() * totalFrequency;

        for (const card of cards) {
            draw -= cardFrequency(card);
            if (draw < 0) return card;
        }
        return null;
    };
    this.polandDecksUseFrequency = true;
}
const hubHand =
    (this.state.currentHands &&
        this.state.currentHands["poland_hub"]) || [];
const hubMonthKey = Number(Q.year) * 100 + Number(Q.month);
Q.poland_hand_count = hubHand.length;
Q.poland_hand_full = hubHand.length >= 3 ? 1 : 0;
Q.poland_discard_used_this_month =
    Number(Q.poland_discard_month_key) == hubMonthKey ? 1 : 0;
Q.poland_discard_available =
    hubHand.length > 0 &&
    !Q.poland_discard_used_this_month &&
    Number(Q.resources) >= 1 &&
    Number(Q.month_actions) < Number(Q.max_month_actions)
        ? 1
        : 0;
!}

= [+ date_label +] — Leadership Table

<div class="leadership-board">
<div class="hub-briefing">
<div class="hub-briefing-kicker">Before the bureau</div>
<div class="hub-headline">[+ news_headline +]</div>

<p>[? if not left_in_government and government_has_confidence and not
caretaker_government: The government whips can still pass ordinary business
without us. Around our table, the argument is therefore about leverage: a
public confrontation, a narrow channel across the aisle, or patient work
outside Parliament that will outlast today's story.?][? if not
left_in_government and not government_has_confidence and not
caretaker_government: The cabinet no longer trusts its own count. Every
conversation across the aisle may become a negotiation over survival, and
every opposition party wants to decide what follows before the government
does.?][? if caretaker_government: Cabinet papers arrive from an administration
living on borrowed time. We must decide what can still be forced now and what
must wait for a government with a mandate.?][? if left_in_government and not
caretaker_government: Our
ministers arrive with folders thick enough to consume the morning. A promise
made here must still survive coalition partners, the Sejm and the offices
expected to carry it out.?]</p>

<p>[? if resources <= 1: The treasurer has circled every discretionary line in
red. One expensive gesture would empty the reserve, so whatever leaves this
room must justify the organisation it consumes.?][? if resources > 1 and
resources <= 4: The treasury can sustain one serious intervention, not every
request pushed under the door. Choosing the month also means choosing what we
will leave unanswered.?][? if resources >= 5: For once, the treasurer is not
the loudest person in the room. We can choose between immediate pressure and
the slower work of building a party able to apply it again.?] [? if party_unity
< 40: The factions arrive expecting somebody else to set the trap; even a good
decision may split on who is asked to carry it.?][? if party_unity >= 40 and
party_unity < 65: The alliance will carry a clear decision, but an ambiguous
bargain will reopen every old suspicion.?][? if party_unity >= 65: The
leadership can spend less time writing guarantees for itself and more time on
the consequences outside this room.?]</p>
</div>

</div>

- @poland_party_deck
- @poland_government_deck
- @poland_negotiation_deck
- @poland_major_reform_deck
- @poland_foreign_deck
- #poland_advisor
- @poland_manage_advisors
- @poland_political_bulletin

@end_month
title: End month
subtitle: Pass without playing an agenda card. Neglect carries a political cost.
is-pinned-card: true
view-if: started = 1
card-image: img/poland/cards/end-month.webp
go-to: poland_advance

@dossier
title: Polish dossier
subtitle: Rules, factions and institutions.
is-pinned-card: true
is-special: true
view-if: started = 1
card-image: img/poland/cards/polish-dossier.webp
go-to: library
