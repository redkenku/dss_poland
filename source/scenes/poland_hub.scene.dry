title: Leadership Table
new-page: true
is-hand: true
max-cards: 3
call: poland_normalize
on-arrival: {!
Q.deckDescription = "Draw an opportunity";
Q.handDescription = "On the leadership table";
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription =
        "Advisers are ready.";
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription =
        "Advisers return next month.";
} else {
    Q.pinnedCardsDescription =
        "Advisers return in " +
        Q.advisor_action_timer + " months.";
}
if (Q.leadership_reshuffle_timer <= 0) {
    Q.pinnedCardsDescription += " The leadership team can be reshuffled.";
} else {
    Q.pinnedCardsDescription += " The next reshuffle is available in " +
        Q.leadership_reshuffle_timer + " months.";
}
const hubHand =
    (this.state.currentHands &&
        this.state.currentHands["poland_hub"]) || [];
const hubMonthKey = Number(Q.year) * 100 + Number(Q.month);
Q.poland_hand_count = hubHand.length;
Q.poland_hand_full = hubHand.length >= 3 ? 1 : 0;
Q.poland_discard_used_this_month =
    Number(Q.poland_discard_month_key) == hubMonthKey ? 1 : 0;
Q.poland_discard_available =
    hubHand.length > 0 &&
    !Q.poland_discard_used_this_month &&
    Number(Q.resources) >= 1 &&
    Number(Q.month_actions) < Number(Q.max_month_actions)
        ? 1
        : 0;
Q.pinnedCardsDescription +=
    " Ending the month without acting carries a political cost.";
!}

= [+ date_label +] — Leadership Table

**[+ news_headline +]**

**Government:** [+ government_name +], led by **[+ prime_minister +]**.
**President:** **[+ president_name +]**.
**Lewica:** [+ left_role +].

**Party resources:** **[+ resources +]** available. **[+ party_income +]** more
arrive each January. [? if emergency_fundraising_timer > 0: Another emergency
appeal can be made in **[+ emergency_fundraising_timer +] months**.?]

[? if left_in_government: **Government programme:** **[+ budget +] budget
points** remain for new commitments. ?]

[? if not left_in_government and government_has_confidence and not caretaker_government:
**Across the aisle:** [+ negotiation_forecast +]. ?]

[? if president_name = "Rafał Trzaskowski" and government_party = "pis":
**Palace–cabinet conflict:** [+ pis_cohabitation_state +]. ?]

**Abroad:** [+ eu_campaign_stage +]. **Washington:** [+ us_president +].

Draw up to three opportunities onto the table. Play one to act and move
to the next month. The others stay for later. Discarding one costs **1 party
resource** and also ends the month.

[? if poland_hand_count = 0: **The table is clear.** Draw your first
opportunity below.?]
[? if poland_hand_full = 1: **The table is full.** Play an opportunity,
discard one, or end the month.?]
[? if poland_hand_count > 0 and poland_discard_used_this_month = 1:
**You have already discarded this month.**?]
[? if poland_hand_count > 0 and poland_discard_used_this_month = 0 and
resources < 1: **The party cannot afford a discard.** Play a card or end the
month.?]

- @poland_party_deck
- @poland_government_deck
- @poland_negotiation_deck
- @poland_foreign_deck
- #poland_advisor
- @poland_manage_advisors
- @poland_political_bulletin
- @poland_discard_card
- @end_month
- @dossier

@end_month
title: End month
subtitle: Pass without playing an agenda card. Neglect carries a political cost.
is-pinned-card: true
view-if: started = 1
card-image: img/poland/cards/end-month.webp
go-to: poland_advance

@dossier
title: Polish dossier
subtitle: Rules, factions and institutions.
is-pinned-card: true
is-special: true
view-if: started = 1
card-image: img/poland/cards/polish-dossier.webp
go-to: library
