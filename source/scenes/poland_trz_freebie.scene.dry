new-page: true
tags: poland_event, poland_event_calendar
priority: 27
order: 18
max-visits: 1
view-if: continuous_campaign = 1 and year = 2023 and month >= 11 and formation_complete = 1 and trz_freebie_law != "" and trz_freebie_2023_aftermath = 0
on-arrival: {!
Q.trz_freebie_2023_aftermath = 1;
const pisCabinet = Q.government_party == "pis" &&
    Q.government_has_confidence && !Q.caretaker_government;
Q.trz_freebie_2023_pis_cabinet = pisCabinet ? 1 : 0;
if (pisCabinet) {
    Q.united_right_cohesion -= 5;
    Q.trz_freebie_realign_pressure += 4;
    Q.konf_normalisation += 2;
    Q.konf_poll_momentum += 0.35;
    Q.news_headline =
        "The PiS cabinet survives while its younger right-wing movement leaves";
} else {
    Q.united_right_cohesion -= 14;
    Q.suwerenna_merge_dissent += 12;
    Q.trz_freebie_realign_pressure += 10;
    Q.konf_normalisation += 4;
    Q.konf_poll_momentum += 1.0;
    Q.pis_poll_momentum -= 0.45;
    Q.news_headline =
        "The 2023 defeat makes Konfederacja the claimant to the Polish right";
}
Q.far_right_fragmentation += pisCabinet ? 3 : 6;
const newHope = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "nowa_nadzieja";
});
const national = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "ruch_narodowy";
});
if (newHope) newHope.organisation = Math.max(28, newHope.organisation + 2);
if (national) national.organisation = Math.max(30, national.organisation + 1);
!}

= [? if trz_freebie_2023_pis_cabinet: A cabinet survives; its movement does not?][? if not trz_freebie_2023_pis_cabinet: A defeat chooses an heir?]

[? if trz_freebie_2023_pis_cabinet: PiS still controls the ministries, the
calendar and a confidence majority. Outside the Chancellery, the people who
turned the **[? if trz_freebie_law = "marriage": marriage-equality law?][? if
trz_freebie_law = "abortion": abortion-restoration law?]** into their test of
loyalty are moving elsewhere. Konfederacja receives the younger broadcasters,
legal defence funds and county organisers while PiS receives another month in
office.?]

[? if not trz_freebie_2023_pis_cabinet: PiS has lost the government and the
argument over why. Its apparatus says the electorate wanted competence;
Suwerenna says the party tolerated a liberal President; Konfederacja says both
claims prove that the old party cannot protect anything. The last explanation
is the one acquiring members.?]

The enacted law remains in force. What changes tonight is which party the
right trusts to organize its repeal.

- @freebie_2023_material
- @freebie_2023_cordon
- @freebie_2023_copy

