    Math.round(Number(Q.public_trust || 0) * 0.25);
if (support >= 231 && Number(Q.president_relation || 0) >= 32) {
    Q.media_charter_stage = 4;
    Q.media_charter_outcome = "Charter passed, signed and survived legal review";
    Q.media_editorial_independence += 9;
    Q.media_legal_security += 9;
    Q.public_media_security += 5;
} else if (support >= 231) {
    Q.media_charter_stage = 3;
    Q.media_charter_outcome = "Charter passed the Sejm and remains under presidential or court challenge";
    Q.media_legal_security += 2;
} else {
    Q.media_charter_stage = 2;
    Q.media_charter_outcome = "Charter failed in the Sejm; the annual funding route remains";
}
Q.news_headline = Q.media_charter_outcome;
!}

