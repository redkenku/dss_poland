on-arrival: {!
const broad = Q.hate_speech_bill_scope.startsWith("Broad");
const sejmSupport = Number(Q.coalition_democratic_seats || 0) +
    Math.round(Number(Q.minority_safety || 0) * 0.18) - (broad ? 12 : 0);
Q.hate_speech_stage = 2;
