    Q.hate_speech_bill_outcome = "Bill defeated in the Sejm";
} else {
    Q.hate_speech_stage = 3;
    if (Number(Q.president_relation || 0) < (broad ? 48 : 30)) {
        Q.hate_speech_bill_outcome = "Bill vetoed by the President";
    } else if (broad && Number(Q.media_legal_security || 0) < 45) {
        Q.hate_speech_stage = 4;
        Q.hate_speech_bill_outcome = "Broad bill signed and sent to constitutional review";
    } else {
        Q.hate_speech_stage = 5;
        Q.hate_speech_bill_outcome = "Bill passed, signed and survives review";
        Q.minority_safety += broad ? 9 : 5;
        Q.prosecution_independence += broad ? -2 : 3;
    }
}
Q.hate_speech_done = 1;
Q.public_mood_pending_lgbt_equality_support += 8;
Q.public_mood_pending_refugee_solidarity_support += 7;
Q.public_mood_pending_rule_of_law_support += 5;
Q.news_headline = Q.hate_speech_bill_outcome;
!}

