    "Adrian Zandberg": 2.3,
    "Agnieszka Dziemianowicz-Bąk": 2.5,
    "Anna-Maria Żukowska": 2.2,
    "Katarzyna Kotula": 2.4,
    "Magdalena Biejat": 2.1
};
Q.pres_debate_frame_done = 1;
Q.pres_debate_stops_remaining -= 1;
