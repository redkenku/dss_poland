title: Constitutional office compatibility

@resolve
# prose-audit: Grade B — A constitutional-housekeeping notice done properly: incompatibility stated clearly, the successor produced by the competent institution, and both responses refusing Lewica an appointment power it does not have. Its substance is a generated string ([+ office_incompatibility_resolution +]), so there is no scene for the succession it reports.
title: One person cannot hold both offices
subtitle: The legally competent institution fills each vacancy; Lewica chooses only its response.
face-image: img/poland/events/sejm-chamber-2024.webp
new-page: true
tags: poland_event
priority: 100
order: 0
max-visits: 8
view-if: continuous_campaign = 1 and office_incompatibility_pending = 1
on-arrival: {!
const president = String(Q.president_name || "");
const avoidPresident = function(preferred, fallback) {
    return preferred == president ? fallback : preferred;
};
const previousKind = String(Q.office_incompatibility_kind || "Office");
const filled = [];

if (String(Q.prime_minister || "").includes("succession pending")) {
    const successors = {
        pis: ["Beata Szydło", "Przemysław Czarnek"],
        ko: ["Donald Tusk", "Radosław Sikorski"],
        lewica: ["Agnieszka Dziemianowicz-Bąk", "Magdalena Biejat"],
        psl: ["Piotr Zgorzelski", "Krzysztof Hetman"],
        p2050: ["Katarzyna Pełczyńska-Nałęcz", "Paulina Hennig-Kloska"],
        independent: ["Independent caretaker nominee", "Non-partisan Sejm nominee"],
        other: ["Cross-party caretaker nominee", "Non-partisan Sejm nominee"]
    };
    const slate = successors[Q.government_party] || successors.other;
    Q.office_incompatibility_pm_nominee =
        avoidPresident(slate[0], slate[1]);
    Q.office_incompatibility_pm_nominee_party =
        String(Q.government_party || "other");
    Q.government_name = "Caretaker after prime-ministerial vacancy";
    Q.caretaker_government = 1;
    Q.formation_in_progress = 1;
    Q.office_incompatibility_pm_formation = 1;
    Q.snap_formation_context =
        "Prime-ministerial vacancy after presidential inauguration";
    Q.snap_formation_attempt = 0;
    filled.push(
        "Prime-ministerial nominee: " +
        Q.office_incompatibility_pm_nominee
    );
}

if (String(Q.sejm_speaker || "").includes("Sejm election pending")) {
    const speakerSlates = {
        pis: ["Elżbieta Witek", "Mariusz Błaszczak"],
        ko: ["Monika Wielichowska", "Radosław Sikorski"],
        lewica: [
            String(Q.left_marshal_nominee || "Włodzimierz Czarzasty"),
            "Agnieszka Dziemianowicz-Bąk"
        ],
        psl: ["Piotr Zgorzelski", "Krzysztof Hetman"],
        p2050: ["Katarzyna Pełczyńska-Nałęcz", "Paulina Hennig-Kloska"],
        independent: ["Cross-party Sejm nominee", "Senior Deputy Marshal"],
        other: ["Cross-party Sejm nominee", "Senior Deputy Marshal"]
    };
    const slate = speakerSlates[Q.government_party] || speakerSlates.other;
    Q.office_incompatibility_sejm_nominee =
        avoidPresident(slate[0], slate[1]);
    const sejmTotal = Math.max(1, Number(Q.sejm_total) || 460);
    const leftCabinetVotes = Q.left_in_government
        ? Math.max(
            0,
            Number(Q.ministry_left_cabinet_seats) ||
                Number(Q.left_seats) || 0
        )
        : 0;
    Q.office_sejm_marshal_yes = Math.min(
        sejmTotal,
        Math.max(0, Number(Q.government_support_seats) || 0) +
            leftCabinetVotes
    );
    Q.office_sejm_marshal_absent = Math.min(
        12,
        Math.max(0, sejmTotal - Q.office_sejm_marshal_yes)
    );
    Q.office_sejm_marshal_no = Math.max(
        0,
        sejmTotal - Q.office_sejm_marshal_yes -
            Q.office_sejm_marshal_absent
    );
    Q.office_sejm_marshal_present =
        Q.office_sejm_marshal_yes + Q.office_sejm_marshal_no;
    Q.office_sejm_marshal_threshold =
        Math.floor(Q.office_sejm_marshal_present / 2) + 1;
    const speakerElected =
        Q.office_sejm_marshal_present >= Math.ceil(sejmTotal / 2) &&
        Q.office_sejm_marshal_yes >= Q.office_sejm_marshal_threshold;
    Q.sejm_speaker = speakerElected
        ? Q.office_incompatibility_sejm_nominee
        : "Senior Deputy Marshal (acting after inconclusive vote)";
    filled.push(
        speakerElected
            ? "Sejm vote " + Q.office_sejm_marshal_yes + "–" +
                Q.office_sejm_marshal_no + " elects: " + Q.sejm_speaker
            : "Sejm vote " + Q.office_sejm_marshal_yes + "–" +
                Q.office_sejm_marshal_no +
                " is inconclusive; acting Marshal remains"
    );
}

if (String(Q.senate_marshal || "").includes("Senate election pending")) {
    const senateTotal = Math.max(1, Number(Q.senate_total) || 100);
    const senateDemocratic = Math.max(
        0,
        (Number(Q.senate_ko_seats) || 0) +
            (Number(Q.senate_p2050_seats) || 0) +
            (Number(Q.senate_psl_seats) || 0) +
            (Number(Q.senate_left_seats) || 0) +
            Math.ceil((Number(Q.senate_independent_seats) || 0) / 2)
    );
    const senateRight = Math.max(
        0,
        (Number(Q.senate_pis_seats) || 0) +
            (Number(Q.senate_konf_seats) || 0) +
            Math.floor((Number(Q.senate_independent_seats) || 0) / 2)
    );
    const democraticNominee = avoidPresident(
        "Małgorzata Kidawa-Błońska",
        "Democratic Senate nominee"
    );
    const rightNominee = avoidPresident(
        "Stanisław Karczewski",
        "PiS Senate nominee"
    );
    Q.office_senate_marshal_nominee = senateDemocratic >= senateRight
        ? democraticNominee
        : rightNominee;
    Q.office_senate_marshal_yes = Math.min(
        senateTotal,
        Math.max(senateDemocratic, senateRight)
    );
    Q.office_senate_marshal_no = Math.max(
        0,
        senateTotal - Q.office_senate_marshal_yes
    );
    Q.office_senate_marshal_threshold =
        Math.floor(senateTotal / 2) + 1;
    const senateMarshalElected =
        Q.office_senate_marshal_yes >=
            Q.office_senate_marshal_threshold;
    Q.senate_marshal = senateMarshalElected
        ? Q.office_senate_marshal_nominee
        : "Senior Deputy Senate Marshal (acting after inconclusive vote)";
    filled.push(
        senateMarshalElected
            ? "Senate vote " + Q.office_senate_marshal_yes + "–" +
                Q.office_senate_marshal_no + " elects: " +
                Q.senate_marshal
            : "Senate vote is inconclusive; acting Marshal remains"
    );
}

if (String(Q.p2050_leader || "").includes("party election pending")) {
    Q.p2050_leader = avoidPresident(
        "Katarzyna Pełczyńska-Nałęcz",
        "Paulina Hennig-Kloska"
    );
    filled.push("Poland 2050 acting leader: " + Q.p2050_leader);
}
if (String(Q.psl_leader || "").includes("party election pending")) {
    Q.psl_leader = avoidPresident("Piotr Zgorzelski", "Krzysztof Hetman");
    filled.push("PSL acting leader: " + Q.psl_leader);
}

const portfolio = String(Q.office_incompatibility_portfolio || "");
if (portfolio) {
    const ministerKey = portfolio + "_minister";
    const partyKey = portfolio + "_minister_party";
    if (String(Q[ministerKey] || "").includes("appointment pending")) {
        const partyLabels = {
            pis: "PiS", ko: "KO", lewica: "Lewica", psl: "PSL",
            p2050: "Poland 2050", independent: "Cabinet", other: "Cabinet"
        };
        const previousParty = String(
            Q.office_incompatibility_previous_minister_party || ""
        );
        Q[partyKey] = previousParty &&
            previousParty != "Vacant" &&
            previousParty != "Unassigned"
                ? previousParty
                : (partyLabels[Q.government_party] || "Cabinet");
        const successorMinisters = {
            PiS: {
                labor: "Stanisław Szwed",
                equality: "Urszula Rusecka",
                housing: "Waldemar Buda",
                health: "Czesław Hoc",
                digital: "Paweł Lewandowski",
                science: "Przemysław Czarnek",
                interior: "Maciej Wąsik",
                finance: "Zbigniew Kuźmiuk",
                economy: "Olga Semeniuk-Patkowska",
                justice: "Sebastian Kaleta",
                foreign: "Paweł Jabłoński",
                agriculture: "Ryszard Bartosik",
                defence: "Michał Dworczyk"
            },
            KO: {
                labor: "Aleksandra Gajewska",
                equality: "Barbara Nowacka",
                housing: "Krystyna Sibińska",
                health: "Alicja Chybicka",
                digital: "Paweł Olszewski",
                science: "Katarzyna Lubnauer",
                interior: "Czesław Mroczek",
                finance: "Janusz Cichoń",
                economy: "Borys Budka",
                justice: "Barbara Dolniak",
                foreign: "Paweł Kowal",
                agriculture: "Dorota Niedziela",
                defence: "Tomasz Siemoniak"
            },
            Lewica: {
                labor: "Katarzyna Ueberhan",
                equality: "Anita Kucharska-Dziedzic",
                housing: "Joanna Scheuring-Wielgus",
                health: "Marek Rutka",
                digital: "Dariusz Standerski",
                science: "Maciej Gdula",
                interior: "Tomasz Szymański",
                finance: "Wojciech Konieczny",
                economy: "Arkadiusz Iwaniak",
                justice: "Katarzyna Ueberhan",
                foreign: "Marek Balt",
                agriculture: "Zdzisław Wolski",
                defence: "Andrzej Szejna"
            },
            PSL: {
                economy: "Adam Jarubas",
                agriculture: "Stefan Krajewski",
                defence: "Paweł Bejda"
            },
            "Poland 2050": {
                digital: "Kamil Wnuk"
            },
            Cabinet: {
                labor: "Gertruda Uścińska",
                equality: "Zuzanna Rudzińska-Bluszcz",
                housing: "Joanna Erbel",
                health: "Maria Libura",
                digital: "Alek Tarkowski",
                science: "Michał Kleiber",
                interior: "Marek Biernacki",
                finance: "Paweł Wojciechowski",
                economy: "Jerzy Hausner",
                justice: "Ewa Łętowska",
                foreign: "Jacek Czaputowicz",
                agriculture: "Monika Stanny",
                defence: "Stanisław Koziej"
            }
        };
        const partySuccessors = successorMinisters[Q[partyKey]] ||
            successorMinisters.Cabinet;
        Q[ministerKey] = avoidPresident(
            partySuccessors[portfolio] ||
                successorMinisters.Cabinet[portfolio],
            successorMinisters.Cabinet[portfolio]
        );
        filled.push(portfolio + " minister: " + Q[ministerKey]);
    }
}

Q.office_incompatibility_resolution = filled.length
    ? filled.join(" · ")
    : previousKind + " vacancy recorded for the competent institution";
Q.office_incompatibility_pending = 0;
Q.office_incompatibility_resolved = 1;
Q.office_incompatibility_portfolio = "";
Q.office_incompatibility_previous_minister_party = "";
Q.news_headline =
    "Constitutional incompatibility triggers a recorded succession process";
!}

= The second office is vacated before succession

The presidential mandate cannot be combined with a cabinet portfolio,
premiership or parliamentary Marshalship. The incompatible office was vacated,
not quietly reassigned. The Sejm, Senate, Prime Minister or party rules have
now held the recorded successor vote or identified a nominee for the required
confidence vote:

**[+ office_incompatibility_resolution +]**

We can accept the competent institution's work or make it publish the roll
call, legal basis and recusals. Neither response lets us appoint the successor;
a prime-ministerial nominee still needs the constitutionally required Sejm
formation vote.

- @accept
- @record

@accept
title: Recognise the succession and return to substantive politics
subtitle: Respect the competent authority and close the vacancy without a party veto.
on-arrival: public_trust += 2; constitutional_restraint += 2; news_headline = "The succession is recognised without inventing a party appointment power"
go-to: poland_events_2026_snap.snap_formation_attempt_one if office_incompatibility_pm_formation = 1; poland_events_2026_snap.snap_senate_marshal_resume if office_incompatibility_pm_formation = 0 and snap_senate_marshal_return = 1; poland_event_queue if office_incompatibility_pm_formation = 0 and snap_senate_marshal_return = 0

We recognise the recorded successor and deny ourselves a power the
Constitution gives elsewhere. The new office-holder begins without a Lewica
endorsement, but also without a manufactured legitimacy crisis.

@record
title: Demand the roll call, legal basis and recusals in public
subtitle: Make the succession auditable, accepting another round of coalition conflict.
on-arrival: media_capacity += 3; public_trust += 1; government_coalition_dissent += 2; news_headline = "The new office-holder begins under a published authority record"
go-to: poland_events_2026_snap.snap_formation_attempt_one if office_incompatibility_pm_formation = 1; poland_events_2026_snap.snap_senate_marshal_resume if office_incompatibility_pm_formation = 0 and snap_senate_marshal_return = 1; poland_event_queue if office_incompatibility_pm_formation = 0 and snap_senate_marshal_return = 0

We publish who voted, under which rule and who stood aside. The record earns
public trust and gives our press team evidence; coalition partners resent that
we kept a settled vacancy in the headlines.

