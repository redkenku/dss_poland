        Q.abortion_rewrite_pending = 0;
        Q.abortion_cabinet_deadline = 0;
        Q.abortion_event_done = 1;
        Q.strike_event_done = 1;
        Q.november_2021_sajbor_done = 1;
        Q.dorota_2023_done = 1;
    }
    if (Q.marriage_reform_stage >= 1) {
        Q.partnership_revision_enacted = 1;
        Q.partnership_revision_pending = 0;
        Q.partnership_revision_result =
            "Superseded by the enacted major-reform settlement";
    }
    if (Q.marriage_reform_stage >= 3) {
