title: Normalise Polish scenario state
on-arrival: {!
const budgetHost = typeof window !== "undefined"
    ? window
    : (typeof globalThis !== "undefined" ? globalThis : this);
const july2021ChainPending =
    Q.year == 2021 && Q.month == 7 &&
    (!Q.tusk_return_2021_done || !Q.left_revolt_event_done ||
        !Q.kukiz_negotiation_done);
if (july2021ChainPending) {
    Q.poland_historical_event_phase = 1;
} else if (!Number.isFinite(Number(Q.poland_historical_event_phase))) {
    const historicalCalendar =
        Q.year < 2023 || (Q.year == 2023 && Q.month <= 7);
    Q.poland_historical_event_phase =
        historicalCalendar && Q.polling_has_dated_route ? 1 : 0;
}
if (!budgetHost.polandBudgetModel) {
    const number = function(value, fallback) {
        return Number.isFinite(Number(value)) ? Number(value) : fallback;
    };
    const clamp = function(value, low, high) {
        return Math.max(low, Math.min(high, number(value, low)));
    };
    const factions = {
        barons: {
            label: "SLD establishment", nameKey: "barons_name",
            representative: "Tomasz Trela", seatsKey: "left_barons_seats",
            priorities: [2, 5, 9, 11, 14],
            social: 17.2, deficit: 5.4,
            defenceFloor: 4.3, defenceCeiling: 5.5
        },
        spring: {
            label: "Wiosna", nameKey: "spring_name",
            representative: "Krzysztof Śmiszek", seatsKey: "left_spring_seats",
            priorities: [4, 7, 10, 15],
            social: 18.4, deficit: 5.8,
            defenceFloor: 4.0, defenceCeiling: 5.1
        },
        labor: {
            label: "Lewica Pracy", nameKey: "labor_name",
            representative: "Agnieszka Dziemianowicz-Bąk",
            seatsKey: "left_labor_seats", priorities: [1, 2, 7, 12, 13, 14],
            social: 19.0, deficit: 6.1,
            defenceFloor: 3.9, defenceCeiling: 5.0
        },
        progressives: {
            label: "Younger progressives", nameKey: "progressives_name",
            representative: "Katarzyna Kotula",
            seatsKey: "left_progressives_seats", priorities: [3, 4, 8, 10, 15],
            social: 18.5, deficit: 5.8,
            defenceFloor: 3.9, defenceCeiling: 5.0
        },
        razem: {
            label: "Razem", representative: "Adrian Zandberg",
            seatsKey: "razem_seats", priorities: [1, 2, 3, 12, 13],
            social: 18.0, deficit: 6.3,
            defenceFloor: 3.8, defenceCeiling: 4.9
        },
        pps: {
            label: "PPS", representative: "Joanna Senyszyn",
            seatsKey: "left_pps_seats", priorities: [1, 2, 5, 7, 11, 14],
            social: 18.8, deficit: 6.0,
            defenceFloor: 4.0, defenceCeiling: 5.0
        },
        social_patriot: {
            label: "Social patriots", nameKey: "social_patriot_name",
            representative: "Paulina Matysiak",
            seatsKey: "left_social_patriot_seats", priorities: [2, 5, 9, 11, 14],
            social: 17.2, deficit: 5.2,
            defenceFloor: 4.8, defenceCeiling: 5.8
        }
    };
    const activeFactions = function(q) {
        const active = Array.isArray(q.factions)
            ? q.factions.filter(function(id) {
                return typeof id == "string" && factions[id];
            })
            : ["barons", "spring", "progressives", "razem"];
        if (
            q.labor_active && q.labor_in_left && !q.labor_party_formed &&
            !active.includes("labor")
        ) {
            active.push("labor");
        }
        return active;
    };
    const factionBacking = function(q, id) {
        const target = factions[id] || factions.barons;
        const social = number(q.annual_budget_social_share, 17);
        const defence = number(q.annual_budget_defence_share, 4.6);
        const deficit = number(q.annual_budget_deficit_share, 4.5);
        const socialFloorBreach = Math.max(
            0,
            number(q.annual_budget_social_floor, 0) - social
        );
        let support =
            60 + number(q.party_unity, 50) * 0.10 -
            number(q[id + "_dissent"], 0) * 0.32;
        if (social < target.social) support -= (target.social - social) * 20;
        else support += Math.min(9, (social - target.social) * 6);
        if (deficit > target.deficit) support -= (deficit - target.deficit) * 11;
        if (defence < target.defenceFloor) {
            support -= (target.defenceFloor - defence) *
                (id == "social_patriot" ? 18 : 5);
        }
        if (defence > target.defenceCeiling && social < target.social + 0.2) {
            support -= (defence - target.defenceCeiling) * 14;
        }
        if (socialFloorBreach > 0) {
            support -= socialFloorBreach *
                (id == "razem"
                    ? 12
                    : (["labor", "pps"].includes(id) ? 34 : 20));
        }
        if (q.annual_budget_public_wage_guarantee) {
            if (id == "labor") support += 14;
            if (id == "razem") support += 10;
            if (id == "pps") support += 12;
            if (id == "spring") support += 4;
        }
        if (q.annual_budget_progressive_revenue) {
            if (id == "labor") support += 7;
            if (id == "progressives") support += 6;
            if (id == "razem") support += 9;
            if (id == "pps") support += 6;
            if (id == "barons") support -= 2;
            if (id == "social_patriot") support -= 3;
        }
        if (q.annual_budget_kpo_cofinance) {
            if (id == "progressives") support += 5;
            if (id == "barons") support += 3;
            if (id == "spring") support += 3;
        }
        if (q.annual_budget_green_investment) {
            if (id == "progressives") support += 10;
            if (id == "spring") support += 8;
            if (id == "labor") support += 3;
        }
        if (q.annual_budget_local_compact) {
            if (id == "barons") support += 5;
            if (id == "social_patriot") support += 4;
            if (id == "labor") support += 2;
        }
        if (q.annual_budget_deficit_rule) {
            if (id == "barons" || id == "social_patriot") support += 6;
            if (id == "labor") support -= 2;
            if (id == "razem") support -= 3;
        }
        if (q.annual_budget_market_cuts) {
            if (id == "labor") support -= 18;
            if (id == "razem") support -= 10;
            if (id == "pps") support -= 16;
            if (id == "progressives") support -= 9;
            if (id == "spring") support -= 7;
            if (id == "barons") support += 3;
            if (id == "social_patriot") support += 4;
        }
        if (q.annual_budget_family_defence_deal) {
            if (id == "progressives") support -= 16;
            if (id == "spring") support -= 12;
            if (id == "razem") support -= 22;
            if (id == "labor") support -= 8;
            if (id == "social_patriot") support += 15;
            if (id == "barons") support += 3;
        }
        if (
            id == "razem" && social < 18.0 &&
            (q.razem_in_government || q.razem_budget_support_pact)
        ) {
            support = Math.min(support, 20);
        }
        if (
            id == "labor" && social < 17.4 &&
            !q.annual_budget_public_wage_guarantee
        ) {
            support = Math.min(support, 28);
        }
        return Math.round(clamp(support, 0, 100));
    };
    const malcontents = function(stress, seats) {
        return Math.min(
            Math.max(0, Math.round(number(seats, 0))),
            Math.max(0, Math.round((number(stress, 0) - 20) / 5))
        );
    };
    const priceRebellion = function(options) {
        const governmentSeats = Math.max(
            0,
            Math.round(number(options.governmentSeats, 0))
        );
        const pool = Math.min(
            governmentSeats,
            Math.max(0, Math.round(number(options.malcontents, 0)))
        );
        const freedom = clamp(
            (number(options.loyalYes, governmentSeats) -
                number(options.oppositionNo, 0)) / 30,
            0,
            1
        );
        const diehards = Math.floor(pool * 0.2);
        const whipBonus = Math.max(
            0,
            Math.round(number(options.whipBonus, 0))
        );
        const priced = Math.min(
            governmentSeats,
            diehards + Math.round((pool - diehards) * freedom)
        );
        const defectors = Math.max(0, priced - Math.min(priced, whipBonus));
        const openNo = Math.round(defectors * freedom * 0.5);
        return {
            freedom: freedom,
            loyalMargin: number(options.loyalYes, governmentSeats) -
                number(options.oppositionNo, 0),
            diehards: diehards,
            minimum: Math.max(0, diehards - whipBonus),
            maximum: Math.max(0, pool - whipBonus),
            defectors: defectors,
            openNo: openNo,
            abstain: defectors - openNo
        };
    };
    const rollCall = function(options) {
        const total = Math.max(1, Math.round(number(options.sejmTotal, 460)));
        const governmentSeats = Math.max(
            0,
            Math.min(total, Math.round(number(options.governmentSeats, 0)))
        );
        const leftYes = Math.max(0, Math.round(number(options.leftYes, 0)));
        const leftNo = Math.max(0, Math.round(number(options.leftNo, 0)));
        const leftAbstain = Math.max(
            0,
            Math.round(number(options.leftAbstain, 0))
        );
        const externalYes = Math.max(
            0,
            Math.round(number(options.externalYes, 0))
        );
        const externalNo = Math.max(
            0,
            Math.round(number(options.externalNo, 0))
        );
        const externalAbstain = Math.max(
            0,
            Math.round(number(options.externalAbstain, 0))
        );
        const priced = priceRebellion({
            governmentSeats: governmentSeats,
            malcontents: options.malcontents,
            loyalYes: governmentSeats + leftYes + externalYes,
            oppositionNo: leftNo + externalNo,
            whipBonus: options.whipBonus
        });
        const defectors = Number.isFinite(Number(options.defectors))
            ? Math.max(
                0,
                Math.min(governmentSeats, Math.round(Number(options.defectors)))
            )
            : priced.defectors;
        const openNo = Math.round(defectors * priced.freedom * 0.5);
        const governmentYes = governmentSeats - defectors;
        const governmentAbstain = defectors - openNo;
        const yes = governmentYes + leftYes + externalYes;
        const no = openNo + leftNo + externalNo;
        const abstain = governmentAbstain + leftAbstain + externalAbstain;
        const present = yes + no + abstain;
        const quorum = Math.max(1, Math.round(number(options.quorum, 230)));
        const passed = present >= quorum && yes > no ? 1 : 0;
        return {
            governmentYes: governmentYes,
            governmentNo: openNo,
            governmentAbstain: governmentAbstain,
            defectors: defectors,
            freedom: priced.freedom,
            loyalMargin: priced.loyalMargin,
            diehards: priced.diehards,
            minimum: priced.minimum,
            maximum: priced.maximum,
            yes: yes,
            no: no,
            abstain: abstain,
            present: present,
            threshold: no + 1,
            passed: passed,
            margin: passed ? yes - no : 0,
            shortfall: passed ? 0 : Math.max(0, no + 1 - yes)
        };
    };
    const forecast = function(options) {
        const centre = rollCall(options);
        const unity = clamp(options.partyUnity, 0, 100);
        const width = centre.maximum > centre.minimum
            ? Math.max(
                1,
                Math.ceil(number(options.malcontents, 0) *
                    (0.45 - unity * 0.003)) -
                    Math.round(number(options.whipBonus, 0))
            )
            : 0;
        const low = Math.max(centre.minimum, centre.defectors - width);
        const high = Math.min(centre.maximum, centre.defectors + width);
        const rolls = [];
        for (let defectors = low; defectors <= high; defectors += 1) {
            rolls.push(rollCall(Object.assign({}, options, {defectors: defectors})));
        }
        const range = function(key) {
            const values = rolls.map(function(roll) { return roll[key]; });
            return {low: Math.min.apply(Math, values), high: Math.max.apply(Math, values)};
        };
        return {
            centre: centre,
            width: high - low,
            defectors: {low: low, high: high},
            yes: range("yes"),
            no: range("no"),
            abstain: range("abstain")
        };
    };
    budgetHost.polandBudgetModel = {
        factions: factions,
        activeFactions: activeFactions,
        factionBacking: factionBacking,
        malcontents: malcontents,
        priceRebellion: priceRebellion,
        rollCall: rollCall,
        forecast: forecast
    };
}
const publicMoodHost = budgetHost;
if (!budgetHost.polandElectionModel) {
    const finiteElection = function(value, fallback) {
        const number = Number(value);
        return Number.isFinite(number) ? number : fallback;
    };
    const clampElection = function(value, low, high) {
        return Math.max(low, Math.min(high, finiteElection(value, low)));
    };
    const apportionElection = function(total, ids, weightFor) {
        const result = {};
        const safeTotal = Math.max(0, Math.round(finiteElection(total, 0)));
        if (!ids.length || safeTotal == 0) return result;
        const weightTotal = ids.reduce(function(sum, id) {
            return sum + Math.max(0, finiteElection(weightFor(id), 0));
        }, 0);
        const divisor = Math.max(0.01, weightTotal);
        const rows = ids.map(function(id) {
            const exact = safeTotal * Math.max(
                0,
                finiteElection(weightFor(id), 0)
            ) / divisor;
            return {
                id: id,
                seats: Math.floor(exact),
                remainder: exact - Math.floor(exact)
            };
        });
        let allocated = rows.reduce(function(sum, row) {
            return sum + row.seats;
        }, 0);
        rows.sort(function(a, b) {
            return b.remainder - a.remainder;
        });
        let remainderIndex = 0;
        while (allocated < safeTotal) {
            rows[remainderIndex % rows.length].seats += 1;
            remainderIndex += 1;
            allocated += 1;
        }
        for (const row of rows) result[row.id] = row.seats;
        return result;
    };
    const dhondtElection = function(votes, qualified, seatCount) {
        const result = {};
        for (const id of Object.keys(votes)) result[id] = 0;
        for (let seat = 0; seat < seatCount; seat += 1) {
            let winner = qualified[0];
            let best = -1;
            for (const id of qualified) {
                const quotient = finiteElection(votes[id], 0) /
                    ((result[id] || 0) + 1);
                if (quotient > best) {
                    best = quotient;
                    winner = id;
                }
            }
            result[winner] = (result[winner] || 0) + 1;
        }
        return result;
    };
    const groupIds = [
        "metropolitan_liberals", "liberal_professionals",
        "public_service_families", "industrial_logistics",
        "provincial_welfare", "rural_localists",
        "older_welfare_households", "anti_establishment_youth"
    ];
    const nationalWeights = [12, 11, 12, 13, 15, 15, 12, 10];
    const urbanProfiles = [
        [34, 24, 16, 8, 4, 2, 4, 8],
        [18, 16, 22, 24, 7, 2, 6, 5],
        [12, 10, 18, 34, 10, 3, 8, 5],
        [22, 20, 12, 12, 12, 5, 9, 8]
    ];
    const ruralProfiles = [
        [2, 3, 5, 8, 22, 38, 18, 4],
        [5, 6, 10, 19, 30, 15, 11, 4],
        [3, 4, 10, 31, 28, 9, 11, 4],
        [8, 10, 9, 18, 22, 18, 10, 5]
    ];
    const familyFor = function(id) {
        if ([
            "left", "sld_breakaway", "social_patriot", "spring_breakaway",
            "labor_left", "young_left", "razem", "pps", "tak_rozwoj"
        ].includes(id)) return "left";
        if (["ko", "ko_splinter", "centrum"].includes(id)) return "ko";
        if ([
            "pis", "rozwoj", "suwerenna", "republikanie", "odnowa",
            "duda", "social_conservative"
        ].includes(id)) return "pis";
        if (["konf", "korona", "new_hope", "national_movement"].includes(id)) {
            return "konf";
        }
        if (["porozumienie", "kukiz"].includes(id)) return "psl";
        return id;
    };
    const weightedShare = function(state, family, weights) {
        let total = 0;
        let weightTotal = 0;
        for (let index = 0; index < groupIds.length; index += 1) {
            const share = Number(state[groupIds[index] + "_" + family]);
            if (!Number.isFinite(share)) continue;
            total += share * weights[index];
            weightTotal += weights[index];
        }
        return weightTotal > 0 ? total / weightTotal : 0;
    };
    const staticGeography = {
        left: [1.30, 0.52], ko: [1.28, 0.58], p2050: [1.12, 0.78],
        pis: [0.68, 1.35], psl: [0.54, 1.55], konf: [1.02, 0.96],
        p0: [1.10, 0.82], other: [1, 1]
    };
    const geographyFactor = function(state, id, pool, index) {
        const family = familyFor(id);
        const profiles = pool == "urban" ? urbanProfiles : ruralProfiles;
        const local = weightedShare(
            state,
            family,
            profiles[index % profiles.length]
        );
        const national = weightedShare(state, family, nationalWeights);
        const fallback = staticGeography[family] || [1, 1];
        let factor = national > 0
            ? clampElection(local / national, 0.42, 1.8)
            : fallback[pool == "urban" ? 0 : 1];
        let hash = pool == "urban" ? 17 : 31;
        for (let cursor = 0; cursor < id.length; cursor += 1) {
            hash = (hash * 33 + id.charCodeAt(cursor)) % 997;
        }
        hash = (hash + index * 37) % 17;
        factor *= 1 + (hash - 8) / 100;
        return factor;
    };
    const allocateSejm = function(options) {
        const state = options.state || {};
        const system = ["mixed_230", "fptp_460"].includes(options.system)
            ? options.system
            : "proportional";
        const partyIds = (options.partyIds || []).slice();
        const committeeFor = options.committeeFor || {};
        const componentVotes = options.componentVotes || {};
        const committeeVotes = options.committeeVotes || {};
        const negotiatedShares = options.negotiatedShares || {};
        const committees = Object.keys(committeeVotes).filter(function(id) {
            return finiteElection(committeeVotes[id], 0) > 0;
        });
        let qualified = (options.qualifiedCommittees || []).filter(function(id) {
            return committees.includes(id);
        });
        if (!qualified.length && committees.length) {
            qualified = committees.slice().sort(function(a, b) {
                return committeeVotes[b] - committeeVotes[a];
            }).slice(0, 1);
        }
        const membersFor = function(committee) {
            return partyIds.filter(function(id) {
                return finiteElection(componentVotes[id], 0) > 0 &&
                    (committeeFor[id] || id) == committee;
            });
        };
        const weightsFor = function(members) {
            const useNegotiated = members.length > 1 && members.every(function(id) {
                return finiteElection(negotiatedShares[id], 0) > 0;
            });
            const weights = {};
            for (const id of members) {
                weights[id] = useNegotiated
                    ? finiteElection(negotiatedShares[id], 0)
                    : finiteElection(componentVotes[id], 0);
            }
            return weights;
        };
        const emptySeats = function() {
            const result = {};
            for (const id of partyIds) result[id] = 0;
            return result;
        };
        const listPartySeats = emptySeats();
        const urbanPartySeats = emptySeats();
        const ruralPartySeats = emptySeats();
        const listCount = system == "proportional" ? 460 :
            (system == "mixed_230" ? 230 : 0);
        const listCommitteeSeats = listCount > 0
            ? dhondtElection(committeeVotes, qualified, listCount)
            : {};
        for (const committee of committees) {
            const members = membersFor(committee);
            if (!members.length) continue;
            const weights = weightsFor(members);
            const apportioned = apportionElection(
                listCommitteeSeats[committee] || 0,
                members,
                function(id) { return weights[id]; }
            );
            for (const id of members) listPartySeats[id] = apportioned[id] || 0;
        }
        const districtCommitteeSeats = {};
        for (const committee of committees) {
            districtCommitteeSeats[committee] = {urban: 0, rural: 0};
        }
        const leftStrongholdCount = clampElection(Math.round(
            6 + (finiteElection(state.local_network, 42) - 42) / 4 +
            (finiteElection(state.urban_progressive_support, 27) - 27) / 5
        ), 6, 15);
        const countDistricts = function(pool, count, partySeats) {
            if (count <= 0 || !committees.length) return;
            const rankedCommittees = committees.slice().sort(function(a, b) {
                return finiteElection(committeeVotes[b], 0) -
                    finiteElection(committeeVotes[a], 0);
            });
            const pollingLeader = rankedCommittees[0];
            const leaderMargin = Math.max(
                0,
                finiteElection(committeeVotes[pollingLeader], 0) -
                    finiteElection(committeeVotes[rankedCommittees[1]], 0)
            );
            const playerLeads = membersFor(pollingLeader).includes("left");
            const leaderMultiplier = leaderMargin > 0
                ? (playerLeads
                    ? 2.4 + Math.min(0.6, leaderMargin * 0.025)
                    : 1.08 + Math.min(0.37, leaderMargin * 0.025))
                : 1;
            const baseScore = function(committee, index) {
                const members = membersFor(committee);
                const transfer = members.length > 1 ? 0.94 : 1;
                const localScore = members.reduce(function(total, id) {
                    return total + finiteElection(componentVotes[id], 0) *
                        geographyFactor(state, id, pool, index);
                }, 0) * transfer;
                const memberNational = members.reduce(function(total, id) {
                    return total + finiteElection(componentVotes[id], 0);
                }, 0);
                const committeeScale = finiteElection(
                    committeeVotes[committee],
                    memberNational
                ) / Math.max(0.01, memberNational);
                return localScore * committeeScale *
                    (committee == pollingLeader ? leaderMultiplier : 1);
            };
            const leftCommittee = committeeFor.left || "left";
            const strongholdRanks = {};
            if (pool == "urban" && committees.includes(leftCommittee) &&
                membersFor(leftCommittee).includes("left")) {
                const ranked = [];
                for (let index = 0; index < count; index += 1) {
                    let rival = 0;
                    for (const committee of committees) {
                        if (committee != leftCommittee) {
                            rival = Math.max(rival, baseScore(committee, index));
                        }
                    }
                    ranked.push({
                        index: index,
                        margin: baseScore(leftCommittee, index) - rival
                    });
                }
                ranked.sort(function(a, b) {
                    return b.margin - a.margin || a.index - b.index;
                });
                ranked.slice(0, Math.min(count, leftStrongholdCount)).forEach(
                    function(entry, rank) { strongholdRanks[entry.index] = rank; }
                );
            }
            const nomineeByCommittee = {};
            for (const committee of committees) {
                const members = membersFor(committee);
                nomineeByCommittee[committee] = [];
                if (!members.length) continue;
                const weights = weightsFor(members);
                const targets = {};
                const assigned = {};
                const weightTotal = members.reduce(function(sum, id) {
                    return sum + weights[id];
                }, 0);
                for (const id of members) {
                    targets[id] = count * weights[id] / Math.max(0.01, weightTotal);
                    assigned[id] = 0;
                }
                for (let index = 0; index < count; index += 1) {
                    let nominee = null;
                    if (pool == "urban" && strongholdRanks[index] !== undefined &&
                        members.includes("left")) {
                        nominee = "left";
                    } else {
                        nominee = members.slice().sort(function(a, b) {
                            return (targets[b] - assigned[b]) -
                                (targets[a] - assigned[a]) || a.localeCompare(b);
                        })[0];
                    }
                    nomineeByCommittee[committee][index] = nominee;
                    assigned[nominee] += 1;
                }
            }
            for (let index = 0; index < count; index += 1) {
                let winner = committees[0];
                let best = -1;
                for (const committee of committees) {
                    let score = baseScore(committee, index);
                    const nominee = nomineeByCommittee[committee][index];
                    if (pool == "urban" && nominee == "left" &&
                        strongholdRanks[index] !== undefined) {
                        const rank = strongholdRanks[index];
                        const leftViability = clampElection(
                            (finiteElection(committeeVotes[leftCommittee], 0) - 3) / 9,
