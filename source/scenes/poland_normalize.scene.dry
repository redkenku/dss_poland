        }
        return Number(Q[caucus + "_escalation_stage"]) >= 7 &&
            !(caucus == "razem" && Q.razem_breakaway_protected);
    }) || authoredLaborSplitPending ? 1 : 0;
    const sldPopulistSequencePending =
        Q.sld_populist_route_active &&
        Number(Q.time) >= Number(Q.sld_populist_stage_time) + 1 &&
        (
            (
                Q.sld_populist_settlement_stage >= 1 &&
                Q.sld_populist_settlement_stage <= 3
            ) ||
            (
                Q.sld_populist_settlement_stage == 4 &&
                (
                    Q.sld_populist_orientation == "unsettled" ||
                    Q.sld_populist_orientation != "unsettled" &&
                    Q.sld_populist_escalation == "unsettled"
                )
            )
        );
    const caucusCrisisReady =
        Q.sld_populist_entry_pending || sldPopulistSequencePending ? 1 :
        (Q.social_patriot_launch_pending ? 1 :
        (Q.factions.some(function(caucus) {
        if (caucus == "razem" && Q.razem_breakaway_protected) {
            return false;
        }
        if (caucus == "social_patriot" && Q.sld_populist_route_active) {
            return false;
        }
        const stage = Number(Q[caucus + "_escalation_stage"]) || 0;
        return (
            stage == 2 &&
            !Q[caucus + "_demand_answered"] &&
            Number(Q.time) >= Number(Q[caucus + "_demand_deadline"])
        ) || stage >= 7;
    }) || authoredLaborCrisisPending ? 1 : 0));
    Q.caucus_crisis_pending = caucusCrisisReady;
    Q.caucus_crisis_dispatchable =
        caucusCrisisReady && !Q.caucus_crisis_deferred ? 1 : 0;
    Q.faction_stage_highwater = caucusIds.reduce(
