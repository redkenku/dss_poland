        Q.sld_populist_alliance_partner = "none";
    }
    if (typeof Q.sld_populist_alliance_state != "string") {
        Q.sld_populist_alliance_state = "none";
    }
    if (typeof Q.sld_populist_ideology != "string") {
        Q.sld_populist_ideology = "Conventional New Left strategy";
    }
    if (typeof Q.sld_populist_escalation != "string") {
        Q.sld_populist_escalation = "none";
    }
    Q.sld_populist_settlement_stage = clamp(
        Math.round(Number(Q.sld_populist_settlement_stage) || 0),
        0,
        4
    );
    Q.sld_populist_stage_time = Number.isFinite(
        Number(Q.sld_populist_stage_time)
    ) ? Number(Q.sld_populist_stage_time) :
        (Q.sld_populist_route_active ? (Number(Q.time) || 0) - 1 : -99);
    if (typeof Q.sld_populist_progressive_settlement != "string") {
        Q.sld_populist_progressive_settlement = "none";
    }
    Q.sld_populist_transfer_progressives = Math.max(
        0,
        Number(Q.sld_populist_transfer_progressives) || 0
    );
    if (Q.sld_populist_route_active && Q.razem_party_formed) {
        Q.razem_list_committee = "razem";
        if (Q.spring_party_formed) {
            Q.spring_joined_razem = 1;
            Q.spring_list_committee = "razem";
        }
        if (
            Q.progressives_party_formed &&
            Q.sld_populist_progressive_settlement ==
                "expelled to democratic-left opposition"
        ) {
            Q.progressives_joined_razem = 1;
            Q.progressives_list_committee = "razem";
        }
    }
    for (const quality of [
        "sld_populist_alliance_offer_score",
        "sld_populist_factional_capture",
        "sld_populist_international_isolation",
        "sld_populist_media_salience"
    ]) {
        Q[quality] = clamp(Number(Q[quality]) || 0, 0, 100);
    }
    Q.sld_populist_alliance_offer =
        Number(Q.sld_populist_alliance_offer) === 1 ? 1 : 0;
    if (typeof Q.sld_populist_failed_alignment != "string") {
        Q.sld_populist_failed_alignment = "none";
    }
    if (Q.advisor_slot_1_locked) {
        Q.advisor_slot_1 = "miller";
        Q.miller_advisor = 1;
    }
    const advisorRoster = [
        "miller",
        "czarzasty",
        "biedron",
        "zandberg",
        "dziemianowicz_bak",
        "zukowska",
        "kotula",
        "biejat",
        "wieczorek",
        "gawkowski",
        "nowicka",
        "zawisza",
        "matysiak",
        "konieczny",
        "morawska_stanecka",
        "kwiatkowski",
        "pelczynska_nalecz",
        "hennig_kloska",
        "zielinska",
        "morawiecki",
        "holownia",
        "tracz",
        "spurek",
        "semieniuk",
        "cieszynski"
    ];
    Q.n_advisors = advisorRoster.reduce(function(total, advisor) {
        return total +
            (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
    }, 0);
    const advisorCaucuses = {
        barons: ["miller", "czarzasty", "wieczorek"],
        spring: Q.spring_active ? ["biedron"] : [],
        progressives: [
            "zukowska", "kotula", "gawkowski", "nowicka"
        ].concat(Q.spring_transfer_complete ? ["biedron"] : []).concat(
            Q.biejat_party == "Razem" ? [] : ["biejat"]
        ),
        razem: ["zandberg", "zawisza"].concat(
            Q.biejat_party == "Razem" ? ["biejat"] : []
        ).concat(Q.social_patriot_active ? [] : ["matysiak"]),
        pps: ["konieczny", "morawska_stanecka", "kwiatkowski"],
        social_patriot: Q.sld_populist_route_active
            ? ["miller"]
            : ["matysiak"]
    };
    for (const faction of Q.factions) {
        const caucusRoster = advisorCaucuses[faction] || [];
        Q[faction + "_advisor_count"] =
            caucusRoster.reduce(function(total, advisor) {
                return total +
                    (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
            }, 0);
    }
    Q.labor_advisor_count = Number(Q.dziemianowicz_bak_advisor) === 1
        ? 1
        : 0;

    for (const caucus of caucusIds) {
        for (const factor of [
            "office_hold",
            "local_organisation",
            "personal_following",
            "ideological_intensity",
            "list_dependence",
            "cohesion",
            "grievance_memory",
            "defection_readiness"
        ]) {
            Q[caucus + "_" + factor] = clamp(
                Q[caucus + "_" + factor],
                0,
                100
            );
        }
        Q[caucus + "_estimated_mps"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_estimated_mps"]) || 0)
        );
        Q[caucus + "_individual_defections"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_individual_defections"]) || 0)
        );
        Q[caucus + "_mp_departed"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_mp_departed"]) || 0)
        );
        Q[caucus + "_mp_retained"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_mp_retained"]) || 0)
        );
        Q[caucus + "_mp_departure_rate"] = clamp(
            Q[caucus + "_mp_departure_rate"],
            0,
            1
        );
        Q[caucus + "_escalation_stage"] = Math.round(clamp(
            Q[caucus + "_escalation_stage"],
            0,
            7
        ));
        Q[caucus + "_escalation_label"] =
            escalationLabels[Q[caucus + "_escalation_stage"]];
    }

    let totalFactionStrength = 0;
    for (const faction of Q.factions) {
        Q[faction + "_dissent"] =
            clamp(Q[faction + "_dissent"], 0, 100);
        Q[faction + "_strength"] =
            clamp(Q[faction + "_strength"], 0, 100);
        totalFactionStrength += Q[faction + "_strength"];
    }
    if (totalFactionStrength <= 0 && Q.factions.length > 0) {
        const equalStrength = 100 / Q.factions.length;
        for (const faction of Q.factions) {
            Q[faction + "_strength"] = equalStrength;
        }
        totalFactionStrength = 100;
    } else {
        for (const faction of Q.factions) {
            Q[faction + "_strength"] =
                Q[faction + "_strength"] * 100 / totalFactionStrength;
        }
    }

    let weightedDissent = 0;
    let activeVetoes = 0;
    for (const faction of Q.factions) {
        const strength = Q[faction + "_strength"];
        const dissent = Q[faction + "_dissent"];
        weightedDissent += strength * dissent;
        if (strength >= 12 && dissent >= 60) {
            activeVetoes += 1;
        }
    }
    Q.internal_dissent = Q.factions.length > 0 ?
        Math.round(weightedDissent / 100) : 100;
    Q.faction_vetoes = activeVetoes;
    Q.party_action_effectiveness = Math.round(clamp(
        100 - Math.max(0, Q.internal_dissent - 20) * 0.80,
        35,
        100
    ));
    Q.message_discipline = Math.round(clamp(
        100 - Math.max(0, Q.internal_dissent - 20) -
            Q.faction_vetoes * 5,
        20,
        100
    ));
    const authoredLaborSplitPending =
        Q.labor_party_breakdown_authored &&
        Q.labor_active && Q.labor_in_left &&
        Number(Q.labor_escalation_stage) >= 7;
    const authoredLaborCrisisPending =
        Q.labor_party_breakdown_authored &&
        Q.labor_active && Q.labor_in_left &&
        (
            (
                Number(Q.labor_escalation_stage) == 2 &&
                !Q.labor_demand_answered &&
                Number(Q.time) >= Number(Q.labor_demand_deadline)
            ) ||
            Number(Q.labor_escalation_stage) >= 7
        );
    Q.caucus_split_pending = Q.factions.some(function(caucus) {
        if (caucus == "social_patriot" && Q.sld_populist_route_active) {
