        "court_user_trust",
        "judicial_vacancies",
        "president_judiciary_cooperation",
        "legal_dualism",
        "judicial_repair_mandate"
    ]) {
        Q[judicialQuality] = clamp(Q[judicialQuality], 0, 100);
    }
    Q.household_security = clamp(Q.household_security, 0, 100);
    Q.health_capacity = clamp(Q.health_capacity, 0, 100);
    Q.police_trust = clamp(Q.police_trust, 0, 100);
    Q.military_trust = clamp(Q.military_trust, 0, 100);
    Q.border_security_confidence =
        clamp(Q.border_security_confidence, 0, 100);
    Q.minority_safety = clamp(Q.minority_safety, 0, 100);
    Q.far_right_agenda = clamp(Q.far_right_agenda, 0, 100);
    Q.republika_capacity = clamp(Q.republika_capacity, 0, 100);
    Q.kanal_zero_capacity = clamp(Q.kanal_zero_capacity, 0, 100);
    Q.border_rights_standard = clamp(Q.border_rights_standard, 0, 100);
    Q.refugee_empathy = clamp(Q.refugee_empathy, 0, 100);
    Q.anti_ukrainian_pressure =
        clamp(Q.anti_ukrainian_pressure, 0, 100);
    Q.movement_autonomy = clamp(Q.movement_autonomy, 0, 100);
    Q.organiser_energy = clamp(Q.organiser_energy, 0, 100);
    Q.pandemic_deaths_pressure =
        clamp(Q.pandemic_deaths_pressure, 0, 100);

    // Public-opinion migration. These defaults are used only when an old save
    // predates the issue model; authored event and card shifts are never
    // replaced once a track exists.
    const publicOpinionDefaults = {
        abortion_rights: [49, 42, 58],
        refugee_solidarity: [
            Number.isFinite(Number(Q.refugee_empathy))
                ? Number(Q.refugee_empathy)
                : 38,
            Q.border_2021_event_done ? 68 : 34,
            Q.border_2021_event_done ? 72 : 58
        ],
        border_security: [
            Number.isFinite(Number(Q.border_security_confidence))
                ? Math.max(55, Number(Q.border_security_confidence))
                : 70,
            Q.border_2021_event_done ? 76 : 44,
            Q.border_2021_event_done ? 60 : 36
        ],
        vaccination: [
            Q.vaccine_event_done ? 68 : 76,
            Q.vaccine_event_done ? 62 : 24,
            Q.vaccine_event_done ? 54 : 27
        ],
        social_spending: [72, 67, 38],
        lgbt_equality: [48, 52, 62],
        secular_state: [52, 43, 58],
        rule_of_law: [
            Number.isFinite(Number(Q.judicial_repair_mandate))
                ? Math.max(45, Number(Q.judicial_repair_mandate))
                : 58,
            56,
            52
        ],
        national_security: [
            Number.isFinite(Number(Q.military_trust))
                ? Math.max(60, Number(Q.military_trust))
                : 74,
            Q.ukraine_invasion_event_done ? 78 : 48,
            Q.ukraine_invasion_event_done ? 46 : 34
        ]
    };
    const publicOpinionIssues = Object.keys(publicOpinionDefaults);
    if (!Array.isArray(Q.public_opinion_issues)) {
        Q.public_opinion_issues = publicOpinionIssues.slice();
    } else {
        for (const issue of publicOpinionIssues) {
            if (!Q.public_opinion_issues.includes(issue)) {
                Q.public_opinion_issues.push(issue);
            }
        }
    }
    for (const issue of publicOpinionIssues) {
        const defaults = publicOpinionDefaults[issue];
        for (const measure of [
            ["support", defaults[0]],
            ["salience", defaults[1]],
            ["backlash", defaults[2]]
        ]) {
            const quality = issue + "_" + measure[0];
            if (!Number.isFinite(Number(Q[quality]))) {
                Q[quality] = measure[1];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
    }
    Q.public_opinion_version = Math.max(
        1,
        Math.round(Number(Q.public_opinion_version) || 1)
    );
    let publicPanicTotal = 0;
    let publicConsensusTotal = 0;
    let hottestPublicIssue = publicOpinionIssues[0];
    let hottestPublicIssueScore = -1;
    const publicIssueLabels = {
        abortion_rights: "Abortion rights",
        refugee_solidarity: "Refugees and asylum solidarity",
        border_security: "Eastern-border security",
        vaccination: "Vaccination and public health",
        social_spending: "Social spending and public services",
        lgbt_equality: "LGBT equality",
        secular_state: "Secular state and schools",
        rule_of_law: "Rule-of-law repair",
        national_security: "Defence and allied security"
    };
    for (const issue of publicOpinionIssues) {
        const support = Number(Q[issue + "_support"]);
        const salience = Number(Q[issue + "_salience"]);
        const backlash = Number(Q[issue + "_backlash"]);
        const heat = salience * 0.65 + backlash * 0.35;
        publicPanicTotal += heat;
        publicConsensusTotal +=
            Math.abs(support - 50) * 2 * (1 - backlash / 200);
        if (heat > hottestPublicIssueScore) {
            hottestPublicIssueScore = heat;
            hottestPublicIssue = issue;
        }
    }
    Q.public_panic_index = Math.round(
        publicPanicTotal / publicOpinionIssues.length
    );
    Q.public_consensus_index = Math.round(
        publicConsensusTotal / publicOpinionIssues.length
    );
    Q.public_opinion_hottest_issue =
        publicIssueLabels[hottestPublicIssue];
    Q.public_opinion_last_delta = Number.isFinite(
        Number(Q.public_opinion_last_delta)
    )
        ? Number(Q.public_opinion_last_delta)
        : 0;
    Q.public_opinion_bridge_pressure = Number.isFinite(
        Number(Q.public_opinion_bridge_pressure)
    )
        ? clamp(Q.public_opinion_bridge_pressure, 0, 100)
        : 0;
    if (
        typeof Q.public_opinion_hottest_issue !== "string" ||
        !Q.public_opinion_hottest_issue.length
    ) {
        Q.public_opinion_hottest_issue =
            "Social spending and public services";
    }
    if (
        typeof Q.public_opinion_last_issue !== "string" ||
        !Q.public_opinion_last_issue.length
    ) {
        Q.public_opinion_last_issue = "None";
    }
    if (
        typeof Q.public_opinion_last_reception !== "string" ||
        !Q.public_opinion_last_reception.length
    ) {
        Q.public_opinion_last_reception = "No recent test";
    }
    if (
        typeof Q.public_opinion_last_action !== "string" ||
        !Q.public_opinion_last_action.length
    ) {
        Q.public_opinion_last_action = "No public-opinion test yet";
    }
    if (
        typeof Q.public_opinion_last_updated !== "string" ||
        !Q.public_opinion_last_updated.length
    ) {
        Q.public_opinion_last_updated =
            (Q.date_label || "Current month") + " model";
    }
    if (
        !["breakthrough", "favourable", "contested", "backlash", "reversal"]
            .includes(Q.card_public_response)
    ) {
        Q.card_public_response = "contested";
    }
    Q.card_public_response_score = Number.isFinite(
        Number(Q.card_public_response_score)
    )
        ? clamp(Q.card_public_response_score, -3, 3)
        : 0;
    const publicBridgeSources = {
        feminist_trust: 44,
        refugee_empathy: 58,
        border_confidence: 48,
        border_rights: 45,
        far_right_agenda: 32,
        minority_safety: 56,
        household_security: 45,
        health_capacity: 48,
        pandemic_pressure: 0,
        anti_ukrainian: 8,
        judicial_legitimacy: 36,
        repair_mandate: 38,
        military_trust: 66,
        police_trust: 45
    };
    const publicBridgeCurrent = {
        feminist_trust: Q.feminist_trust,
        refugee_empathy: Q.refugee_empathy,
        border_confidence: Q.border_security_confidence,
        border_rights: Q.border_rights_standard,
        far_right_agenda: Q.far_right_agenda,
        minority_safety: Q.minority_safety,
        household_security: Q.household_security,
        health_capacity: Q.health_capacity,
        pandemic_pressure: Q.pandemic_deaths_pressure,
        anti_ukrainian: Q.anti_ukrainian_pressure,
        judicial_legitimacy: Q.judicial_legitimacy,
        repair_mandate: Q.judicial_repair_mandate,
        military_trust: Q.military_trust,
        police_trust: Q.police_trust
    };
    if (!Number(Q.public_bridge_initialized)) {
        // Begin observing an old save at its current state. This prevents a
        // migration from replaying years of historical changes as one shock.
        for (const bridge of Object.keys(publicBridgeSources)) {
            const current = Number(publicBridgeCurrent[bridge]);
            Q["public_bridge_" + bridge] = Number.isFinite(current)
                ? current
                : publicBridgeSources[bridge];
        }
        Q.public_bridge_initialized = 1;
    } else {
        for (const bridge of Object.keys(publicBridgeSources)) {
            const quality = "public_bridge_" + bridge;
            if (!Number.isFinite(Number(Q[quality]))) {
                const current = Number(publicBridgeCurrent[bridge]);
                Q[quality] = Number.isFinite(current)
                    ? current
                    : publicBridgeSources[bridge];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
    }

    Q.workers_support = clamp(Q.workers_support, 0, 100);
    Q.public_sector_support = clamp(Q.public_sector_support, 0, 100);
    Q.young_support = clamp(Q.young_support, 0, 100);
    Q.women_support = clamp(Q.women_support, 0, 100);
    Q.urban_progressive_support =
        clamp(Q.urban_progressive_support, 0, 100);
    Q.rural_support = clamp(Q.rural_support, 0, 100);
    Q.pensioner_support = clamp(Q.pensioner_support, 0, 100);
    Q.turnout_readiness = clamp(Q.turnout_readiness, 0, 100);

    const foreignNumericDefaults = {
        eu_campaign_progress: 0,
        eu_campaign_complete: 0,
        eu_brussels_mission: 0,
        eu_social_mission: 0,
        eu_eastern_mission: 0,
        eu_triangle_mission: 0,
        eu_influence: 28,
        eu_institutional_trust: 26,
        eu_left_network: 20,
        eu_eastern_coalition: 24,
        germany_relation: 38,
        france_relation: 32,
        foreign_pressure: 18,
        foreign_cards_resolved: 0,
        us_alliance_reliability: 48,
        us_rule_of_law_pressure: 12,
        us_ambassador_channel: 44,
        us_defence_channel: 62,
        us_congress_channel: 40,
        left_atlanticist_dissent: 10,
        us_election_2020_done: Q.year > 2020 ? 1 : 0,
        us_2020_roll: 0,
        us_2020_democratic_vote: Q.year > 2020 ? 51.3 : 0,
        us_2020_republican_vote: Q.year > 2020 ? 48.7 : 0,
        us_election_2024_done: Q.year > 2024 ? 1 : 0,
        us_2024_roll: 0,
        us_2024_democratic_vote: Q.year > 2024 ? 48.4 : 0,
        us_2024_republican_vote: Q.year > 2024 ? 51.6 : 0
    };
    for (const quality of Object.keys(foreignNumericDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = foreignNumericDefaults[quality];
        }
    }
    const foreignMissionFlags = [
        "eu_campaign_complete",
        "eu_brussels_mission",
        "eu_social_mission",
        "eu_eastern_mission",
        "eu_triangle_mission",
        "us_election_2020_done",
        "us_election_2024_done"
    ];
    for (const flag of foreignMissionFlags) {
        Q[flag] = Q[flag] ? 1 : 0;
    }
    Q.eu_campaign_progress = Math.max(
        Number(Q.eu_campaign_progress) || 0,
        Q.eu_brussels_mission +
            Q.eu_social_mission +
            Q.eu_eastern_mission +
            Q.eu_triangle_mission
    );
    Q.eu_campaign_progress = Math.max(
        0,
        Math.min(4, Math.round(Q.eu_campaign_progress))
    );
    Q.eu_influence = clamp(Q.eu_influence, 0, 100);
    Q.eu_institutional_trust =
        clamp(Q.eu_institutional_trust, 0, 100);
    Q.eu_left_network = clamp(Q.eu_left_network, 0, 100);
    Q.eu_eastern_coalition = clamp(Q.eu_eastern_coalition, 0, 100);
    Q.germany_relation = clamp(Q.germany_relation, 0, 100);
    Q.france_relation = clamp(Q.france_relation, 0, 100);
    Q.foreign_pressure = clamp(Q.foreign_pressure, 0, 100);
    Q.foreign_cards_resolved = Math.max(
        0,
        Math.round(Q.foreign_cards_resolved)
    );
    Q.us_alliance_reliability =
        clamp(Q.us_alliance_reliability, 0, 100);
    Q.us_rule_of_law_pressure =
        clamp(Q.us_rule_of_law_pressure, 0, 100);
    Q.us_ambassador_channel = clamp(Q.us_ambassador_channel, 0, 100);
    Q.us_defence_channel = clamp(Q.us_defence_channel, 0, 100);
    Q.us_congress_channel = clamp(Q.us_congress_channel, 0, 100);
    Q.left_atlanticist_dissent =
        clamp(Q.left_atlanticist_dissent, 0, 100);
    Q.us_2020_roll = clamp(Q.us_2020_roll, 0, 1);
    Q.us_2024_roll = clamp(Q.us_2024_roll, 0, 1);
    Q.us_2020_democratic_vote =
        clamp(Q.us_2020_democratic_vote, 0, 100);
    Q.us_2020_republican_vote =
        clamp(Q.us_2020_republican_vote, 0, 100);
    Q.us_2024_democratic_vote =
        clamp(Q.us_2024_democratic_vote, 0, 100);
    Q.us_2024_republican_vote =
        clamp(Q.us_2024_republican_vote, 0, 100);
    if (
        typeof Q.us_election_2020_winner !== "string" ||
        !Q.us_election_2020_winner.length
    ) {
        Q.us_election_2020_winner =
            Q.year > 2020 ? "Joe Biden" : "Undecided";
    }
    if (
        typeof Q.us_election_2024_winner !== "string" ||
        !Q.us_election_2024_winner.length
    ) {
        Q.us_election_2024_winner =
            Q.year > 2024 ? "Donald Trump" : "Undecided";
    }
    if (
        typeof Q.us_2024_republican_candidate !== "string" ||
        !Q.us_2024_republican_candidate.length
    ) {
        Q.us_2024_republican_candidate =
            Q.us_election_2020_winner == "Donald Trump"
