    );
    Q.dues_withheld = Math.max(0, Number(Q.dues_withheld) || 0);
    Q.lost_dues_total = Math.max(0, Number(Q.lost_dues_total) || 0);
    Q.strategic_centre_label = Q.organised_left_splits > 0
        ? (
