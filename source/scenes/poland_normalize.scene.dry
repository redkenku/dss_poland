    // rival AI owns first-time migration and authored defaults.
    for (const quality of [
        "party_system_left_pull",
        "party_system_konf_pull",
        "covid_anti_system_pressure",
        "democratic_rightward_pressure",
        "left_right_score",
        "pis_right_score",
        "ko_right_score",
        "psl_right_score",
        "konf_right_score",
        "p2050_right_score",
        "pis_solidarist_share",
        "pis_market_hardliner_share",
        "ko_social_liberal_share",
        "ko_classical_liberal_share",
        "psl_agrarian_pragmatist_share",
        "psl_conservative_share",
        "psl_coalition_manager_share",
        "konf_braunist_share",
        "konf_mentzenite_share",
        "konf_nationalist_share",
        "p2050_state_capacity_share",
        "p2050_christian_dem_share",
        "p2050_personalist_share"
    ]) {
        clampIfPresent(quality, 0, 100);
    }
    clampIfPresent("party_system_pendulum", -100, 100);
    for (const party of ["pis", "ko", "psl", "konf", "p2050"]) {
        for (const acceptance of [
            "accept_social",
            "accept_rights",
            "accept_order",
            "accept_market",
            "coalition_openness"
        ]) {
            clampIfPresent(
                party + "_" + acceptance,
                0,
                100
            );
        }
        clampIfPresent(party + "_right_score_previous", 0, 100);
        clampIfPresent(party + "_wing_model_initialized", 0, 1);
    }
    clampIfPresent("rival_wings_initialized", 0, 1);
    if (Number.isFinite(Number(Q.rival_wings_version))) {
        Q.rival_wings_version = Math.max(
            0,
            Math.round(Number(Q.rival_wings_version))
        );
    }

    const konfShares = [
        "konf_braunist_share",
        "konf_mentzenite_share",
        "konf_nationalist_share"
    ];
    if (konfShares.every(function(quality) {
        return Number.isFinite(Number(Q[quality]));
    })) {
        let konfShareTotal = konfShares.reduce(function(total, quality) {
            return total + clamp(Number(Q[quality]), 0, 100);
        }, 0);
        if (konfShareTotal <= 0) {
            // A wholly corrupt trio has no evolved ratio to preserve.
            Q.konf_braunist_share = 18;
            Q.konf_mentzenite_share = 47;
            Q.konf_nationalist_share = 35;
            konfShareTotal = 100;
        } else {
            Q.konf_braunist_share =
                Q.konf_braunist_share / konfShareTotal * 100;
            Q.konf_mentzenite_share =
                Q.konf_mentzenite_share / konfShareTotal * 100;
            Q.konf_nationalist_share =
                100 -
                Q.konf_braunist_share -
                Q.konf_mentzenite_share;
        }
    }

    for (const party of ["pis", "ko", "psl", "konf", "p2050"]) {
        // The rival organisational pools are deliberately uncapped.
        Q[party + "_org_resources"] =
            Number.isFinite(Number(Q[party + "_org_resources"]))
                ? Math.max(0, Number(Q[party + "_org_resources"]))
                : 0;
        Q[party + "_org_income"] =
            Number.isFinite(Number(Q[party + "_org_income"]))
                ? Math.max(0, Number(Q[party + "_org_income"]))
                : 0;
        Q[party + "_ai_actions"] =
            Number.isFinite(Number(Q[party + "_ai_actions"]))
                ? Math.max(0, Number(Q[party + "_ai_actions"]))
                : 0;
        Q[party + "_ai_last_spend"] =
            Number.isFinite(Number(Q[party + "_ai_last_spend"]))
                ? Math.max(0, Number(Q[party + "_ai_last_spend"]))
                : 0;
        Q[party + "_ai_acted"] =
            Number.isFinite(Number(Q[party + "_ai_acted"]))
                ? clamp(Q[party + "_ai_acted"], 0, 1)
                : 0;
        // Preserve compatibility with the election prototype's earlier names.
        Q[party + "_ai_resources"] =
            Math.max(0, Number(Q[party + "_ai_resources"]) || 0);
        Q[party + "_ai_income"] =
            Math.max(0, Number(Q[party + "_ai_income"]) || 0);
        Q[party + "_ai_activity"] =
            clamp(Q[party + "_ai_activity"], 0, 100);
    }
    for (const party of ["p0"]) {
        Q[party + "_org_resources"] =
            Number.isFinite(Number(Q[party + "_org_resources"]))
                ? Math.max(0, Number(Q[party + "_org_resources"]))
                : 0;
        Q[party + "_org_income"] =
            Number.isFinite(Number(Q[party + "_org_income"]))
                ? Math.max(0, Number(Q[party + "_org_income"]))
                : 0;
        Q[party + "_ai_actions"] =
            Number.isFinite(Number(Q[party + "_ai_actions"]))
                ? Math.max(0, Number(Q[party + "_ai_actions"]))
                : 0;
        Q[party + "_ai_last_spend"] =
            Number.isFinite(Number(Q[party + "_ai_last_spend"]))
                ? Math.max(0, Number(Q[party + "_ai_last_spend"]))
                : 0;
        Q[party + "_ai_acted"] =
            Number.isFinite(Number(Q[party + "_ai_acted"]))
                ? clamp(Q[party + "_ai_acted"], 0, 1)
                : 0;
    }
    for (const pair of [
        "pis_ko",
        "pis_psl",
        "pis_konf",
        "pis_p2050",
        "ko_psl",
        "ko_konf",
        "ko_p2050",
        "psl_konf",
        "psl_p2050",
        "konf_p2050"
    ]) {
        const canonicalKey = "rival_relation_" + pair;
        const compatibilityKey = "relation_" + pair;
        const relationValue = Number.isFinite(Number(Q[canonicalKey]))
            ? Number(Q[canonicalKey])
            : (
                Number.isFinite(Number(Q[compatibilityKey]))
                    ? Number(Q[compatibilityKey])
                    : 0
            );
        Q[canonicalKey] = clamp(relationValue, 0, 100);
        Q[compatibilityKey] = Q[canonicalKey];
    }
    // A coalition needs trust and a survivable common programme. Distance is
    // measured on the same 0-100 economic and cultural axes the rival AI
    // already drifts, with the economic axis discounted because Polish
    // coalitions break on culture rather than on tax policy: that is what
    // separates a plausible PiS-Konfederacja cabinet from an impossible
    // KO-Konfederacja one, even though the two pairs sit a similar raw
    // distance apart. Small distances demand nothing, so ordinary partners
    // stay available at their opening relations; the required relation then
    // climbs with distance, and past coalitionMaxDistance no relation value
    // is enough. A socially liberal KO therefore loses Konfederacja as a
    // partner by moving, not by an authored veto.
    // ponytail: two axes and a linear floor; the three weights below are the
    // calibration knobs if a bloc turns out too easy or too hard to sign.
    const coalitionEconomicWeight = 0.7;
    const coalitionDistanceFloor = 30;
    const coalitionMaxDistance = 55;
    const coalitionPositionDefaults = {
        left: {economic: 52, cultural: 52},
        pis: {economic: 31, cultural: 86},
        ko: {economic: 60, cultural: 43},
        psl: {economic: 49, cultural: 68},
        konf: {economic: 86, cultural: 91},
        p2050: {economic: 55, cultural: 51}
    };
    const coalitionPosition = function(id, axis) {
        const value = Number(Q[id + "_" + axis + "_position"]);
        return Number.isFinite(value)
            ? value
            : coalitionPositionDefaults[id][axis];
    };
    // "left" is the player. Its pairs read the player's own relation
    // qualities; every other pair reads the hidden rival matrix above.
    const coalitionOrder = ["left", "pis", "ko", "psl", "konf", "p2050"];
    coalitionOrder.forEach(function(first, firstIndex) {
        coalitionOrder.slice(firstIndex + 1).forEach(function(second) {
            const economicGap =
                Math.abs(
                    coalitionPosition(first, "economic") -
                    coalitionPosition(second, "economic")
                ) * coalitionEconomicWeight;
            const culturalGap = Math.abs(
                coalitionPosition(first, "cultural") -
                coalitionPosition(second, "cultural")
            );
            const distance = Math.round(
                Math.sqrt(
                    economicGap * economicGap + culturalGap * culturalGap
                )
            );
            const relationKey = first == "left"
                ? second + "_relation"
                : "rival_relation_" + first + "_" + second;
            const relation = Number.isFinite(Number(Q[relationKey]))
                ? Number(Q[relationKey])
                : 0;
            const required = Math.round(
                Math.max(0, distance - coalitionDistanceFloor) * 1.2
            );
            const pair = first + "_" + second;
            Q["coalition_distance_" + pair] = distance;
            Q["coalition_required_relation_" + pair] = required;
            Q["coalition_viable_" + pair] =
                distance <= coalitionMaxDistance && relation >= required
                    ? 1
                    : 0;
        });
    });
    if (Q.psl_right_alignment_locked) {
        for (const pair of ["left_psl", "ko_psl", "psl_p2050"]) {
            Q["coalition_viable_" + pair] = 0;
        }
    }
    // The formation menu calculates its seat totals before calling this
    // normaliser. Publish the table colors here, after the live compatibility
    // gates above, so the table and its choices cannot disagree.
    const canContract = function() {
        return Array.from(arguments).every(function(pair) {
            return Number(Q["coalition_viable_" + pair]) == 1;
        });
    };
    const coalitionTableStatus = function(ready, needsSupport) {
        return ready
            ? (needsSupport ? "Needs support" : "Passes")
            : "No path";
    };
    const is2023Formation = Number(Q.year) == 2023;
    Q.formation_status_democratic = coalitionTableStatus(
        Q.formation_option_democratic >= Q.formation_majority_needed &&
            canContract(
                "left_ko", "left_psl", "left_p2050", "ko_psl", "ko_p2050"
            )
    );
    Q.formation_status_ko_psl_left = coalitionTableStatus(
        Q.formation_option_ko_psl_left >= Q.formation_majority_needed &&
            canContract("left_ko", "left_psl", "ko_psl"),
        Q.formation_option_ko_psl_left_outside > 0
    );
    Q.formation_status_ko_p2050_left = coalitionTableStatus(
        Q.formation_option_ko_p2050_left >= Q.formation_majority_needed &&
            canContract("left_ko", "left_p2050", "ko_p2050"),
        Q.formation_option_ko_p2050_left_outside > 0
    );
    Q.formation_status_left_p2050 = coalitionTableStatus(
        Q.formation_option_left_p2050 >= Q.formation_majority_needed &&
            canContract("left_p2050")
    );
    Q.formation_status_left_psl = coalitionTableStatus(
        Q.formation_option_left_psl >= Q.formation_majority_needed &&
            canContract("left_psl")
    );
    Q.formation_status_left_third = coalitionTableStatus(
        Q.formation_option_left_third >= Q.formation_majority_needed &&
            canContract("left_psl", "left_p2050", "psl_p2050")
    );
    Q.formation_status_third_left_pis = coalitionTableStatus(
        Q.formation_option_left_third < Q.formation_majority_needed &&
            Q.formation_option_third_left_pis >=
