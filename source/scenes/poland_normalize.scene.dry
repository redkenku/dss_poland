    Q.negotiation_successes =
        Math.max(0, Math.round(Number(Q.negotiation_successes) || 0));
    Q.negotiation_last_score = Number.isFinite(
        Number(Q.negotiation_last_score)
    ) ? clamp(Q.negotiation_last_score, 0, 100) : 0;
    Q.negotiation_last_threshold = Number.isFinite(
        Number(Q.negotiation_last_threshold)
    ) ? clamp(Q.negotiation_last_threshold, 0, 100) : 0;
    Q.pis_cohabitation_stress = Number.isFinite(
        Number(Q.pis_cohabitation_stress)
    ) ? clamp(Q.pis_cohabitation_stress, 0, 100) : 0;
    Q.pis_cohabitation_rally = Number.isFinite(
        Number(Q.pis_cohabitation_rally)
    ) ? clamp(Q.pis_cohabitation_rally, 0, 100) : 0;
    Q.pis_cohabitation_last_shift = Number.isFinite(
        Number(Q.pis_cohabitation_last_shift)
    ) ? clamp(Q.pis_cohabitation_last_shift, -20, 20) : 0;
    const advisorRoster = [
        "czarzasty",
        "biedron",
        "zandberg",
        "dziemianowicz_bak",
        "zukowska",
        "kotula",
        "biejat",
        "wieczorek",
        "gawkowski",
        "nowicka",
        "zawisza",
        "matysiak"
    ];
    Q.n_advisors = advisorRoster.reduce(function(total, advisor) {
        return total +
            (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
    }, 0);
    const advisorCaucuses = {
        barons: ["czarzasty", "wieczorek"],
        spring: Q.spring_active ? ["biedron"] : [],
        labor: ["dziemianowicz_bak"],
        progressives: [
            "zukowska", "kotula", "gawkowski", "nowicka"
        ].concat(Q.spring_active ? [] : ["biedron"]),
        razem: ["zandberg", "biejat", "zawisza", "matysiak"],
        pps: []
    };
    for (const faction of Q.factions) {
        const caucusRoster = advisorCaucuses[faction] || [];
        Q[faction + "_advisor_count"] =
            caucusRoster.reduce(function(total, advisor) {
                return total +
                    (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
            }, 0);
    }

    let totalFactionStrength = 0;
    for (const faction of Q.factions) {
        Q[faction + "_dissent"] =
            clamp(Q[faction + "_dissent"], 0, 100);
        Q[faction + "_strength"] =
            clamp(Q[faction + "_strength"], 0, 100);
        totalFactionStrength += Q[faction + "_strength"];
    }
    if (totalFactionStrength <= 0 && Q.factions.length > 0) {
        const equalStrength = 100 / Q.factions.length;
        for (const faction of Q.factions) {
            Q[faction + "_strength"] = equalStrength;
        }
        totalFactionStrength = 100;
    } else {
        for (const faction of Q.factions) {
            Q[faction + "_strength"] =
                Q[faction + "_strength"] * 100 / totalFactionStrength;
        }
    }

    let weightedDissent = 0;
    let activeVetoes = 0;
    for (const faction of Q.factions) {
        const strength = Q[faction + "_strength"];
        const dissent = Q[faction + "_dissent"];
        weightedDissent += strength * dissent;
        if (strength >= 12 && dissent >= 60) {
            activeVetoes += 1;
        }
    }
    Q.internal_dissent = Q.factions.length > 0 ?
        Math.round(weightedDissent / 100) : 100;
    Q.faction_vetoes = activeVetoes;
    Q.caucus_crisis_pending = Q.factions.some(function(caucus) {
        return Q[caucus + "_dissent"] >= 72 &&
            Number(Q.time) >=
                Number(Q[caucus + "_last_crisis_time"]) + 4;
    }) ? 1 : 0;

    const splinterSeatQualities = [
        "sld_breakaway_seats",
        "spring_breakaway_seats",
        "labor_left_seats",
        "young_left_seats",
        "razem_party_seats",
        "pps_party_seats"
    ];
    Q.left_splinter_seats = splinterSeatQualities.reduce(
        function(total, quality) {
            return total + Math.max(
                0,
                Math.round(Number(Q[quality]) || 0)
            );
        },
        0
    );
    Q.left_family_seats =
        Math.max(0, Math.round(Number(Q.left_seats) || 0)) +
        Q.left_splinter_seats;
    const splinterRelations = [
        ["sld_breakaway_seats", "barons_party_relation"],
        ["spring_breakaway_seats", "spring_party_relation"],
        ["labor_left_seats", "labor_party_relation"],
        ["young_left_seats", "progressives_party_relation"],
        ["razem_party_seats", "razem_party_relation"],
        ["pps_party_seats", "pps_party_relation"]
    ];
    Q.left_splinter_support_votes = splinterRelations.reduce(
        function(total, entry) {
            return total + (
                Number(Q[entry[1]]) >= 45
                    ? Math.max(0, Math.round(Number(Q[entry[0]]) || 0))
                    : 0
            );
        },
        0
    );
    Q.left_committed_seats =
        Math.max(0, Math.round(Number(Q.left_seats) || 0)) +
        Q.left_splinter_support_votes;
    const centrumCommitted =
        Number(Q.centrum_relation) >= 45
            ? Math.max(
                0,
                Math.round(Number(Q.centrum_seats) || 0)
            )
            : 0;
    Q.coalition_democratic_seats =
        Math.max(0, Math.round(Number(Q.ko_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.psl_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.p2050_seats) || 0)) +
        centrumCommitted +
        Q.left_committed_seats;
    Q.coalition_right_seats =
        Math.max(0, Math.round(Number(Q.pis_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.konf_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.rozwoj_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.korona_seats) || 0));

    const chamberNumbers = [
        "senate_total",
        "senate_pis_seats",
        "senate_ko_seats",
        "senate_psl_seats",
        "senate_left_seats",
        "senate_independent_seats",
        "senate_opposition_seats",
        "senate_working_votes",
        "senate_amendment_credit",
        "confidence_present",
        "confidence_threshold",
        "confidence_yes",
        "confidence_no",
        "confidence_abstain",
        "morawiecki_votes",
        "democratic_votes",
        "morawiecki_left_defectors",
        "morawiecki_psl_defectors",
        "coalition_seats"
    ];
    for (const quality of chamberNumbers) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? Math.max(0, Number(Q[quality]))
            : 0;
    }
    Q.senate_cohesion = clamp(Q.senate_cohesion, 0, 100);
    Q.senate_left_leverage = clamp(Q.senate_left_leverage, 0, 100);
    Q.third_way_cohesion = clamp(Q.third_way_cohesion, 0, 100);
    Q.government_coalition_dissent =
        clamp(Q.government_coalition_dissent, 0, 100);
    Q.ko_coalition_dissent = clamp(Q.ko_coalition_dissent, 0, 100);
    Q.psl_coalition_dissent = clamp(Q.psl_coalition_dissent, 0, 100);
    Q.p2050_coalition_dissent =
        clamp(Q.p2050_coalition_dissent, 0, 100);
    Q.left_coalition_dissent =
        clamp(Q.left_coalition_dissent, 0, 100);
}
!}
