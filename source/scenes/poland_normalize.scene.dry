        ["nowa_nadzieja", "konf", "party", "Wolność", "Janusz Korwin-Mikke", "Konfederacja", "allied party", 1, 1, 26, 48, 2, 5],
        ["ruch_narodowy", "konf", "party", "Ruch Narodowy", "Krzysztof Bosak", "Konfederacja", "allied party", 1, 1, 32, 62, 4, 5],
        ["kkp", "konf", "party", "Konfederacja Korony Polskiej", "Grzegorz Braun", "Konfederacja", "allied party", 1, 1, 16, 70, -8, 1],
        ["konf_committee", "konf", "party", "Konfederacja Wolność i Niepodległość", "collective presidium", "Konfederacja Wolność i Niepodległość", "electoral alliance", 1, 1, 34, 44, 2, 0],
        ["zp_committee", "pis", "party", "Zjednoczona Prawica", "Jarosław Kaczyński", "Zjednoczona Prawica", "electoral alliance", 1, 1, 70, 66, 8, 0],
        ["republikanie", "pis", "party", "Partia Republikańska", "Adam Bielan", "United Right", "not formed", 0, 1, 0, 0, 18, 0],
        ["odnowa", "pis", "party", "OdNowa RP", "Marcin Ociepa", "United Right", "not formed", 0, 1, 0, 0, 20, 0],
        ["duda_movement", "pis", "party", "Duda civic vehicle", "Andrzej Duda", "Presidential milieu", "not formed", 0, 0, 0, 0, 28, 0],
        ["tak_rozwoj_party", "left", "party", "Tak! Dla Rozwoju", "Paulina Matysiak", "Tak! Dla Rozwoju", "not formed", 0, 0, 0, 0, 22, 0],
        ["p0_party", "p0", "party", "Partia Zero", "Krzysztof Stanowski", "Partia Zero", "not formed", 0, 0, 0, 0, 20, 0],
        ["prawica_committee", "pis", "committee", "Prawica", "Andrzej Duda", "Prawica", "not formed", 0, 0, 0, 0, 30, 0]
    ];
    if (!Array.isArray(Q.rival_group_records)) {
        Q.rival_group_records = [];
    }
    const rivalGroupFields = [
        "id", "bloc", "kind", "name", "leader", "parent",
        "legal_status", "active", "allied", "organisation", "cohesion",
        "relation", "mp_count", "exclusive_seats"
    ];
    for (const values of rivalGroupDefaults) {
        let record = Q.rival_group_records.find(function(candidate) {
            return candidate && candidate.id == values[0];
        });
        if (!record) {
            record = {};
            Q.rival_group_records.push(record);
        }
        for (let index = 0; index < rivalGroupFields.length; index += 1) {
            const field = rivalGroupFields[index];
            if (record[field] === undefined || record[field] === null) {
                record[field] = values[index];
            }
        }
        const detailDefaults = {
            broker: record.leader,
            sejm_mps: record.mp_count,
            senators: 0,
            meps: 0,
            local_base: record.organisation,
            offices: record.allied ? 20 : 0,
            media_reach: Math.round(
                (Number(record.organisation) + Number(record.cohesion)) / 2
            ),
            policy_priorities: "autonomous organisational priorities",
            red_lines: "loss of organisation without an internal mandate",
            electoral_outside_option: record.active
                ? "retain or build an autonomous organisation"
                : "not currently available",
            defection_readiness: 0,
            grievance_memory: 0
        };
        for (const field of Object.keys(detailDefaults)) {
            if (record[field] === undefined || record[field] === null) {
                record[field] = detailDefaults[field];
            }
        }
        for (const field of [
            "active", "allied", "organisation", "cohesion", "relation",
            "mp_count", "exclusive_seats", "sejm_mps", "senators", "meps",
            "local_base", "offices", "media_reach", "defection_readiness",
            "grievance_memory"
        ]) {
            record[field] = Number(record[field]) || 0;
        }
        record.organisation = clamp(record.organisation, 0, 100);
        record.cohesion = clamp(record.cohesion, 0, 100);
        record.relation = clamp(record.relation, -100, 100);
        record.local_base = clamp(record.local_base, 0, 100);
        record.offices = clamp(record.offices, 0, 100);
        record.media_reach = clamp(record.media_reach, 0, 100);
        record.defection_readiness = clamp(
            record.defection_readiness,
            0,
            100
        );
        record.grievance_memory = clamp(record.grievance_memory, 0, 100);
        record.mp_count = Math.max(0, Math.round(record.mp_count));
        record.sejm_mps = Math.max(0, Math.round(record.sejm_mps));
        record.senators = Math.max(0, Math.round(record.senators));
        record.meps = Math.max(0, Math.round(record.meps));
        record.exclusive_seats = Math.max(
            0,
            Math.round(record.exclusive_seats)
        );
    }
    // Five affiliations that historically move independently. A party can be
    // its own legal organisation, sit in a parliamentary club it does not
    // control, run on somebody else's list, hold portfolios and vote with the
    // government — and it can lose any one of those without losing the rest.
    // Nothing here is derived from anything else. `allied` still means
    // "friendly to the parent bloc" and `active` still means "the
    // organisation exists"; neither implies list, club or cabinet membership.
    const affiliationDefaults = {
        pis_party: ["pis", "pis", 1, "coalition", 0],
        pis_apparatus: ["pis", "pis", 1, "coalition", 0],
        porozumienie: ["pis", "pis", 1, "coalition", 1],
        solidarna: ["pis", "pis", 1, "coalition", 1],
        morawiecki: ["pis", "pis", 1, "coalition", 0],
        pis_welfare: ["pis", "pis", 1, "coalition", 0],
        pis_security: ["pis", "pis", 1, "coalition", 0],
        pis_culture: ["pis", "pis", 1, "coalition", 0],
        rozwoj_plus: ["pis", "pis", 0, "coalition", 0],
        republikanie: ["pis", "pis", 0, "none", 1],
        odnowa: ["pis", "pis", 0, "none", 1],
        psl_party: ["psl", "kp", 0, "opposition", 1],
        p2050_party: ["p2050", "p2050", 0, "opposition", 1],
        kp_committee: ["psl", "kp", 0, "opposition", 0],
        nowa_nadzieja: ["konf", "konf", 0, "opposition", 1],
        ruch_narodowy: ["konf", "konf", 0, "opposition", 1],
        kkp: ["konf", "konf", 0, "opposition", 1],
        konf_committee: ["konf", "konf", 0, "opposition", 0],
        zp_committee: ["pis", "pis", 1, "coalition", 0],
        kukiz15: ["psl", "kp", 0, "opposition", 1],
        kp_partners: ["psl", "kp", 0, "opposition", 1],
        po: ["ko", "ko", 0, "opposition", 1],
        nowoczesna: ["ko", "ko", 0, "opposition", 1],
        ipl: ["ko", "ko", 0, "opposition", 1],
        greens: ["ko", "ko", 0, "opposition", 1],
        ko_party: ["ko", "ko", 0, "opposition", 1],
        ko_splinter: ["ko", "ko", 0, "opposition", 1],
        duda_movement: ["duda", "duda", 0, "opposition", 1]
    };
    const affiliationFields = [
        "list_committee", "club", "in_cabinet", "support_mode", "independent"
    ];
    const supportModes = ["coalition", "toleration", "opposition", "none"];
    for (const record of Q.rival_group_records) {
        const values = affiliationDefaults[record.id] ||
            [record.id, record.id, 0, "none", 1];
        for (let index = 0; index < affiliationFields.length; index += 1) {
            const field = affiliationFields[index];
            if (record[field] === undefined || record[field] === null) {
                record[field] = values[index];
            }
        }
        record.list_committee = String(record.list_committee || record.id);
        record.club = String(record.club || record.id);
        record.in_cabinet = record.in_cabinet ? 1 : 0;
        record.independent = record.independent ? 1 : 0;
        if (!supportModes.includes(String(record.support_mode))) {
            record.support_mode = "none";
        }
        const contestingDefaults = {
            pis_party: 1,
            po: 0,
            ko_party: 1,
            psl_party: 1,
            p2050_party: 0,
            nowa_nadzieja: 0,
            ruch_narodowy: 0,
            kkp: 0,
            konf_committee: 1,
            zp_committee: 1,
            ko_splinter: 0,
            duda_movement: 0
        };
        const ideologicalDefaults = {
            pis: [64, 82, 22],
            ko: [58, 38, 58],
            psl: [52, 58, 66],
            konf: [78, 92, 8]
        };
        const ideology = ideologicalDefaults[record.bloc] || [50, 50, 35];
        if (typeof record.ballot_name != "string" || !record.ballot_name) {
            record.ballot_name = record.name;
        }
        if (!Number.isFinite(Number(record.contesting))) {
            record.contesting = contestingDefaults[record.id] || 0;
        }
        if (!Number.isFinite(Number(record.threshold))) {
            record.threshold = /committee$/.test(record.id) ? 8 : 5;
        }
        if (!Number.isFinite(Number(record.vote_intent))) {
            record.vote_intent = 0;
        }
        if (!Number.isFinite(Number(record.poll_momentum))) {
            record.poll_momentum = 0;
        }
        if (!Number.isFinite(Number(record.projected_seats))) {
            record.projected_seats = 0;
        }
        if (!Number.isFinite(Number(record.economic_position))) {
            record.economic_position = ideology[0];
        }
        if (!Number.isFinite(Number(record.cultural_position))) {
            record.cultural_position = ideology[1];
        }
        if (!Number.isFinite(Number(record.coalition_openness))) {
            record.coalition_openness = ideology[2];
        }
        if (!Number.isFinite(Number(record.negotiated_list_share))) {
            record.negotiated_list_share = 0;
        }
        record.contesting = record.contesting ? 1 : 0;
        record.threshold = clamp(record.threshold, 0, 20);
        record.vote_intent = clamp(record.vote_intent, 0, 100);
        record.poll_momentum = clamp(record.poll_momentum, -20, 20);
        record.projected_seats = Math.round(clamp(
            record.projected_seats,
            0,
            460
        ));
        record.economic_position = clamp(record.economic_position, 0, 100);
        record.cultural_position = clamp(record.cultural_position, 0, 100);
        record.coalition_openness = clamp(record.coalition_openness, 0, 100);
        record.negotiated_list_share = clamp(
            record.negotiated_list_share,
            0,
            100
        );
    }
    Q.rival_group_schema_version = 4;
    if (typeof Q.rival_group_month_action != "string") {
        Q.rival_group_month_action =
            "No component organisation has acted yet";
    }
    Q.rival_group_ids = Q.rival_group_records.map(function(record) {
        return record.id;
    });
    const rivalGroup = function(id) {
        return Q.rival_group_records.find(function(record) {
            return record.id == id;
        });
    };

    // Saves made before the named-party seat ledger counted an independent
    // Suwerenna caucus both under its own name and in Others.
    if (
        Q.suwerenna_merger_result == "Merger refused" &&
        !Q.suwerenna_seat_ledger_corrected
    ) {
        Q.other_seats = Math.max(
            0,
            (Number(Q.other_seats) || 0) -
                Math.max(0, Number(Q.suwerenna_seats) || 0)
        );
        Q.suwerenna_seat_ledger_corrected = 1;
    }

    if (!Array.isArray(Q.rival_person_records)) {
        Q.rival_person_records = [];
    }
    const rivalPeopleDefaults = [
        ["gowin", "Jarosław Gowin", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["ociepa", "Marcin Ociepa", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["michalek", "Iwona Michałek", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["gut_mostowy", "Andrzej Gut-Mostowy", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["murdzek", "Wojciech Murdzek", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["sroka", "Magdalena Sroka", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["wypij", "Michał Wypij", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["bukowiec", "Stanisław Bukowiec", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["baszko", "Mieczysław Baszko", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["piechowiak", "Grzegorz Piechowiak", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["dabrowska_banaszek", "Anna Dąbrowska-Banaszek", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["emilewicz", "Jadwiga Emilewicz", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["bielan", "Adam Bielan", "European Parliament", "pis", "porozumienie", "undecided", "United Right MEP"],
        ["bortniczuk", "Kamil Bortniczuk", "Sejm", "pis", "porozumienie", "undecided", "United Right MP"],
        ["strzezek", "Jacek Strzeżek", "Sejm", "pis", "porozumienie", "Porozumienie", "United Right MP"],
        ["kukiz", "Paweł Kukiz", "Sejm", "psl", "kukiz15", "Kukiz'15", "Koalicja Polska MP"],
        ["tyszka", "Stanisław Tyszka", "Sejm", "psl", "kukiz15", "Kukiz'15", "Koalicja Polska MP"],
        ["morawiecki", "Mateusz Morawiecki", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["semieniuk", "Olga Semeniuk-Patkowska", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["cieszynski", "Janusz Cieszyński", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["jablonski", "Paweł Jabłoński", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["kwiecien", "Anna Kwiecień", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["bartosik", "Ryszard Bartosik", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["lorek", "Grzegorz Lorek", "Sejm", "pis", "pis", "PiS", "PiS MP"],
        ["dworczyk", "Michał Dworczyk", "European Parliament", "pis", "pis", "PiS", "PiS MEP"],
        ["muller", "Piotr Müller", "European Parliament", "pis", "pis", "PiS", "PiS MEP"]
    ];
    const personFields = [
        "id", "name", "chamber", "party", "organisation", "loyalty",
        "status"
    ];
    for (const values of rivalPeopleDefaults) {
        let person = Q.rival_person_records.find(function(candidate) {
            return candidate && candidate.id == values[0];
        });
        if (!person) {
            person = {};
            Q.rival_person_records.push(person);
        }
        for (let index = 0; index < personFields.length; index += 1) {
            const field = personFields[index];
            if (person[field] === undefined || person[field] === null) {
                person[field] = values[index];
            }
        }
    }
    Q.rival_person_schema_version = 1;

    const porozumienieRecord = rivalGroup("porozumienie");
    porozumienieRecord.active = Q.porozumienie_active ? 1 : 0;
    porozumienieRecord.exclusive_seats = Math.max(
        0,
        Math.round(Number(Q.porozumienie_seats) || 0)
    );
    if (Q.porozumienie_exit_done) {
        // Unlike Solidarna Polska, Gowin's party left the electoral committee
        // as well as the cabinet, so all five affiliations move together here.
        porozumienieRecord.allied = 0;
        porozumienieRecord.independent = 1;
        porozumienieRecord.in_cabinet = 0;
        porozumienieRecord.support_mode = "opposition";
        porozumienieRecord.club = "porozumienie";
        porozumienieRecord.list_committee =
            String(Q.porozumienie_list_committee || "porozumienie");
        porozumienieRecord.legal_status = "independent parliamentary party";
        porozumienieRecord.mp_count = Math.max(
            porozumienieRecord.mp_count,
            porozumienieRecord.exclusive_seats
        );
        porozumienieRecord.sejm_mps = porozumienieRecord.exclusive_seats;
    }
    const solidarnaRecord = rivalGroup("solidarna");
    if (Q.suwerenna_renamed) solidarnaRecord.name = "Suwerenna Polska";
    if (Q.suwerenna_walkout) {
        // A walkout ends cabinet membership and coalition discipline. It does
        // not by itself end the shared electoral committee: Solidarna Polska
        // stayed on the PiS list throughout its independence, and only an
        // explicit decision to file its own committee changes that.
        solidarnaRecord.active = 1;
        solidarnaRecord.independent = 1;
        solidarnaRecord.club = "sp";
        solidarnaRecord.in_cabinet = 0;
        solidarnaRecord.support_mode = "opposition";
        solidarnaRecord.legal_status = "independent party after walkout";
        solidarnaRecord.exclusive_seats = Math.max(
            0,
            Math.round(Number(Q.suwerenna_seats) || 0)
        );
        solidarnaRecord.sejm_mps = solidarnaRecord.exclusive_seats;
        solidarnaRecord.mp_count = solidarnaRecord.exclusive_seats;
    }
    if (Q.suwerenna_merged) {
        solidarnaRecord.active = 0;
        solidarnaRecord.allied = 1;
        solidarnaRecord.kind = "caucus";
        solidarnaRecord.independent = 0;
        solidarnaRecord.club = "pis";
        solidarnaRecord.legal_status = "merged current inside PiS";
    }
    solidarnaRecord.list_committee = Q.suwerenna_own_list ? "solidarna" : "pis";
    const rozwojRecord = rivalGroup("rozwoj_plus");
    if (Q.rozwoj_association_active) {
        const morawieckiRecord = rivalGroup("morawiecki");
        if (morawieckiRecord) {
            morawieckiRecord.active = 0;
            morawieckiRecord.mp_count = 0;
            morawieckiRecord.sejm_mps = 0;
            morawieckiRecord.legal_status = "absorbed into Rozwój+";
        }
        rozwojRecord.active = 1;
        rozwojRecord.legal_status = Q.rozwoj_party_formed
            ? "registered party"
            : (Q.rozwoj_club_formed
                ? "association with parliamentary club"
                : "political association");
    }
    if (Q.rozwoj_joined_left) {
        rozwojRecord.bloc = "left";
        rozwojRecord.kind = "current";
        rozwojRecord.parent = Q.left_realign_name || "Nowa Solidarność";
        rozwojRecord.legal_status = "internal developmental current";
        rozwojRecord.exclusive_seats = 0;
    }
    if (Q.rozwoj_internal_pis && !Q.rozwoj_party_formed &&
        !Q.rozwoj_joined_left) {
        rozwojRecord.bloc = "pis";
        rozwojRecord.kind = "current";
        rozwojRecord.parent = "Prawo i Sprawiedliwość";
        rozwojRecord.allied = 1;
        rozwojRecord.legal_status = "internal PiS sub-party/current";
        rozwojRecord.exclusive_seats = 0;
    }
    rozwojRecord.mp_count = Math.max(
        Number(Q.rozwoj_association_members) || 0,
        Number(Q.rozwoj_definitive_departures) || 0
    );
    rozwojRecord.sejm_mps = Number(Q.rozwoj_association_members) || 0;
    rozwojRecord.senators = Q.rozwoj_loyalty_declarations >= 40 ? 1 : 0;
    rozwojRecord.meps = Q.rozwoj_loyalty_declarations >= 40 ? 3 : 0;
    rozwojRecord.exclusive_seats = Math.max(
        0,
        Math.round(
            (Number(Q.rozwoj_seats) || 0) +
            (Number(Q.rozwoj_pending_seats) || 0)
        )
    );
    if (Q.rozwoj_party_formed && !Q.rozwoj_joined_left) {
        rozwojRecord.bloc = "rozwoj";
        rozwojRecord.kind = "party";
        rozwojRecord.parent = "Rozwój+";
        rozwojRecord.allied = 0;
        rozwojRecord.list_committee = "rozwoj";
        rozwojRecord.club = "rozwoj";
    }
    const takRozwojRecord = rivalGroup("tak_rozwoj_party");
    takRozwojRecord.active = Q.tak_dla_rozwoju_legal_party_formed ? 1 : 0;
    takRozwojRecord.name = Q.tak_rozwoj_party_name || "Tak! Dla Rozwoju";
    takRozwojRecord.leader = Q.tak_rozwoj_leader || "Paulina Matysiak";
    takRozwojRecord.parent = takRozwojRecord.name;
    takRozwojRecord.legal_status = Q.tak_rozwoj_legal_status;
    takRozwojRecord.list_committee = Q.tak_rozwoj_list_committee || "tak_rozwoj";
    takRozwojRecord.club = "tak_rozwoj";
    takRozwojRecord.contesting = takRozwojRecord.active;
    takRozwojRecord.exclusive_seats = Math.max(
        0, Math.round(Number(Q.tak_rozwoj_seats) || 0)
    );
    takRozwojRecord.mp_count = takRozwojRecord.exclusive_seats;
    takRozwojRecord.sejm_mps = takRozwojRecord.exclusive_seats;
    const p0Record = rivalGroup("p0_party");
    p0Record.active = Q.p0_formed ? 1 : 0;
    p0Record.name = Q.p0_name || "Partia Zero";
    p0Record.leader = Q.p0_leader || "Krzysztof Stanowski";
    p0Record.parent = p0Record.name;
    p0Record.legal_status = p0Record.active
        ? "registered political party"
        : "not formed";
    p0Record.list_committee = "p0";
    p0Record.club = "p0";
    p0Record.contesting = p0Record.active;
    p0Record.exclusive_seats = Math.max(
        0, Math.round(Number(Q.p0_seats) || 0)
    );
    p0Record.mp_count = p0Record.exclusive_seats;
    p0Record.sejm_mps = p0Record.exclusive_seats;
    const koPartyRecord = rivalGroup("ko_party");
    if (Q.ko_consolidated) {
        koPartyRecord.active = 1;
        koPartyRecord.legal_status = "registered party";
        koPartyRecord.organisation = Math.max(
            koPartyRecord.organisation,
            76
        );
        for (const id of ["po", "nowoczesna", "ipl"]) {
            const current = rivalGroup(id);
            if (current) {
                current.active = 1;
                current.allied = 1;
                current.kind = "current";
                current.parent = "Koalicja Obywatelska";
                current.legal_status = "internal KO current";
                current.exclusive_seats = 0;
            }
        }
    }
    const koSplinterRecord = rivalGroup("ko_splinter");
    const iplSplinter = Q.ko_splinter_active &&
        Q.ko_splinter_type == "Progressive" &&
        Q.ko_break_leader == "Barbara Nowacka";
    const activeSplinterRecord = iplSplinter
        ? rivalGroup("ipl")
        : koSplinterRecord;
    koSplinterRecord.active = Q.ko_splinter_active && !iplSplinter ? 1 : 0;
    if (Q.ko_splinter_active) {
        // A breakaway registers under a name, not under the name of the wing
        // it belonged to. The classical-liberal walkout re-founds Platforma
        // Obywatelska outside the bloc as Nowa Platforma, with its own
        // registration, colour and badge.
        Q.ko_splinter_name = iplSplinter
            ? "Inicjatywa Polska"
            : Q.ko_splinter_type == "Classical-liberal"
                ? "Nowa Platforma"
                : Q.ko_splinter_type + " KO splinter";
        Q.ko_splinter_class = iplSplinter
            ? "party-inicjatywa-polska"
            : Q.ko_splinter_type == "Classical-liberal"
                ? "party-np"
                : "party-ko";
        activeSplinterRecord.active = 1;
        activeSplinterRecord.name = Q.ko_splinter_name;
        activeSplinterRecord.leader = Q.ko_break_leader;
        activeSplinterRecord.bloc = "ko";
        activeSplinterRecord.kind = "party";
        activeSplinterRecord.parent = "Civic coalition";
        activeSplinterRecord.allied = 0;
        activeSplinterRecord.legal_status = "independent organisation";
        activeSplinterRecord.list_committee = "ko_splinter";
        activeSplinterRecord.club = "ko_splinter";
        activeSplinterRecord.independent = 1;
        activeSplinterRecord.relation = Q.ko_splinter_relation;
        activeSplinterRecord.exclusive_seats = Math.max(
            0,
            Math.round(Number(Q.ko_splinter_seats) || 0)
        );
        activeSplinterRecord.mp_count = activeSplinterRecord.exclusive_seats;
        activeSplinterRecord.sejm_mps = activeSplinterRecord.exclusive_seats;
    }

    // A prime minister's own electoral family is not the same fact as which
    // party controls the cabinet. A Lewica compromise candidate heading a
    // KO-led coalition is both a Lewica politician and the head of a KO
    // government, and events that want one of those must not read the other.
    const pmFamilyRoster = [
        ["left", [
            "Agnieszka Dziemianowicz-Bąk", "Magdalena Biejat",
            "Krzysztof Gawkowski", "Włodzimierz Czarzasty",
            "Robert Biedroń", "Adrian Zandberg", "Anna Maria Żukowska",
            "Tomasz Trela", "Joanna Senyszyn", "Marcelina Zawisza",
            "Dariusz Wieczorek", "Katarzyna Kotula", "Leszek Miller",
            "Monika Jaruzelska"
        ]],
        ["ko", [
            "Donald Tusk", "Rafał Trzaskowski", "Radosław Sikorski",
            "Marcin Kierwiński", "Borys Budka", "Adam Szłapka",
            "Barbara Nowacka", "Grzegorz Schetyna", "Adam Bodnar"
        ]],
        ["psl", [
            "Władysław Kosiniak-Kamysz", "Krzysztof Hetman",
            "Czesław Siekierski", "Piotr Zgorzelski"
        ]],
        ["p2050", [
            "Szymon Hołownia", "Katarzyna Pełczyńska-Nałęcz",
            "Paulina Hennig-Kloska", "Michał Gramatyka"
        ]],
        ["pis", [
            "Mateusz Morawiecki", "Beata Szydło", "Przemysław Czarnek",
            "Henryk Kowalczyk", "Jarosław Kaczyński", "Mariusz Błaszczak", "Piotr Müller",
            "Tobiasz Bocheński", Q.pres_2025_right_candidate, "Zbigniew Ziobro"
        ]],
        ["konf", [
            "Sławomir Mentzen", "Krzysztof Bosak", "Grzegorz Braun",
            "Janusz Korwin-Mikke"
        ]]
    ];
    const pmDynamicFamilies = [
        ["left", Q.left_leader], ["left", Q.prime_minister_left_nominee],
        ["ko", Q.ko_leader], ["psl", Q.psl_leader],
        ["p2050", Q.p2050_leader], ["pis", Q.pis_leader],
        ["konf", Q.konf_libertarian_leader]
    ];
    const primeMinisterName = String(Q.prime_minister || "");
    let pmFamily = "";
    for (const entry of pmFamilyRoster) {
        if (entry[1].includes(primeMinisterName)) { pmFamily = entry[0]; break; }
    }
    if (!pmFamily && primeMinisterName) {
        for (const entry of pmDynamicFamilies) {
            if (entry[1] && String(entry[1]) == primeMinisterName) {
                pmFamily = entry[0];
                break;
            }
        }
    }
    if (!pmFamily) {
        // Fall back to whoever controls the cabinet, which is the only other
        // thing we know about them.
        const governingParty = String(Q.government_party || "");
        pmFamily = governingParty == "lewica"
            ? "left"
            : (["ko", "psl", "p2050", "pis", "konf"].includes(governingParty)
                ? governingParty
                : "independent");
    }
    Q.pm_political_family = pmFamily;
    // A premiership Lewica holds because it is the largest party in the
    // cabinet is a different asset from one it holds because the larger
    // partners could not agree on anybody else. The second is borrowed.
    const cabinetPartnerSeats = [
        Q.ministry_pis_in_cabinet ? Number(Q.pis_seats) || 0 : 0,
        Q.ministry_ko_in_cabinet ? Number(Q.ko_seats) || 0 : 0,
        Q.ministry_psl_in_cabinet ? Number(Q.psl_seats) || 0 : 0,
        Q.ministry_p2050_in_cabinet ? Number(Q.p2050_seats) || 0 : 0,
        Q.ministry_konf_in_cabinet ? Number(Q.konf_seats) || 0 : 0
    ];
    const largestPartnerSeats = cabinetPartnerSeats.reduce(
        function(best, seats) { return Math.max(best, seats); }, 0
    );
    Q.left_is_strongest_coalition_partner =
        (Number(Q.left_seats) || 0) >= largestPartnerSeats ? 1 : 0;
    Q.left_pm_is_borrowed =
        pmFamily == "left" && !Q.left_is_strongest_coalition_partner &&
        largestPartnerSeats > 0 ? 1 : 0;
    const pmFamilyNames = {
        left: String(Q.left_party_name || "Lewica"),
        ko: "Koalicja Obywatelska",
        psl: "Polskie Stronnictwo Ludowe",
        p2050: "Polska 2050",
        pis: "Prawo i Sprawiedliwość",
        konf: "Konfederacja Wolność i Niepodległość",
        independent: "No party affiliation"
    };
    const pmFamilyClasses = {
        left: "party-lewica", ko: "party-ko", psl: "party-psl",
        p2050: "party-p2050", pis: "party-pis", konf: "party-konf",
        independent: "party-independent"
    };
    Q.pm_party_name = pmFamilyNames[pmFamily];
    Q.pm_party_class = pmFamilyClasses[pmFamily];
    // The two facts, kept separate and both printable.
    Q.pm_is_left = pmFamily == "left" ? 1 : 0;
    Q.pm_leads_own_party_government =
        (pmFamily == "left" && String(Q.government_party || "") == "lewica") ||
        pmFamily == String(Q.government_party || "") ? 1 : 0;

    const zpCommittee = rivalGroup("zp_committee");
    const zpMembers = Q.rival_group_records.filter(function(record) {
        return record.active && record.id != "zp_committee" &&
            record.kind == "party" && record.list_committee == "pis";
    });
    zpCommittee.active = zpMembers.length > 1 ? 1 : 0;
    zpCommittee.leader = String(Q.pis_leader || "Jarosław Kaczyński");
    zpCommittee.mp_count = Math.max(0, Math.round(Number(Q.pis_seats) || 0));
    zpCommittee.sejm_mps = zpCommittee.mp_count;
    Q.zp_committee_name = zpCommittee.active
        ? zpCommittee.name
        : "Prawo i Sprawiedliwość";

    // Konfederacja is a federation of surviving parties on one committee, in
    // the same shape as the PiS and Koalicja Polska families. The libertarian
    // component has changed its name three times without ever ceasing to be
    // the same organisation, so the name is derived rather than stored.
    const nowaNadziejaRecord = rivalGroup("nowa_nadzieja");
    const konfCommittee = rivalGroup("konf_committee");
    const konfYear = Number(Q.year) || 2019;
    const konfMonth = Number(Q.month) || 10;
    if (Q.konf_succession_2022_done) {
        nowaNadziejaRecord.name = Q.konf_korwin_countercoup_2022
            ? "KORWiN"
            : "Nowa Nadzieja";
    } else if (konfYear > 2021 || (konfYear == 2021 && konfMonth >= 12)) {
        nowaNadziejaRecord.name = "KORWiN";
    } else {
        nowaNadziejaRecord.name = "Wolność";
    }
    nowaNadziejaRecord.leader =
        String(Q.konf_libertarian_leader || "Janusz Korwin-Mikke");
    const kkpRecord = rivalGroup("kkp");
    if (Q.far_right_split) {
        // Braun's organisation leaves the committee and the club without
        // ceasing to exist, exactly as Porozumienie and Kukiz'15 can.
        kkpRecord.name = "Korona";
        kkpRecord.list_committee = "korona";
        kkpRecord.club = "korona";
        kkpRecord.allied = 0;
        kkpRecord.legal_status = "independent party after the split";
        kkpRecord.exclusive_seats = Math.max(
            0,
            Math.round(Number(Q.korona_seats) || 0)
        );
    }
    const konfMembers = Q.rival_group_records.filter(function(record) {
        return record.active && record.id != "konf_committee" &&
            record.list_committee == "konf";
    });
    konfCommittee.active = konfMembers.length > 1 ? 1 : 0;
    konfCommittee.leader = String(Q.konf_leader || "collective presidium");
    konfCommittee.mp_count = konfMembers.reduce(function(total, record) {
        return total + Math.max(0, Number(record.mp_count) || 0);
    }, 0);
    konfCommittee.sejm_mps = konfCommittee.mp_count;
    Q.konf_committee_name = konfCommittee.active
        ? konfCommittee.name
        : "No shared committee";
    Q.konf_libertarian_party_name = nowaNadziejaRecord.name;

    const kpPartnersRecord = rivalGroup("kp_partners");
    if (kpPartnersRecord.name == "Koalicja Polska partners") {
        kpPartnersRecord.name = "Unia Europejskich Demokratów (UED)";
    }
    const kpCommittee = rivalGroup("kp_committee");
    const p2050Party = rivalGroup("p2050_party");
    // An alliance whose two components end up on opposite sides of a cabinet
    // is not an alliance. Recording the split here keeps the polling committee,
    // the seat table and the party panel from disagreeing about who exists:
    // without it PSL renders as an independent party while Poland 2050's vote
    // is still folded into a Trzecia Droga committee nothing draws.
    if (
        (!!Q.third_way_active || !!Q.third_way_2023_done) &&
        !Q.third_way_split &&
        !!Q.p2050_emerged &&
        Boolean(Q.ministry_p2050_in_cabinet) !=
            Boolean(Q.ministry_psl_in_cabinet)
    ) {
        Q.third_way_split = 1;
        Q.third_way_active = 0;
        Q.third_way_future = "Split by a cabinet only one of them joined";
    }
    const thirdWayFormed =
        (!!Q.third_way_active || !!Q.third_way_2023_done) && !Q.third_way_split;
    p2050Party.active = Q.p2050_emerged && !Q.p2050_joined_left ? 1 : 0;
    if (p2050Party.active) {
        p2050Party.leader = String(Q.p2050_leader || "Szymon Hołownia");
        p2050Party.legal_status = thirdWayFormed
            ? "allied party inside Trzecia Droga"
            : "independent party";
    }
    const kpCommitteeId = thirdWayFormed ? "third_way" : "psl";
    for (const member of Q.rival_group_records) {
        if (["psl_party", "kp_partners"].includes(member.id) && member.active) {
            member.list_committee = kpCommitteeId;
            member.parent = thirdWayFormed ? "Trzecia Droga" : "Koalicja Polska";
        }
    }
    if (p2050Party.active && thirdWayFormed) {
        p2050Party.list_committee = "third_way";
        p2050Party.club = "third_way";
        p2050Party.parent = "Trzecia Droga";
    } else if (p2050Party.active) {
        p2050Party.list_committee = "p2050";
        p2050Party.club = "p2050";
        p2050Party.parent = "Polska 2050";
    }
    if (Q.p2050_greens_absorbed) {
        const greensRecord = rivalGroup("greens");
        greensRecord.active = 0;
        greensRecord.allied = 0;
        greensRecord.bloc = "p2050";
        greensRecord.kind = "former party";
        greensRecord.parent = "Polska 2050";
        greensRecord.legal_status = "dissolved into Polska 2050";
        greensRecord.list_committee = "p2050";
        greensRecord.club = "p2050";
        greensRecord.in_cabinet = 0;
        greensRecord.independent = 0;
        greensRecord.mp_count = 0;
        greensRecord.sejm_mps = 0;
        greensRecord.exclusive_seats = 0;
        Q.left_realign_invite_greens = 0;
        Q.left_realign_greens_accepted = 0;
        Q.greens_joined_left = 0;
        Q.left_green_current_seats = 0;
        p2050Party.mp_count = Math.max(
            0,
            Math.round(Number(Q.p2050_seats) || 0)
        );
        p2050Party.sejm_mps = p2050Party.mp_count;
    }
    const kpMembers = Q.rival_group_records.filter(function(record) {
        return record.active && record.id != "kp_committee" &&
            record.list_committee == kpCommitteeId;
    });
    kpCommittee.list_committee = kpCommitteeId;
    kpCommittee.club = thirdWayFormed ? "third_way" : "kp";
    kpCommittee.name = thirdWayFormed ? "Trzecia Droga" : "Koalicja Polska";
    kpCommittee.parent = kpCommittee.name;
    kpCommittee.legal_status = "electoral alliance";
    // A committee with one component is not a committee.
    kpCommittee.active = kpMembers.length > 1 ? 1 : 0;
    kpCommittee.mp_count = kpMembers.reduce(function(total, record) {
        return total + Math.max(0, Number(record.mp_count) || 0);
    }, 0);
    kpCommittee.sejm_mps = kpCommittee.mp_count;
    // Koalicja Polska is green; its successor keeps the Third Way colour.
    Q.kp_committee_class = thirdWayFormed ? "party-third-way" : "party-psl";
    Q.kp_committee_name = kpCommittee.active
        ? kpCommittee.name
        : "No shared committee";
    Q.third_way_committee_active =
        kpCommittee.active && thirdWayFormed ? 1 : 0;

    // Duda's congress becomes possible only when several genuinely distinct
    // right-wing ballot lines exist. This is derived state: the congress event
    // owns the seeded roll and every membership decision.
    const prawicaEligibleCommittees = [];
    const prawicaIndependentPolls = [];
    Q.prawica_pis_government_block =
        Q.government_party == "pis" || Q.ministry_pis_in_cabinet ? 1 : 0;
    const addPrawicaFragment = function(eligible, committee, poll) {
        if (!eligible) return;
        prawicaEligibleCommittees.push(String(committee));
        prawicaIndependentPolls.push(Math.max(0, Number(poll) || 0));
    };
    addPrawicaFragment(true, "pis", Q.pis_poll);
    const prawicaRozwoj = rivalGroup("rozwoj_plus");
    addPrawicaFragment(
        prawicaRozwoj && prawicaRozwoj.active,
        prawicaRozwoj && prawicaRozwoj.list_committee || "rozwoj",
        Q.rozwoj_poll
    );
    if (Q.mentzen_bosak_split == 1) {
        const prawicaNewHope = rivalGroup("nowa_nadzieja");
        const prawicaNational = rivalGroup("ruch_narodowy");
        addPrawicaFragment(
            prawicaNewHope && prawicaNewHope.active,
            prawicaNewHope && prawicaNewHope.list_committee || "new_hope",
            Q.new_hope_poll
        );
        addPrawicaFragment(
            prawicaNational && prawicaNational.active,
            prawicaNational && prawicaNational.list_committee || "national_movement",
            Q.national_movement_poll
        );
    } else {
        const prawicaKonf = rivalGroup("konf_committee");
        addPrawicaFragment(
            prawicaKonf && prawicaKonf.active,
            prawicaKonf && prawicaKonf.list_committee || "konf",
            Q.konf_poll
        );
    }
    const prawicaPslOutside = Q.government_party != "psl" &&
        !Q.ministry_psl_in_cabinet;
    addPrawicaFragment(
        prawicaPslOutside && rivalGroup("psl_party") &&
            rivalGroup("psl_party").active,
        rivalGroup("psl_party") && rivalGroup("psl_party").list_committee || "psl",
        Q.psl_poll
    );
    addPrawicaFragment(
        Q.tak_dla_rozwoju_legal_party_formed &&
            Q.tak_rozwoj_party_name != "Akcja Socjalistyczna",
        Q.tak_rozwoj_list_committee || "tak_rozwoj",
        Q.tak_rozwoj_poll
    );
    addPrawicaFragment(Q.p0_formed, "p0", Q.p0_poll);
    addPrawicaFragment(
        Q.kukiz_active && rivalGroup("kukiz15") && rivalGroup("kukiz15").active,
        Q.kukiz_list_committee || "kukiz",
        Q.kukiz_poll
    );
    const prawicaSolidarna = rivalGroup("solidarna");
    addPrawicaFragment(
        prawicaSolidarna && prawicaSolidarna.active && !Q.suwerenna_merged,
        prawicaSolidarna && prawicaSolidarna.list_committee || "suwerenna",
        Q.suwerenna_poll
    );
    const prawicaPorozumienie = rivalGroup("porozumienie");
    addPrawicaFragment(
        Q.porozumienie_active && prawicaPorozumienie &&
            prawicaPorozumienie.active,
        Q.porozumienie_list_committee || "porozumienie",
        Q.porozumienie_poll
    );
    const prawicaRepublikanie = rivalGroup("republikanie");
    addPrawicaFragment(
        Q.republikanie_formed && prawicaRepublikanie &&
            prawicaRepublikanie.active,
        prawicaRepublikanie && prawicaRepublikanie.list_committee || "republikanie",
        0
    );
    const prawicaOdnowa = rivalGroup("odnowa");
    addPrawicaFragment(
        Q.odnowa_formed && prawicaOdnowa && prawicaOdnowa.active,
        prawicaOdnowa && prawicaOdnowa.list_committee || "odnowa",
        0
    );
    const prawicaSikorski = rivalGroup("ko_splinter");
    addPrawicaFragment(
        Q.ko_splinter_active && prawicaSikorski && prawicaSikorski.active &&
            prawicaSikorski.independent &&
            prawicaSikorski.leader == "Radosław Sikorski",
        prawicaSikorski && prawicaSikorski.list_committee || "ko_splinter",
        Q.ko_splinter_poll
    );
    const prawicaDistinct = Array.from(new Set(prawicaEligibleCommittees)).length;
    const prawicaBelowThreshold = prawicaIndependentPolls.slice(1).filter(
        function(poll) { return poll < 5; }
    ).length;
    Q.prawica_fragmentation_score = Math.max(0, Math.min(100, Math.round(
        10 * Math.max(0, prawicaDistinct - 2) +
        (Q.pis_collapsed ? 18 : 0) +
        (Q.pis_split ? 12 : 0) +
        (Q.far_right_split ? 8 : 0) +
        (Q.mentzen_bosak_split ? 8 : 0) +
        (Q.third_way_split ? 6 : 0) +
        Math.min(18, Math.max(0,
            Math.round((Number(Q.pis_collapse_pressure) || 0) * 0.18))) +
        4 * prawicaBelowThreshold
    )));
    const prawicaJowActive = Q.electoral_reform_stage == "enacted" &&
        ["mixed_230", "fptp_460"].includes(Q.sejm_electoral_system);
    Q.prawica_attempt_threshold = prawicaJowActive
        ? 950
        : (Q.prawica_fragmentation_score < 55
            ? 0
            : 400 + Math.min(200,
                (Q.prawica_fragmentation_score - 55) * 10));
    if (String(Q.third_way_alternative_outcome || "").startsWith("Common-centre")) {
        const centreIds = [
            "ko_party", "psl_party", "p2050_party", "unia_centrum",
            "ko_splinter"
        ];
        const liveCentre = centreIds.map(rivalGroup).filter(function(record) {
            return record && record.active &&
                !Q.prawica_member_ids.includes(record.id);
        });
        const totalSeats = liveCentre.reduce(function(total, record) {
            return total + Math.max(1, Number(record.exclusive_seats) ||
                Number(record.mp_count) || 0);
        }, 0);
        for (const record of liveCentre) {
            record.list_committee = "common_centre_2027";
            record.contesting = 1;
            if (!record.negotiated_list_share) {
                record.negotiated_list_share = Math.round(
                    Math.max(1, Number(record.exclusive_seats) ||
                        Number(record.mp_count) || 0) * 100 /
                    Math.max(1, totalSeats)
                );
            }
        }
    }
    if (String(Q.third_way_alternative_outcome || "").startsWith("Permanent Third Way")) {
        for (const id of ["psl_party", "p2050_party"]) {
            const record = rivalGroup(id);
            if (!record || !record.active ||
                Q.prawica_member_ids.includes(record.id)) continue;
            record.list_committee = "third_way_2027";
            record.contesting = 1;
            record.negotiated_list_share = id == "psl_party" ? 55 : 45;
        }
    }

    // Prawica is applied last. Member parties remain legal organisations, but
    // no later ZP, Third Way or common-centre repair may reclaim their list or
    // parliamentary-club affiliation.
    if (Q.prawica_formed) {
        const prawicaCommittee = rivalGroup("prawica_committee");
        if (prawicaCommittee) {
            prawicaCommittee.active = 1;
            prawicaCommittee.contesting = 1;
            prawicaCommittee.name = "Prawica";
            prawicaCommittee.leader = "Andrzej Duda";
            prawicaCommittee.parent = "Prawica";
            prawicaCommittee.legal_status = "electoral coalition and parliamentary club";
            prawicaCommittee.list_committee = "right_2027";
            prawicaCommittee.club = "prawica";
            prawicaCommittee.mp_count = Q.prawica_member_ids.reduce(
                function(total, id) {
                    const member = rivalGroup(id);
                    return total + Math.max(0, Number(member &&
                        member.exclusive_seats) || 0);
                }, 0
            );
            prawicaCommittee.sejm_mps = prawicaCommittee.mp_count;
        }
        const replacedZp = rivalGroup("zp_committee");
        if (replacedZp) {
            replacedZp.active = 0;
            replacedZp.contesting = 0;
            replacedZp.legal_status = "replaced by Prawica";
        }
        for (const id of Q.prawica_member_ids) {
            const record = rivalGroup(id);
            if (!record || id == "kkp") continue;
            record.list_committee = "right_2027";
            record.club = "prawica";
            record.parent = "Prawica";
            record.contesting = 1;
            record.in_cabinet = 0;
            record.support_mode = "opposition";
            record.prawica_member = 1;
            record.legal_status = "founding organisation of Prawica";
        }
        if (Q.prawica_member_source_ids.includes("psl")) {
            Q.third_way_active = 0;
            Q.third_way_split = 1;
            Q.psl_support_mode = "opposition";
            kpCommittee.active = 0;
        }
        if (Q.prawica_member_source_ids.includes("kukiz")) {
            Q.kukiz_left_kp = 1;
            Q.kukiz_list_committee = "right_2027";
        }
        if (Q.prawica_member_source_ids.includes("tak_rozwoj")) {
            Q.tak_rozwoj_list_committee = "right_2027";
        }
        if (Q.prawica_member_source_ids.includes("porozumienie")) {
            Q.porozumienie_list_committee = "right_2027";
        }
        if (Q.prawica_member_source_ids.includes("suwerenna")) {
            Q.suwerenna_own_list = 0;
        }
        const prawicaDuda = rivalGroup("duda_movement");
        if (prawicaDuda) {
            prawicaDuda.active = 1;
            prawicaDuda.contesting = 1;
            prawicaDuda.list_committee = "right_2027";
            prawicaDuda.club = "prawica";
            prawicaDuda.parent = "Prawica";
            prawicaDuda.prawica_member = 1;
            prawicaDuda.legal_status = "founding vehicle of Prawica";
        }
    }

    // Read-only affiliation roll-ups. Events own the seat totals themselves —
    // this only reports who is currently attached to which committee, club and
    // cabinet, so a scene never has to re-derive it and the path checks have
    // one place to test the arithmetic against.
    const affiliationRoll = function(field, value) {
        return Q.rival_group_records.filter(function(record) {
            return record.active && record[field] == value;
        });
    };
    const affiliationNames = function(records) {
        return records.length
            ? records.map(function(record) { return record.name; }).join(", ")
            : "None";
    };
    const affiliationSeats = function(records) {
        return records.reduce(function(total, record) {
            return total + Math.max(0, Number(record.exclusive_seats) || 0);
        }, 0);
    };
    const konfListRecords = affiliationRoll("list_committee", "konf").filter(
        function(record) { return record.id != "konf_committee"; }
    );
    Q.konf_list_members = affiliationNames(konfListRecords);
    const pisListRecords = affiliationRoll("list_committee", "pis").filter(
        function(record) { return record.kind == "party"; }
    );
    // The PSL committee is Koalicja Polska, or Trzecia Droga once the centrist
    // bloc has formed on top of it. It is the same record either way.
    const kpListRecords = affiliationRoll("list_committee", kpCommitteeId)
        .filter(function(record) { return record.id != "kp_committee"; });
    Q.pis_list_members = affiliationNames(pisListRecords);
    Q.kp_list_members = affiliationNames(kpListRecords);
    Q.pis_list_attached_seats = affiliationSeats(pisListRecords);
    Q.kp_list_attached_seats = affiliationSeats(kpListRecords);
    Q.government_toleration_seats = affiliationSeats(
        affiliationRoll("support_mode", "toleration")
    );
    // Named separately from coalition_cabinet_parties, which is owned by the
    // Lewica-era cabinet ledger further down this scene.
    Q.allied_cabinet_parties = affiliationNames(
        affiliationRoll("in_cabinet", 1).filter(function(record) {
            return record.kind == "party";
        })
    );
    Q.kp_coalition_active = kpListRecords.length > 1 ? 1 : 0;
    // Anything outside the four rival electoral families still exists and
    // still has to be visible somewhere, including the player's breakaways.
    const sharedCommittees = [
        "pis", "psl", "ko", "konf", "third_way", "right_2027"
    ];
    const isolatedRecords = Q.rival_group_records.filter(function(record) {
        return record.active && record.kind == "party" &&
            !String(record.id).endsWith("_committee") &&
            !sharedCommittees.includes(String(record.list_committee));
    });
    const independentQualityParties = [
        [Q.barons_party_formed, Q.barons_party_name || "SLD breakaway",
            Q.sld_breakaway_seats, "barons_party"],
        [Q.social_patriot_party_formed,
            Q.social_patriot_party_name || "Social-Patriot party",
            Q.social_patriot_seats, "social_patriot_party"],
        [Q.spring_party_formed, Q.spring_party_name || "Wiosna",
            Q.spring_breakaway_seats, "spring_party"],
        [Q.labor_party_formed,
            Q.labor_party_name || "Independent Labour Left",
            Q.labor_left_seats, "labor_party"],
        [Q.progressives_party_formed,
            Q.progressives_party_name || "Young Left",
            Q.young_left_seats, "progressives_party"],
        [Q.razem_party_formed, Q.razem_party_name || "Razem",
            Q.razem_party_seats, "razem_party"],
        [Q.pps_party_formed, Q.pps_party_name || "PPS",
            Q.pps_party_seats, "pps_party"],
        [Q.unia_centrum_formed, "Unia Centrum", Q.centrum_seats,
            "unia_centrum"],
        [Number(Q.other_seats) > 0,
            Number(Q.year) <= 2023
                ? "German Minority"
                : "Other independent lists",
            Q.other_seats, "other_independent"]
    ].filter(function(entry) {
        return entry[0] && Math.max(0, Number(entry[2]) || 0) > 0;
    }).map(function(entry) {
        return {
            id: entry[3],
            name: entry[1],
            exclusive_seats: Math.max(0, Math.round(Number(entry[2]) || 0)),
            senators: 0
        };
    });
    const isolatedParties = isolatedRecords.map(function(record) {
        return {
            id: record.id,
            name: record.name,
            exclusive_seats: record.id == "p2050_party"
                ? Math.max(0, Math.round(Number(Q.p2050_seats) || 0))
                : Math.max(0, Math.round(Number(record.exclusive_seats) || 0)),
            senators: Math.max(0, Math.round(Number(record.senators) || 0))
        };
    });
    const independentParties = isolatedParties.concat(
        independentQualityParties
    );
    Q.independent_bucket_members = affiliationNames(independentParties);
    Q.independent_bucket_count = independentParties.length;
    Q.independent_bucket_seats = affiliationSeats(independentParties);
    Q.independent_bucket_senators = Math.max(
        0,
        Math.round(Number(Q.senate_independent_seats) || 0)
    );

    // One parliamentary roster reconciles electoral-family totals with the
    // parties that actually compose them. Events continue to own the family
    // totals; this read-only allocation is the shared source for every member
    // display and always adds back to those totals.
    const parliamentaryParties = [];
    const parliamentaryFamilies = [];
    const apportion = function(totalValue, entries, weightField) {
        const total = Math.max(0, Math.round(Number(totalValue) || 0));
        const result = new Map(entries.map(function(entry) {
            return [entry.id, 0];
        }));
        if (!entries.length || !total) return result;
        let weights = entries.map(function(entry) {
            return Math.max(0, Number(entry[weightField]) || 0);
        });
        if (!weights.some(function(weight) { return weight > 0; })) {
            weights[0] = 1;
        }
        const weightTotal = weights.reduce(function(sum, weight) {
            return sum + weight;
        }, 0);
        const ranked = entries.map(function(entry, index) {
            const exact = total * weights[index] / weightTotal;
            const seats = Math.floor(exact);
            result.set(entry.id, seats);
            return { id: entry.id, remainder: exact - seats, index: index };
        }).sort(function(left, right) {
            return right.remainder - left.remainder || left.index - right.index;
        });
        let assigned = Array.from(result.values()).reduce(function(sum, seats) {
            return sum + seats;
        }, 0);
        for (let index = 0; assigned < total; index += 1, assigned += 1) {
            const id = ranked[index % ranked.length].id;
            result.set(id, result.get(id) + 1);
        }
        return result;
    };
    const addFamily = function(id, name, sejmTotal, senateTotal, entries) {
        const sejm = apportion(sejmTotal, entries, "sejm_weight");
        const senate = apportion(senateTotal, entries, "senate_weight");
        for (const entry of entries) {
            const party = {
                id: entry.id,
                name: entry.name,
                family: id,
                list_committee: entry.list_committee,
                sejm_mps: sejm.get(entry.id) || 0,
                senators: senate.get(entry.id) || 0
            };
            parliamentaryParties.push(party);
            if (entry.record) {
                entry.record.sejm_mps = party.sejm_mps;
                entry.record.senators = party.senators;
            }
        }
        parliamentaryFamilies.push({
            id: id,
            name: name,
            sejm_seats: Array.from(sejm.values()).reduce(function(sum, seats) {
                return sum + seats;
            }, 0),
            senate_seats: Array.from(senate.values()).reduce(
                function(sum, seats) { return sum + seats; }, 0
            )
        });
    };
    const externalPartyEntries = function(listCommittee, order, weights) {
        return Q.rival_group_records.filter(function(record) {
            return record.active && record.kind == "party" &&
                record.list_committee == listCommittee &&
                !String(record.id).endsWith("_committee");
        }).sort(function(left, right) {
            return (order[left.id] || 99) - (order[right.id] || 99);
        }).map(function(record) {
            return {
                id: record.id,
                name: record.name,
                record: record,
                list_committee: listCommittee,
                sejm_weight: weights[record.id] !== undefined
                    ? weights[record.id]
                    : Math.max(0, Number(record.mp_count) || 0),
                senate_weight: 0
            };
        });
    };

    const zpEntries = externalPartyEntries(
        "pis",
        { pis_party: 1, porozumienie: 2, solidarna: 3 },
        {}
    );
    const zpLead = zpEntries.find(function(entry) {
        return entry.id == "pis_party";
    });
    if (zpLead) {
        const juniorSejm = zpEntries.reduce(function(total, entry) {
            return total + (entry.id == "pis_party" ? 0 : entry.sejm_weight);
        }, 0);
        zpLead.sejm_weight = Math.max(
            0,
            (Number(Q.pis_seats) || 0) - juniorSejm
        );
    }
    for (const entry of zpEntries) {
        entry.senate_weight = ["porozumienie", "solidarna"].includes(entry.id)
            ? 2
            : 0;
    }
    if (zpLead) {
        const juniorSenate = zpEntries.reduce(function(total, entry) {
            return total + (entry.id == "pis_party" ? 0 : entry.senate_weight);
        }, 0);
        zpLead.senate_weight = Math.max(
            0,
            (Number(Q.senate_pis_seats) || 0) - juniorSenate
        );
    }
    addFamily(
        "zp", Q.zp_committee_name,
        Q.pis_seats, Q.senate_pis_seats, zpEntries
    );

    const koEntries = externalPartyEntries(
        "ko",
        { ko_party: 1, po: 1, nowoczesna: 2, ipl: 3, greens: 4 },
        {}
    );
    if (!Q.ko_consolidated) {
        koEntries.push({
            id: "ko_independent_parliamentarians",
            name: "KO-affiliated independent parliamentarians",
            list_committee: "ko",
            sejm_weight: 13,
            senate_weight: 0
        });
    }
    const koHost = koEntries.find(function(entry) {
        return ["ko_party", "po"].includes(entry.id);
    });
    if (koHost) {
        const koJuniorSejm = koEntries.reduce(function(total, entry) {
            return total + (entry.id == koHost.id ? 0 : entry.sejm_weight);
        }, 0);
        koHost.sejm_weight = Math.max(
            0,
            (Number(Q.ko_seats) || 0) - koJuniorSejm
        );
    }
    for (const entry of koEntries) {
        entry.senate_weight = ["ko_party", "po"].includes(entry.id) ? 1 : 0;
    }
    addFamily(
        "ko", "Koalicja Obywatelska",
        Q.ko_seats, Q.senate_ko_seats, koEntries
    );

    const kpListCommittee = thirdWayFormed ? "third_way" : "psl";
    const kpEntries = externalPartyEntries(
        kpListCommittee,
        { psl_party: 1, p2050_party: 2, kukiz15: 3, kp_partners: 4 },
        {}
    );
    if (!thirdWayFormed) {
        kpEntries.push({
            id: "kp_independent_parliamentarians",
            name: "KP-affiliated independent parliamentarians",
            list_committee: "psl",
            sejm_weight: 3,
            senate_weight: 0
        });
    }
    for (const entry of kpEntries) {
        if (entry.id == "kp_partners") entry.senate_weight = 1;
    }
    const kpJuniorSeats = kpEntries.reduce(function(total, entry) {
        if (["psl_party", "p2050_party"].includes(entry.id)) return total;
        return total + Math.max(0, Number(entry.sejm_weight) || 0);
    }, 0);
    const kpJuniorSenators = kpEntries.reduce(function(total, entry) {
        if (["psl_party", "p2050_party"].includes(entry.id)) return total;
        return total + Math.max(0, Number(entry.senate_weight) || 0);
    }, 0);
    for (const entry of kpEntries) {
        if (entry.id == "psl_party") {
            entry.sejm_weight = Math.max(
                1,
                (Number(Q.psl_seats) || 0) - kpJuniorSeats
            );
            entry.senate_weight = Math.max(
                0,
                (Number(Q.senate_psl_seats) || 0) - kpJuniorSenators
            );
        } else if (entry.id == "p2050_party") {
            entry.sejm_weight = Math.max(0, Number(Q.p2050_seats) || 0);
            entry.senate_weight = Math.max(
                0,
                Number(Q.senate_p2050_seats) || 0
            );
        }
    }
    addFamily(
        "kp", Q.kp_committee_name,
        (Number(Q.psl_seats) || 0) +
            (thirdWayFormed ? Number(Q.p2050_seats) || 0 : 0),
        (Number(Q.senate_psl_seats) || 0) +
            (thirdWayFormed ? Number(Q.senate_p2050_seats) || 0 : 0),
        kpEntries
    );

    const konfEntries = externalPartyEntries(
        "konf",
        { nowa_nadzieja: 1, ruch_narodowy: 2, kkp: 3 },
        {}
    );
    for (const entry of konfEntries) entry.senate_weight = entry.sejm_weight;
    addFamily(
        "konf", Q.konf_committee_name,
        Q.konf_seats, Q.senate_konf_seats, konfEntries
    );

    addFamily("left", String(Q.left_party_name || "Lewica"),
        Q.left_seats, Q.senate_left_seats, [{
            id: "left_party",
            name: String(Q.left_party_name || "Lewica"),
            list_committee: "left",
            sejm_weight: 1,
            senate_weight: 1
        }]);

    for (const party of independentParties) {
        parliamentaryParties.push({
            id: party.id,
            name: party.name,
            family: "independent",
            list_committee: party.id,
            sejm_mps: Math.max(0, Number(party.exclusive_seats) || 0),
            senators: Math.max(0, Number(party.senators) || 0)
        });
    }
    const assignedIndependentSenators = independentParties.reduce(
        function(total, party) {
            return total + Math.max(0, Number(party.senators) || 0);
        },
        0
    );
    const unaffiliatedSenators = Math.max(
        0,
        Q.independent_bucket_senators - assignedIndependentSenators
    );
    if (unaffiliatedSenators) {
        parliamentaryParties.push({
            id: "independent_parliamentarians",
            name: "Unaffiliated parliamentarians",
            family: "independent",
            list_committee: "independent",
            sejm_mps: 0,
            senators: unaffiliatedSenators
        });
    }
    parliamentaryFamilies.push({
        id: "independent",
        name: "Independent parties",
        sejm_seats: Q.independent_bucket_seats,
        senate_seats: Q.independent_bucket_senators
    });
    Q.parliamentary_party_records = parliamentaryParties;
    Q.parliamentary_family_records = parliamentaryFamilies;
    const resultMemberIds = [
        "pis_party", "porozumienie", "solidarna", "republikanie", "odnowa",
        "po", "nowoczesna", "ipl", "greens", "ko_party",
        "ko_independent_parliamentarians", "psl_party", "p2050_party",
        "kukiz15", "kp_partners", "kp_independent_parliamentarians",
        "nowa_nadzieja", "ruch_narodowy", "kkp"
    ];
    for (const id of resultMemberIds) {
        const party = parliamentaryParties.find(function(record) {
            return record.id == id;
        }) || {};
        Q["result_member_" + id + "_name"] = String(party.name || id);
        Q["result_member_" + id + "_sejm"] = Math.max(
            0, Math.round(Number(party.sejm_mps) || 0)
        );
        Q["result_member_" + id + "_senate"] = Math.max(
            0, Math.round(Number(party.senators) || 0)
        );
    }
    Q.porozumienie_relation = porozumienieRecord.relation;
    Q.kukiz_relation = rivalGroup("kukiz15").relation;

    // KO's structural health is one derived number rather than four hidden
    // convention meters. Every term is a failure the player can already see:
    // what the coalition has cost KO, where its polling is, a succession
    // nobody could force, a lost presidency, and discrete shocks recorded by
    // KO's own events (ko_collapse_shock, which decays monthly in advance).
    Q.ko_cohesion = clamp(Math.round(Number(Q.ko_cohesion) || 62), 0, 100);
    const koCollapsePressure =
        Math.max(0, Number(Q.ko_collapse_shock) || 0) +
        Math.max(0, (Number(Q.ko_coalition_dissent) || 0) - 18) * 0.9 +
        Math.max(0, 24 - (Number(Q.ko_poll) || 24)) * 2.4 +
        Math.max(0, 60 - Q.ko_cohesion) * 0.5 +
        (Q.ko_leader == "Donald Tusk" && Number(Q.year) >= 2026 ? 8 : 0) +
        (Q.pres_2025_winner_key == "right" ? 6 : 0) +
        (Q.caretaker_government ? 8 : 0) +
        (Q.snap_election_requested ? 6 : 0) -
        (Q.ko_consolidated ? 16 : 0) -
        (Q.government_party == "ko" && Q.government_has_confidence ? 8 : 0);
    Q.ko_collapse_pressure = Q.ko_collapsed
        ? 0
        : clamp(Math.round(koCollapsePressure), 0, 100);
    Q.ko_condition_label = Q.ko_collapsed
        ? "split into rival organisations"
        : Q.ko_collapse_pressure >= 68
            ? "at breaking point"
            : Q.ko_collapse_pressure >= 48
                ? "openly quarrelling"
                : Q.ko_collapse_pressure >= 28
                    ? "strained but holding"
                    : "in working order";
    // PiS's structural health, on the same principle as KO's: one derived
    // number, every term a failure the player can already see. A party held
    // together by one man's authority does not break because a die was rolled,
    // it breaks when the succession is overdue, the mandates have started
    // leaving individually, the presidency is gone and Konfederacja is
    // outbidding it for the same voters.
    const pisCollapsePressure =
        Math.max(0, 55 - (Number(Q.united_right_cohesion) || 72)) * 1.1 +
        Math.max(0, 30 - (Number(Q.pis_poll) || 30)) * 2.2 +
        Math.max(0, Number(Q.rozwoj_definitive_departures) || 0) * 1.2 +
        (Q.pis_split ? 14 : 0) +
        (Q.suwerenna_walkout ? 8 : 0) +
        ((Number(Q.konf_poll) || 0) >= (Number(Q.pis_poll) || 0) ? 12 : 0) +
        (Q.pis_leader == "Jarosław Kaczyński" && Number(Q.year) >= 2026
            ? 10
            : 0) +
        (Q.pres_2025_winner_key != "" && Q.pres_2025_winner_key != "right"
            ? 8
            : 0) -
        (Q.government_party == "pis" && Q.government_has_confidence ? 18 : 0) -
        (Q.rozwoj_internal_pis ? 12 : 0);
    Q.pis_collapse_pressure = Q.pis_collapsed
        ? 0
        : clamp(Math.round(pisCollapsePressure), 0, 100);
    Q.pis_condition_label = Q.pis_collapsed
        ? "broken into rival right-wing parties"
        : Q.pis_collapse_pressure >= 68
            ? "at breaking point"
            : Q.pis_collapse_pressure >= 48
                ? "openly contesting the succession"
                : Q.pis_collapse_pressure >= 28
                    ? "strained but holding"
                    : "in working order";
    if (Q.greens_joined_left) {
        const greensRecord = rivalGroup("greens");
        if (greensRecord) {
            greensRecord.bloc = "left";
            greensRecord.kind = "current";
            greensRecord.parent = Q.left_realign_name || "Wspólna Polska";
            greensRecord.legal_status = "internal green current";
            greensRecord.exclusive_seats = 0;
        }
    }
    if (Q.ipl_joined_left) {
        const iplRecord = rivalGroup("ipl");
        if (iplRecord) {
            iplRecord.bloc = "left";
            iplRecord.kind = "current";
            iplRecord.parent = Q.left_party_name || "Lewica";
            iplRecord.legal_status = "internal progressive current";
            iplRecord.exclusive_seats = 0;
        }
    }
    if (Q.trzaskowski_joined_left) {
        Q.trzaskowski_affiliation =
            (Q.trzaskowski_current_name || "Civic-progressive current") +
            " in " + (Q.left_party_name || "Lewica");
    }

    if (!["proportional", "mixed_230", "fptp_460"].includes(
        String(Q.sejm_electoral_system || "")
    )) {
        Q.sejm_electoral_system = "proportional";
    }
    if (!["none", "kukiz_pact", "ko_compromise", "referendum_won",
        "enacted", "failed"].includes(String(Q.electoral_reform_stage || ""))) {
        Q.electoral_reform_stage = "none";
    }
    if (!["none", "mixed_230", "fptp_460"].includes(
        String(Q.electoral_reform_proposal || "")
    )) {
        Q.electoral_reform_proposal = "none";
    }
    if (Q.electoral_reform_stage != "enacted") {
        Q.sejm_electoral_system = "proportional";
    }
    for (const quality of [
        "electoral_reform_ko_support", "electoral_reform_boundary_safeguards",
        "electoral_reform_opposition_pact_channel",
        "electoral_reform_ko_talks_done", "electoral_reform_referendum_done",
        "electoral_reform_referendum_turnout", "electoral_reform_referendum_yes",
        "electoral_reform_constitution_done", "electoral_reform_sejm_yes",
        "electoral_reform_senate_yes",
        "electoral_reform_constitution_passed",
        "electoral_reform_president_signed", "electoral_reform_code_enacted"
    ]) {
        if (!Number.isFinite(Number(Q[quality]))) Q[quality] = 0;
    }
    if (typeof Q.electoral_reform_result != "string") {
        Q.electoral_reform_result = "No Sejm electoral reform proposed";
    }
    Q.sejm_electoral_system_label = Q.sejm_electoral_system == "mixed_230"
        ? "230 list MPs plus 230 single-member districts"
        : (Q.sejm_electoral_system == "fptp_460"
            ? "460 single-member plurality districts"
            : "460 proportional-list MPs");
    Q.sejm_electoral_system_summary = Q.sejm_electoral_system == "mixed_230"
        ? "230 list · 138 urban JOW · 92 rural JOW"
        : (Q.sejm_electoral_system == "fptp_460"
            ? "276 urban JOW · 184 rural JOW"
            : "460 proportional seats");
    const electoralSeatParties = [
        "pis", "ko", "p2050", "psl", "left", "konf", "p0", "other",
        "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left",
        "young_left", "razem", "pps", "tak_rozwoj", "centrum", "rozwoj",
        "korona", "ko_splinter", "suwerenna", "porozumienie", "republikanie",
        "odnowa", "kukiz", "new_hope", "national_movement", "duda",
        "social_conservative"
    ];
    for (const id of electoralSeatParties) {
        for (const suffix of [
            "list_seats", "urban_seats", "rural_seats",
            "projected_list_seats", "projected_urban_seats",
            "projected_rural_seats"
        ]) {
            const quality = id + "_" + suffix;
            if (!Number.isFinite(Number(Q[quality]))) Q[quality] = 0;
        }
    }
    const sejmListTextDefaults = {
        sejm_list_target: "Left host list",
        sejm_list_outcome: "left_5",
        sejm_list_structure: "Host-party list",
        sejm_list_host: "left",
        sejm_list_members: "Lewica and its internal partners",
        sejm_list_control: "Lewica controls nominations and subsidy",
        sejm_list_terms: "No cross-party bargain",
        sejm_list_acceptances: "No external talks held",
        sejm_list_result: "The Left plans its own 5% party list"
    };
    for (const quality of Object.keys(sejmListTextDefaults)) {
        if (typeof Q[quality] != "string" || !Q[quality].length) {
            Q[quality] = sejmListTextDefaults[quality];
        }
    }
    Q.sejm_list_negotiation_done = Q.sejm_list_negotiation_done ? 1 : 0;
    Q.sejm_list_has_partners = Q.sejm_list_has_partners ? 1 : 0;
    Q.sejm_list_threshold = Number(Q.sejm_list_threshold) == 8 ? 8 : 5;
    Q.sejm_list_partner_score = clamp(
        Number(Q.sejm_list_partner_score) || 0,
        0,
        100
    );
    Q.sejm_list_internal_score = clamp(
        Number(Q.sejm_list_internal_score) || 0,
        0,
        100
    );
    const leftListCommitteeDefaults = {
        spring: "spring_breakaway",
        labor: "labor_left",
        progressives: "young_left",
        razem: "razem",
        pps: "pps",
        social_patriot: "social_patriot"
    };
    for (const caucus of Object.keys(leftListCommitteeDefaults)) {
        const quality = caucus + "_list_committee";
        if (typeof Q[quality] != "string" || !Q[quality].length) {
            Q[quality] = leftListCommitteeDefaults[caucus];
        }
    }
    if (typeof Q.social_patriot_electoral_strategy != "string") {
        Q.social_patriot_electoral_strategy = "Independent party list";
    }

    for (const quality of [
        "social_patriot_support", "market_liberal_support",
        "social_patriot_strength", "market_liberal_strength",
        "social_patriot_dissent", "market_liberal_dissent"
    ]) {
        Q[quality] = clamp(Number(Q[quality]) || 0, 0, 100);
    }
    Q.social_patriot_active = Q.social_patriot_active ? 1 : 0;
    Q.market_liberal_active = Q.market_liberal_active ? 1 : 0;
    Q.social_patriot_referrals = Math.max(
        0,
        Math.round(Number(Q.social_patriot_referrals) || 0)
    );
    if (
        !Q.social_patriot_active &&
        !Q.social_patriot_party_formed &&
        Q.social_patriot_support >= 18 &&
        Number(Q.left_right_score) >= 44
    ) {
        Q.social_patriot_active = 1;
        Q.social_patriot_in_left = 1;
        Q.social_patriot_emerged_time = Number(Q.time) || 0;
        Q.social_patriot_strength = clamp(
            6 + (Q.social_patriot_support - 18) * 0.45,
            6,
            18
        );
        Q.social_patriot_dissent = 18;
        Q.social_patriot_launch_pending = 1;
        const socialPatriotTransfer = Q.social_patriot_strength;
        Q.barons_strength = Math.max(
            1,
            (Number(Q.barons_strength) || 0) - socialPatriotTransfer * 0.55
        );
        Q.labor_strength = Math.max(
            1,
            (Number(Q.labor_strength) || 0) - socialPatriotTransfer * 0.20
        );
        Q.razem_strength = Math.max(
            1,
            (Number(Q.razem_strength) || 0) - socialPatriotTransfer * 0.25
        );
        Q.news_headline =
            "A Social-Patriot organisation calls a founding congress";
    }
    if (
        !Q.market_liberal_active &&
        Q.market_liberal_support >= 18 &&
        Number(Q.left_economic_position) >= 58
    ) {
        Q.market_liberal_active = 1;
        Q.market_liberal_emerged_time = Number(Q.time) || 0;
        Q.news_headline =
            "Market liberals establish a caucus inside the Left";
    }
    if (Q.social_patriot_active) {
        Q.social_patriot_dissent +=
            (44 - Number(Q.left_right_score || 0)) * 0.04;
    }
    if (Q.market_liberal_active) {
        Q.market_liberal_strength = clamp(
            6 + (Q.market_liberal_support - 18) * 0.45,
            6,
            28
        );
        Q.market_liberal_dissent = clamp(
            28 + (58 - Number(Q.left_economic_position || 0)) * 2,
            0,
            100
        );
    }
    Q.social_patriot_name = Q.sld_populist_route_active
        ? "Sojusz Polski Społecznej tendency"
        : "Social-Patriot organisation";
    // Canonicalise legacy saves that composed this from the parent Left name.
    Q.social_patriot_party_name = Q.sld_populist_route_active
        ? "Sojusz Polski Społecznej"
        : "Lewica Patriotyczna";
    Q.market_liberal_name = "Market Left caucus";
    Q.right_turn_caucuses = [];
    if (Q.social_patriot_active) {
        Q.right_turn_caucuses.push("social_patriot");
    }
    if (Q.market_liberal_active) {
        Q.right_turn_caucuses.push("market_liberal");
    }
    Q.right_turn_caucus_label = Q.right_turn_caucuses.length
        ? Q.right_turn_caucuses.map(function(caucus) {
            return caucus == "social_patriot"
                ? Q.social_patriot_name
                : Q.market_liberal_name;
        }).join(" · ")
        : "No organised right caucus";

    // Lewica Pracy is a parliamentary and movement relationship, not another
    // member party. The old qualities remain compatibility inputs.
    if (!Number.isFinite(Number(Q.labor_strength))) Q.labor_strength = 14;
    if (!Number.isFinite(Number(Q.labor_dissent))) Q.labor_dissent = 18;
    if (!Number.isFinite(Number(Q.labor_credibility))) {
        Q.labor_credibility = 46;
    }
    if (!Number.isFinite(Number(Q.union_trust))) Q.union_trust = 44;
    if (!Number.isFinite(Number(Q.opzz_cooperation))) {
        Q.opzz_cooperation = 42;
    }
    if (!Number.isFinite(Number(Q.labor_mobilization))) {
        Q.labor_mobilization = Math.max(
            20,
            Math.min(55, Number(Q.labor_strength) * 2)
        );
    }
    // A pre-rework save may inherit the new root default even though its
    // independent list already exists, so party formation also migrates the
    // historical-breakdown flag.
    if (Q.labor_party_formed) {
        Q.labor_party_breakdown_authored = 1;
    } else if (Q.labor_party_breakdown_authored === undefined) {
        Q.labor_party_breakdown_authored = 0;
    }
    Q.labor_party_breakdown_authored =
        Q.labor_party_breakdown_authored ? 1 : 0;
    Q.general_strike_called = Q.general_strike_called ? 1 : 0;
    Q.labor_strength = clamp(Q.labor_strength, 0, 100);
    Q.labor_dissent = clamp(Q.labor_dissent, 0, 100);
    Q.labor_parliamentary_influence = Q.labor_strength;
    Q.labor_conflict = Q.labor_dissent;
    Q.union_trust = clamp(Q.union_trust, 0, 100);
    Q.opzz_cooperation = clamp(Q.opzz_cooperation, 0, 100);
    Q.labor_mobilization = clamp(Q.labor_mobilization, 0, 100);
    Q.labor_name = "Lewica Pracy parliamentary network";
    if (
        typeof Q.labor_party_name != "string" ||
        !Q.labor_party_name.trim() ||
        Q.labor_party_name == "Labour Left"
    ) {
        Q.labor_party_name = "Independent Labour Left";
    }
    if (
        Q.labor_conflict >= 75 ||
        Q.union_trust <= 20 ||
        Q.opzz_cooperation <= 20
    ) {
        Q.labor_relationship_state = "hostile";
        Q.labor_relationship_label =
            "Open conflict with OPZZ and the wider union movement";
    } else if (
        Q.union_trust >= 60 &&
        Q.opzz_cooperation >= 55 &&
        Q.labor_conflict <= 40
    ) {
        Q.labor_relationship_state = "cooperative";
        Q.labor_relationship_label =
            "Durable cooperation with OPZZ and workplace organisers";
    } else {
        Q.labor_relationship_state = "ignored";
        Q.labor_relationship_label =
            "Consulted without durable cooperation";
    }
    Q.labor_movement_leverage = Math.round(clamp(
        Q.labor_credibility * 0.24 +
            Q.union_trust * 0.24 +
            Q.opzz_cooperation * 0.18 +
            Q.labor_mobilization * 0.34 -
            Q.labor_conflict * 0.28,
        0,
        100
    ));

    const caucusDefaults = {
        barons: {
            strength: 27,
            dissent: 12,
            name: "SLD organisation",
            partyName: "Democratic Left Alliance"
        },
        spring: {
            strength: 19,
            dissent: 16,
            name: "Wiosna",
            partyName: "Spring"
        },
        labor: {
            strength: 14,
            dissent: 18,
            name: "Lewica Pracy parliamentary network",
            partyName: "Independent Labour Left"
        },
        progressives: {
            strength: 18,
            dissent: 14,
            name: "Younger progressives",
            partyName: "Young Left"
        },
        razem: {
            strength: 20,
            dissent: 28,
            name: "Razem",
            partyName: "Razem"
        },
        pps: {
            strength: 2,
            dissent: 20,
            name: "PPS",
            partyName: "PPS"
        },
        social_patriot: {
            strength: 0,
            dissent: 18,
            name: "Social-Patriot organisation",
            partyName: "Lewica Patriotyczna"
        }
    };
    const caucusEscalationDefaults = {
        barons: {
            leader: "Włodzimierz Czarzasty",
            broker: "regional SLD secretaries",
            demand: "protected nominations and a regional-organisation statute",
            mps: 13, offices: 68, local: 88, following: 44,
            ideology: 34, list: 66, cohesion: 80
        },
        spring: {
            leader: "Robert Biedroń",
            broker: "the Wiosna candidate network",
            demand: "equality-policy ownership and list parity",
            mps: 9, offices: 58, local: 48, following: 82,
            ideology: 68, list: 54, cohesion: 67
        },
        labor: {
            leader: "Agnieszka Dziemianowicz-Bąk",
            broker: "union and public-service organisers",
            demand: "an enforceable wages and public-services protocol",
            mps: 7, offices: 50, local: 66, following: 55,
            ideology: 78, list: 62, cohesion: 64
        },
        progressives: {
            leader: "the younger parliamentary current",
            broker: "feminist and local movement organisers",
            demand: "open selections and a binding rights timetable",
            mps: 9, offices: 44, local: 56, following: 66,
            ideology: 86, list: 58, cohesion: 57
        },
        razem: {
            leader: "Adrian Zandberg",
            broker: "the Razem national council",
            demand: "enforceable programme milestones and caucus autonomy",
            mps: 10, offices: 24, local: 72, following: 72,
            ideology: 92, list: 34, cohesion: 84
        },
        pps: {
            leader: "the PPS parliamentary circle",
            broker: "the party presidium",
            demand: "a programme seat and a guaranteed social floor",
            mps: 1, offices: 18, local: 34, following: 38,
            ideology: 82, list: 76, cohesion: 60
        },
        social_patriot: {
            leader: "Paulina Matysiak",
            broker: "regional welfare and sovereignty organisers",
            demand: "ownership of regional development and social-sovereignty policy",
            mps: 4, offices: 26, local: 48, following: 58,
            ideology: 74, list: 58, cohesion: 62
        }
    };
    const escalationLabels = [
        "Contained bargaining",
        "Private grumbling and leaks",
        "Specific demand with a deadline",
        "Public criticism and threatened free vote",
        "Rebellion or refusal to whip",
        "Individual defections",
        "Parliamentary circle or club",
        "Organised party and list split"
    ];
    const caucusIds = Object.keys(caucusDefaults);
    const organisationalCaucusIds = caucusIds.filter(function(caucus) {
        return caucus != "labor";
    });
    Q.caucus_ids = caucusIds.slice();
    if (Q.spring_transfer_complete === undefined) {
        // The pre-lifecycle congress recorded a completed transfer in the
        // existing exit ledger. A merger agreement by itself is not enough.
        Q.spring_transfer_complete =
            Number(Q.spring_exit_strength) > 0 ? 1 : 0;
    } else {
        Q.spring_transfer_complete =
            Number(Q.spring_transfer_complete) === 1 ? 1 : 0;
    }
    if (
        !Q.spring_transfer_complete &&
        Q.spring_merged &&
        !Q.spring_active && !Q.spring_in_left &&
        Q.historical_merger_conflict_applied
    ) {
        // The standalone October 2023 entry begins after the historical
        // merger conflict and therefore after Wiosna's internal transfer.
        Q.spring_transfer_complete = 1;
    }
    if (!Number.isFinite(Number(Q.spring_transfer_labor))) {
        Q.spring_transfer_labor = 0;
    }
    if (!Number.isFinite(Number(Q.spring_transfer_progressives))) {
        Q.spring_transfer_progressives = 0;
    }
    for (const caucus of caucusIds) {
        const defaults = caucusDefaults[caucus];
        if (!Number.isFinite(Number(Q[caucus + "_strength"]))) {
            Q[caucus + "_strength"] = defaults.strength;
        }
        if (!Number.isFinite(Number(Q[caucus + "_dissent"]))) {
            Q[caucus + "_dissent"] = defaults.dissent;
        }
        if (Q[caucus + "_active"] === undefined) {
            if (
                caucus == "razem" &&
                Q.razem_in_left_club !== undefined
            ) {
                Q[caucus + "_active"] =
                    Q.razem_in_left_club ? 1 : 0;
            } else if (
                caucus == "spring" && Q.spring_transfer_complete
            ) {
                Q[caucus + "_active"] = 0;
            } else if (Q[caucus + "_party_formed"]) {
                Q[caucus + "_active"] = 0;
            } else {
                Q[caucus + "_active"] = 1;
            }
        }
        if (Q[caucus + "_in_left"] === undefined) {
            Q[caucus + "_in_left"] =
                Q[caucus + "_active"] ? 1 : 0;
        }
        if (Q[caucus + "_party_formed"] === undefined) {
            Q[caucus + "_party_formed"] = 0;
        }
        if (!Number.isFinite(Number(Q[caucus + "_exit_strength"]))) {
            Q[caucus + "_exit_strength"] = 0;
        }
        if (!Number.isFinite(Number(Q[caucus + "_party_relation"]))) {
            Q[caucus + "_party_relation"] = 0;
        }
        if (!Number.isFinite(Number(Q[caucus + "_last_crisis_time"]))) {
            Q[caucus + "_last_crisis_time"] = -99;
        }
        if (
            typeof Q[caucus + "_name"] !== "string" ||
            !Q[caucus + "_name"].trim().length
        ) {
            Q[caucus + "_name"] = defaults.name;
        }
        if (
            typeof Q[caucus + "_party_name"] !== "string" ||
            !Q[caucus + "_party_name"].trim().length
        ) {
            Q[caucus + "_party_name"] = defaults.partyName;
        }
        const escalation = caucusEscalationDefaults[caucus];
        const textDefaults = {
            leader: escalation.leader,
            broker: escalation.broker,
            demand: escalation.demand
        };
        for (const field of Object.keys(textDefaults)) {
            const quality = caucus + "_" + field;
            if (
                typeof Q[quality] !== "string" ||
                !Q[quality].trim().length
            ) {
                Q[quality] = textDefaults[field];
            }
        }
        const factorDefaults = {
            estimated_mps: escalation.mps,
            office_hold: escalation.offices,
            local_organisation: escalation.local,
            personal_following: escalation.following,
            ideological_intensity: escalation.ideology,
            list_dependence: escalation.list,
            cohesion: escalation.cohesion,
            grievance_memory: 0,
            defection_readiness: 0,
            last_escalation_time: -99,
            demand_deadline: -1,
            demand_answered: 0,
            individual_defections: 0,
            circle_formed: 0,
            failed_whips: 0,
            contradictory_appearances: 0,
            adviser_resignations: 0,
            mp_departure_rate: 0,
            mp_departed: 0,
            mp_retained: escalation.mps
        };
        for (const field of Object.keys(factorDefaults)) {
            const quality = caucus + "_" + field;
            if (!Number.isFinite(Number(Q[quality]))) {
                Q[quality] = factorDefaults[field];
            }
        }
        if (!Number.isFinite(Number(Q[caucus + "_escalation_stage"]))) {
            Q[caucus + "_escalation_stage"] =
                Number(Q[caucus + "_dissent"]) >= 72 ? 2 :
                (Number(Q[caucus + "_dissent"]) >= 48 ? 1 : 0);
        }
        Q[caucus + "_escalation_stage"] = Math.round(clamp(
            Q[caucus + "_escalation_stage"],
            0,
            7
        ));
        Q[caucus + "_escalation_label"] =
            escalationLabels[Q[caucus + "_escalation_stage"]];
    }
    if (!Q.labor_party_breakdown_authored) {
        Q.labor_escalation_stage = 0;
        Q.labor_escalation_label =
            "Movement negotiation outside party discipline";
        Q.labor_demand_answered = 1;
        Q.labor_circle_formed = 0;
    }
    Q.factions = organisationalCaucusIds.filter(function(caucus) {
        return Q[caucus + "_active"] &&
            Q[caucus + "_in_left"];
    });
    Q.razem_merged = Q.razem_merged ? 1 : 0;
    if (Q.nowa_lewica_merger_agreed === undefined) {
        Q.nowa_lewica_merger_agreed =
            Q.merger_event_done &&
            String(Q.left_project || "") != "Lewica parliamentary alliance"
                ? 1 : 0;
    }
    const federationTextDefaults = {
        federation_leadership_model: "Unsettled",
        federation_finance_model: "Unsettled",
        federation_candidate_rule: "Unsettled",
        federation_membership_model: "Unsettled",
        federation_crisis_result: "No federal crisis resolved",
        left_structural_endpoint: "Lewica parliamentary alliance"
    };
    for (const quality of Object.keys(federationTextDefaults)) {
        if (typeof Q[quality] != "string" || !Q[quality].trim()) {
            Q[quality] = federationTextDefaults[quality];
        }
    }
    for (const quality of [
        "historical_peaceful_unification", "federation_sequence_stage",
        "federation_route_score", "federation_veto_pressure",
        "federation_decision_delay", "federation_brand_dilution",
        "federation_coalition_reach", "federation_successful",
        "federation_peaceful_unification", "sejm_list_federal_bonus"
    ]) {
        if (!Number.isFinite(Number(Q[quality]))) Q[quality] = 0;
    }
    const pluralConstitutions = [
        "dual_chairs", "member_executive", "protected_currents",
        "single_leadership_protected_currents", "razem_dual_chairs",
        "member-ratified_federation", "federal_council"
    ];
    Q.left_pluralism_protected =
        pluralConstitutions.includes(String(Q.left_constitution || ""))
            ? 1
            : 0;
    if (
        typeof Q.merger_leader != "string" ||
        (Q.merger_leader == "No merger" && Q.nowa_lewica_merger_agreed)
    ) {
        const mergerProject = String(Q.left_project || "").toLowerCase();
        Q.merger_leader = mergerProject.includes("razem-led")
            ? "Razem"
            : (mergerProject.includes("centralised") ||
                mergerProject.includes("asset-led")
                ? "Włodzimierz Czarzasty"
                : (mergerProject.includes("member") ||
                    mergerProject.includes("convention")
                    ? "Membership convention"
                    : "Dual chairs"));
    }
    if (Q.razem_merged && Q.merger_leader == "Razem") {
        if (
            Q.left_constitution == "single_leadership" ||
            Q.left_constitution == "single_leadership_protected_currents"
        ) {
            Q.left_constitution = "razem_dual_chairs";
        }
        Q.left_leader = Q.razem_co_leader == "Vacant"
            ? Q.razem_leader
            : Q.razem_leader + " and " + Q.razem_co_leader;
        if (
            typeof Q.left_leadership_result != "string" ||
            Q.left_leadership_result ==
                "Alliance leadership not yet consolidated"
        ) {
            Q.left_leadership_result =
                "Razem's two chairs jointly lead the unified Left";
        }
    }
    // One place decides which Lewica figure carries the Marshal claim. A
    // Razem-controlled party does not send the SLD founder to the chair, and
    // a Czarzasty already removed from the leadership centre is not restored
    // by the rotation agreement either.
    Q.left_marshal_nominee =
        (Q.left_dominant_current == "razem" ||
            Q.merger_leader == "Razem" ||
            Q.left_party_name == "Lewica Razem")
            ? "Marta Stożek"
            : (!Q.advisor_reshuffle_removed_czarzasty && Q.barons_active
                ? "Włodzimierz Czarzasty"
                : "Agnieszka Dziemianowicz-Bąk");

    Q.razem_in_left_club = Q.razem_active ? 1 : 0;
    Q.matysiak_caucus_actions = Math.max(
        0,
        Math.round(Number(Q.matysiak_caucus_actions) || 0)
    );
    Q.razem_breakaway_protected =
        Q.razem_active &&
        Q.razem_in_left &&
        (
            Q.razem_cooperation_protocol ||
            (
                Q.matysiak_party == "Razem" &&
                Q.matysiak_caucus_actions >= 4 &&
                Number(Q.razem_right_score) >= 50
            ) ||
            (Q.razem_merged && Q.merger_leader == "Razem") ||
            (
                Number(Q.razem_cooperation) >= 60 &&
                Number(Q.razem_dissent) < 35
            )
        ) ? 1 : 0;

    const razemAllianceParties = [
        ["spring", "Wiosna"],
        ["labor", Q.labor_party_name || "Independent Labour Left"],
        ["progressives", Q.progressives_party_name || "Young Left"]
    ];
    Q.pps_joined_razem = 0;
    Q.social_patriot_joined_razem = 0;
    const razemAllianceMembers = ["Razem"];
    for (const party of razemAllianceParties) {
        const joinedQuality = party[0] + "_joined_razem";
        if (!Q.razem_party_formed || !Q[party[0] + "_party_formed"]) {
            Q[joinedQuality] = 0;
        } else {
            Q[joinedQuality] = Q[joinedQuality] ? 1 : 0;
        }
        if (Q[joinedQuality]) razemAllianceMembers.push(party[1]);
    }
    Q.razem_alliance_members = razemAllianceMembers.join(" · ");
    if (razemAllianceMembers.length == 1) {
        Q.razem_alliance_arithmetic = "No independent Razem alliance";
    }

    if (Q.spring_transfer_complete) {
        Q.spring_active = 0;
        Q.spring_in_left = 0;
        Q.spring_strength = 0;
        Q.spring_name = "Wiosna (merged)";
        Q.barons_name = "Nowa Lewica establishment";
        Q.labor_name = "Lewica Pracy parliamentary network";
        if (!Q.wspolne_jutro_formed) {
            Q.progressives_name = "New Left progressives";
            Q.progressives_leader = "Robert Biedroń";
            Q.progressives_broker =
                "Krzysztof Śmiszek, Katarzyna Kotula, Krzysztof Gawkowski, " +
                "Wanda Nowicka and the former Wiosna candidate network";
            Q.progressives_demand =
                "equality-policy ownership, open selections and a binding rights timetable";
        }
        Q.factions = organisationalCaucusIds.filter(function(caucus) {
            return Q[caucus + "_active"] &&
                Q[caucus + "_in_left"];
        });
    }
    const activeLeftCaucuses = organisationalCaucusIds.filter(function(caucus) {
        return Q[caucus + "_active"] && Q[caucus + "_in_left"];
    });
    let strongestLeftCaucus = activeLeftCaucuses[0] || "";
    for (const caucus of activeLeftCaucuses) {
        if (
            Number(Q[caucus + "_strength"]) >
            Number(Q[strongestLeftCaucus + "_strength"])
        ) {
            strongestLeftCaucus = caucus;
        }
    }
    const caucusLeadsBureau = {
        barons: Q.czarzasty_advisor || Q.wieczorek_advisor,
        spring: Q.spring_active && Q.biedron_advisor,
        progressives:
            Q.zukowska_advisor || Q.kotula_advisor ||
            Q.gawkowski_advisor || Q.nowicka_advisor ||
            (Q.spring_transfer_complete && Q.biedron_advisor) ||
            (Q.biejat_party != "Razem" && Q.biejat_advisor),
        razem:
            Q.zandberg_advisor ||
            (Q.biejat_party == "Razem" && Q.biejat_advisor) ||
            Q.zawisza_advisor ||
            (!Q.social_patriot_active && Q.matysiak_advisor),
        social_patriot:
            Q.social_patriot_active &&
            (Q.matysiak_advisor || Q.left_leader == "Paulina Matysiak"),
        pps: false
    };
    Q.left_party_name = Q.left_realign_formed
        ? String(Q.left_realign_name || "Nowa Solidarność")
        : "";
    if (!Q.left_party_name && !activeLeftCaucuses.length) {
        Q.left_party_name = "Lewica w Rozsypce";
    } else if (
        !Q.left_party_name &&
        Number(Q.organised_left_splits) >= 3 &&
        Number(Q.party_unity) < 20
    ) {
        Q.left_party_name = "Porozumienie Lewicy";
    } else if (!Q.left_party_name && Q.nowa_lewica_merger_agreed) {
        Q.left_party_name =
            Q.merger_leader == "Razem"
                ? "Lewica Razem"
                : (
                    Q.merger_leader == "Constituent convention"
                        ? "Federacja Lewicy"
                        : "Nowa Lewica"
                );
    } else if (
        !Q.left_party_name && caucusLeadsBureau[strongestLeftCaucus]
    ) {
        const factionBrands = {
            razem: "Lewica Razem",
            progressives: "Wspólne Jutro",
            spring: "Wiosna-SLD",
            social_patriot: "Lewica Patriotyczna"
        };
        Q.left_party_name = factionBrands[strongestLeftCaucus] || "";
    }
    if (!Q.left_party_name) {
        if (!Q.barons_active) {
            Q.left_party_name = "Nowa Lewica – Odnowa";
        } else if (!Q.spring_active && !Q.spring_merged) {
            Q.left_party_name = "SLD";
        } else if (Q.rename_event_done || Q.spring_merged) {
            Q.left_party_name = "Nowa Lewica";
        } else {
            Q.left_party_name = "Lewica";
        }
    }
    Q.sld_partocracy_stage = clamp(
        Math.round(Number(Q.sld_partocracy_stage) || 0),
        0,
        3
    );
    Q.sld_partocracy_declined = Q.sld_partocracy_declined ? 1 : 0;

    // Wiosna ascendancy path. Wiosna can own the common project from three
    // starting positions: the protected dual chairs, a Wiosna-led successor,
    // or an unmerged Wiosna that is simply the strongest current left in the
    // room. Only availability and the labels are derived here; the dated
    // events own stage, route and consequences.
    const springStrength = Number(Q.spring_strength) || 0;
    const springStrongestCurrent =
        Q.spring_active && Q.spring_in_left &&
        activeLeftCaucuses.every(function(caucus) {
            return caucus == "spring" ||
                springStrength >= (Number(Q[caucus + "_strength"]) || 0);
        });
    Q.spring_path_mode = Q.spring_party_formed
        ? "none"
        : (
            String(Q.left_dominant_current || "") == "spring" &&
            Q.spring_active && Q.spring_in_left
            ? "sole"
            : (!Q.spring_merged && springStrongestCurrent
                ? "independent"
                : (String(Q.left_constitution || "") == "dual_chairs" &&
                        Q.spring_merged &&
                        Q.spring_active && Q.spring_in_left
                    ? "dual"
                    : "none")));
    Q.spring_path_available =
        Q.spring_path_mode != "none" && !Q.spring_path_declined &&
        Q.sld_partocracy_stage < 1 ? 1 : 0;
    Q.spring_path_stage = clamp(
        Math.round(Number(Q.spring_path_stage) || 0),
        0,
        3
    );
    if (
        ["social_liberal", "market_liberal"].indexOf(
            String(Q.spring_path_route)
        ) < 0
    ) {
        Q.spring_path_route = "none";
    }
    Q.spring_liberal_bridge = clamp(
        Number(Q.spring_liberal_bridge) || 0,
        0,
        100
    );
    Q.spring_path_doctrine_label =
        Q.spring_path_route == "market_liberal"
            ? "Fiscally conservative, socially liberal"
            : (Q.spring_path_route == "social_liberal"
                ? "Equality-first social liberalism"
                : "Doctrine unsettled");
    if (Q.spring_path_stage >= 2) {
        Q.spring_path_label =
            "Wiosna ascendant · " + Q.spring_path_doctrine_label;
    } else if (Q.spring_path_available) {
        Q.spring_path_label = "Wiosna can claim the project";
    } else if (Q.spring_path_declined) {
        Q.spring_path_label = "Wiosna's claim was refused";
    } else {
        Q.spring_path_label = "No Wiosna project";
    }
    // A completed doctrine convention renames the party it produced.
    if (
        Q.spring_path_stage >= 3 &&
        typeof Q.spring_path_party_name == "string" &&
        Q.spring_path_party_name.trim().length &&
        !Q.left_realign_formed
    ) {
        Q.left_party_name = Q.spring_path_party_name;
    }
    // The Stage 4 route contract is authoritative: the later SLD path is
    // available only when one legal SLD-hosted party and its apparatus both
    // survive. Labels, adviser slots and merger prose are consequences rather
    // than hidden entry gates.
    const sldCounterCoupLeader = String(Q.rename_displaced_leader || "");
    const sldMachineOrigin = Q.old_left_route_state == "miller_restoration"
        ? "miller_restoration"
        : (Q.left_constitution == "temporary_executive" ||
                Q.left_mandate == "administrative"
            ? "asset_led_executive"
            : (sldCounterCoupLeader &&
                    sldCounterCoupLeader != "Włodzimierz Czarzasty"
                ? "machine_counter_coup"
                : (Q.left_constitution == "single_leadership" &&
                        Q.left_mandate == "executive"
                    ? "centralized_executive"
                    : (Q.left_dominant_current == "barons" &&
                            Q.left_machine_controller == "barons"
                        ? "baron_ascendancy"
                        : "none"))));
    const sldLegalMachine =
        Q.left_common_party_exists &&
        Q.left_legal_vehicle == "sld" &&
        Q.barons_active && Q.barons_in_left &&
        Q.barons_org_status == "merged_current" &&
        !Q.barons_party_formed;
    if (Q.sld_partocracy_stage < 1) {
        Q.sld_partocracy_origin = sldMachineOrigin;
    }
    Q.sld_partocracy_available =
        Q.sld_partocracy_stage < 1 &&
        !Q.sld_partocracy_declined &&
        !Q.sld_populist_route_active &&
        Q.spring_path_stage < 1 &&
        !Q.left_realign_formed &&
        sldLegalMachine && sldMachineOrigin != "none" ? 1 : 0;
    if (
        ["orthodox", "market_apparatus", "partocracy"].indexOf(
            String(Q.sld_partocracy_doctrine)
        ) < 0
    ) {
        Q.sld_partocracy_doctrine = "none";
    }
    Q.sld_partocracy_doctrine_label =
        Q.sld_partocracy_doctrine == "orthodox"
            ? "Orthodox SLD"
            : (Q.sld_partocracy_doctrine == "market_apparatus"
                ? "Market apparatus"
                : (Q.sld_partocracy_doctrine == "partocracy"
                    ? "Reform-avoidant partocracy"
                    : "Doctrine unsettled"));
    Q.sld_patronage_exposure = clamp(
        Number(Q.sld_patronage_exposure) || 0,
        0,
        100
    );
    Q.sld_election_payoff = clamp(
        Number(Q.sld_election_payoff) || 0,
        -10,
        10
    );
    if (Q.sld_partocracy_stage >= 3) {
        Q.sld_partocracy_label =
            "SLD ascendancy · " + Q.sld_partocracy_doctrine_label;
    } else if (Q.sld_partocracy_stage >= 1) {
        Q.sld_partocracy_label = "SLD apparatus consolidating";
    } else if (Q.sld_partocracy_available) {
        Q.sld_partocracy_label = "SLD can claim the party";
    } else if (Q.sld_partocracy_declined) {
        Q.sld_partocracy_label = "SLD ascendancy declined";
    } else {
        Q.sld_partocracy_label = "No SLD ascendancy";
    }
    if (Q.sld_partocracy_stage >= 2 && !Q.left_realign_formed) {
        Q.left_party_name = "SLD";
        Q.left_project = "SLD apparatus ascendancy";
        Q.left_structural_endpoint = "SLD apparatus party";
    }
    // Stage 6 consumes only the Stage 4 restoration contract. A doctrine
    // already present in an old save may remain historical state, but it
    // cannot rename or gate the social-populist project.
    if (Q.sld_populist_route_active) {
        Q.left_party_name = "Sojusz Polski Społecznej";
        Q.social_patriot_party_name = "Sojusz Polski Społecznej";
        Q.social_patriot_name = "Sojusz Polski Społecznej tendency";
        Q.left_leader = "Leszek Miller";
        Q.merger_leader = "Leszek Miller";
        Q.social_patriot_leader = "Leszek Miller";
        Q.left_dominant_current = "social_patriot";
        Q.left_project =
            "Sojusz Polski Społecznej welfare-nationalist refoundation";
        Q.left_structural_endpoint = "National welfare-populist party";
        Q.left_leadership_result =
            "Miller refounded the restored SLD apparatus as a social-populist vehicle";
    }

    const autonomousPartners = [];
    if (
        Q.razem_active &&
        !Q.razem_merged &&
        !Q.left_party_name.includes("Razem")
    ) autonomousPartners.push("Razem");
    if (Q.pps_active && !Q.razem_merged) autonomousPartners.push("PPS");
    Q.left_family_name = autonomousPartners.length
        ? Q.left_party_name + " · " + autonomousPartners.join(" · ")
        : Q.left_party_name;

    // Keep constitutional office, cabinet ownership and Lewica's role
    // separate. Later events can replace a prime minister or move the Left
    // outside cabinet without leaving the interface to infer who governs.
    const primeMinisterText =
        String(Q.prime_minister || "").toLowerCase();
    const governmentText = (
        primeMinisterText + " " +
        String(Q.government_name || "").toLowerCase()
    );
    const authoritativeGovernmentParties = [
        "pis", "ko", "lewica", "psl", "p2050", "independent", "other"
    ];
    if (
        authoritativeGovernmentParties.indexOf(
            String(Q.government_party || "").toLowerCase()
        ) < 0
    ) {
    if (
        primeMinisterText.includes("morawiecki") ||
        primeMinisterText.includes("szydło") ||
        primeMinisterText.includes("szydlo") ||
        primeMinisterText.includes("czarnek") ||
        (
            !primeMinisterText &&
            governmentText.includes("pis")
        )
    ) {
        Q.government_party = "pis";
        Q.government_owner = "PiS and its governing partners";
    } else if (
        primeMinisterText.includes("dziemianowicz") ||
        primeMinisterText.includes("biejat") ||
        primeMinisterText.includes("czarzasty") ||
        primeMinisterText.includes("biedroń") ||
        primeMinisterText.includes("biedron") ||
        primeMinisterText.includes("zandberg") ||
        primeMinisterText.includes("lewica") ||
        (
            !primeMinisterText &&
            governmentText.includes("lewica")
        )
    ) {
        Q.government_party = "lewica";
        Q.government_owner = "Lewica-led coalition";
    } else if (
        primeMinisterText.includes("kosiniak") ||
        (
            !primeMinisterText &&
            governmentText.includes("psl")
        )
    ) {
        Q.government_party = "psl";
        Q.government_owner = "PSL-led coalition";
    } else if (
        primeMinisterText.includes("hołownia") ||
        primeMinisterText.includes("holownia") ||
        (
            !primeMinisterText &&
            governmentText.includes("poland 2050")
        )
    ) {
        Q.government_party = "p2050";
        Q.government_owner = "Poland 2050-led coalition";
    } else if (
        primeMinisterText.includes("tusk") ||
        primeMinisterText.includes("trzaskowski") ||
        primeMinisterText.includes("nowacka") ||
        primeMinisterText.includes("sikorski") ||
        primeMinisterText.includes("kierwiński") ||
        primeMinisterText.includes("kierwinski") ||
        governmentText.includes("ko-led") ||
        (
            !primeMinisterText &&
            governmentText.includes("democratic")
        )
    ) {
        Q.government_party = "ko";
        Q.government_owner = "KO-led democratic coalition";
    } else {
        Q.government_party =
            typeof Q.government_party == "string" &&
            Q.government_party.length
                ? Q.government_party
                : "other";
        Q.government_owner =
            Q.government_party == "lewica"
                ? "Lewica-led coalition"
                : (Q.government_party == "ko"
                    ? "KO-led democratic coalition"
                    : "Caretaker or cross-party cabinet");
    }
    }
    if (
        typeof Q.government_owner != "string" ||
        !Q.government_owner.length
    ) {
        Q.government_owner =
            Q.government_party == "pis"
                ? "PiS and its governing partners"
                : (Q.government_party == "ko"
                    ? "KO-led democratic coalition"
                    : (Q.government_party == "lewica"
                        ? "Lewica-led coalition"
                        : (Q.government_party == "independent"
                            ? "Independent prime minister and supporting majority"
                            : "Caretaker or cross-party cabinet")));
    }

    // Constitutional offices are not extra party jobs. Normalisation may
    // enforce a vacancy, but it must never appoint the successor: the named
    // institution does that in the full office-authority event.
    const presidentKey =
        String(Q.president_name || "").toLowerCase();
    const speakerKey =
        String(Q.sejm_speaker || "").toLowerCase();
    if (
        presidentKey &&
        speakerKey &&
        presidentKey == speakerKey
    ) {
        Q.office_incompatibility_previous_speaker = Q.sejm_speaker;
        Q.sejm_speaker = "Vacant — Sejm election pending";
        Q.office_incompatibility_pending = 1;
        Q.office_incompatibility_kind = "Sejm Marshal";
    }
    if (
        presidentKey &&
        primeMinisterText &&
        presidentKey == primeMinisterText
    ) {
        Q.office_incompatibility_previous_prime_minister =
            Q.prime_minister;
        Q.prime_minister = "Vacant — constitutional succession pending";
        Q.caretaker_government = 1;
        Q.government_has_confidence = 0;
        Q.formation_in_progress = 1;
        Q.office_incompatibility_pm_formation = 1;
        Q.office_incompatibility_pending = 1;
        Q.office_incompatibility_kind = "Prime Minister";
    }
    if (
        presidentKey.includes("hołownia") ||
        presidentKey.includes("holownia")
    ) {
        if (
            String(Q.p2050_leader || "").includes("Hołownia")
        ) {
            Q.p2050_leader = "Vacant — party election pending";
            Q.office_incompatibility_pending = 1;
            Q.office_incompatibility_kind = "Party leadership";
        }
    }
    if (presidentKey.includes("kosiniak")) {
        if (
            String(Q.psl_leader || "").includes("Kosiniak")
        ) {
            Q.psl_leader = "Vacant — party election pending";
            Q.office_incompatibility_pending = 1;
            Q.office_incompatibility_kind = "Party leadership";
        }
    }

    // The 2026 Poland 2050 chain defaults to a formal split path; the
    // internal-wing variant remains an explicit fallback for custom branches.
    if (!Number.isFinite(Number(Q.p2050_formal_split_chain))) {
        Q.p2050_formal_split_chain = 1;
    }
    if (
        Number(Q.p2050_formal_split_chain) === 0 &&
        !Q.p2050_split_occurred &&
        !Q.unia_centrum_formed
    ) {
        Q.p2050_formal_split_chain = 1;
    }
    Q.p2050_formal_split_chain = Q.p2050_formal_split_chain ? 1 : 0;
    if (!Number.isFinite(Number(Q.p2050_internal_split))) {
        Q.p2050_internal_split = 0;
    }
    Q.p2050_internal_split = Q.p2050_internal_split ? 1 : 0;
    if (!Number.isFinite(Number(Q.p2050_internal_split_month))) {
        Q.p2050_internal_split_month = -1;
    }
    if (typeof Q.p2050_internal_split_leader != "string") {
        Q.p2050_internal_split_leader = "No organised internal wing";
    }
    if (typeof Q.p2050_internal_split_status != "string") {
        Q.p2050_internal_split_status = "No internal split";
    }
    const p2050LeaderName = String(Q.p2050_leader || "");
    const p2050LeaderLower = p2050LeaderName.toLowerCase();
    const p2050LeaderSettled =
        p2050LeaderName.length > 0 &&
        !p2050LeaderLower.includes("vacant") &&
        !p2050LeaderLower.includes("pending");
    const p2050InternalSplitWindow =
        Number(Q.year) > 2026 ||
        (Number(Q.year) == 2026 && Number(Q.month) >= 2);
    if (
        !Q.p2050_formal_split_chain &&
        !Q.p2050_split &&
        !Q.p2050_internal_split &&
        Q.third_way_split &&
        p2050LeaderSettled &&
        p2050InternalSplitWindow
    ) {
        Q.p2050_internal_split = 1;
        Q.p2050_internal_split_month = Number(Q.time) || 0;
        Q.p2050_internal_split_leader =
            p2050LeaderName == "Katarzyna Pełczyńska-Nałęcz"
                ? "Paulina Hennig-Kloska"
                : "Katarzyna Pełczyńska-Nałęcz";
        Q.p2050_internal_split_status =
            "Competing internal platform inside Poland 2050";
        Q.p2050_coalition_dissent += 6;
        Q.p2050_relation -= 3;
        if (
            Q.government_has_confidence &&
            !Q.caretaker_government &&
            (
                Q.government_party == "p2050" ||
                Boolean(Q.ministry_p2050_in_cabinet)
            )
        ) {
            Q.government_coalition_dissent += 2;
        }
        Q.news_headline =
            "Poland 2050 enters an internal split under " +
            Q.p2050_internal_split_leader +
            " without creating a separate party";
    }
    if (Q.p2050_split) {
        Q.p2050_internal_split = 0;
        Q.p2050_internal_split_status =
            "Escalated beyond an internal split";
    }

    // A politician who has left the Left delegation—or taken the
    // presidency—cannot remain available as a Lewica minister.
    if (
        Q.health_minister == "Marcelina Zawisza" &&
        (
            Q.razem_split ||
            !Q.razem_in_left_club ||
            !Q.razem_active
        )
    ) {
        Q.office_incompatibility_previous_minister = Q.health_minister;
        Q.office_incompatibility_previous_minister_party =
            Q.health_minister_party;
        Q.office_incompatibility_portfolio = "health";
        Q.health_minister_party = "Vacant";
        Q.health_minister =
            "Vacant — prime-ministerial appointment pending";
        Q.office_incompatibility_pending = 1;
        Q.office_incompatibility_kind = "Cabinet portfolio";
    }
    // Formation saves made before coalition membership became canonical kept
    // only a route code and a handful of party-specific flags. Rebuild that
    // one source of truth once, then mirror the compatibility fields from it.
    const formationCode = String(Q.formation_coalition_code || "none")
        .replace(/_tolerated$/, "");
    const formationMembersByCode = {
        democratic_2023: ["ko", "p2050", "psl", "lewica"],
        ko_psl_left: ["ko", "psl", "lewica"],
        ko_p2050_left: ["ko", "p2050", "lewica"],
        left_p2050: ["p2050", "lewica"],
        left_psl: ["psl", "lewica"],
        left_third: ["p2050", "psl", "lewica"],
        third_left_pis: ["p2050", "psl", "lewica"],
        ko_left: ["ko", "lewica"],
        left_only: ["lewica"],
        left_pis: ["pis", "lewica"],
        left_pis_psl: ["pis", "lewica", "psl"],
        left_pis_p2050: ["pis", "lewica", "p2050"],
        left_pis_third: ["pis", "lewica", "psl", "p2050"],
        left_pis_konf: ["pis", "lewica", "konf"],
        left_pis_konf_psl: ["pis", "lewica", "konf", "psl"],
        left_pis_konf_p2050: ["pis", "lewica", "konf", "p2050"],
        left_pis_konf_third: ["pis", "lewica", "konf", "psl", "p2050"],
        pis_psl: ["pis", "psl"],
        pis_third: ["pis", "psl", "p2050"],
        pis_psl_konf: ["pis", "psl", "konf"],
        pis_third_konf: ["pis", "psl", "p2050", "konf"],
        pis_konf: ["pis", "konf"],
        pis_konf_third: ["pis", "konf", "p2050", "psl"],
        pis_konf_psl: ["pis", "konf", "psl"],
        ko_third: ["ko", "p2050", "psl"],
        ko_konf: ["ko", "konf"]
    };
    const knownFormationParties = [
        "pis", "ko", "psl", "p2050", "konf", "lewica"
    ];
    let canonicalFormationMembers = Array.isArray(Q.formation_coalition_members)
        ? Q.formation_coalition_members.filter(function(code, index, members) {
            return knownFormationParties.includes(code) &&
                members.indexOf(code) == index;
        })
        : [];
    if (
        Q.formation_coalition_selected &&
        !canonicalFormationMembers.length &&
        formationMembersByCode[formationCode]
    ) {
        canonicalFormationMembers = formationMembersByCode[formationCode].slice();
    }
    Q.formation_coalition_members = canonicalFormationMembers;
    const formationHas = function(code) {
        return canonicalFormationMembers.includes(code);
    };
    if (Q.formation_coalition_selected && canonicalFormationMembers.length) {
        Q.formation_pis_cabinet_committed = formationHas("pis") ? 1 : 0;
        Q.formation_ko_cabinet_committed = formationHas("ko") ? 1 : 0;
        Q.formation_psl_cabinet_committed = formationHas("psl") ? 1 : 0;
        Q.formation_p2050_cabinet_committed = formationHas("p2050") ? 1 : 0;
        Q.formation_konf_cabinet_committed = formationHas("konf") ? 1 : 0;
    }
    for (const code of ["pis", "ko", "psl", "p2050", "konf"]) {
        const key = "formation_" + code + "_cabinet_committed";
        Q[key] = Number.isFinite(Number(Q[key]))
            ? Math.max(-1, Math.min(1, Math.round(Number(Q[key]))))
            : -1;
    }
    Q.formation_pis_left_safeguards = Math.max(
        0,
        Math.min(3, Math.round(Number(Q.formation_pis_left_safeguards) || 0))
    );
    Q.formation_pis_rival_code = typeof Q.formation_pis_rival_code == "string"
        ? Q.formation_pis_rival_code : "none";
    Q.formation_pis_rival_pressure = Math.max(
        0,
        Math.min(2, Math.round(Number(Q.formation_pis_rival_pressure) || 0))
    );
    Q.formation_miller_konf_exception =
        Number(Q.sld_populist_route_active) == 1 &&
        String(Q.sld_populist_orientation || "") == "konfederacja" &&
        String(Q.sld_populist_alliance_state || "") == "accepted" &&
        String(Q.sejm_list_outcome || "") == "konf_5" ? 1 : 0;
    Q.formation_pm_candidate_party =
        typeof Q.formation_pm_candidate_party == "string" &&
        Q.formation_pm_candidate_party.length
            ? Q.formation_pm_candidate_party
            : String(Q.pm_political_family || "");
    Q.formation_solpol_exit_seats = Math.max(
        0,
        Math.round(Number(Q.formation_solpol_exit_seats) || 0)
    );
    Q.formation_solpol_exit_triggered = Q.formation_solpol_exit_triggered ? 1 : 0;
    const legacyEarlyPiSLeftEntry = Boolean(Q.pis_left_coalition_2021) ||
        String(Q.government_name || "").includes("Third Morawiecki Cabinet") ||
        String(Q.coalition_status || "").includes("PiS–New Left");
    Q.formation_pis_left_taboo_broken =
        Q.formation_pis_left_taboo_broken || legacyEarlyPiSLeftEntry ? 1 : 0;
    if (
        Q.formation_pis_left_taboo_broken &&
        (typeof Q.formation_pis_left_taboo_origin != "string" ||
            !Q.formation_pis_left_taboo_origin.length)
    ) {
        Q.formation_pis_left_taboo_origin = legacyEarlyPiSLeftEntry
            ? "Joined PiS after Gowin's exit in 2021"
            : "Earlier PiS–Lewica governing agreement";
    }
    Q.formation_pis_rival_process_started =
        Q.formation_pis_rival_process_started ? 1 : 0;
    Q.formation_pis_rival_process_resolved =
        Q.formation_pis_rival_process_resolved ? 1 : 0;
    Q.formation_pis_rival_skip_reason =
        typeof Q.formation_pis_rival_skip_reason == "string"
            ? Q.formation_pis_rival_skip_reason : "Not evaluated";
    Q.cabinet_pis_loss = Math.max(0, Math.round(Number(Q.cabinet_pis_loss) || 0));
    Q.cabinet_konf_loss = Math.max(0, Math.round(Number(Q.cabinet_konf_loss) || 0));

    // The active Polish cabinet uses one complete roster for formation,
    // recurring policy cards and later reshuffles. Migrate older saves, clear
    // stale Lewica ownership after an exit, and derive the count from the
    // roster rather than trusting incremental bookkeeping.
    const snapRosterRecorded = Boolean(Q.snap_cabinet_commitments_recorded);
    const formationRosterRecorded = Boolean(Q.formation_coalition_selected) &&
        canonicalFormationMembers.length > 0;
    const p2050CabinetEligible = Number(Q.p2050_seats) > 0 &&
        (formationRosterRecorded ? formationHas("p2050") : (
            Boolean(Q.ministry_p2050_in_cabinet) ||
            !snapRosterRecorded ||
            Q.government_party == "p2050" ||
            Boolean(Q.snap_p2050_cabinet_committed)
        ));
    const pslCabinetEligible = Number(Q.psl_seats) > 0 &&
        !Q.coalition_broken &&
        (formationRosterRecorded ? formationHas("psl") : (
            Boolean(Q.ministry_psl_in_cabinet) ||
            !snapRosterRecorded ||
            Q.government_party == "psl" ||
            Boolean(Q.snap_psl_cabinet_committed)
        ));
    const konfCabinetEligible =
        (formationRosterRecorded
            ? formationHas("konf")
            : (Boolean(Q.ministry_konf_in_cabinet) ||
                Boolean(Q.sikorski_konf_cabinet))) &&
        Number(Q.konf_seats) > 0;
    const democraticCabinetDefaults = {
        labor: ["KO", "Marzena Okła-Drewnowicz"],
        equality: ["KO", "Monika Rosa"],
        housing: ["KO", "Krystyna Sibińska"],
        health: ["KO", "Izabela Leszczyna"],
        digital: p2050CabinetEligible
            ? ["Poland 2050", "Michał Gramatyka"]
            : ["KO", "Jan Grabiec"],
        science: ["KO", "Barbara Nowacka"],
        interior: ["KO", "Marcin Kierwiński"],
        finance: ["KO", "Andrzej Domański"],
        economy:
            !pslCabinetEligible
            ? ["KO", "Borys Budka"]
            : ["PSL", "Krzysztof Hetman"],
        justice: ["KO", "Adam Bodnar"],
        foreign: ["KO", "Radosław Sikorski"],
        agriculture:
            !pslCabinetEligible
            ? ["KO", "Dorota Niedziela"]
            : ["PSL", "Czesław Siekierski"],
        defence:
            !pslCabinetEligible
            ? ["KO", "Tomasz Siemoniak"]
            : ["PSL", "Władysław Kosiniak-Kamysz"]
    };
    let cabinetDefaults = democraticCabinetDefaults;
    let cabinetAllowedParties = ["KO"];
    if (p2050CabinetEligible) {
        cabinetAllowedParties.push("Poland 2050");
    }
    if (pslCabinetEligible) {
        cabinetAllowedParties.push("PSL");
    }
    if (konfCabinetEligible) {
        cabinetAllowedParties.push("Konfederacja");
    }
    if (
        !Q.left_in_government &&
        !["ko", "psl", "p2050"].includes(Q.government_party)
    ) {
        const cabinetPartyLabels = {
            pis: "PiS",
            psl: "PSL",
            p2050: "Poland 2050",
            konf: "Konfederacja",
            lewica: "Lewica",
            other: "Cabinet"
        };
        const cabinetParty =
            cabinetPartyLabels[Q.government_party] || "Cabinet";
        const pisCabinetMinisters = {
            labor: "Dorota Bojemska",
            equality: "Anna Schmidt",
            housing: "Piotr Uściński",
            health: "Ewa Krajewska",
            digital: "Janusz Cieszyński",
            science: "Krzysztof Szczucki",
            interior: "Paweł Szefernaker",
            finance: "Andrzej Kosztowniak",
            economy: "Marlena Maląg",
            justice: "Paweł Jabłoński",
            foreign: "Szymon Szynkowski vel Sęk",
            agriculture: "Anna Gembicka",
            defence: "Mariusz Błaszczak"
        };
        const leftCabinetMinisters = {
            labor: "Agnieszka Dziemianowicz-Bąk",
            equality: "Katarzyna Kotula",
            housing: "Magdalena Biejat",
            health: "Marcelina Zawisza",
            digital: "Krzysztof Gawkowski",
            science: "Dariusz Wieczorek",
            interior: "Wiesław Szczepański",
            finance: "Dariusz Standerski",
            economy: "Paulina Matysiak",
            justice: "Krzysztof Śmiszek",
            foreign: "Andrzej Szejna",
            agriculture: "Wiesław Buż",
            defence: "Marcin Kulasek"
        };
        const razemCabinetMinisters = {
            labor: "Agnieszka Dziemianowicz-Bąk",
            equality: "Katarzyna Kotula",
            housing: "Magdalena Biejat",
            health: "Marcelina Zawisza",
            digital: "Krzysztof Gawkowski",
            science: "Maciej Gdula",
            interior: "Wiesław Szczepański",
            finance: "Dariusz Standerski",
            economy: "Paulina Matysiak",
            justice: "Katarzyna Ueberhan",
            foreign: "Andrzej Szejna",
            agriculture: "Wiesław Buż",
            defence: "Marcin Kulasek"
        };
        const independentCabinetMinisters = {
            labor: "Gertruda Uścińska",
            equality: "Zuzanna Rudzińska-Bluszcz",
            housing: "Joanna Erbel",
            health: "Maria Libura",
            digital: "Alek Tarkowski",
            science: "Michał Kleiber",
            interior: "Marek Biernacki",
            finance: "Paweł Wojciechowski",
            economy: "Jerzy Hausner",
            justice: "Ewa Łętowska",
            foreign: "Jacek Czaputowicz",
            agriculture: "Monika Stanny",
            defence: "Stanisław Koziej"
        };
        const leadingLeftCaucus = String(strongestLeftCaucus || "").trim();
        const cabinetMinisters = Q.government_party == "pis"
            ? pisCabinetMinisters
            : Q.government_party == "lewica"
            ? (leadingLeftCaucus == "razem"
                ? razemCabinetMinisters
                : leftCabinetMinisters)
            : independentCabinetMinisters;
        cabinetDefaults = {};
        for (
            const portfolio of Object.keys(
                democraticCabinetDefaults
            )
        ) {
            cabinetDefaults[portfolio] = [
                cabinetParty,
                cabinetMinisters[portfolio]
            ];
        }
        cabinetAllowedParties = [cabinetParty];
        if (Q.government_party == "pis") {
            if (p2050CabinetEligible) {
                cabinetDefaults.digital = ["Poland 2050", "Michał Gramatyka"];
                cabinetAllowedParties.push("Poland 2050");
            }
            if (pslCabinetEligible) {
                cabinetDefaults.agriculture = ["PSL", "Czesław Siekierski"];
                cabinetAllowedParties.push("PSL");
            }
            if (konfCabinetEligible) {
                cabinetDefaults.finance = ["Konfederacja", "Sławomir Mentzen"];
                cabinetDefaults.economy = ["Konfederacja", "Konrad Berkowicz"];
                cabinetAllowedParties.push("Konfederacja");
            }
        }
    }
    const cabinetGovernmentChanged =
        Q.year >= 2023 &&
        !Q.left_in_government &&
        !Q.caretaker_government &&
        String(Q.cabinet_roster_government_party || "") !=
            String(Q.government_party || "");
    const cabinetPortfolios = Object.keys(cabinetDefaults);
    for (const portfolio of cabinetPortfolios) {
        const partyKey = portfolio + "_minister_party";
        const ministerKey = portfolio + "_minister";
        const partyMissing =
            typeof Q[partyKey] != "string" ||
            !Q[partyKey].length;
        const ministerMissing =
            typeof Q[ministerKey] != "string" ||
            !Q[ministerKey].length ||
            /nominee|unassigned|development ministry/i.test(
                Q[ministerKey]
            );
        const authorityVacancy =
            String(Q[ministerKey] || "").includes(
                "appointment pending"
            );
        const wrongGovernment =
            Q.year >= 2023 &&
            !Q.left_in_government &&
            !Q.caretaker_government &&
            !authorityVacancy &&
            (
                cabinetGovernmentChanged ||
                (
                    !partyMissing &&
                    cabinetAllowedParties.indexOf(Q[partyKey]) < 0
                )
            );
        if ((partyMissing || wrongGovernment) && !authorityVacancy) {
            Q[partyKey] = Q.year >= 2023
                ? cabinetDefaults[portfolio][0]
                : "Unassigned";
        }
        if ((ministerMissing || wrongGovernment) && !authorityVacancy) {
            Q[ministerKey] = Q.year >= 2023
                ? cabinetDefaults[portfolio][1]
                : "Unassigned";
        }
    }
    Q.cabinet_roster_government_party =
        String(Q.government_party || "other");

    // The President cannot simultaneously remain in the Council of
    // Ministers. Clear every conflicting portfolio generically so new
    // portfolios cannot reintroduce the bug. Appointment is deferred to the
    // authority event instead of being invented by monthly normalisation.
    if (presidentKey) {
        for (const portfolio of cabinetPortfolios) {
            const ministerKey = portfolio + "_minister";
            const partyKey = portfolio + "_minister_party";
            if (
                String(Q[ministerKey] || "").toLowerCase() == presidentKey
            ) {
                Q.office_incompatibility_previous_minister =
                    Q[ministerKey];
                Q.office_incompatibility_previous_minister_party =
                    Q[partyKey];
                Q.office_incompatibility_portfolio = portfolio;
                Q[ministerKey] =
                    "Vacant — prime-ministerial appointment pending";
                Q[partyKey] = "Vacant";
                Q.office_incompatibility_pending = 1;
                Q.office_incompatibility_kind = "Cabinet portfolio";
            }
        }
        if (
            String(Q.senate_marshal || "").toLowerCase() == presidentKey
        ) {
            Q.senate_marshal = "Vacant — Senate election pending";
            Q.office_incompatibility_pending = 1;
            Q.office_incompatibility_kind = "Senate Marshal";
        }
    }

    // Invariant: coalition_seats counts MPs belonging to parties that hold at
    // least one Council of Ministers portfolio. It is not the last confidence
    // yes count, a projected alliance, or outside confidence-and-supply votes.
    // Exact roll calls remain in confidence_yes/no/abstain.
    const sejmSeatTotal = Math.max(
        1,
        Math.round(Number(Q.sejm_total) || 460)
    );
    const mainLeftSeats = Math.min(
        sejmSeatTotal,
        Math.max(0, Math.round(Number(Q.left_seats) || 0))
    );
    const liveCommittedSeparateLeftSeats = [
        ["sld_breakaway_seats", "barons_party_relation"],
        ["social_patriot_seats", "social_patriot_party_relation"],
        ["spring_breakaway_seats", "spring_party_relation"],
        ["labor_left_seats", "labor_party_relation"],
        ["young_left_seats", "progressives_party_relation"],
        ["razem_party_seats", "razem_party_relation"],
        ["pps_party_seats", "pps_party_relation"]
    ].reduce(function(total, entry) {
        return total + (
            Number(Q[entry[1]]) >= 45
                ? Math.max(0, Math.round(Number(Q[entry[0]]) || 0))
                : 0
        );
    }, 0);
    const validCommittedLeftSeats = Math.min(
        sejmSeatTotal,
        mainLeftSeats + liveCommittedSeparateLeftSeats
    );
    const recordedLeftCabinetSeats = Math.min(
        validCommittedLeftSeats,
        Math.max(
            0,
            Math.round(Number(Q.ministry_left_cabinet_seats) || 0)
        )
    );
    const cabinetSeatByParty = {
        PiS: Math.max(0, Math.round(Number(Q.pis_seats) || 0)),
        KO: Math.max(0, Math.round(Number(Q.ko_seats) || 0)),
        Lewica: recordedLeftCabinetSeats,
        PSL: Math.max(0, Math.round(Number(Q.psl_seats) || 0)),
        "Poland 2050": Math.max(
            0,
            Math.round(Number(Q.p2050_seats) || 0)
        ),
        Konfederacja: Math.max(
            0,
            Math.round(Number(Q.konf_seats) || 0)
        )
    };
    const cabinetParties = [];
    for (const portfolio of cabinetPortfolios) {
        const party = String(Q[portfolio + "_minister_party"] || "");
        if (
            Object.prototype.hasOwnProperty.call(cabinetSeatByParty, party) &&
            cabinetParties.indexOf(party) < 0
        ) {
            cabinetParties.push(party);
        }
    }
    if (!Q.caretaker_government && !cabinetGovernmentChanged) {
        const recordedCabinetMembership = [
            ["PiS", Q.ministry_pis_in_cabinet, Q.pis_seats],
            ["KO", Q.ministry_ko_in_cabinet, Q.ko_seats],
            ["Poland 2050", Q.ministry_p2050_in_cabinet, Q.p2050_seats],
            ["PSL", Q.ministry_psl_in_cabinet, Q.psl_seats],
            ["Konfederacja", Q.ministry_konf_in_cabinet || Q.sikorski_konf_cabinet, Q.konf_seats],
            ["Lewica", Q.left_in_government, recordedLeftCabinetSeats]
        ];
        for (const membership of recordedCabinetMembership) {
            if (
                membership[1] && Number(membership[2]) > 0 &&
                cabinetParties.indexOf(membership[0]) < 0
            ) {
                cabinetParties.push(membership[0]);
            }
        }
    }
    const recordedGovernmentSupport = Math.max(
        0,
        Math.round(Number(Q.government_support_seats) || 0)
    );
    if (!Q.caretaker_government) {
        Q.coalition_seats = Math.min(
            Number(Q.sejm_total) || 460,
            cabinetParties.reduce(function(total, party) {
                return total + cabinetSeatByParty[party];
            }, 0)
        );
        const nonLeftCabinetSeats = cabinetParties.reduce(
            function(total, party) {
                return total + (
                    party == "Lewica" ? 0 : cabinetSeatByParty[party]
                );
            },
            0
        );
        const nonLeftMaximum = Math.max(
            0,
            sejmSeatTotal - validCommittedLeftSeats
        );
        Q.government_support_seats = Math.min(
            nonLeftMaximum,
            cabinetGovernmentChanged
                ? nonLeftCabinetSeats
                : Math.max(
                    nonLeftCabinetSeats,
                    recordedGovernmentSupport
                )
        );
    } else if (Q.caretaker_government) {
        Q.coalition_seats = 0;
        Q.government_support_seats = 0;
        Q.ministry_pis_in_cabinet = 0;
        Q.ministry_ko_in_cabinet = 0;
        Q.ministry_p2050_in_cabinet = 0;
        Q.ministry_psl_in_cabinet = 0;
        Q.ministry_konf_in_cabinet = 0;
        Q.sikorski_konf_cabinet = 0;
    }
    Q.coalition_seats_basis =
        "MPs of parties holding Council of Ministers portfolios";
    Q.government_support_basis =
        "Dependable non-Lewica government votes; Lewica is recorded separately";
    Q.coalition_cabinet_parties = cabinetParties.length
        ? cabinetParties.join(" · ")
        : "None recorded";
    Q.family_minister_party = Q.labor_minister_party;
    Q.family_minister = Q.labor_minister;
    Q.ministry_count = cabinetPortfolios.reduce(
        function(total, portfolio) {
            return total + (
                Q[portfolio + "_minister_party"] == "Lewica"
                    ? 1
                    : 0
            );
        },
        0
    );
    Q.ministry_leverage = Math.max(
        0,
        Number(Q.ministry_leverage) || 0
    );
    Q.ministry_base_leverage = Math.max(
        0,
        Number(Q.ministry_base_leverage) || 0
    );
    Q.ministries_finalized = Q.ministries_finalized ? 1 : 0;
    Q.ministry_maximal_mandate =
        Q.ministry_maximal_mandate ? 1 : 0;
    Q.ministry_whole_left_mandate =
        Q.ministry_whole_left_mandate ? 1 : 0;
    Q.ministry_left_cabinet_seats = recordedLeftCabinetSeats;
    Q.ministry_coalition_seats = Math.max(
        0,
        Number(Q.ministry_coalition_seats) || 0
    );
    Q.ministry_pis_in_cabinet = Q.ministry_pis_in_cabinet ? 1 : 0;
    Q.ministry_ko_in_cabinet = Q.ministry_ko_in_cabinet ? 1 : 0;
    Q.ministry_p2050_in_cabinet =
        Q.ministry_p2050_in_cabinet ? 1 : 0;
    Q.ministry_psl_in_cabinet = Q.ministry_psl_in_cabinet ? 1 : 0;
    Q.ministry_konf_in_cabinet =
        Q.ministry_konf_in_cabinet || Q.sikorski_konf_cabinet ? 1 : 0;
    Q.formation_psl_cabinet_committed = Number.isFinite(
        Number(Q.formation_psl_cabinet_committed)
    )
        ? Math.max(
            -1,
            Math.min(1, Math.round(Q.formation_psl_cabinet_committed))
        )
        : -1;
    Q.ministry_reshuffle_previous_count = Math.max(
        0,
        Number(Q.ministry_reshuffle_previous_count) || 0
    );
    Q.ministry_reshuffle_changes = Math.max(
        0,
        Number(Q.ministry_reshuffle_changes) || 0
    );
    Q.psl_agriculture_released =
        Q.psl_agriculture_released ? 1 : 0;
    if (
        typeof Q.ministry_allocation_mode != "string" ||
        !Q.ministry_allocation_mode.length
    ) {
        Q.ministry_allocation_mode = "settled";
    }
    if (
        typeof Q.ministry_return_mode != "string" ||
        !Q.ministry_return_mode.length
    ) {
        Q.ministry_return_mode = "cabinet_program";
    }

    const governmentBurdenDefaults = {
        government_achievements: 0,
        government_burden_active: 0,
        government_burden_timer: 0,
        government_burden_cycle: 0,
        government_burden_required: 2,
        government_burden_completed: 0,
        government_burden_breached: 0,
        government_burden_review_pending: 0,
        government_burden_failures: 0,
        government_burden_last_completed: 0,
        government_burden_last_breached: 0,
        government_goal_health: 0,
        government_goal_housing: 0,
        government_goal_labor: 0,
        government_goal_welfare: 0,
        government_goal_equality: 0,
        government_burden_health_market_seen: 0,
        government_burden_social_delay_seen: 0,
        government_burden_tenant_seen: 0
    };
    for (const quality of Object.keys(governmentBurdenDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = governmentBurdenDefaults[quality];
        }
    }
    Q.government_burden_required = 2;
    Q.government_burden_timer = Math.max(
        0,
        Math.round(Number(Q.government_burden_timer) || 0)
    );
    for (const quality of [
        "government_burden_active",
        "government_burden_breached",
        "government_burden_review_pending",
        "government_burden_last_breached",
        "government_goal_health",
        "government_goal_housing",
        "government_goal_labor",
        "government_goal_welfare",
        "government_goal_equality",
        "government_burden_health_market_seen",
        "government_burden_social_delay_seen",
        "government_burden_tenant_seen"
    ]) {
        Q[quality] = Q[quality] ? 1 : 0;
    }
    Q.government_burden_completed = [
        "government_goal_health",
        "government_goal_housing",
        "government_goal_labor",
        "government_goal_welfare",
        "government_goal_equality"
    ].reduce(function(total, quality) {
        return total + Q[quality];
    }, 0);
    if (typeof Q.government_burden_last_result != "string") {
        Q.government_burden_last_result = "No government record yet";
    }
    if (typeof Q.government_burden_last_goals != "string") {
        Q.government_burden_last_goals = "None";
    }
    if (
        !Q.left_in_government ||
        !Q.government_has_confidence ||
        Q.caretaker_government
    ) {
        Q.government_burden_active = 0;
        Q.government_burden_timer = 0;
        Q.government_burden_completed = 0;
        Q.government_burden_breached = 0;
        Q.government_burden_review_pending = 0;
        Q.government_goal_health = 0;
        Q.government_goal_housing = 0;
        Q.government_goal_labor = 0;
        Q.government_goal_welfare = 0;
        Q.government_goal_equality = 0;
    }

    Q.snap_campaign_active = Q.snap_campaign_active ? 1 : 0;
    Q.election_2027_terminal = Q.election_2027_terminal ? 1 : 0;
    Q.election_2027_campaign_open = Q.election_2027_campaign_open ? 1 : 0;
    if (!Number.isFinite(Number(Q.snap_campaign_start_time))) {
        Q.snap_campaign_start_time = -1;
    }
    if (!Number.isFinite(Number(Q.snap_campaign_due_time))) {
        Q.snap_campaign_due_time = -1;
    }
    if (!Number.isFinite(Number(Q.snap_campaign_left_bonus))) {
        Q.snap_campaign_left_bonus = 0;
    }
    if (typeof Q.snap_campaign_strategy != "string") {
        Q.snap_campaign_strategy = "No snap campaign";
    }
    if (typeof Q.election_2027_campaign_strategy != "string") {
        Q.election_2027_campaign_strategy = "No 2027 campaign line";
    }

    // Budget defeat scenes predate the constitutional scheduler. Record the
    // month in which they first request an election so the later event can
    // enforce the four-month presidential budget clock.
    if (Q.snap_election_requested) {
        if (
            !Number.isFinite(Number(Q.snap_election_request_time)) ||
            Number(Q.snap_election_request_time) < 0
        ) {
            Q.snap_election_request_time = Number(Q.time) || 0;
            Q.snap_election_request_year = Number(Q.year) || 0;
            Q.snap_election_request_month = Number(Q.month) || 0;
            Q.snap_event_deferred_time = -1;
        }
        if (
            (
                !Number.isFinite(Number(Q.budget_submission_time)) ||
                Number(Q.budget_submission_time) < 0
            ) &&
            String(Q.annual_budget_result || "")
                .toLowerCase()
                .includes("failed")
        ) {
            Q.budget_submission_time = Number(Q.time) || 0;
            Q.budget_submission_year = Number(Q.year) || 0;
            Q.budget_submission_month = Number(Q.month) || 0;
        }
        if (
            Number.isFinite(Number(Q.budget_submission_time))
        ) {
            Q.budget_deadline_time =
                Number(Q.budget_submission_time) + 4;
        }
    }
    if (Q.caretaker_government) {
        Q.left_role =
            Q.left_in_government || Q.ministry_count > 0
            ? "caretaker ministers, with new executive action frozen"
            : "outside the caretaker cabinet during formation or election talks";
    } else if (Q.left_in_government) {
        Q.left_role =
            "a governing coalition partner, with ministers and shared cabinet responsibility";
    } else if (
        String(Q.position || "").toLowerCase().includes("confidence")
    ) {
        Q.left_role =
            "supporting confidence votes from outside the cabinet";
    } else {
        Q.left_role =
            "in opposition, without ministers or control of public spending";
    }

    // Foreign policy is routed through the office Lewica actually holds.
    // A presidency and a caretaker cabinet are constitutional roles, not a
    // shortcut to routine cabinet command. Otherwise cabinet leadership and
    // MFA ownership remain separate.
    const confidenceSupply =
        String(Q.position || "").toLowerCase().includes("confidence");
    const leftHoldsMFA = Q.foreign_minister_party == "Lewica";
    Q.foreign_left_presidential_channel = Q.left_president ? 1 : 0;
    if (Q.caretaker_government) {
        Q.foreign_authority_role = "caretaker";
        Q.foreign_authority_label = "Caretaker";
        Q.foreign_authority_scope =
            "Continuity and consultation; irreversible commitments are deferred";
    } else if (!Q.left_in_government && confidenceSupply) {
        Q.foreign_authority_role = "confidence_opposition";
        Q.foreign_authority_label =
            "Confidence-and-supply opposition";
        Q.foreign_authority_scope =
            "Opposition diplomacy plus budget and confidence conditions for limited commitments";
    } else if (!Q.left_in_government) {
        Q.foreign_authority_role = "ordinary_opposition";
        Q.foreign_authority_label = "Ordinary opposition";
        Q.foreign_authority_scope =
            "Questions, committee motions, shadow doctrine, party diplomacy and public pressure";
    } else if (Q.government_party == "lewica" && leftHoldsMFA) {
        Q.foreign_authority_role = "lead_mfa";
        Q.foreign_authority_label =
            "Lead government holding Foreign Affairs";
        Q.foreign_authority_scope =
            "Full initiative, implementation and responsibility";
    } else if (Q.government_party == "lewica") {
        Q.foreign_authority_role = "lead_no_mfa";
        Q.foreign_authority_label =
            "Lead government without Foreign Affairs";
        Q.foreign_authority_scope =
            "Set cabinet strategy and direct the minister while managing the portfolio owner's resistance";
    } else if (leftHoldsMFA) {
        Q.foreign_authority_role = "junior_mfa";
        Q.foreign_authority_label =
            "Junior coalition holding Foreign Affairs";
        Q.foreign_authority_scope =
            "Operate the ministry within the prime minister's and coalition's mandate, with a risk of being overruled";
    } else {
        Q.foreign_authority_role = "junior_no_mfa";
        Q.foreign_authority_label =
            "Junior coalition without Foreign Affairs";
        Q.foreign_authority_scope =
            "Coalition-council demands, pressure on the minister, public dissent and traded support";
    }
    if (Q.foreign_left_presidential_channel) {
        Q.foreign_authority_label += " · Left President";
        Q.foreign_authority_scope +=
            "; the Palace separately adds representation, ratification, appointments and convening, but no cabinet command";
    }
    // Bargaining power combines political capacity with the government's need
    // for votes or cover. Pressure cards move negotiation capital directly;
    // coalition weakness and media access make those gains politically useful.
    const finitePolitical = function(value, fallback) {
        return Number.isFinite(Number(value)) ? Number(value) : fallback;
    };
    const economicCrisis =
        Math.max(0, finitePolitical(Q.inflation, 2.6) - 4) * 2.2 +
        Math.max(0, -finitePolitical(Q.economic_growth, 2)) * 6 +
        Math.max(0, finitePolitical(Q.unemployment, 5) - 7) * 2;
    const securityCrisis =
        finitePolitical(Q.war_escalation_risk, 0) * 0.34 +
        Math.max(
            0,
            finitePolitical(Q.national_security_salience, 48) - 55
        ) * 0.22 +
        Math.max(
            0,
            finitePolitical(Q.border_security_salience, 44) - 60
        ) * 0.18;
    const serviceCrisis =
        finitePolitical(Q.pandemic_deaths_pressure, 0) * 0.45 +
        Math.max(0, 45 - finitePolitical(Q.health_capacity, 48)) * 0.34 +
        Math.max(0, 42 - finitePolitical(Q.household_security, 45)) * 0.28;
    Q.national_crisis_pressure = Math.round(
        clamp(
            economicCrisis + securityCrisis + serviceCrisis +
                finitePolitical(Q.oath_crisis_pressure, 0),
            0,
            100
        )
    );
    const cohabitationPenalty =
        Q.government_party == "pis" &&
        Q.president_name == "Rafał Trzaskowski"
            ? 8
            : 0;
    const hostilityBase =
        Q.government_party == "pis" ? 76 :
        (Q.government_party == "ko" ? 36 :
        (Q.government_party == "psl" ? 43 :
        (Q.government_party == "p2050" ? 40 : 50)));
    const enemyFocusHostility =
        Q.poland_enemy_focus == "PiS" ? 6 :
        (Q.poland_enemy_focus == "the anti-democratic right" ? 3 :
        (Q.poland_enemy_focus == "the radical right" ? -2 :
        (Q.poland_enemy_focus == "the capitalist parties" ? -3 : 0)));
    Q.government_negotiation_hostility = Math.round(
        clamp(
            hostilityBase +
                cohabitationPenalty -
                (Q.government_party == "pis"
                    ? clamp(finitePolitical(
                        Q.pis_negotiation_hostility_relief, 0
                    ), -20, 40)
                    : 0) -
                finitePolitical(Q.negotiation_successes, 0) * 2 +
                (Q.government_party == "pis" ? enemyFocusHostility : 0),
            10,
            95
        )
    );
    const governmentRelation =
        Q.government_party == "pis"
            ? finitePolitical(Q.pis_relation, 8)
            : (Q.government_party == "ko"
                ? finitePolitical(Q.ko_relation, 44)
                : (Q.government_party == "psl"
                    ? finitePolitical(Q.psl_relation, 24)
                    : finitePolitical(Q.p2050_relation, 20)));
    const statutoryMajority = Math.max(
        1,
        finitePolitical(Q.sejm_statutory_majority, 231)
    );
    const governmentMargin =
        finitePolitical(Q.government_support_seats, statutoryMajority) -
        statutoryMajority;
    const leftVoteWeight = clamp(
        finitePolitical(Q.left_seats, 0) / 50,
        0,
        1.2
    );
    const parliamentaryNeed = clamp(
        14 - Math.max(0, governmentMargin) * 1.2 +
            Math.max(0, -governmentMargin) * 1.5 +
            Math.max(
                0,
                finitePolitical(Q.government_coalition_dissent, 0) - 10
            ) * 0.2,
        0,
        24
    ) * leftVoteWeight;
    const earnedGovernmentFavors = clamp(
        finitePolitical(Q.government_favors, 0) * 4,
        0,
        8
    );
    const negotiationCapital = clamp(
        finitePolitical(Q.negotiation_capital, 0),
        -20,
        30
    );
    Q.negotiation_capital = negotiationCapital;
    const palaceMediation =
        Q.president_name == "Rafał Trzaskowski" ? 14 :
        (finitePolitical(Q.president_relation, 18) >= 55 ? 5 : 0);
    Q.negotiation_leverage = Math.round(
        clamp(
            parliamentaryNeed + earnedGovernmentFavors +
                finitePolitical(Q.public_trust, 43) * 0.12 +
                finitePolitical(Q.labor_credibility, 46) * 0.08 +
                finitePolitical(Q.local_network, 42) * 0.04 +
                finitePolitical(Q.media_access, 31) * 0.06 +
                governmentRelation * 0.08 +
                Q.national_crisis_pressure * 0.28 +
                palaceMediation +
                negotiationCapital -
                Q.government_negotiation_hostility * 0.09,
            0,
            100
        )
    );
    if (
        Q.government_party == "pis" &&
        Q.national_crisis_pressure < 25 &&
        Q.negotiation_leverage < 24
    ) {
        Q.negotiation_forecast =
            "PiS can govern without us; build leverage through scrutiny, TVP or its social fault line";
    } else if (
        Q.government_party == "pis" &&
        Q.national_crisis_pressure < 25
    ) {
        Q.negotiation_forecast =
            "Public pressure can now force a bounded concession, though PiS still rejects a broad pact";
    } else if (
        Q.government_party == "pis" &&
        Q.president_name == "Rafał Trzaskowski" &&
        Q.national_crisis_pressure >= 25
    ) {
        Q.negotiation_forecast =
            "The crisis opens a path through President Trzaskowski, but only for a concrete deal";
    } else if (
        Q.government_party == "pis" &&
        Q.national_crisis_pressure >= 25
    ) {
        Q.negotiation_forecast =
            "The crisis has made PiS listen, though it will demand votes and shared blame";
    } else if (Q.government_party == "ko") {
        Q.negotiation_forecast =
            "The democratic cabinet will take the call, but every concession still needs votes";
    } else {
        Q.negotiation_forecast =
            "The cabinet is willing to trade, and will price every opposition vote";
    }

    Q.party_unity = clamp(Q.party_unity, 0, 100);
    Q.left_poll = Math.round(clamp(Q.left_poll, 0, 52) * 10) / 10;
    Q.resources = Number.isFinite(Number(Q.resources))
        ? Math.max(0, Number(Q.resources))
        : 0;
    Q.member_dues = Number.isFinite(Number(Q.member_dues))
        ? Math.max(1, Math.min(5, Math.round(Number(Q.member_dues))))
        : 2;
    Q.seat_subvention_seats = Number.isFinite(Number(Q.left_seats))
        ? Math.max(0, Math.round(Number(Q.left_seats)))
        : 0;
    Q.seat_subvention = Q.seat_subvention_seats > 0
        ? Math.max(1, Math.round(Q.seat_subvention_seats / 25))
        : 0;
    Q.party_income = Q.member_dues + Q.seat_subvention;
    Q.last_dues_payout = Number.isFinite(Number(Q.last_dues_payout))
        ? Math.max(0, Number(Q.last_dues_payout))
        : 0;
    Q.last_subvention_payout =
        Number.isFinite(Number(Q.last_subvention_payout))
            ? Math.max(0, Number(Q.last_subvention_payout))
            : 0;
    Q.last_annual_payout = Number.isFinite(Number(Q.last_annual_payout))
        ? Math.max(0, Number(Q.last_annual_payout))
        : 0;
    Q.last_midyear_resource_restore_year = Number.isFinite(
        Number(Q.last_midyear_resource_restore_year)
    )
        ? Math.round(Number(Q.last_midyear_resource_restore_year))
        : (Number(Q.month) >= 7 ? Number(Q.year) : Number(Q.year) - 1);
    Q.budget = Number.isFinite(Number(Q.budget))
        ? Number(Q.budget)
        : 0;
    Q.fiscal_stress = Number.isFinite(Number(Q.fiscal_stress))
        ? Math.max(0, Number(Q.fiscal_stress))
        : 0;
    Q.public_trust = clamp(Q.public_trust, 0, 100);
    Q.government_delivery = clamp(Q.government_delivery, 0, 100);
    Q.pis_poll = Math.round(clamp(Q.pis_poll, 0, 60) * 10) / 10;
    Q.ko_poll = Math.round(clamp(Q.ko_poll, 0, 60) * 10) / 10;
    Q.psl_poll = Math.round(clamp(Q.psl_poll, 0, 40) * 10) / 10;
    Q.konf_poll = Math.round(clamp(Q.konf_poll, 0, 40) * 10) / 10;
    Q.p2050_poll = Math.round(clamp(Q.p2050_poll, 0, 40) * 10) / 10;
    Q.p0_poll = Math.round(clamp(Q.p0_poll, 0, 30) * 10) / 10;
    Q.other_poll = Math.round(clamp(Q.other_poll, 0, 40) * 10) / 10;
    const pollNumbers = [
        "left_vote_intent",
        "pis_vote_intent",
        "ko_vote_intent",
        "psl_vote_intent",
        "konf_vote_intent",
        "p2050_vote_intent",
        "p0_vote_intent",
        "other_vote_intent"
    ];
    for (const quality of pollNumbers) {
        // Intentions remain full-precision simulation state. Only the published
        // poll is rounded; rounding every party here can destroy the exact
        // 100-point conservation established by the electorate model.
        Q[quality] = clamp(Q[quality], 0, 100);
    }
    const pollStateNumbers = [
        "left_poll_momentum",
        "pis_poll_momentum",
        "ko_poll_momentum",
        "psl_poll_momentum",
        "konf_poll_momentum",
        "p2050_poll_momentum",
        "p0_poll_momentum",
        "other_poll_momentum",
        "poll_calibration_left",
        "poll_calibration_pis",
        "poll_calibration_ko",
        "poll_calibration_psl",
        "poll_calibration_konf",
        "poll_calibration_p2050",
        "poll_calibration_p0",
        "poll_calibration_other"
    ];
    for (const quality of pollStateNumbers) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? Number(Q[quality])
            : 0;
    }
    const projectedSeats = [
        "left_projected_seats",
        "pis_projected_seats",
        "ko_projected_seats",
        "psl_projected_seats",
        "konf_projected_seats",
        "p2050_projected_seats",
        "p0_projected_seats",
        "other_projected_seats"
    ];
    for (const quality of projectedSeats) {
        Q[quality] = Math.round(clamp(Q[quality], 0, 460));
    }
    Q.poll_sample_size = Math.round(clamp(Q.poll_sample_size, 100, 100000));
    Q.poll_margin_error = clamp(Q.poll_margin_error, 0, 20);
    Q.poll_danger_months = Math.round(clamp(Q.poll_danger_months, 0, 120));
    if (!Array.isArray(Q.voter_groups)) {
