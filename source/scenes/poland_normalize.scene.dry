    Q.sld_populist_route_active =
        Number(Q.sld_populist_route_active) === 1 &&
        Q.old_left_route_state === "miller_restoration" &&
        Number(Q.miller_restoration_done) === 1 ? 1 : 0;
    Q.sld_populist_entry_pending =
        Q.old_left_route_state === "miller_restoration" &&
        Number(Q.miller_restoration_done) === 1 &&
        !Q.sld_populist_entry_done && !Q.sld_populist_route_active ? 1 : 0;
    const sldPopulistOrientations = [
        "none", "unsettled", "konfederacja", "pis", "independent",
