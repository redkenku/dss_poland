    Q.psl_relation = clamp(Q.psl_relation, 0, 100);
    Q.p2050_relation = clamp(Q.p2050_relation, 0, 100);
    Q.pis_relation = clamp(Q.pis_relation, 0, 100);
    Q.konf_relation = clamp(Q.konf_relation, 0, 100);
    Q.president_relation = clamp(Q.president_relation, 0, 100);

    Q.judicial_legitimacy = clamp(Q.judicial_legitimacy, 0, 100);
    Q.constitutional_restraint = clamp(Q.constitutional_restraint, 0, 100);
    for (const judicialQuality of [
