        slateSettled >= slatePicked
    ) {
        Q.major_reforms_complete = 1;
        // The reward scales with how far the chosen settlements actually went.
        // Three token compromises are not the same achievement as three
        // maximal laws.
        const closingScale = Math.max(0.4, Math.min(1.6, slateWeight / 7.5));
        Q.left_poll += 2 * closingScale;
        Q.public_trust += Math.round(4 * closingScale);
        Q.winner_reputation += Math.round(5 * closingScale);
        Q.issue_ownership += Math.round(5 * closingScale);
        for (const group of [
            "metropolitan_liberals", "liberal_professionals",
            "public_service_families", "industrial_logistics",
            "provincial_welfare", "rural_localists",
            "older_welfare_households", "anti_establishment_youth"
        ]) {
            const affinityKey = group + "_left_affinity";
            Q[affinityKey] =
                (Number(Q[affinityKey]) || 0) + 2 * closingScale;
        }
        Q.news_headline = slateWeight >= 10
            ? "Lewica closes its whole reform programme on its own terms"
            : "Lewica closes its reform programme on compromise settlements";
    }

    // New project enactments also satisfy the older dated-chain flags. This
    // is deliberately monotonic: a later historical callback may never veto
    // or downgrade a stronger law the player has already enacted.
    if (Q.abortion_reform_stage >= 1) {
