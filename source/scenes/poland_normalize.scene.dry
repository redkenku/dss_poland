            "liberal_professionals",
            "public_service_families",
            "industrial_logistics",
            "provincial_welfare",
            "rural_localists",
            "older_welfare_households",
            "anti_establishment_youth"
        ];
    }
    for (const group of Q.voter_groups) {
        Q[group + "_size"] = clamp(Q[group + "_size"], 0, 100);
        Q[group + "_turnout"] = clamp(Q[group + "_turnout"], 0, 100);
        Q[group + "_margin"] = clamp(Q[group + "_margin"], 0, 100);
        for (const party of [
            "left", "pis", "ko", "psl", "konf", "p2050", "p0", "other"
