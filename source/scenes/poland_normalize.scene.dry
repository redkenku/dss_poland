    Q.household_security = clamp(Q.household_security, 0, 100);
    Q.health_capacity = clamp(Q.health_capacity, 0, 100);
    Q.police_trust = clamp(Q.police_trust, 0, 100);
    Q.military_trust = clamp(Q.military_trust, 0, 100);
    Q.border_security_confidence =
        clamp(Q.border_security_confidence, 0, 100);
    Q.minority_safety = clamp(Q.minority_safety, 0, 100);
    Q.far_right_agenda = clamp(Q.far_right_agenda, 0, 100);
    Q.republika_capacity = clamp(Q.republika_capacity, 0, 100);
    Q.kanal_zero_capacity = clamp(Q.kanal_zero_capacity, 0, 100);
    Q.border_rights_standard = clamp(Q.border_rights_standard, 0, 100);
    Q.refugee_empathy = clamp(Q.refugee_empathy, 0, 100);
    Q.anti_ukrainian_pressure =
        clamp(Q.anti_ukrainian_pressure, 0, 100);
    Q.movement_autonomy = clamp(Q.movement_autonomy, 0, 100);
    Q.organiser_energy = clamp(Q.organiser_energy, 0, 100);
    Q.pandemic_deaths_pressure =
        clamp(Q.pandemic_deaths_pressure, 0, 100);

    // Phase-three attitudes are deliberately orthogonal. Old saves acquire
    // the 2019 electorate at their current date without inferring any of
    // these values from Lewica's poll or from social-spending support.
    const latentAttitudeDefaults = {
        capitalism_acceptance: 64,
        welfare_expectation: 76,
        cultural_conservatism: 63,
        order_threat_sensitivity: 57,
        universal_solidarity: 52,
        institutional_trust: 44,
        change_appetite: 56
    };
    Q.latent_attitudes = Object.keys(latentAttitudeDefaults);
    for (const attitude of Q.latent_attitudes) {
        if (!Number.isFinite(Number(Q[attitude]))) {
            Q[attitude] = latentAttitudeDefaults[attitude];
        }
        Q[attitude] = clamp(Q[attitude], 0, 100);
    }
    Q.latent_attitudes_version = Math.max(
        1,
        Math.round(Number(Q.latent_attitudes_version) || 1)
    );

    const historicalPressureDefaults = {
        electoral_viability: Q.scenario_mode == "formation_2023" ? 50 : 62,
        winner_reputation: Q.scenario_mode == "formation_2023" ? 38 : 54,
        issue_ownership: Q.scenario_mode == "formation_2023" ? 36 : 42,
        leadership_authority: Q.scenario_mode == "formation_2023" ? 43 : 53,
        coalition_blur: Q.scenario_mode == "formation_2023" ? 14 : 8,
        media_access: Q.scenario_mode == "formation_2023" ? 27 : 31,
        list_confidence: Q.scenario_mode == "formation_2023" ? 49 : 61
    };
    for (const quality of Object.keys(historicalPressureDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = historicalPressureDefaults[quality];
        }
        Q[quality] = clamp(Q[quality], 0, 100);
    }
    for (const quality of [
        "tactical_desertion_to_ko",
        "tactical_desertion_to_abstention",
        "tactical_desertion_to_p2050"
    ]) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? clamp(Q[quality], 0, 100)
            : 0;
    }
    Q.historical_pressure_version = Math.max(
        1,
        Math.round(Number(Q.historical_pressure_version) || 1)
    );
    if (
        typeof Q.historical_pressure_last !== "string" ||
        !Q.historical_pressure_last.length
    ) {
        Q.historical_pressure_last =
            "2019 unity cleared the threshold and returned the Left to the Sejm";
    }
    const historicalBenchmarks = {
        historical_benchmark_2019: 12.56,
        historical_benchmark_2020: 2.22,
        historical_benchmark_2023: 8.61,
        historical_benchmark_2025_biejat: 4.23,
        historical_benchmark_2025_zandberg: 4.86
    };
    for (const quality of Object.keys(historicalBenchmarks)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = historicalBenchmarks[quality];
        }
    }

    const trajectoryDefaults = {
        womens_strike_activist_mobilisation: 0,
        womens_strike_public_sympathy: 49,
        womens_strike_party_conversion: 0,
        womens_strike_conservative_backlash: 24,
        migration_empathy: Number.isFinite(Number(Q.refugee_empathy))
            ? Number(Q.refugee_empathy) : 58,
        migration_border_competence:
            Number.isFinite(Number(Q.border_security_confidence))
                ? Number(Q.border_security_confidence) : 48,
        migration_local_service_capacity: 28,
        migration_welfare_competition: 24,
        migration_disinformation: 27
    };
    for (const quality of Object.keys(trajectoryDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = trajectoryDefaults[quality];
        }
        Q[quality] = clamp(Q[quality], 0, 100);
    }

    if (!Array.isArray(Q.story_queue)) {
        Q.story_queue = [];
    }
    for (const quality of [
        "story_last_reach",
        "story_last_audience_trust",
        "story_last_messenger_credibility",
        "story_last_issue_salience",
        "story_last_left_credibility",
        "story_persuasion",
        "story_backlash",
        "story_salience_memory",
        "story_distrust_memory",
        "story_backlash_memory",
        "story_reputation_memory"
    ]) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? clamp(Q[quality], 0, 100)
            : 0;
    }
    for (const quality of [
        "story_last_frame",
        "story_last_signal",
        "story_mobilisation",
        "story_abstention",
        "story_issue_ownership"
    ]) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? clamp(Q[quality], -100, 100)
            : 0;
    }
    Q.story_contest_version = Math.max(
        1,
        Math.round(Number(Q.story_contest_version) || 1)
    );
    if (typeof Q.story_last_title !== "string") {
        Q.story_last_title = "No important story tested";
    }
    if (typeof Q.story_last_issue !== "string") {
        Q.story_last_issue = "None";
    }

    // Public-opinion migration. These defaults are used only when an old save
    // predates the issue model; authored event and card shifts are never
    // replaced once a track exists.
    const publicOpinionDefaults = {
        abortion_rights: [49, 42, 58],
        refugee_solidarity: [
            Number.isFinite(Number(Q.refugee_empathy))
                ? Number(Q.refugee_empathy)
                : 38,
            Q.border_2021_event_done ? 68 : 34,
            Q.border_2021_event_done ? 72 : 58
        ],
        border_security: [
            Number.isFinite(Number(Q.border_security_confidence))
                ? Math.max(55, Number(Q.border_security_confidence))
                : 70,
            Q.border_2021_event_done ? 76 : 44,
            Q.border_2021_event_done ? 60 : 36
        ],
        vaccination: [
            Q.vaccine_event_done ? 68 : 76,
            Q.vaccine_event_done ? 62 : 24,
            Q.vaccine_event_done ? 54 : 27
        ],
        social_spending: [72, 67, 38],
        lgbt_equality: [48, 52, 62],
        secular_state: [52, 43, 58],
        rule_of_law: [
            Number.isFinite(Number(Q.judicial_repair_mandate))
                ? Math.max(45, Number(Q.judicial_repair_mandate))
                : 58,
            56,
            52
        ],
        national_security: [
            Number.isFinite(Number(Q.military_trust))
                ? Math.max(60, Number(Q.military_trust))
                : 74,
            Q.ukraine_invasion_event_done ? 78 : 48,
            Q.ukraine_invasion_event_done ? 46 : 34
        ]
    };
    const publicOpinionIssues = Object.keys(publicOpinionDefaults);
    if (!Array.isArray(Q.public_opinion_issues)) {
        Q.public_opinion_issues = publicOpinionIssues.slice();
    } else {
        for (const issue of publicOpinionIssues) {
            if (!Q.public_opinion_issues.includes(issue)) {
                Q.public_opinion_issues.push(issue);
            }
        }
    }
    for (const issue of publicOpinionIssues) {
        const defaults = publicOpinionDefaults[issue];
        for (const measure of [
            ["support", defaults[0]],
            ["salience", defaults[1]],
            ["backlash", defaults[2]]
        ]) {
            const quality = issue + "_" + measure[0];
            if (!Number.isFinite(Number(Q[quality]))) {
                Q[quality] = measure[1];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
        const ownershipQuality = issue + "_left_ownership";
        if (!Number.isFinite(Number(Q[ownershipQuality]))) {
            Q[ownershipQuality] = Number(Q.issue_ownership) || 35;
        }
        Q[ownershipQuality] = clamp(Q[ownershipQuality], 0, 100);
    }
    Q.public_opinion_version = Math.max(
        2,
        Math.round(Number(Q.public_opinion_version) || 2)
    );
    let publicPanicTotal = 0;
    let publicConsensusTotal = 0;
    let hottestPublicIssue = publicOpinionIssues[0];
    let hottestPublicIssueScore = -1;
    const publicIssueLabels = {
        abortion_rights: "Abortion rights",
        refugee_solidarity: "Refugees and asylum solidarity",
        border_security: "Eastern-border security",
        vaccination: "Vaccination and public health",
        social_spending: "Social spending and public services",
        lgbt_equality: "LGBT equality",
        secular_state: "Secular state and schools",
        rule_of_law: "Rule-of-law repair",
        national_security: "Defence and allied security"
    };
    for (const issue of publicOpinionIssues) {
        const support = Number(Q[issue + "_support"]);
        const salience = Number(Q[issue + "_salience"]);
        const backlash = Number(Q[issue + "_backlash"]);
        const heat = salience * 0.65 + backlash * 0.35;
        publicPanicTotal += heat;
        publicConsensusTotal +=
            Math.abs(support - 50) * 2 * (1 - backlash / 200);
        if (heat > hottestPublicIssueScore) {
            hottestPublicIssueScore = heat;
            hottestPublicIssue = issue;
        }
    }
    Q.public_panic_index = Math.round(
        publicPanicTotal / publicOpinionIssues.length
    );
    Q.public_consensus_index = Math.round(
        publicConsensusTotal / publicOpinionIssues.length
    );
    Q.public_opinion_hottest_issue =
        publicIssueLabels[hottestPublicIssue];
    Q.public_opinion_last_delta = Number.isFinite(
        Number(Q.public_opinion_last_delta)
    )
        ? Number(Q.public_opinion_last_delta)
        : 0;
    Q.public_opinion_bridge_pressure = Number.isFinite(
        Number(Q.public_opinion_bridge_pressure)
    )
        ? clamp(Q.public_opinion_bridge_pressure, 0, 100)
        : 0;
    if (
        typeof Q.public_opinion_hottest_issue !== "string" ||
        !Q.public_opinion_hottest_issue.length
    ) {
        Q.public_opinion_hottest_issue =
            "Social spending and public services";
    }
    if (
        typeof Q.public_opinion_last_issue !== "string" ||
        !Q.public_opinion_last_issue.length
    ) {
        Q.public_opinion_last_issue = "None";
    }
    if (
        typeof Q.public_opinion_last_reception !== "string" ||
        !Q.public_opinion_last_reception.length
    ) {
        Q.public_opinion_last_reception = "No recent test";
    }
    if (
        typeof Q.public_opinion_last_action !== "string" ||
        !Q.public_opinion_last_action.length
    ) {
        Q.public_opinion_last_action = "No public-opinion test yet";
    }
    if (
        typeof Q.public_opinion_last_updated !== "string" ||
        !Q.public_opinion_last_updated.length
    ) {
        Q.public_opinion_last_updated =
            (Q.date_label || "Current month") + " model";
    }
    if (
        !["breakthrough", "favourable", "contested", "backlash", "reversal"]
            .includes(Q.card_public_response)
    ) {
        Q.card_public_response = "contested";
    }
    Q.card_public_response_score = Number.isFinite(
        Number(Q.card_public_response_score)
    )
        ? clamp(Q.card_public_response_score, -3, 3)
        : 0;
    const publicBridgeSources = {
        feminist_trust: 44,
        refugee_empathy: 58,
        border_confidence: 48,
        border_rights: 45,
        far_right_agenda: 32,
        minority_safety: 56,
        household_security: 45,
        health_capacity: 48,
        pandemic_pressure: 0,
        anti_ukrainian: 8,
        judicial_legitimacy: 36,
        repair_mandate: 38,
        military_trust: 66,
        police_trust: 45,
        refugee_services: 0
    };
    const publicBridgeCurrent = {
        feminist_trust: Q.feminist_trust,
        refugee_empathy: Q.refugee_empathy,
        border_confidence: Q.border_security_confidence,
        border_rights: Q.border_rights_standard,
        far_right_agenda: Q.far_right_agenda,
        minority_safety: Q.minority_safety,
        household_security: Q.household_security,
        health_capacity: Q.health_capacity,
        pandemic_pressure: Q.pandemic_deaths_pressure,
        anti_ukrainian: Q.anti_ukrainian_pressure,
        judicial_legitimacy: Q.judicial_legitimacy,
        repair_mandate: Q.judicial_repair_mandate,
        military_trust: Q.military_trust,
        police_trust: Q.police_trust,
        refugee_services: Q.refugee_service_capacity
    };
    if (!Number(Q.public_bridge_initialized)) {
        // Begin observing an old save at its current state. This prevents a
        // migration from replaying years of historical changes as one shock.
        for (const bridge of Object.keys(publicBridgeSources)) {
            const current = Number(publicBridgeCurrent[bridge]);
            Q["public_bridge_" + bridge] = Number.isFinite(current)
                ? current
                : publicBridgeSources[bridge];
        }
        Q.public_bridge_initialized = 1;
    } else {
        for (const bridge of Object.keys(publicBridgeSources)) {
            const quality = "public_bridge_" + bridge;
            if (!Number.isFinite(Number(Q[quality]))) {
                const current = Number(publicBridgeCurrent[bridge]);
                Q[quality] = Number.isFinite(current)
                    ? current
                    : publicBridgeSources[bridge];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
    }

    Q.workers_support = clamp(Q.workers_support, 0, 100);
    Q.public_sector_support = clamp(Q.public_sector_support, 0, 100);
    Q.young_support = clamp(Q.young_support, 0, 100);
    Q.women_support = clamp(Q.women_support, 0, 100);
    Q.urban_progressive_support =
        clamp(Q.urban_progressive_support, 0, 100);
    Q.rural_support = clamp(Q.rural_support, 0, 100);
    Q.pensioner_support = clamp(Q.pensioner_support, 0, 100);
    Q.turnout_readiness = clamp(Q.turnout_readiness, 0, 100);

    const foreignNumericDefaults = {
        eu_campaign_progress: 0,
        eu_campaign_complete: 0,
        eu_brussels_mission: 0,
        eu_social_mission: 0,
        eu_eastern_mission: 0,
        eu_triangle_mission: 0,
        eu_influence: 28,
        eu_institutional_trust: 26,
        eu_left_network: 20,
        eu_eastern_coalition: 24,
        germany_relation: 38,
        france_relation: 32,
        foreign_pressure: 18,
        foreign_cards_resolved: 0,
        foreign_ministry_override_risk: 0,
        foreign_portfolio_resistance: 0,
        foreign_policy_responsibility: 0,
        us_alliance_reliability: 48,
        us_rule_of_law_pressure: 12,
        us_ambassador_channel: 44,
        us_defence_channel: 62,
        us_congress_channel: 40,
        left_atlanticist_dissent: 10,
        us_election_2020_done: Q.year > 2020 ? 1 : 0,
        us_2020_roll: 0,
        us_2020_democratic_vote: Q.year > 2020 ? 51.3 : 0,
        us_2020_republican_vote: Q.year > 2020 ? 48.7 : 0,
        us_election_2024_done: Q.year > 2024 ? 1 : 0,
        us_2024_roll: 0,
        us_2024_democratic_vote: Q.year > 2024 ? 48.4 : 0,
        us_2024_republican_vote: Q.year > 2024 ? 51.6 : 0
    };
    for (const quality of Object.keys(foreignNumericDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = foreignNumericDefaults[quality];
        }
    }
    const foreignMissionFlags = [
        "eu_campaign_complete",
        "eu_brussels_mission",
        "eu_social_mission",
        "eu_eastern_mission",
        "eu_triangle_mission",
        "us_election_2020_done",
        "us_election_2024_done"
    ];
    for (const flag of foreignMissionFlags) {
        Q[flag] = Q[flag] ? 1 : 0;
    }
    Q.eu_campaign_progress = Math.max(
        Number(Q.eu_campaign_progress) || 0,
        Q.eu_brussels_mission +
            Q.eu_social_mission +
            Q.eu_eastern_mission +
            Q.eu_triangle_mission
    );
    Q.eu_campaign_progress = Math.max(
        0,
        Math.min(4, Math.round(Q.eu_campaign_progress))
    );
    Q.eu_influence = clamp(Q.eu_influence, 0, 100);
    Q.eu_institutional_trust =
        clamp(Q.eu_institutional_trust, 0, 100);
    Q.eu_left_network = clamp(Q.eu_left_network, 0, 100);
    Q.eu_eastern_coalition = clamp(Q.eu_eastern_coalition, 0, 100);
    Q.germany_relation = clamp(Q.germany_relation, 0, 100);
    Q.france_relation = clamp(Q.france_relation, 0, 100);
    Q.foreign_pressure = clamp(Q.foreign_pressure, 0, 100);
    Q.foreign_cards_resolved = Math.max(
        0,
        Math.round(Q.foreign_cards_resolved)
    );
    Q.foreign_ministry_override_risk = clamp(
        Q.foreign_ministry_override_risk,
        0,
        100
    );
    Q.foreign_portfolio_resistance = clamp(
        Q.foreign_portfolio_resistance,
        0,
        100
    );
    Q.foreign_policy_responsibility = clamp(
        Q.foreign_policy_responsibility,
        0,
        100
    );
    Q.us_alliance_reliability =
        clamp(Q.us_alliance_reliability, 0, 100);
    Q.us_rule_of_law_pressure =
        clamp(Q.us_rule_of_law_pressure, 0, 100);
    Q.us_ambassador_channel = clamp(Q.us_ambassador_channel, 0, 100);
    Q.us_defence_channel = clamp(Q.us_defence_channel, 0, 100);
    Q.us_congress_channel = clamp(Q.us_congress_channel, 0, 100);
    Q.left_atlanticist_dissent =
        clamp(Q.left_atlanticist_dissent, 0, 100);
    Q.us_2020_roll = clamp(Q.us_2020_roll, 0, 1);
    Q.us_2024_roll = clamp(Q.us_2024_roll, 0, 1);
    Q.us_2020_democratic_vote =
        clamp(Q.us_2020_democratic_vote, 0, 100);
    Q.us_2020_republican_vote =
        clamp(Q.us_2020_republican_vote, 0, 100);
    Q.us_2024_democratic_vote =
        clamp(Q.us_2024_democratic_vote, 0, 100);
    Q.us_2024_republican_vote =
        clamp(Q.us_2024_republican_vote, 0, 100);
    if (
        typeof Q.us_election_2020_winner !== "string" ||
        !Q.us_election_2020_winner.length
    ) {
        Q.us_election_2020_winner =
            Q.year > 2020 ? "Joe Biden" : "Undecided";
    }
    if (
        typeof Q.us_election_2024_winner !== "string" ||
        !Q.us_election_2024_winner.length
    ) {
        Q.us_election_2024_winner =
            Q.year > 2024 ? "Donald Trump" : "Undecided";
    }
    if (
        typeof Q.us_2024_republican_candidate !== "string" ||
        !Q.us_2024_republican_candidate.length
    ) {
        Q.us_2024_republican_candidate =
            Q.us_election_2020_winner == "Donald Trump"
                ? "Republican successor"
                : "Donald Trump";
    }
    if (
        typeof Q.us_president !== "string" ||
        !Q.us_president.length
    ) {
        Q.us_president = Q.year > 2024
            ? Q.us_election_2024_winner
            : (Q.year > 2020 ? Q.us_election_2020_winner : "Donald Trump");
    }
    if (
        typeof Q.us_administration !== "string" ||
        !Q.us_administration.length
    ) {
        Q.us_administration =
            Q.us_president == "Joe Biden" ||
            Q.us_president == "Kamala Harris"
                ? "Democratic"
                : "America First";
    }
    if (Q.eu_campaign_complete) {
        Q.eu_campaign_stage =
            "Warsaw compact — social security, democratic law and eastern defence";
    } else if (Q.eu_campaign_progress >= 3) {
        Q.eu_campaign_stage =
            "Compact available — three European missions completed";
    } else if (Q.eu_campaign_progress == 2) {
        Q.eu_campaign_stage =
            "Coalition building — two European missions completed";
    } else if (Q.eu_campaign_progress == 1) {
        Q.eu_campaign_stage =
            "First permanent European channel";
    } else {
        Q.eu_campaign_stage = "Opening contacts";
    }

    Q.economic_growth = clamp(Q.economic_growth, -20, 20);
    Q.inflation = clamp(Q.inflation, -5, 40);
    Q.unemployment = clamp(Q.unemployment, 0, 40);
    Q.public_debt = clamp(Q.public_debt, 0, 150);
    Q.budget_balance = clamp(Q.budget_balance, -30, 20);

    Q.presidential_result = clamp(Q.presidential_result, 0, 100);
    Q.budget_promises = Math.max(0, Q.budget_promises);
    Q.budget_breaches = Math.max(0, Q.budget_breaches);
    Q.roundtable_cooldown = Math.max(0, Q.roundtable_cooldown);
    Q.hostile_interview_cooldown =
        Math.max(0, Q.hostile_interview_cooldown);
    Q.razem_guarantee_cooldown =
        Math.max(0, Q.razem_guarantee_cooldown);
    Q.advisor_action_timer = Math.max(0, Q.advisor_action_timer || 0);
    Q.leadership_reshuffle_timer =
        Math.max(0, Q.leadership_reshuffle_timer || 0);
    for (const cabinetTimer of [
        "poland_labor_inspection_timer",
        "poland_housing_fund_timer",
        "poland_equality_bill_timer",
        "poland_health_compact_timer",
        "poland_digital_state_timer",
        "poland_science_compact_timer",
        "poland_internal_security_timer",
        "poland_fiscal_policy_timer",
        "poland_economic_programme_timer",
        "poland_justice_repair_timer",
        "poland_foreign_ministry_line_timer",
        "poland_agricultural_bargain_timer",
        "poland_defence_policy_timer",
        "poland_cabinet_reshuffle_timer",
        "poland_coalition_council_timer",
        "poland_social_welfare_review_timer"
    ]) {
        Q[cabinetTimer] = Math.max(
            0,
            Number(Q[cabinetTimer]) || 0
        );
    }
    Q.poland_fundraising_timer =
        Math.max(0, Q.poland_fundraising_timer || 0);
    Q.poland_campaigning_timer =
        Math.max(0, Q.poland_campaigning_timer || 0);
    Q.poland_rally_timer =
        Math.max(0, Q.poland_rally_timer || 0);
    Q.poland_crisis_compact_timer =
        Math.max(0, Q.poland_crisis_compact_timer || 0);
    Q.poland_oversight_bargain_timer =
        Math.max(0, Q.poland_oversight_bargain_timer || 0);
    Q.poland_palace_mediation_timer =
        Math.max(0, Q.poland_palace_mediation_timer || 0);
    Q.poland_european_campaign_timer =
        Math.max(0, Q.poland_european_campaign_timer || 0);
    Q.poland_brussels_pressure_timer =
        Math.max(0, Q.poland_brussels_pressure_timer || 0);
    Q.poland_berlin_pressure_timer =
        Math.max(0, Q.poland_berlin_pressure_timer || 0);
    Q.poland_eastern_flank_timer =
        Math.max(0, Q.poland_eastern_flank_timer || 0);
    Q.poland_white_house_pressure_timer =
        Math.max(0, Q.poland_white_house_pressure_timer || 0);
    Q.poland_european_right_timer =
        Math.max(0, Q.poland_european_right_timer || 0);
    Q.emergency_fundraising_timer =
        Math.max(0, Q.emergency_fundraising_timer || 0);
    Q.negotiation_capital = Number.isFinite(Number(Q.negotiation_capital))
        ? clamp(Q.negotiation_capital, -20, 30)
        : 0;
    Q.negotiation_attempts =
        Math.max(0, Math.round(Number(Q.negotiation_attempts) || 0));
    Q.negotiation_successes =
        Math.max(0, Math.round(Number(Q.negotiation_successes) || 0));
    Q.negotiation_last_score = Number.isFinite(
        Number(Q.negotiation_last_score)
    ) ? clamp(Q.negotiation_last_score, 0, 100) : 0;
    Q.negotiation_last_threshold = Number.isFinite(
        Number(Q.negotiation_last_threshold)
    ) ? clamp(Q.negotiation_last_threshold, 0, 100) : 0;
    Q.pis_cohabitation_stress = Number.isFinite(
        Number(Q.pis_cohabitation_stress)
    ) ? clamp(Q.pis_cohabitation_stress, 0, 100) : 0;
    Q.pis_cohabitation_rally = Number.isFinite(
        Number(Q.pis_cohabitation_rally)
    ) ? clamp(Q.pis_cohabitation_rally, 0, 100) : 0;
    Q.pis_cohabitation_last_shift = Number.isFinite(
        Number(Q.pis_cohabitation_last_shift)
    ) ? clamp(Q.pis_cohabitation_last_shift, -20, 20) : 0;
    const advisorRoster = [
        "czarzasty",
        "biedron",
        "zandberg",
        "dziemianowicz_bak",
        "zukowska",
        "kotula",
        "biejat",
        "wieczorek",
        "gawkowski",
        "nowicka",
        "zawisza",
        "matysiak"
    ];
    Q.n_advisors = advisorRoster.reduce(function(total, advisor) {
        return total +
            (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
    }, 0);
    const advisorCaucuses = {
        barons: ["czarzasty", "wieczorek"],
        spring: Q.spring_active ? ["biedron"] : [],
        labor: ["dziemianowicz_bak"],
        progressives: [
            "zukowska", "kotula", "gawkowski", "nowicka"
        ].concat(Q.spring_active ? [] : ["biedron"]),
        razem: ["zandberg", "biejat", "zawisza", "matysiak"],
        pps: []
    };
    for (const faction of Q.factions) {
        const caucusRoster = advisorCaucuses[faction] || [];
        Q[faction + "_advisor_count"] =
            caucusRoster.reduce(function(total, advisor) {
                return total +
                    (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
            }, 0);
    }

    for (const caucus of caucusIds) {
        for (const factor of [
            "office_hold",
            "local_organisation",
            "personal_following",
            "ideological_intensity",
            "list_dependence",
            "cohesion",
            "grievance_memory",
            "defection_readiness"
        ]) {
            Q[caucus + "_" + factor] = clamp(
                Q[caucus + "_" + factor],
                0,
                100
            );
        }
        Q[caucus + "_estimated_mps"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_estimated_mps"]) || 0)
        );
        Q[caucus + "_individual_defections"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_individual_defections"]) || 0)
        );
        Q[caucus + "_mp_departed"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_mp_departed"]) || 0)
        );
        Q[caucus + "_mp_retained"] = Math.max(
            0,
            Math.round(Number(Q[caucus + "_mp_retained"]) || 0)
        );
        Q[caucus + "_mp_departure_rate"] = clamp(
            Q[caucus + "_mp_departure_rate"],
            0,
            1
        );
        Q[caucus + "_escalation_stage"] = Math.round(clamp(
            Q[caucus + "_escalation_stage"],
            0,
            7
        ));
        Q[caucus + "_escalation_label"] =
            escalationLabels[Q[caucus + "_escalation_stage"]];
    }

    let totalFactionStrength = 0;
    for (const faction of Q.factions) {
        Q[faction + "_dissent"] =
            clamp(Q[faction + "_dissent"], 0, 100);
        Q[faction + "_strength"] =
            clamp(Q[faction + "_strength"], 0, 100);
        totalFactionStrength += Q[faction + "_strength"];
    }
    if (totalFactionStrength <= 0 && Q.factions.length > 0) {
        const equalStrength = 100 / Q.factions.length;
        for (const faction of Q.factions) {
            Q[faction + "_strength"] = equalStrength;
        }
        totalFactionStrength = 100;
    } else {
        for (const faction of Q.factions) {
            Q[faction + "_strength"] =
                Q[faction + "_strength"] * 100 / totalFactionStrength;
        }
    }

    let weightedDissent = 0;
    let activeVetoes = 0;
    for (const faction of Q.factions) {
        const strength = Q[faction + "_strength"];
        const dissent = Q[faction + "_dissent"];
        weightedDissent += strength * dissent;
        if (strength >= 12 && dissent >= 60) {
            activeVetoes += 1;
        }
    }
    Q.internal_dissent = Q.factions.length > 0 ?
        Math.round(weightedDissent / 100) : 100;
    Q.faction_vetoes = activeVetoes;
    Q.party_action_effectiveness = Math.round(clamp(
        100 - Math.max(0, Q.internal_dissent - 20) * 0.80,
        35,
        100
    ));
    Q.message_discipline = Math.round(clamp(
        100 - Math.max(0, Q.internal_dissent - 20) -
            Q.faction_vetoes * 5,
        20,
        100
    ));
    Q.caucus_split_pending = Q.factions.some(function(caucus) {
        return Number(Q[caucus + "_escalation_stage"]) >= 7;
    }) ? 1 : 0;
    Q.caucus_crisis_pending = Q.factions.some(function(caucus) {
        const stage = Number(Q[caucus + "_escalation_stage"]) || 0;
        return (
            stage == 2 &&
            !Q[caucus + "_demand_answered"] &&
            Number(Q.time) >= Number(Q[caucus + "_demand_deadline"])
        ) || stage >= 7;
    }) ? 1 : 0;
    Q.faction_stage_highwater = caucusIds.reduce(
        function(highest, caucus) {
            return Math.max(
                highest,
                Number(Q[caucus + "_escalation_stage"]) || 0
            );
        },
        0
    );
    Q.failed_whips = caucusIds.reduce(function(total, caucus) {
        return total + Math.max(
            0,
            Math.round(Number(Q[caucus + "_failed_whips"]) || 0)
        );
    }, 0);
    Q.adviser_resignations = caucusIds.reduce(function(total, caucus) {
        return total + Math.max(
            0,
            Math.round(Number(Q[caucus + "_adviser_resignations"]) || 0)
        );
    }, 0);
    Q.individual_defections = caucusIds.reduce(function(total, caucus) {
        return total + Math.max(
            0,
            Math.round(Number(Q[caucus + "_individual_defections"]) || 0)
        );
    }, 0);
    Q.parliamentary_circles = caucusIds.reduce(function(total, caucus) {
        return total + (Q[caucus + "_circle_formed"] ? 1 : 0);
    }, 0);
    Q.organised_left_splits = caucusIds.reduce(function(total, caucus) {
        return total + (Q[caucus + "_party_formed"] ? 1 : 0);
    }, 0);
    Q.contradictory_media_appearances = caucusIds.reduce(
        function(total, caucus) {
            return total + Math.max(
                0,
                Math.round(
                    Number(Q[caucus + "_contradictory_appearances"]) || 0
                )
            );
        },
        0
    );
    Q.campaign_capacity_loss = Math.max(
        0,
        Number(Q.campaign_capacity_loss) || 0
    );
    Q.dues_withheld = Math.max(0, Number(Q.dues_withheld) || 0);
    Q.lost_dues_total = Math.max(0, Number(Q.lost_dues_total) || 0);
    Q.strategic_centre_label = Q.organised_left_splits > 0
        ? (
            Number(Q.left_seats) >= 10
                ? "Lewica coordinating centre and rump caucus"
                : "Strategic coordinating centre outside a viable rump"
        )
        : "Lewica coordinating centre";
    if (Q.organised_left_splits > 0) {
        Q.fragmentation_status =
            Q.organised_left_splits + " competing Left list" +
            (Q.organised_left_splits == 1 ? "" : "s");
    } else if (Q.faction_stage_highwater >= 6) {
        Q.fragmentation_status = "Parliamentary clubs are preparing lists";
    } else if (Q.faction_stage_highwater >= 4) {
        Q.fragmentation_status = "The common whip is failing";
    } else if (Q.faction_stage_highwater >= 2) {
        Q.fragmentation_status = "Faction demands carry deadlines";
    } else if (Q.faction_stage_highwater >= 1) {
        Q.fragmentation_status = "Private leaks and contradictory briefings";
    } else {
        Q.fragmentation_status = "Negotiated common campaign";
    }

    const splinterSeatQualities = [
        "sld_breakaway_seats",
        "spring_breakaway_seats",
        "labor_left_seats",
        "young_left_seats",
        "razem_party_seats",
        "pps_party_seats"
    ];
    Q.left_splinter_seats = splinterSeatQualities.reduce(
        function(total, quality) {
            return total + Math.max(
                0,
                Math.round(Number(Q[quality]) || 0)
            );
        },
        0
    );
    Q.left_family_seats =
        Math.max(0, Math.round(Number(Q.left_seats) || 0)) +
        Q.left_splinter_seats;
    const splinterRelations = [
        ["sld_breakaway_seats", "barons_party_relation"],
        ["spring_breakaway_seats", "spring_party_relation"],
        ["labor_left_seats", "labor_party_relation"],
        ["young_left_seats", "progressives_party_relation"],
        ["razem_party_seats", "razem_party_relation"],
        ["pps_party_seats", "pps_party_relation"]
    ];
    Q.left_splinter_support_votes = splinterRelations.reduce(
        function(total, entry) {
            return total + (
                Number(Q[entry[1]]) >= 45
                    ? Math.max(0, Math.round(Number(Q[entry[0]]) || 0))
                    : 0
            );
        },
        0
    );
    Q.left_committed_seats =
        Math.max(0, Math.round(Number(Q.left_seats) || 0)) +
        Q.left_splinter_support_votes;
    const centrumCommitted =
        Number(Q.centrum_relation) >= 45
            ? Math.max(
                0,
                Math.round(Number(Q.centrum_seats) || 0)
            )
            : 0;
    Q.coalition_democratic_seats =
        Math.max(0, Math.round(Number(Q.ko_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.psl_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.p2050_seats) || 0)) +
        centrumCommitted +
        Q.left_committed_seats;
    Q.coalition_right_seats =
        Math.max(0, Math.round(Number(Q.pis_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.konf_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.rozwoj_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.korona_seats) || 0));

    const chamberNumbers = [
        "senate_total",
        "senate_pis_seats",
        "senate_konf_seats",
        "senate_ko_seats",
        "senate_p2050_seats",
        "senate_psl_seats",
        "senate_left_seats",
        "senate_independent_seats",
        "senate_democratic_seats",
        "senate_right_seats",
        "senate_opposition_seats",
        "senate_working_votes",
        "senate_amendment_credit",
        "confidence_present",
        "confidence_threshold",
        "confidence_yes",
        "confidence_no",
        "confidence_abstain",
        "morawiecki_votes",
        "democratic_votes",
        "morawiecki_left_defectors",
        "morawiecki_psl_defectors",
        "coalition_seats"
    ];
    for (const quality of chamberNumbers) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? Math.max(0, Number(Q[quality]))
            : 0;
    }
    Q.senate_cohesion = clamp(Q.senate_cohesion, 0, 100);
    Q.senate_left_leverage = clamp(Q.senate_left_leverage, 0, 100);
    Q.third_way_cohesion = clamp(Q.third_way_cohesion, 0, 100);
    Q.government_coalition_dissent =
        clamp(Q.government_coalition_dissent, 0, 100);
    Q.ko_coalition_dissent = clamp(Q.ko_coalition_dissent, 0, 100);
    Q.psl_coalition_dissent = clamp(Q.psl_coalition_dissent, 0, 100);
    Q.p2050_coalition_dissent =
        clamp(Q.p2050_coalition_dissent, 0, 100);
    Q.left_coalition_dissent =
        clamp(Q.left_coalition_dissent, 0, 100);
}
!}
