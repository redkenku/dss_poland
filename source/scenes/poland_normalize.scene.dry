    ];
    Q.left_splinter_support_votes = splinterRelations.reduce(
        function(total, entry) {
            return total + (
                Number(Q[entry[1]]) >= 45
                    ? Math.max(0, Math.round(Number(Q[entry[0]]) || 0))
                    : 0
            );
        },
        0
    );
    Q.left_committed_seats =
        Math.max(0, Math.round(Number(Q.left_seats) || 0)) +
        Q.left_splinter_support_votes;
    const centrumCommitted =
        Number(Q.centrum_relation) >= 45
            ? Math.max(
                0,
                Math.round(Number(Q.centrum_seats) || 0)
            )
            : 0;
    Q.coalition_democratic_seats =
        Math.max(0, Math.round(Number(Q.ko_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.psl_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.p2050_seats) || 0)) +
        centrumCommitted +
        Q.left_committed_seats;
    Q.coalition_right_seats =
        Math.max(0, Math.round(Number(Q.pis_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.konf_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.rozwoj_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.korona_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.new_hope_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.national_movement_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.duda_seats) || 0)) +
        Math.max(0, Math.round(Number(Q.social_conservative_seats) || 0));

    const chamberNumbers = [
        "senate_total",
        "senate_pis_seats",
        "senate_konf_seats",
        "senate_ko_seats",
        "senate_p2050_seats",
        "senate_psl_seats",
        "senate_left_seats",
        "senate_independent_seats",
        "senate_democratic_seats",
        "senate_right_seats",
        "senate_opposition_seats",
        "senate_working_votes",
        "senate_amendment_credit",
        "confidence_present",
        "confidence_threshold",
        "confidence_yes",
        "confidence_no",
        "confidence_abstain",
        "morawiecki_votes",
        "democratic_votes",
        "morawiecki_left_defectors",
        "morawiecki_psl_defectors",
        "coalition_seats"
    ];
    for (const quality of chamberNumbers) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? Math.max(0, Number(Q[quality]))
            : 0;
    }
    Q.senate_cohesion = clamp(Q.senate_cohesion, 0, 100);
    Q.senate_left_leverage = clamp(Q.senate_left_leverage, 0, 100);
    Q.third_way_cohesion = clamp(Q.third_way_cohesion, 0, 100);
    Q.government_coalition_dissent =
        clamp(Q.government_coalition_dissent, 0, 100);
    Q.pis_coalition_dissent = clamp(Q.pis_coalition_dissent, 0, 100);
    Q.ko_coalition_dissent = clamp(Q.ko_coalition_dissent, 0, 100);
    Q.psl_coalition_dissent = clamp(Q.psl_coalition_dissent, 0, 100);
    Q.p2050_coalition_dissent =
        clamp(Q.p2050_coalition_dissent, 0, 100);
    Q.konf_coalition_dissent = clamp(Q.konf_coalition_dissent, 0, 100);
    Q.left_coalition_dissent =
        clamp(Q.left_coalition_dissent, 0, 100);

    // Unanswered policy pressure.
    //
    // Party and opposition work can put a demand on the national agenda; only
    // the competent ledger can answer it. What is left over is what voters are
    // actually angry about, and it is the input to both the pressure events and
    // the radicalisation of the party system. Every domain therefore pairs the
    // demand with the ledger that answers it.
    const pressureDomains = [
        {
            id: "health",
            label: "hospitals, staff and waiting lists",
            pressure: "health_policy_pressure",
            answer: "health_capacity",
            floor: 45,
            weight: 1.00,
            portfolio: "health_minister_party"
        },
        {
            id: "household",
            label: "rents, bills and household security",
            pressure: "household_policy_pressure",
            answer: "household_security",
            floor: 42,
            weight: 1.10,
            portfolio: "housing_minister_party"
        },
        {
            id: "climate",
            label: "energy transition and climate capacity",
            pressure: "climate_policy_pressure",
            answer: "climate_state_capacity",
            floor: 30,
            weight: 0.70,
            portfolio: "economy_minister_party"
        },
        {
            id: "admin",
            label: "state administration and delivery capacity",
            pressure: "administrative_reform_pressure",
            answer: "administrative_capacity",
            floor: 30,
            weight: 0.75,
            portfolio: "digital_minister_party"
        },
        {
            id: "kpo",
            label: "recovery-fund money and its conditions",
            pressure: "kpo_scrutiny",
            answer: "kpo_public_credit",
            floor: 20,
            weight: 0.85,
            portfolio: "finance_minister_party"
        },
        {
            id: "justice",
            label: "prosecution, courts and accountability",
            pressure: "prosecution_oversight_capacity",
            answer: "judicial_legitimacy",
            floor: 40,
            weight: 0.80,
            portfolio: "justice_minister_party"
        }
    ];
    let grievanceTotal = 0;
    let grievanceWeight = 0;
    let topPressureDomain = null;
    for (const domain of pressureDomains) {
        const raised = clamp(finitePolitical(Q[domain.pressure], 0), 0, 100);
        const answered = Math.max(
            0,
            finitePolitical(Q[domain.answer], 0) - domain.floor
        ) * 0.55;
        const unmet = clamp(raised - answered, 0, 60);
        Q[domain.id + "_pressure_unmet"] = Math.round(unmet * 10) / 10;
        grievanceTotal += unmet * domain.weight;
        grievanceWeight += domain.weight;
        if (!topPressureDomain || unmet > topPressureDomain.unmet) {
            topPressureDomain = {
                id: domain.id,
                label: domain.label,
                portfolio: domain.portfolio,
                unmet: unmet
            };
        }
    }
    Q.social_grievance = Math.round(
        clamp(
            grievanceTotal / Math.max(1, grievanceWeight) * 2.1,
            0,
            100
        )
    );
    const leftExecutive =
        Q.left_in_government &&
        Q.government_has_confidence &&
        !Q.caretaker_government;
    if (topPressureDomain && topPressureDomain.unmet >= 6) {
        Q.pressure_top_domain = topPressureDomain.id;
        Q.pressure_top_label = topPressureDomain.label;
        Q.pressure_top_value = Math.round(topPressureDomain.unmet * 10) / 10;
        Q.pressure_owner =
            leftExecutive &&
            String(Q[topPressureDomain.portfolio] || "") == "Lewica"
                ? "Lewica ministry"
                : (leftExecutive
                    ? "the coalition"
                    : String(Q.government_name || "the cabinet"));
    } else {
        Q.pressure_top_domain = "none";
        Q.pressure_top_label = "No unanswered demand";
        Q.pressure_top_value = 0;
        Q.pressure_owner = "none";
    }

    // Radicalisation is anger with nowhere institutional to go. Economic pain
    // and unanswered demands push it up; trust, delivery and household
    // security pull it back, so a competent government can always work its way
    // out of the spiral it inherited.
    const grievancePush = Q.social_grievance * 0.42;
    const economicPush = clamp(economicCrisis, 0, 60) * 0.55;
    const antiSystemPush =
        Math.max(
            0,
            finitePolitical(Q.far_right_street_capacity, 38) - 38
        ) * 0.20 +
        finitePolitical(Q.covid_anti_system_pressure, 0) * 0.10 +
        Math.max(0, finitePolitical(Q.far_right_agenda, 30) - 40) * 0.16;
    const institutionalDamping =
        Math.max(0, finitePolitical(Q.institutional_trust, 44) - 44) * 0.30 +
        Math.max(0, finitePolitical(Q.public_trust, 43) - 43) * 0.22 +
        Math.max(0, finitePolitical(Q.household_security, 45) - 45) * 0.18 +
        (leftExecutive
            ? Math.max(
                0,
                finitePolitical(Q.government_delivery, 30) - 30
            ) * 0.14
            : 0);
    Q.radicalisation_index = Math.round(
        clamp(
            grievancePush + economicPush + antiSystemPush -
                institutionalDamping,
            0,
            100
        )
    );

    // Prose uses canonical public names; ledgers and vote arithmetic use the
    // compact label carried beside them. `name` remains the live display brand
    // for compatibility with older saves and authored scenes.
    const playerPartyNameVariants = [
        ["Lewica", "Lewica", "Lewica"],
        ["Nowa Lewica", "Nowa Lewica", "NL"],
        ["Lewica Razem", "Lewica Razem", "LR"],
        ["Wiosna", "Wiosna", "Wiosna"],
        ["Lewica w Rozsypce", "Lewica w Rozsypce", "LwR"],
        ["Porozumienie Lewicy", "Porozumienie Lewicy", "PL"],
        ["Federacja Lewicy", "Federacja Lewicy", "FL"],
        ["Wspólne Jutro", "Wspólne Jutro", "WJ"],
        ["Wiosna-SLD", "Wiosna-SLD", "Wiosna-SLD"],
        ["Lewica Patriotyczna", "Lewica Patriotyczna", "LP"],
        ["Nowa Lewica – Odnowa", "Nowa Lewica – Odnowa", "NL–O"],
        ["New Left Renewal", "Nowa Lewica – Odnowa", "NL–O"],
        ["Ruch Postępu", "Ruch Postępu", "RP"],
        ["Sojusz Polski Społecznej", "Sojusz Polski Społecznej", "SPS"],
        ["Nowa Solidarność", "Nowa Solidarność", "NS"],
        ["Solidarność Społeczna", "Solidarność Społeczna", "SS"],
        ["Lewica Rozwoju", "Lewica Rozwoju", "LRz"],
        ["Wspólna Polska", "Wspólna Polska", "WP"],
        ["Partia Pracy", "Partia Pracy", "PP"],
        ["Lewica Lewic", "Lewica Lewic", "LL"]
    ];
    Q.player_party_name_variants = playerPartyNameVariants.map(
        function(names) {
            return {
                name: names[0],
                long_name: names[1],
                short_name: names[2]
            };
        }
    );
    const partyNameAliases = [
        ["Prawo i Sprawiedliwość", "Prawo i Sprawiedliwość", "PiS"],
        ["PiS", "Prawo i Sprawiedliwość", "PiS"],
        ["Zjednoczona Prawica", "Zjednoczona Prawica", "ZP"],
        ["Koalicja Obywatelska", "Koalicja Obywatelska", "KO"],
        ["Platforma Obywatelska", "Platforma Obywatelska", "PO"],
        ["Nowoczesna", "Nowoczesna", ".N"],
        ["Inicjatywa Polska", "Inicjatywa Polska", "iPL"],
        ["Zieloni", "Partia Zieloni", "Zieloni"],
        ["Partia Zieloni", "Partia Zieloni", "Zieloni"],
        ["Polskie Stronnictwo Ludowe", "Polskie Stronnictwo Ludowe", "PSL"],
        ["PSL", "Polskie Stronnictwo Ludowe", "PSL"],
        ["Koalicja Polska", "Koalicja Polska", "KP"],
        ["Polska 2050", "Polska 2050", "PL2050"],
        ["Trzecia Droga", "Trzecia Droga", "TD"],
        ["Kukiz'15", "Kukiz'15", "Kukiz'15"],
        ["Unia Europejskich Demokratów (UED)",
            "Unia Europejskich Demokratów", "UED"],
        ["Unia Europejskich Demokratów",
            "Unia Europejskich Demokratów", "UED"],
        ["Konfederacja Wolność i Niepodległość",
            "Konfederacja Wolność i Niepodległość", "Konf."],
        ["Konfederacja", "Konfederacja Wolność i Niepodległość", "Konf."],
        ["Wolność", "Wolność", "Wolność"],
        ["KORWiN", "KORWiN", "KORWiN"],
        ["Nowa Nadzieja", "Nowa Nadzieja", "NN"],
        ["Ruch Narodowy", "Ruch Narodowy", "RN"],
        ["Konfederacja Korony Polskiej",
            "Konfederacja Korony Polskiej", "KKP"],
        ["Korona", "Konfederacja Korony Polskiej", "KKP"],
        ["Porozumienie", "Porozumienie", "Porozumienie"],
        ["Solidarna Polska", "Solidarna Polska", "SP"],
        ["Suwerenna Polska", "Suwerenna Polska", "SP"],
        ["Partia Republikańska", "Partia Republikańska", "PR"],
        ["OdNowa RP", "OdNowa Rzeczypospolitej Polskiej", "OdNowa RP"],
        ["OdNowa Rzeczypospolitej Polskiej",
            "OdNowa Rzeczypospolitej Polskiej", "OdNowa RP"],
        ["Rozwój+", "Rozwój Plus", "Rozwój+"],
        ["Rozwój Plus", "Rozwój Plus", "Rozwój+"],
        ["Sojusz Lewicy Demokratycznej",
            "Sojusz Lewicy Demokratycznej", "SLD"],
        ["Democratic Left Alliance", "Sojusz Lewicy Demokratycznej", "SLD"],
        ["SLD", "Sojusz Lewicy Demokratycznej", "SLD"],
        ["Spring", "Wiosna", "Wiosna"],
        ["Razem", "Partia Razem", "Razem"],
        ["Partia Razem", "Partia Razem", "Razem"],
        ["PPS", "Polska Partia Socjalistyczna", "PPS"],
        ["Polska Partia Socjalistyczna", "Polska Partia Socjalistyczna", "PPS"],
        ["Independent Labour Left", "Lewica Pracy", "LP"],
        ["Labour Left", "Lewica Pracy", "LP"],
        ["Lewica Pracy", "Lewica Pracy", "LP"],
        ["Young Left", "Młoda Lewica", "Młoda Lewica"],
        ["Młoda Lewica", "Młoda Lewica", "Młoda Lewica"],
        ["Tak! Dla Rozwoju", "Tak! Dla Rozwoju", "T!DR"],
        ["Akcja Socjalistyczna", "Akcja Socjalistyczna", "AS"],
        ["Unia Centrum", "Unia Centrum", "UC"],
        ["Partia Zero", "Partia Zero", "P0"],
        ["German Minority", "Mniejszość Niemiecka", "MN"],
        ["Mniejszość Niemiecka", "Mniejszość Niemiecka", "MN"]
    ].concat(playerPartyNameVariants);
    const partyNamesByAlias = {};
    for (const names of partyNameAliases) {
        partyNamesByAlias[names[0]] = {
            long_name: names[1],
            short_name: names[2]
        };
    }
    const partyNames = function(value) {
        const name = String(value || "Unassigned");
        return partyNamesByAlias[name] || {
            long_name: name,
            short_name: name
        };
    };
    const applyPartyNames = function(record) {
        const names = partyNames(record.name);
        record.long_name = names.long_name;
        record.short_name = names.short_name;
    };
    for (const record of Q.rival_group_records || []) applyPartyNames(record);

    const leftNames = partyNames(Q.left_party_name || "Lewica");
    Q.left_party_long_name = leftNames.long_name;
    Q.left_party_short_name = leftNames.short_name;
    const majorPartyNames = {
        pis: "Prawo i Sprawiedliwość",
        ko: "Koalicja Obywatelska",
        psl: "Polskie Stronnictwo Ludowe",
        p2050: "Polska 2050",
        konf: "Konfederacja Wolność i Niepodległość"
    };
    for (const id of Object.keys(majorPartyNames)) {
        const names = partyNames(majorPartyNames[id]);
        Q[id + "_party_long_name"] = names.long_name;
        Q[id + "_party_short_name"] = names.short_name;
    }
    for (const id of ["zp_committee", "kp_committee", "konf_committee"]) {
        const names = partyNames(Q[id + "_name"]);
        Q[id + "_long_name"] = names.long_name;
        Q[id + "_short_name"] = names.short_name;
    }
    const pmNames = partyNames(
        Q.pm_political_family == "left" ? Q.left_party_name : Q.pm_party_name
    );
    Q.pm_party_long_name = pmNames.long_name;
    Q.pm_party_short_name = pmNames.short_name;

    for (const record of Q.parliamentary_party_records || []) {
        if (record.id == "left_party") record.name = Q.left_party_name;
        applyPartyNames(record);
    }
    for (const record of Q.parliamentary_family_records || []) {
        if (record.id == "left") record.name = Q.left_party_name;
        applyPartyNames(record);
    }
    Q.party_name_schema_version = 1;

    // Junior-partner authority.
    //
    // A Lewica ministry inside somebody else's cabinet can be overruled, and
    // the risk is a political fact rather than a mood: coalition strain, a cold
    // senior relationship and an absent operating agreement all make an
    // objection more likely, while a written dispute protocol and a delivering
    // government make it rarer. Ministry cards roll against this number.
    const leftIsJunior =
        leftExecutive && String(Q.government_party || "") != "lewica";
    Q.left_is_junior_partner = leftIsJunior ? 1 : 0;
    const seniorPartnerNames = {
        pis: "PiS",
        ko: "KO",
        psl: "PSL",
        p2050: "Poland 2050",
        lewica: "Lewica"
    };
    Q.coalition_senior_partner =
        seniorPartnerNames[String(Q.government_party || "")] ||
        "the senior coalition partner";
    const seniorRelation =
        Q.government_party == "pis"
            ? finitePolitical(Q.pis_relation, 8)
            : (Q.government_party == "ko"
                ? finitePolitical(Q.ko_relation, 44)
                : (Q.government_party == "psl"
                    ? finitePolitical(Q.psl_relation, 24)
                    : (Q.government_party == "p2050"
                        ? finitePolitical(Q.p2050_relation, 20)
                        : 50)));
    Q.coalition_objection_risk = Math.round(
        clamp(
            (leftIsJunior ? 26 : 0) +
                Math.max(
                    0,
                    finitePolitical(Q.government_coalition_dissent, 0) - 8
                ) * 0.9 +
                Math.max(0, 50 - seniorRelation) * 0.45 +
                Math.max(
                    0,
                    finitePolitical(Q.psl_coalition_dissent, 0) - 12
                ) * 0.25 -
                Math.max(
                    0,
                    finitePolitical(Q.government_delivery, 30) - 40
                ) * 0.30 -
                // Everything written down at formation is worth something
                // here, which is the only reason to have written it down.
                (Q.coalition_dispute_protocol ? 12 : 0) -
                (Q.annual_rural_guarantee ? 6 : 0) -
                (
                    String(Q.coalition_budget_bargain || "").length > 0 &&
                    Q.coalition_budget_bargain != "None"
                        ? 5
                        : 0
                ),
            0,
            78
        )
    );
    // The values clause PSL bought at formation is a real veto, not a memory.
    Q.coalition_values_veto = Q.coalition_conscience_clause ? 1 : 0;
}
// --- The Second War at the Top ---------------------------------------------
// One camp holding both the Palace and the cabinet is not peace. Eligibility,
// camp identity and the heat of the personal rivalry are computed once a month
// here, so every stage of the chain in poland_war_on_top reads the same
// numbers and a camp that stops being one camp ends the war immediately.
{
    const warPresident = String(Q.president_name || "");
    const warPm = String(Q.prime_minister || "");
    const vacantOffice = function(name) {
        return !name.length ||
            name.indexOf("acting") >= 0 ||
            name.indexOf("disputed") >= 0 ||
            name.indexOf("Vacant") >= 0 ||
            name.indexOf("pending") >= 0;
    };
    const leftPalace = Boolean(
        Q.left_president ||
        Q.president_party == "lewica" ||
        [
            "Adrian Zandberg",
            "Magdalena Biejat",
            "Agnieszka Dziemianowicz-Bąk"
        ].includes(warPresident)
    );
    const liberalPalace =
        warPresident == "Rafał Trzaskowski" ||
        warPresident == "Szymon Hołownia";
    const rightPalace =
        warPresident == "Karol Nawrocki" ||
        warPresident == String(Q.pres_2025_right_candidate || "␀") ||
        [
            "Mateusz Morawiecki",
            "Beata Szydło",
            "Przemysław Czarnek"
        ].includes(warPresident);
    let sameCamp = "none";
    if (!vacantOffice(warPresident) && !vacantOffice(warPm)) {
        if (Q.government_party == "lewica" && leftPalace) {
            sameCamp = "lewica";
        } else if (Q.government_party == "ko" && liberalPalace && !leftPalace) {
            sameCamp = "ko";
        } else if (
            Q.government_party == "pis" &&
            rightPalace &&
            !leftPalace &&
            // Duda's own PiS cohabitation is the united-right period the
            // Gowin crisis already covers; it is not this chain.
            warPresident != "Andrzej Duda"
        ) {
            sameCamp = "pis";
        }
    }
    const warEligible =
        sameCamp != "none" &&
        Q.continuous_campaign &&
        Q.government_has_confidence &&
        !Q.caretaker_government &&
        !Q.formation_in_progress ? 1 : 0;
    // Named pairs, because "the president against the prime minister" is a
    // different fight depending on which two people it is. Zandberg against
    // the apparatus is the 2003 pattern; Zandberg against a Razem co-founder
    // in the cabinet keeps a channel open that the ruling cannot close.
    const heatPairs = {
        "Adrian Zandberg|Włodzimierz Czarzasty": 80,
        "Adrian Zandberg|Leszek Miller": 80,
        "Adrian Zandberg|Krzysztof Gawkowski": 70,
        "Adrian Zandberg|Agnieszka Dziemianowicz-Bąk": 65,
        "Adrian Zandberg|Magdalena Biejat": 35,
        "Magdalena Biejat|Włodzimierz Czarzasty": 45,
        "Agnieszka Dziemianowicz-Bąk|Włodzimierz Czarzasty": 45,
        "Rafał Trzaskowski|Donald Tusk": 60,
        "Rafał Trzaskowski|Radosław Sikorski": 55,
        "Karol Nawrocki|Przemysław Czarnek": 65,
        "Karol Nawrocki|Mateusz Morawiecki": 55,
        "Karol Nawrocki|Beata Szydło": 45
    };
    const campDefaultHeat = { lewica: 45, ko: 45, pis: 50, none: 0 };
    Q.war_top_eligible = warEligible;
    Q.war_top_camp_live = warEligible ? sameCamp : "none";
    Q.war_top_heat_live = warEligible
        ? (heatPairs[warPresident + "|" + warPm] ||
            campDefaultHeat[sameCamp])
        : 0;
    Q.war_top_stage = Math.max(
        0,
        Math.min(5, Math.round(Number(Q.war_top_stage) || 0))
    );
    Q.war_top_palace_bloc = Math.max(
        0,
        Math.min(100, Math.round(Number(Q.war_top_palace_bloc) || 0))
    );
    Q.war_top_heat = Math.max(
        0,
        Math.min(100, Math.round(Number(Q.war_top_heat) || 0))
    );
    // A war inside one camp cannot continue once the camp has lost the
    // cabinet, the Palace or its majority. It stays on the record instead.
    Q.war_top_suspended =
        Q.war_top_stage >= 1 && Q.war_top_stage < 5 && !warEligible ? 1 : 0;
    Q.war_top_state = Q.war_top_stage < 1
        ? (warEligible
            ? "One camp holds the Palace and the cabinet"
            : "No single-camp Palace and cabinet")
        : (Q.war_top_suspended
            ? "Suspended — the camp no longer holds both offices"
            : (Q.war_top_stage >= 5
                ? String(Q.war_top_settlement || "Settled")
                : "Stage " + Q.war_top_stage + " — Palace bloc " +
                    Q.war_top_palace_bloc + "/100, heat " +
                    Q.war_top_heat + "/100"));
}

    Q.third_way_display_name = !Q.p2050_emerged
        ? "PSL"
        : ((Q.third_way_active || Q.third_way_2023_done) && !Q.third_way_split
            ? "Trzecia Droga"
            : "PSL and Poland 2050");

// The explicit socialist turn. The hard programme reaches the leadership table
// only when the socialist current is actually large inside the alliance, the
// party is not being run as a Wiosna project, Razem is still working with the
// leadership rather than shouting at it, and the unions are cooperating rather
// than being managed. None of those are permanent, so the opening can close
// again while the line and the legal exposure it produced stay on the record.
{
    const hardNumber = function(value, fallback) {
        return Number.isFinite(Number(value)) ? Number(value) : fallback;
    };
    const hardClamp = function(value) {
        return Math.max(0, Math.min(100, Math.round(hardNumber(value, 0))));
    };
    const socialistStrength =
        Math.max(0, hardNumber(Q.razem_strength, 0)) +
        Math.max(0, hardNumber(Q.progressives_strength, 0)) +
        Math.max(0, hardNumber(Q.pps_strength, 0));
    const totalStrength = [
        "barons", "spring", "labor", "progressives", "razem", "pps",
        "social_patriot", "market_liberal"
    ].reduce(function(total, faction) {
        return total + Math.max(0, hardNumber(Q[faction + "_strength"], 0));
    }, 0);
    Q.hard_left_current_share = totalStrength > 0
        ? Math.round((socialistStrength / totalStrength) * 100)
        : 0;
    // Cooperativeness is a relationship, not a mood: the confederation has to
    // trust the party, OPZZ has to be working with it, and the labour caucus
    // has to not be in open conflict at the same time.
    const labourCooperative =
        hardNumber(Q.opzz_cooperation, 0) >= 55 &&
        hardNumber(Q.union_trust, 0) >= 55 &&
        hardNumber(Q.labor_dissent, 100) <= 45;
    const razemInside =
        Q.razem_active && Q.razem_in_left && !Q.razem_party_formed;
    const progressivesInside =
        Q.progressives_active && Q.progressives_in_left;
    Q.hard_left_turn_open =
        Q.continuous_campaign &&
        razemInside &&
        progressivesInside &&
        hardNumber(Q.spring_path_stage, 0) < 2 &&
        Q.spring_path_route != "market_liberal" &&
        Q.hard_left_current_share >= 22 &&
        hardNumber(Q.razem_cooperation, 0) >= 45 &&
        labourCooperative
            ? 1
            : 0;
    Q.hard_left_line = hardClamp(Q.hard_left_line);
    Q.hard_left_exposure = hardClamp(Q.hard_left_exposure);
    Q.hard_left_refusals = Math.max(0, Math.round(
        hardNumber(Q.hard_left_refusals, 0)
    ));
    Q.hard_left_line_label = Q.hard_left_line >= 70
        ? "An openly socialist party programme"
        : (Q.hard_left_line >= 45
            ? "A hardened programme the centre can no longer read as social democracy"
            : (Q.hard_left_line >= 20
                ? "A sharpened line with the old formulations still attached"
                : "No explicit socialist programme"));
}

Q.ideological_path_government_open =
    (Q.sld_partocracy_stage >= 3 &&
        (Q.poland_sld_public_boards_timer == 0 ||
            Q.poland_sld_mayors_timer == 0 ||
            Q.poland_sld_pension_guarantee_timer == 0 ||
            Q.poland_sld_national_champions_timer == 0 ||
            Q.poland_sld_administrative_republic_timer == 0)) ||
    (Q.spring_path_stage >= 3 &&
        Q.spring_path_route == "social_liberal" &&
        (Q.poland_wiosna_equal_citizenship_timer == 0 ||
            Q.poland_wiosna_secular_state_timer == 0 ||
            Q.poland_wiosna_reproductive_timer == 0 ||
            Q.poland_wiosna_rainbow_school_timer == 0 ||
            Q.poland_wiosna_open_republic_timer == 0)) ||
    (Q.market_liberal_active &&
        (Q.poland_market_social_budget_timer == 0 ||
            Q.poland_market_competition_timer == 0 ||
            Q.poland_market_one_rate_timer == 0 ||
            Q.poland_market_private_supply_timer == 0 ||
            Q.poland_market_fiscal_council_timer == 0)) ||
    (Q.sld_populist_route_active &&
        Q.sld_populist_settlement_stage >= 4 &&
        (Q.poland_populist_tariff_timer == 0 ||
            Q.poland_populist_welfare_timer == 0 ||
            Q.poland_populist_bank_timer == 0 ||
            Q.poland_populist_foreign_capital_timer == 0 ||
            Q.poland_populist_referendum_timer == 0))
        ? 1
        : 0;

// Constituent programmes remain available whenever their own current is live
// and strong, regardless of which leadership route controls the common party.
// This aggregate keeps the already-large Government Affairs gate parseable.
Q.constituent_programme_government_open =
    (Q.continuous_campaign &&
        !Q.left_common_party_exists &&
        Q.barons_active && Q.barons_in_left && Q.barons_strength >= 38 &&
        (Q.poland_sld_housebuilding_timer == 0 ||
            Q.poland_sld_inspector_timer == 0 ||
            Q.poland_sld_public_work_timer == 0 ||
            Q.poland_sld_ivf_timer == 0 ||
            Q.poland_sld_research_timer == 0)) ||
    (Q.continuous_campaign &&
        !Q.left_common_party_exists &&
        Q.spring_active && Q.spring_in_left && Q.spring_strength >= 25 &&
        (Q.poland_wiosna_powiat_train_timer == 0 ||
            Q.poland_wiosna_specialist_timer == 0 ||
            Q.poland_wiosna_alimony_timer == 0 ||
            Q.poland_wiosna_assistant_timer == 0 ||
            Q.poland_wiosna_conscience_timer == 0)) ||
    (Q.continuous_campaign &&
        Q.pps_active && Q.pps_in_left && Q.pps_strength >= 6 &&
        (Q.poland_pps_six_hour_timer == 0 ||
            Q.poland_pps_councils_timer == 0 ||
            Q.poland_pps_maximum_wage_timer == 0 ||
            Q.poland_pps_housing_first_timer == 0 ||
            Q.poland_pps_public_fibre_timer == 0)) ||
    (Q.continuous_campaign &&
        Q.nowa_lewica_merger_agreed && Q.left_common_party_exists &&
        (Q.poland_nowa_lewica_second_breakfast_timer == 0 ||
            Q.poland_nowa_lewica_student_ticket_timer == 0 ||
            Q.poland_nowa_lewica_school_health_timer == 0 ||
            Q.poland_nowa_lewica_widow_pension_timer == 0 ||
            Q.poland_nowa_lewica_empty_homes_timer == 0)) ||
    (Q.continuous_campaign &&
        Q.razem_active && Q.razem_in_left && Q.razem_strength >= 15 &&
        (Q.poland_razem_eight_reactors_timer == 0 ||
            Q.poland_razem_public_code_timer == 0 ||
            Q.poland_razem_twenty_desks_timer == 0 ||
            Q.poland_razem_one_percent_housing_timer == 0 ||
            Q.poland_razem_choose_waiting_room_timer == 0))
        ? 1
        : 0;

// Achievements use Dendry's native persistent and per-run qualities. Keep the
// predicates in one callable table so the normal monthly path and the final
// epilogue evaluate exactly the same rules.
if (!budgetHost.polandAchievementEvaluator) {
    budgetHost.polandAchievementEvaluator = function(engine, q) {
        if (!q.started || q.scenario_mode != "campaign_2019") {
            return [];
        }
        const number = function(value) {
            return Number.isFinite(Number(value)) ? Number(value) : 0;
        };
        const coalitionCode = String(q.formation_coalition_code || "none")
            .replace(/_tolerated$/, "");
        const cabinetLive = Boolean(
            q.government_has_confidence && !q.caretaker_government
        );
        const nuclearComplete =
            number(q.nuclear_stage) >= 5 &&
            !q.nuclear_shelved &&
            number(q.nuclear_delivery) >= 15;
        const cpkComplete =
            number(q.cpk_stage) >= 5 &&
            !q.cpk_cancelled &&
            number(q.cpk_delivery) >= 15;
        const peoplesAtom =
            nuclearComplete &&
            number(q.nuclear_public_ownership) >= 20 &&
            number(q.nuclear_price_shield) >= 15 &&
            number(q.nuclear_labour_standard) >= 25 &&
            number(q.nuclear_just_transition) >= 20;
        const secondNuclear =
            !q.nuclear_shelved &&
            q.nuclear_second_plant ==
                "Pątnów–Konin with a Korean partner and a public majority";
        const peoplesCpk =
            cpkComplete &&
            q.cpk_scope ==
                "Hub airport and high-speed rail, publicly owned" &&
            number(q.cpk_public_ownership) >= 15 &&
            number(q.cpk_labour_standard) >= 25;
        const leftMarshalNames = [
            "Włodzimierz Czarzasty", "Robert Biedroń",
            "Agnieszka Dziemianowicz-Bąk", "Magdalena Biejat",
            "Marta Stożek", "Adrian Zandberg", "Krzysztof Gawkowski",
            "Anna Maria Żukowska", "Katarzyna Kotula", "Krzysztof Śmiszek",
            "Tomasz Trela", "Paulina Matysiak", "Joanna Scheuring-Wielgus",
            "Wanda Nowicka"
        ];
        const speakerName = String(q.sejm_speaker || "");
        const leftLeaderName = String(q.left_leader || "");
        const leftMarshal = speakerName.length > 0 && (
            q.sejm_speaker_party == "lewica" ||
            leftMarshalNames.includes(speakerName) ||
            (leftLeaderName.length > 0 && speakerName == leftLeaderName)
        );
        const rightSplitCount = [
            "republikanie_formed", "kukiz_left_kp", "suwerenna_walkout",
            "pis_split", "far_right_split", "mentzen_bosak_split",
            "pis_collapsed"
        ].reduce(function(total, key) {
            return total + (q[key] ? 1 : 0);
        }, 0);
        const referendumReform = [
            "abortion", "marriage", "church", "asylum"
        ].some(function(issue) {
            return q[issue + "_referendum_mandate"] &&
                number(q[issue + "_reform_stage"]) >= 4;
        });
        const terminal = Boolean(
            number(q.game_over) == 1 &&
            ["Natural conclusion", "Voted out"].includes(
                String(q.ending_exit_type || "")
            )
        );
        const checks = [
            ["left_eight_percent_2020",
                Boolean(q.pres_first_round_complete) &&
                number(q.pres_r1_display_left) >= 8],
            ["biedron_below_historical_2020",
                Boolean(q.pres_first_round_complete) &&
                q.presidential_candidate == "Robert Biedroń" &&
                number(q.pres_r1_display_left) < 2.22],
            ["biedron_beats_bosak_2020",
                Boolean(q.pres_first_round_complete) &&
                q.presidential_candidate == "Robert Biedroń" &&
                number(q.pres_r1_display_left) > 7 &&
                number(q.pres_r1_display_left) >
                    number(q.pres_r1_display_bosak)],
            ["trzaskowski_president_2020", Boolean(q.trz_inaugurated)],
            ["left_president_2025", q.pres_2025_winner_key == "left"],
            ["first_round_president_2025",
                q.pres_2025_winner_key == "left" &&
                Boolean(q.pres_2025_first_round_winner)],
            ["back_in_the_ring",
                Boolean(q.prawica_formed) &&
                q.prawica_leader == "Andrzej Duda" &&
                !q.prawica_pis_government_block],
            ["ill_be_back",
                Boolean(q.third_way_split) &&
                q.third_way_response ==
                    "PSL recognised as the parliamentary hinge" &&
                (q.pres_2025_winner_key == "holownia" ||
                    q.president_name == "Szymon Hołownia")],
            ["enter_government", cabinetLive && Boolean(q.left_in_government)],
            ["left_prime_minister",
                cabinetLive && Boolean(q.left_in_government) &&
                q.government_party == "lewica"],
            ["left_only_government", cabinetLive && coalitionCode == "left_only"],
            ["democratic_coalition",
                cabinetLive && coalitionCode == "democratic_2023"],
            ["wina_tuska",
                q.sejm_list_outcome == "democratic_8" && cabinetLive &&
                Boolean(q.left_in_government) &&
                Array.isArray(q.formation_coalition_members) &&
                !q.formation_coalition_members.includes("ko")],
            ["split_third_way_coalition",
                cabinetLive && [
                    "ko_psl_left", "ko_p2050_left", "left_p2050", "left_psl"
                ].includes(coalitionCode)],
            ["left_pis_coalition", cabinetLive && coalitionCode == "left_pis"],
            ["five_party_coalition",
                cabinetLive && coalitionCode == "left_pis_konf_third"],
            ["third_way_left_pis",
                cabinetLive && coalitionCode == "third_left_pis"],
            ["borrowed_left_pm",
                cabinetLive && Boolean(q.left_pm_borrowed_mandate)],
            ["confidence_and_supply",
                cabinetLive && !q.left_in_government &&
                q.left_cabinet_model == "Confidence and supply from opposition"],
            ["no_third_way",
                Boolean(q.third_way_split) &&
                (coalitionCode == "ko_p2050_left" ||
                    coalitionCode == "left_p2050") &&
                Boolean(q.psl_2023_exclusion_crisis_done) &&
                Boolean(q.psl_right_alignment_locked)],
            ["budget_concession",
                Boolean(q.budget_concession_after_defeat)],
            ["marshal_rotation", Boolean(q.marshal_rotation_vote_passed)],
            ["sejmflix",
                q.sejm_speaker == "Szymon Hołownia" &&
                Boolean(q.sejmflix_2023_done) &&
                number(q.parliament_visibility) >= 65],
            ["german_agent",
                cabinetLive && q.government_party == "ko" &&
                q.prime_minister == "Donald Tusk" &&
                q.pis_leader == "Jarosław Kaczyński" &&
                number(q.pis_seats) > 0 && number(q.pis_relation) <= 10],
            ["power_holding_group",
                cabinetLive && q.government_party == "lewica" &&
                Boolean(q.left_president) && leftMarshal],
            ["nocna_zmiana", Boolean(q.government_removed_by_vonc)],
            ["sejm_freezer",
                leftMarshal && Boolean(q.reform_pressure_frozen) &&
                number(q.frozen_demand_count) >= 1],
            ["full_abortion_reform", number(q.abortion_reform_stage) >= 4],
            ["full_marriage_reform", number(q.marriage_reform_stage) >= 4],
            ["full_church_reform", number(q.church_reform_stage) >= 4],
            ["full_asylum_reform", number(q.asylum_reform_stage) >= 4],
            ["full_border_reform", number(q.border_reform_stage) >= 4],
            ["full_defence_reform", number(q.defence_reform_stage) >= 4],
            ["full_labor_reform", number(q.labor_reform_stage) >= 4],
            ["full_health_reform", number(q.health_reform_stage) >= 4],
            ["full_courts_reform", number(q.courts_reform_stage) >= 4],
            ["three_max_reforms",
                Boolean(q.major_reforms_complete) &&
                number(q.reform_slate_count) == 3 &&
                number(q.reform_slate_weight) == 12],
            ["referendum_reform", referendumReform],
            ["trzaskowski_freebie",
                q.trz_rights_bill_outcome == "Passed and signed"],
            ["nuclear_complete", nuclearComplete],
            ["peoples_atom", peoplesAtom],
            ["second_nuclear_plant", secondNuclear],
            ["nuclear_shelved", Boolean(q.nuclear_ever_shelved)],
            ["cpk_complete", cpkComplete],
            ["peoples_cpk", peoplesCpk],
            ["rail_first",
                q.cpk_scope ==
                    "Rail programme first, hub airport staged behind demonstrated demand"],
            ["cpk_public_works",
                Boolean(q.cpk_cancelled) && Boolean(q.cpk_public_works)],
            ["compensated_nationalisation",
                Boolean(q.petrochemical_statute_enacted)],
            ["unlawful_nationalisation",
                Boolean(q.petrochemical_unlawful_seizure)],
            ["ownership_doctrine",
                Boolean(q.nationalisation_doctrine_adopted)],
            ["five_nationalisations", number(q.strategic_nationalisations) >= 5],
            ["mmt_doctrine", Boolean(q.mmt_doctrine_adopted)],
            ["developmental_state",
                peoplesAtom && peoplesCpk && secondNuclear &&
                number(q.strategic_nationalisations) >= 5],
            ["bez_zadnego_trybu", Boolean(q.emergency_capital_controls)],
            ["unified_left_party",
                Boolean(q.left_common_party_exists) &&
                q.left_merger_structure == "unified_party"],
            ["member_led_unification",
                Boolean(q.historical_peaceful_unification) ||
                Boolean(q.federation_peaceful_unification)],
            ["binding_federation",
                q.left_constitution == "member-ratified_federation" ||
                [
                    "Member-ratified binding federation",
                    "Late binding federation"
                ].includes(String(q.left_structural_endpoint || ""))],
            ["razem_leaves",
                Boolean(q.razem_split) && !Boolean(q.razem_in_left)],
            ["razem_leadership", q.left_dominant_current == "razem"],
            ["miller_restoration", Boolean(q.miller_restoration_done)],
            ["miller_akcja",
                Boolean(q.miller_restoration_done) &&
                q.razem_future_route == "akcja_socjalistyczna" &&
                Boolean(q.zandberg_project_active)],
            ["tak_dla_rozwoju",
                q.razem_future_route == "tak_dla_rozwoju" &&
                Boolean(q.matysiak_project_active)],
            ["biggest_tent",
                Boolean(q.p2050_joined_left) ||
                Boolean(q.p2050_social_joined_left) ||
                Boolean(q.rozwoj_joined_left) ||
                Boolean(q.ipl_joined_left) ||
                Boolean(q.greens_joined_left)],
            ["ground_game",
                number(q.media_capacity) + number(q.local_network) >= 110],
            ["miller_imprisoned",
                Boolean(q.miller_imprisonment_recorded) &&
                Boolean(q.leszek_miller_imprisoned)],
            ["pps_circle",
                Boolean(q.pps_party_formed) &&
                number(q.pps_party_seats) >= 3],
            ["club_collapse", Boolean(q.left_club_collapsed)],
            ["rownosc_founded", Boolean(q.rownosc_media_active)],
            ["ja_panu_nie_przerywalem",
                Boolean(q.hostile_policy_interview_done)],
            ["jest_pan_zerem",
                Boolean(q.miller_restoration_done) &&
                number(q.ziobro_world_tour_updates) >= 2],
            ["kurica_nie_ptica",
                Boolean(q.ukraine_neutrality_demanded)],
            ["ten_defections", number(q.individual_defections) >= 10],
            ["three_left_splits", number(q.organised_left_splits) >= 3],
            ["three_right_splits", rightSplitCount >= 3],
            ["cabinet_collapse",
                q.coalition_status == "Cabinet lost confidence" &&
                Boolean(q.caretaker_government)],
            ["piwo_z_mentzenem", q.pres_2025_torun_route == "democratic"],
            ["bedziesz_siedzial",
                q.nik_removal_response == "Immunity stripped"],
            ["szczesc_boze",
                q.braun_compulsion_strategy ==
                    "Pre-trial detention and one broad extremist case" &&
                q.braun_outcome ==
                    "Braun leaves Poland before the compelled appearance"],
            ["wniosek_formalny",
                q.marshal_2019_response == "Standing orders"],
            ["mokry_sen_kukiza",
                q.electoral_reform_stage == "enacted" &&
                (q.sejm_electoral_system == "mixed_230" ||
                    q.sejm_electoral_system == "fptp_460")],
            ["impossible_majority",
                terminal && q.ending_name == "The impossible majority"],
            ["red_tide",
                terminal && number(q.ending_family_vote) >= 20 &&
                number(q.ending_family_seats) > 0 &&
                number(q.ending_threshold_losses) == 0],
            ["below_threshold",
                terminal && q.ending_exit_type == "Voted out"],
            ["game_completed", terminal]
        ];
        const earned = [];
        for (const check of checks) {
            if (check[1] && q["game_achievement_" + check[0]] !== 1) {
                engine.achieve(check[0]);
                earned.push(check[0]);
            }
        }
        return earned;
    };
}
budgetHost.polandAchievementEvaluator(this, Q);
!}
