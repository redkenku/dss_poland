    if (
        typeof Q.advisor_slot_1_lock_reason != "string" ||
        !Q.advisor_slot_1_lock_reason.length
    ) {
        Q.advisor_slot_1_lock_reason = "None";
    }
    Q.miller_advisor = Number(Q.miller_advisor) === 1 ? 1 : 0;
    Q.miller_restoration_done =
        Number(Q.miller_restoration_done) === 1 ? 1 : 0;
    if (Q.advisor_slot_1_locked) {
        Q.advisor_slot_1 = "miller";
        Q.miller_advisor = 1;
    }
    const advisorRoster = [
        "miller",
        "czarzasty",
        "biedron",
        "zandberg",
        "dziemianowicz_bak",
        "zukowska",
        "kotula",
        "biejat",
