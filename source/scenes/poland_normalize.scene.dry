    }

    Q.media_capacity = clamp(Q.media_capacity, 0, 100);
    Q.local_network = clamp(Q.local_network, 0, 100);
    Q.labor_credibility = clamp(Q.labor_credibility, 0, 100);
    Q.progressive_credibility = clamp(Q.progressive_credibility, 0, 100);
    Q.opposition_budget_issue_ownership = clamp(
