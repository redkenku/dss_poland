    for (const quality of [
        "story_last_reach",
        "story_last_audience_trust",
        "story_last_messenger_credibility",
        "story_last_issue_salience",
        "story_last_left_credibility",
        "story_persuasion",
        "story_backlash",
        "story_salience_memory",
        "story_distrust_memory",
        "story_backlash_memory",
        "story_reputation_memory"
    ]) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? clamp(Q[quality], 0, 100)
            : 0;
    }
    for (const quality of [
        "story_last_frame",
        "story_last_signal",
        "story_mobilisation",
        "story_abstention",
        "story_issue_ownership"
    ]) {
        Q[quality] = Number.isFinite(Number(Q[quality]))
            ? clamp(Q[quality], -100, 100)
            : 0;
    }
    Q.story_contest_version = Math.max(
        1,
        Math.round(Number(Q.story_contest_version) || 1)
    );
    if (typeof Q.story_last_title !== "string") {
        Q.story_last_title = "No important story tested";
    }
    if (typeof Q.story_last_issue !== "string") {
        Q.story_last_issue = "None";
    }

    // Public-opinion migration. These defaults are used only when an old save
    // predates the issue model; authored event and card shifts are never
    // replaced once a track exists.
    const publicOpinionDefaults = {
        abortion_rights: [49, 42, 58],
        refugee_solidarity: [
            Number.isFinite(Number(Q.refugee_empathy))
                ? Number(Q.refugee_empathy)
                : 38,
            Q.border_2021_event_done ? 68 : 34,
            Q.border_2021_event_done ? 72 : 58
        ],
        border_security: [
            Number.isFinite(Number(Q.border_security_confidence))
                ? Math.max(55, Number(Q.border_security_confidence))
                : 70,
            Q.border_2021_event_done ? 76 : 44,
            Q.border_2021_event_done ? 60 : 36
        ],
        vaccination: [
            Q.vaccine_event_done ? 68 : 76,
            Q.vaccine_event_done ? 62 : 24,
            Q.vaccine_event_done ? 54 : 27
        ],
        social_spending: [72, 67, 38],
        lgbt_equality: [48, 52, 62],
        secular_state: [52, 43, 58],
        rule_of_law: [
            Number.isFinite(Number(Q.judicial_repair_mandate))
                ? Math.max(45, Number(Q.judicial_repair_mandate))
                : 58,
            56,
            52
        ],
        national_security: [
            Number.isFinite(Number(Q.military_trust))
                ? Math.max(60, Number(Q.military_trust))
                : 74,
            Q.ukraine_invasion_event_done ? 78 : 48,
            Q.ukraine_invasion_event_done ? 46 : 34
        ]
    };
    const publicOpinionIssues = Object.keys(publicOpinionDefaults);
    if (!Array.isArray(Q.public_opinion_issues)) {
        Q.public_opinion_issues = publicOpinionIssues.slice();
    } else {
        for (const issue of publicOpinionIssues) {
            if (!Q.public_opinion_issues.includes(issue)) {
                Q.public_opinion_issues.push(issue);
            }
        }
    }
    for (const issue of publicOpinionIssues) {
        const defaults = publicOpinionDefaults[issue];
        for (const measure of [
            ["support", defaults[0]],
            ["salience", defaults[1]],
            ["backlash", defaults[2]]
        ]) {
            const quality = issue + "_" + measure[0];
            if (!Number.isFinite(Number(Q[quality]))) {
                Q[quality] = measure[1];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
        const ownershipQuality = issue + "_left_ownership";
        if (!Number.isFinite(Number(Q[ownershipQuality]))) {
            Q[ownershipQuality] = Number(Q.issue_ownership) || 35;
        }
        Q[ownershipQuality] = clamp(Q[ownershipQuality], 0, 100);
    }
    Q.public_opinion_version = Math.max(
        2,
        Math.round(Number(Q.public_opinion_version) || 2)
    );
    let publicPanicTotal = 0;
    let publicConsensusTotal = 0;
    let hottestPublicIssue = publicOpinionIssues[0];
    let hottestPublicIssueScore = -1;
    const publicIssueLabels = {
        abortion_rights: "Abortion rights",
        refugee_solidarity: "Refugees and asylum solidarity",
        border_security: "Eastern-border security",
        vaccination: "Vaccination and public health",
        social_spending: "Social spending and public services",
        lgbt_equality: "LGBT equality",
        secular_state: "Secular state and schools",
        rule_of_law: "Rule-of-law repair",
        national_security: "Defence and allied security"
    };
    for (const issue of publicOpinionIssues) {
        const support = Number(Q[issue + "_support"]);
        const salience = Number(Q[issue + "_salience"]);
        const backlash = Number(Q[issue + "_backlash"]);
        const heat = salience * 0.65 + backlash * 0.35;
        publicPanicTotal += heat;
        publicConsensusTotal +=
            Math.abs(support - 50) * 2 * (1 - backlash / 200);
        if (heat > hottestPublicIssueScore) {
            hottestPublicIssueScore = heat;
            hottestPublicIssue = issue;
        }
    }
    Q.public_panic_index = Math.round(
        publicPanicTotal / publicOpinionIssues.length
    );
    Q.public_consensus_index = Math.round(
        publicConsensusTotal / publicOpinionIssues.length
    );
    Q.public_opinion_hottest_issue =
        publicIssueLabels[hottestPublicIssue];
    // Climate trend defaults, so old saves and the pre-first-month state read
    // the same qualities the monthly model writes.
    let progressiveTotal = 0;
    let ownershipTotal = 0;
    const progressiveFields = [
        "abortion_rights", "lgbt_equality", "secular_state",
        "refugee_solidarity"
    ];
    for (const field of progressiveFields) {
        progressiveTotal += clamp(Q[field + "_support"], 0, 100);
        ownershipTotal += clamp(Q[field + "_left_ownership"], 0, 100);
    }
    Q.public_climate_progressive_index =
        progressiveTotal / progressiveFields.length;
    Q.public_climate_left_ownership_index =
        ownershipTotal / progressiveFields.length;
    if (!Number.isFinite(Number(Q.public_climate_progressive_trend))) {
        Q.public_climate_progressive_trend = 0;
    }
    const climateTrend = Number(Q.public_climate_progressive_trend);
    Q.public_climate_direction = climateTrend >= 1.6
        ? "progressive wave"
        : (climateTrend >= 0.5
            ? "slow liberalisation"
            : (climateTrend <= -1.6
                ? "reactionary surge"
                : (climateTrend <= -0.5
                    ? "conservative drift"
                    : "settled trench")));
    Q.public_climate_band =
        Q.public_climate_progressive_index >= 58
            ? "permissive"
            : (Q.public_climate_progressive_index >= 50
                ? "balanced"
                : (Q.public_climate_progressive_index >= 43
                    ? "resistant"
                    : "hostile"));
    Q.public_climate_report =
        "National climate: " + Q.public_climate_band + " terrain, " +
        Q.public_climate_direction + ". Hottest field: " +
        Q.public_opinion_hottest_issue + ".";
    if (!Number.isFinite(Number(Q.public_climate_media_bonus))) {
        Q.public_climate_media_bonus = 0;
    }
    Q.public_climate_media_bonus = clamp(Q.public_climate_media_bonus, -6, 6);
    Q.public_opinion_last_delta = Number.isFinite(
        Number(Q.public_opinion_last_delta)
    )
        ? Number(Q.public_opinion_last_delta)
        : 0;
    Q.public_opinion_bridge_pressure = Number.isFinite(
        Number(Q.public_opinion_bridge_pressure)
    )
        ? clamp(Q.public_opinion_bridge_pressure, 0, 100)
        : 0;
    if (
        typeof Q.public_opinion_hottest_issue !== "string" ||
        !Q.public_opinion_hottest_issue.length
    ) {
        Q.public_opinion_hottest_issue =
            "Social spending and public services";
    }
    if (
        typeof Q.public_opinion_last_issue !== "string" ||
        !Q.public_opinion_last_issue.length
    ) {
        Q.public_opinion_last_issue = "None";
    }
    if (
        typeof Q.public_opinion_last_reception !== "string" ||
        !Q.public_opinion_last_reception.length
    ) {
        Q.public_opinion_last_reception = "No recent test";
    }
    if (
        typeof Q.public_opinion_last_action !== "string" ||
        !Q.public_opinion_last_action.length
    ) {
        Q.public_opinion_last_action = "No public-opinion test yet";
    }
    if (
        typeof Q.public_opinion_last_updated !== "string" ||
        !Q.public_opinion_last_updated.length
    ) {
        Q.public_opinion_last_updated =
            (Q.date_label || "Current month") + " model";
    }
    if (
        !["breakthrough", "favourable", "contested", "backlash", "reversal"]
            .includes(Q.card_public_response)
    ) {
        Q.card_public_response = "contested";
    }
    Q.card_public_response_score = Number.isFinite(
        Number(Q.card_public_response_score)
    )
        ? clamp(Q.card_public_response_score, -3, 3)
        : 0;
    const publicBridgeSources = {
        feminist_trust: 44,
        refugee_empathy: 58,
        border_confidence: 48,
        border_rights: 45,
        far_right_agenda: 32,
        minority_safety: 56,
        household_security: 45,
        health_capacity: 48,
        pandemic_pressure: 0,
        anti_ukrainian: 8,
        judicial_legitimacy: 36,
        repair_mandate: 38,
        military_trust: 66,
        police_trust: 45,
        refugee_services: 0
    };
    const publicBridgeCurrent = {
        feminist_trust: Q.feminist_trust,
        refugee_empathy: Q.refugee_empathy,
        border_confidence: Q.border_security_confidence,
        border_rights: Q.border_rights_standard,
        far_right_agenda: Q.far_right_agenda,
        minority_safety: Q.minority_safety,
        household_security: Q.household_security,
        health_capacity: Q.health_capacity,
        pandemic_pressure: Q.pandemic_deaths_pressure,
        anti_ukrainian: Q.anti_ukrainian_pressure,
        judicial_legitimacy: Q.judicial_legitimacy,
        repair_mandate: Q.judicial_repair_mandate,
        military_trust: Q.military_trust,
        police_trust: Q.police_trust,
        refugee_services: Q.refugee_service_capacity
    };
    if (!Number(Q.public_bridge_initialized)) {
        // Begin observing an old save at its current state. This prevents a
        // migration from replaying years of historical changes as one shock.
        for (const bridge of Object.keys(publicBridgeSources)) {
            const current = Number(publicBridgeCurrent[bridge]);
            Q["public_bridge_" + bridge] = Number.isFinite(current)
                ? current
                : publicBridgeSources[bridge];
        }
        Q.public_bridge_initialized = 1;
    } else {
        for (const bridge of Object.keys(publicBridgeSources)) {
            const quality = "public_bridge_" + bridge;
            if (!Number.isFinite(Number(Q[quality]))) {
                const current = Number(publicBridgeCurrent[bridge]);
                Q[quality] = Number.isFinite(current)
                    ? current
                    : publicBridgeSources[bridge];
            }
            Q[quality] = clamp(Q[quality], 0, 100);
        }
    }
    publicMoodHost.polandPublicMoodModel.normalize(Q);

    Q.workers_support = clamp(Q.workers_support, 0, 100);
    Q.public_sector_support = clamp(Q.public_sector_support, 0, 100);
    Q.young_support = clamp(Q.young_support, 0, 100);
    Q.women_support = clamp(Q.women_support, 0, 100);
    Q.urban_progressive_support =
        clamp(Q.urban_progressive_support, 0, 100);
    Q.rural_support = clamp(Q.rural_support, 0, 100);
    Q.pensioner_support = clamp(Q.pensioner_support, 0, 100);
    Q.turnout_readiness = clamp(Q.turnout_readiness, 0, 100);

    const foreignNumericDefaults = {
        eu_campaign_progress: 0,
        eu_campaign_complete: 0,
        eu_brussels_mission: 0,
        eu_social_mission: 0,
        eu_eastern_mission: 0,
        eu_influence: 28,
        eu_institutional_trust: 26,
        eu_left_network: 20,
        eu_progressive_headwind: 0,
        eu_right_shift_done: 0,
        western_economic_drag: 0,
        western_economic_shock_done: 0,
        hungary_relation: 42,
        hungary_democratic_network: 12,
        hungary_fidesz_channel: 40,
        hungary_fidesz_in_power: 1,
        hungary_election_2022_done: Q.year > 2022 ? 1 : 0,
        hungary_election_2026_done: 0,
        hungary_election_2026_score: 0,
        hungary_tisza_seats: 0,
        hungary_fidesz_seats: 0,
        ziobro_whereabouts_stage: 0,
        ziobro_whereabouts_due_time: -1,
        ziobro_whereabouts_updates: 0,
        ziobro_world_tour_updates: 0,
        foreign_pressure: 18,
        foreign_cards_resolved: 0,
        foreign_ministry_override_risk: 0,
        foreign_portfolio_resistance: 0,
        foreign_policy_responsibility: 0,
        us_alliance_reliability: 48,
        us_rule_of_law_pressure: 12,
        us_ambassador_channel: 44,
        us_defence_channel: 62,
        us_congress_channel: 40,
        left_atlanticist_dissent: 10,
        us_election_2020_done: Q.year > 2020 ? 1 : 0,
        us_2020_roll: 0,
        us_2020_democratic_vote: Q.year > 2020 ? 51.3 : 0,
        us_2020_republican_vote: Q.year > 2020 ? 48.7 : 0,
        us_election_2024_done: Q.year > 2024 ? 1 : 0,
        us_2024_roll: 0,
        us_2024_democratic_vote: Q.year > 2024 ? 48.4 : 0,
        us_2024_republican_vote: Q.year > 2024 ? 51.6 : 0
    };
    for (const quality of Object.keys(foreignNumericDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = foreignNumericDefaults[quality];
        }
    }

    // CPK and the nuclear programme are long capital projects rather than
    // single votes: scope, ownership, labour standards, local grievance and
    // cost run for years across separate dated events, so they need a stable
    // ledger instead of one "infrastructure" score.
    const infrastructureNumericDefaults = {
        cpk_stage: 0,
        cpk_audit_open: 0,
        cpk_audit_scrutiny_done: 0,
        cpk_transparency: 0,
        cpk_opposition_terms: 0,
        cpk_ownership_rollcall: 0,
        cpk_public_works: 0,
        cpk_cancelled: 0,
        cpk_rail_priority: 20,
        cpk_public_ownership: 40,
        cpk_labour_standard: 10,
        cpk_land_conflict: 12,
        cpk_delivery: 0,
        cpk_cost_pressure: 10,
        cpk_left_credit: 0,
        nuclear_stage: 0,
        nuclear_shelved: 0,
        nuclear_priority: 50,
        nuclear_public_ownership: 50,
        nuclear_price_shield: 0,
        nuclear_labour_standard: 10,
        nuclear_just_transition: 0,
        nuclear_site_conflict: 10,
        nuclear_delivery: 0,
        nuclear_cost_pressure: 10,
        nuclear_left_credit: 0,
        nuclear_ownership_rollcall: 0
    };
    for (const quality of Object.keys(infrastructureNumericDefaults)) {
        if (!Number.isFinite(Number(Q[quality]))) {
            Q[quality] = infrastructureNumericDefaults[quality];
        }
    }
    Q.cpk_rail_priority = clamp(Q.cpk_rail_priority, 0, 100);
    Q.cpk_public_ownership = clamp(Q.cpk_public_ownership, 0, 100);
    Q.cpk_labour_standard = clamp(Q.cpk_labour_standard, 0, 100);
    Q.cpk_land_conflict = clamp(Q.cpk_land_conflict, 0, 100);
    Q.cpk_delivery = clamp(Q.cpk_delivery, 0, 100);
    Q.cpk_cost_pressure = clamp(Q.cpk_cost_pressure, 0, 100);
    Q.cpk_left_credit = clamp(Q.cpk_left_credit, -30, 60);
    Q.nuclear_priority = clamp(Q.nuclear_priority, 0, 100);
    Q.nuclear_public_ownership = clamp(Q.nuclear_public_ownership, 0, 100);
    Q.nuclear_price_shield = clamp(Q.nuclear_price_shield, 0, 100);
    Q.nuclear_labour_standard = clamp(Q.nuclear_labour_standard, 0, 100);
    Q.nuclear_just_transition = clamp(Q.nuclear_just_transition, 0, 100);
    Q.nuclear_site_conflict = clamp(Q.nuclear_site_conflict, 0, 100);
    Q.nuclear_delivery = clamp(Q.nuclear_delivery, 0, 100);
    Q.nuclear_cost_pressure = clamp(Q.nuclear_cost_pressure, 0, 100);
    Q.nuclear_left_credit = clamp(Q.nuclear_left_credit, -30, 60);
    const infrastructureStringDefaults = {
        cpk_scope: "Programme inherited from the previous government",
        cpk_left_position: "No settled Lewica line on the hub programme",
        cpk_compensation_model: "Statutory valuations under the special act",
        cpk_financing_model: "No settled financing model",
        cpk_settlement: "The programme has not yet met an electorate",
        cpk_public_verdict: "No settled public verdict on the site",
        nuclear_position: "No settled Lewica line on the nuclear programme",
        nuclear_financing_model: "No settled financing model",
        nuclear_second_plant: "No decision on a second plant",
        nuclear_settlement: "The programme has not yet met an electorate",
        nuclear_bill_verdict: "No settled tariff outcome"
    };
    for (const quality of Object.keys(infrastructureStringDefaults)) {
        if (typeof Q[quality] != "string" || !Q[quality]) {
            Q[quality] = infrastructureStringDefaults[quality];
        }
    }
    Q.ziobro_whereabouts_stage = Math.round(clamp(
        Q.ziobro_whereabouts_stage, 0, 6
    ));
    Q.ziobro_whereabouts_updates = Math.max(
        0, Math.round(Q.ziobro_whereabouts_updates)
    );
    Q.ziobro_world_tour_updates = Math.round(clamp(
        Q.ziobro_world_tour_updates, 0, 2
    ));
    if (typeof Q.ziobro_whereabouts_last != "string") {
        Q.ziobro_whereabouts_last = "No post-government sighting";
    }
    if (typeof Q.ziobro_rumor_country != "string") {
        Q.ziobro_rumor_country = "";
    }
    const foreignMissionFlags = [
        "eu_campaign_complete",
        "eu_brussels_mission",
        "eu_social_mission",
        "eu_eastern_mission",
        "eu_right_shift_done",
        "western_economic_shock_done",
        "hungary_fidesz_in_power",
        "hungary_election_2022_done",
        "hungary_election_2026_done",
        "us_election_2020_done",
        "us_election_2024_done"
    ];
    for (const flag of foreignMissionFlags) {
        Q[flag] = Q[flag] ? 1 : 0;
    }
    Q.eu_campaign_progress = Math.max(
        Number(Q.eu_campaign_progress) || 0,
        Q.eu_brussels_mission +
            Q.eu_social_mission +
            Q.eu_eastern_mission
    );
    Q.eu_campaign_progress = Math.max(
        0,
        Math.min(3, Math.round(Q.eu_campaign_progress))
    );
    Q.eu_influence = clamp(Q.eu_influence, 0, 100);
    Q.eu_institutional_trust =
        clamp(Q.eu_institutional_trust, 0, 100);
    Q.eu_left_network = clamp(Q.eu_left_network, 0, 100);
    Q.eu_progressive_headwind = clamp(
        Q.eu_progressive_headwind, 0, 20
    );
    Q.western_economic_drag = clamp(
        Q.western_economic_drag, 0, 20
    );
    Q.hungary_relation = clamp(Q.hungary_relation, 0, 100);
    Q.hungary_democratic_network = clamp(
        Q.hungary_democratic_network, 0, 100
    );
    Q.hungary_fidesz_channel = clamp(
        Q.hungary_fidesz_channel, 0, 100
    );
    Q.foreign_pressure = clamp(Q.foreign_pressure, 0, 100);
    Q.foreign_cards_resolved = Math.max(
        0,
        Math.round(Q.foreign_cards_resolved)
    );
    Q.foreign_ministry_override_risk = clamp(
        Q.foreign_ministry_override_risk,
        0,
        100
    );
    Q.foreign_portfolio_resistance = clamp(
        Q.foreign_portfolio_resistance,
        0,
        100
    );
    Q.foreign_policy_responsibility = clamp(
        Q.foreign_policy_responsibility,
        0,
        100
    );
    Q.us_alliance_reliability =
        clamp(Q.us_alliance_reliability, 0, 100);
    Q.us_rule_of_law_pressure =
        clamp(Q.us_rule_of_law_pressure, 0, 100);
    Q.us_ambassador_channel = clamp(Q.us_ambassador_channel, 0, 100);
    Q.us_defence_channel = clamp(Q.us_defence_channel, 0, 100);
    Q.us_congress_channel = clamp(Q.us_congress_channel, 0, 100);
    Q.left_atlanticist_dissent =
        clamp(Q.left_atlanticist_dissent, 0, 100);
    Q.western_economic_access = Math.round(clamp(
        Number(Q.eu_institutional_trust) * 0.55 +
            Number(Q.us_alliance_reliability) * 0.45,
        0,
        100
    ));
    Q.us_2020_roll = clamp(Q.us_2020_roll, 0, 1);
    Q.us_2024_roll = clamp(Q.us_2024_roll, 0, 1);
    Q.us_2020_democratic_vote =
        clamp(Q.us_2020_democratic_vote, 0, 100);
    Q.us_2020_republican_vote =
        clamp(Q.us_2020_republican_vote, 0, 100);
    Q.us_2024_democratic_vote =
        clamp(Q.us_2024_democratic_vote, 0, 100);
    Q.us_2024_republican_vote =
        clamp(Q.us_2024_republican_vote, 0, 100);
    if (
        typeof Q.us_election_2020_winner !== "string" ||
        !Q.us_election_2020_winner.length
    ) {
        Q.us_election_2020_winner =
            Q.year > 2020 ? "Joe Biden" : "Undecided";
    }
    if (
        typeof Q.us_election_2024_winner !== "string" ||
        !Q.us_election_2024_winner.length
    ) {
        Q.us_election_2024_winner =
            Q.year > 2024 ? "Donald Trump" : "Undecided";
    }
    if (
        typeof Q.us_2024_republican_candidate !== "string" ||
        !Q.us_2024_republican_candidate.length ||
        Q.us_2024_republican_candidate == "Republican successor"
    ) {
        Q.us_2024_republican_candidate =
            Q.us_election_2020_winner == "Donald Trump"
                ? "Nikki Haley"
                : "Donald Trump";
    }
    if (Q.us_election_2024_winner == "Republican successor") {
        Q.us_election_2024_winner = Q.us_2024_republican_candidate;
    }
    if (Q.us_president == "Republican successor") {
        Q.us_president = Q.us_2024_republican_candidate;
    }
    if (
        typeof Q.us_president !== "string" ||
        !Q.us_president.length
    ) {
        Q.us_president = Q.year > 2024
            ? Q.us_election_2024_winner
            : (Q.year > 2020 ? Q.us_election_2020_winner : "Donald Trump");
    }
    if (
        typeof Q.us_administration !== "string" ||
        !Q.us_administration.length
    ) {
        Q.us_administration =
            Q.us_president == "Joe Biden" ||
            Q.us_president == "Kamala Harris"
                ? "Democratic"
                : "America First";
    }
    if (typeof Q.hungary_election_2022_result != "string") {
        Q.hungary_election_2022_result = Q.hungary_election_2022_done
            ? "Fidesz–KDNP 135 seats · United for Hungary 57"
            : "Not held";
    }
    if (typeof Q.hungary_election_2026_result != "string") {
        Q.hungary_election_2026_result = "Not held";
    }
    if (typeof Q.hungary_government != "string") {
        Q.hungary_government = Q.hungary_fidesz_in_power
            ? "Viktor Orbán — Fidesz–KDNP"
            : "Péter Magyar — Tisza";
    }
    if (Q.eu_campaign_complete) {
        Q.eu_campaign_stage =
            "Polish EU settlement — funds, democratic law and social investment";
    } else if (Q.eu_campaign_progress >= 3) {
        Q.eu_campaign_stage =
            "Three working channels — democratic, social and Ukraine";
    } else if (Q.eu_campaign_progress == 2) {
        Q.eu_campaign_stage =
            "Two working EU channels";
    } else if (Q.eu_campaign_progress == 1) {
        Q.eu_campaign_stage =
            "First working EU channel";
    } else {
