    );
    Q.reform_pressure_illegality = clamp(
        Q.reform_pressure_illegality, 0, 100
    );
    Q.anticlerical_edge = clamp(Q.anticlerical_edge, 0, 100);

    // An enacted historical settlement closes that issue's campaign. The
    // number records how far the original ambitious bill was forced down; it
    // is an outcome, not a rung that unlocks another card later.
    if (!Q.abortion_reform_settled && Q.abortion_law_enacted) {
        Q.abortion_reform_stage = Math.max(Q.abortion_reform_stage, 2);
    }
    if (
        !Q.abortion_reform_settled &&
        Q.trz_rights_bill == "Abortion-law restoration" &&
        Q.trz_rights_bill_outcome == "Passed and signed"
    ) {
        Q.abortion_reform_stage = Math.max(Q.abortion_reform_stage, 3);
    }
    if (!Q.marriage_reform_settled && Q.partnership_revision_enacted) {
        Q.marriage_reform_stage = Math.max(Q.marriage_reform_stage, 1);
    }
    if (
        !Q.marriage_reform_settled &&
        (
            Q.partnership_presidential_outcome == "Signed" ||
            Q.partnership_implementation_complete
        )
    ) {
        Q.marriage_reform_stage = Math.max(Q.marriage_reform_stage, 3);
    }
    if (
        !Q.marriage_reform_settled &&
        Q.trz_rights_bill == "Marriage equality" &&
        Q.trz_rights_bill_outcome == "Passed and signed"
    ) {
        Q.marriage_reform_stage = 4;
    }
    if (!Q.labor_reform_settled && Q.pip_law_enacted) {
        Q.labor_reform_stage = Math.max(Q.labor_reform_stage, 2);
    }
    for (const issue of majorReformIssues) {
        if (Q[issue + "_reform_stage"] > 0) {
            Q[issue + "_reform_defined"] = 1;
            Q[issue + "_reform_settled"] = 1;
            Q[issue + "_reform_proposal_stage"] =
                Q[issue + "_reform_stage"];
        }
    }
    // The programme closes when every reform the party actually chose has a
    // settlement, not when all nine fields are legislated. Ten years buys three
    // fights.
    let slatePicked = 0;
    let slateSettled = 0;
    let slateWeight = 0;
    for (const issue of majorReformIssues) {
        if (!Q[issue + "_on_slate"]) {
            continue;
        }
        slatePicked += 1;
        if (Q[issue + "_reform_settled"]) {
