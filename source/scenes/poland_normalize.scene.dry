                Q[affinityKey] = Number.isFinite(
                    Number(Q[affinityKey])
                )
                    ? clamp(Q[affinityKey], -20, 20)
                    : 0;
            }
        }
        Q[group + "_left"] = clamp(Q[group + "_left"], 0, 100);
    }
    for (const party of [
        "left", "pis", "ko", "psl", "konf", "p2050", "p0"
    ]) {
        if (Number.isFinite(Number(Q[party + "_economic_position"]))) {
            Q[party + "_economic_position"] =
                clamp(Q[party + "_economic_position"], 0, 100);
        }
        if (Number.isFinite(Number(Q[party + "_cultural_position"]))) {
            Q[party + "_cultural_position"] =
                clamp(Q[party + "_cultural_position"], 0, 100);
        }
        if (Number.isFinite(Number(Q[party + "_social_position"]))) {
            Q[party + "_social_position"] =
                clamp(Q[party + "_social_position"], 0, 100);
        }
    }

    // Rival ideology is hidden simulation state. Old saves may not contain
