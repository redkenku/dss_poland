                : "Donald Trump";
    }
    if (
        typeof Q.us_president !== "string" ||
        !Q.us_president.length
    ) {
        Q.us_president = Q.year > 2024
            ? Q.us_election_2024_winner
            : (Q.year > 2020 ? Q.us_election_2020_winner : "Donald Trump");
    }
    if (
        typeof Q.us_administration !== "string" ||
        !Q.us_administration.length
    ) {
        Q.us_administration =
            Q.us_president == "Joe Biden" ||
            Q.us_president == "Kamala Harris"
                ? "Democratic"
                : "America First";
    }
    if (Q.eu_campaign_complete) {
        Q.eu_campaign_stage =
