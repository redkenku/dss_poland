            ) + conversion + ownership * 0.06;
            state.womens_strike_conservative_backlash = finiteMood(
                state.womens_strike_conservative_backlash, 24
            ) + conservative + backlash * 0.10;
        }
        return Object.assign({}, effect, {
            mode: "delta",
            issue: issue,
            bloc: signal < 0 ? "conservative" : (effect.bloc || "progressive"),
            support: persuasion * 0.08 - backlash * 0.035,
            salience: Math.abs(signal) * 0.38,
            backlash: backlash * 0.15,
            blocOwnership: Math.abs(ownership) * 0.18,
            leftOwnership: ownership * 0.24,
            resolvedSignal: signal
        });
    };
    const applyEffect = function(state, rawEffect) {
        if (rawEffect.mode == "story" && rawEffect.kind &&
            !knownStoryKinds.includes(rawEffect.kind)) {
            state.public_mood_invalid_effects =
                finiteMood(state.public_mood_invalid_effects, 0) + 1;
            return;
        }
        const effect = rawEffect.mode == "story"
            ? resolveStory(state, rawEffect) : rawEffect;
        const issue = String(effect.issue || "");
        if (!moodIssues[issue]) {
            state.public_mood_invalid_effects =
                finiteMood(state.public_mood_invalid_effects, 0) + 1;
            return;
        }
        const bloc = ["progressive", "centrist", "conservative"]
            .includes(effect.bloc) ? effect.bloc : "centrist";
        state[issue + "_support"] = clampMood(
            state[issue + "_support"] + finiteMood(effect.support, 0), 0, 100
        );
        state[issue + "_salience"] = clampMood(
            state[issue + "_salience"] + finiteMood(effect.salience, 0), 0, 100
        );
        state[issue + "_backlash"] = clampMood(
            state[issue + "_backlash"] + finiteMood(effect.backlash, 0), 0, 100
        );
        state[issue + "_left_ownership"] = clampMood(
            state[issue + "_left_ownership"] +
                finiteMood(effect.leftOwnership, 0), 0, 100
        );
        transferOwnership(
            state, issue, bloc, finiteMood(effect.blocOwnership, 0)
        );
        const publicDelta = finiteMood(effect.support, 0) -
            Math.max(0, finiteMood(effect.backlash, 0)) * 0.35;
        state.public_opinion_last_issue = effect.label || moodLabels[issue];
        state.public_opinion_last_action = effect.title || "Public mood shift";
        state.public_opinion_last_delta = Math.round(publicDelta * 10) / 10;
        state.public_opinion_last_reception = publicDelta >= 1
            ? "favourable" : (publicDelta <= -1 ? "backlash" : "contested");
        state.public_mood_effect_log.push({
            id: effect.id || "mood-effect",
            month: moodMonthKey(state), source: effect.source || "event",
            actor: effect.actor || "none", bloc: bloc, issue: issue,
            title: effect.title || "Public mood shift",
            support: Math.round(finiteMood(effect.support, 0) * 10) / 10,
            salience: Math.round(finiteMood(effect.salience, 0) * 10) / 10,
            backlash: Math.round(finiteMood(effect.backlash, 0) * 10) / 10,
            blocOwnership:
                Math.round(finiteMood(effect.blocOwnership, 0) * 10) / 10,
            leftOwnership:
                Math.round(finiteMood(effect.leftOwnership, 0) * 10) / 10
        });
        while (state.public_mood_effect_log.length > 18) {
            state.public_mood_effect_log.shift();
        }
    };
    const supportTarget = function(state, issue) {
        const config = moodIssues[issue];
        const baseline = baselineFor(state, issue);
        const driverBaseline = driverBaselines[scenarioId(state)];
        let movement = 0;
        for (const driver of config.drivers) {
            let driverMovement =
                finiteMood(state[driver[0]], driverBaseline[driver[0]]) -
                finiteMood(driverBaseline[driver[0]], 50);
            if (driver[0] == "migration_empathy") {
                driverMovement = (driverMovement +
                    finiteMood(state.refugee_empathy,
                        driverBaseline.refugee_empathy) -
                    finiteMood(driverBaseline.refugee_empathy, 50)) / 2;
            }
            movement += driver[1] * driverMovement;
        }
        return clampMood(
            baseline[0] + 0.25 * movement / config.drivers.length,
            15, 90
        );
    };
    const moveToward = function(value, target, rate, cap) {
        return value + clampMood((target - value) * rate, -cap, cap);
    };
    const advanceMood = function(state) {
        state.story_salience_memory =
            clampMood(state.story_salience_memory, 0, 100) * 0.78;
        state.story_distrust_memory =
            clampMood(state.story_distrust_memory, 0, 100) * 0.975;
        state.story_backlash_memory =
            clampMood(state.story_backlash_memory, 0, 100) * 0.985;
        state.story_reputation_memory =
            clampMood(state.story_reputation_memory, 0, 100) * 0.992;
        const driverSnapshot = driverBaselines[scenarioId(state)];
        let bridgePressure = 0;
        for (const driver of Object.keys(driverSnapshot)) {
            const key = "public_mood_driver_" + driver;
            const current = finiteMood(state[driver], driverSnapshot[driver]);
            const previous = finiteMood(state[key], current);
            bridgePressure += Math.abs(current - previous);
            state[key] = current;
        }
        state.public_opinion_bridge_pressure = Math.round(
            bridgePressure * 10 /
                Math.max(1, Object.keys(driverSnapshot).length)
        ) / 10;
        for (const issue of Object.keys(moodIssues)) {
            const baseline = baselineFor(state, issue);
            state[issue + "_support"] = moveToward(
                state[issue + "_support"], supportTarget(state, issue),
                0.025, 0.75
            );
            state[issue + "_salience"] = moveToward(
                state[issue + "_salience"], baseline[1], 0.05, 1.5
            );
            const centrist = clampMood(
                state[issue + "_centrist_ownership"], 0, 100
            );
            const backlashTarget = clampMood(
                20 + state[issue + "_salience"] * 0.25 +
                Math.abs(state[issue + "_support"] - 50) * 0.35 +
                Math.max(0, 40 - centrist) * 0.25,
                15, 85
            );
            state[issue + "_backlash"] = moveToward(
                state[issue + "_backlash"], backlashTarget, 0.04, 1.5
            );
            const doctrineBonus = state.spring_path_stage >= 2 &&
                state.spring_path_route == "social_liberal" &&
                ["abortion_rights", "lgbt_equality", "secular_state"]
                    .includes(issue) ? 8 : 0;
            state[issue + "_left_ownership"] = moveToward(
                state[issue + "_left_ownership"],
                clampMood(baseline[3] + doctrineBonus, 0, 100), 0.01, 0.6
            );
            for (let index = 0; index < 3; index += 1) {
                const bloc = ["progressive", "centrist", "conservative"][index];
                const key = issue + "_" + bloc + "_ownership";
                state[key] = moveToward(state[key], baseline[index + 4], 0.01, 0.6);
            }
            normalizeOwnership(state, issue);
        }
    };
    const resolveMood = function(state, options) {
        normalizeMood(state);
        const settings = options || {};
        const key = moodMonthKey(state);
        if (settings.advance && state.public_mood_last_advanced_month_key != key) {
            advanceMood(state);
            state.public_mood_last_advanced_month_key = key;
        }
        const effects = state.public_mood_effect_queue.slice();
        state.public_mood_effect_queue = [];
        for (const effect of effects) applyEffect(state, effect || {});
        aggregateMood(state);
        if (settings.finalize && state.public_mood_finalized_month_key != key) {
            const previous = finiteMood(
                state.public_climate_previous_index,
                state.public_climate_progressive_index
            );
            state.public_climate_progressive_trend =
                finiteMood(state.public_climate_progressive_trend, 0) * 0.88 +
                (state.public_climate_progressive_index - previous);
            state.public_climate_previous_index =
                state.public_climate_progressive_index;
            state.public_mood_finalized_month_key = key;
            state.public_climate_media_bonus = Math.round(clampMood(
                state.public_climate_progressive_trend * 2.2, -6, 6
            ));
            aggregateMood(state);
        }
        state.public_opinion_last_updated =
            (state.date_label || "Current month") + " dynamic model";
        snapshotMood(state);
        return effects.length;
    };
    publicMoodHost.polandPublicMoodModel = {
        issues: moodIssues,
        labels: moodLabels,
        storyKinds: knownStoryKinds,
        normalize: normalizeMood,
        enqueue: enqueueMood,
        resolve: resolveMood,
        aggregate: aggregateMood
    };
}
if (Q.started) {
    const clamp = function(value, low, high) {
        if (!Number.isFinite(Number(value))) {
            return low;
        }
        return Math.max(low, Math.min(high, value));
    };
    const clampIfPresent = function(quality, low, high) {
        if (Number.isFinite(Number(Q[quality]))) {
            Q[quality] = clamp(Number(Q[quality]), low, high);
        }
    };

    // SPS is Miller-exclusive. Migrate either half of the Stage 4 contract
    // before any route-dependent names or leaders are normalised.
    const earlyMillerRestoration =
        Number(Q.miller_restoration_done) === 1 ||
        Q.old_left_route_state === "miller_restoration";
    if (earlyMillerRestoration) {
        Q.miller_restoration_done = 1;
        Q.old_left_route_state = "miller_restoration";
    } else if (Number(Q.sld_populist_route_active) === 1) {
        Q.sld_populist_route_active = 0;
    }

    // Repair saves that advanced past the July 2021 routing race with Budka
    // still in office. The response choice cannot be reconstructed, but the
    // historical leadership change and its shared organisational effects can.
    if (
        !Number(Q.tusk_return_2021_done) &&
        (Number(Q.year) > 2021 ||
            (Number(Q.year) === 2021 && Number(Q.month) > 7)) &&
        Q.ko_leader === "Borys Budka" &&
        Q.ko_alternative_2021_outcome !== "Tusk does not return"
    ) {
        Q.tusk_return_2021_done = 1;
        Q.ko_outgoing_leader = "Borys Budka";
        Q.ko_leader = "Donald Tusk";
        Q.ko_incoming_bloc =
            "PO's founding apparatus, parliamentary managers and anti-PiS two-bloc strategists";
        Q.ko_org_resources = (Number(Q.ko_org_resources) || 0) + 3;
        Q.ko_poll_momentum = (Number(Q.ko_poll_momentum) || 0) + 1.5;
        Q.ko_coalition_dissent =
            (Number(Q.ko_coalition_dissent) || 0) + 3;
        Q.ko_right_score = (Number(Q.ko_right_score) || 0) + 12;
        Q.ko_social_liberal_share =
            (Number(Q.ko_social_liberal_share) || 0) - 12;
        Q.ko_classical_liberal_share =
            (Number(Q.ko_classical_liberal_share) || 0) + 12;
    }

    // Old saves could retain the historical Razem candidacy after making
    // Zandberg the common nominee. One person can occupy only one ballot row.
    if (Q.pres_2025_left_candidate == "Adrian Zandberg") {
        Q.pres_2025_candidate = "Adrian Zandberg";
        Q.pres_2025_united_left = 1;
        Q.pres_2025_razem_candidate = "None";
    } else if (Q.pres_2025_united_left) {
        Q.pres_2025_razem_candidate = "None";
    }

    // Major reforms are persistent projects rather than one-off cabinet
    // cards. Explicit defaults keep old saves safe when raw JavaScript reads
    // progress, commitments or a pending coalition dispute.
    // Nine reform fields exist, one per public-mood issue, but a ten-year
    // campaign cannot carry them all. The slate is the scarcity: three picks,
    // chosen once, for the whole game.
    const majorReformIssues = [
        "abortion", "marriage", "church", "asylum", "border",
        "defence", "labor", "health", "courts"
    ];
    const majorReformDefaults = {
        reform_slate_max: 3,
        reform_slate_count: 0,
        reform_slate_closed: 0,
        reform_pressure_rounds: 0,
        reform_pressure_pending: 0,
        reform_pressure_actor_live: 0,
        reform_pressure_authority_live: 0,
        reform_pressure_intensity: 0,
        reform_pressure_illegality: 0,
        reform_pressure_target_stage: 0,
        reform_pressure_previous_stage: 0,
        reform_pressure_palace_override: 0,
        reform_pressure_referendum_used: 0,
        reform_pressure_bargain_available: 0,
        reform_pressure_override_votes: 0,
        reform_pressure_override_available: 0,
        reform_pressure_abandoned: 0,
        reform_pressure_cooldown: 0,
        reform_pressure_due_time: -1,
        reform_pressure_demands: 0,
        reform_pressure_objections: 0,
        major_reforms_complete: 0,
        coalition_judicial_pressure_concessions: 0,
        coalition_media_takeover_concessions: 0,
        marketisation_concessions: 0,
        pegasus_legal_framework: 0,
        anticlerical_edge: 70,
        pzpr_history_concessions: 0
    };
    for (const issue of majorReformIssues) {
        majorReformDefaults["poland_" + issue + "_reform_timer"] = 0;
        majorReformDefaults[issue + "_reform_stage"] = 0;
        majorReformDefaults[issue + "_reform_defined"] = 0;
        majorReformDefaults[issue + "_reform_goal_stage"] = 4;
        majorReformDefaults[issue + "_reform_proposal_stage"] = 4;
        majorReformDefaults[issue + "_reform_settled"] = 0;
        majorReformDefaults[issue + "_reform_progress"] = 0;
        majorReformDefaults[issue + "_reform_power"] = 0;
        majorReformDefaults[issue + "_reform_threshold"] = 0;
        majorReformDefaults[issue + "_reform_next_stage"] = 4;
        majorReformDefaults[issue + "_reform_abandoned"] = 0;
        majorReformDefaults[issue + "_on_slate"] = 0;
        majorReformDefaults[issue + "_referendum_mandate"] = 0;
        majorReformDefaults[issue + "_referendum_score"] = 0;
        for (const partner of ["ko", "pis", "third_way", "palace"]) {
            majorReformDefaults[issue + "_" + partner + "_commitment"] = 0;
        }
    }
    for (const party of ["pis", "ko", "psl", "p2050", "konf"]) {
        const ignoredKey = "reform_pressure_ignored_" + party;
        majorReformDefaults[ignoredKey] = 0;
    }
    for (const key of Object.keys(majorReformDefaults)) {
        if (!Number.isFinite(Number(Q[key]))) {
            Q[key] = majorReformDefaults[key];
        }
    }
    for (const party of ["pis", "ko", "psl", "p2050", "konf"]) {
        const ignoredKey = "reform_pressure_ignored_" + party;
        Q[ignoredKey] = Q[ignoredKey] ? 1 : 0;
    }
    for (const issue of majorReformIssues) {
        Q[issue + "_reform_stage"] = Math.round(clamp(
            Q[issue + "_reform_stage"], 0, 4
        ));
        Q[issue + "_reform_goal_stage"] = Math.round(clamp(
            Q[issue + "_reform_goal_stage"], 1, 4
        ));
        Q[issue + "_reform_proposal_stage"] = Math.round(clamp(
            Q[issue + "_reform_proposal_stage"], 1, 4
        ));
        Q[issue + "_reform_defined"] =
            Q[issue + "_reform_defined"] ? 1 : 0;
        Q[issue + "_reform_settled"] =
            Q[issue + "_reform_settled"] ? 1 : 0;
        Q[issue + "_reform_progress"] = clamp(
            Q[issue + "_reform_progress"], 0, 100
        );
        Q[issue + "_reform_power"] = clamp(
            Q[issue + "_reform_power"], 0, 140
        );
        for (const partner of ["ko", "pis", "third_way", "palace"]) {
            Q[issue + "_" + partner + "_commitment"] = Math.round(clamp(
                Q[issue + "_" + partner + "_commitment"], 0, 4
            ));
        }
        const palacePresidentKey = issue + "_palace_president";
        if (typeof Q[palacePresidentKey] != "string") {
            Q[palacePresidentKey] =
                Q[issue + "_palace_commitment"] > 0
                    ? Q.president_name
                    : "";
        }
    }
    for (const issue of majorReformIssues) {
        Q[issue + "_referendum_mandate"] =
            Q[issue + "_referendum_mandate"] ? 1 : 0;
    }
    // Old saves predate explicit slate ownership, so infer their picks once.
    // New games and one-off legislation never turn an enacted field into a
    // Major Reform pick: only the player's slate choice owns that flag.
    const reformSlateNeedsMigration =
        !Number.isFinite(Number(Q.reform_slate_schema_version));
    Q.reform_slate_max = Math.round(clamp(Q.reform_slate_max, 1, 9));
    let slateCount = 0;
    for (const issue of majorReformIssues) {
        if (
            reformSlateNeedsMigration &&
            (Q[issue + "_reform_stage"] > 0 || Q[issue + "_reform_defined"])
        ) {
            Q[issue + "_on_slate"] = 1;
        }
        Q[issue + "_on_slate"] = Q[issue + "_on_slate"] ? 1 : 0;
        slateCount += Q[issue + "_on_slate"];
    }
    if (reformSlateNeedsMigration) {
        Q.reform_slate_schema_version = 1;
    }
    Q.reform_slate_count = slateCount;
    Q.reform_slate_slots_left = Math.max(0, Q.reform_slate_max - slateCount);
    Q.reform_slate_closed = Q.reform_slate_slots_left <= 0 ? 1 : 0;
    // The deck's own view-if cannot loop over nine issues, so the "is there
    // anything to draw" question is answered here.
    let deckLive = Q.reform_slate_slots_left > 0 &&
        Number(Q.poland_reform_slate_timer) <= 0 ? 1 : 0;
    for (const issue of majorReformIssues) {
        if (
            Q[issue + "_on_slate"] &&
            !Q[issue + "_reform_settled"] &&
            Number(Q["poland_" + issue + "_reform_timer"]) <= 0
        ) {
            deckLive = 1;
        }
    }
    Q.major_reform_deck_live = deckLive;
    Q.reform_pressure_rounds = Math.max(
        0, Math.round(Number(Q.reform_pressure_rounds) || 0)
    );
    Q.reform_pressure_pending = Q.reform_pressure_pending ? 1 : 0;
    // A demand put in the Sejm freezer keeps its own clock. When it matures it
    // re-arms itself as the same partner's same file, and the apply step
    // scales every penalty by how often we have promised action already.
    Q.reform_pressure_frozen = Q.reform_pressure_frozen ? 1 : 0;
    Q.frozen_demand_count = Math.max(0, Number(Q.frozen_demand_count) || 0);
    if (
        Q.reform_pressure_frozen &&
        !Q.reform_pressure_pending &&
        Q.left_in_government &&
        !Q.caretaker_government &&
        Number(Q.frozen_demand_due_time) >= 0 &&
        Number(Q.time) >= Number(Q.frozen_demand_due_time)
    ) {
        Q.reform_pressure_pending = 1;
        Q.reform_pressure_mode = "partner_demand";
        Q.reform_pressure_frozen_return = 1;
        Q.reform_pressure_actor = Q.frozen_demand_actor;
        Q.reform_pressure_actor_name = Q.frozen_demand_actor_name;
        Q.reform_pressure_issue = Q.frozen_demand_issue;
        Q.reform_pressure_issue_name = Q.frozen_demand_issue_name;
        Q.reform_pressure_intensity = Math.min(
            100,
            (Number(Q.frozen_demand_intensity) || 50) +
                8 * Math.max(1, Number(Q.frozen_demand_count) || 1)
        );
        Q.reform_pressure_illegality = Number(Q.frozen_demand_illegality) || 0;
        Q.reform_pressure_cooldown = 0;
        Q.frozen_demand_due_time = -1;
