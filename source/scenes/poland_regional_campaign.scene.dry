title: Regional campaign planning

@july_2023
# prose-audit: Grade B — The board is deliberately procedural: it exposes forecast uncertainty, issue ownership and a bounded tour rather than inventing a national polling swing.
title: Put the July campaign on the map
subtitle: Choose one national issue and one voivodeship for a free campaign tour.
new-page: true
tags: poland_event, poland_event_calendar
priority: 70
order: 1
max-visits: 1
view-if: continuous_campaign = 1 and year = 2023 and month = 7 and election_2023_certified = 0
on-arrival: {!
Q.regional_campaign_window_label = "July 2023 campaign map";
Q.regional_campaign_return = "events";
(typeof window !== "undefined" ? window : globalThis).polandElectionModel
    .initialiseCampaign(Q, "2023-07");
!}
go-to: board

@october_2023
# prose-audit: Grade B — The closing board makes one geographic trade-off visible before the authored election count and does not disclose exact forecast shares.
title: Make the final 2023 regional campaign choice
subtitle: Revisit the forecast before the parliamentary count.
new-page: true
tags: poland_event, poland_event_calendar
priority: 70
order: 1
max-visits: 1
view-if: continuous_campaign = 1 and year = 2023 and month = 10 and election_2023_certified = 0
on-arrival: {!
Q.regional_campaign_window_label = "October 2023 closing map";
Q.regional_campaign_return = "events";
(typeof window !== "undefined" ? window : globalThis).polandElectionModel
    .initialiseCampaign(Q, "2023-10");
!}
go-to: board

