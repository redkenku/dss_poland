@snap_open
title: Put the snap-election campaign on the map
on-arrival: {!
Q.regional_campaign_window_label = "Snap campaign opening map";
Q.regional_campaign_return = "events";
(typeof window !== "undefined" ? window : globalThis).polandElectionModel
    .initialiseCampaign(
        Q, "snap-" + Q.snap_election_cycle + "-open-" + Q.time
    );
!}
go-to: board

@snap_close
title: Make the snap campaign's closing regional choice
on-arrival: {!
Q.regional_campaign_window_label = "Snap campaign closing map";
Q.regional_campaign_return = "snap_count";
(typeof window !== "undefined" ? window : globalThis).polandElectionModel
    .initialiseCampaign(
        Q, "snap-" + Q.snap_election_cycle + "-close-" + Q.time
    );
!}
go-to: board

@board
title: [+ regional_campaign_window_label +]
new-page: true

= One issue, one free tour

The national vote total is held constant. This choice changes where Lewica's
support is efficient enough to win seats; repeated tours have diminishing
returns.

{!<div class="regional-campaign-board-host election-map-host" data-election-map-source="campaign"></div>!}

- @confirm: Confirm the issue and province

@confirm
title: Regional campaign route confirmed
on-arrival: {!
const regionalCampaignModel = (typeof window !== "undefined"
    ? window : globalThis).polandElectionModel;
Q.regional_campaign_confirmed = regionalCampaignModel.submitCampaign(Q) ? 1 : 0;
Q.news_headline = Q.regional_campaign_confirmed
    ? "Lewica confirms a national issue and regional campaign tour"
    : "The regional campaign window closes without a complete route";
!}
go-to: poland_events_2026_snap.snap_campaign_count if regional_campaign_return = "snap_count"; poland_event_queue
