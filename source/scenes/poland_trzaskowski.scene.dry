We refuse to decorate the rerun with democratic consent. The legal protest
remains intact, but Duda takes the office uncontested and voters who expected
us to end the interregnum lose faith in the opposition.

- @repeat_election_count: Count the repeat ballot

@repeat_election_count
title: The repeat ballot ends the acting presidency
new-page: true
on-arrival: {!
const repeatVariance =
    Math.floor((this.random.uint32() / 4294967296) * 7) - 3;
const democraticRaw = Math.max(
    0,
    Number(Q.trz_repeat_campaign_score) + repeatVariance
);
const rightRaw = Math.max(1, Number(Q.trz_repeat_right_score));
Q.trz_repeat_result = Math.round(
    democraticRaw / Math.max(1, democraticRaw + rightRaw) * 1000
) / 10;
Q.trz_repeat_winner = Q.trz_repeat_result >= 50
    ? "Rafał Trzaskowski"
    : "Andrzej Duda";
Q.president_name = Q.trz_repeat_winner;
Q.trz_repeat_election_pending = 0;
if (Q.trz_repeat_winner == "Rafał Trzaskowski") {
    Q.trz_inaugurated = 1;
    Q.trz_blocked = 0;
    Q.pres_2020_phase = "Cohabitation after repeat election";
    Q.trz_inauguration_status = "Sworn in after winning the imposed rerun";
    Q.trz_oath_crisis_outcome =
        "Witek's interregnum ends after Trzaskowski wins again";
    Q.ko_relation += 4;
    Q.news_headline = "Trzaskowski wins again and the acting presidency ends";
} else {
    Q.trz_inaugurated = 0;
    Q.trz_blocked = 0;
    Q.pres_2020_phase = "Duda presidency after repeat election";
    Q.trz_inauguration_status = "Blocked winner loses the conceded rerun";
    Q.trz_oath_crisis_outcome =
        "Witek's interregnum ends after Duda wins the imposed rerun";
    Q.pis_relation += 4;
    Q.news_headline = "Duda wins the rerun and the acting presidency ends";
}
!}

