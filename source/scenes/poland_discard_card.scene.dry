title: Discard an opportunity
subtitle: Remove one held card without spending the month or changing the political state.
is-pinned-card: true
view-if: started = 1
card-image: img/poland/discard.svg
new-page: true
on-arrival: {!
const hand = this.state.currentHands["poland_hub"] || [];
const slots = [
    ["poland_discard_slot_1_id", "poland_discard_slot_1_title"],
    ["poland_discard_slot_2_id", "poland_discard_slot_2_title"],
    ["poland_discard_slot_3_id", "poland_discard_slot_3_title"]
];
Q.poland_discard_slot_count = Math.min(3, hand.length);
for (let index = 0; index < slots.length; index += 1) {
    const card = hand[index];
    Q[slots[index][0]] = card ? card.id : "";
    Q[slots[index][1]] = card
        ? (card.title || this.game.scenes[card.id].title || card.id)
        : "";
}
!}

= Discard an opportunity

Choose one held card to remove. This spends no resource or budget capacity,
does not consume the monthly action, and does not trigger the card's effects.
The opportunity can return in a later draw.

[? if poland_discard_slot_count = 0: There are no cards in hand. ?]

- @slot_1
- @slot_2
- @slot_3
- @cancel

@slot_1
title: Discard “[+ poland_discard_slot_1_title +]”
subtitle: Remove the first held card.
view-if: poland_discard_slot_count >= 1
on-arrival: {!
const hand = this.state.currentHands["poland_hub"] || [];
const index = hand.findIndex(card =>
    card.id === Q.poland_discard_slot_1_id
);
if (index >= 0) hand.splice(index, 1);
Q.poland_discard_slot_count = 0;
Q.poland_discard_slot_1_id = "";
Q.poland_discard_slot_1_title = "";
Q.poland_discard_slot_2_id = "";
Q.poland_discard_slot_2_title = "";
Q.poland_discard_slot_3_id = "";
Q.poland_discard_slot_3_title = "";
!}
go-to: poland_hub

@slot_2
title: Discard “[+ poland_discard_slot_2_title +]”
subtitle: Remove the second held card.
view-if: poland_discard_slot_count >= 2
on-arrival: {!
const hand = this.state.currentHands["poland_hub"] || [];
const index = hand.findIndex(card =>
    card.id === Q.poland_discard_slot_2_id
);
if (index >= 0) hand.splice(index, 1);
Q.poland_discard_slot_count = 0;
Q.poland_discard_slot_1_id = "";
Q.poland_discard_slot_1_title = "";
Q.poland_discard_slot_2_id = "";
Q.poland_discard_slot_2_title = "";
Q.poland_discard_slot_3_id = "";
Q.poland_discard_slot_3_title = "";
!}
go-to: poland_hub

@slot_3
title: Discard “[+ poland_discard_slot_3_title +]”
subtitle: Remove the third held card.
view-if: poland_discard_slot_count >= 3
on-arrival: {!
const hand = this.state.currentHands["poland_hub"] || [];
const index = hand.findIndex(card =>
    card.id === Q.poland_discard_slot_3_id
);
if (index >= 0) hand.splice(index, 1);
Q.poland_discard_slot_count = 0;
Q.poland_discard_slot_1_id = "";
Q.poland_discard_slot_1_title = "";
Q.poland_discard_slot_2_id = "";
Q.poland_discard_slot_2_title = "";
Q.poland_discard_slot_3_id = "";
Q.poland_discard_slot_3_title = "";
!}
go-to: poland_hub

@cancel
title: Keep every held card
subtitle: Return to the leadership table without changing the hand.
on-arrival: {!
Q.poland_discard_slot_count = 0;
Q.poland_discard_slot_1_id = "";
Q.poland_discard_slot_1_title = "";
Q.poland_discard_slot_2_id = "";
Q.poland_discard_slot_2_title = "";
Q.poland_discard_slot_3_id = "";
Q.poland_discard_slot_3_title = "";
!}
go-to: poland_hub
