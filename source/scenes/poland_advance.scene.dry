title: The month turns
new-page: true
on-arrival: {!
if (Q.month_actions > 0) {
    Q.leadership_actions_taken += 1;
} else {
    Q.neglected_months += 1;
    Q.party_unity -= 3;
    Q.public_trust -= 1;
    Q.organiser_energy -= 3;
    Q.barons_dissent += 1;
    Q.spring_dissent += 1;
    Q.labor_dissent += 1;
    Q.progressives_dissent += 1;
    Q.razem_dissent += 2;
}

// Foreign-policy friction resolves on the next month turn. Risk meters are
// consequences, not decorative numbers: coalition actors can overrule a
// junior minister, a portfolio owner can resist the lead party, and a cabinet
// that claimed full authority owns the result.
const foreignOverrideRisk = Math.max(
    0,
    Number(Q.foreign_ministry_override_risk) || 0
);
const foreignPortfolioResistance = Math.max(
    0,
    Number(Q.foreign_portfolio_resistance) || 0
);
const foreignResponsibility = Math.max(
    0,
    Number(Q.foreign_policy_responsibility) || 0
);
if (foreignOverrideRisk > 0) {
    const overrideDamage = Math.max(
        1,
        Math.round(foreignOverrideRisk * 0.35)
    );
    Q.government_delivery -= overrideDamage;
    Q.government_coalition_dissent += overrideDamage;
    Q.foreign_followthrough_last =
        "The Prime Minister trims or delays the junior minister's initiative";
} else if (foreignPortfolioResistance > 0) {
    const resistanceDamage = Math.max(
        1,
        Math.round(foreignPortfolioResistance * 0.30)
    );
    Q.government_delivery -= resistanceDamage;
    Q.government_coalition_dissent += resistanceDamage;
    Q.foreign_followthrough_last =
        "The coalition portfolio owner narrows the cabinet's foreign-policy order";
} else if (foreignResponsibility > 0) {
    const responsibilityShift = Math.max(
        1,
        Math.round(foreignResponsibility * 0.20)
    );
    if ((Number(Q.government_delivery) || 0) >= 55) {
        Q.public_trust += responsibilityShift;
        Q.foreign_followthrough_last =
            "Visible implementation lets the cabinet claim its foreign-policy result";
    } else if ((Number(Q.government_delivery) || 0) < 45) {
        Q.public_trust -= responsibilityShift;
        Q.foreign_followthrough_last =
            "The cabinet owns the cost of a foreign-policy promise it could not deliver";
    } else {
        Q.foreign_followthrough_last =
            "The cabinet's foreign-policy commitment lands without a clear political dividend";
    }
}
Q.foreign_ministry_override_risk = 0;
Q.foreign_portfolio_resistance = 0;
Q.foreign_policy_responsibility = 0;

const advisorRepresentation = {
    barons: Number(Q.barons_advisor_count) || 0,
    spring: Number(Q.spring_advisor_count) || 0,
    labor: Number(Q.labor_advisor_count) || 0,
    progressives: Number(Q.progressives_advisor_count) || 0,
    razem: Number(Q.razem_advisor_count) || 0,
    social_patriot: Number(Q.social_patriot_advisor_count) || 0
};
const apparatusGlue = Math.max(
    0.10,
    1 - advisorRepresentation.barons * 0.30
);
const dissentRecovery = Number(Q.party_unity) >= 60
    ? 1.25
    : (Number(Q.party_unity) >= 45 ? 0.75 : 0.35);
for (const faction of Q.factions) {
    const represented = advisorRepresentation[faction] || 0;
    let structuralDrift = 0;
    if (represented <= 0) {
        structuralDrift = apparatusGlue;
    } else if (represented == 2) {
        structuralDrift = -0.25;
    } else if (represented >= 3) {
        structuralDrift = -0.50;
    }
    if ((Number(Q[faction + "_dissent"]) || 0) > 20) {
        structuralDrift -= dissentRecovery;
    }
    Q[faction + "_dissent"] += structuralDrift;
    Q[faction + "_strength"] += represented * 0.50;
}

// A durable conservative or capitalist turn creates its own organisation and
// pushes the non-establishment Left toward the existing split ladder.
const culturalRightPressure =
    Math.max(0, (Number(Q.left_right_score) || 0) - 42) * 0.18 +
    Math.max(0, (Number(Q.left_cultural_position) || 0) - 58) * 0.10;
const marketRightPressure =
    Math.max(0, (Number(Q.left_economic_position) || 0) - 57) * 0.16;
const rightTurnDissentWeights = {
    spring: [0.65, 0.15],
    labor: [0.30, 0.75],
    progressives: [1.00, 0.35],
    razem: [0.85, 0.85],
    pps: [0.40, 0.60]
};
for (const faction of Object.keys(rightTurnDissentWeights)) {
    if (!Q[faction + "_active"] || !Q[faction + "_in_left"]) continue;
    const weights = rightTurnDissentWeights[faction];
    const dissentGain =
        culturalRightPressure * weights[0] +
        marketRightPressure * weights[1];
    Q[faction + "_dissent"] += dissentGain;
    if (dissentGain >= 2.5) {
        Q[faction + "_grievance_memory"] += 0.5;
    }
}
if (culturalRightPressure > 0) {
    Q.social_patriot_support += Math.min(2, culturalRightPressure * 0.16);
    Q.barons_dissent -= Math.min(1.5, culturalRightPressure * 0.12);
}
if (marketRightPressure > 0) {
    Q.market_liberal_support += Math.min(2, marketRightPressure * 0.18);
}
if (culturalRightPressure + marketRightPressure >= 4) {
    Q.party_unity -= 1;
}

// Disunity is operational damage, not a game-over trigger. It erodes the
// common campaign while leaving the player in charge of the coordinating
// centre or whatever rump survives.
if (
    (Q.party_unity < 35 || Q.internal_dissent >= 40) &&
    Q.factions.length > 0
) {
    const mostDissenting = Q.factions.slice().sort(function(a, b) {
        return Number(Q[b + "_dissent"]) - Number(Q[a + "_dissent"]);
    })[0];
    const capacityLoss =
        Q.party_unity < 15 || Q.internal_dissent >= 65 ? 1 : 0.5;
    Q.campaign_capacity_loss += capacityLoss;
    Q.media_capacity -= capacityLoss * 0.55;
    Q.local_network -= capacityLoss * 0.35;
    Q.organiser_energy -= capacityLoss * 0.45;
    Q[mostDissenting + "_contradictory_appearances"] += 1;
    if (Q.party_unity < 25) {
        Q.dues_withheld += Q.party_unity < 15 ? 0.50 : 0.25;
        for (const faction of Q.factions) {
            Q[faction + "_grievance_memory"] +=
                Q.party_unity < 15 ? 4 : 2;
            Q[faction + "_dissent"] +=
                Q.party_unity < 15 ? 1.5 : 0.75;
        }
    }
}

const monthlyTimers = [
    "roundtable_cooldown",
    "hostile_interview_cooldown",
    "razem_guarantee_cooldown",
    "advisor_action_timer",
    "leadership_reshuffle_timer",
    "poland_faction_congress_timer",
    "poland_local_structures_timer",
    "poland_programme_convention_timer",
    "poland_opposition_coordination_timer",
    "poland_rival_organisations_timer",
    "poland_picking_enemies_timer",
    "poland_inter_party_relations_timer",
    "poland_rural_hinge_timer",
    "poland_presidential_channel_timer",
    "poland_rapid_response_timer",
    "poland_hostile_interview_card_timer",
    "poland_local_media_ecosystem_timer",
    "poland_workers_public_services_timer",
    "poland_housing_households_timer",
    "poland_cost_programme_timer",
    "poland_senate_docket_timer",
    "poland_labor_inspection_timer",
    "poland_housing_fund_timer",
    "poland_equality_bill_timer",
    "poland_health_compact_timer",
    "poland_digital_state_timer",
    "poland_science_compact_timer",
    "poland_internal_security_timer",
    "poland_fiscal_policy_timer",
    "poland_economic_programme_timer",
    "poland_justice_repair_timer",
    "poland_foreign_ministry_line_timer",
    "poland_agricultural_bargain_timer",
    "poland_defence_policy_timer",
    "poland_cabinet_reshuffle_timer",
    "poland_coalition_council_timer",
    "poland_social_welfare_review_timer",
    "poland_fundraising_timer",
    "poland_campaigning_timer",
    "poland_rally_timer",
    "poland_crisis_compact_timer",
    "poland_oversight_bargain_timer",
    "poland_palace_mediation_timer",
    "poland_pis_social_channel_timer",
    "poland_pis_right_faultline_timer",
    "poland_european_campaign_timer",
    "poland_brussels_pressure_timer",
    "poland_berlin_pressure_timer",
    "poland_eastern_flank_timer",
    "poland_white_house_pressure_timer",
    "poland_european_right_timer",
    "emergency_fundraising_timer",
    "constructive_vonc_cooldown"
];
for (const timer of monthlyTimers) {
    if (Q[timer] !== undefined) {
        Q[timer] = Math.max(0, Q[timer] - 1);
    }
}

const burdenGovernmentFunctioning =
    Q.left_in_government &&
    Q.government_has_confidence &&
    !Q.caretaker_government;
if (
    burdenGovernmentFunctioning &&
    Q.government_burden_active &&
    !Q.government_burden_review_pending
) {
    const burdenGoals = [
        ["government_goal_health", "public health"],
        ["government_goal_housing", "housing and tenant security"],
        ["government_goal_labor", "labour rights"],
        ["government_goal_welfare", "social welfare"],
        ["government_goal_equality", "equality"]
    ];
    Q.government_burden_completed = burdenGoals.reduce(
        function(total, goal) {
            return total + (Number(Q[goal[0]]) >= 1 ? 1 : 0);
        },
        0
    );
    Q.government_burden_timer = Math.max(
        0,
        (Number(Q.government_burden_timer) || 0) - 1
    );
    if (Q.government_burden_timer === 0) {
        Q.government_burden_last_completed =
            Q.government_burden_completed;
        Q.government_burden_last_breached =
            Q.government_burden_breached ? 1 : 0;
        Q.government_burden_last_goals = burdenGoals
            .filter(function(goal) {
                return Number(Q[goal[0]]) >= 1;
            })
            .map(function(goal) {
                return goal[1];
            })
            .join(" · ") || "None";
        const burdenPassed =
            !Q.government_burden_last_breached &&
            Q.government_burden_last_completed >=
                (Number(Q.government_burden_required) || 2);
        if (burdenPassed) {
            Q.government_achievements += 1;
            Q.party_unity += 1;
            Q.coalition_blur -= 1;
            Q.government_burden_last_result =
                "Lewica meets its six-month government burden";
        } else {
            Q.government_burden_failures += 1;
            Q.left_poll -= 0.7;
            Q.public_trust -= 3;
            Q.government_delivery -= 2;
            Q.coalition_blur += 5;
            Q.labor_dissent += 4;
            Q.progressives_dissent += 3;
            Q.razem_dissent += 5;
            Q.government_burden_last_result =
                Q.government_burden_last_breached
                    ? "A conservative coalition settlement fails Lewica's government burden"
                    : "Lewica misses its six-month government burden";
        }
        Q.government_burden_review_pending = 1;
    }
}

Q.time += 1;
Q.month += 1;
if (
    Q.partnership_implementation_pending &&
    Number(Q.time) >= Number(Q.partnership_implementation_due_time)
) {
    Q.partnership_implementation_pending = 0;
    Q.partnership_implementation_complete = 1;
    Q.minority_safety += 3;
    Q.government_delivery += 4;
    Q.administrative_capacity += 2;
    Q.last_policy_stage = "Implementation";
    Q.last_policy_authority = "Council of Ministers implementing enacted partnership law";
    Q.last_policy_implementation = 1;
    Q.news_headline = "The enacted partnership law enters administrative operation";
}
if (
    Q.pis_social_amendment_pending &&
    Number(Q.time) >= Number(Q.pis_social_amendment_due_time)
) {
    Q.pis_social_amendment_pending = 0;
    Q.pis_social_amendment_implemented = 1;
    Q.household_security += 3;
    Q.government_delivery += 3;
    Q.last_policy_stage = "Implementation";
    Q.last_policy_authority = "PiS Council of Ministers executing the enacted amendment";
    Q.last_policy_implementation = 1;
    Q.news_headline = "The enacted social amendment reaches households under PiS administration";
}
if (Q.month > 12) {
    Q.month = 1;
    Q.year += 1;
    if (Q.last_resource_restore_year < Q.year) {
        const subsidySeats = Number.isFinite(Number(Q.left_seats))
            ? Math.max(0, Math.round(Number(Q.left_seats)))
            : 0;
        Q.seat_subvention_seats = subsidySeats;
        Q.seat_subvention = subsidySeats > 0
            ? Math.max(1, Math.round(subsidySeats / 25))
            : 0;
        Q.member_dues = Number.isFinite(Number(Q.member_dues))
            ? Math.max(1, Math.min(5, Math.round(Number(Q.member_dues))))
            : 2;
        Q.party_income = Q.member_dues + Q.seat_subvention;
        let duesCollected = Q.member_dues;
        if (Q.internal_dissent <= 20) {
            duesCollected += 1;
        } else if (Q.internal_dissent >= 55) {
            duesCollected -= 1;
        }
        const withheldDues = Math.min(
            Math.max(0, duesCollected),
            Math.floor(Math.max(0, Number(Q.dues_withheld) || 0))
        );
        duesCollected -= withheldDues;
        Q.dues_withheld = Math.max(
            0,
            (Number(Q.dues_withheld) || 0) - withheldDues
        );
        Q.lost_dues_total += withheldDues;
        Q.last_dues_payout = Math.max(0, duesCollected);
        Q.last_subvention_payout = Q.seat_subvention;
        Q.last_annual_payout =
            Q.last_dues_payout + Q.last_subvention_payout;
        Q.last_annual_payout_label =
            Q.year + ": " + Q.last_dues_payout + " dues + " +
            Q.last_subvention_payout + " subvention" +
            (withheldDues > 0 ? " · " + withheldDues + " withheld" : "");
        Q.resources += Q.last_annual_payout;
        Q.last_resource_restore_year = Q.year;
    }
    if (
        Q.left_in_government &&
        (!Number.isFinite(Number(Q.last_budget_restore_year)) ||
            Number(Q.last_budget_restore_year) < Q.year)
    ) {
        const yearlyBudgetGrant = Math.max(
            2,
            Math.round(
                4 +
                (Number(Q.government_delivery) || 0) / 30 -
                (Number(Q.fiscal_stress) || 0) / 35
            )
        );
        Q.budget += yearlyBudgetGrant;
        Q.last_budget_restore = yearlyBudgetGrant;
        Q.last_budget_restore_year = Q.year;
        Q.budget_authority =
            "Coalition budget reserve — +" + yearlyBudgetGrant +
            " capacity restored for " + Q.year;
    } else if (!Q.left_in_government) {
        Q.budget = 0;
        Q.last_budget_restore = 0;
        Q.budget_authority = "Opposition — no state spending authority";
    }
}

Q.month_actions = 0;

if (Q.hard_mode) {
    Q.party_unity -= 2;
    Q.public_trust -= 0.5;
    Q.barons_dissent += 2;
    Q.spring_dissent += 1;
    Q.labor_dissent += 1;
    Q.progressives_dissent += 1;
    Q.razem_dissent += 2;
    Q.far_right_agenda += 1;
}

let totalFactionStrength = 0;
let weightedDissent = 0;
let activeVetoes = 0;
for (const faction of Q.factions) {
    const strength = Math.max(0, Q[faction + "_strength"] || 0);
    const dissent = Math.max(0, Q[faction + "_dissent"] || 0);
    totalFactionStrength += strength;
    weightedDissent += strength * dissent;
    if (strength >= 12 && dissent >= 60) {
        activeVetoes += 1;
    }
}
Q.internal_dissent = totalFactionStrength > 0
    ? Math.round(weightedDissent / totalFactionStrength)
    : 100;
Q.faction_vetoes = activeVetoes;
Q.party_action_effectiveness = Math.round(Math.max(
    35,
    100 - Math.max(0, Q.internal_dissent - 20) * 0.80
));
Q.message_discipline = Math.round(Math.max(
    20,
    100 - Math.max(0, Q.internal_dissent - 20) -
        Q.faction_vetoes * 5
));

if (Q.internal_dissent >= 35) {
    Q.party_unity -= 1;
}
if (Q.internal_dissent >= 50) {
    Q.party_unity -= 1;
    Q.left_poll -= 0.1;
}
if (Q.faction_vetoes > 0) {
    Q.party_unity -= Q.faction_vetoes;
}

const caucusSeatRecords = {
    barons: {
        internal: "left_barons_seats",
        separate: "sld_breakaway_seats"
    },
    spring: {
        internal: "left_spring_seats",
        separate: "spring_breakaway_seats"
    },
    labor: {
        internal: "left_labor_seats",
        separate: "labor_left_seats"
    },
    progressives: {
        internal: "left_progressives_seats",
        separate: "young_left_seats"
    },
    razem: {
        internal: "razem_seats",
        separate: "razem_party_seats"
    },
    pps: {
        internal: "left_pps_seats",
        separate: "pps_party_seats"
    },
    social_patriot: {
        internal: "left_social_patriot_seats",
        separate: "social_patriot_seats"
    }
};
const caucusAdvisers = {
    barons: ["czarzasty", "wieczorek"],
    spring: ["biedron"],
    labor: ["dziemianowicz_bak"],
    progressives: ["zukowska", "kotula", "gawkowski", "nowicka"],
    razem: ["zandberg", "biejat", "zawisza"].concat(
        Q.social_patriot_active ? [] : ["matysiak"]
    ),
    pps: [],
    social_patriot: ["matysiak"]
};
const escalationThresholds = [0, 48, 58, 67, 74, 81, 88, 94];
for (const faction of Q.factions.slice()) {
    if (!Q[faction + "_active"] || !Q[faction + "_in_left"]) continue;
    const dissent = Math.max(0, Number(Q[faction + "_dissent"]) || 0);
    const currentStage = Math.max(
        0,
        Math.min(7, Math.round(
            Number(Q[faction + "_escalation_stage"]) || 0
        ))
    );
    const protectedRazem =
        faction == "razem" &&
        (
            (Q.razem_merged && Q.merger_leader == "Razem") ||
            (
                Number(Q.razem_cooperation) >= 60 &&
                dissent < 35
            )
        );
    if (protectedRazem) {
        if (currentStage > 0) {
            const deescalatedStage = currentStage - 1;
            Q.razem_escalation_stage = deescalatedStage;
            Q.razem_defection_readiness = Math.min(
                Number(Q.razem_defection_readiness) || 0,
                deescalatedStage * 14
            );
            if (deescalatedStage < 2) {
                Q.razem_demand_answered = 1;
            }
        }
        continue;
    }
    const grievance = Math.max(
        0,
        Number(Q[faction + "_grievance_memory"]) || 0
    );
    const offices = Math.min(
        100,
        (Number(Q[faction + "_office_hold"]) || 0) +
            (Number(Q[faction + "_advisor_count"]) || 0) * 8 +
            (Q.left_in_government ? 6 : 0)
    );
    const listDependence = Math.max(
        0,
        Number(Q[faction + "_list_dependence"]) || 0
    );
    const escalationPressure =
        dissent +
        grievance * 0.55 +
        Math.max(0, 35 - Number(Q.party_unity)) * 0.80 +
        Math.max(0, Number(Q.poll_danger_months) || 0) * 2 -
        offices * 0.035 -
        listDependence * 0.025;
    let targetStage = 0;
    for (let stage = 1; stage <= 7; stage += 1) {
        if (escalationPressure >= escalationThresholds[stage]) {
            targetStage = stage;
        }
    }
    const waitingForDemandDeadline =
        currentStage == 2 &&
        !Q[faction + "_demand_answered"] &&
        // The month counter has already advanced above.  Preserve stage two
        // through the turn that began on the stated deadline.
        Number(Q.time) <= Number(Q[faction + "_demand_deadline"]) + 1;
    if (
        targetStage > currentStage &&
        !waitingForDemandDeadline &&
        Number(Q.time) > Number(Q[faction + "_last_escalation_time"])
    ) {
        const nextStage = currentStage + 1;
        Q[faction + "_escalation_stage"] = nextStage;
        Q[faction + "_last_escalation_time"] = Number(Q.time) || 0;
        Q[faction + "_defection_readiness"] = Math.max(
            Number(Q[faction + "_defection_readiness"]) || 0,
            nextStage * 14
        );
        Q.faction_stage_highwater = Math.max(
            Number(Q.faction_stage_highwater) || 0,
            nextStage
        );

        if (nextStage == 1) {
            Q.faction_leaks += 1;
            Q.media_capacity -= 0.4;
            Q.public_trust -= 0.2;
            Q.news_headline =
                Q[faction + "_name"] + " begins briefing against the common line";
        } else if (nextStage == 2) {
            Q[faction + "_demand_deadline"] = Q.time + 2;
            Q[faction + "_demand_answered"] = 0;
            Q[faction + "_grievance_memory"] += 1;
            Q.news_headline =
                Q[faction + "_name"] + " sets a deadline for " +
                Q[faction + "_demand"];
        } else if (nextStage == 3) {
            Q.faction_public_criticisms += 1;
            Q[faction + "_contradictory_appearances"] += 1;
            Q.media_capacity -= 0.8;
            Q.public_trust -= 0.5;
            Q.news_headline =
                Q[faction + "_name"] + " threatens a free vote in public";
        } else if (nextStage == 4) {
            Q[faction + "_failed_whips"] += 1;
            Q.left_coalition_dissent += 3;
            Q.party_unity -= 1;
            const resigningAdviser = (caucusAdvisers[faction] || []).find(
                function(adviser) {
                    return Number(Q[adviser + "_advisor"]) === 1;
                }
            );
            if (resigningAdviser) {
                Q[resigningAdviser + "_advisor"] = 0;
                Q[faction + "_adviser_resignations"] += 1;
                Q.last_adviser_resignation = resigningAdviser;
            }
            Q.news_headline =
                Q[faction + "_name"] + " refuses the whip";
        } else if (nextStage == 5) {
            const seatRecord = caucusSeatRecords[faction];
            const currentLeftSeats = Math.max(
                0,
                Math.round(Number(Q.left_seats) || 0)
            );
            const recordedSeats = Math.max(
                0,
                Math.round(Number(Q[seatRecord.internal]) || 0)
            );
            const proportionalSeats = currentLeftSeats > 0
                ? Math.max(
                    1,
                    Math.round(
                        currentLeftSeats *
                        (Number(Q[faction + "_strength"]) || 0) /
                        100
                    )
                )
                : 0;
            const estimatedSeats = Math.min(
                currentLeftSeats,
                recordedSeats > 0 ? recordedSeats : proportionalSeats
            );
            const individualRate = Math.max(
                0.08,
                Math.min(
                    0.36,
                    0.04 +
                    (Number(Q[faction + "_personal_following"]) || 0) * 0.001 +
                    (Number(Q[faction + "_ideological_intensity"]) || 0) * 0.001 +
                    (100 - listDependence) * 0.0008 +
                    (Number(Q[faction + "_local_organisation"]) || 0) * 0.0006 +
                    grievance * 0.001 -
                    offices * 0.0007
                )
            );
            const defectors = estimatedSeats > 0
                ? Math.min(
                    estimatedSeats,
                    Math.max(1, Math.round(estimatedSeats * individualRate))
                )
                : 0;
            Q[faction + "_estimated_mps"] = Math.max(
                Number(Q[faction + "_estimated_mps"]) || 0,
                estimatedSeats
            );
            Q[faction + "_individual_defections"] += defectors;
            Q[faction + "_mp_departed"] += defectors;
            Q[faction + "_mp_retained"] = Math.max(
                0,
                estimatedSeats - defectors
            );
            Q.left_seats = Math.max(0, currentLeftSeats - defectors);
            if (recordedSeats > 0) {
                Q[seatRecord.internal] = Math.max(
                    0,
                    recordedSeats - defectors
                );
            }
            Q[seatRecord.separate] = Math.max(
                0,
                Math.round(Number(Q[seatRecord.separate]) || 0)
            ) + defectors;
            if (Q.left_in_government) {
                const externalRazemDeparture =
                    faction == "razem" &&
                    (
                        !Q.razem_in_government ||
                        String(Q.left_cabinet_model || "").includes(
                            "Razem external"
                        )
                    );
                if (!externalRazemDeparture) {
                    Q.ministry_left_cabinet_seats = Math.max(
                        0,
                        (Number(Q.ministry_left_cabinet_seats) || 0) -
                            defectors
                    );
                    Q.coalition_seats = Math.max(
                        0,
                        (Number(Q.coalition_seats) || 0) - defectors
                    );
                }
                Q.government_coalition_dissent += 2;
            }
            Q.party_unity -= defectors > 0 ? 1 : 0;
            Q.news_headline = defectors > 0
                ? defectors + " " + Q[faction + "_name"] +
                    " MP" + (defectors == 1 ? " defects" : "s defect")
                : Q[faction + "_name"] +
                    " cannot yet persuade an MP to defect";
        } else if (nextStage == 6) {
            const seatRecord = caucusSeatRecords[faction];
            if (!Q[faction + "_circle_formed"]) {
                Q[faction + "_circle_formed"] = 1;
            }
            Q.news_headline =
                Q[faction + "_name"] + " registers a parliamentary circle";
        } else if (nextStage == 7) {
            Q.news_headline =
                Q[faction + "_name"] + " approves a competing electoral list";
        }
    }
}

if (Q.barons_strength >= 25 && Q.barons_dissent < 50) {
    Q.local_network += 0.3;
    Q.psl_relation += 0.1;
}
if (Q.spring_strength >= 23 && Q.spring_dissent < 50) {
    Q.media_capacity += 0.3;
}
if (Q.labor_strength >= 20 && Q.labor_dissent < 50) {
    Q.labor_credibility += 0.3;
    Q.workers_support += 0.2;
}
if (Q.progressives_strength >= 23 && Q.progressives_dissent < 50) {
    Q.progressive_credibility += 0.3;
    Q.feminist_trust += 0.2;
}
if (Q.razem_strength >= 23 && Q.razem_dissent < 50) {
    Q.labor_credibility += 0.2;
    Q.razem_cooperation += 0.2;
}

if (Q.ko_relation < 35 || Q.psl_relation < 20) {
    Q.senate_cohesion -= 1;
} else if (Q.ko_relation >= 50 && Q.psl_relation >= 30) {
    Q.senate_cohesion += 0.3;
}

if (Q.party_unity < 40) {
    Q.left_poll -= 0.1;
}
if (Q.media_capacity < 18) {
    Q.public_trust -= 0.5;
}
if (Q.razem_dissent >= 70) {
    Q.razem_cooperation -= 2;
}

const names = [
    "", "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];
Q.month_name = names[Q.month];
Q.date_label = Q.month_name + " " + Q.year;

// Macroeconomic shocks persist, but they are not permanent constants. Move
// the crisis variables gradually toward a year-specific baseline while
// retaining the effect of fiscal stress, delivery and later authored shocks.
// This mirrors the Weimar model's continuing feedback rather than freezing
// the COVID/inflation peak for the rest of the campaign.
if (Q.year >= 2021) {
    const finiteMacro = function(value, fallback) {
        return Number.isFinite(Number(value)) ? Number(value) : fallback;
    };
    const macroBaselines = {
        2021: {growth: 6.9, inflation: 5.1, unemployment: 5.4},
        2022: {growth: 5.3, inflation: 14.4, unemployment: 5.2},
        2023: {growth: 0.2, inflation: 11.4, unemployment: 5.1},
        2024: {growth: 3.0, inflation: 3.7, unemployment: 5.0},
        2025: {growth: 3.4, inflation: 4.2, unemployment: 5.1},
        2026: {growth: 3.1, inflation: 3.5, unemployment: 5.2}
    };
    const baseline =
        macroBaselines[Math.max(2021, Math.min(2026, Q.year))];
    const fiscalStress = Math.max(
        0,
        Math.min(100, finiteMacro(Q.fiscal_stress, 0))
    );
    const delivery = Math.max(
        0,
        Math.min(100, finiteMacro(Q.government_delivery, 0))
    );
    const warRisk = Math.max(
        0,
        Math.min(100, finiteMacro(Q.war_escalation_risk, 0))
    );
    const targetInflation =
        baseline.inflation + fiscalStress * 0.018 + warRisk * 0.010;
    const targetGrowth =
        baseline.growth + delivery * 0.008 -
        fiscalStress * 0.012 - warRisk * 0.006;
    const targetUnemployment =
        baseline.unemployment + fiscalStress * 0.006 -
        delivery * 0.004;
    const convergeMacro = function(current, target, rate) {
        return Math.round(
            (current + (target - current) * rate) * 100
        ) / 100;
    };
    Q.inflation = convergeMacro(
        finiteMacro(Q.inflation, baseline.inflation),
        targetInflation,
        Q.year >= 2024 ? 0.18 : 0.12
    );
    Q.economic_growth = convergeMacro(
        finiteMacro(Q.economic_growth, baseline.growth),
        targetGrowth,
        0.16
    );
    Q.unemployment = convergeMacro(
        finiteMacro(Q.unemployment, baseline.unemployment),
        targetUnemployment,
        0.12
    );
    Q.macro_baseline_year = Q.year;
    Q.macro_baseline_label =
        "Converging " + Q.year + " baseline with campaign shocks";
}

// Trzaskowski versus a PiS cabinet is not a free opposition bonus. Sustained
// confrontation resolves each month toward either elite fracture or a
// defensive rally, and those outcomes move both cabinet discipline and blocs.
if (
    Q.president_name == "Rafał Trzaskowski" &&
    Q.government_party == "pis" &&
    Q.government_has_confidence &&
    !Q.caretaker_government
) {
    const cohabitationPressure = Math.max(
        0,
        Math.min(
            100,
            (Number(Q.trz_cohabitation_temperature) || 0) +
                (Number(Q.trz_vetoes) || 0) * 3
        )
    );
    const fractureForce =
        (Number(Q.trz_right_fragmentation) || 0) +
        (Number(Q.national_crisis_pressure) || 0) * 0.38 +
        Math.max(0, 45 - (Number(Q.public_trust) || 0)) * 0.18;
    const rallyForce =
        (Number(Q.trz_right_backlash) || 0) +
        (Number(Q.far_right_agenda) || 0) * 0.28 +
        Math.max(0, 35 - (Number(Q.president_relation) || 0)) * 0.24;
    const monthlyCohabitationShift = Math.max(
        1,
        Math.min(
            5,
            Math.round(1 + cohabitationPressure / 32)
        )
    );
    if (fractureForce > rallyForce + 4) {
        Q.pis_cohabitation_stress += monthlyCohabitationShift;
        Q.pis_cohabitation_rally = Math.max(
            0,
            (Number(Q.pis_cohabitation_rally) || 0) - 1
        );
        Q.government_coalition_dissent +=
            monthlyCohabitationShift * 0.8;
        Q.trz_right_fragmentation += 1;
        Q.pis_poll_momentum -= 0.08 * monthlyCohabitationShift;
        Q.provincial_welfare_pis_affinity -=
            0.18 * monthlyCohabitationShift;
        Q.older_welfare_households_pis_affinity -=
            0.16 * monthlyCohabitationShift;
        Q.pis_cohabitation_last_shift = monthlyCohabitationShift;
        Q.pis_cohabitation_state =
            Q.pis_cohabitation_stress >= 60
                ? "Severe internal stress — succession camps defy the government line"
                : (Q.pis_cohabitation_stress >= 30
                    ? "Internal stress — veto defeats are becoming a leadership fight"
                    : "Contained strain — PiS factions blame one another for Palace defeats");
    } else {
        Q.pis_cohabitation_rally += monthlyCohabitationShift;
        Q.pis_cohabitation_stress = Math.max(
            0,
            (Number(Q.pis_cohabitation_stress) || 0) - 1
        );
        Q.government_coalition_dissent -=
            monthlyCohabitationShift * 0.45;
        Q.trz_right_backlash += 1;
        Q.pis_poll_momentum += 0.07 * monthlyCohabitationShift;
        Q.provincial_welfare_pis_affinity +=
            0.14 * monthlyCohabitationShift;
        Q.older_welfare_households_pis_affinity +=
            0.16 * monthlyCohabitationShift;
        Q.far_right_agenda += 0.25 * monthlyCohabitationShift;
        Q.pis_cohabitation_last_shift = -monthlyCohabitationShift;
        Q.pis_cohabitation_state =
            Q.pis_cohabitation_rally >= 60
                ? "Rally around the flag — PiS has turned cohabitation into regime defence"
                : (Q.pis_cohabitation_rally >= 30
                    ? "Defensive rally — hostile-Palace rhetoric is restoring discipline"
                    : "Early rally — PiS is testing an obstruction narrative");
    }
} else if (
    Q.president_name != "Rafał Trzaskowski" ||
    Q.government_party != "pis"
) {
    Q.pis_cohabitation_last_shift = 0;
    if (
        (Number(Q.pis_cohabitation_stress) || 0) <= 0 &&
        (Number(Q.pis_cohabitation_rally) || 0) <= 0
    ) {
        Q.pis_cohabitation_state = "No hostile cohabitation";
    } else {
        Q.pis_cohabitation_state =
            "Cohabitation legacy — prior stress and mobilisation remain";
    }
}

// Important stories share one contest resolver. `frame` is signed: positive
// values carry a Left-compatible interpretation and negative values carry a
// hostile one. Its absolute strength participates in the required six-factor
// product; direction is restored only after the multiplication.
const clampMood = function(value, low, high) {
    const numeric = Number(value);
    return Math.max(
        low,
        Math.min(high, Number.isFinite(numeric) ? numeric : low)
    );
};
Q.story_salience_memory =
    clampMood(Q.story_salience_memory, 0, 100) * 0.78;
Q.story_distrust_memory =
    clampMood(Q.story_distrust_memory, 0, 100) * 0.975;
Q.story_backlash_memory =
    clampMood(Q.story_backlash_memory, 0, 100) * 0.985;
Q.story_reputation_memory =
    clampMood(Q.story_reputation_memory, 0, 100) * 0.992;
const queuedStories = Array.isArray(Q.story_queue)
    ? Q.story_queue.slice()
    : [];
Q.story_queue = [];
for (const story of queuedStories) {
    const issue = typeof story.issue == "string"
        ? story.issue
        : "social_spending";
    const kind = typeof story.kind == "string" ? story.kind : "authored";
    let derivedReach = Number(story.reach);
    let derivedAudienceTrust = Number(story.audienceTrust);
    let derivedFrame = Number(story.frame);
    let derivedMessenger = Number(story.messengerCredibility);
    let derivedLeftCredibility = Number(story.leftCredibility);
    if (kind == "pandemic_opening") {
        derivedReach = 96;
        derivedAudienceTrust = Q.public_trust;
        if (Q.covid_policy == "Restrictions with a social shield") {
            derivedFrame = 78;
            derivedMessenger = (Q.labor_credibility + Q.health_capacity) / 2;
        } else if (Q.covid_policy == "Constitutional emergency") {
            derivedFrame = 34;
            derivedMessenger = Q.constitutional_restraint;
        } else if (Q.covid_policy == "National unity") {
            derivedFrame = 24;
            derivedMessenger = Q.public_trust;
        } else {
            derivedFrame = -74;
            derivedMessenger = Math.max(22, Q.public_trust - 12);
        }
        derivedLeftCredibility = (
            Q.labor_credibility + Q.health_capacity + Q.issue_ownership
        ) / 3;
    }
    if (kind == "womens_ruling" || kind == "womens_followup") {
        derivedReach = kind == "womens_ruling" ? 94 : 82;
        derivedAudienceTrust = (
            Q.public_trust + Q.feminist_trust + Q.movement_autonomy
        ) / 3;
        if (kind == "womens_ruling") {
            if (Q.abortion_strategy == "Autonomous movement support") {
                derivedFrame = 74;
                derivedMessenger = Q.feminist_trust;
            } else if (Q.abortion_strategy == "Party-led mobilisation") {
                derivedFrame = 34;
                derivedMessenger = Math.max(25, Q.progressive_credibility - 8);
            } else if (Q.abortion_strategy == "Broad democratic front") {
                derivedFrame = 68;
                derivedMessenger = (Q.feminist_trust + Q.public_trust) / 2;
            } else if (Q.abortion_strategy == "Palace restoration front") {
                derivedFrame = 58;
                derivedMessenger =
                    (Q.feminist_trust + Q.president_relation) / 2;
            } else {
                derivedFrame = -66;
                derivedMessenger = Q.public_trust;
            }
        } else if (Q.womens_strike_followup == "Independent legal defence") {
            derivedFrame = 70;
            derivedMessenger = Q.feminist_trust;
        } else if (Q.womens_strike_followup == "Social programme") {
            derivedFrame = 54;
            derivedMessenger =
                (Q.feminist_trust + Q.labor_credibility) / 2;
        } else {
            derivedFrame = -58;
            derivedMessenger = Q.public_trust;
        }
        derivedLeftCredibility = (
            Q.progressive_credibility + Q.feminist_trust + Q.issue_ownership
        ) / 3;
    }
    if (kind == "migration_border" || kind == "migration_services" ||
        kind == "migration_welfare") {
        derivedReach = kind == "migration_border" ? 90 : 82;
        derivedAudienceTrust = (
            Q.public_trust + Q.institutional_trust
        ) / 2;
        if (kind == "migration_border") {
            if (Q.border_doctrine ==
                "Controlled processing with monitored access") {
                derivedFrame = 76;
                derivedMessenger =
                    (Q.border_security_confidence + Q.local_network) / 2;
            } else if (Q.border_doctrine ==
                "Rights-first humanitarian access") {
                derivedFrame = Q.migration_local_service_capacity >= 48
                    ? 24 : -38;
                derivedMessenger = Q.progressive_credibility;
            } else if (Q.border_doctrine ==
                "Security first with deferred scrutiny") {
                derivedFrame = -30;
                derivedMessenger = Q.border_security_confidence;
            } else {
                derivedFrame = -62;
                derivedMessenger = Math.max(20, Q.media_capacity);
            }
        } else if (kind == "migration_services") {
            if (String(Q.refugee_settlement).includes(
                "Funded local services"
            )) {
                derivedFrame = 80;
                derivedMessenger =
                    (Q.local_network + Q.health_capacity) / 2;
            } else if (String(Q.refugee_settlement).includes(
                "Volunteer emergency reception"
            )) {
                derivedFrame = 36;
                derivedMessenger = Q.movement_autonomy;
            } else if (String(Q.refugee_settlement).includes(
                "One humanitarian standard"
            )) {
                derivedFrame = Q.migration_local_service_capacity >= 48
                    ? 18 : -34;
                derivedMessenger = Q.progressive_credibility;
            } else {
                derivedFrame = -20;
                derivedMessenger = Q.border_security_confidence;
            }
        } else if (String(Q.refugee_settlement).includes("services")) {
            derivedFrame = 74;
            derivedMessenger =
                (Q.local_network + Q.labor_credibility) / 2;
        } else if (String(Q.refugee_settlement).includes("transparent")) {
            derivedFrame = 56;
            derivedMessenger = Q.public_trust;
        } else {
            derivedFrame = -72;
            derivedMessenger = Math.max(20, Q.public_trust - 8);
        }
        derivedLeftCredibility = (
            Q.progressive_credibility + Q.migration_border_competence +
            Q.migration_local_service_capacity + Q.issue_ownership
        ) / 4;
    }
    const reach = clampMood(derivedReach, 0, 100);
    const audienceTrust = clampMood(derivedAudienceTrust, 0, 100);
    const frame = clampMood(derivedFrame, -100, 100);
    const messengerCredibility = clampMood(
        derivedMessenger,
        0,
        100
    );
    const issueSalience = clampMood(
        Number.isFinite(Number(story.issueSalience))
            ? story.issueSalience
            : Q[issue + "_salience"],
        0,
        100
    );
    const leftCredibility = clampMood(derivedLeftCredibility, 0, 100);
    const direction = frame < 0 ? -1 : (frame > 0 ? 1 : 0);
    const messageCredibility = direction < 0
        ? clampMood(100 - leftCredibility * 0.5, 0, 100)
        : leftCredibility;
    const dissentEffectiveness = direction > 0
        ? (
            clampMood(Q.party_action_effectiveness, 35, 100) +
            clampMood(Q.message_discipline, 20, 100)
        ) / 200
        : 1;
    const storySignal = 100 * direction *
        (reach / 100) *
        (audienceTrust / 100) *
        (Math.abs(frame) / 100) *
        (messengerCredibility / 100) *
        (issueSalience / 100) *
        (messageCredibility / 100) *
        dissentEffectiveness;
    let receptivity = clampMood(Q.change_appetite, 0, 100);
    let resistance = 45;
    if (["social_spending", "vaccination"].includes(issue)) {
        receptivity = (
            clampMood(Q.welfare_expectation, 0, 100) +
            clampMood(Q.institutional_trust, 0, 100)
        ) / 2;
        resistance = Math.max(
            0,
            clampMood(Q.capitalism_acceptance, 0, 100) -
                clampMood(Q.welfare_expectation, 0, 100) * 0.45
        );
    } else if ([
        "abortion_rights", "lgbt_equality", "secular_state"
    ].includes(issue)) {
        receptivity = (
            clampMood(Q.change_appetite, 0, 100) +
            100 - clampMood(Q.cultural_conservatism, 0, 100)
        ) / 2;
        resistance = clampMood(Q.cultural_conservatism, 0, 100);
    } else if (["refugee_solidarity", "border_security"].includes(issue)) {
        receptivity = clampMood(Q.universal_solidarity, 0, 100);
        resistance = (
            clampMood(Q.order_threat_sensitivity, 0, 100) +
            clampMood(Q.migration_welfare_competition, 0, 100) +
            clampMood(Q.migration_disinformation, 0, 100)
        ) / 3;
    } else if (["rule_of_law", "national_security"].includes(issue)) {
        receptivity = (
            clampMood(Q.institutional_trust, 0, 100) +
            clampMood(Q.order_threat_sensitivity, 0, 100)
        ) / 2;
        resistance = 100 - clampMood(Q.institutional_trust, 0, 100);
    }
    const positiveSignal = Math.max(0, storySignal);
    const negativeSignal = Math.max(0, -storySignal);
    const persuasion = positiveSignal * (0.55 + receptivity / 220);
    const backlash =
        negativeSignal * (0.72 + resistance / 260) +
        positiveSignal * resistance / 620;
    const mobilisation =
        storySignal * (0.46 + clampMood(Q.change_appetite, 0, 100) / 240) -
        backlash * 0.12;
    const abstention =
        negativeSignal * (0.72 - clampMood(Q.change_appetite, 0, 100) / 300) -
        positiveSignal * (0.18 + audienceTrust / 600);
    const ownership =
        storySignal * (0.62 + leftCredibility / 320) - backlash * 0.10;
    Q.story_last_title = story.title || "Important story";
    Q.story_last_issue = story.label || issue;
    Q.story_last_reach = Math.round(reach);
    Q.story_last_audience_trust = Math.round(audienceTrust);
    Q.story_last_frame = Math.round(frame);
    Q.story_last_messenger_credibility =
        Math.round(messengerCredibility);
    Q.story_last_issue_salience = Math.round(issueSalience);
    Q.story_last_left_credibility = Math.round(leftCredibility);
    Q.story_last_signal = Math.round(storySignal * 10) / 10;
    Q.story_persuasion = Math.round(persuasion * 10) / 10;
    Q.story_backlash = Math.round(backlash * 10) / 10;
    Q.story_mobilisation = Math.round(mobilisation * 10) / 10;
    Q.story_abstention = Math.round(abstention * 10) / 10;
    Q.story_issue_ownership = Math.round(ownership * 10) / 10;
    Q.story_salience_memory = clampMood(
        Q.story_salience_memory + Math.abs(storySignal) * 0.70,
        0,
        100
    );
    Q.story_distrust_memory = clampMood(
        Q.story_distrust_memory + negativeSignal * 0.32 + backlash * 0.10,
        0,
        100
    );
    Q.story_backlash_memory = clampMood(
        Q.story_backlash_memory + backlash * 0.34,
        0,
        100
    );
    Q.story_reputation_memory = clampMood(
        Q.story_reputation_memory + negativeSignal * 0.20,
        0,
        100
    );
    if (Number.isFinite(Number(Q[issue + "_support"]))) {
        Q[issue + "_support"] +=
            persuasion * 0.08 - backlash * 0.035;
        Q[issue + "_salience"] += Math.abs(storySignal) * 0.38;
        Q[issue + "_backlash"] += backlash * 0.15;
    }
    const issueOwnershipKey = issue + "_left_ownership";
    Q[issueOwnershipKey] = clampMood(
        Number.isFinite(Number(Q[issueOwnershipKey]))
            ? Number(Q[issueOwnershipKey]) + ownership * 0.24
            : clampMood(Q.issue_ownership, 0, 100) + ownership * 0.24,
        0,
        100
    );
    Q.issue_ownership = clampMood(
        Number(Q.issue_ownership) + ownership * 0.055,
        0,
        100
    );
    Q.winner_reputation = clampMood(
        Number(Q.winner_reputation) +
            (persuasion - backlash - Math.max(0, abstention)) * 0.020,
        0,
        100
    );
    Q.turnout_readiness += mobilisation * 0.035 -
        Math.max(0, abstention) * 0.045;
    Q.left_poll_momentum +=
        (persuasion - backlash - Math.max(0, abstention)) * 0.012;
    Q.public_opinion_last_issue = story.label || issue;
    Q.public_opinion_last_reception = storySignal >= 2
        ? "favourable"
        : (storySignal <= -2 ? "backlash" : "contested");
    Q.public_opinion_last_delta =
        Math.round((persuasion - backlash) * 10) / 10;
    Q.public_opinion_last_action = story.title || "Important story";

    if (kind == "womens_ruling" || kind == "womens_followup") {
        let activistShift = 0;
        let sympathyShift = 0;
        let conversionShift = 0;
        let conservativeShift = 0;
        if (kind == "womens_ruling" &&
            Q.abortion_strategy == "Autonomous movement support") {
            activistShift = 12; sympathyShift = 9;
            conversionShift = 2; conservativeShift = 4;
        } else if (kind == "womens_ruling" &&
            Q.abortion_strategy == "Party-led mobilisation") {
            activistShift = 15; sympathyShift = -6;
            conversionShift = 8; conservativeShift = 13;
        } else if (kind == "womens_ruling" &&
            Q.abortion_strategy == "Broad democratic front") {
            activistShift = 9; sympathyShift = 12;
            conversionShift = 3; conservativeShift = 5;
        } else if (kind == "womens_ruling" &&
            Q.abortion_strategy == "Palace restoration front") {
            activistShift = 8; sympathyShift = 9;
            conversionShift = 3; conservativeShift = 8;
        } else if (kind == "womens_followup" &&
            Q.womens_strike_followup == "Independent legal defence") {
            activistShift = 11; sympathyShift = 5;
            conversionShift = 1; conservativeShift = 3;
        } else if (kind == "womens_followup" &&
            Q.womens_strike_followup == "Social programme") {
            activistShift = 7; sympathyShift = 7;
            conversionShift = 4; conservativeShift = 6;
        } else {
            activistShift = -8; sympathyShift = -8;
            conversionShift = -5; conservativeShift = -2;
        }
        Q.womens_strike_activist_mobilisation += activistShift +
            Math.max(0, mobilisation) * 0.12;
        Q.womens_strike_public_sympathy += sympathyShift +
            persuasion * 0.08 - backlash * 0.08;
        Q.womens_strike_party_conversion += conversionShift +
            ownership * 0.06;
        Q.womens_strike_conservative_backlash += conservativeShift +
            backlash * 0.10;
    }
}

// Pandemic trajectory: the initial emergency creates solidaristic and public-
// health openings. Prolonged restriction, insecurity and administrative
// distrust later feed order and anti-system politics unless the Left has made
// workplace protection and public services visibly its own.
if (Q.covid_event_done && !Q.pandemic_attitude_opening_applied) {
    Q.universal_solidarity += 5;
    Q.welfare_expectation += 2;
    Q.institutional_trust += 2;
    Q.vaccination_salience += 18;
    Q.social_spending_salience += 5;
    Q.pandemic_attitude_opening_applied = 1;
}
const prolongedPandemic = Q.covid_event_done && (
    Q.year == 2020 && Q.month >= 9 ||
    Q.year == 2021 ||
    Q.year == 2022 && Q.month <= 4
);
if (prolongedPandemic) {
    const workplaceOwnership = (
        clampMood(Q.labor_credibility, 0, 100) +
        clampMood(Q.health_capacity, 0, 100) +
        clampMood(Q.social_spending_left_ownership, 0, 100) +
        clampMood(Q.vaccination_left_ownership, 0, 100)
    ) / 4;
    const pandemicWear = 0.18 +
        clampMood(Q.pandemic_deaths_pressure, 0, 100) / 260 +
        Math.max(0, 48 - clampMood(Q.household_security, 0, 100)) / 180;
    const protection = Math.max(0, workplaceOwnership - 45) / 150;
    const defensiveDrift = Math.max(0, pandemicWear - protection);
    Q.order_threat_sensitivity += pandemicWear * 0.42;
    Q.capitalism_acceptance += defensiveDrift * 0.20;
    Q.cultural_conservatism += defensiveDrift * 0.16;
    Q.universal_solidarity -= defensiveDrift * 0.28;
    Q.institutional_trust -= defensiveDrift * 0.30;
    Q.change_appetite += pandemicWear * 0.16;
    Q.covid_anti_system_pressure +=
        defensiveDrift * 0.55;
    if (workplaceOwnership >= 58) {
        Q.issue_ownership += 0.12;
        Q.covid_anti_system_pressure -= 0.12;
    }
}

// Historical Lewica decline is a hostile pressure track with authored shocks
// and slow organisational counterplay. No branch directly changes cultural
// conservatism or welfare expectation.
const applyHistoryShift = function(shifts, label) {
    for (const quality of Object.keys(shifts)) {
        Q[quality] = clampMood(Number(Q[quality]) + shifts[quality], 0, 100);
    }
    Q.historical_pressure_last = label;
};
if (Q.pres_first_round_complete && !Q.historical_presidential_2020_applied) {
    const result2020 = Number.isFinite(Number(Q.presidential_result))
        ? Number(Q.presidential_result)
        : 2.22;
    // The count itself has already committed organisational consequences.
    // Voter consideration and participation live in the time-limited
    // pres_feedback record; do not manufacture a second permanent poll shock.
    Q.historical_pressure_last =
        "The 2020 presidential result of " + result2020 + "% is judged " +
        (Q.pres_performance_band || "against its campaign expectation");
    Q.historical_presidential_2020_applied = 1;
}
if (Q.recovery_fund_event_done && !Q.historical_recovery_bargain_applied) {
    if (Q.recovery_fund_strategy == "Negotiated PiS deal") {
        applyHistoryShift({
            issue_ownership: 4,
            electoral_viability: -4,
            winner_reputation: -6,
            coalition_blur: 8
        }, "Recovery-fund safeguards deliver policy while making Lewica look like PiS's rescuer");
    } else if (Q.recovery_fund_strategy == "Common opposition slate" ||
        Q.recovery_fund_strategy == "Presidential safeguards") {
        applyHistoryShift({
            issue_ownership: 2,
            winner_reputation: 2,
            coalition_blur: -2
        }, "Recovery-fund delivery remains visibly distinct from rescuing PiS");
    } else {
        applyHistoryShift({
            issue_ownership: -2,
            electoral_viability: -1
        }, "Lewica avoids the rescue charge but gains little ownership of recovery policy");
    }
    Q.historical_recovery_bargain_applied = 1;
}
if (Q.left_revolt_event_done && !Q.historical_merger_conflict_applied) {
    if (Q.merger_resolution == "No merger, no revolt") {
        Q.historical_pressure_last =
            "No merger leadership existed to produce the 2021 revolt";
    } else if (
        Q.merger_resolution == "Executive suspensions" ||
        Q.merger_resolution == "Razem discipline"
    ) {
        applyHistoryShift({
            leadership_authority: -9,
            winner_reputation: -4,
            list_confidence: -7,
            media_access: -2
        }, "Merger conflict and leadership discipline damage renewal and authority");
    } else if (Q.merger_resolution == "Membership ballot") {
        applyHistoryShift({
            leadership_authority: 4,
            list_confidence: 5,
            winner_reputation: 2
        }, "A member ballot converts merger conflict into a renewal mandate");
    } else {
        applyHistoryShift({
            leadership_authority: -2,
            list_confidence: -1
        }, "A merger truce contains rather than resolves the authority dispute");
    }
    Q.historical_merger_conflict_applied = 1;
}
if ((Q.year > 2021 || Q.year == 2021 && Q.month >= 7) &&
    !Q.historical_tusk_squeeze_applied) {
    const differentiation = (
        clampMood(Q.issue_ownership, 0, 100) +
        clampMood(Q.labor_credibility, 0, 100) +
        clampMood(Q.media_access, 0, 100)
    ) / 3;
    const squeeze = Math.max(1, 7 - Math.max(0, differentiation - 42) / 8);
    applyHistoryShift({
        electoral_viability: -squeeze,
        media_access: -squeeze * 0.8,
        winner_reputation: -squeeze * 0.45
    }, differentiation >= 56
        ? "Tusk centralises the opposition, but a differentiated Left keeps an audience"
        : "Tusk's return centralises the anti-PiS electorate around KO");
    Q.historical_tusk_squeeze_applied = 1;
}
if (Q.ukraine_invasion_event_done && !Q.historical_war_inflation_applied) {
    const preparedMaterialSecurity = (
        clampMood(Q.labor_credibility, 0, 100) +
        clampMood(Q.household_security, 0, 100) +
        clampMood(Q.national_security_left_ownership, 0, 100)
    ) / 3;
    const securityPenalty = Math.max(
        1,
        7 - Math.max(0, preparedMaterialSecurity - 42) / 7
    );
    applyHistoryShift({
        electoral_viability: -securityPenalty,
        winner_reputation: -securityPenalty * 0.55,
        issue_ownership: preparedMaterialSecurity >= 58 ? 2 : -3
    }, preparedMaterialSecurity >= 58
        ? "Prepared material-security policy keeps Lewica relevant through war and inflation"
        : "War and inflation privilege government, security and large-party competence");
    Q.historical_war_inflation_applied = 1;
}
if (Q.rates_lists_2022_done && !Q.historical_common_list_applied) {
    const listPressure = clampMood(Q.opposition_list_pressure, 0, 100);
    applyHistoryShift({
        list_confidence: -Math.max(1, listPressure * 0.22),
        issue_ownership: -Math.max(0, listPressure - 5) * 0.10,
        electoral_viability: -Math.max(0, listPressure - 4) * 0.10
    }, listPressure <= 5
        ? "Written list conditions protect a distinct Left identity"
        : "Common-list pressure and tactical voting weaken distinct identity");
    Q.historical_common_list_applied = 1;
}
if (Q.election_2023_certified && !Q.historical_election_2023_applied) {
    const result2023 = Number.isFinite(Number(Q.election_2023_left_vote))
        ? Number(Q.election_2023_left_vote)
        : 8.61;
    const benchmarkGap = result2023 - 12.56;
    applyHistoryShift({
        electoral_viability: benchmarkGap * 1.2,
        winner_reputation: benchmarkGap * 1.4,
        list_confidence: benchmarkGap * 0.9
    }, result2023 >= 11
        ? "The 2023 result reverses the expected decline"
        : "The 2023 result confirms that 2019 was no permanent floor");
    Q.historical_election_2023_applied = 1;
}
if (Q.movement_reckoning_2024_done && !Q.historical_abortion_failure_applied) {
    const deliveryRepair = Q.movement_reckoning_result ==
        "Clinical access and legal defence before another vote" ? 4 : 0;
    const capturePenalty = Q.movement_reckoning_result ==
        "Party command of the reproductive-rights campaign" ? 5 : 0;
    applyHistoryShift({
        issue_ownership: -6 + deliveryRepair,
        winner_reputation: -4,
        coalition_blur: 5 + capturePenalty,
        list_confidence: -2 - capturePenalty
    }, deliveryRepair
        ? "Failed abortion reform costs trust, but clinical delivery limits the damage"
        : "Failed abortion reform leaves responsibility without delivery credit");
    Q.historical_abortion_failure_applied = 1;
}
if (Q.razem_split && !Q.historical_razem_rupture_applied) {
    applyHistoryShift({
        list_confidence: -9,
        winner_reputation: -5,
        issue_ownership: -3,
        leadership_authority: -4
    }, "The Razem rupture weakens trust in a common Left list");
    Q.historical_razem_rupture_applied = 1;
}
if (Q.pres_2025_round_one_done && !Q.historical_presidential_2025_applied) {
    const backedResult = Number(Q.pres_2025_player_result) ||
        Number(Q.pres_2025_r1_left) || 0;
    const fieldResult = Number(Q.pres_2025_field_result) ||
        Number(Q.pres_2025_left_result) || 0;
    // Candidate and field were scored separately at the count. In particular,
    // the stronger candidate cannot erase a defeat for the backed leadership.
    Q.historical_pressure_last = Q.pres_2025_leadership_defeat
        ? "Biejat's " + backedResult +
            "% trails Zandberg despite a " + fieldResult +
            "% Left field, opening a leadership challenge"
        : "The backed candidate wins " + backedResult +
            "% and the total Left field " + fieldResult + "%";
    Q.historical_presidential_2025_applied = 1;
}

const organisationCounterplay = (
    clampMood(Q.local_network, 0, 100) +
    clampMood(Q.organiser_energy, 0, 100) +
    clampMood(Q.party_unity, 0, 100)
) / 3;
const credibilityCounterplay = (
    clampMood(Q.labor_credibility, 0, 100) +
    clampMood(Q.progressive_credibility, 0, 100) +
    clampMood(Q.government_delivery, 0, 100)
) / 3;
Q.media_access +=
    (clampMood(Q.media_capacity, 0, 100) - Q.media_access) * 0.018;
Q.leadership_authority +=
    (clampMood(Q.party_unity, 0, 100) - Q.leadership_authority) * 0.012;
Q.list_confidence +=
    (organisationCounterplay - Q.list_confidence) * 0.010;
Q.issue_ownership +=
    (credibilityCounterplay - Q.issue_ownership) * 0.008;
Q.electoral_viability +=
    (organisationCounterplay - Q.electoral_viability) * 0.006;
const winnerCounterplay = (
    clampMood(Q.electoral_viability, 0, 100) +
    clampMood(Q.issue_ownership, 0, 100) +
    clampMood(Q.public_trust, 0, 100) +
    (Q.left_in_government
        ? clampMood(Q.government_delivery, 0, 100)
        : organisationCounterplay)
) / 4;
Q.winner_reputation +=
    (winnerCounterplay - Q.winner_reputation) * 0.006;
if (Q.left_in_government) {
    Q.coalition_blur +=
        Math.max(0, clampMood(Q.government_coalition_dissent, 0, 100) - 35) *
            0.008 +
        Math.max(0, 50 - clampMood(Q.issue_ownership, 0, 100)) * 0.006 -
        Math.max(0, clampMood(Q.government_delivery, 0, 100) - 45) * 0.010;
} else {
    Q.coalition_blur -= 0.18;
}
for (const quality of [
    "electoral_viability", "winner_reputation", "issue_ownership",
    "leadership_authority", "coalition_blur", "media_access",
    "list_confidence"
]) {
    Q[quality] = clampMood(Q[quality], 0, 100);
}
const tacticalFragility = Math.max(0, (
    55 - Q.electoral_viability +
    55 - Q.winner_reputation +
    55 - Q.list_confidence +
    50 - Q.issue_ownership
) / 4);
const tacticalKoTarget = clampMood(
    tacticalFragility * (Q.ko_leader == "Donald Tusk" ? 0.34 : 0.22),
    0,
    18
);
const tacticalAbstentionTarget = clampMood(
    tacticalFragility * (0.22 + Q.coalition_blur / 500),
    0,
    16
);
const tacticalP2050Target = Q.p2050_emerged
    ? clampMood(tacticalFragility * 0.10, 0, 7)
    : 0;
Q.tactical_desertion_to_ko +=
    (tacticalKoTarget - Q.tactical_desertion_to_ko) * 0.16;
Q.tactical_desertion_to_abstention +=
    (tacticalAbstentionTarget - Q.tactical_desertion_to_abstention) * 0.14;
Q.tactical_desertion_to_p2050 +=
    (tacticalP2050Target - Q.tactical_desertion_to_p2050) * 0.16;

// Public attention can cool quickly between shocks. Support itself does not
// reset; distrust, backlash and party reputation recover through the much
// slower and deliberately uneven memory tracks above.
const publicOpinionIssues = Array.isArray(Q.public_opinion_issues)
    ? Q.public_opinion_issues
    : [
        "abortion_rights",
        "refugee_solidarity",
        "border_security",
        "vaccination",
        "social_spending",
        "lgbt_equality",
        "secular_state",
        "rule_of_law",
        "national_security"
    ];
const publicIssueLabels = {
    abortion_rights: "Abortion rights",
    refugee_solidarity: "Refugees and asylum solidarity",
    border_security: "Eastern-border security",
    vaccination: "Vaccination and public health",
    social_spending: "Social spending and public services",
    lgbt_equality: "LGBT equality",
    secular_state: "Secular state and schools",
    rule_of_law: "Rule-of-law repair",
    national_security: "Defence and allied security"
};
const clampPublic = function(value) {
    return Math.max(0, Math.min(100, Number(value) || 0));
};
const bridgeDelta = function(name, current) {
    const quality = "public_bridge_" + name;
    const previous = Number(Q[quality]);
    const now = Number(current);
    const safeNow = Number.isFinite(now) ? now : 0;
    const safePrevious = Number.isFinite(previous) ? previous : safeNow;
    Q[quality] = safeNow;
    return Math.max(-12, Math.min(12, safeNow - safePrevious));
};
const shiftPublicIssue = function(
    issue,
    supportShift,
    salienceShift,
    backlashShift
) {
    Q[issue + "_support"] = clampPublic(
        Number(Q[issue + "_support"]) + supportShift
    );
    Q[issue + "_salience"] = clampPublic(
        Number(Q[issue + "_salience"]) + salienceShift
    );
    Q[issue + "_backlash"] = clampPublic(
        Number(Q[issue + "_backlash"]) + backlashShift
    );
};

// Bridge authored substantive trackers into public opinion. Only the change
// since the previous month is translated, so a high standing value cannot
// produce the same bonus forever and a one-off event shift is preserved.
const feministDelta = bridgeDelta("feminist_trust", Q.feminist_trust);
const refugeeDelta = bridgeDelta("refugee_empathy", Q.refugee_empathy);
const borderDelta = bridgeDelta(
    "border_confidence",
    Q.border_security_confidence
);
const borderRightsDelta = bridgeDelta(
    "border_rights",
    Q.border_rights_standard
);
const farRightDelta = bridgeDelta("far_right_agenda", Q.far_right_agenda);
const minorityDelta = bridgeDelta("minority_safety", Q.minority_safety);
const householdDelta = bridgeDelta(
    "household_security",
    Q.household_security
);
const healthDelta = bridgeDelta("health_capacity", Q.health_capacity);
const pandemicDelta = bridgeDelta(
    "pandemic_pressure",
    Q.pandemic_deaths_pressure
);
const antiUkrainianDelta = bridgeDelta(
    "anti_ukrainian",
    Q.anti_ukrainian_pressure
);
const judicialDelta = bridgeDelta(
    "judicial_legitimacy",
    Q.judicial_legitimacy
);
const repairDelta = bridgeDelta(
    "repair_mandate",
    Q.judicial_repair_mandate
);
const militaryDelta = bridgeDelta("military_trust", Q.military_trust);
const policeDelta = bridgeDelta("police_trust", Q.police_trust);
const refugeeServiceDelta = bridgeDelta(
    "refugee_services",
    Q.refugee_service_capacity
);

// Keep the five migration components legible even though older authored
// scenes still write to the established refugee/border qualities.
Q.migration_empathy = clampPublic(
    Number(Q.migration_empathy) + refugeeDelta * 0.72 -
        antiUkrainianDelta * 0.20
);
Q.migration_border_competence = clampPublic(
    Number(Q.migration_border_competence) + borderDelta * 0.78
);
Q.migration_local_service_capacity = clampPublic(
    Number(Q.migration_local_service_capacity) + refugeeServiceDelta * 0.82
);
Q.migration_welfare_competition = clampPublic(
    Number(Q.migration_welfare_competition) -
        Math.max(0, refugeeServiceDelta) * 0.45 +
        Math.max(0, -householdDelta) * 0.20 +
        Math.max(0, antiUkrainianDelta) * 0.22
);
Q.migration_disinformation = clampPublic(
    Number(Q.migration_disinformation) +
        Math.max(0, antiUkrainianDelta) * 0.42 +
        Math.max(0, farRightDelta) * 0.24 -
        Math.max(0, refugeeServiceDelta) * 0.18
);

shiftPublicIssue(
    "abortion_rights",
    feministDelta * 0.24,
    Math.abs(feministDelta) * 0.16 + Math.max(0, farRightDelta) * 0.16,
    Math.max(0, -feministDelta) * 0.20 +
        Math.max(0, farRightDelta) * 0.20
);
shiftPublicIssue(
    "refugee_solidarity",
    refugeeDelta * 0.34 +
        borderRightsDelta * 0.16 -
        antiUkrainianDelta * 0.30 +
        refugeeServiceDelta * 0.18 -
        Math.max(0, Number(Q.migration_welfare_competition) - 45) * 0.010 -
        Math.max(0, Number(Q.migration_disinformation) - 45) * 0.012,
    Math.abs(refugeeDelta) * 0.18 +
        Math.abs(antiUkrainianDelta) * 0.28 +
        Math.max(0, farRightDelta) * 0.18 +
        Math.abs(refugeeServiceDelta) * 0.08,
    Math.max(0, -refugeeDelta) * 0.24 +
        Math.abs(antiUkrainianDelta) * 0.22 +
        Math.max(0, farRightDelta) * 0.20 +
        Math.max(0, -refugeeServiceDelta) * 0.18
);
shiftPublicIssue(
    "border_security",
    borderDelta * 0.28 + policeDelta * 0.08,
    Math.abs(borderDelta) * 0.18 +
        Math.max(0, farRightDelta) * 0.18,
    Math.max(0, -borderDelta) * 0.18 +
        Math.max(0, farRightDelta) * 0.18
);
shiftPublicIssue(
    "vaccination",
    healthDelta * 0.18 + pandemicDelta * 0.12,
    Math.abs(healthDelta) * 0.10 + pandemicDelta * 0.34,
    Math.abs(pandemicDelta) * 0.14 +
        Math.max(0, farRightDelta) * 0.08
);
shiftPublicIssue(
    "social_spending",
    householdDelta * 0.12 +
        (householdDelta < 0 ? -householdDelta * 0.08 : 0) +
        healthDelta * 0.08,
    -householdDelta * 0.24 - healthDelta * 0.10,
    Math.max(0, -householdDelta) * 0.14
);
shiftPublicIssue(
    "lgbt_equality",
    feministDelta * 0.16 + minorityDelta * 0.22,
    Math.abs(minorityDelta) * 0.14 +
        Math.max(0, farRightDelta) * 0.22,
    Math.max(0, -minorityDelta) * 0.24 +
        Math.max(0, farRightDelta) * 0.24
);
shiftPublicIssue(
    "secular_state",
    feministDelta * 0.08 + judicialDelta * 0.06,
    Math.abs(feministDelta) * 0.08 +
        Math.max(0, farRightDelta) * 0.18,
    Math.max(0, farRightDelta) * 0.22
);
shiftPublicIssue(
    "rule_of_law",
    judicialDelta * 0.22 + repairDelta * 0.26,
    Math.abs(judicialDelta) * 0.16 +
        Math.abs(repairDelta) * 0.18,
    Math.max(0, -judicialDelta) * 0.18 +
        Math.max(0, farRightDelta) * 0.10
);
shiftPublicIssue(
    "national_security",
    militaryDelta * 0.30 + borderDelta * 0.08,
    Math.abs(militaryDelta) * 0.14 +
        Math.abs(borderDelta) * 0.08,
    Math.max(0, -militaryDelta) * 0.18
);
Q.public_opinion_bridge_pressure = Math.round(
    (
        Math.abs(feministDelta) +
        Math.abs(refugeeDelta) +
        Math.abs(borderDelta) +
        Math.abs(borderRightsDelta) +
        Math.abs(farRightDelta) +
        Math.abs(minorityDelta) +
        Math.abs(householdDelta) +
        Math.abs(healthDelta) +
        Math.abs(pandemicDelta) +
        Math.abs(antiUkrainianDelta) +
        Math.abs(judicialDelta) +
        Math.abs(repairDelta) +
        Math.abs(militaryDelta) +
        Math.abs(policeDelta) +
        Math.abs(refugeeServiceDelta)
    ) / 15
);
let publicPanicTotal = 0;
let publicConsensusTotal = 0;
let hottestPublicIssue = publicOpinionIssues[0];
let hottestPublicIssueScore = -1;
for (const issue of publicOpinionIssues) {
    const supportKey = issue + "_support";
    const salienceKey = issue + "_salience";
    const backlashKey = issue + "_backlash";
    const support = Math.max(0, Math.min(100, Number(Q[supportKey]) || 0));
    let salience = Math.max(
        0,
        Math.min(100, Number(Q[salienceKey]) || 0)
    );
    let backlash = Math.max(
        0,
        Math.min(100, Number(Q[backlashKey]) || 0)
    );
    const salienceDecay = Q.hard_mode ? 0.55 : 0.85;
    salience = Math.max(0, salience - salienceDecay);
    const backlashTarget = Math.min(
        100,
        24 + Math.abs(support - 50) * 0.45 + salience * 0.24
    );
    backlash += (backlashTarget - backlash) * 0.015;
    Q[supportKey] = support;
    Q[salienceKey] = salience;
    Q[backlashKey] = backlash;
    const heat = salience * 0.65 + backlash * 0.35;
    publicPanicTotal += heat;
    publicConsensusTotal +=
        Math.abs(support - 50) * 2 * (1 - backlash / 200);
    if (heat > hottestPublicIssueScore) {
        hottestPublicIssueScore = heat;
        hottestPublicIssue = issue;
    }
}
Q.public_panic_index = Math.round(
    publicPanicTotal / publicOpinionIssues.length
);
Q.public_consensus_index = Math.round(
    publicConsensusTotal / publicOpinionIssues.length
);
Q.public_opinion_hottest_issue =
    publicIssueLabels[hottestPublicIssue] || hottestPublicIssue;
Q.public_opinion_last_updated = Q.date_label + " monthly model";

// Women's Strike participation cools faster than movement reputation. Broad
// sympathy, conservative backlash and party-conversion memory move on separate
// clocks, so a party capture can grow the activist core and still narrow the
// public coalition.
if (Q.strike_event_done) {
    Q.womens_strike_activist_mobilisation = Math.max(
        0,
        Number(Q.womens_strike_activist_mobilisation) -
            (Q.year >= 2022 ? 0.55 : 0.28)
    );
    Q.womens_strike_public_sympathy +=
        (50 - Number(Q.womens_strike_public_sympathy)) * 0.004;
    Q.womens_strike_party_conversion *= 0.994;
    Q.womens_strike_conservative_backlash *= 0.992;
}
for (const attitude of [
    "capitalism_acceptance", "welfare_expectation",
    "cultural_conservatism", "order_threat_sensitivity",
    "universal_solidarity", "institutional_trust", "change_appetite"
]) {
    Q[attitude] = clampPublic(Q[attitude]);
}
for (const trajectory of [
    "womens_strike_activist_mobilisation",
    "womens_strike_public_sympathy",
    "womens_strike_party_conversion",
    "womens_strike_conservative_backlash",
    "migration_empathy", "migration_border_competence",
    "migration_local_service_capacity", "migration_welfare_competition",
    "migration_disinformation"
]) {
    Q[trajectory] = clampPublic(Q[trajectory]);
}

if (Q.year == 2020 && Q.month >= 1) {
    Q.next_budget_label = "December 2020";
}
if (Q.year == 2021) {
    Q.next_budget_label = "December 2021";
}
if (Q.year == 2022) {
    Q.next_budget_label = "December 2022";
}
if (Q.year >= 2023) {
    Q.next_budget_label = "December " + Q.year;
}
!}
go-to: poland_party_ai

= [+ date_label +]

The leadership clears its calendar. Politics does not.
