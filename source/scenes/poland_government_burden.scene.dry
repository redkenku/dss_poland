	["spurek", "Sylwia Spurek"],
	["semieniuk", "Olga Semeniuk-Patkowska"],
	["cieszynski", "Janusz Cieszyński"]
];
const activeAdvisorNames = advisorRoster
	.filter(function(advisor) {
		return Number(Q[advisor[0] + "_advisor"]) === 1;
	})
	.map(function(advisor) {
		return advisor[1];
	});
const liveLeadership = String(Q.left_leader || "").trim();
const defaultLeadership = "Włodzimierz Czarzasty and Robert Biedroń";
if (!activeAdvisorNames.length) {
	Q.government_burden_leaders = "the collective party leadership";
} else if (liveLeadership && liveLeadership !== defaultLeadership) {
	Q.government_burden_leaders = liveLeadership;
} else if (activeAdvisorNames.length === 1) {
