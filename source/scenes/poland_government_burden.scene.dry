choose-if: budget >= 1
unavailable-subtitle: Indexation requires one budget point.
on-arrival: budget -= 1; household_security += 5; workers_support += 3; government_delivery += 3; government_goal_welfare = 1; ko_relation -= 2; government_coalition_dissent += 4; fiscal_stress += 2; news_headline = "Benefit thresholds rise before another cabinet review"
