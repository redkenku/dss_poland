Q.constitutional_restraint += 7;
Q.public_trust += 5;
if (code == "24") {
    Q.acting_presidency_scope = "Published continuity protocol; no power to shorten the Sejm term";
    Q.president_relation += 2;
} else if (code == "25") {
    Q.party_unity += 2;
    Q.media_capacity += 2;
} else if (code == "27") {
    Q.media_safety_capacity += 9;
    Q.minority_safety += 7;
    Q.police_trust += 3;
    Q.far_right_agenda -= 2;
}
Q.news_headline = "A joint constitutional response contains the shock without choosing its beneficiary";
!}

