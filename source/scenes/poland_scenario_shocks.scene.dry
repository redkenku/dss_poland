@domestic_shock
# scenario-ledger: SHK-13, SHK-16, SHK-17, SHK-19, SHK-28
# prose-audit: Grade A — Economic, health, environmental, labour and corruption shocks retain independent persisted rolls and draw their consequences from the live capacities or exposure ledger.
title: A domestic shock clears its persisted threshold
subtitle: Capacity shapes damage and response; preparation cannot prevent the external event
new-page: true
tags: poland_event
priority: 48
order: 101
max-visits: 5
view-if: continuous_campaign = 1 and (shock_13_ready = 1 or shock_16_ready = 1 or shock_17_ready = 1 or shock_19_ready = 1 or shock_28_ready = 1) and election_2027_terminal = 0
on-arrival: {!
const order = ["28", "16", "17", "19", "13"];
const code = order.find(function(id) { return Number(Q["shock_" + id + "_ready"]); });
Q.shock_active_code = code || "none";
if (code) Q["shock_" + code + "_done"] = 1;
if (code == "13") {
    Q.shock_13_outcome = "A German recession hits Polish industrial and logistics demand";
    Q.unemployment += 2.1;
    Q.household_security -= 9;
    Q.fiscal_stress += 9;
    Q.industrial_support -= 5;
} else if (code == "16") {
    Q.shock_16_outcome = "A new respiratory pathogen reaches Poland";
    Q.health_capacity -= Math.max(3, Math.round((60 - Number(Q.health_capacity || 0)) / 5));
    Q.household_security -= 5;
    Q.public_mood_pending_vaccination_backlash += 5;
} else if (code == "17") {
    Q.shock_17_outcome = "A second warm-season ecological collapse reaches the Oder";
    Q.climate_policy_pressure += 15;
    Q.public_trust -= 5;
    Q.climate_state_capacity -= 3;
} else if (code == "19") {
    Q.shock_19_outcome = "A coal-region revolt follows a closure and weak replacement investment";
    Q.union_trust -= 9;
    Q.energy_security -= 5;
    Q.far_right_agenda += 5;
} else if (code == "28") {
    const cpkExposure = Number(Q.cpk_stage || 0) >= 1 &&
        !Number(Q.cpk_cancelled || 0)
        ? Math.max(0, Number(Q.cpk_cost_pressure || 0) +
            Number(Q.cpk_land_conflict || 0) -
            (Number(Q.cpk_transparency || 0) ? 15 : 0) -
            Math.max(0, Number(Q.cpk_delivery || 0)) * 0.2)
        : 0;
    const exposures = [
        ["CPK procurement", cpkExposure],
        ["KPO delivery", Number(Q.kpo_patronage_risk || 0)],
        ["flood reconstruction", Number(Q.flood_reconstruction_exposure || 0)],
        ["nuclear procurement", Number(Q.nuclear_delivery_risk || 0)],
        ["public media", Number(Q.media_pluralism_pressure || 0)],
        ["active procurement", Number(Q.procurement_scandal_pressure || 0)]
    ].sort(function(left, right) { return right[1] - left[1]; });
    Q.shock_source_ledger = exposures[0][0];
    Q.shock_28_outcome = "A major corruption file opens in " + Q.shock_source_ledger;
    Q.public_trust -= 9;
    Q.government_coalition_dissent += 9;
}
Q.news_headline = code ? Q["shock_" + code + "_outcome"] : "No domestic shock";
!}

