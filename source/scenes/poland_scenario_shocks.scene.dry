title: Persisted audited shocks

@security_shock
# scenario-ledger: SHK-04, SHK-05, SHK-06, SHK-21, SHK-22
# prose-audit: Grade A — One of five independently rolled security shocks is selected from current causal eligibility; attribution, alliance consultation and operational response remain separate.
title: A security shock clears its persisted threshold
subtitle: The setup roll is fixed; rising documented risk can make the event eligible without a reload reroll
new-page: true
tags: poland_event
priority: 58
order: 100
max-visits: 5
view-if: continuous_campaign = 1 and (shock_04_ready = 1 or shock_05_ready = 1 or shock_06_ready = 1 or shock_21_ready = 1 or shock_22_ready = 1) and election_2027_terminal = 0
on-arrival: {!
const order = ["04", "06", "05", "21", "22"];
const code = order.find(function(id) { return Number(Q["shock_" + id + "_ready"]); });
Q.shock_active_code = code || "none";
if (code) Q["shock_" + code + "_done"] = 1;
if (code == "04") {
    Q.shock_attribution_confidence = Math.max(20, Math.min(95,
        Number(Q.military_trust || 0) + Number(Q.us_defence_channel || 0) * 0.3));
    Q.shock_04_outcome = "A Russian weapon strikes Polish territory; attribution and NATO consultation begin";
    Q.military_trust -= 3;
    Q.war_escalation_risk += 15;
    Q.fiscal_stress += 5;
    Q.government_coalition_dissent += 5;
} else if (code == "05") {
    Q.shock_05_outcome = "Ceasefire lines halt large-scale fighting and open guarantees and reconstruction talks";
    Q.war_escalation_risk -= 9;
    Q.war_fatigue -= 5;
    Q.refugee_empathy += 3;
    Q.fiscal_stress += 2;
} else if (code == "06") {
    Q.shock_06_outcome = "A Ukrainian battlefield collapse produces a refugee and eastern-reinforcement emergency";
    Q.war_escalation_risk += 15;
    Q.border_service_capacity -= 9;
    Q.health_capacity -= 5;
    Q.household_security -= 5;
} else if (code == "21") {
    Q.shock_21_outcome = "A blackout follows a coordinated cyberattack on energy dispatch";
    Q.energy_security -= 9;
    Q.household_security -= 5;
    Q.public_trust -= 3;
} else if (code == "22") {
    Q.shock_22_outcome = "Sabotage damages a rail and arms-logistics node serving Ukraine";
    Q.police_trust -= 5;
    Q.ukraine_solidarity -= 3;
    Q.war_escalation_risk += 5;
}
Q.news_headline = code ? Q["shock_" + code + "_outcome"] : "No security shock";
!}

= [+ date_label +] — A fixed roll, a live cause

[? if shock_active_code = "04": A Russian weapon has struck Polish territory.
Attribution confidence is **[+ shock_attribution_confidence +]**. Article 4 or
5 consultation, mobilisation and retaliation rhetoric are separate decisions;
one press statement cannot settle all four.?]
[? if shock_active_code = "05": A ceasefire stops large-scale fighting. It
closes later battlefield-collapse eligibility while opening guarantees,
reconstruction, refugee return or integration and defence-budget choices.?]
[? if shock_active_code = "06": Ukrainian lines collapse. New arrivals and
eastern reinforcement reach housing, health and integration systems with the
capacity the campaign actually built.?]
[? if shock_active_code = "21": Operators restore power while investigators
separate emergency repair, attribution and any request for surveillance
powers.?]
[? if shock_active_code = "22": Rail and arms logistics are damaged. Evidence,
secrecy, NATO consultation and safeguards will decide whether the response
protects Ukraine support or corrodes it.?]

- @security_shock_evidence
- @security_shock_force

@security_shock_evidence
title: Separate restoration, evidence and alliance consultation
subtitle: Choose a proportionate response with safeguards and accept slower political certainty.
on-arrival: {!
const code = String(Q.shock_active_code || "none");
Q.constitutional_restraint += 5;
Q.public_trust += 3;
if (code == "04") {
    Q.us_alliance_reliability += 5;
    Q.military_trust += 5;
    Q.war_escalation_risk -= 5;
} else if (code == "05") {
    Q.border_integration_capacity += 5;
    Q.ukraine_solidarity += 3;
    Q.fiscal_stress += 2;
} else if (code == "06") {
    Q.border_service_capacity += 5;
    Q.refugee_empathy += 5;
    Q.us_defence_channel += 3;
} else if (code == "21") {
    Q.energy_security += 7;
    Q.media_legal_security += 3;
} else if (code == "22") {
    Q.police_trust += 5;
    Q.ukraine_solidarity += 5;
    Q.prosecution_independence += 2;
}
Q.news_headline = "Evidence and operational recovery lead the security-shock response";
!}

The response becomes a later alliance, budget and election-integrity input.

- @poland_event_queue: Return to the shock desk

@security_shock_force
