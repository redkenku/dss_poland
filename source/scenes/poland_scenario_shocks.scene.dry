const code = String(Q.shock_active_code || "none");
Q.security_issue_salience += 9;
Q.constitutional_restraint -= 9;
Q.public_trust -= 2;
if (code == "04") {
    Q.war_escalation_risk += 15;
    Q.military_trust += 2;
} else if (code == "05") {
    Q.war_fatigue += 5;
    Q.refugee_empathy -= 5;
} else if (code == "06") {
    Q.border_force_pressure += 9;
    Q.minority_safety -= 5;
} else if (code == "21") {
    Q.media_legal_security -= 9;
    Q.police_trust -= 5;
} else if (code == "22") {
    Q.police_trust -= 5;
    Q.ukraine_solidarity -= 3;
}
Q.news_headline = "Emergency powers overtake the evidentiary security response";
!}

If attribution later fails, the constitutional and alliance penalty remains.

