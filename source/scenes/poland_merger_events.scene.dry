    add("labor_dissent", 6);
    add("razem_dissent", Number(Q.razem_merged) ? 7 : 3);
} else if (Q.merger_revolt_leader === "Robert Biedroń") {
    add("spring_dissent", -8);
    add("spring_strength", 3);
    add("barons_dissent", 10);
    add("progressives_dissent", 5);
    add("razem_dissent", Number(Q.razem_merged) ? 6 : 3);
} else if (Q.merger_revolt_leader === "Dual chairs") {
    add("barons_dissent", -3);
    add("spring_dissent", -3);
    add("progressives_dissent", 8);
    add("labor_dissent", 5);
    add("razem_dissent", 4);
} else {
    add("progressives_dissent", -4);
    add("labor_dissent", -4);
    add("barons_dissent", 10);
    add("spring_dissent", 6);
}
add("party_unity", -10);
add("public_trust", -4);
Q.news_headline = "The incumbent leadership suspends its internal opponents";
!}

Suspension letters remove committee posts, office access and the right to speak
in the party's name. The incumbent survives, but the constitutional dispute is
resolved by making the losing side temporarily unable to act.

