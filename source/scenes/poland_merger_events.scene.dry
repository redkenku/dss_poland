}
function add(name, amount) {
    Q[name] = (Number(Q[name]) || 0) + amount;
}
const candidates = [];
if (Number(Q.merger_barons_present) === 1 && Number(Q.barons_in_left) !== 0) {
    candidates.push({ name: "barons", score: n(Q.barons_dissent) });
}
if (Number(Q.merger_spring_present) === 1 && Number(Q.spring_in_left) !== 0) {
    candidates.push({ name: "spring", score: n(Q.spring_dissent) });
}
if (Number(Q.merger_razem_present) === 1 && Number(Q.razem_in_left) !== 0) {
    candidates.push({ name: "razem", score: n(Q.razem_dissent) });
}
if (Number(Q.merger_pps_present) === 1 && Number(Q.pps_in_left) !== 0) {
    candidates.push({ name: "pps", score: n(Q.pps_dissent) });
}
candidates.sort(function(a, b) { return b.score - a.score; });
Q.federation_exit_current = candidates.length ? candidates[0].name : "none";
if (Q.federation_exit_current === "barons") {
    Q.barons_in_left = 0;
    Q.barons_org_status = "departed";
    Q.merger_barons_present = 0;
    add("barons_dissent", -5);
} else if (Q.federation_exit_current === "spring") {
    Q.spring_in_left = 0;
    Q.spring_org_status = "departed";
    Q.merger_spring_present = 0;
    add("spring_dissent", -5);
} else if (Q.federation_exit_current === "razem") {
    Q.razem_in_left = 0;
    Q.razem_org_status = "departed";
    Q.merger_razem_present = 0;
    add("razem_cooperation", -15);
    add("razem_dissent", -5);
} else if (Q.federation_exit_current === "pps") {
    Q.pps_in_left = 0;
    Q.pps_org_status = "departed";
    Q.merger_pps_present = 0;
    Q.pps_party_formed = 1;
}
Q.left_surviving_current_count = Math.max(
    1,
    (Number(Q.left_surviving_current_count) || 1) - 1
);
Q.merger_resolution = "Most alienated federal partner departed";
add("party_unity", -6);
add("public_trust", -2);
Q.news_headline = "The most alienated partner leaves the Left federation";
!}

