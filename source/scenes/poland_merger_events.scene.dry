@revolt_ballot_count
title: Count the membership ballot
new-page: true
on-arrival: {!
function n(value) {
    return Math.max(0, Number(value) || 0);
}
function penalty(value) {
    return Math.max(0, n(value)) * 0.35;
}
const incumbent = String(Q.merger_revolt_leader || "Members");
const candidates = [];
const razemHasBureauSeat =
    Number(Q.zandberg_advisor) === 1 ||
    Number(Q.biejat_advisor) === 1 ||
    Number(Q.zawisza_advisor) === 1 ||
    Number(Q.matysiak_advisor) === 1;

if (
    Q.barons_org_status === "merged_current" &&
    Number(Q.czarzasty_advisor) === 1
) {
    candidates.push({
        name: "Włodzimierz Czarzasty",
        score: n(Q.barons_strength) - penalty(Q.barons_dissent) +
            (Q.left_machine_controller === "barons" ? 5 : 0) +
            (incumbent === "Włodzimierz Czarzasty" ? 7.25 : 0)
    });
}
if (
    Q.spring_org_status === "merged_current" &&
    Number(Q.biedron_advisor) === 1
) {
    candidates.push({
        name: "Robert Biedroń",
        score: n(Q.spring_strength) - penalty(Q.spring_dissent) +
            (Q.left_machine_controller === "spring" ? 4 : 0) +
            (incumbent === "Robert Biedroń" || incumbent === "Dual chairs" ? 7.25 : 0)
    });
}
if (
    Q.razem_org_status === "merged_current" &&
    Number(Q.razem_merged) === 1 &&
    razemHasBureauSeat
) {
    candidates.push({
        name: "Razem",
        score: n(Q.razem_strength) - penalty(Q.razem_dissent) +
            (Q.left_machine_controller === "razem" ? 4 : 0) +
            (incumbent === "Razem" ? 7.25 : 0)
    });
}
const memberCurrents = [
    n(Q.progressives_strength),
    n(Q.labor_strength),
    n(Q.pps_strength)
].sort(function(a, b) { return b - a; });
const memberScore =
    memberCurrents[0] +
    memberCurrents[1] * 0.25 +
    memberCurrents[2] * 0.15 +
    (Q.left_mandate === "member_ballot" ? 6 : 0) +
    (incumbent === "Members" ? 7.25 : 0);
candidates.push({ name: "Members", score: memberScore });

candidates.sort(function(a, b) { return b.score - a.score; });
Q.merger_ballot_winner = candidates.length ? candidates[0].name : "Members";
Q.merger_ballot_margin = candidates.length > 1
    ? candidates[0].score - candidates[1].score
    : candidates[0].score;
Q.left_mandate = "member_ballot";
Q.party_unity = (Number(Q.party_unity) || 0) + 3;
Q.public_trust = (Number(Q.public_trust) || 0) + 3;
Q.organiser_energy = (Number(Q.organiser_energy) || 0) + 2;
!}
go-to: revolt_ballot_razem if merger_ballot_winner = "Razem"; revolt_ballot_barons if merger_ballot_winner = "Włodzimierz Czarzasty"; revolt_ballot_spring if merger_ballot_winner = "Robert Biedroń"; revolt_ballot_members if merger_ballot_winner = "Members"


@revolt_ballot_razem
