@pps_crush
title: Refuse autonomy and enforce common-party discipline
on-arrival: pps_democratic_split_done = 1; left_revolt_event_done = 1; merger_resolution = "PPS autonomy suppressed"; pps_org_status = "merged_current"; pps_dissent += 12; labor_dissent += 4; party_unity -= 6; public_trust -= 2; news_headline = "The common executive blocks a separate PPS route"

