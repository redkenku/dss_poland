@pps_accept_split
title: Accept a friendly PPS parliamentary and electoral split
subtitle: Only seats already tracked as PPS-aligned leave the player's party.
on-arrival: {!
Q.pps_democratic_split_done = 1;
Q.left_revolt_event_done = 1;
Q.merger_resolution = "PPS autonomous party after democratic merger";
Q.pps_active = 1;
Q.pps_in_left = 0;
Q.pps_org_status = "departed";
Q.pps_party_formed = 1;
Q.pps_party_name = "PPS";
Q.pps_party_relation = 55;
Q.pps_circle_relation = 55;
const trackedSejmSeats = Math.max(0, Math.round(Number(Q.left_pps_seats) || 0));
const trackedSenateSeats = Math.max(
    0,
    Math.round(Number(Q.left_pps_senate_seats) || 0)
);
const ppsSejmSeats = Math.min(
    trackedSejmSeats,
    Math.max(0, Math.round(Number(Q.left_seats) || 0))
);
const ppsSenateSeats = Math.min(
    trackedSenateSeats,
    Math.max(0, Math.round(Number(Q.senate_left_seats) || 0))
);
Q.left_seats = Math.max(0, (Number(Q.left_seats) || 0) - ppsSejmSeats);
Q.left_pps_seats = 0;
Q.pps_party_seats = ppsSejmSeats;
Q.senate_left_seats = Math.max(
    0,
    (Number(Q.senate_left_seats) || 0) - ppsSenateSeats
);
Q.senate_independent_seats =
    Math.max(0, Number(Q.senate_independent_seats) || 0) + ppsSenateSeats;
Q.pps_senate_seats = ppsSenateSeats;
Q.left_pps_senate_seats = 0;
Q.pps_exit_strength = Math.max(1, Number(Q.pps_strength) || 2);
Q.pps_defector_names = ppsSejmSeats > 0 || ppsSenateSeats > 0
    ? "PPS-aligned parliamentarians"
    : "PPS organisers";
Q.konieczny_advisor = 0;
Q.kwiatkowski_advisor = 0;
Q.rozenek_in_left = 0;
Q.morawska_stanecka_in_left = 0;
Q.seat_subvention_seats = Q.left_seats;
Q.party_unity = (Number(Q.party_unity) || 0) - 2;
Q.news_headline = "PPS leaves the common party on negotiated terms";
!}

PPS registers its own party and parliamentary route. [? if pps_party_seats > 0:
