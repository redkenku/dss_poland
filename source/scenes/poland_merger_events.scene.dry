@revolt_restore_miller
title: Back the anti-merger old-guard restoration
subtitle: The old SLD establishment takes the party and locks Miller into slot 1.
view-if: merger_barons_present = 1 and barons_org_status = "merged_current" and miller_restoration_done != 1
on-arrival: {!
function add(name, amount) {
    Q[name] = (Number(Q[name]) || 0) + amount;
}
Q.merger_resolution = "SLD restoration under Miller";
Q.miller_restoration_done = 1;
Q.miller_advisor = 1;
Q.advisor_slot_1_locked = 1;
Q.advisor_slot_1 = "miller";
Q.advisor_slot_1_lock_reason = "Old SLD restoration";

const currentAdvisors = [
    "miller",
    "czarzasty",
    "biedron",
    "zandberg",
    "dziemianowicz_bak",
    "zukowska",
    "kotula",
    "biejat",
    "wieczorek",
    "gawkowski",
    "nowicka",
    "zawisza",
    "matysiak"
];
const demotionOrder = [
    "zandberg",
    "biejat",
    "zawisza",
    "matysiak",
    "biedron",
    "dziemianowicz_bak",
    "zukowska",
    "kotula",
    "gawkowski",
    "nowicka",
    "wieczorek",
    "czarzasty"
];
function countAdvisors() {
    return currentAdvisors.reduce(function(total, advisor) {
        return total + (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
    }, 0);
}
while (countAdvisors() > 3) {
    const toRemove = demotionOrder.find(function(advisor) {
        return Number(Q[advisor + "_advisor"]) === 1;
    });
    if (!toRemove) {
        break;
    }
    Q[toRemove + "_advisor"] = 0;
}
const remainingAdvisors = currentAdvisors.filter(function(advisor) {
    return advisor !== "miller" && Number(Q[advisor + "_advisor"]) === 1;
});
Q.n_advisors = countAdvisors();
Q.advisor_slot_2 = remainingAdvisors[0] || "";
Q.advisor_slot_3 = remainingAdvisors[1] || "";

Q.merger_leader = "Leszek Miller";
Q.left_dominant_current = "barons";
Q.left_machine_controller = "barons";
Q.left_mandate = "executive_coup";
Q.left_constitution = "single_leadership";
Q.left_party_name = "Nowa Lewica";
Q.barons_org_status = "merged_current";
if (Number(Q.razem_merged) === 1) {
    Q.razem_org_status = "merged_current";
}
if (Number(Q.spring_merged) === 1) {
    Q.spring_org_status = "merged_current";
}
add("barons_strength", 10);
add("barons_dissent", -10);
add("spring_dissent", 8);
add("labor_dissent", 4);
add("progressives_dissent", 8);
add("razem_dissent", Number(Q.razem_merged) === 1 ? 15 : 10);
add("party_unity", -12);
add("public_trust", -5);
Q.left_project = "Old SLD restoration in Nowa Lewica";
Q.left_leader = "Leszek Miller and the old SLD establishment";
Q.left_leadership_result = "Merger revolt restored old-SLD command";
Q.news_headline = "The anti-merger revolt restores Miller and old-SLD command";
!}

The old guard wins control of offices, committees and nominations in one night
of procedural votes. [? if razem_merged: Razem loses the leadership but remains
a merged current trapped inside the party it helped create. A later split may
follow, but this event does not pretend that Razem was merely an outside
affiliate all along.?] Wiosna and the younger currents receive the same blunt
message: the merger has been captured by the organisation it was supposed to
replace.

