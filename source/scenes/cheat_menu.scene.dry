on-arrival: party_unity = 100; barons_dissent = 0; spring_dissent = 0; labor_dissent = 0; progressives_dissent = 0; razem_dissent = 0; pps_dissent = 0; social_patriot_dissent = 0; government_coalition_dissent = 0
go-to: party_state

@capacity_max
on-arrival: public_trust = 100; media_capacity = 100; local_network = 100; labor_credibility = 100; progressive_credibility = 100; feminist_trust = 100; organiser_energy = 100; government_delivery = 100; administrative_capacity = 100
go-to: party_state

@god_mode
title: Apply the everything-is-easy preset
on-arrival: {!
Q.resources = 99;
Q.budget = Math.max(25, Number(Q.budget) || 0);
Q.month_actions = 0;
Q.max_month_actions = 99;
Q.left_poll = 35;
Q.party_unity = 100;
Q.public_trust = 100;
for (const quality of [
    "media_capacity", "local_network", "labor_credibility",
    "progressive_credibility", "feminist_trust", "organiser_energy",
    "government_delivery", "administrative_capacity", "ko_relation",
    "psl_relation", "p2050_relation", "pis_relation", "konf_relation",
    "president_relation"
]) {
    Q[quality] = 100;
}
for (const quality of [
    "barons_dissent", "spring_dissent", "labor_dissent",
    "progressives_dissent", "razem_dissent", "pps_dissent",
    "social_patriot_dissent", "government_coalition_dissent",
    "fiscal_stress"
]) {
    Q[quality] = 0;
}
!}
go-to: cheat_menu

@disable
title: Disable cheats for this save
on-arrival: cheat_enabled = 0
go-to: poland_hub
