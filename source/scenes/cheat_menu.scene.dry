title: Cheat menu
new-page: true
is-special: true
call: poland_normalize

= Cheat menu

Changes apply immediately to this save. Polling will still move when the next
monthly polling model runs.

**Quick view:** [+ resources +] resources · [+ left_poll +]% Lewica · [+
party_unity +]/100 unity · [+ public_trust +]/100 public trust.

- @money: Resources and actions
- @polls: Polling
- @relations: Relationships
- @party_state: Party and government state
- @factions: Internal factions
- @god_mode: Apply the everything-is-easy preset
- @disable: Disable cheats for this save
- @poland_hub: Back to the Leadership Table

@money
title: Resources and actions
on-arrival: {!
Q.resources = Math.max(0, Number(Q.resources) || 0);
Q.budget = Number(Q.budget) || 0;
Q.month_actions = Math.max(0, Number(Q.month_actions) || 0);
Q.max_month_actions = Math.max(1, Number(Q.max_month_actions) || 1);
!}

= Resources and actions

Party resources **[+ resources +]** · state-budget capacity **[+ budget +]** ·
actions **[+ month_actions +]/[+ max_month_actions +]**.

- @resources_up: Add 10 party resources
- @resources_down: Remove 10 party resources
- @resources_max: Set party resources to 99
- @budget_up: Add 5 state-budget capacity
- @budget_down: Remove 5 state-budget capacity
- @action_refill: Refill this month's action
- @actions_unlimited: Allow 99 actions per month
- @actions_normal: Restore the normal one-action limit
- @cheat_menu: Back to the cheat menu

@resources_up
on-arrival: resources += 10
go-to: money

@resources_down
on-arrival: resources -= 10
go-to: money

@resources_max
on-arrival: resources = 99
go-to: money

@budget_up
on-arrival: budget += 5
go-to: money

@budget_down
on-arrival: budget -= 5
go-to: money

@action_refill
on-arrival: month_actions = 0
go-to: money

@actions_unlimited
on-arrival: max_month_actions = 99; month_actions = 0
go-to: money

@actions_normal
on-arrival: max_month_actions = 1; month_actions = 0
go-to: money

@polls
title: Polling
on-arrival: {!
const cheatPollIds = [
    "left", "pis", "ko", "psl", "konf", "p2050", "p0", "other",
    "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left",
    "young_left", "razem", "pps", "left_coalition", "democratic_list",
    "third_way", "tak_rozwoj", "centrum", "rozwoj", "korona",
    "ko_splinter", "suwerenna", "porozumienie", "kukiz"
];
let cheatPollTotal = 0;
for (const id of cheatPollIds) {
    Q[id + "_poll"] = Math.max(0, Number(Q[id + "_poll"]) || 0);
    cheatPollTotal += Q[id + "_poll"];
}
if (cheatPollTotal <= 0) {
    Q.other_poll = 100;
    cheatPollTotal = 100;
}
for (const id of cheatPollIds) {
    Q[id + "_poll"] = Math.round(
        Q[id + "_poll"] * 1000 / cheatPollTotal
    ) / 10;
}
let cheatRoundedTotal = cheatPollIds.reduce(function(total, id) {
    return total + Q[id + "_poll"];
}, 0);
const cheatResidual = Math.round((100 - cheatRoundedTotal) * 10) / 10;
let cheatResidualParty = "other";
if (Q.other_poll + cheatResidual < 0) {
    cheatResidualParty = cheatPollIds.slice().sort(function(left, right) {
        return Q[right + "_poll"] - Q[left + "_poll"];
    })[0];
}
Q[cheatResidualParty + "_poll"] = Math.round((
    Q[cheatResidualParty + "_poll"] + cheatResidual
) * 10) / 10;
Q.cheat_third_way_polling =
    Q.p2050_emerged && (Q.third_way_active || Q.third_way_2023_done) &&
    !Q.third_way_split &&
    String(Q.sejm_list_outcome || "left_5") != "third_host_5" ? 1 : 0;
Q.cheat_poll_total = Math.round(cheatPollIds.reduce(function(total, id) {
    return total + Q[id + "_poll"];
}, 0) * 10) / 10;
Q.cheat_other_poll = Math.round((Q.cheat_poll_total - Q.left_poll - Q.pis_poll -
    Q.ko_poll - Q.konf_poll - (Q.cheat_third_way_polling
        ? Q.third_way_poll
        : Q.psl_poll + Q.p2050_poll)) * 10) / 10;
!}

= Polling

Lewica **[+ left_poll +]%** · PiS **[+ pis_poll +]%** · KO **[+ ko_poll +]%** ·
[? if not cheat_third_way_polling: PSL **[+ psl_poll +]%** · Polska 2050 **[+
p2050_poll +]%** · ?][? if cheat_third_way_polling: Third Way **[+
third_way_poll +]%** · ?]Konfederacja **[+ konf_poll +]%** · other committees
**[+ cheat_other_poll +]%**. **Total: [+ cheat_poll_total +]%**.

- @left_poll_up: Lewica +1 point
- @left_poll_up_ten: Lewica +10 points
- @left_poll_down: Lewica −1 point
- @pis_poll_up: PiS +1 point
- @pis_poll_up_ten: PiS +10 points
- @pis_poll_down: PiS −1 point
- @ko_poll_up: KO +1 point
- @ko_poll_up_ten: KO +10 points
- @ko_poll_down: KO −1 point
- @psl_poll_up: PSL +1 point
- @psl_poll_up_ten: PSL +10 points
- @psl_poll_down: PSL −1 point
- @p2050_poll_up: Polska 2050 +1 point
- @p2050_poll_up_ten: Polska 2050 +10 points
- @p2050_poll_down: Polska 2050 −1 point
- @third_way_poll_up: Third Way +1 point
- @third_way_poll_up_ten: Third Way +10 points
- @third_way_poll_down: Third Way −1 point
- @konf_poll_up: Konfederacja +1 point
- @konf_poll_up_ten: Konfederacja +10 points
- @konf_poll_down: Konfederacja −1 point
- @cheat_menu: Back to the cheat menu

