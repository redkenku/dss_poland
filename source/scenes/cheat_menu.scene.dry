@apply_poll
on-arrival: {!
const cheatPollIds = [
    "left", "pis", "ko", "psl", "konf", "p2050", "p0", "other",
    "sld_breakaway", "social_patriot", "spring_breakaway", "labor_left",
    "young_left", "razem", "pps", "left_coalition", "democratic_list",
    "third_way", "tak_rozwoj", "centrum", "rozwoj", "korona",
    "ko_splinter", "suwerenna", "porozumienie", "kukiz"
];
const pollCaps = {
    left: 40, pis: 60, ko: 60, psl: 40, p2050: 40, konf: 40,
    third_way: 40
};
const target = Object.prototype.hasOwnProperty.call(
    pollCaps,
    Q.cheat_poll_target
) ? Q.cheat_poll_target : "left";
const targetPoll = target + "_poll";
const requestedTarget = Math.round(Math.max(
    0,
    Math.min(
        pollCaps[target],
        (Number(Q[targetPoll]) || 0) + (Number(Q.cheat_poll_delta) || 0)
    )
) * 10) / 10;
const oldRest = cheatPollIds.reduce(function(total, id) {
    return id == target ? total : total + Math.max(
        0,
        Number(Q[id + "_poll"]) || 0
    );
}, 0);
const desiredRest = 100 - requestedTarget;
for (const id of cheatPollIds) {
    if (id == target) continue;
    const value = Math.max(0, Number(Q[id + "_poll"]) || 0);
    Q[id + "_poll"] = Math.round((oldRest > 0
        ? value * desiredRest / oldRest
        : (id == "other" ? desiredRest : 0)
    ) * 10) / 10;
}
Q[targetPoll] = requestedTarget;
const roundedTotal = cheatPollIds.reduce(function(total, id) {
    return total + Q[id + "_poll"];
}, 0);
const residual = Math.round((100 - roundedTotal) * 10) / 10;
let residualParty = target == "other" ? null : "other";
if (!residualParty || Q[residualParty + "_poll"] + residual < 0) {
    residualParty = cheatPollIds.filter(function(id) {
        return id != target;
    }).sort(function(left, right) {
        return Q[right + "_poll"] - Q[left + "_poll"];
    })[0];
}
if (residualParty) {
    Q[residualParty + "_poll"] = Math.round((
        Q[residualParty + "_poll"] + residual
    ) * 10) / 10;
}
for (const id of cheatPollIds) {
    const intent = id + "_vote_intent";
    if (Number.isFinite(Number(Q[intent]))) {
        Q[intent] = Q[id + "_poll"];
    }
}
!}
go-to: polls

