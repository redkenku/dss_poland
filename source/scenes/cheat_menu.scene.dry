@faction_edit
title: Edit internal faction
on-arrival: {!
const allowedFactions = [
    "barons", "spring", "labor", "progressives", "razem", "pps",
    "social_patriot"
];
if (allowedFactions.indexOf(Q.cheat_faction) < 0) {
    Q.cheat_faction = "barons";
}
const faction = Q.cheat_faction;
Q[faction + "_strength"] = Math.max(
    0,
    Math.min(100, Number(Q[faction + "_strength"]) || 0)
);
Q[faction + "_dissent"] = Math.max(
    0,
    Math.min(100, Number(Q[faction + "_dissent"]) || 0)
);
if (faction == "labor") {
    Q.labor_parliamentary_influence = Q.labor_strength;
    Q.labor_conflict = Q.labor_dissent;
}
Q.cheat_faction_name = Q[faction + "_name"] || faction;
Q.cheat_faction_strength = Q[faction + "_strength"];
Q.cheat_faction_dissent = Q[faction + "_dissent"];
Q.cheat_faction_status = Q[faction + "_active"] && Q[faction + "_in_left"]
    ? "active inside Lewica"
    : "inactive or outside Lewica";
!}

= [+ cheat_faction_name +]

Strength **[+ cheat_faction_strength +]/100** · dissent **[+
cheat_faction_dissent +]/100** · [+ cheat_faction_status +].

- @faction_strength_up: Strength +10
- @faction_strength_down: Strength −10
- @faction_dissent_up: Dissent +10
- @faction_dissent_down: Dissent −10
- @faction_strength_max: Set strength to 100
- @faction_strength_zero: Set strength to 0
- @faction_dissent_zero: Set dissent to 0
- @faction_dissent_max: Set dissent to 100
- @faction_loyal_dominant: Set strength to 100 and dissent to 0
- @factions: Back to all factions

@faction_strength_up
on-arrival: {!
Q[Q.cheat_faction + "_strength"] =
    Number(Q[Q.cheat_faction + "_strength"]) + 10;
!}
go-to: faction_edit

@faction_strength_down
on-arrival: {!
Q[Q.cheat_faction + "_strength"] =
