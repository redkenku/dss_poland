= February 2026 — No alliance runs on autopilot

[? if us_administration = "Democratic": The Harris administration wants a
common Ukraine line, durable judicial repair and predictable coordination
between cabinet, Palace and Sejm. KO sees an institutional partnership; PiS
calls it ideological supervision.?]
[? if us_administration != "Democratic": The Republican successor wants higher
spending, procurement alignment and a bilateral technology policy. The tone is
less personal than Trump's, but the demands remain costly.?]

**Authority:** [+ foreign_authority_label +].
**Credible instruments:** [+ foreign_authority_scope +].

- @review_compact
- @review_parliament
- @review_europe
- @review_presidential

@review_compact
title: [? if foreign_authority_role = "ordinary_opposition": Propose a cabinet–Palace compact through committees and party diplomacy?][? if foreign_authority_role = "confidence_opposition": Make support conditional on a cabinet–Palace reporting compact?][? if foreign_authority_role = "junior_no_mfa": Demand a cabinet–Palace compact in coalition council?][? if foreign_authority_role = "junior_mfa": Negotiate the ministry's part inside the prime minister's mandate?][? if foreign_authority_role = "lead_no_mfa": Set the compact as cabinet strategy and direct the portfolio owner?][? if foreign_authority_role = "lead_mfa": Negotiate and implement the cabinet side of the compact?][? if foreign_authority_role = "caretaker": Preserve existing channels and leave a compact for the next cabinet?]
subtitle: Gains and responsibility scale with the office Lewica actually holds; the Palace remains a separate actor.
on-arrival: {!
const role = Q.foreign_authority_role;
if (role == "ordinary_opposition") {
    Q.us_congress_channel += 3;
    Q.us_alliance_reliability += 1;
    Q.media_capacity += 2;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome =
        "Lewica proposes a cabinet–Palace compact without claiming national agreement";
} else if (role == "confidence_opposition") {
    Q.us_congress_channel += 3;
    Q.us_alliance_reliability += 2;
    Q.government_coalition_dissent += 2;
    Q.last_policy_stage = "Conditional coordination proposal";
    Q.last_policy_authority = "Opposition confidence-and-supply agreement";
    Q.last_policy_implementation = "Pending cabinet and Palace agreement";
    Q.foreign_authority_last_outcome =
        "A coordination compact becomes a condition of opposition support";
} else if (role == "junior_no_mfa") {
    Q.us_alliance_reliability += 2;
    Q.us_defence_channel += 1;
    Q.government_coalition_dissent += 3;
    Q.foreign_authority_last_outcome =
        "Coalition council records Lewica's compact demand for other office-holders to execute";
} else if (role == "junior_mfa") {
    Q.us_alliance_reliability += 4;
    Q.us_defence_channel += 3;
    Q.president_relation += 2;
    Q.foreign_pressure -= 2;
    Q.foreign_ministry_override_risk += 3;
    Q.foreign_authority_last_outcome =
        "Foreign Affairs negotiates its part of a compact inside the prime minister's mandate";
} else if (role == "lead_no_mfa") {
    Q.us_alliance_reliability += 4;
    Q.us_defence_channel += 3;
    Q.president_relation += 2;
    Q.foreign_pressure -= 2;
    Q.foreign_portfolio_resistance += 3;
    Q.foreign_authority_last_outcome =
        "Cabinet sets the compact strategy while the coalition minister retains the diplomatic pen";
} else if (role == "lead_mfa") {
    Q.us_alliance_reliability += 5;
    Q.us_defence_channel += 4;
    Q.president_relation += 3;
    Q.public_trust += 3;
    Q.government_coalition_dissent += 2;
    Q.foreign_pressure -= 3;
    Q.foreign_policy_responsibility += 5;
    Q.foreign_authority_last_outcome =
        "The government negotiates its part of a cabinet–Palace compact and owns the result";
} else {
    Q.us_alliance_reliability += 1;
    Q.constitutional_restraint += 2;
    Q.foreign_authority_last_outcome =
        "The caretaker preserves existing channels without binding its successor";
}
Q.news_headline = Q.foreign_authority_last_outcome;
!}
go-to: poland_event_queue

