view-if: continuous_campaign = 1 and year = 2024 and month = 11 and us_election_2024_done = 0
on-arrival: {!
Q.us_election_2024_done = 1;
Q.us_2024_roll = this.random.uint32() / 4294967296;
Q.us_2024_republican_candidate =
    Q.us_election_2020_winner == "Donald Trump"
        ? "Republican successor"
        : "Donald Trump";
Q.us_2024_republican_vote = Math.round(
    (49.6 + (Q.us_2024_roll - 0.5) * 8) * 10
) / 10;
Q.us_2024_democratic_vote = Math.round(
    (100 - Q.us_2024_republican_vote) * 10
) / 10;
Q.us_2024_popular_margin = Math.round(
    (Q.us_2024_republican_vote - Q.us_2024_democratic_vote) * 10
) / 10;
Q.us_2024_battleground_roll =
    this.random.uint32() / 4294967296;
Q.us_2024_democratic_tipping_margin = Math.round(
    (
        -Q.us_2024_popular_margin -
        1.2 +
        (Q.us_2024_battleground_roll - 0.5) * 4
    ) * 10
) / 10;
const republicanWin = Q.us_2024_democratic_tipping_margin < 0;
let republicanElectors = Math.round(
    269.5 - Q.us_2024_democratic_tipping_margin * 16
);
republicanElectors = Math.max(120, Math.min(418, republicanElectors));
if (republicanWin) republicanElectors = Math.max(270, republicanElectors);
else republicanElectors = Math.min(269, republicanElectors);
Q.us_2024_republican_electors = republicanElectors;
Q.us_2024_democratic_electors = 538 - republicanElectors;
Q.us_2024_popular_electoral_split =
    republicanWin != (Q.us_2024_popular_margin >= 0) ? 1 : 0;
Q.us_election_2024_winner =
    republicanWin ? Q.us_2024_republican_candidate : "Kamala Harris";
Q.us_2024_electoral_signal =
    republicanWin
        ? (
            Q.us_2024_republican_electors + "–" +
            Q.us_2024_democratic_electors + " Republican"
        )
        : (
            Q.us_2024_democratic_electors + "–" +
            Q.us_2024_republican_electors + " Democratic"
        );
Q.us_president = Q.us_election_2024_winner;
Q.us_administration =
    republicanWin ? "America First" : "Democratic";
if (republicanWin) {
    const trumpReturn =
        Q.us_election_2024_winner == "Donald Trump";
    Q.us_alliance_reliability -= trumpReturn ? 10 : 6;
    Q.us_rule_of_law_pressure -= 5;
    Q.foreign_pressure += trumpReturn ? 12 : 8;
    Q.military_trust -= 3;
    Q.far_right_agenda += 5;
    Q.konf_poll_momentum += 0.3;
    Q.pis_relation += 3;
    Q.left_atlanticist_dissent += 5;
    Q.news_headline = trumpReturn
        ? "Trump's return makes American reliability a Polish coalition issue"
        : "A Republican successor preserves the America First turn";
} else {
    Q.us_alliance_reliability += 10;
    Q.us_rule_of_law_pressure += 7;
    Q.us_congress_channel += 4;
    Q.eu_institutional_trust += 4;
    Q.constitutional_restraint += 2;
    Q.ko_relation += 2;
    Q.left_atlanticist_dissent -= 3;
    Q.news_headline =
        "Harris's victory strengthens the institutional Atlantic channel";
}
!}

