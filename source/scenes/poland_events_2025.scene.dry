) {
    Q.razem_seats -= 1;
    Q.left_seats -= 1;
    movedSeat = 1;
}
Q.matysiak_resolution_done = 1;
Q.matysiak_advisor = 0;
Q.matysiak_has_sejm_mandate = movedSeat;
Q.razem_dissent = Math.max(0, (Number(Q.razem_dissent) || 0) - 3);
Q.razem_cohesion = Math.min(100, (Number(Q.razem_cohesion) || 0) + 4);
if (Q.matysiak_exit_choice == "Tak! Dla Rozwoju") {
    Q.tak_rozwoj_seats = (Number(Q.tak_rozwoj_seats) || 0) + movedSeat;
    Q.matysiak_status = "Leader of Tak! Dla Rozwoju";
    Q.matysiak_party = "tak_rozwoj";
    Q.matysiak_development_pressure += 8;
    Q.news_headline = "Matysiak leaves Razem with Tak! Dla Rozwoju";
} else {
    Q.other_seats = (Number(Q.other_seats) || 0) + movedSeat;
    Q.matysiak_status = "Independent MP after expulsion from Razem";
    Q.matysiak_party = "independent";
    Q.news_headline = "Razem expels Matysiak, who keeps an independent seat";
}
Q.razem_leadership_result = "Adrian Zandberg defeats Matysiak's challenge";
!}

