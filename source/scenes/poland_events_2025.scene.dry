@ko_merger_result_2025
title: The component ballots are counted
new-page: true
on-arrival: {!
const group = function(id) {
    return (Q.rival_group_records || []).find(function(record) {
        return record.id == id;
    });
};
const po = group("po");
const nowoczesna = group("nowoczesna");
const ipl = group("ipl");
const greens = group("greens");
const koParty = group("ko_party");
const splinter = group("ko_splinter");
const integration = Number(Q.ko_merger_integration) || 0;
const federalism = Number(Q.ko_merger_federalism) || 0;
const dissent = Number(Q.ko_merger_dissent) || 0;
const recruitment = Number(Q.ko_merger_recruitment) || 0;
Q.ko_consolidated = 0;
Q.ko_splinter_active = 0;
Q.ko_splinter_seats = 0;
Q.ko_individual_defectors = 0;
if (dissent >= 72) {
    const progressive = Q.ko_social_liberal_share >=
        Q.ko_classical_liberal_share;
    const availableKoSeats = Math.max(0, Number(Q.ko_seats) || 0);
    const defectors = availableKoSeats > 0
        ? Math.min(
            Math.max(3, Math.round(recruitment / 3)),
            availableKoSeats
        )
        : 0;
    Q.ko_splinter_active = 1;
    Q.ko_splinter_type = progressive ? "Progressive" : "Classical-liberal";
    Q.ko_splinter_seats = defectors;
    Q.ko_seats = Math.max(0, Q.ko_seats - defectors);
    Q.ko_merger_result = Q.ko_splinter_type + " splinter after failed talks";
    if (splinter) {
        splinter.active = 1;
        splinter.name = Q.ko_splinter_type + " KO splinter";
        splinter.legal_status = "independent organisation";
        splinter.organisation = 24 + Math.min(16, recruitment);
        splinter.cohesion = 58;
        splinter.mp_count = defectors;
        splinter.sejm_mps = defectors;
        splinter.exclusive_seats = defectors;
    }
} else if (integration >= 72 && dissent <= 55) {
    Q.ko_consolidated = 1;
    Q.ko_merger_result = "Historical full consolidation";
    if (po) {
        po.active = 0;
        po.legal_status = "renamed into Koalicja Obywatelska";
    }
    for (const component of [nowoczesna, ipl]) {
        if (component) {
            component.active = 0;
            component.legal_status = "dissolved; members join individually";
        }
    }
    if (koParty) {
        koParty.active = 1;
        koParty.legal_status = "registered party";
        koParty.organisation = 84;
        koParty.cohesion = Math.max(60, 84 - Math.round(dissent / 3));
        koParty.mp_count = Number(Q.ko_seats) || 0;
        koParty.sejm_mps = Number(Q.ko_seats) || 0;
    }
} else if (integration >= 58) {
    Q.ko_merger_result = "Partial merger; Nowoczesna survives";
    if (po) {
        po.active = 0;
        po.legal_status = "renamed into Koalicja Obywatelska";
    }
    if (ipl) {
        ipl.active = 0;
        ipl.legal_status = "dissolved into renamed PO";
    }
    if (nowoczesna) {
        nowoczesna.active = 1;
        nowoczesna.legal_status = "surviving allied party";
    }
    if (koParty) {
        koParty.active = 1;
        koParty.legal_status = "registered party after partial merger";
        koParty.organisation = 74;
        koParty.mp_count = Math.max(0, (Number(Q.ko_seats) || 0) - 8);
        koParty.sejm_mps = koParty.mp_count;
    }
} else if (federalism >= 52) {
    Q.ko_merger_result = "Federation of separate component parties";
    for (const component of [po, nowoczesna, ipl]) {
        if (component) {
            component.active = 1;
            component.legal_status = "federated component party";
        }
    }
    if (koParty) {
        koParty.active = 0;
        koParty.legal_status = "federal electoral alliance";
    }
} else if (recruitment >= 10) {
    Q.ko_individual_defectors = Math.min(
        8,
        Math.round(recruitment / 2),
        Math.max(0, Number(Q.ko_seats) || 0)
    );
    Q.ko_seats = Math.max(
        0,
        (Number(Q.ko_seats) || 0) - Q.ko_individual_defectors
    );
    Q.left_seats = Math.max(0, Number(Q.left_seats) || 0) +
        Q.ko_individual_defectors;
    Q.nowa_lewica_seats = Math.max(
        0,
        Number(Q.nowa_lewica_seats) || 0
    ) + Q.ko_individual_defectors;
    Q.ko_merger_result = "Components survive with individual defections";
    let remainingDefectors = Q.ko_individual_defectors;
    for (const component of [nowoczesna, ipl, po]) {
        if (component) {
            component.active = 1;
            component.legal_status = "surviving party after individual defections";
            const componentDepartures = Math.min(
                remainingDefectors,
                Math.max(0, Number(component.mp_count) || 0)
            );
            component.mp_count = Math.max(
                0,
                Number(component.mp_count) - componentDepartures
            );
            component.sejm_mps = Math.max(
                0,
                Number(component.sejm_mps) - componentDepartures
            );
            remainingDefectors -= componentDepartures;
        }
    }
} else {
    Q.ko_merger_result = "Consolidation rejected; components survive";
    for (const component of [po, nowoczesna, ipl]) {
        if (component) {
            component.active = 1;
            component.legal_status = "surviving allied party";
        }
    }
}
if (greens) {
    greens.active = 1;
    greens.allied = 1;
    greens.legal_status = "allied separate party";
}
Q.ko_merger_stage = 7;
Q.news_headline = "KO convention result: " + Q.ko_merger_result;
!}

= [+ ko_merger_result +]

The Greens remain a separate allied party. Component and splinter records stay
in the organisation ledger; no result appoints a leader for KO.

