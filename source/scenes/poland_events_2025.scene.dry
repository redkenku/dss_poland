    Math.min(
        Number(Q.sejm_total) || 460,
        (Number(Q.formation_2025_designation_support) || 0) -
            (Number(Q.formation_2025_left_yes) || 0)
    )
);
Q.snap_formation_left_votes =
    Number(Q.formation_2025_left_yes) || 0;
Q.snap_formation_left_abstentions =
    Number(Q.formation_2025_left_abstain) || 0;
Q.snap_formation_variance = 0;
Q.snap_formation_first_right = 0;
Q.confidence_mode =
    "Article 154(1)-(2) presidential cabinet — investiture pending";
Q.confidence_candidate = Q.formation_2025_candidate;
Q.news_headline =
    Q.formation_2025_candidate +
    " is designated and must now win Sejm confidence";
!}
