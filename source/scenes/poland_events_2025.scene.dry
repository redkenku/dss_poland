go-to: poland_event_queue

@left_leadership_2025
# prose-audit: Grade C — Keep the factual setup, but write distinct aftermaths before the queue and translate +/- forecasts into faction and public reactions.
title: New Left chooses its post-merger leadership
subtitle: Earlier removal and the current caucus map determine who can stand
new-page: true
tags: poland_event
priority: 24
order: 21
max-visits: 1
view-if: continuous_campaign = 1 and year = 2025 and month = 12
on-arrival: {!
Q.left_transition_nominee =
    Q.president_name == "Agnieszka Dziemianowicz-Bąk"
        ? "Krzysztof Gawkowski"
        : "Agnieszka Dziemianowicz-Bąk";
Q.news_headline =
    "The dual SLD–Wiosna leadership structure gives way to one chair";
!}

= December 2025 — Consolidation or renewal

[? if advisor_reshuffle_removed_czarzasty = 0 and barons_active = 1: The
post-merger congress can retain Czarzasty, set a date for succession, or open
the leadership to a membership vote.?]
[? if advisor_reshuffle_removed_czarzasty = 1 or barons_active = 0: Czarzasty
was removed from the party's leadership centre earlier. The congress therefore
chooses between a labour-progressive transition and an open primary; it does
not silently restore him.?]

- @leader_czarzasty
- @leader_transition
- @leader_primary

@leader_czarzasty
title: Consolidate behind Czarzasty through 2027
subtitle: Baron dissent −6 and strength +4; progressive and Wiosna dissent +4.
view-if: advisor_reshuffle_removed_czarzasty = 0 and barons_active = 1
on-arrival: left_leader = "Włodzimierz Czarzasty"; left_leadership_result = "Czarzasty elected sole chair through the 2027 election"; barons_strength += 4; barons_dissent -= 6; spring_dissent += 4; progressives_dissent += 4; party_unity += 1; news_headline = "The old organisational centre keeps control of New Left through the election cycle"
go-to: poland_event_queue

@leader_transition
title: Elect [+ left_transition_nominee +] as sole chair
subtitle: Labour and progressive strength +3; unity +3 and public trust +2.
on-arrival: {!
Q.left_leader = Q.left_transition_nominee;
Q.left_leadership_result =
    Q.left_transition_nominee + " elected in the generational handover";
Q.labor_strength += 3;
Q.progressives_strength += 3;
Q.barons_dissent += 4;
Q.party_unity += 3;
Q.public_trust += 2;
Q.news_headline = Q.left_transition_nominee +
    " wins the sole-chair vote";
!}
go-to: poland_event_queue

@leader_primary
title: Open the chair to a membership primary now
subtitle: Cost: 2 resources.
choose-if: resources >= 2
unavailable-subtitle: The party cannot administer a credible contest.
on-arrival: resources -= 2; party_unity -= 2; local_network += 2; news_headline = "The sole-leader congress becomes an open membership vote"
go-to: leader_primary_result

@leader_primary_result
title: The membership primary chooses one chair
new-page: true
on-arrival: {!
const leadershipCandidates = [
    {
        name: "Włodzimierz Czarzasty",
        key: "czarzasty",
        eligible: !Q.advisor_reshuffle_removed_czarzasty && Q.barons_active,
        score: (Number(Q.barons_strength) || 0) +
            (Number(Q.local_network) || 0) * 0.10 -
            (Number(Q.barons_dissent) || 0) * 0.15
    },
    {
        name: "Agnieszka Dziemianowicz-Bąk",
        key: "dziemianowicz",
        eligible: Q.labor_active,
        score: (Number(Q.labor_strength) || 0) +
            (Number(Q.labor_credibility) || 0) * 0.10 +
            (Number(Q.workers_support) || 0) * 0.05 -
            (Number(Q.labor_dissent) || 0) * 0.12
    },
    {
        name: "Krzysztof Gawkowski",
        key: "gawkowski",
        eligible: Q.progressives_active,
        score: (Number(Q.progressives_strength) || 0) +
            (Number(Q.progressive_credibility) || 0) * 0.08 +
            (Number(Q.media_capacity) || 0) * 0.05 -
            (Number(Q.progressives_dissent) || 0) * 0.12
    }
].filter(function(candidate) {
    return candidate.eligible && candidate.name != Q.president_name;
});
if (!leadershipCandidates.length) {
    leadershipCandidates.push({
        name: "Krzysztof Gawkowski", key: "gawkowski", score: 0
    });
}
leadershipCandidates.sort(function(a, b) {
    if (b.score != a.score) return b.score - a.score;
    return a.name < b.name ? -1 : 1;
});
const winner = leadershipCandidates[0];
Q.left_primary_czarzasty_score = Math.round(
    (leadershipCandidates.find(function(candidate) {
        return candidate.key == "czarzasty";
    }) || {score: 0}).score * 10
) / 10;
Q.left_primary_dziemianowicz_score = Math.round(
    (leadershipCandidates.find(function(candidate) {
        return candidate.key == "dziemianowicz";
    }) || {score: 0}).score * 10
) / 10;
Q.left_primary_gawkowski_score = Math.round(
    (leadershipCandidates.find(function(candidate) {
        return candidate.key == "gawkowski";
    }) || {score: 0}).score * 10
) / 10;
Q.left_primary_winner = winner.name;
Q.left_leader = winner.name;
Q.left_leadership_result = winner.name + " won the membership primary";
if (winner.key == "czarzasty") {
    Q.barons_strength += 2;
    Q.progressives_dissent += 2;
} else if (winner.key == "dziemianowicz") {
    Q.labor_strength += 4;
    Q.workers_support += 2;
} else {
    Q.progressives_strength += 4;
    Q.media_capacity += 2;
}
Q.news_headline = winner.name + " wins the New Left membership primary";
!}

**Membership score:** Czarzasty **[+ left_primary_czarzasty_score +]** ·
Dziemianowicz-Bąk **[+ left_primary_dziemianowicz_score +]** · Gawkowski
**[+ left_primary_gawkowski_score +]**.

President: **[+ president_name +]**. A sitting President was not eligible for
the party chair.

Winner: **[+ left_primary_winner +]**.

- @leader_primary_finish

@leader_primary_finish
title: Record the sole chair
go-to: poland_event_queue
