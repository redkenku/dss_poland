@presidential_first_round_2025
title: Presidential election — first round
subtitle: The two Left strategies receive separate verdicts
new-page: true
tags: poland_event
priority: 45
order: 1
max-visits: 1
view-if: continuous_campaign = 1 and year = 2025 and month = 5 and pres_2025_round_one_done = 0
on-arrival: {!
const finitePres25 = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const clampPres25 = function(value, low, high) {
    return Math.max(low, Math.min(high, value));
};
const noise = function(scale) {
    return (
        (this.random.uint32() / 4294967296) * 2 - 1
    ) * scale;
}.bind(this);
const leftIntent = finitePres25(Q.left_vote_intent, 8.61);
const koIntent = finitePres25(Q.ko_vote_intent, 30.70);
const pisIntent = finitePres25(Q.pis_vote_intent, 35.38);
const konfIntent = finitePres25(Q.konf_vote_intent, 7.16);
const campaign = finitePres25(Q.pres_2025_campaign_strength, 0);
const debate = finitePres25(Q.pres_2025_debate_shift, 0);
let governmentLeftBase;
let razemLeftBase;
if (Q.pres_2025_united_left) {
    // A common ticket is a new electorate, not Biejat plus Zandberg. The
    // nomination route can create public legitimacy or strand coerced voters.
    governmentLeftBase =
        7.70 +
        (leftIntent - 8.61) * 0.55 +
        campaign * 0.20 +
        debate * 0.65 +
        clampPres25(finitePres25(Q.pres_2025_unity_effect, 0), -1.5, 1.5);
    razemLeftBase = 0;
} else {
    governmentLeftBase =
        4.23 +
        (leftIntent - 8.61) * 0.28 +
        campaign * 0.20 +
        debate * 0.55;
    razemLeftBase =
        4.86 +
        (leftIntent - 8.61) * 0.30 +
        (finitePres25(Q.razem_strength, 20) - 20) * 0.06;
}
governmentLeftBase = Math.max(0.4, governmentLeftBase);
razemLeftBase = Math.max(0, razemLeftBase);
const governmentLeft = Math.max(
    0.4,
    governmentLeftBase + noise(Q.pres_2025_united_left ? 1.4 : 1.0)
);
const razemLeft = Math.max(
    0,
    razemLeftBase + (Q.pres_2025_united_left ? 0 : noise(0.9))
);
let koBase =
    31.36 +
    (koIntent - 30.70) * 0.34 +
    (finitePres25(Q.ko_relation, 50) - 50) * 0.025 -
    Math.max(0, governmentLeftBase + razemLeftBase - 10) * 0.18;
if (Q.pres_2025_incumbent) {
    Q.pres_2025_incumbent_record =
        1.2 +
        (finitePres25(Q.public_trust, 43) - 43) * 0.035 +
        finitePres25(Q.trz_vetoes, 0) * 0.10 +
        (
            finitePres25(Q.pis_cohabitation_stress, 0) -
            finitePres25(Q.pis_cohabitation_rally, 0)
        ) * 0.022 +
        (Q.trz_rights_bill_outcome == "Passed and signed" ? 1.0 : 0);
    koBase += Q.pres_2025_incumbent_record;
}
const ko =
    koBase -
    (
        Math.max(0, governmentLeft + razemLeft - 10) -
        Math.max(0, governmentLeftBase + razemLeftBase - 10)
    ) * 0.18 +
    noise(1.4);
const rightBase =
    29.54 +
    (pisIntent - 35.38) * 0.25 +
    (finitePres25(Q.far_right_agenda, 32) - 32) * 0.018;
const mentzenBase =
    14.81 +
    (konfIntent - 7.16) * 0.35 +
    (finitePres25(Q.konf_mentzenite_share, 47) - 47) * 0.025;
const braunBase =
    6.34 +
    finitePres25(Q.braun_martyrdom, 0) * 0.06 +
    (finitePres25(Q.konf_braunist_share, 18) - 18) * 0.025;
const holowniaBase =
    4.99 +
    (finitePres25(Q.p2050_vote_intent, 4.0) - 4.0) * 0.25;
const stanowskiBase =
    1.24 +
    (finitePres25(Q.kanal_zero_capacity, 12) - 12) * 0.025;
const right = rightBase + noise(1.4);
const mentzen = mentzenBase + noise(1.2);
const braun = braunBase + noise(0.8);
const holownia = holowniaBase + noise(0.7);
const stanowski = stanowskiBase + noise(0.35);
const other = 2.63;
const expectedRaw = {
    ko: Math.max(0.5, koBase),
    right: Math.max(0.5, rightBase),
    left: governmentLeftBase,
    razem: razemLeftBase,
    mentzen: Math.max(0.3, mentzenBase),
    braun: Math.max(0.2, braunBase),
    holownia: Math.max(0.2, holowniaBase),
    stanowski: Math.max(0.1, stanowskiBase),
    other: other
};
const expectedTotal = Object.keys(expectedRaw).reduce(function(sum, key) {
    return sum + expectedRaw[key];
}, 0);
Q.pres_2025_candidate_expectation = Math.round(
    expectedRaw.left * 10000 / expectedTotal
) / 100;
Q.pres_2025_field_expectation = Math.round(
    (expectedRaw.left + expectedRaw.razem) * 10000 / expectedTotal
) / 100;
const raw = {
    ko: Math.max(0.5, ko),
    right: Math.max(0.5, right),
    left: governmentLeft,
    razem: razemLeft,
    mentzen: Math.max(0.3, mentzen),
    braun: Math.max(0.2, braun),
    holownia: Math.max(0.2, holownia),
    stanowski: Math.max(0.1, stanowski),
    other: other
};
const total = Object.keys(raw).reduce(function(sum, key) {
    return sum + raw[key];
}, 0);
for (const key of Object.keys(raw)) {
    raw[key] = raw[key] * 100 / total;
    Q["pres_2025_r1_" + key] =
        Math.round(raw[key] * 100) / 100;
}
const candidateNames = {
    ko: Q.pres_2025_ko_candidate || "Rafał Trzaskowski",
    right: "Karol Nawrocki",
    left: Q.pres_2025_left_candidate,
    razem: Q.pres_2025_razem_candidate || "Adrian Zandberg",
    mentzen: "Sławomir Mentzen",
    braun: "Grzegorz Braun",
    holownia: "Szymon Hołownia",
    stanowski: "Krzysztof Stanowski",
    other: "Other candidates"
};
const ranked = Object.keys(raw)
    .filter(function(key) {
        // "Other candidates" is a reporting aggregate, not one candidacy.
        // It contributes to the 100% denominator but can never be a finalist.
        return key != "other" && raw[key] > 0;
    })
    .sort(function(a, b) {
        return raw[b] - raw[a];
    });
Q.pres_2025_finalist_a_key = ranked[0];
Q.pres_2025_finalist_b_key = ranked[1];
Q.pres_2025_finalist_a = candidateNames[ranked[0]];
Q.pres_2025_finalist_b = candidateNames[ranked[1]];
Q.pres_2025_player_result = Math.round(raw.left * 100) / 100;
Q.pres_2025_field_result =
    Math.round((raw.left + raw.razem) * 100) / 100;
Q.pres_2025_left_result = Q.pres_2025_field_result;
Q.pres_2025_ko_result = Q.pres_2025_r1_ko;
Q.pres_2025_right_result = Q.pres_2025_r1_right;
Q.pres_2025_radical_result =
    Math.round((raw.mentzen + raw.braun) * 100) / 100;
Q.pres_2025_left_finalist =
    ranked[0] == "left" || ranked[1] == "left" ||
    ranked[0] == "razem" || ranked[1] == "razem" ? 1 : 0;
Q.pres_2025_player_finalist =
    ranked[0] == "left" || ranked[1] == "left" ? 1 : 0;
Q.pres_2025_candidate_historical =
    Q.pres_2025_left_candidate == "Magdalena Biejat" ? 4.23 :
    (Q.pres_2025_left_candidate == "Adrian Zandberg" ? 4.86 : 0);
Q.pres_2025_historical_field = 9.09;
Q.pres_2025_candidate_expectation_gap = Math.round(
    (Q.pres_2025_player_result - Q.pres_2025_candidate_expectation) * 100
) / 100;
Q.pres_2025_field_expectation_gap = Math.round(
    (Q.pres_2025_field_result - Q.pres_2025_field_expectation) * 100
) / 100;
Q.pres_2025_candidate_historical_gap = Math.round(
    (Q.pres_2025_player_result - Q.pres_2025_candidate_historical) * 100
) / 100;
Q.pres_2025_field_historical_gap = Math.round(
    (Q.pres_2025_field_result - Q.pres_2025_historical_field) * 100
) / 100;
const performanceVerdict25 = function(result, transformed) {
    if (transformed) {
        return {label: "Party-system transformation", level: 4};
    }
    if (result < 2.5) {
        return {label: "Shattering disaster", level: -3};
    }
    if (result < 4) {
        return {label: "Severe defeat", level: -2};
    }
    if (result < 5.5) {
        return {label: "Disappointing or ambiguous", level: -1};
    }
    if (result < 7.5) {
        return {label: "Base held; broadly satisfying", level: 1};
    }
    if (result < 10) {
        return {label: "Strong result", level: 2};
    }
    return {label: "Breakthrough", level: 3};
};
const candidateVerdict = performanceVerdict25(
    Q.pres_2025_player_result,
    Q.pres_2025_player_finalist
);
const fieldVerdict = performanceVerdict25(
    Q.pres_2025_field_result,
    Q.pres_2025_left_finalist
);
Q.pres_2025_candidate_band = candidateVerdict.label;
Q.pres_2025_candidate_level = candidateVerdict.level;
Q.pres_2025_field_band = fieldVerdict.label;
Q.pres_2025_field_level = fieldVerdict.level;
Q.pres_2025_leadership_defeat =
    !Q.pres_2025_united_left &&
    Q.pres_2025_left_candidate == "Magdalena Biejat" &&
    Q.pres_2025_razem_candidate == "Adrian Zandberg" &&
    raw.left < raw.razem ? 1 : 0;
Q.pres_2025_zandberg_claim = Q.pres_2025_leadership_defeat;
if (!Q.pres_2025_feedback_applied) {
    const candidateLevel = Number(Q.pres_2025_candidate_level) || 0;
    const fieldLevel = Number(Q.pres_2025_field_level) || 0;
    let combinedLevel = candidateLevel * 0.72 + fieldLevel * 0.28;
    if (Q.pres_2025_leadership_defeat) {
        combinedLevel -= 1.4;
    }
    let consideration = combinedLevel * 1.45;
    let feedbackTurnout = combinedLevel * 1.10;
    const expectationAdjustment = clampPres25(
        (Number(Q.pres_2025_candidate_expectation_gap) || 0) * 0.18 +
            (Number(Q.pres_2025_field_expectation_gap) || 0) * 0.08,
        -1.2,
        1.2
    );
    consideration += expectationAdjustment;
    feedbackTurnout += expectationAdjustment * 0.70;
    if (candidateLevel == -3) {
        // A two-percent candidate result remains a disaster even when another
        // Left candidacy keeps the combined field respectable.
        consideration = Math.min(-6, consideration);
        feedbackTurnout = Math.min(-5, feedbackTurnout);
    } else if (candidateLevel == 1) {
        consideration = Math.max(0.5, consideration);
        feedbackTurnout = Math.max(0.6, feedbackTurnout);
    }
    const previousFailure = Q.pres_feedback_active &&
        (Number(Q.pres_feedback_direction) || 0) < 0 && consideration < 0;
    let duration = candidateLevel == -3 || candidateLevel >= 3 ? 12 :
        (Math.abs(combinedLevel) >= 1.5 ? 10 : 8);
    if (Q.pres_2025_leadership_defeat) {
        duration = Math.max(duration, 10);
    }
    if (previousFailure) {
        duration = Math.min(12, duration + 2);
        consideration *= 1.15;
        feedbackTurnout *= 1.15;
        Q.pres_feedback_reinforcements =
            (Number(Q.pres_feedback_reinforcements) || 0) + 1;
    }
    Q.pres_feedback_active = 1;
    Q.pres_feedback_source = "2025 presidential verdict";
    Q.pres_feedback_direction = consideration < 0 ? -1 : 1;
    Q.pres_feedback_duration = duration;
    Q.pres_feedback_months_remaining = duration;
    Q.pres_feedback_decay_factor = 1;
    Q.pres_feedback_consideration =
        Math.round(consideration * 100) / 100;
    Q.pres_feedback_turnout =
        Math.round(feedbackTurnout * 100) / 100;
    Q.pres_feedback_consideration_current =
        Q.pres_feedback_consideration;
    Q.pres_feedback_turnout_current = Q.pres_feedback_turnout;
    Q.pres_feedback_leadership_pressure = 0;
    Q.pres_feedback_leadership_challenge = 0;
    Q.pres_feedback_donor_loss = 0;
    Q.pres_feedback_activist_loss = 0;
    Q.pres_feedback_media_loss = 0;
    Q.pres_feedback_faction_pressure = 0;
    Q.pres_feedback_tactical_flight = 0;
    Q.pres_feedback_base_certainty = 0;
    Q.pres_feedback_squeeze_protection = 0;
    if (candidateLevel == -3) {
        Q.pres_feedback_leadership_pressure = 88;
        Q.pres_feedback_leadership_challenge = 1;
        Q.pres_feedback_donor_loss = 2;
        Q.pres_feedback_activist_loss = 6;
        Q.pres_feedback_media_loss = 4;
        Q.pres_feedback_faction_pressure = 8;
        Q.pres_feedback_tactical_flight = 6;
        Q.resources -= 2;
        Q.organiser_energy -= 6;
        Q.media_capacity -= 4;
        Q.media_access -= 5;
        Q.leadership_authority -= 10;
        Q.list_confidence -= 8;
        Q.winner_reputation -= 8;
        Q.electoral_viability -= 5;
        Q.party_unity -= 8;
        Q.barons_dissent += 8;
        Q.spring_dissent += 8;
        Q.labor_dissent += 6;
        Q.progressives_dissent += 8;
        Q.razem_dissent += 6;
    } else if (Q.pres_2025_leadership_defeat) {
        Q.pres_feedback_leadership_pressure = 75;
        Q.pres_feedback_leadership_challenge = 1;
        Q.pres_feedback_donor_loss = 1;
        Q.pres_feedback_activist_loss = 3;
        Q.pres_feedback_media_loss = 2;
        Q.pres_feedback_faction_pressure = 7;
        Q.pres_feedback_tactical_flight = 3;
        Q.resources -= 1;
        Q.organiser_energy -= 3;
        Q.media_capacity -= 2;
        Q.media_access -= 2;
        Q.leadership_authority -= 9;
        Q.list_confidence -= 5;
        Q.winner_reputation -= 5;
        Q.electoral_viability += fieldLevel >= 2 ? 1 : -2;
        Q.party_unity -= 6;
        Q.barons_dissent += 5;
        Q.spring_dissent += 5;
        Q.labor_dissent += 4;
        Q.progressives_dissent += 4;
        Q.razem_dissent -= 3;
        Q.razem_cooperation -= 6;
    } else if (candidateLevel == -2) {
        Q.pres_feedback_leadership_pressure = 60;
        Q.pres_feedback_leadership_challenge = 1;
        Q.pres_feedback_donor_loss = 1;
        Q.pres_feedback_activist_loss = 4;
        Q.pres_feedback_media_loss = 3;
        Q.pres_feedback_faction_pressure = 5;
        Q.pres_feedback_tactical_flight = 4;
        Q.resources -= 1;
        Q.organiser_energy -= 4;
        Q.media_capacity -= 3;
        Q.media_access -= 3;
        Q.leadership_authority -= 6;
        Q.list_confidence -= 5;
        Q.winner_reputation -= 4;
        Q.electoral_viability -= 3;
        Q.party_unity -= 5;
        Q.barons_dissent += 4;
        Q.spring_dissent += 5;
        Q.progressives_dissent += 5;
    } else if (candidateLevel == -1) {
        Q.pres_feedback_leadership_pressure = 28;
        Q.pres_feedback_activist_loss = 1;
        Q.pres_feedback_media_loss = 1;
        Q.pres_feedback_faction_pressure = 2;
        Q.pres_feedback_tactical_flight = 1;
        Q.organiser_energy -= 1;
        Q.media_capacity -= 1;
        Q.media_access -= 1;
        Q.leadership_authority -= 2;
        Q.list_confidence -= 2;
        Q.winner_reputation -= 1;
        Q.party_unity -= 2;
        Q.spring_dissent += 2;
        Q.progressives_dissent += 2;
    } else {
        Q.pres_feedback_base_certainty = candidateLevel == 1 ? 65 :
            (candidateLevel == 2 ? 78 : 92);
        Q.pres_feedback_squeeze_protection = 1;
        Q.party_unity += candidateLevel == 1 ? 3 :
            (candidateLevel == 2 ? 4 : 6);
        Q.organiser_energy += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 3 : 5);
        Q.media_capacity += candidateLevel == 1 ? 1 :
            (candidateLevel == 2 ? 2 : 4);
        Q.media_access += candidateLevel == 1 ? 1 :
            (candidateLevel == 2 ? 2 : 4);
        Q.leadership_authority += candidateLevel == 1 ? 3 :
            (candidateLevel == 2 ? 4 : 6);
        Q.list_confidence += candidateLevel == 1 ? 5 :
            (candidateLevel == 2 ? 6 : 8);
        Q.winner_reputation += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 4 : 6);
        Q.electoral_viability += candidateLevel == 1 ? 2 :
            (candidateLevel == 2 ? 3 : 5);
        Q.tactical_desertion_to_ko = Math.max(
            0,
            Q.tactical_desertion_to_ko - (candidateLevel == 1 ? 2 : 4)
        );
        Q.tactical_desertion_to_abstention = Math.max(
            0,
            Q.tactical_desertion_to_abstention -
                (candidateLevel == 1 ? 1 : 3)
        );
        Q.barons_dissent -= candidateLevel == 1 ? 1 : 2;
        Q.spring_dissent -= candidateLevel == 1 ? 1 : 2;
        Q.progressives_dissent -= candidateLevel == 1 ? 1 : 2;
    }
    Q.pres_feedback_tactical_current =
        Q.pres_feedback_tactical_flight;
    if (Q.pres_2025_zandberg_claim) {
        Q.razem_strength += 2;
    }
    Q.pres_2025_feedback_applied = 1;
}
Q.pres_2025_round_one_done = 1;
Q.news_headline =
    Q.pres_2025_finalist_a + " and " +
    Q.pres_2025_finalist_b + " reach the runoff";
!}

= 18 May 2025 — First-round result

<div class="election-table">
<div class="election-table-head"><span>Candidate</span><span>Camp</span><span>Vote</span><span>Status</span></div>
<div class="election-table-row"><span>[+ pres_2025_ko_candidate +]</span><span class="party party-ko">KO</span><b>[+ pres_2025_r1_ko +]%</b><span>[? if pres_2025_finalist_a_key = "ko" or pres_2025_finalist_b_key = "ko": runoff?]</span></div>
<div class="election-table-row"><span>Karol Nawrocki</span><span class="party party-pis">PiS-backed</span><b>[+ pres_2025_r1_right +]%</b><span>[? if pres_2025_finalist_a_key = "right" or pres_2025_finalist_b_key = "right": runoff?]</span></div>
<div class="election-table-row"><span>[+ pres_2025_left_candidate +]</span><span class="party party-lewica">Lewica</span><b>[+ pres_2025_r1_left +]%</b><span>[? if pres_2025_finalist_a_key = "left" or pres_2025_finalist_b_key = "left": runoff?]</span></div>
