@debate_close
title: Debate III — last-minute movement
new-page: true
on-arrival: {!
const candidateBonus =
    Q.pres_2025_left_candidate == "Adrian Zandberg" ? 3 : 0;
const noise =
    (this.random.uint32() / 4294967296) * 4 - 2;
Q.pres_2025_debate_score += candidateBonus;
Q.pres_2025_debate_shift =
    Math.round(
        (
            (Number(Q.pres_2025_debate_score) || 0) * 0.12 +
            noise
        ) * 10
    ) / 10;
Q.pres_2025_campaign_strength +=
    Math.max(-1, Q.pres_2025_debate_shift);
Q.news_headline =
    Q.pres_2025_left_candidate + " moves " +
    Q.pres_2025_debate_shift + " points in the final debate model";
!}

