    78 - Math.max(0, koInternalDissent - 30) * 0.35 +
    koConventionRoll + strongLeftPressure * 0.35 +
    socialConsolidationMood * 0.30
);
Q.ko_merger_federalism = Math.round(
    32 + koInternalDissent * 0.20 - koConventionRoll * 0.20
);
