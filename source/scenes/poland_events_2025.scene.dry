title: The presidential year

@left_presidential_split
title: Zandberg enters the presidential race
subtitle: Government left and opposition left face the voters separately
new-page: true
tags: poland_event
priority: 25
order: 10
max-visits: 1
view-if: continuous_campaign = 1 and year = 2025 and month = 1
on-arrival: {!
if (!Q.pres_2025_left_candidate ||
    Q.pres_2025_left_candidate == "Undecided") {
    Q.pres_2025_left_candidate = "Magdalena Biejat";
}
if (!Q.pres_2025_candidate ||
    Q.pres_2025_candidate == "Undecided") {
    Q.pres_2025_candidate = Q.pres_2025_left_candidate;
}
if (!Q.pres_2025_united_left) {
    Q.pres_2025_razem_candidate = "Adrian Zandberg";
}
Q.news_headline =
    Q.pres_2025_united_left
        ? "A common Left candidate opens the presidential year"
        : "Biejat and Zandberg prepare to measure two Left strategies";
!}

= January 2025 — Government record or opposition programme

[? if pres_2025_united_left: **[+ pres_2025_left_candidate +]** carries a
common mandate. The difficult question is who controls the campaign and the
programme behind it.?]
[? if not pres_2025_united_left: **[+ pres_2025_left_candidate +]** runs for
the governing left while **Adrian Zandberg** runs for Razem. Their combined
electorate may grow even as each campaign attacks the other's strategy.?]

- @left_campaign_shared
- @left_campaign_compete
- @left_campaign_last_offer

@left_campaign_shared
title: Build one shared field operation even if there are two candidates
subtitle: Cost: 2 resources. Preserves transfer channels without hiding disagreement.
choose-if: resources >= 2
unavailable-subtitle: The party cannot finance shared organisers.
on-arrival: resources -= 2; pres_2025_campaign_strength += 4; razem_cooperation += 5; local_network += 3; party_unity += 2; news_headline = "Two Left campaigns share organisers and anti-right mobilisation"
go-to: poland_event_queue

@left_campaign_compete
title: Let government delivery compete openly with Razem's opposition
subtitle: Campaign strength and media +2; Razem cooperation −5 and unity −2.
on-arrival: pres_2025_campaign_strength += 2; media_capacity += 2; razem_cooperation -= 5; razem_dissent += 3; party_unity -= 2; news_headline = "The presidential campaign becomes a referendum on Left strategy"
go-to: poland_event_queue

@left_campaign_last_offer
