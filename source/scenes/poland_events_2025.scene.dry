@formation_investiture_2025
title: The July investiture roll call
new-page: true
on-arrival: {!
const total = Math.max(1, Number(Q.sejm_total) || 460);
const quorum = Math.max(
    1,
    Math.min(total, Number(Q.sejm_quorum_floor) || 230)
);
const leftPool = Math.max(
    0,
    Math.min(
        total,
        Number(Q.formation_2025_left_pool) || 0
    )
);
const rawCore =
    Math.max(0, Number(Q.ko_seats) || 0) +
    (Q.formation_2025_p2050_committed
        ? Math.max(0, Number(Q.p2050_seats) || 0)
        : 0) +
    (Q.formation_2025_centrum_committed
        ? Math.max(0, Number(Q.centrum_seats) || 0)
        : 0) +
    (Q.formation_2025_psl_committed
        ? Math.max(0, Number(Q.psl_seats) || 0)
        : 0);
const corePool = Math.max(
    0,
    Math.min(total - leftPool, Math.round(rawCore))
);
const relationLoss =
    (Q.ko_relation < 30 ? 3 : 0) +
    (Q.formation_2025_psl_committed && Q.psl_relation < 45 ? 4 : 0) +
    (Q.formation_2025_p2050_committed && Q.p2050_relation < 45 ? 3 : 0);
const dissentLoss = Math.max(
    0,
    Math.round(
        ((Number(Q.government_coalition_dissent) || 0) - 28) / 8
    )
);
Q.formation_2025_variance =
    Math.floor((this.random.uint32() / 4294967296) * 7) - 3;
Q.formation_2025_core_loss = Math.max(
    0,
    Math.min(
        corePool,
        relationLoss + dissentLoss - Q.formation_2025_variance
    )
);
Q.formation_2025_absent =
    4 + Math.floor((this.random.uint32() / 4294967296) * 9);
const coreAbsent = Math.min(
    Math.max(0, corePool - Q.formation_2025_core_loss),
    Math.round(Q.formation_2025_absent * corePool / total)
);
const coreYes = Math.max(
    0,
    corePool - Q.formation_2025_core_loss - coreAbsent
);
const coreDissentNo = Math.ceil(
    Q.formation_2025_core_loss * 0.45
);
const coreDissentAbstain =
    Q.formation_2025_core_loss - coreDissentNo;
const leftYes = Math.max(
    0,
    Math.min(
        leftPool,
        Number(Q.formation_2025_left_yes) || 0
    )
);
const leftNo = Math.max(
    0,
    Math.min(
        leftPool - leftYes,
        Number(Q.formation_2025_left_no) || 0
    )
);
const leftAbstain = Math.max(
    0,
    Math.min(
        leftPool - leftYes - leftNo,
        Number(Q.formation_2025_left_abstain) || 0
    )
);
const leftAbsent = Math.max(
    0,
    leftPool - leftYes - leftNo - leftAbstain
);
const otherPool = Math.max(
    0,
    total - corePool - leftPool
);
const otherAbsent = Math.min(
    otherPool,
    Math.max(
        0,
        Q.formation_2025_absent - coreAbsent - leftAbsent
    )
);
const otherPresent = Math.max(0, otherPool - otherAbsent);
const otherAbstain = Math.min(
    otherPresent,
    Math.max(0, Math.round(otherPresent * 0.05))
);
const otherNo = Math.max(0, otherPresent - otherAbstain);
Q.formation_2025_core_pool = corePool;
Q.formation_2025_core_yes = coreYes;
Q.confidence_mode =
    "Article 154(2) cabinet investiture — absolute majority";
Q.confidence_candidate =
    Q.formation_2025_candidate + " cabinet";
Q.confidence_yes = coreYes + leftYes;
Q.confidence_no =
    coreDissentNo + leftNo + otherNo;
Q.confidence_abstain =
    coreDissentAbstain + leftAbstain + otherAbstain;
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.formation_2025_absent = Math.max(
    0,
    total - Q.confidence_present
);
Q.confidence_threshold =
    Math.floor(Q.confidence_present / 2) + 1;
Q.formation_2025_passed =
    Q.confidence_present >= quorum &&
    Q.confidence_yes >= Q.confidence_threshold ? 1 : 0;
Q.news_headline = Q.formation_2025_passed
    ? Q.formation_2025_candidate +
        " wins a recorded cabinet investiture"
    : Q.formation_2025_candidate +
        " fails investiture and the caretaker remains";
!}

= A nominee meets the Sejm

**[+ confidence_yes +] yes · [+ confidence_no +] no · [+
confidence_abstain +] abstain · [+ formation_2025_absent +] absent**

The designated cabinet starts from **[+ formation_2025_core_pool +] partner
seats** and loses **[+ formation_2025_core_loss +]** through relations and
coalition dissent. The roll-call variance is **[+ formation_2025_variance
+]**. With **[+ confidence_present +] present**, an absolute majority requires
**[+ confidence_threshold +] yes**.

[? if formation_2025_passed: The cabinet has cleared investiture. Its office
and spending authority can now change.?]
[? if not formation_2025_passed: Designation alone has installed nobody. The
outgoing cabinet remains caretaker while later constitutional attempts and
early-election pressure continue.?]

- @formation_record_2025: Record the constitutional result

@formation_record_2025
go-to: formation_success_2025 if formation_2025_passed = 1; formation_failure_2025 if formation_2025_passed = 0

@formation_success_2025
title: The successor cabinet takes office
new-page: true
on-arrival: {!
Q.government_has_confidence = 1;
Q.caretaker_government = 0;
Q.coalition_broken = 0;
Q.formation_in_progress = 0;
Q.snap_formation_attempt = 1;
Q.snap_formation_context =
    "July 2025 first-attempt cabinet formed";
Q.government_party = "ko";
Q.government_owner = "KO-led democratic coalition";
Q.prime_minister = Q.formation_2025_candidate;
Q.government_name =
    Q.formation_2025_candidate + " democratic cabinet";
Q.razem_in_government = 0;
const successorCabinet = {
    labor: ["KO", "Coalition social-policy nominee"],
    equality: ["KO", "Coalition equality nominee"],
    housing: ["KO", "Coalition housing nominee"],
    health: ["KO", "Izabela Leszczyna"],
    digital: Q.formation_2025_p2050_committed
        ? ["Poland 2050", "Coalition digital nominee"]
        : ["KO", "Coalition digital nominee"],
    science: ["KO", "Coalition science nominee"],
    interior: ["KO", "Marcin Kierwiński"],
    finance: ["KO", "Andrzej Domański"],
    economy: Q.formation_2025_psl_committed
        ? ["PSL", "Krzysztof Hetman"]
        : ["KO", "Coalition development nominee"],
    justice: ["KO", "Adam Bodnar"],
    foreign: ["KO", "Radosław Sikorski"],
    agriculture: Q.formation_2025_psl_committed
        ? ["PSL", "Czesław Siekierski"]
        : ["KO", "Coalition agriculture nominee"],
    defence: Q.formation_2025_psl_committed
        ? ["PSL", "Władysław Kosiniak-Kamysz"]
        : ["KO", "Coalition defence nominee"]
};
if (Q.formation_2025_left_cabinet) {
    successorCabinet.labor = [
        "Lewica", "Agnieszka Dziemianowicz-Bąk"
    ];
    successorCabinet.digital = ["Lewica", "Krzysztof Gawkowski"];
}
for (const portfolio of Object.keys(successorCabinet)) {
    Q[portfolio + "_minister_party"] = successorCabinet[portfolio][0];
    Q[portfolio + "_minister"] = successorCabinet[portfolio][1];
}
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;
Q.cabinet_roster_government_party = "ko";
Q.ministry_ko_in_cabinet = 1;
Q.ministry_psl_in_cabinet = Q.formation_2025_psl_committed;
Q.ministry_p2050_in_cabinet = Q.formation_2025_p2050_committed;
Q.ministry_left_cabinet_seats = Q.formation_2025_left_cabinet
    ? Math.max(0, Number(Q.nowa_lewica_seats) || 0)
    : 0;
if (Q.formation_2025_left_cabinet) {
    Q.left_in_government = 1;
    Q.left_cabinet_committed = 1;
    Q.left_cabinet_model =
        "New Left ministers · Razem external support";
    Q.position = "Coalition government";
    Q.coalition_status = "Rebuilt democratic coalition";
    Q.coalition_seats = Math.min(
        Number(Q.sejm_total) || 460,
        Math.max(0, Number(Q.ko_seats) || 0) +
            (Q.formation_2025_p2050_committed
                ? Math.max(0, Number(Q.p2050_seats) || 0)
                : 0) +
            (Q.formation_2025_psl_committed
                ? Math.max(0, Number(Q.psl_seats) || 0)
                : 0) +
            Q.ministry_left_cabinet_seats
    );
    Q.budget = Math.max(2, Number(Q.budget) || 0);
    Q.budget_authority =
        "Governing coalition — negotiated fiscal capacity";
    Q.ministries_finalized = 0;
    Q.ministry_allocation_mode = "formation";
    Q.ministry_return_mode = "event_queue";
} else {
    Q.left_in_government = 0;
    Q.left_cabinet_committed = 0;
    Q.left_cabinet_model =
        Q.formation_2025_mode == "Confidence and supply"
            ? "Confidence and supply from opposition"
            : "Opposition to a replacement cabinet";
    Q.budget = 0;
    Q.budget_authority =
        "Opposition — no state spending authority";
    Q.coalition_seats = Math.min(
        Number(Q.sejm_total) || 460,
        Math.max(0, Number(Q.ko_seats) || 0) +
            (Q.formation_2025_p2050_committed
                ? Math.max(0, Number(Q.p2050_seats) || 0)
                : 0) +
            (Q.formation_2025_psl_committed
                ? Math.max(0, Number(Q.psl_seats) || 0)
                : 0)
    );
    if (Q.formation_2025_mode == "Confidence and supply") {
        Q.position = "Confidence-and-supply opposition";
        Q.coalition_status = "Minority democratic cabinet";
    } else {
        Q.position =
            "Opposition to a replacement democratic cabinet";
        Q.coalition_status =
            "Replacement democratic coalition";
    }
}
Q.government_support_seats = Math.max(
    0,
    Number(Q.formation_2025_core_yes) || 0
);
Q.news_headline =
    Q.formation_2025_candidate +
    " takes office only after winning the recorded investiture";
!}

