@confidence_2025_roll
title: The June confidence roll call
new-page: true
on-arrival: {!
const total = Math.max(1, Number(Q.sejm_total) || 460);
const quorum = Math.max(
    1,
    Math.min(total, Number(Q.sejm_quorum_floor) || 230)
);
const leftPool = Q.left_in_government
    ? 0
    : Math.max(
        0,
        Math.min(
            total,
            Number(Q.confidence_2025_left_pool) || 0
        )
    );
let governingSeats = Number(Q.coalition_seats);
if (!Number.isFinite(governingSeats) || governingSeats <= 0) {
    governingSeats =
        (Number(Q.ko_seats) || 0) +
        (Number(Q.psl_seats) || 0) +
        (Number(Q.p2050_seats) || 0) +
        (Q.left_in_government ? (Number(Q.left_seats) || 0) : 0);
}
const partnerSeats =
    Math.max(0, Number(Q.ko_seats) || 0) +
    Math.max(0, Number(Q.psl_seats) || 0) +
    Math.max(0, Number(Q.p2050_seats) || 0) +
    Math.max(0, Number(Q.centrum_seats) || 0);
if (!Q.left_in_government && partnerSeats > 0) {
    governingSeats = Math.min(governingSeats, partnerSeats);
}
governingSeats = Math.max(
    0,
    Math.min(total - leftPool, Math.round(governingSeats))
);
const baseDissent = Math.max(
    0,
    Math.round(
        ((Number(Q.government_coalition_dissent) || 0) - 30) / 7
    )
);
const strategy = Number(Q.confidence_2025_bonus) || 0;
const dissentLoss = Math.max(
    0,
    Math.min(
        governingSeats,
        baseDissent +
            Math.max(0, -strategy) -
            Math.min(baseDissent, Math.max(0, strategy))
    )
);
const totalAbsences = Math.min(
    Math.max(0, total - quorum),
    Math.floor((this.random.uint32() / 4294967296) * 11)
);
const nonLeftSeats = Math.max(1, total - leftPool);
const governmentAbsences = Math.min(
    Math.max(0, governingSeats - dissentLoss),
    Math.round(totalAbsences * governingSeats / nonLeftSeats)
);
Q.confidence_2025_governing_base = Math.round(governingSeats);
Q.confidence_2025_dissent_loss = dissentLoss;
Q.confidence_2025_random_loss = totalAbsences;
const governmentYes = Math.max(
    0,
    governingSeats - dissentLoss - governmentAbsences
);
const governmentDissentNo = Math.ceil(dissentLoss * 0.58);
const governmentDissentAbstain =
    dissentLoss - governmentDissentNo;
const leftYes = Math.max(
    0,
    Math.min(leftPool, Number(Q.confidence_2025_left_yes) || 0)
);
const leftNo = Math.max(
    0,
    Math.min(
        leftPool - leftYes,
        Number(Q.confidence_2025_left_no) || 0
    )
);
const leftAbstain = Math.max(
    0,
    Math.min(
        leftPool - leftYes - leftNo,
        Number(Q.confidence_2025_left_abstain) || 0
    )
);
const leftUnassigned = Math.max(
    0,
    leftPool - leftYes - leftNo - leftAbstain
);
const otherPool = Math.max(
    0,
    total - governingSeats - leftPool
);
const otherAbsences = Math.min(
    otherPool,
    Math.max(0, totalAbsences - governmentAbsences)
);
const otherPresent = Math.max(0, otherPool - otherAbsences);
const otherAbstain = Math.min(
    otherPresent,
    Math.max(0, Math.round(otherPresent * 0.06))
);
const otherNo = Math.max(0, otherPresent - otherAbstain);
Q.confidence_yes = governmentYes + leftYes;
Q.confidence_no =
    governmentDissentNo + leftNo + otherNo;
Q.confidence_abstain =
    governmentDissentAbstain + leftAbstain + otherAbstain;
Q.confidence_present =
    Q.confidence_yes + Q.confidence_no + Q.confidence_abstain;
Q.confidence_2025_absent = Math.max(
    0,
    total - Q.confidence_present
);
Q.confidence_threshold = Q.confidence_no + 1;
Q.government_has_confidence =
    Q.confidence_present >= quorum &&
    Q.confidence_yes > Q.confidence_no ? 1 : 0;
Q.coalition_confidence_2025_done = 1;
if (Q.government_has_confidence) {
    Q.government_coalition_dissent -= 3;
    Q.public_trust += 1;
    Q.news_headline =
        "The cabinet survives with " + Q.confidence_yes + " votes";
} else {
    Q.coalition_broken = 1;
    Q.caretaker_government = 1;
    Q.left_in_government = 0;
    Q.razem_in_government = 0;
    Q.left_cabinet_committed = 0;
    Q.budget = 0;
    Q.budget_authority =
        "Caretaker cabinet — no new discretionary spending authority";
    Q.position = "Caretaker cabinet and formation talks";
    Q.formation_in_progress = 1;
    Q.early_election_risk = Math.max(70, Q.early_election_risk);
    Q.news_headline =
        "The cabinet loses confidence with " + Q.confidence_yes + " votes";
}
!}

= Confidence roll call

**Yes [+ confidence_yes +] · No [+ confidence_no +] · Abstain [+
confidence_abstain +] · Absent [+ confidence_2025_absent +]**

Yes count: **[+ confidence_2025_governing_base +] governing base** − **[+
confidence_2025_dissent_loss +] coalition-dissent losses** − **[+
confidence_2025_random_loss +] total roll-call absences**. Lewica posture:
**[+ confidence_2025_left_posture +]**.

Article 160 requires a quorum and a simple majority: yes must exceed no.
Abstentions are recorded separately and do not become no votes. The live
threshold is **[+ confidence_threshold +] yes** with **[+
confidence_present +] present**.

[? if government_has_confidence: The cabinet survives. The vote proves a
simple majority under Article 160;
it does not settle candidate strategy, delivery or trust.?]
[? if not government_has_confidence: The cabinet falls. A named constructive
replacement or the constitutional formation ladder must now find a majority.?]

