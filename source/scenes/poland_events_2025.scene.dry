subtitle: Minority safety +4, court trust +3 and delivery +2.
on-arrival: minority_safety += 4; court_user_trust += 3; government_delivery += 2; constitutional_restraint += 2; progressives_dissent += 1; news_headline = "Administrative guidance makes the judgment usable"
go-to: poland_event_queue

