}.bind(this);
const leftIntent = finitePres25(Q.left_vote_intent, 8.61);
const koIntent = finitePres25(Q.ko_vote_intent, 30.70);
const pisIntent = finitePres25(Q.pis_vote_intent, 35.38);
const konfIntent = finitePres25(Q.konf_vote_intent, 7.16);
const campaign = finitePres25(Q.pres_2025_campaign_strength, 0);
const debate = finitePres25(Q.pres_2025_debate_shift, 0);
const candidateBaseline =
