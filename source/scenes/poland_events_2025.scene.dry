        (Number(Q.formation_2025_designation_support) || 0) -
            (Number(Q.formation_2025_left_yes) || 0)
    )
);
Q.snap_formation_left_votes =
    Number(Q.formation_2025_left_yes) || 0;
Q.snap_formation_left_abstentions =
    Number(Q.formation_2025_left_abstain) || 0;
Q.snap_formation_variance = 0;
Q.snap_formation_first_right = 0;
