@confidence_rescue_2025
title: Supply enough votes to rescue the democratic cabinet
subtitle: Rescue the democratic cabinet from outside and accept a visible Left split.
on-arrival: {!
Q.confidence_2025_left_yes = Math.round(
    (Number(Q.confidence_2025_left_pool) || 0) * 0.72
);
Q.confidence_2025_left_no = 0;
Q.confidence_2025_left_abstain = Math.max(
    0,
    (Number(Q.confidence_2025_left_pool) || 0) -
        Q.confidence_2025_left_yes
);
Q.confidence_2025_bonus = 0;
Q.confidence_2025_left_posture =
    "Opposition — partial rescue vote";
