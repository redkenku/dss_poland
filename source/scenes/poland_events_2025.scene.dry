go-to: poland_ministries

@reshuffle_exit
title: Leave the cabinet and offer confidence from outside
subtitle: Lewica becomes confidence-and-supply opposition; KO −10 and Razem +5.
view-if: government_has_confidence = 1 and left_in_government = 1
on-arrival: {!
Q.left_in_government = 0;
Q.razem_in_government = 0;
Q.left_cabinet_committed = 0;
Q.left_cabinet_model = "Confidence and supply from opposition";
Q.budget = 0;
Q.budget_authority = "Opposition — no state spending authority";
Q.position = "Confidence-and-supply opposition";
Q.coalition_status = "Minority democratic cabinet";
const sittingCabinetPortfolios = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
// Read actual office-holding before changing the coalition status.  A prior
// PSL resignation must not be undone merely because this later event resets
// the broader crisis flag.
const pslStillInCabinet = sittingCabinetPortfolios.some(function(portfolio) {
    return Q[portfolio + "_minister_party"] == "PSL";
});
const p2050StillInCabinet = sittingCabinetPortfolios.some(function(portfolio) {
    return Q[portfolio + "_minister_party"] == "Poland 2050";
});
Q.party_unity -= 3;
Q.razem_cooperation += 5;
Q.ko_relation -= 10;
const exitCabinet = {
    labor: ["KO", "Coalition social-policy nominee"],
    equality: ["KO", "Coalition equality nominee"],
    housing: ["KO", "Coalition housing nominee"],
    health: ["KO", "Izabela Leszczyna"],
    digital: p2050StillInCabinet
        ? ["Poland 2050", "Coalition digital nominee"]
        : ["KO", "Coalition digital nominee"],
    science: ["KO", "Coalition science nominee"],
    interior: ["KO", "Marcin Kierwiński"],
    finance: ["KO", "Andrzej Domański"],
    economy: pslStillInCabinet
        ? ["PSL", "Krzysztof Hetman"]
        : ["KO", "Coalition development nominee"],
    justice: ["KO", "Adam Bodnar"],
    foreign: ["KO", "Radosław Sikorski"],
    agriculture: pslStillInCabinet
        ? ["PSL", "Czesław Siekierski"]
        : ["KO", "Coalition agriculture nominee"],
    defence: pslStillInCabinet
        ? ["PSL", "Władysław Kosiniak-Kamysz"]
        : ["KO", "Coalition defence nominee"]
};
for (const portfolio of Object.keys(exitCabinet)) {
    Q[portfolio + "_minister_party"] = exitCabinet[portfolio][0];
    Q[portfolio + "_minister"] = exitCabinet[portfolio][1];
}
// coalition_seats is cabinet-party membership, not the confidence-and-supply
// tally.  Centrum and the departing Left remain outside unless they hold an
// actual Council of Ministers portfolio.
Q.coalition_seats = Math.min(
    Number(Q.sejm_total) || 460,
    Math.max(0, Number(Q.ko_seats) || 0) +
        (p2050StillInCabinet
            ? Math.max(0, Number(Q.p2050_seats) || 0)
            : 0) +
        (pslStillInCabinet
            ? Math.max(0, Number(Q.psl_seats) || 0)
            : 0)
);
Q.family_minister_party = Q.labor_minister_party;
Q.family_minister = Q.labor_minister;
Q.ministry_count = 0;
Q.ministries_finalized = 1;
Q.ministry_allocation_mode = "settled";
Q.news_headline =
    "The Left leaves ministries without immediately bringing down the cabinet";
!}
go-to: poland_event_queue

@reshuffle_opposition_audit
title: Stay outside and publish a ministry-by-ministry audit
subtitle: Media +3, public trust +2 and KO relations −2.
view-if: government_has_confidence = 1 and left_in_government = 0
on-arrival: media_capacity += 3; public_trust += 2; ko_relation -= 2; labor_credibility += 2; news_headline = "Lewica audits the reshuffle from opposition instead of inventing ministries"
go-to: poland_event_queue

@reshuffle_opposition_entry
title: Negotiate entry around labour, housing and equality
subtitle: Requires a workable KO relationship; opens the real portfolio table.
view-if: government_has_confidence = 1 and left_in_government = 0
choose-if: ko_relation >= 45
unavailable-subtitle: KO will not reopen cabinet posts at the current relationship.
on-arrival: {!
Q.left_in_government = 1;
Q.razem_in_government = 0;
Q.left_cabinet_committed = 1;
Q.coalition_broken = 0;
Q.caretaker_government = 0;
Q.left_cabinet_model =
    "New Left ministers · Razem external support";
Q.position = "Coalition government";
Q.coalition_status = "Reconstituted democratic coalition";
const entryPortfolios = [
    "labor", "equality", "housing", "health", "digital", "science",
    "interior", "finance", "economy", "justice", "foreign",
    "agriculture", "defence"
];
const entryPartySeats = {
    KO: Math.max(0, Number(Q.ko_seats) || 0),
    PSL: Math.max(0, Number(Q.psl_seats) || 0),
    "Poland 2050": Math.max(0, Number(Q.p2050_seats) || 0)
};
const entryCabinetParties = [];
for (const portfolio of entryPortfolios) {
    const party = Q[portfolio + "_minister_party"];
    if (
        Object.prototype.hasOwnProperty.call(entryPartySeats, party) &&
        entryCabinetParties.indexOf(party) < 0
    ) {
        entryCabinetParties.push(party);
    }
}
Q.coalition_seats = Math.min(
    Number(Q.sejm_total) || 460,
    entryCabinetParties.reduce(function(total, party) {
        return total + entryPartySeats[party];
    }, 0)
);
Q.budget = Math.max(2, Number(Q.budget) || 0);
Q.budget_authority =
    "Governing coalition — negotiated fiscal capacity";
Q.ministries_finalized = 0;
Q.ministry_allocation_mode = "event_reshuffle";
Q.ministry_return_mode = "event_queue";
Q.ministry_reshuffle_previous_count = 0;
Q.ko_relation -= 2;
Q.party_unity -= 2;
Q.news_headline =
    "Lewica opens a transparent negotiation to enter the surviving cabinet";
!}
go-to: poland_ministries

