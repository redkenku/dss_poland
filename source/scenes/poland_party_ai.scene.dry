// Parties created by campaign splits are political actors, not inert vote
// containers. They use a deliberately lighter AI than the five national
// organisations, but still build capacity, choose cooperation or competition,
// and create their own polling momentum every month.
const successorParties = [
    {
        id: "p0",
        active: !!Q.p0_formed,
        parent: "konf",
        seats: "p0_seats",
        founding: "stanowski_trigger_score",
        parentRelation: 24,
        label: Q.p0_name || "Partia Zero"
    },
    {
        id: "centrum",
        active: !!Q.unia_centrum_formed,
        parent: "p2050",
        seats: "centrum_seats",
        founding: "centrum_party_readiness",
        parentRelation: 34,
        label: "Centrum"
    },
    {
        id: "rozwoj",
        active: !!Q.rozwoj_party_formed && !Q.rozwoj_internal_pis && !Q.rozwoj_joined_left,
        parent: "pis",
        seats: "rozwoj_seats",
        founding: "rozwoj_association_members",
        parentRelation: 28,
        label: "Rozwój"
    },
    {
        id: "tak_rozwoj",
        active: !!Q.tak_dla_rozwoju_party_formed,
        parent: Q.razem_party_formed ? "razem" : "left",
        seats: "tak_rozwoj_seats",
        founding: "razem_future_activists",
        parentRelation: 30,
        label: Q.tak_rozwoj_party_name || "Tak! Dla Rozwoju"
    },
    {
        id: "korona",
        active: !!Q.far_right_split,
        parent: "konf",
        seats: "korona_seats",
        founding: "far_right_fragmentation",
        parentRelation: 20,
        label: "Korona"
    },
    {
        id: "sld_breakaway",
        active: !!Q.barons_party_formed,
        parent: "left",
        caucus: "barons",
        seats: "sld_breakaway_seats",
        founding: "barons_exit_strength",
        label: Q.barons_party_name || "SLD breakaway"
    },
    {
        id: "social_patriot",
        active: !!Q.social_patriot_party_formed,
        parent: "left",
        caucus: "social_patriot",
        seats: "social_patriot_seats",
        founding: "social_patriot_exit_strength",
        label: Q.social_patriot_party_name || "Lewica Patriotyczna"
    },
    {
        id: "spring_breakaway",
        active: !!Q.spring_party_formed,
        parent: "left",
        caucus: "spring",
        seats: "spring_breakaway_seats",
        founding: "spring_exit_strength",
        list: "spring_list_committee",
        joinedRazem: "spring_joined_razem",
        razemRelation: 58,
        label: Q.spring_party_name || "Spring breakaway"
    },
    {
        id: "labor_left",
        active: !!Q.labor_party_formed,
        parent: "left",
        caucus: "labor",
        seats: "labor_left_seats",
        founding: "labor_exit_strength",
        list: "labor_list_committee",
        joinedRazem: "labor_joined_razem",
        razemRelation: 50,
        label: Q.labor_party_name || "Independent Labour Left"
    },
    {
        id: "young_left",
        active: !!Q.progressives_party_formed,
        parent: "left",
        caucus: "progressives",
        seats: "young_left_seats",
        founding: "progressives_exit_strength",
        list: "progressives_list_committee",
        joinedRazem: "progressives_joined_razem",
        razemRelation: 62,
        label: Q.progressives_party_name || "Young Left"
    },
    {
        id: "razem",
        active: !!Q.razem_party_formed,
        parent: "left",
        caucus: "razem",
        seats: "razem_party_seats",
        founding: "razem_exit_strength",
        label: Q.razem_party_name || "Razem"
    },
    {
        id: "pps",
        active: !!Q.pps_party_formed,
        parent: "left",
        caucus: "pps",
        seats: "pps_party_seats",
        founding: "pps_exit_strength",
        label: Q.pps_party_name || "PPS"
    }
];
for (const successor of successorParties) {
    const id = successor.id;
    if (!successor.active) {
        Q[id + "_ai_acted"] = 0;
        Q[id + "_ai_strategy"] = "Organisation not active";
        continue;
    }
    Q[id + "_ai_active"] = 1;
    const successorSeats = Math.max(0, finiteAI(Q[successor.seats], 0));
    const foundingStrength = Math.max(
        0,
        finiteAI(Q[successor.founding], 0)
    );
    if (!Number.isFinite(Number(Q[id + "_right_score"]))) {
        Q[id + "_right_score"] = finiteAI(
            Q[successor.parent + "_right_score"],
            50
        );
    }
    if (typeof Q[id + "_dominant_wing"] != "string") {
        Q[id + "_dominant_wing"] = successor.label + " leadership";
    }
    if (typeof Q[id + "_ideology_drift"] != "string") {
        Q[id + "_ideology_drift"] = "Defining an autonomous profile";
    }
    if (!Number.isFinite(Number(Q[id + "_org_resources"]))) {
        Q[id + "_org_resources"] = Math.round(clampAI(
            2 + Math.max(successorSeats * 0.30, foundingStrength * 0.08),
            2,
            8
        ));
    }
    if (!Number.isFinite(Number(Q[id + "_org_income"]))) {
        Q[id + "_org_income"] = Math.round(clampAI(
            1 + Math.max(successorSeats * 0.08, foundingStrength * 0.035),
            1,
            5
        ));
    }
    if (!Number.isFinite(Number(Q[id + "_organisation"]))) {
        Q[id + "_organisation"] = Math.round(clampAI(
            12 + successorSeats * 2 + foundingStrength * 0.5,
            12,
            65
        ));
    }
    if (!Number.isFinite(Number(Q[id + "_income_last_year"]))) {
        Q[id + "_income_last_year"] = Q.year;
    }
    if (Q.year > Q[id + "_income_last_year"]) {
        Q[id + "_org_resources"] = Math.min(
            12,
            Q[id + "_org_resources"] +
                Q[id + "_org_income"] *
                Math.min(10, Q.year - Q[id + "_income_last_year"])
        );
        Q[id + "_income_last_year"] = Q.year;
    }
    if (!Number.isFinite(Number(Q[id + "_ai_actions"]))) {
        Q[id + "_ai_actions"] = 0;
    }
    Q[id + "_ai_acted"] = 0;
    Q[id + "_ai_last_spend"] = 0;
    const successorVote = Math.max(0, finiteAI(
        Q[id + "_component_vote_intent"],
        finiteAI(Q[id + "_vote_intent"], finiteAI(Q[id + "_poll"], 0))
    ));
    Q[id + "_electoral_viability"] = successorVote >= 5
        ? "Above the 5% threshold"
        : "Below the 5% threshold";
    const relationKey = successor.caucus
        ? successor.caucus + "_party_relation"
        : id + "_parent_relation";
    if (!Number.isFinite(Number(Q[relationKey]))) {
        Q[relationKey] = successor.caucus
            ? 20
            : successor.parentRelation;
    }
    let relation = finiteAI(Q[relationKey], 20);
    const successorActs =
        Q[id + "_org_resources"] >= 1 &&
        randomAI() <= Math.min(
            0.82,
            0.40 + Q[id + "_org_resources"] * 0.04 +
                (successorVote < 5 ? 0.12 : 0)
        );
    if (!successorActs) {
        Q[id + "_ai_strategy"] = "Build an independent organisation";
        Q[id + "_ideology_drift"] =
            "Consolidating an autonomous line";
        Q[id + "_organisation"] = clampAI(
            Q[id + "_organisation"] + 1.5,
            0,
            100
        );
        Q[id + "_org_resources"] = Math.min(
            12,
            Q[id + "_org_resources"] + 0.2
        );
        Q[id + "_org_income"] = Math.min(
            5,
            Q[id + "_org_income"] + 0.04
        );
        Q[id + "_poll_momentum"] = clampAI(
            finiteAI(Q[id + "_poll_momentum"], 0) + 0.06,
            -4,
            8
        );
        Q[id + "_ai_headline"] =
            successor.label + " spends the month building local branches";
    } else {
        Q[id + "_org_resources"] -= 1;
        Q[id + "_organisation"] = clampAI(
            Q[id + "_organisation"] + 0.5,
            0,
            100
        );
        Q[id + "_ai_last_spend"] = 1;
        Q[id + "_ai_acted"] = 1;
        Q[id + "_ai_actions"] += 1;
        Q.rival_actions_this_month += 1;
        if (relation >= 45) {
            Q[id + "_ai_strategy"] =
                "Coordinate without surrendering autonomy";
            Q[id + "_ideology_drift"] =
                "Pragmatic cooperation with distinct branding";
            Q[id + "_poll_momentum"] = clampAI(
                finiteAI(Q[id + "_poll_momentum"], 0) + 0.22,
                -4,
                8
            );
            Q[successor.parent + "_poll_momentum"] = clampAI(
                finiteAI(Q[successor.parent + "_poll_momentum"], 0) + 0.04,
                -4,
                8
            );
            relation = clampAI(relation + 1.5, 0, 100);
            Q[id + "_ai_headline"] = successor.label +
                " negotiates an electoral non-aggression pact";
        } else {
            Q[id + "_ai_strategy"] = "Differentiate from the parent party";
            Q[id + "_ideology_drift"] =
                "Hard differentiation from the parent bloc";
            Q[id + "_poll_momentum"] = clampAI(
                finiteAI(Q[id + "_poll_momentum"], 0) + 0.34,
                -4,
                8
            );
            Q[successor.parent + "_poll_momentum"] = clampAI(
                finiteAI(Q[successor.parent + "_poll_momentum"], 0) - 0.08,
                -4,
                8
            );
            relation = clampAI(relation - 2, 0, 100);
            Q[id + "_ai_headline"] =
                successor.label + " attacks its former party from outside";
        }
        Q[relationKey] = relation;
    }
    const filed2023List =
        Q.year == 2023 && !!Q.sejm_list_negotiation_done;
    if (successor.list && !filed2023List) {
        const razemVote = Math.max(0, finiteAI(
            Q.razem_component_vote_intent,
            finiteAI(Q.razem_vote_intent, finiteAI(Q.razem_poll, 0))
        ));
        const razemRelationKey = id + "_razem_relation";
        if (!Number.isFinite(Number(Q[razemRelationKey]))) {
            Q[razemRelationKey] = successor.razemRelation;
        }
        const spsExileAlliance =
            !!Q.sld_populist_route_active && !!Q.razem_party_formed &&
            ["spring_breakaway", "young_left"].includes(id) &&
            !!Q[successor.joinedRazem];
        const viableRazemAlliance = spsExileAlliance ||
            (
                !!Q.razem_party_formed && successorVote < 5 &&
                successorVote + razemVote >= 5 &&
                finiteAI(Q[razemRelationKey], 0) >= 50 &&
                finiteAI(Q.razem_cooperation, 0) >= 50
            );
        const canReturnToLeft =
            successorVote < 5 && relation >= 55 && !viableRazemAlliance;
        Q[successor.list] = viableRazemAlliance
            ? "razem"
            : (canReturnToLeft ? "left" : id);
        Q[successor.joinedRazem] = viableRazemAlliance ? 1 : 0;
        Q[id + "_electoral_strategy"] = viableRazemAlliance
            ? (spsExileAlliance
                ? "Join the democratic-left Razem list against SPS"
                : "Join a viable independent Razem list")
            : (canReturnToLeft
                ? "Negotiate protected places on the Lewica list"
                : (successorVote >= 5
                    ? "Defend an independent five-percent campaign"
                    : "Build an independent list toward five percent"));
    } else if (id == "sld_breakaway" || id == "pps") {
        Q[id + "_electoral_strategy"] =
            "Remain a separate party and contest independently";
    } else if (!successor.list) {
        Q[id + "_electoral_strategy"] = successorVote >= 5
            ? "Defend an independent five-percent campaign"
            : "Build an independent list toward five percent";
    }
    if (
        Q.sld_populist_route_active &&
        ["spring_breakaway", "young_left", "razem"].includes(id)
    ) {
        Q[id + "_ai_headline"] = successor.label +
            " campaigns from the democratic-left opposition to Miller's SPS";
    }
    headlines.push(Q[id + "_ai_headline"]);
}

if (Q.social_patriot_party_formed) {
    Q.social_patriot_party_name = Q.sld_populist_route_active
        ? "Sojusz Polski Społecznej"
        : "Lewica Patriotyczna";
    Q.social_patriot_joined_razem = 0;
    const socialPatriotVote = finiteAI(
        Q.social_patriot_component_vote_intent,
        finiteAI(
            Q.social_patriot_vote_intent,
            finiteAI(Q.social_patriot_poll, 0)
        )
    );
    const filed2023List =
        Q.year == 2023 && !!Q.sejm_list_negotiation_done &&
        ["pis", "konf", "social_patriot"].includes(
            String(Q.social_patriot_list_committee)
        );
    if (Q.sld_populist_route_active) {
        Q.social_patriot_list_committee =
            Q.sld_populist_planned_committee;
    } else if (!filed2023List) {
        Q.social_patriot_list_committee = socialPatriotVote < 5
            ? "pis"
            : "social_patriot";
    }
    const joinsPis = Q.social_patriot_list_committee == "pis";
    const joinsKonf = Q.social_patriot_list_committee == "konf";
    const independentSps = Q.sld_populist_route_active &&
        Q.social_patriot_list_committee == "left";
    Q.social_patriot_electoral_strategy = joinsPis
        ? "Protected places on the PiS party list"
        : (joinsKonf
            ? "Protected places on the Konfederacja party list"
            : (independentSps
                ? "Independent SPS party list"
                : "Independent party list above 5%"));
    Q.social_patriot_ai_strategy = joinsPis || joinsKonf
        ? "Defend conditional host-list places"
        : "Defend an independent five-percent campaign";
    Q.social_patriot_ai_headline = Q.sld_populist_route_active
        ? "Miller's Sojusz Polski Społecznej defends its " +
            Q.sld_populist_orientation + " orientation"
        : (joinsPis
            ? "Lewica Patriotyczna chooses PiS list places over a sub-threshold run"
            : "Lewica Patriotyczna campaigns to clear five percent alone");
    headlines.push(Q.social_patriot_ai_headline);
}
if (Q.sld_populist_route_active && !Q.social_patriot_party_formed) {
    Q.social_patriot_ai_strategy =
        Q.sld_populist_orientation == "independent"
            ? "Build an independent rural welfare-populist campaign"
            : "Protect a conditional " +
                Q.sld_populist_alliance_partner + " pact";
    Q.social_patriot_ai_headline =
        "Miller's Sojusz Polski Społecznej defends its " +
        Q.sld_populist_orientation + " orientation";
    headlines.push(Q.social_patriot_ai_headline);
}

// Component parties and associations keep acting even when they share a
// parliamentary club. This uses the same persistent record shape as split
// parties and never changes their leader or transfers their whole following.
const autonomousGroupIds = [
    "porozumienie", "solidarna", "rozwoj_plus", "nowoczesna", "ipl",
    "greens", "ko_splinter", "republikanie", "odnowa", "kukiz15"
];
const autonomousGroups = (Q.rival_group_records || []).filter(
    function(record) {
        return record.active && autonomousGroupIds.includes(record.id);
    }
);
// Three actors with their own logic rather than the generic component tick.
// Gowin looks for compromise first, threatens second, and only leaves when
// staying costs him his political identity; Kukiz sells programme and not
// office; Kaczynski's answer to both is to cultivate their internal rivals.
const gowinRecord = (Q.rival_group_records || []).find(function(record) {
    return record.id == "porozumienie" && record.active;
});
if (gowinRecord && !Q.porozumienie_exit_done) {
    const squeezed = Math.max(0, 55 - Math.max(0, Number(Q.gowin_standing) || 55));
    gowinRecord.grievance_memory = Math.min(
        100,
        (Number(gowinRecord.grievance_memory) || 0) + (squeezed > 12 ? 2 : 0)
    );
    // Threatening is cheap and always costs him cohesion; it is the trap the
    // whole chain is about.
    if (squeezed > 18 && randomAI() <= 0.35) {
        gowinRecord.cohesion = Math.max(
            0,
            (Number(gowinRecord.cohesion) || 55) - 1
        );
        Q.rival_group_month_action =
            gowinRecord.name + " threatens the coalition and loses another deputy's patience";
        headlines.push(Q.rival_group_month_action);
    }
    // PiS answers by paying his internal rivals rather than him.
    if (Q.republikanie_formed && randomAI() <= 0.4) {
        const republicans = (Q.rival_group_records || []).find(function(record) {
            return record.id == "republikanie";
        });
        if (republicans) {
            republicans.organisation = Math.min(
                100,
                (Number(republicans.organisation) || 26) + 1
            );
        }
    }
}
const kukizRecord = (Q.rival_group_records || []).find(function(record) {
    return record.id == "kukiz15" && record.active;
});
if (kukizRecord && Q.kukiz_left_kp) {
    const credit = Math.max(0, Number(Q.kukiz_programme_credit) || 0);
    // He is not buyable with offices, so the only thing that moves him is
    // whether anybody is actually passing his bills.
    if (credit >= 30 && randomAI() <= 0.3) {
        kukizRecord.relation = Math.min(
            100,
            (Number(kukizRecord.relation) || 16) + 1
        );
        Q.rival_group_month_action =
            "Kukiz'15 votes with the opposition on an anti-corruption clause";
        headlines.push(Q.rival_group_month_action);
    } else if (String(Q.kukiz_alignment || "") == "toleration" &&
        randomAI() <= 0.25) {
        Q.rival_group_month_action =
            "Kukiz'15 withholds its votes until somebody names a committee date";
        headlines.push(Q.rival_group_month_action);
    }
}
for (const independentId of ["solidarna", "porozumienie"]) {
    const independent = autonomousGroups.find(function(record) {
        return record.id == independentId &&
            ((independentId == "solidarna" &&
                (Q.suwerenna_walkout ||
                    String(Q.suwerenna_merger_result || "") == "Merger refused")) ||
                (independentId == "porozumienie" && Q.porozumienie_exit_done));
    });
    if (independent) {
        independent.electoral_outside_option = "independent parliamentary party";
        independent.organisation = Math.min(
            100,
            (Number(independent.organisation) || 0) + 1
        );
        Q.rival_group_month_action = independent.name +
            " builds an independent parliamentary organisation";
        headlines.push(Q.rival_group_month_action);
    }
}
if (autonomousGroups.length) {
    const groupIndex = Math.abs(Number(Q.rival_ai_tick) || 0) %
        autonomousGroups.length;
    const activeGroup = autonomousGroups[groupIndex];
    const organisingMonth = randomAI() <= 0.55;
    if (organisingMonth) {
        activeGroup.organisation = Math.min(
            100,
            (Number(activeGroup.organisation) || 0) + 1
        );
        activeGroup.cohesion = Math.min(
            100,
            (Number(activeGroup.cohesion) || 0) + 1
        );
        Q.rival_group_month_action =
            activeGroup.name + " builds its own branches and member roll";
    } else {
        const relationDirection = activeGroup.relation >= 45 ? 1 : -1;
        activeGroup.relation = Math.max(
            -100,
            Math.min(100, activeGroup.relation + relationDirection)
        );
        Q.rival_group_month_action = activeGroup.relation >= 45
            ? activeGroup.name + " keeps an autonomous cooperation channel"
            : activeGroup.name + " differentiates itself from Lewica";
    }
    headlines.push(Q.rival_group_month_action);
}

const directRelationAI = {
    pis: finiteAI(Q.pis_relation, 8),
    ko: finiteAI(Q.ko_relation, 44),
    psl: finiteAI(Q.psl_relation, 24),
    konf: finiteAI(Q.konf_relation, 2),
    p2050: finiteAI(Q.p2050_relation, 0)
};
const socialWingAI = {
    pis: Q.pis_solidarist_share,
    ko: Q.ko_social_liberal_share,
    psl:
        Q.psl_agrarian_pragmatist_share +
        Q.psl_coalition_manager_share * 0.30,
    konf: Math.max(
        5,
        30 -
            Q.konf_mentzenite_share * 0.25 -
            Q.konf_braunist_share * 0.10
    ),
    p2050:
        Q.p2050_state_capacity_share +
        Q.p2050_personalist_share * 0.15
};
const rightsWingAI = {
    pis: Math.max(4, 100 - Q.pis_cultural_position),
    ko: Q.ko_social_liberal_share,
    psl:
        100 -
        Q.psl_conservative_share -
        Q.psl_agrarian_pragmatist_share * 0.20,
    konf: Math.max(
        2,
        30 -
            Q.konf_braunist_share * 0.40 -
            Q.konf_nationalist_share * 0.30
    ),
    p2050:
        Q.p2050_state_capacity_share +
        Q.p2050_personalist_share * 0.20
};
const orderWingAI = {
    pis: (Q.pis_cultural_position + Q.pis_market_hardliner_share) / 2,
    ko:
        Q.ko_classical_liberal_share * 0.65 +
        finiteAI(Q.institutional_issue_salience, 40) * 0.35,
    psl:
        Q.psl_conservative_share +
        Q.psl_agrarian_pragmatist_share * 0.35,
    konf:
        Q.konf_nationalist_share +
        Q.konf_braunist_share * 0.75,
    p2050:
        Q.p2050_christian_dem_share +
        Q.p2050_personalist_share * 0.25
};
const marketWingAI = {
    pis: Q.pis_market_hardliner_share,
    ko: Q.ko_classical_liberal_share,
    psl:
        Q.psl_coalition_manager_share +
        Q.psl_conservative_share * 0.40,
    konf: Q.konf_mentzenite_share,
    p2050:
        Q.p2050_personalist_share +
        Q.p2050_christian_dem_share * 0.50
};
for (const id of rivalParties) {
    if (id == "p2050" && !Q.p2050_emerged) {
        Q.p2050_accept_social = 0;
        Q.p2050_accept_rights = 0;
        Q.p2050_accept_order = 0;
        Q.p2050_accept_market = 0;
        Q.p2050_coalition_openness = 0;
        continue;
    }
    const economicFit = clampAI(
        100 - Math.abs(Q[id + "_economic_position"] - leftEconomic),
        0,
        100
    );
    const culturalFit = clampAI(
        100 - Math.abs(Q[id + "_cultural_position"] - leftCultural),
        0,
        100
    );
    const strategicFit = clampAI(
        100 - Math.abs(Q[id + "_right_score"] - Q.left_right_score),
        0,
        100
    );
    Q[id + "_accept_social"] = clampAI(
        directRelationAI[id] * 0.42 +
            economicFit * 0.30 +
            socialWingAI[id] * 0.28,
        0,
        100
    );
    Q[id + "_accept_rights"] = clampAI(
        directRelationAI[id] * 0.44 +
            culturalFit * 0.30 +
            rightsWingAI[id] * 0.26,
        0,
        100
    );
    Q[id + "_accept_order"] = clampAI(
        directRelationAI[id] * 0.38 +
            strategicFit * 0.22 +
            orderWingAI[id] * 0.40,
        0,
        100
    );
    Q[id + "_accept_market"] = clampAI(
        directRelationAI[id] * 0.40 +
            economicFit * 0.25 +
            marketWingAI[id] * 0.35,
        0,
        100
    );
    let openness =
        directRelationAI[id] * 0.46 +
        strategicFit * 0.22 +
        Q[id + "_accept_social"] * 0.16 +
        Q[id + "_accept_rights"] * 0.16;
    if (id == "psl") {
        openness += Q.psl_coalition_manager_share * 0.10;
    }
    if (id == "konf") {
        openness -= Q.konf_braunist_share * 0.22;
    }
    Q[id + "_coalition_openness"] = clampAI(openness, 0, 100);
}

// A governing partner occasionally spends its own AI turn on a project that
// needs Lewica's votes. These demands use the same relationship and wing
// scores as ordinary party action, then resolve in a shared coalition-pressure
// scene after the month closes.
const rightPresidentsAI = [
    "Andrzej Duda", "Krzysztof Bosak",
    String(Q.pres_2025_right_candidate || ""),
    "Sławomir Mentzen", "Grzegorz Braun"
];
const hostileCohabitationAI =
    Q.government_party != "pis" &&
    (
        Q.pres_2025_hostile_president ||
        rightPresidentsAI.includes(Q.president_name)
    );
const reformDemandCadenceAI = hostileCohabitationAI ? 3 : 4;
const democraticPartnersAI = [];
if (Q.government_party == "ko" || Q.ministry_ko_in_cabinet) {
    democraticPartnersAI.push("ko");
}
if (Q.government_party == "psl" || Q.ministry_psl_in_cabinet) {
    democraticPartnersAI.push("psl");
}
if (Q.government_party == "p2050" || Q.ministry_p2050_in_cabinet) {
    democraticPartnersAI.push("p2050");
}
const availableReformDemandsAI = [];
if (Q.government_party == "pis") {
    if (finiteAI(Q.pegasus_legal_framework, 0) < 2) {
        availableReformDemandsAI.push("pegasus_legalisation");
    }
    if (finiteAI(Q.anticlerical_edge, 70) > 20) {
        availableReformDemandsAI.push("clerical_truce");
    }
    if (
        finiteAI(Q.pzpr_history_concessions, 0) < 2 &&
        !Q.barons_party_formed
    ) {
        availableReformDemandsAI.push("pzpr_condemnation");
    }
} else if (democraticPartnersAI.length) {
    if (finiteAI(Q.coalition_judicial_pressure_concessions, 0) < 2) {
        availableReformDemandsAI.push("judicial_reset");
    }
    if (
        finiteAI(Q.coalition_media_takeover_concessions, 0) < 2 &&
        Q.public_media_patron != "ko"
    ) {
        availableReformDemandsAI.push("public_media_takeover");
    }
    if (finiteAI(Q.marketisation_concessions, 0) < 2) {
        availableReformDemandsAI.push("marketisation");
    }
}
if (
    Q.left_in_government &&
    Q.government_has_confidence &&
    !Q.caretaker_government &&
    !Q.reform_pressure_pending &&
    finiteAI(Q.reform_pressure_cooldown, 0) <= 0 &&
    finiteAI(Q.rival_ai_tick, 0) > 0 &&
    finiteAI(Q.rival_ai_tick, 0) % reformDemandCadenceAI == 0 &&
    availableReformDemandsAI.length
) {
    const demandIndex =
        Math.floor(finiteAI(Q.rival_ai_tick, 0) / reformDemandCadenceAI) %
        availableReformDemandsAI.length;
    const demandIssue = availableReformDemandsAI[demandIndex];
    Q.reform_pressure_pending = 1;
    Q.reform_pressure_mode = "partner_demand";
    Q.reform_pressure_due_time = finiteAI(Q.time, 0);
    Q.reform_pressure_demands = finiteAI(Q.reform_pressure_demands, 0) + 1;
    if (Q.government_party == "pis") {
        Q.reform_pressure_actor = "pis";
        Q.reform_pressure_actor_name = "PiS";
        Q.reform_pressure_issue = demandIssue;
        if (demandIssue == "pegasus_legalisation") {
            Q.reform_pressure_intensity =
                58 + Q.pis_market_hardliner_share * 0.15;
            Q.reform_pressure_illegality =
                62 + Q.pis_market_hardliner_share * 0.18;
        } else if (demandIssue == "clerical_truce") {
            Q.reform_pressure_intensity =
                54 + Q.pis_cultural_position * 0.18;
            Q.reform_pressure_illegality = 20;
        } else {
            Q.reform_pressure_intensity =
                74 + Math.max(0, 35 - Q.pis_relation) * 0.20;
            Q.reform_pressure_illegality = 12;
        }
    } else {
        const thirdWayPartnersAI = democraticPartnersAI.filter(
            function(id) { return id == "psl" || id == "p2050"; }
        );
        let sponsor = democraticPartnersAI.includes("ko")
            ? "ko"
            : democraticPartnersAI[0];
        if (demandIssue == "marketisation" && thirdWayPartnersAI.length) {
            sponsor = thirdWayPartnersAI[
                finiteAI(Q.rival_ai_tick, 0) % thirdWayPartnersAI.length
            ];
        }
        Q.reform_pressure_actor = sponsor;
        Q.reform_pressure_actor_name = sponsor == "ko"
            ? "KO"
            : "the " + Q.third_way_display_name;
        Q.reform_pressure_issue = demandIssue;
        if (demandIssue == "judicial_reset") {
            Q.reform_pressure_intensity =
                55 + finiteAI(Q.institutional_issue_salience, 40) * 0.20;
            Q.reform_pressure_illegality = hostileCohabitationAI ? 76 : 34;
        } else if (demandIssue == "public_media_takeover") {
            Q.reform_pressure_intensity =
                58 + finiteAI(Q.media_capacity, 20) * 0.08;
            Q.reform_pressure_illegality = hostileCohabitationAI ? 76 : 34;
        } else {
            const sponsorMarketWing = sponsor == "ko"
                ? Number(Q.ko_classical_liberal_share)
                : (sponsor == "psl"
                    ? Number(Q.psl_agrarian_pragmatist_share)
                    : 100 - Number(Q.p2050_state_capacity_share));
            Q.reform_pressure_intensity =
                48 + sponsorMarketWing * 0.28 +
                (sponsor == "ko" ? 0 : 6);
            Q.reform_pressure_illegality = 8;
        }
    }
    Q.reform_pressure_intensity = clampAI(
        Q.reform_pressure_intensity, 0, 100
    );
    Q.reform_pressure_illegality = clampAI(
        Q.reform_pressure_illegality, 0, 100
    );
    headlines.push(
        Q.reform_pressure_actor_name +
        " demands Lewica's support for a coalition reform"
    );
}

Q.pis_ideology =
    Q.pis_dominant_wing == "Social solidarists"
        ? "National-conservative · social-solidarist wing ascendant"
        : "National-conservative · market-hardliner wing ascendant";
Q.ko_ideology =
    Q.ko_dominant_wing == "Social liberals"
        ? "Broad-tent liberal · social-liberal wing ascendant"
        : "Broad-tent liberal · classical-liberal wing ascendant";
Q.psl_ideology =
    "Agrarian centre · " + Q.psl_dominant_wing.toLowerCase();
Q.konf_ideology =
    "Radical-right federation · " + Q.konf_dominant_wing;
Q.p2050_ideology = Q.p2050_emerged
    ? "Centrist movement · " + Q.p2050_dominant_wing.toLowerCase()
    : "Movement not yet formed";

if (publicMoodModelAI) {
    publicMoodModelAI.resolve(Q, {advance: false, finalize: true});
}

Q.national_turnout_climate = clampAI(
    finiteAI(Q.national_turnout_climate, isFormationEra ? 74 : 61) +
        Q.rival_actions_this_month * 0.12 +
        (Q.cultural_issue_salience >= 65 ? 0.2 : 0),
    35,
    90
);
Q.rival_ai_tick = finiteAI(Q.rival_ai_tick, 0) + 1;
Q.party_ai_last_updated = Q.date_label;
Q.rival_month_headline = headlines.length
    ? headlines.join(" · ")
    : (maintenanceHeadlines.length
        ? maintenanceHeadlines.slice(0, 3).join(" · ")
        : "Rival parties conserve their organisational pools");
if (Q.rival_mood_last_effect) {
    Q.rival_month_headline += " · Mood contest: " +
        Q.rival_mood_last_effect;
}

if (
    Q.rival_relation_ko_psl >= 60 &&
    (
        !Q.p2050_emerged ||
        Q.rival_relation_ko_p2050 >= 55
    )
) {
    Q.rival_coalition_signal =
        "The democratic opposition can still coordinate";
} else if (
    Q.rival_relation_pis_psl >= 45 ||
    Q.rival_relation_pis_konf >= 50
) {
    Q.rival_coalition_signal =
        "PiS has a live channel to a party on its right";
} else {
    Q.rival_coalition_signal =
        "Every coalition channel is tactical and conditional";
}

// Keep decimal recovery internally, but prevent floating-point tails from
// leaking into party and relationship displays.
for (const key of Object.keys(relationDefaults)) {
    Q[key] = Math.round(finiteAI(Q[key], relationDefaults[key]) * 10) / 10;
}

// Compatibility mirrors for the separate election worksheet. The canonical
// simulation state remains the uncapped organisational pools and the hidden
// rival_relation_* matrix above.
for (const id of rivalParties) {
    Q[id + "_ai_resources"] =
        Math.round(Q[id + "_org_resources"] * 10) / 10;
    Q[id + "_ai_income"] = Q[id + "_org_income"];
    Q[id + "_social_position"] = Q[id + "_cultural_position"];
}
Q.left_social_position = Q.left_cultural_position;
for (const pair of [
    ["pis", "ko"],
    ["pis", "psl"],
    ["pis", "konf"],
    ["pis", "p2050"],
    ["ko", "psl"],
    ["ko", "konf"],
    ["ko", "p2050"],
    ["psl", "konf"],
    ["psl", "p2050"],
    ["konf", "p2050"]
]) {
    Q["relation_" + pair[0] + "_" + pair[1]] =
        Q["rival_relation_" + pair[0] + "_" + pair[1]];
}

if (!Array.isArray(Q.rival_strategy_log)) {
    Q.rival_strategy_log = [];
}
Q.rival_strategy_log.push(
    Q.date_label + " — " + Q.rival_month_headline
);
while (Q.rival_strategy_log.length > 18) {
    Q.rival_strategy_log.shift();
}
Q.rival_ai_last_month_key = rivalAIMonthKey;
}
!}
go-to: poland_reform_pressure if reform_pressure_pending = 1; poland_polling if reform_pressure_pending = 0
