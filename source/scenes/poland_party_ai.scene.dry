for (const id of rivalParties) {
    Q[id + "_ai_last_spend"] = 0;
    Q[id + "_ai_acted"] = 0;
}

const actChance = function(id) {
    const resources = finiteAI(Q[id + "_org_resources"], 0);
    if (resources < 1) {
        return 0;
    }
    return clampAI(
        0.48 + Math.min(12, resources) * 0.025,
        0.48,
        0.78
    );
};

