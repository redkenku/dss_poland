const setDriftAI = function(id) {
    const change =
        finiteAI(Q[id + "_right_score"], rightScoreDefaults[id]) -
        finiteAI(previousRightScores[id], rightScoreDefaults[id]);
    Q[id + "_ideology_drift"] = change >= 0.15
        ? "Moving right"
        : (change <= -0.15 ? "Moving left" : "Holding course");
};
for (const id of ["left", "pis", "ko", "psl", "konf"]) {
    setDriftAI(id);
}
Q.p2050_ideology_drift =
