const relationOrder = ["pis", "ko", "psl", "konf", "p2050"];
const relationKeyAI = function(first, second) {
    const firstIndex = relationOrder.indexOf(first);
    const secondIndex = relationOrder.indexOf(second);
    return firstIndex < secondIndex
        ? "rival_relation_" + first + "_" + second
        : "rival_relation_" + second + "_" + first;
};
const adjustRelationAI = function(first, second, amount) {
    const key = relationKeyAI(first, second);
    Q[key] = clampAI(finiteAI(Q[key], 30) + amount, 0, 100);
};
const shiftBlocAI = function(bloc, party, amount) {
    const key = bloc + "_" + party + "_affinity";
    Q[key] = clampAI(finiteAI(Q[key], 0) + amount, -20, 20);
};
const addMomentumAI = function(party, amount) {
    const key = party + "_poll_momentum";
    Q[key] = finiteAI(Q[key], 0) + amount;
};

// Slow structural convergence happens before parties choose their monthly move.
// Active cooperation or confrontation therefore survives the current tick.
const voteSignalAI = function(id) {
    return finiteAI(
        Q[id + "_vote_intent"],
        finiteAI(Q[id + "_poll"], 0)
    );
};
const passiveRelationTargetAI = function(first, second) {
    const key = relationKeyAI(first, second);
    const defaultRelation = finiteAI(relationDefaults[key], 30);
    const rightCompatibility =
        100 - Math.abs(
            finiteAI(Q[first + "_right_score"], 50) -
            finiteAI(Q[second + "_right_score"], 50)
        );
    const economicCompatibility =
        100 - Math.abs(
            finiteAI(Q[first + "_economic_position"], 50) -
            finiteAI(Q[second + "_economic_position"], 50)
        );
    const culturalCompatibility =
        100 - Math.abs(
            finiteAI(Q[first + "_cultural_position"], 50) -
            finiteAI(Q[second + "_cultural_position"], 50)
        );
    const electoralCompetition = Math.max(
        0,
        12 - Math.abs(voteSignalAI(first) - voteSignalAI(second))
    ) * 0.22;
    let target =
        defaultRelation +
        (rightCompatibility - 55) * 0.08 +
        (economicCompatibility - 55) * 0.04 +
        (culturalCompatibility - 55) * 0.04 -
        electoralCompetition;

    if (key == "rival_relation_pis_ko") {
        target -=
            10 +
            Math.max(0, Q.institutional_issue_salience - 45) * 0.08;
    } else if (key == "rival_relation_pis_psl") {
        target +=
            Q.pis_solidarist_share * 0.05 +
            Q.psl_conservative_share * 0.07;
    } else if (key == "rival_relation_pis_konf") {
        target +=
            Q.konf_nationalist_share * 0.11 +
            Q.konf_mentzenite_share * 0.025 -
            Q.konf_braunist_share * 0.16 -
            electoralCompetition * 0.6;
    } else if (key == "rival_relation_pis_p2050") {
        target -= 4;
    } else if (key == "rival_relation_ko_psl") {
        target +=
            Q.ko_classical_liberal_share * 0.04 +
            Q.psl_coalition_manager_share * 0.08 +
            Math.max(0, Q.party_system_pendulum) * 0.03;
    } else if (key == "rival_relation_ko_konf") {
        target -= 13 + Q.konf_braunist_share * 0.08;
    } else if (key == "rival_relation_ko_p2050") {
        target +=
            Q.p2050_state_capacity_share * 0.05 -
            electoralCompetition * 0.5;
    } else if (key == "rival_relation_psl_konf") {
        target +=
            Q.psl_conservative_share * 0.06 -
            Q.konf_braunist_share * 0.13 -
            electoralCompetition * 0.4;
    } else if (key == "rival_relation_psl_p2050") {
        target +=
            Q.psl_coalition_manager_share * 0.08 +
            (finiteAI(Q.third_way_cohesion, 50) - 50) * 0.12;
    } else if (key == "rival_relation_konf_p2050") {
        target -= 10 + Q.konf_braunist_share * 0.08;
    }
    return clampAI(target, 0, 100);
};
for (const pair of [
    ["pis", "ko"],
    ["pis", "psl"],
    ["pis", "konf"],
    ["pis", "p2050"],
    ["ko", "psl"],
    ["ko", "konf"],
    ["ko", "p2050"],
    ["psl", "konf"],
    ["psl", "p2050"],
    ["konf", "p2050"]
]) {
    if (
        (pair[0] == "p2050" || pair[1] == "p2050") &&
        !Q.p2050_emerged
    ) {
        continue;
    }
    const key = relationKeyAI(pair[0], pair[1]);
    Q[key] = moveTowardAI(
        clampAI(Q[key], 0, 100),
        passiveRelationTargetAI(pair[0], pair[1]),
        0.4
    );
}

const headlines = [];
const maintenanceHeadlines = [];
const partyLabelAI = {
    pis: "PiS",
    ko: "KO",
    psl: "PSL",
    konf: "Konfederacja",
    p2050: "Poland 2050"
};
const canAffordAI = function(id, cost) {
    return finiteAI(Q[id + "_org_resources"], 0) >= cost;
};
const maintainPartyAI = function(id, strategy, headline, recovery) {
    Q[id + "_ai_strategy"] = strategy;
    Q[id + "_ai_headline"] = headline;
    Q[id + "_org_resources"] =
        finiteAI(Q[id + "_org_resources"], 0) + finiteAI(recovery, 0.2);
    addMomentumAI(id, 0.04);
    maintenanceHeadlines.push(headline);
};
const takeActionAI = function(id, key, cost, headline, applyAction) {
    if (!canAffordAI(id, cost)) {
        maintainPartyAI(
            id,
            "Rebuild campaign capacity",
            partyLabelAI[id] + " scales back its preferred national action",
            0.25
        );
        return false;
    }
    Q[id + "_org_resources"] -= cost;
    Q[id + "_ai_last_spend"] = cost;
    Q[id + "_ai_acted"] = 1;
    Q[id + "_ai_actions"] += 1;
    Q.rival_actions_this_month += 1;
    Q[id + "_ai_strategy"] = key;
    Q[id + "_ai_headline"] = headline;
    applyAction();
    headlines.push(headline);
    return true;
};
const publicMoodModelAI = (typeof window !== "undefined"
    ? window : globalThis).polandPublicMoodModel;
const moodRightsIssuesAI = [
    "abortion_rights", "lgbt_equality", "secular_state",
    "refugee_solidarity"
];
const moodTargetAI = function(issues, bloc) {
    let target = issues[0];
    let best = -1;
    for (const issue of issues) {
        const salience = clampAI(Q[issue + "_salience"], 0, 100);
        const own = clampAI(Q[issue + "_" + bloc + "_ownership"], 0, 100);
        const rival = Math.max.apply(null,
            ["progressive", "centrist", "conservative"]
                .filter(function(other) { return other != bloc; })
                .map(function(other) {
                    return clampAI(
                        Q[issue + "_" + other + "_ownership"], 0, 100
                    );
                })
        );
        const leftCredit = clampAI(Q[issue + "_left_ownership"], 0, 100);
        const support = clampAI(Q[issue + "_support"], 0, 100);
        const backlash = clampAI(Q[issue + "_backlash"], 0, 100);
        const vulnerability = 100 - Math.abs(support - 50) * 2;
        const score = salience * 0.35 + (100 - own) * 0.15 +
            rival * 0.15 + vulnerability * 0.15 +
            leftCredit * 0.10 + backlash * 0.10;
        if (score > best) {
            target = issue;
            best = score;
        }
    }
    return target;
};
const queueMoodAI = function(
    actor, issue, bloc, cost, title, support, backlash, leftOwnership
) {
    if (!publicMoodModelAI) return;
    const costScale = cost >= 2 ? 1.6 : 1;
    const difficultyScale = Q.hard_mode ? 1.25 : 1;
    const scale = costScale * difficultyScale;
    // A rival's national campaign is a real force on the issue, not a rounding
    // error. The old ±1 clamp meant PiS could campaign against refugees every
    // month for four years and move the field by less than the monthly mean
    // reversion pulled back, so the climate could only ever drift the player's
    // way. `moodCampaignGain` is the dial: raise it for a more volatile
    // country, lower it for a stickier one.
    const moodCampaignGain = 6;
    const supportEffect = clampAI(
        finiteAI(support, 0) * scale * moodCampaignGain, -8, 8
    );
    const ownershipEffect = 3 * scale;
    const backlashEffect = clampAI(
        finiteAI(backlash, 0) * scale * 1.5, -8, 8
    );
    const leftEffect = clampAI(
        finiteAI(leftOwnership, -2) * scale, -6, 2
    );
    publicMoodModelAI.enqueue(Q, {
        id: "ai-" + actor + "-" + rivalAIMonthKey + "-" + issue,
        mode: "delta",
        source: "ai",
        actor: actor,
        bloc: bloc,
        issue: issue,
        title: title,
        support: supportEffect,
        salience: 4 * scale,
        backlash: backlashEffect,
        blocOwnership: ownershipEffect,
        leftOwnership: leftEffect
    });
    Q.rival_mood_last_action = title;
    Q.rival_mood_last_issue = issue;
    Q.rival_mood_last_actor = actor;
    Q.rival_mood_last_effect = issue.replace(/_/g, " ") +
        ": " + bloc + " ownership +" + ownershipEffect.toFixed(1) +
        ", support " + (supportEffect >= 0 ? "+" : "") +
        supportEffect.toFixed(1) + ", backlash " +
        (backlashEffect >= 0 ? "+" : "") + backlashEffect.toFixed(1);
};

Q.rival_actions_this_month = 0;
