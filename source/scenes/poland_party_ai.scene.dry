title: Rival parties choose their month
new-page: true
on-arrival: {!
const finiteAI = function(value, fallback) {
    return Number.isFinite(Number(value)) ? Number(value) : fallback;
};
const clampAI = function(value, low, high) {
    return Math.max(low, Math.min(high, finiteAI(value, low)));
};
const moveTowardAI = function(current, target, step) {
    const start = finiteAI(current, target);
    if (Math.abs(target - start) <= step) {
        return target;
    }
    return start + (target > start ? step : -step);
};
const randomAI = function() {
    return this.random.uint32() / 4294967296;
}.bind(this);
const normalizeWingFamilyAI = function(keys, defaults) {
    let total = 0;
    const values = [];
    for (let index = 0; index < keys.length; index += 1) {
        const fallback = defaults[index];
        const value = Math.max(0.1, finiteAI(Q[keys[index]], fallback));
        values.push(value);
        total += value;
    }
    let assigned = 0;
    for (let index = 0; index < keys.length; index += 1) {
        const normalized = index == keys.length - 1
            ? 100 - assigned
            : Math.round(values[index] * 1000 / Math.max(0.1, total)) / 10;
        Q[keys[index]] = normalized;
        assigned += normalized;
    }
};
const shiftWingAI = function(key, amount) {
    Q[key] = Math.max(0.1, finiteAI(Q[key], 0.1) + amount);
};
const dominantWingAI = function(entries) {
    let winner = entries[0];
    for (const entry of entries) {
        if (finiteAI(Q[entry[0]], 0) > finiteAI(Q[winner[0]], 0)) {
            winner = entry;
        }
    }
    return winner[1];
};

const rivalAIMonthKey =
    String(finiteAI(Q.year, 2019)) + "-" + String(finiteAI(Q.month, 1));
const rivalAIAlreadyUpdated =
    Q.rival_ai_last_month_key == rivalAIMonthKey;

if (!rivalAIAlreadyUpdated) {
const rivalParties = ["pis", "ko", "psl", "konf", "p2050"];
const electorateBlocs = [
    "metropolitan_liberals",
    "liberal_professionals",
    "public_service_families",
    "industrial_logistics",
    "provincial_welfare",
    "rural_localists",
    "older_welfare_households",
    "anti_establishment_youth"
];
const relationDefaults2019 = {
    rival_relation_pis_ko: 8,
    rival_relation_pis_psl: 24,
    rival_relation_pis_konf: 34,
    rival_relation_pis_p2050: 12,
    rival_relation_ko_psl: 62,
    rival_relation_ko_konf: 7,
    rival_relation_ko_p2050: 54,
    rival_relation_psl_konf: 22,
    rival_relation_psl_p2050: 58,
    rival_relation_konf_p2050: 10
};
const relationDefaults2023 = {
    rival_relation_pis_ko: 5,
    rival_relation_pis_psl: 26,
    rival_relation_pis_konf: 31,
    rival_relation_pis_p2050: 9,
    rival_relation_ko_psl: 68,
    rival_relation_ko_konf: 5,
    rival_relation_ko_p2050: 73,
    rival_relation_psl_konf: 19,
    rival_relation_psl_p2050: 82,
    rival_relation_konf_p2050: 7
};
const isFormationEra =
    Q.scenario_mode == "formation_2023" || finiteAI(Q.year, 2019) >= 2023;
const relationDefaults =
    isFormationEra ? relationDefaults2023 : relationDefaults2019;

const resourceDefaults = isFormationEra
    ? {pis: 11, ko: 10, psl: 7, konf: 7, p2050: 8}
    : {pis: 9, ko: 7, psl: 5, konf: 4, p2050: 0};
const incomeDefaults = isFormationEra
    ? {pis: 12, ko: 10, psl: 7, konf: 7, p2050: 8}
    : {pis: 11, ko: 9, psl: 7, konf: 7, p2050: 8};
const economicDefaults = {
    pis: 31,
    ko: 60,
    psl: 49,
    konf: 86,
    p2050: 55
};
const culturalDefaults = {
    pis: 86,
    ko: 43,
    psl: 68,
    konf: 91,
    p2050: 51
};
const rightScoreDefaults = isFormationEra
    ? {left: 32, pis: 64, ko: 49, psl: 60, konf: 90, p2050: 52}
    : {left: 35, pis: 61, ko: 50, psl: 59, konf: 89, p2050: 52};
const wingDefaults = isFormationEra
    ? {
        pis: [54, 46],
        ko: [48, 52],
        psl: [42, 38, 20],
        konf: [15, 52, 33],
        p2050: [45, 30, 25]
    }
    : {
        pis: [58, 42],
        ko: [42, 58],
        psl: [45, 35, 20],
        konf: [18, 47, 35],
        p2050: [40, 35, 25]
    };

normalizeWingFamilyAI(
    ["pis_solidarist_share", "pis_market_hardliner_share"],
    wingDefaults.pis
);
normalizeWingFamilyAI(
    ["ko_social_liberal_share", "ko_classical_liberal_share"],
    wingDefaults.ko
);
normalizeWingFamilyAI(
    [
        "psl_agrarian_pragmatist_share",
        "psl_conservative_share",
        "psl_coalition_manager_share"
    ],
    wingDefaults.psl
);
normalizeWingFamilyAI(
    [
        "konf_braunist_share",
        "konf_mentzenite_share",
        "konf_nationalist_share"
    ],
    wingDefaults.konf
);
normalizeWingFamilyAI(
    [
        "p2050_state_capacity_share",
        "p2050_christian_dem_share",
        "p2050_personalist_share"
    ],
    wingDefaults.p2050
);
for (const id of ["left", "pis", "ko", "psl", "konf", "p2050"]) {
    const rightScoreKey = id + "_right_score";
    Q[rightScoreKey] = Number.isFinite(Number(Q[rightScoreKey]))
        ? clampAI(Q[rightScoreKey], 0, 100)
        : rightScoreDefaults[id];
}

const initializingRivalAI = !Q.rival_ai_initialized;
if (initializingRivalAI) {
    Q.rival_ai_initialized = 1;
    Q.rival_ai_era = isFormationEra ? "2023" : "2019";
    Q.rival_income_last_month_index =
        finiteAI(Q.year, 2019) * 12 + finiteAI(Q.month, 1);
    Q.rival_ai_tick = 0;
    Q.rival_actions_this_month = 0;
    Q.rival_month_headline = "Rival parties have not acted yet";
    Q.rival_coalition_signal = "Coalition channels are still being mapped";
    Q.national_turnout_climate = isFormationEra ? 74 : 61;
    Q.p2050_ai_active = Q.p2050_emerged ? 1 : 0;
    Q.rival_strategy_log = [];
}

for (const id of rivalParties) {
    Q[id + "_org_resources"] = initializingRivalAI
        ? resourceDefaults[id]
        : Math.max(
            0,
            finiteAI(Q[id + "_org_resources"], resourceDefaults[id])
        );
    Q[id + "_org_income"] = initializingRivalAI
        ? incomeDefaults[id]
        : Math.max(
            0,
            finiteAI(Q[id + "_org_income"], incomeDefaults[id])
        );
    Q[id + "_economic_position"] = clampAI(
        Q[id + "_economic_position"],
        0,
        100
    );
    if (!Number.isFinite(Number(Q[id + "_economic_position"]))) {
        Q[id + "_economic_position"] = economicDefaults[id];
    }
    Q[id + "_cultural_position"] = clampAI(
        Q[id + "_cultural_position"],
        0,
        100
    );
    if (!Number.isFinite(Number(Q[id + "_cultural_position"]))) {
        Q[id + "_cultural_position"] = culturalDefaults[id];
    }
    // clampAI uses its lower bound as fallback, so restore authored defaults
    // on old saves where the qualities genuinely did not exist.
    if (Q[id + "_position_initialized"] !== 1) {
        Q[id + "_economic_position"] = economicDefaults[id];
        Q[id + "_cultural_position"] = culturalDefaults[id];
        Q[id + "_position_initialized"] = 1;
    }
    Q[id + "_ai_actions"] = Math.max(
        0,
        finiteAI(Q[id + "_ai_actions"], 0)
    );
    Q[id + "_ai_last_spend"] = 0;
    Q[id + "_ai_acted"] = 0;
    if (!Q[id + "_ai_strategy"]) {
        Q[id + "_ai_strategy"] = "Holding its opening position";
    }
    if (!Q[id + "_ai_headline"]) {
        Q[id + "_ai_headline"] = "No background action";
    }
}

// Existing saves retain the lower annual incomes authored for the old
// lump-sum model unless they are migrated once into the monthly economy.
if (!Q.rival_ai_monthly_income_migrated) {
    for (const id of rivalParties) {
        Q[id + "_org_income"] = Math.max(
            Q[id + "_org_income"],
            incomeDefaults[id]
        );
    }
    Q.rival_ai_monthly_income_migrated = 1;
}

Q.far_right_agenda = finiteAI(Q.far_right_agenda, 32);
Q.minority_safety = finiteAI(Q.minority_safety, 50);
Q.rival_ai_tick = Math.max(0, finiteAI(Q.rival_ai_tick, 0));
Q.national_turnout_climate = finiteAI(
    Q.national_turnout_climate,
    isFormationEra ? 74 : 61
);

for (const key of Object.keys(relationDefaults)) {
    Q[key] = clampAI(Q[key], 0, 100);
    if (Q[key + "_initialized"] !== 1) {
        Q[key] = relationDefaults[key];
        Q[key + "_initialized"] = 1;
    }
}

for (const bloc of electorateBlocs) {
    for (const party of ["left", "pis", "ko", "psl", "konf", "p2050"]) {
        const key = bloc + "_" + party + "_affinity";
        Q[key] = finiteAI(Q[key], 0);
    }
}

const p2050Independent = Q.p2050_emerged && !Q.p2050_joined_left;
if (p2050Independent && !Q.p2050_ai_active) {
    Q.p2050_ai_active = 1;
    Q.p2050_org_resources = Math.max(Q.p2050_org_resources, 6);
    Q.p2050_org_income = Math.max(Q.p2050_org_income, 4);
    Q.p2050_economic_position = economicDefaults.p2050;
    Q.p2050_cultural_position = culturalDefaults.p2050;
    Q.p2050_ai_strategy = "Convert a presidential movement into a party";
    Q.p2050_ai_headline =
        "Hołownia opens local structures outside the old party map";
    Q.rival_relation_ko_p2050 = Math.max(
        Q.rival_relation_ko_p2050,
        isFormationEra ? 73 : 50
    );
    Q.rival_relation_psl_p2050 = Math.max(
        Q.rival_relation_psl_p2050,
        isFormationEra ? 82 : 56
    );
    /* The opening calibration hides a party that does not yet exist.  Once
     * Poland 2050 launches, keeping that offset would erase its electorate
     * and leave PiS with the displaced votes indefinitely. */
    if (!Q.p2050_poll_launch_applied) {
        Q.poll_calibration_p2050 = 0;
        Q.p2050_poll_launch_applied = 1;
    }
}

// Organisational income follows live political advantages rather than a
// permanent party-name table. Seats and polling are normalised against the
// strongest active rival; offices benefit the formal alliance that sustains
// them, while PiS and KO retain their established-media advantage.
const resourcePartyCodeAI = function(value) {
    const code = String(value || "").trim().toLowerCase();
    if (["left", "lewica", "razem"].includes(code)) return "left";
    if (["pis", "prawo i sprawiedliwosc", "prawo i sprawiedliwość"]
        .includes(code)) return "pis";
    if (["ko", "po", "koalicja obywatelska", "platforma obywatelska"]
        .includes(code)) return "ko";
    if (["psl", "polskie stronnictwo ludowe"].includes(code)) return "psl";
    if (["p2050", "polska 2050", "poland 2050"].includes(code)) return "p2050";
    if (["konf", "konfederacja"].includes(code)) return "konf";
    return code;
};
const officePartyAI = function(name, recordedParty) {
    const officeName = String(name || "").trim();
    const lowerName = officeName.toLowerCase();
    if (
        !officeName || ["vacant", "pending", "disputed", "acting after"]
            .some(function(marker) { return lowerName.includes(marker); })
    ) return "";
    const dynamicNames = [
        ["left", Q.left_leader], ["left", Q.left_marshal_nominee],
        ["pis", Q.pis_leader], ["pis", Q.pres_2025_right_candidate],
        ["ko", Q.ko_leader], ["psl", Q.psl_leader],
        ["p2050", Q.p2050_leader],
        ["konf", Q.konf_libertarian_leader]
    ];
    for (const entry of dynamicNames) {
        if (entry[1] && String(entry[1]).trim() == officeName) {
            return entry[0];
        }
    }
    const nameFragments = {
        pis: ["duda", "nawrocki", "morawiecki", "szydło", "witek",
            "błaszczak", "blaszczak", "czarnek"],
        ko: ["tusk", "trzaskowski", "kidawa-błońska", "kidawa-blonska",
            "wielichowska", "sikorski", "nowacka"],
        psl: ["kosiniak-kamysz", "sawicki", "zgorzelski", "hetman"],
        p2050: ["hołownia", "holownia", "pełczyńska-nałęcz",
            "pelczynska-nalecz", "hennig-kloska", "petru"],
        konf: ["mentzen", "bosak", "korwin-mikke"],
        left: ["czarzasty", "stożek", "stozek", "biejat", "zandberg",
            "biedroń", "biedron", "dziemianowicz-bąk",
            "dziemianowicz-bak", "żukowska", "zukowska", "kotula"]
    };
    for (const id of Object.keys(nameFragments)) {
        if (nameFragments[id].some(function(fragment) {
            return lowerName.includes(fragment);
        })) return id;
    }
    return resourcePartyCodeAI(recordedParty);
};
const cabinetAllianceAI = [];
if (!Q.caretaker_government && Q.government_has_confidence) {
    const governmentPartyAI = resourcePartyCodeAI(Q.government_party);
    if (governmentPartyAI) cabinetAllianceAI.push(governmentPartyAI);
    if (Q.left_in_government) cabinetAllianceAI.push("left");
    if (Q.ministry_ko_in_cabinet) cabinetAllianceAI.push("ko");
    if (Q.ministry_psl_in_cabinet) cabinetAllianceAI.push("psl");
    if (Q.ministry_p2050_in_cabinet) cabinetAllianceAI.push("p2050");
    if (Q.sikorski_konf_cabinet) cabinetAllianceAI.push("konf");
}
const officeAllianceAI = function(anchor, primeMinister) {
    const alliance = new Set(anchor ? [anchor] : []);
    if (
        (anchor == "psl" || anchor == "p2050") &&
        (Q.third_way_active || Q.third_way_2023_done) && !Q.third_way_split
    ) {
        alliance.add("psl");
        alliance.add("p2050");
    }
    if (
        (primeMinister && anchor) ||
        (anchor && cabinetAllianceAI.includes(anchor))
    ) {
        for (const party of cabinetAllianceAI) alliance.add(party);
    }
    return alliance;
};
const presidentPartyAI = officePartyAI(
    Q.president_name,
    Q.president_party || Q.president_affiliation
);
const primeMinisterPartyAI = officePartyAI(
    Q.prime_minister,
    Q.pm_political_family || Q.prime_minister_party || Q.government_party
);
const marshalPartyAI = officePartyAI(
    Q.sejm_speaker,
    Q.sejm_speaker_party || Q.sejm_speaker_affiliation
);
const presidentAllianceAI = officeAllianceAI(presidentPartyAI, false);
const primeMinisterAllianceAI = officeAllianceAI(primeMinisterPartyAI, true);
const marshalAllianceAI = officeAllianceAI(marshalPartyAI, false);
const activeResourcePartiesAI = rivalParties.filter(function(id) {
    return id != "p2050" || p2050Independent;
});
const resourceSeatsAI = function(id) {
    return Math.max(0, finiteAI(Q[id + "_seats"], 0));
};
const resourcePollAI = function(id) {
    return Math.max(
        0,
        finiteAI(Q[id + "_vote_intent"], finiteAI(Q[id + "_poll"], 0))
    );
};
const largestRivalSeatsAI = Math.max.apply(
    null,
    activeResourcePartiesAI.map(resourceSeatsAI).concat([1])
);
const largestRivalPollAI = Math.max.apply(
    null,
    activeResourcePartiesAI.map(resourcePollAI).concat([1])
);
for (const id of rivalParties) {
    if (!activeResourcePartiesAI.includes(id)) {
        for (const component of [
            "business", "media", "president", "pm", "marshal",
            "parliament", "poll"
        ]) Q[id + "_resource_" + component + "_support"] = 0;
        Q[id + "_resource_score"] = 0;
        Q[id + "_org_income"] = 0;
        continue;
    }
    Q[id + "_resource_business_support"] =
        clampAI(Q[id + "_economic_position"], 0, 100) / 100 * 6;
    Q[id + "_resource_media_support"] =
        id == "pis" || id == "ko" ? 8 : 0;
    Q[id + "_resource_president_support"] =
        presidentAllianceAI.has(id) ? 10 : 0;
    Q[id + "_resource_pm_support"] =
        primeMinisterAllianceAI.has(id) ? 12 : 0;
    Q[id + "_resource_marshal_support"] =
        marshalAllianceAI.has(id) ? 8 : 0;
    Q[id + "_resource_parliament_support"] =
        resourceSeatsAI(id) / largestRivalSeatsAI * 28;
    Q[id + "_resource_poll_support"] =
        resourcePollAI(id) / largestRivalPollAI * 28;
    Q[id + "_resource_score"] = Math.round((
        Q[id + "_resource_business_support"] +
        Q[id + "_resource_media_support"] +
        Q[id + "_resource_president_support"] +
        Q[id + "_resource_pm_support"] +
        Q[id + "_resource_marshal_support"] +
        Q[id + "_resource_parliament_support"] +
        Q[id + "_resource_poll_support"]
    ) * 10) / 10;
    Q[id + "_org_income"] = Math.round(
        (4 + Q[id + "_resource_score"] * 0.08) * 10
    ) / 10;
}

const currentRivalMonthIndex =
    finiteAI(Q.year, 2019) * 12 + finiteAI(Q.month, 1);
const lastRivalIncomeMonth = finiteAI(
    Q.rival_income_last_month_index,
    currentRivalMonthIndex
);
const rivalMonthsElapsed = Math.max(
    0,
    Math.min(24, currentRivalMonthIndex - lastRivalIncomeMonth)
);
if (rivalMonthsElapsed > 0) {
    for (const id of rivalParties) {
        if (id != "p2050" || p2050Independent) {
            Q[id + "_org_resources"] +=
                Q[id + "_org_income"] * rivalMonthsElapsed / 12;
        }
    }
}
Q.rival_income_last_month_index = currentRivalMonthIndex;
Q.rival_income_last_year = finiteAI(Q.year, 2019);

const budgetText = String(Q.budget_strategy || "").toLowerCase();
const covidText = String(Q.covid_policy || "").toLowerCase();
const abortionText = String(Q.abortion_strategy || "").toLowerCase();
const mediaText = String(Q.media_strategy || "").toLowerCase();
let leftEconomicPosition =
    52 -
    (finiteAI(Q.labor_credibility, 46) - 46) * 0.38 -
    (finiteAI(Q.household_security, 45) - 45) * 0.12 -
    finiteAI(Q.budget_promises, 0) * 1.6 +
    finiteAI(Q.budget_breaches, 0) * 2.2;
if (
    budgetText.includes("social") ||
    budgetText.includes("welfare") ||
    budgetText.includes("public")
) {
    leftEconomicPosition -= 8;
}
if (budgetText.includes("separate") || budgetText.includes("fragment")) {
    leftEconomicPosition += 5;
}
let leftCulturalPosition =
    59 -
    (finiteAI(Q.progressive_credibility, 50) - 40) * 0.55 -
    (finiteAI(Q.feminist_trust, 44) - 40) * 0.30;
if (
    abortionText.includes("autonomous") ||
    abortionText.includes("party-led") ||
    abortionText.includes("broad")
) {
    leftCulturalPosition -= 10;
}
if (abortionText.includes("compromise")) {
    leftCulturalPosition += 22;
}
if (Q.sld_populist_route_active) {
    leftEconomicPosition -= 8;
    leftCulturalPosition += 24;
}
Q.left_economic_position = clampAI(leftEconomicPosition, 5, 90);
Q.left_cultural_position = clampAI(leftCulturalPosition, 5, 95);

const modeledInflation =
    isFormationEra && finiteAI(Q.inflation, 2.6) < 5
        ? 11.4
        : finiteAI(Q.inflation, 2.6);
const modeledGrowth =
    isFormationEra && finiteAI(Q.economic_growth, 4.5) > 2
        ? 0.2
        : finiteAI(Q.economic_growth, 4.5);
const macroEconomicSalience = clampAI(
    38 + Math.max(0, modeledInflation - 2) * 2.2 +
        Math.max(0, finiteAI(Q.unemployment, 5.1) - 5) * 2.5 +
        Math.max(0, -modeledGrowth) * 3 +
        finiteAI(Q.budget_promises, 0) * 2 +
        (Q.covid_event_done ? 12 : 0), 0, 100
);
const moodEconomicSalience =
    finiteAI(Q.social_spending_salience, 67) * 0.70 +
    finiteAI(Q.vaccination_salience, 24) * 0.30;
Q.economic_issue_salience = clampAI(
    moodEconomicSalience * 0.70 + macroEconomicSalience * 0.30, 0, 100
);
Q.cultural_issue_salience = clampAI(Math.max(
    finiteAI(Q.abortion_rights_salience, 42),
    finiteAI(Q.lgbt_equality_salience, 52),
    finiteAI(Q.secular_state_salience, 43),
    finiteAI(Q.refugee_solidarity_salience, 34)
), 0, 100);
Q.institutional_issue_salience = clampAI(
    finiteAI(Q.rule_of_law_salience, 56) * 0.60 +
    finiteAI(Q.border_security_salience, 44) * 0.20 +
    finiteAI(Q.national_security_salience, 48) * 0.20,
    0, 100
);

const leftEconomic = Q.left_economic_position;
const leftCultural = Q.left_cultural_position;
const vaccinationText =
    String(Q.vaccination_strategy || "").toLowerCase();
let covidPressureTarget = 0;
if (Q.covid_event_done) {
    covidPressureTarget =
        12 +
        finiteAI(Q.pandemic_deaths_pressure, 0) * 0.65 +
        Math.max(0, 48 - finiteAI(Q.public_trust, 43)) * 0.55 +
        Math.max(0, 45 - finiteAI(Q.health_capacity, 48)) * 0.35;
    if (covidText.includes("opposition")) {
        covidPressureTarget += 18;
    } else if (covidText.includes("national unity")) {
        covidPressureTarget += 3;
    } else if (covidText.includes("constitutional")) {
        covidPressureTarget += 1;
    } else if (covidText.includes("social shield")) {
        covidPressureTarget -= 5;
    }
    if (vaccinationText.includes("consent")) {
        covidPressureTarget += 6;
    } else if (vaccinationText.includes("public-health")) {
        covidPressureTarget -= 4;
    } else if (vaccinationText.includes("local access")) {
        covidPressureTarget -= 2;
    }
}
covidPressureTarget = clampAI(covidPressureTarget, 0, 100);
const currentCovidPressure = clampAI(
    Q.covid_anti_system_pressure,
    0,
    100
);
Q.covid_anti_system_pressure = currentCovidPressure < covidPressureTarget
    ? moveTowardAI(currentCovidPressure, covidPressureTarget, 3.5)
    : moveTowardAI(currentCovidPressure, covidPressureTarget, 0.8);

const leftVoteSignal = finiteAI(
    Q.left_vote_intent,
    finiteAI(Q.left_poll, 12.6)
);
const konfVoteSignal = finiteAI(
    Q.konf_vote_intent,
    finiteAI(Q.konf_poll, 6.8)
);
Q.party_system_left_pull = clampAI(
    (leftVoteSignal - 10) * 4 +
        (finiteAI(Q.labor_credibility, 46) - 45) * 0.6 +
        (finiteAI(Q.issue_ownership, 42) - 42) * 0.48 +
        (finiteAI(Q.electoral_viability, 62) - 55) * 0.30 +
        (finiteAI(Q.media_access, 31) - 31) * 0.22 +
        Math.max(0, finiteAI(Q.left_projected_seats, 49) - 40) * 0.25 +
        Math.max(0, finiteAI(Q.party_unity, 58) - 50) * 0.20 +
        (Q.social_floor_written ? 7 : 0) +
        (Q.primary_social_slate ? 3 : 0),
    0,
    100
);
Q.party_system_konf_pull = clampAI(
    (konfVoteSignal - 6) * 5 +
        (finiteAI(Q.far_right_agenda, 32) - 30) * 0.8 +
        Q.covid_anti_system_pressure * 0.6 +
        Math.max(
            0,
            finiteAI(Q.far_right_street_capacity, 25) - 25
        ) * 0.22 -
        Math.max(0, finiteAI(Q.civic_patriotism, 10) - 10) * 0.14 +
        Math.max(0, finiteAI(Q.konf_org_resources, 4) - 4) * 0.8 +
        Math.max(
            0,
            finiteAI(Q.anti_establishment_youth_konf_affinity, 0)
        ) * 1.2,
    0,
    100
);
const pendulumTarget = clampAI(
    Q.party_system_konf_pull - Q.party_system_left_pull,
    -100,
    100
);
Q.party_system_pendulum = moveTowardAI(
    clampAI(finiteAI(Q.party_system_pendulum, 0), -100, 100),
    pendulumTarget,
    4
);
Q.democratic_rightward_pressure = clampAI(
    Math.max(0, Q.party_system_pendulum) +
        Q.party_system_konf_pull * 0.35 +
        Q.covid_anti_system_pressure * 0.15 +
        Math.max(0, 45 - finiteAI(Q.issue_ownership, 42)) * 0.25 +
        Math.max(0, 40 - finiteAI(Q.media_access, 31)) * 0.16,
    0,
    100
);
if (Q.party_system_pendulum >= 24) {
    Q.party_system_climate =
        "Konfederacja is pulling the democratic camp to the right";
} else if (Q.party_system_pendulum >= 8) {
    Q.party_system_climate =
        "The radical right is setting the terms of competition";
} else if (Q.party_system_pendulum <= -24) {
    Q.party_system_climate =
        "A strong Left is pulling social policy toward solidarity";
} else if (Q.party_system_pendulum <= -8) {
    Q.party_system_climate =
        "The centre is answering pressure from a stronger Left";
} else {
    Q.party_system_climate =
        "Neither the Left nor Konfederacja controls the system's direction";
}

const economicHardship =
    Math.max(0, modeledInflation - 3) +
    Math.max(0, finiteAI(Q.unemployment, 5.1) - 5) * 1.4 +
    Math.max(0, -modeledGrowth) * 2;
const pisSolidaristDelta = clampAI(
