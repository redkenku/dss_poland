if (Q.left_in_government) Q.budget -= 2;
else Q.resources -= 2;
Q.refugee_empathy += 5;
Q.labor_credibility += 3;
Q.minority_safety += 4;
Q.anti_ukrainian_pressure -= 3;
if (Q.left_in_government) {
    Q.refugee_settlement = "Funded receiving-community services";
    Q.household_security += 4;
    Q.news_headline =
        "Receiving communities receive capacity instead of another slogan";
} else {
