        460,
        leftVotes + Q.abortion_vote_ko +
        Q.abortion_vote_p2050 + Q.abortion_vote_psl + roll
    )
);
Q.abortion_vote_no = Math.max(
    0,
    Math.min(
        460 - Q.abortion_vote_yes,
        Math.round(
            (Number(Q.pis_seats) || 0) +
            (Number(Q.konf_seats) || 0) +
            (Number(Q.korona_seats) || 0) +
            Math.max(
                0,
                (Number(Q.psl_seats) || 0) -
                Q.abortion_vote_psl
            ) +
            Math.max(
                0,
                (Number(Q.ko_seats) || 0) -
                Q.abortion_vote_ko
            )
        )
    )
);
Q.abortion_vote_abstain = Math.max(
    0,
    460 - Q.abortion_vote_yes - Q.abortion_vote_no
);
Q.abortion_vote_passed =
    Q.abortion_vote_yes > Q.abortion_vote_no ? 1 : 0;
if (Q.abortion_vote_passed) {
    Q.feminist_trust += 6;
    Q.psl_coalition_dissent += 3;
    Q.government_coalition_dissent += 2;
    Q.news_headline =
        "Decriminalisation passes " + Q.abortion_vote_yes +
        "–" + Q.abortion_vote_no;
} else {
    Q.feminist_trust -= 5;
    Q.psl_coalition_dissent += 8;
    Q.government_coalition_dissent += 8;
    Q.news_headline =
        "Decriminalisation fails " + Q.abortion_vote_yes +
        "–" + Q.abortion_vote_no;
}
!}

= July 2024 — Is a free vote still a coalition?

**[+ abortion_vote_yes +] yes · [+ abortion_vote_no +] no · [+
abortion_vote_abstain +] abstain.**

[? if abortion_vote_passed: Earlier organisation and coalition relations
produced a parliamentary majority. The President and implementation remain
separate fights.?]
[? if not abortion_vote_passed: The defeat reveals exactly how many PSL,
centre and KO deputies the April strategy moved. Retaliation can still damage
other policy before it changes a vote.?]

- @abort_shame
- @abort_trade
- @abort_crisis
- @abort_rebuild
