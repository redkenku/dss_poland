on-arrival: {!
const greens = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "greens";
});
const p2050 = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "p2050_party";
});
const nowoczesna = (Q.rival_group_records || []).find(function(record) {
    return record && record.id == "nowoczesna";
});
const greenMandates = Math.min(
    Math.max(0, Math.round(Number(Q.ko_seats) || 0)),
    Math.max(
        0,
        Math.round(
            Number(greens && greens.exclusive_seats) ||
            Number(greens && greens.mp_count) || 0
        )
    )
);
const p2050Transfer = greenMandates <= 3
    ? greenMandates
    : Math.max(3, Math.ceil(greenMandates / 2));
const nowoczesnaTransfer = greenMandates - p2050Transfer;
Q.p2050_greens_absorbed = 1;
Q.p2050_greens_transferred_mps = p2050Transfer;
Q.greens_nowoczesna_transferred_mps = nowoczesnaTransfer;
Q.p2050_comeback_stage = 2;
Q.p2050_comeback_status =
    "Independent Poland 2050 strengthened by the dissolved Greens";
Q.ko_seats = Math.max(0, (Number(Q.ko_seats) || 0) - p2050Transfer);
Q.p2050_seats = Math.max(0, Number(Q.p2050_seats) || 0) + p2050Transfer;
if (
    Q.government_party == "ko" && Q.government_has_confidence &&
    !Q.caretaker_government
) {
    Q.government_support_seats = Math.max(
        0,
        (Number(Q.government_support_seats) || 0) - p2050Transfer
    );
    Q.coalition_seats = Math.max(
        0,
        (Number(Q.coalition_seats) || 0) - p2050Transfer
    );
}
Q.p2050_holownia_retention_ceiling = Math.min(
