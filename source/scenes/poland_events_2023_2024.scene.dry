    p2050.parent = "Polska 2050";
    p2050.legal_status = "independent anti-duopoly party";
    p2050.list_committee = "p2050";
    p2050.club = "p2050";
    p2050.support_mode = "opposition";
    p2050.organisation = Math.min(
        100,
