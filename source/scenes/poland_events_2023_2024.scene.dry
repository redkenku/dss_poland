@suwerenna_merger_decision_2024
# prose-audit: Grade D — The factual premise is usable, but the scene is skeletal; add named actors, Lewica viewpoint, and a bespoke aftermath for each exit.
title: Suwerenna Polska decides whether to merge with PiS
subtitle: The result follows the organisations' accumulated support and dissent
new-page: true
tags: poland_event
priority: 24
order: 12
max-visits: 1
view-if: continuous_campaign = 1 and year = 2024 and month = 10 and suwerenna_renamed = 1 and suwerenna_merged = 0
on-arrival: {!
const solidarna = (Q.rival_group_records || []).find(function(record) {
    return record.id == "solidarna";
});
const mergerSupport = Number(Q.suwerenna_merge_support) || 0;
const mergerDissent = Number(Q.suwerenna_merge_dissent) || 0;
Q.suwerenna_individual_joiners = 0;
if (mergerSupport >= 60 && mergerDissent <= 45) {
    Q.suwerenna_merged = 1;
    Q.suwerenna_merger_result = "Full merger into PiS";
    if (solidarna) {
        solidarna.active = 0;
        solidarna.kind = "caucus";
        solidarna.allied = 1;
        solidarna.legal_status = "merged current inside PiS";
        solidarna.cohesion = Math.max(58, solidarna.cohesion - 8);
        solidarna.defection_readiness = 0;
    }
    Q.news_headline = "Suwerenna Polska dissolves into PiS after a negotiated vote";
} else if (mergerSupport >= 43 && mergerDissent < 34) {
    Q.suwerenna_merger_result = "Federated United Right agreement";
    if (solidarna) {
        solidarna.active = 1;
        solidarna.allied = 1;
        solidarna.legal_status = "federated allied party";
        solidarna.electoral_outside_option = "federated United Right partner";
    }
    Q.news_headline = "Suwerenna Polska keeps its legal identity inside a federation";
} else if (mergerDissent >= 34) {
    Q.suwerenna_merger_result = "Merger refused";
    const independentSeats = Math.min(
        Math.max(0, Math.round(Number(Q.pis_seats) || 0)),
        Math.max(
            0,
            Math.round(Number(solidarna && solidarna.mp_count) || 0)
        )
    );
    Q.suwerenna_seats = independentSeats;
    Q.pis_seats = Math.max(
        0,
        Math.round(Number(Q.pis_seats) || 0) - independentSeats
    );
    if (
        Q.government_party == "pis" && Q.government_has_confidence &&
        !Q.caretaker_government
    ) {
        Q.government_support_seats = Math.max(
            0,
            (Number(Q.government_support_seats) || 0) - independentSeats
        );
        Q.coalition_seats = Math.max(
            0,
            (Number(Q.coalition_seats) || 0) - independentSeats
        );
    }
    Q.other_seats = Math.max(
        0,
        Math.round(Number(Q.other_seats) || 0) + independentSeats
    );
    if (solidarna) {
        solidarna.active = 1;
        solidarna.allied = 0;
        solidarna.legal_status = "independent party after refused merger";
        solidarna.defection_readiness = Math.max(
            65,
            Number(solidarna.defection_readiness) || 0
        );
        solidarna.exclusive_seats = independentSeats;
    }
    Q.news_headline = "Suwerenna Polska refuses the final merger terms";
} else {
    Q.suwerenna_individual_joiners = 4;
    Q.suwerenna_merger_result = "Individual accessions; party survives";
    if (solidarna) {
        solidarna.active = 1;
        solidarna.allied = 1;
        solidarna.mp_count = Math.max(0, solidarna.mp_count - 4);
        solidarna.sejm_mps = Math.max(0, solidarna.sejm_mps - 4);
        solidarna.legal_status = "surviving party after individual accessions";
    }
    Q.news_headline = "Four Suwerenna politicians join PiS while the party survives";
}
!}

