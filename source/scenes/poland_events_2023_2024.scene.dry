    Math.max(0, Number(Q.left_progressives_seats) || 0) +
    cooperativeSeats;
Q.left_new_generation_seats =
    Math.max(0, Number(Q.left_labor_seats) || 0) +
    Math.max(0, Number(Q.left_progressives_seats) || 0);
Q.razem_seats = 0;
Q.zandberg_advisor = 0;
Q.zawisza_advisor = 0;
Q.matysiak_advisor = 0;
