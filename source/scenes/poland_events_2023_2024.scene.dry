view-if: continuous_campaign = 1 and year = 2024 and month = 4
on-arrival: {!
const localRoll =
    Math.floor((this.random.uint32() / 4294967296) * 5) - 2;
const localScore =
    (Number(Q.local_network) || 0) * 0.20 +
    (Number(Q.left_poll) || 0) * 0.65 +
    (Number(Q.turnout_readiness) || 0) * 0.08 +
    (Number(Q.ko_relation) || 0) * 0.025 +
    localRoll;
Q.local_election_seats = Math.max(
    4,
    Math.min(32, Math.round(localScore))
);
Q.local_election_outcome =
    Q.local_election_seats >= 18
        ? "breakthrough"
        : (Q.local_election_seats >= 11 ? "mixed result" : "warning");
Q.news_headline =
    "The Left wins " + Q.local_election_seats +
    " regional seats in a " + Q.local_election_outcome;
!}

