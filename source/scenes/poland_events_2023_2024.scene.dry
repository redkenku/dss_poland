new-page: true
tags: poland_event
priority: 24
order: 10
max-visits: 1
view-if: continuous_campaign = 1 and year = 2024 and month = 6
on-arrival: {!
const priorBorderCapacity =
    (Number(Q.border_rights_standard) || 0) +
    (Number(Q.border_security_confidence) || 0) +
    Math.min(20, (Number(Q.refugee_service_capacity) || 0) * 1.5);
const priorBorderOpacity =
    Math.max(0, 50 - (Number(Q.border_rights_standard) || 0)) +
    Math.max(0, 45 - (Number(Q.border_security_confidence) || 0));
Q.border_permission_pressure = Math.max(
    0,
    Math.min(
        100,
        Math.round(
            38 +
            priorBorderOpacity * 0.55 +
            (Number(Q.far_right_agenda) || 0) * 0.20 -
            priorBorderCapacity * 0.18
        )
    )
);
if (
    Q.border_doctrine == "Lawful migration and consular capacity" ||
    Q.border_doctrine == "Controlled processing with monitored access" ||
    Q.border_doctrine == "Officer protection with individual accountability"
) {
    Q.border_consequence_summary =
        "Earlier work left both lawyers and uniformed services at the table.";
    Q.border_permission_pressure = Math.max(
        0,
        Q.border_permission_pressure - 8
    );
} else if (
    Q.border_doctrine == "Security first with deferred scrutiny" ||
    Q.border_doctrine == "Anti-migrant scandal competition"
) {
    Q.border_consequence_summary =
        "Earlier firmness created permission for wider powers before review.";
    Q.border_permission_pressure = Math.min(
        100,
        Q.border_permission_pressure + 8
    );
} else {
    Q.border_consequence_summary =
        "The Left reaches the incident without an operational doctrine it owns.";
}
Q.military_trust += 5;
Q.border_security_confidence += 5;
Q.refugee_empathy -= 6;
Q.far_right_agenda += 4;
Q.news_headline = "Mateusz Sitek's death hardens the border consensus";
!}

