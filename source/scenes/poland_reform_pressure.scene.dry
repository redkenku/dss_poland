title: Coalition reform pressure
new-page: true
on-arrival: {!
const actorNames = {
    pis: "PiS",
    ko: "KO",
    psl: Q.third_way_display_name,
    p2050: Q.third_way_display_name,
    president: "President " + Q.president_name
};
const issueNames = {
    abortion: "reproductive-rights reform",
    marriage: "legal recognition and equal marriage",
    labor: "labour-law reconstruction",
    judicial_reset: "an accelerated judicial reset",
    public_media_takeover: "a hostile takeover of public media",
    marketisation: "privatisation and market liberalisation",
    pegasus_legalisation: "a legal framework and public defence for Pegasus",
    clerical_truce: "a truce with the Church and retreat from anticlerical politics",
    pzpr_condemnation: "a condemnation of the PZPR past"
};
if (
    Q.reform_pressure_mode != "partner_objection" ||
    !Q.reform_pressure_actor_name
) {
    Q.reform_pressure_actor_name =
        actorNames[Q.reform_pressure_actor] || Q.reform_pressure_actor_name;
}
Q.reform_pressure_issue_name =
    Q[Q.reform_pressure_issue + "_reform_display_name"] ||
    issueNames[Q.reform_pressure_issue] || Q.reform_pressure_issue_name;
const actor = Q.reform_pressure_actor;
const issue = Q.reform_pressure_issue;
// Recompute the settlement ceiling on arrival so the negotiation page shows
// the live number every option is trying to move.
Q.reform_ceiling_issue = issue;
Q.reform_ceiling_target = Math.max(
    1, Math.min(4, Math.round(Number(Q.reform_pressure_target_stage) || 1))
);
Q.reform_pressure_authority_live =
    Q.left_in_government && Q.government_has_confidence &&
    !Q.caretaker_government ? 1 : 0;
Q.reform_pressure_actor_live =
    (actor == "president" &&
        Q.reform_pressure_actor_name == "President " + Q.president_name) ||
    (actor == "pis" && Q.government_party == "pis") ||
    (actor == "ko" &&
        (Q.government_party == "ko" || Q.ministry_ko_in_cabinet)) ||
    (actor == "psl" &&
        (Q.government_party == "psl" || Q.ministry_psl_in_cabinet)) ||
    (actor == "p2050" &&
        (Q.government_party == "p2050" || Q.ministry_p2050_in_cabinet))
        ? 1 : 0;
Q.reform_pressure_bargain_available = actor != "president" ? 1 : 0;
// The Sejm freezer needs a Marshal who takes our calls. The chair belongs to a
// person, not a party, so the holder is matched by name against the Left's own
// front bench and its elected leadership.
const leftMarshalNames = [
    "Włodzimierz Czarzasty", "Robert Biedroń",
    "Agnieszka Dziemianowicz-Bąk", "Magdalena Biejat",
    "Adrian Zandberg", "Krzysztof Gawkowski", "Anna Maria Żukowska",
    "Katarzyna Kotula", "Krzysztof Śmiszek", "Tomasz Trela",
    "Paulina Matysiak", "Joanna Scheuring-Wielgus", "Wanda Nowicka"
];
const marshalName = String(Q.sejm_speaker || "").trim();
Q.left_holds_marshal =
    marshalName.length &&
    (leftMarshalNames.indexOf(marshalName) >= 0 ||
        marshalName == String(Q.left_leader || "").trim())
        ? 1 : 0;
Q.frozen_demand_count = Math.max(0, Number(Q.frozen_demand_count) || 0);
Q.frozen_demand_credibility = Math.max(
    0, 2 - Q.frozen_demand_count
);
Q.reform_pressure_freeze_available =
    Q.left_holds_marshal && Q.frozen_demand_credibility > 0 ? 1 : 0;
Q.reform_pressure_override_votes = Math.max(
    Number(Q.coalition_seats) || 0,
    Math.min(
        Number(Q.sejm_total) || 460,
        (Number(Q.government_support_seats) || 0) +
            (Number(Q.left_committed_seats) || 0)
    )
);
Q.reform_pressure_override_available =
    Q.reform_pressure_override_votes >= 276 ? 1 : 0;
// Partners stop taking the meeting after three rounds on the same bill. The
// round counter used to be incremented and never read, which is how the old
// flow became an unbounded resource sink.
Q.reform_pressure_rounds = Math.max(
    0, Math.round(Number(Q.reform_pressure_rounds) || 0)
);
Q.reform_pressure_rounds_left = Math.max(0, 3 - Q.reform_pressure_rounds);
Q.reform_pressure_bill_label =
    Q[issue + "_reform_label_" + Q.reform_ceiling_target] ||
    Q.reform_pressure_issue_name;
!}
call: poland_reform_ceiling
go-to: poland_major_reforms.authority_lost if reform_pressure_pending = 1 and reform_pressure_mode = "partner_objection" and reform_pressure_authority_live = 0; objection_actor_left if reform_pressure_pending = 1 and reform_pressure_mode = "partner_objection" and reform_pressure_authority_live = 1 and reform_pressure_actor_live = 0; demand_lapsed if reform_pressure_pending = 1 and reform_pressure_mode = "partner_demand" and (reform_pressure_authority_live = 0 or reform_pressure_actor_live = 0); objection if reform_pressure_pending = 1 and reform_pressure_mode = "partner_objection" and reform_pressure_authority_live = 1 and reform_pressure_actor_live = 1; demand if reform_pressure_pending = 1 and reform_pressure_mode = "partner_demand" and reform_pressure_authority_live = 1 and reform_pressure_actor_live = 1; poland_polling if reform_pressure_pending = 0

@objection_actor_left
title: The blocking partner leaves the count
on-arrival: reform_pressure_pending = 0; reform_pressure_mode = "None"; reform_pressure_return_mode = "pressure"; reform_pressure_last_result = "The former blocker no longer belongs to the governing coalition"; news_headline = reform_pressure_last_result
go-to: poland_major_reforms.resolve

@demand_lapsed
title: The partner's demand lapses with the coalition
new-page: true
on-arrival: reform_pressure_pending = 0; reform_pressure_mode = "None"; reform_pressure_cooldown = 2; reform_pressure_due_time = -1; reform_pressure_last_result = "The partner's reform demand lapses because its cabinet leverage has disappeared"; news_headline = reform_pressure_last_result

The demand depended on Lewica's votes inside a functioning shared government.
Once that authority or the sponsoring partner leaves the cabinet, no
concession is extracted and no agenda outcome is applied.

- @poland_polling: Carry the changed coalition into the next month

@objection
title: [+ reform_pressure_actor_name +] opposes our action
new-page: true

= [+ reform_pressure_actor_name +] blocks the bill

Lewica assembled enough public, ministerial and parliamentary power to table
**[+ reform_pressure_issue_name +]** at tier **[+
reform_pressure_target_stage +]** — [+ reform_pressure_bill_label +]. [+
reform_pressure_actor_name +] withholds the votes or signature that turns the
proposal into law.

**Settlement ceiling this month: [+ reform_ceiling_tier_label +]** ([+
reform_ceiling_reachable_label +]).
**[+ reform_pressure_actor_name +] scores the bill [+
reform_ceiling_blocker_score +]; tier [+ reform_ceiling_target_resolved +]
needs [+ reform_ceiling_need +].** Short by **[+ reform_ceiling_gap +]**.

[+ reform_ceiling_breakdown +].

[? if reform_ceiling_palace_locked = 1: **This is a profile veto, not a
price.** [+ reform_ceiling_blocker_name +] will not sign a tier-[+
reform_ceiling_target_resolved +] version of this bill at any relationship or
mandate; the Palace ceiling on this field is tier [+ reform_ceiling_palace_cap
+]. Only a lawful three-fifths override, a narrower settlement or a different
president gets past it. Spending further resources on the Chancellery's
protocol will not move the signature.
[? if reform_ceiling_negotiable >= 1: Cutting the bill to tier [+
reform_ceiling_negotiable +] brings it back inside what this Palace could sign,
and the Chancellery protocol becomes worth building again.?]?]

[? if reform_ceiling_blocker_kind = "partner": Commitments are the lever that
moves this actor. Each recorded commitment is worth nine points of its score;
public mandate, polling and the relationship supply the rest.?]

[? if reform_pressure_rounds_left <= 0: **The partners have stopped taking the
meeting on this bill.** Three negotiating rounds have already been spent; what
remains is the reachable settlement, a survival confrontation or withdrawal.?]
[? if reform_pressure_rounds_left = 1: One more negotiating round is available
on this bill before the partners stop taking the meeting.?]

- @objection_bargain
- @objection_relation
- @objection_mandate
- @objection_force
- @palace_reconsider
- @palace_relation
- @palace_referendum
- @palace_override
- @objection_narrow_to_cap
- @objection_narrow
- @objection_withdraw

@objection_bargain
title: Spend a resource on another coalition bargain
subtitle: Cost: 1 resource. One more recorded commitment (+9 to their score), then recount. Rounds left: [+ reform_pressure_rounds_left +].
view-if: reform_pressure_actor != "president"
choose-if: resources >= 1 and reform_pressure_bargain_available = 1 and reform_pressure_rounds_left > 0
unavailable-subtitle: [? if reform_pressure_rounds_left <= 0: This bill has already used its three negotiating rounds; the partner will not open another.?][? if reform_pressure_rounds_left > 0: This negotiating round requires one resource.?]
on-arrival: resources -= 1; reform_pressure_resolution = "bargain"
go-to: apply_objection

@objection_relation
title: Cash in the relationship and demand the promised vote
subtitle: Requires a 58+ relationship; bind this actor to the current bill and spend the accumulated trust.
view-if: reform_pressure_actor != "president"
choose-if: (reform_pressure_actor = "pis" and pis_relation >= 58) or (reform_pressure_actor = "ko" and ko_relation >= 58) or (reform_pressure_actor = "psl" and psl_relation >= 58) or (reform_pressure_actor = "p2050" and p2050_relation >= 58)
unavailable-subtitle: The relationship is not strong enough to cash in.
on-arrival: reform_pressure_resolution = "relationship"
go-to: apply_objection

@objection_mandate
title: Go over their heads and campaign the country on this bill
subtitle: Cost: 1 resource. Raise support and attention on [+ reform_ceiling_field_label +]; every veto player's score moves with the public mood.
choose-if: resources >= 1 and reform_pressure_rounds_left > 0
unavailable-subtitle: [? if reform_pressure_rounds_left <= 0: The bill has run out of negotiating rounds; a fresh campaign belongs to a later attempt.?][? if reform_pressure_rounds_left > 0: A national campaign round needs one resource.?]
on-arrival: resources -= 1; reform_pressure_resolution = "mandate"
go-to: apply_objection

@objection_force
title: Force the full issue and put the coalition under threat
subtitle: Cost: 2 resources. Carry the bill one tier above the coalition's ceiling and risk the government.
view-if: reform_pressure_actor != "president"
choose-if: resources >= 2 and reform_ceiling_target_resolved <= reform_ceiling_forceable
unavailable-subtitle: [? if resources < 2: A survival confrontation requires two resources.?][? if resources >= 2: Forcing buys one tier above the coalition's ceiling, and this bill is further above it than that.?]
on-arrival: resources -= 2; reform_pressure_resolution = "force"
go-to: apply_objection

@palace_reconsider
title: Return with a narrower constitutional and implementation brief
subtitle: Cost: 1 resource. One more Palace commitment (+9 to the presidential score), then resubmit.
view-if: reform_pressure_actor = "president"
choose-if: resources >= 1 and reform_ceiling_palace_locked = 0 and reform_pressure_rounds_left > 0
unavailable-subtitle: [? if reform_ceiling_palace_locked = 1: No implementation brief changes this Palace's position on this field. The presidential ceiling here is tier [+ reform_ceiling_palace_cap +].?][? if reform_ceiling_palace_locked = 0: A new presidential protocol needs one resource and an unspent negotiating round.?]
on-arrival: resources -= 1; reform_pressure_resolution = "palace_reconsider"
go-to: apply_objection

@palace_relation
title: Cash in the presidential relationship for a written commitment
subtitle: Requires President relation 58+. Spend that trust on this issue, then count the Palace again.
view-if: reform_pressure_actor = "president"
choose-if: president_relation >= 58 and reform_ceiling_palace_locked = 0
unavailable-subtitle: [? if reform_ceiling_palace_locked = 1: Trust is not the obstacle. This Palace will not sign a tier-[+ reform_ceiling_target_resolved +] bill on this field at all.?][? if reform_ceiling_palace_locked = 0: The President does not trust Lewica enough to make a written commitment.?]
on-arrival: reform_pressure_resolution = "palace_relation"
go-to: apply_objection

@palace_referendum
title: Put the referendum mandate directly before the President
subtitle: Use a successful referendum as political pressure; it does not itself override a veto.
view-if: reform_pressure_actor = "president" and reform_pressure_referendum_used = 0 and reform_ceiling_referendum_live = 1
choose-if: reform_ceiling_palace_locked = 0
unavailable-subtitle: A referendum is a mandate, not a signature. This Palace's ceiling on this field is tier [+ reform_ceiling_palace_cap +].
on-arrival: reform_pressure_resolution = "palace_referendum"
go-to: apply_objection

@palace_override
title: Override the veto with three-fifths of the Sejm
subtitle: Cost: 2 resources. Requires 276 votes; current override count [+ reform_pressure_override_votes +].
view-if: reform_pressure_actor = "president"
choose-if: resources >= 2 and reform_pressure_override_available = 1
unavailable-subtitle: A lawful veto override requires two resources and at least 276 votes.
on-arrival: resources -= 2; reform_pressure_resolution = "palace_override"
go-to: apply_objection

@objection_narrow_to_cap
title: Cut the bill to [+ reform_ceiling_negotiable_label +] and keep fighting for it
subtitle: Free. Drop to the most this Palace and this cabinet could ever carry — tier [+ reform_ceiling_negotiable +] — which is still above what they will carry today. The negotiation stays open.
view-if: reform_ceiling_negotiable_room = 1 and reform_ceiling_negotiable < reform_pressure_target_stage and reform_ceiling_negotiable >= 1
on-arrival: reform_pressure_resolution = "narrow_to_cap"
go-to: apply_objection

@objection_narrow
title: Find the common line: settle at [+ reform_ceiling_reachable_label +]
subtitle: Free. Drop straight to the tier the veto players will actually carry, in one move. Whatever passes closes this project.
view-if: reform_pressure_target_stage > 1 and reform_ceiling_tier >= 1
on-arrival: reform_pressure_resolution = "narrow"
go-to: apply_objection

@objection_withdraw
title: Take the defeat and regroup around the ambitious bill
subtitle: Withdraw now. Lose trust and momentum; after a five-month cooldown, the original goal returns.
on-arrival: reform_pressure_resolution = "withdraw"
go-to: apply_objection

@apply_objection
title: Resolve the coalition objection
on-arrival: {!
const issue = Q.reform_pressure_issue;
const previous = Math.max(
    0,
    Math.round(Number(Q.reform_pressure_previous_stage) || 0)
);
const proposed = Math.max(
    previous,
    Math.round(Number(Q.reform_pressure_target_stage) || previous)
);
const resolution = Q.reform_pressure_resolution;
const actor = Q.reform_pressure_actor;
const relationKey = actor == "president"
    ? "president_relation"
    : actor + "_relation";
const partnerToken = actor == "psl" || actor == "p2050"
    ? "third_way"
    : actor;
const commitmentKey = issue + "_" + partnerToken + "_commitment";
const palaceKey = issue + "_palace_commitment";
const palacePresidentKey = issue + "_palace_president";
if (
    actor == "president" &&
    Q[palacePresidentKey] != Q.president_name
) {
    Q[palaceKey] = 0;
    Q[palacePresidentKey] = Q.president_name;
}
Q.reform_pressure_abandoned = 0;
// Every paid option consumes a round, so the negotiation is finite and the
// player can see how much rope is left.
if (
    resolution == "bargain" || resolution == "mandate" ||
    resolution == "palace_reconsider"
) {
    Q.reform_pressure_rounds =
        Math.max(0, Number(Q.reform_pressure_rounds) || 0) + 1;
}
let dissent = 0;
if (resolution == "bargain") {
    dissent = 4 + proposed * 2;
    Q[relationKey] += 3;
    Q[commitmentKey] = Math.min(4, Number(Q[commitmentKey]) + 1);
    Q.reform_pressure_last_result =
        "Another bargain adds one issue-specific coalition commitment";
} else if (resolution == "mandate") {
    // The public route. It moves the field for every veto player at once
    // rather than one party's private commitment, and it can misfire: a
    // campaign into an organised backlash raises the backlash too.
    const field = Q.reform_ceiling_field || "";
    const supportNow = Number(Q[field + "_support"]) || 50;
    const backlashNow = Number(Q[field + "_backlash"]) || 50;
    const reach =
        4 +
        Math.max(0, Number(Q.media_capacity) || 0) * 0.05 +
        Math.max(0, Number(Q.left_poll) - 8) * 0.25 +
        Number(Q.progressive_credibility) * 0.02;
    const hostileClimate = backlashNow >= 60 ? 1 : 0;
    const swing = Math.round(
        hostileClimate ? reach * 0.45 : reach
    );
    const clampField = function(key, change) {
        Q[key] = Math.max(
            0, Math.min(100, (Number(Q[key]) || 0) + change)
        );
    };
    clampField(field + "_support", swing);
    clampField(field + "_salience", 6);
    clampField(field + "_backlash", hostileClimate ? 4 : 1);
    clampField(field + "_left_ownership", 4);
    Q[issue + "_reform_progress"] =
        (Number(Q[issue + "_reform_progress"]) || 0) + 5;
    Q.public_opinion_last_issue = field;
    Q.public_opinion_last_action =
        "National campaign for " + Q.reform_pressure_issue_name;
    Q.public_opinion_last_delta = swing;
    Q.public_opinion_last_reception = hostileClimate
        ? (swing >= 3 ? "contested" : "backlash")
        : (swing >= 5 ? "breakthrough" : "favourable");
    Q.reform_pressure_last_result = hostileClimate
        ? "The campaign moves the field slowly against an organised backlash"
        : "A national campaign raises public support behind the bill";
    dissent = 3 + proposed;
} else if (resolution == "relationship") {
    dissent = 6 + proposed * 2;
    Q[relationKey] -= 12;
    Q[commitmentKey] = Math.max(Number(Q[commitmentKey]), proposed);
    Q.reform_pressure_last_result =
        "Accumulated trust becomes a binding issue commitment";
} else if (resolution == "force") {
    dissent = 12 + proposed * 3;
    Q[relationKey] -= 10;
    Q[commitmentKey] = Math.max(Number(Q[commitmentKey]), proposed);
    Q.reform_pressure_forced = 1;
    Q.coalition_break_threat = 1;
    Q.early_election_risk += 10 + proposed * 2;
    Q.reform_pressure_last_result =
        "Lewica forces the coalition partner's votes and risks the government";
} else if (resolution == "palace_reconsider") {
    Q[palaceKey] = Math.min(4, Number(Q[palaceKey]) + 1);
    Q.president_relation += 4;
    Q.reform_pressure_last_result =
        "The President receives a revised implementation and constitutional brief";
} else if (resolution == "palace_relation") {
    Q[palaceKey] = Math.max(Number(Q[palaceKey]), proposed);
    Q.president_relation -= 15;
    Q.reform_pressure_last_result =
        "Lewica cashes in its presidential relationship for a written commitment";
} else if (resolution == "palace_referendum") {
    Q.reform_pressure_referendum_used = 1;
    Q[palaceKey] = Math.min(4, Number(Q[palaceKey]) + 2);
    Q.reform_pressure_last_result =
        "The referendum mandate returns the bill to presidential consideration";
} else if (resolution == "palace_override") {
    Q.reform_pressure_palace_override = 1;
    Q.president_relation -= 12;
    Q.constitutional_restraint += 2;
    Q.reform_pressure_last_result =
        "Three-fifths of the Sejm overrides the presidential veto";
} else if (resolution == "narrow_to_cap") {
    // Not a settlement — a reduction in ambition that keeps the fight alive at
    // the highest tier the Palace and the cabinet could ever carry.
    const negotiable = Math.max(
        1, Math.min(4, Math.round(Number(Q.reform_ceiling_negotiable) || 1))
    );
    Q.reform_pressure_target_stage = Math.max(previous, Math.min(
        proposed - 1, negotiable
    ));
    Q[issue + "_reform_proposal_stage"] = Q.reform_pressure_target_stage;
    Q.reform_pressure_last_result =
        "The bill is cut back to " +
        (Q[issue + "_reform_label_" + Q.reform_pressure_target_stage] ||
            ("tier " + Q.reform_pressure_target_stage)) +
        " and the negotiation continues";
} else if (resolution == "narrow" || resolution == "withdraw") {
    // "Find the common line" now lands on the tier the veto players will
    // actually carry, in one move. Walking down one blind rung at a time was
    // the reason this option read as a no-op.
    const reachable = Math.max(
        0, Math.min(4, Math.round(Number(Q.reform_ceiling_tier) || 0))
    );
    Q.reform_pressure_target_stage = resolution == "withdraw"
        ? previous
        : Math.max(previous, Math.min(proposed - 1, reachable));
    if (Q.reform_pressure_target_stage <= previous) {
        Q.reform_pressure_abandoned = 1;
        const progressKey = issue + "_reform_progress";
        const timerKey = "poland_" + issue + "_reform_timer";
        Q[progressKey] = Math.max(
            previous * 20,
            Number(Q[progressKey]) - 10
        );
        Q[timerKey] = 5;
        Q[issue + "_reform_proposal_stage"] =
            Number(Q[issue + "_reform_goal_stage"]) || 4;
        Q.public_trust -= 1;
        // The constituency that was promised this bill takes the hit.
        const withdrawalCost = {
            abortion: { feminist_trust: 4, progressive_credibility: 1 },
            marriage: { progressive_credibility: 4, minority_safety: 3 },
            church: { progressive_credibility: 3, urban_progressive_support: 3 },
            asylum: { progressive_credibility: 3, minority_safety: 4 },
            border: { government_delivery: 2 },
            defence: { government_delivery: 2 },
            labor: { labor_credibility: 3, workers_support: 3 },
            health: { labor_credibility: 2, public_sector_support: 3 },
            courts: { judicial_legitimacy: 2, public_trust: 1 }
        };
        const costs = withdrawalCost[issue] || { progressive_credibility: 1 };
        for (const key of Object.keys(costs)) {
            Q[key] = (Number(Q[key]) || 0) - costs[key];
        }
        // A field the party publicly retreated from cools and hardens against
        // the next attempt.
        const retreatField = Q.reform_ceiling_field;
        if (retreatField) {
            Q[retreatField + "_left_ownership"] = Math.max(
                0, (Number(Q[retreatField + "_left_ownership"]) || 0) - 4
            );
            Q[retreatField + "_backlash"] = Math.min(
                100, (Number(Q[retreatField + "_backlash"]) || 0) + 3
            );
        }
        Q.reform_pressure_last_result =
            "The bill is withdrawn for a five-month regroup, not abandoned permanently";
    } else {
        Q[issue + "_reform_proposal_stage"] =
            Q.reform_pressure_target_stage;
        Q.reform_pressure_last_result =
            "The common line settles at " +
            (Q[issue + "_reform_label_" + Q.reform_pressure_target_stage] ||
                ("tier " + Q.reform_pressure_target_stage));
    }
}
if (actor != "president") {
    Q.government_coalition_dissent += dissent;
    if (actor == "ko") Q.ko_coalition_dissent += dissent;
    if (actor == "psl") Q.psl_coalition_dissent += dissent;
    if (actor == "p2050") Q.p2050_coalition_dissent += dissent;
    if (actor == "pis") Q.united_right_cohesion -= Math.ceil(dissent / 2);
}
Q.reform_pressure_pending = 0;
Q.reform_pressure_mode = "None";
Q.reform_pressure_cooldown = 3;
Q.reform_pressure_due_time = -1;
Q.reform_pressure_return_mode = Q.reform_pressure_abandoned
    ? "card"
    : "pressure";
Q.news_headline = Q.reform_pressure_last_result;
!}
go-to: poland_polling if reform_pressure_abandoned = 1; poland_major_reforms.resolve if reform_pressure_abandoned = 0

@demand
title: [+ reform_pressure_actor_name +] brings its own major reform
new-page: true

= A partner's project reaches Lewica

**[+ reform_pressure_actor_name +]** wants Lewica to support **[+
reform_pressure_issue_name +]**. The proposal's pressure is **[+
reform_pressure_intensity +]/100**; its procedural-illegality risk is **[+
reform_pressure_illegality +]/100**.

[? if reform_pressure_issue = "judicial_reset": The coalition calls speed the
only way to retake institutions. Under hostile cohabitation, resolutions and
appointments increasingly replace statutes and presidential agreement.?]
[? if reform_pressure_issue = "public_media_takeover": KO wants public
television reclaimed now and legal settlement later. The decision will change
which political camp TVP's news reel serves.?]
[? if reform_pressure_issue = "marketisation": Finance and economy ministers
offer cabinet calm in exchange for privatisation, looser markets and a social
calendar our voters did not join government to postpone. The package usually
arrives as a bundle: private-health lanes, Sunday-trading concessions and
"temporary" labour flexibility that never feels temporary to retail staff.?]
[? if reform_pressure_issue = "marketisation" and reform_pressure_actor = "psl": PSL frames the bargain as practical centrism: keep the coalition calm,
open private providers where queues are visible, and stop ideological fights
that frighten county moderates. Our organisers hear a different message: pay
for cabinet peace by selling off programme identity.?]
[? if reform_pressure_issue = "marketisation" and reform_pressure_actor = "p2050": Poland 2050 sells the package as technocratic modernisation: patient
choice, deregulated services and "evidence-based" labour flexibility. In our
base, it sounds like market language wrapped around retreat.?]
[? if reform_pressure_issue = "marketisation" and reform_pressure_actor = "ko": KO's market wing presents this as responsible European normality: private
co-financing, lighter regulation and one more social compromise later. Lewica's
problem is not the spreadsheet. It is who pays politically when solidarity
becomes optional.?]
[? if reform_pressure_issue = "pegasus_legalisation": PiS asks us to turn an
explanation of state spyware into a legal framework broad enough to vindicate
its previous use.?]
[? if reform_pressure_issue = "clerical_truce": PiS wants its voters shown
that a Left coalition partner will stop treating Church privilege as a
governing conflict.?]
[? if reform_pressure_issue = "pzpr_condemnation": PiS demands a revision of
PZPR memory that makes its unlikely partner safer to defend on the right. The
SLD establishment hears an ultimatum about its own biography.?]

The partner offers a budget priority for agreement, accepts a lawful or
narrower version if we spend political capacity, and threatens coalition
peace if we refuse.

[? if reform_pressure_frozen_return = 1 and frozen_demand_count = 1: This is
the second time this file has crossed our table. Last time we promised
parliamentary action and delivered a committee referral that has not met.
**[+ reform_pressure_actor_name +]** has checked the order paper.?]
[? if reform_pressure_frozen_return = 1 and frozen_demand_count >= 2: This
file has been promised parliamentary action **[+ frozen_demand_count +]**
times and has not reached a first reading once. Nobody in the partner's caucus
is pretending any more that the delay is procedural.?]
[? if left_holds_marshal = 1 and reform_pressure_freeze_available = 1: We hold
the Marshal's chair, which means we control the order paper. A bill can be
promised, referred and simply never scheduled — for a while.?]
[? if left_holds_marshal = 1 and reform_pressure_freeze_available = 0: We still
hold the Marshal's chair and the order paper, but this partner has stopped
accepting a promise of parliamentary action as an answer.?]

- @demand_accept
- @demand_amend
- @demand_freeze
- @demand_refuse

@demand_accept
title: Take the offered budget priority and support the demand
subtitle: Cabinet budget +1. Accept the partner's full political and procedural price.
on-arrival: budget += 1; reform_pressure_resolution = "accept"
go-to: apply_demand

@demand_amend
title: Spend a resource to convince them to accept a lawful, narrower version
subtitle: Cost: 1 resource. Reduce the damage while keeping a coalition agreement.
choose-if: resources >= 1
unavailable-subtitle: A counter-draft and coalition campaign need one resource.
on-arrival: resources -= 1; reform_pressure_resolution = "amend"
go-to: apply_demand

@demand_freeze
title: Promise parliamentary action and put the bill in the Sejm freezer
subtitle: Requires the Marshal's chair. Buys quiet now; the demand returns angrier and the anger compounds each time.
choose-if: reform_pressure_freeze_available = 1
unavailable-subtitle: [? if left_holds_marshal = 0: The Marshal's chair is not ours, so we do not control the order paper and cannot promise a reading we can quietly withhold.?][? if left_holds_marshal = 1: We have used this promise as far as it will go — this partner no longer accepts a committee referral as an answer.?]
on-arrival: reform_pressure_resolution = "freeze"
go-to: apply_demand

@demand_refuse
title: Refuse and make the partner own the threat
subtitle: Free. Protect Lewica's line; relations, dissent and election risk worsen.
on-arrival: reform_pressure_resolution = "refuse"
go-to: apply_demand

@apply_demand
title: Resolve the partner's project
on-arrival: {!
const issue = Q.reform_pressure_issue;
const actor = Q.reform_pressure_actor;
const resolution = Q.reform_pressure_resolution;
const intensity = Number(Q.reform_pressure_intensity) || 50;
const illegality = Number(Q.reform_pressure_illegality) || 0;
const relationKey = actor + "_relation";
// Each previous freeze on this file raises the political price of every later
// answer to it, including another freeze.
const freezeAnger = 1 + 0.6 * Math.max(0, Number(Q.frozen_demand_count) || 0);
const thirdWayMarketisation =
    issue == "marketisation" &&
    (actor == "psl" || actor == "p2050");

if (resolution == "accept") {
    Q[relationKey] += 5;
    Q.government_coalition_dissent -= 3;
    if (actor == "ko") Q.ko_coalition_dissent -= 3;
    if (actor == "psl") Q.psl_coalition_dissent -= 3;
    if (actor == "p2050") Q.p2050_coalition_dissent -= 3;
} else if (resolution == "amend") {
    Q[relationKey] += 1;
    Q.government_coalition_dissent += 3;
    if (actor == "ko") Q.ko_coalition_dissent += 1;
    if (actor == "psl") Q.psl_coalition_dissent += 1;
    if (actor == "p2050") Q.p2050_coalition_dissent += 1;
} else if (resolution == "freeze") {
    // The promise is believed once, tolerated twice and never a third time.
    Q[relationKey] += Math.round(3 - 4 * (freezeAnger - 1));
    Q.government_coalition_dissent += Math.round(2 * freezeAnger);
    if (actor == "ko") Q.ko_coalition_dissent += Math.round(2 * freezeAnger);
    if (actor == "psl") Q.psl_coalition_dissent += Math.round(2 * freezeAnger);
    if (actor == "p2050") {
        Q.p2050_coalition_dissent += Math.round(2 * freezeAnger);
    }
    Q.coalition_blur = (Number(Q.coalition_blur) || 0) + 2;
    Q.early_election_risk =
        (Number(Q.early_election_risk) || 0) + Math.round(2 * freezeAnger);
    Q.frozen_demand_count = Math.max(0, Number(Q.frozen_demand_count) || 0) + 1;
    Q.frozen_demand_issue = issue;
    Q.frozen_demand_actor = actor;
    Q.frozen_demand_actor_name = Q.reform_pressure_actor_name;
    Q.frozen_demand_issue_name = Q.reform_pressure_issue_name;
    Q.frozen_demand_intensity = intensity;
    Q.frozen_demand_illegality = illegality;
    Q.reform_pressure_frozen = 1;
    Q.frozen_demand_due_time =
        (Number(Q.time) || 0) + (Q.frozen_demand_count >= 2 ? 2 : 3);
    Q.frozen_demand_log =
        (Q.frozen_demand_log ? Q.frozen_demand_log + " · " : "") +
        Q.reform_pressure_issue_name + " (" + Q.reform_pressure_actor_name +
        ")";
    if (Q.frozen_demand_count >= 3) {
        Q.coalition_break_threat = 1;
    }
} else {
    Q[relationKey] -= Math.round(8 * freezeAnger);
    Q.government_coalition_dissent += Math.round(8 * freezeAnger);
    if (actor == "ko") Q.ko_coalition_dissent += Math.round(7 * freezeAnger);
    if (actor == "psl") Q.psl_coalition_dissent += Math.round(7 * freezeAnger);
    if (actor == "p2050") {
        Q.p2050_coalition_dissent += Math.round(7 * freezeAnger);
    }
    Q.early_election_risk += Math.round(6 * freezeAnger);
    if (intensity >= 70 || Q.frozen_demand_count >= 2) {
        Q.coalition_break_threat = 1;
    }
    Q.reform_pressure_frozen = 0;
    Q.frozen_demand_count = 0;
}

if (issue == "judicial_reset") {
    if (resolution == "accept") {
        Q.coalition_judicial_pressure_concessions += 2;
        Q.judicial_repair_mandate += 5;
        Q.judicial_legitimacy += 2;
        Q.government_procedural_restraint -= 5 + Math.round(illegality / 20);
        Q.constitutional_restraint -= 3;
        Q.legal_dualism += 4 + Math.round(illegality / 20);
        Q.public_trust -= 2;
        Q.left_poll_momentum -= 0.1;
        Q.progressives_dissent += 3;
    } else if (resolution == "amend") {
        Q.coalition_judicial_pressure_concessions += 1;
        Q.judicial_repair_mandate += 3;
        Q.judicial_legitimacy += 3;
        Q.government_procedural_restraint += 2;
        Q.legal_dualism += 1;
        Q.public_trust -= 1;
    } else {
        Q.constitutional_restraint += 3;
    }
} else if (issue == "public_media_takeover") {
    if (resolution == "accept") {
        Q.coalition_media_takeover_concessions += 2;
        Q.public_media_transition = "KO-directed hostile takeover";
        Q.public_media_patron = "ko";
        Q.media_capacity += 4;
        Q.government_procedural_restraint -= 6;
        Q.legal_dualism += 4;
        Q.republika_capacity += 6;
        Q.public_trust -= 5;
        Q.left_poll -= 0.5;
        Q.left_poll_momentum -= 0.25;
        Q.progressive_credibility -= 3;
        Q.progressives_dissent += 4;
    } else if (resolution == "amend") {
        Q.coalition_media_takeover_concessions += 1;
        Q.public_media_transition = "Interim pluralist board";
        Q.public_media_patron = "neutral";
        Q.constitutional_restraint += 3;
        Q.media_capacity += 1;
        Q.public_trust -= 2;
        Q.left_poll_momentum -= 0.05;
    }
} else if (issue == "marketisation") {
    if (resolution == "accept") {
        Q.marketisation_concessions += 2;
        Q.left_economic_position += 10;
        Q.labor_credibility -= thirdWayMarketisation ? 11 : 9;
        Q.workers_support -= thirdWayMarketisation ? 9 : 7;
        Q.public_sector_support -= thirdWayMarketisation ? 8 : 6;
        Q.public_trust -= thirdWayMarketisation ? 12 : 8;
        Q.left_poll -= thirdWayMarketisation ? 1.2 : 0.7;
        Q.left_poll_momentum -= thirdWayMarketisation ? 0.55 : 0.35;
        Q.urban_progressive_support -= thirdWayMarketisation ? 8 : 5;
        Q.metropolitan_liberals_left_affinity -= thirdWayMarketisation ? 5 : 3;
        Q.razem_dissent += thirdWayMarketisation ? 14 : 10;
        Q.labor_dissent += thirdWayMarketisation ? 10 : 8;
        Q.progressives_dissent += thirdWayMarketisation ? 9 : 6;
        Q.spring_dissent += thirdWayMarketisation ? 7 : 4;
        Q.government_burden_breached = 1;
        Q.coalition_blur += thirdWayMarketisation ? 8 : 6;
    } else if (resolution == "amend") {
        Q.marketisation_concessions += 1;
        Q.left_economic_position += 4;
        Q.labor_credibility -= thirdWayMarketisation ? 5 : 3;
        Q.workers_support -= thirdWayMarketisation ? 4 : 2;
        Q.public_sector_support -= thirdWayMarketisation ? 3 : 1;
        Q.public_trust -= thirdWayMarketisation ? 6 : 3;
        Q.left_poll -= thirdWayMarketisation ? 0.4 : 0.2;
        Q.left_poll_momentum -= thirdWayMarketisation ? 0.25 : 0.12;
        Q.razem_dissent += thirdWayMarketisation ? 7 : 5;
        Q.labor_dissent += thirdWayMarketisation ? 5 : 3;
        Q.progressives_dissent += thirdWayMarketisation ? 4 : 2;
        Q.coalition_blur += 2;
    } else {
        Q.labor_credibility += 2;
        Q.workers_support += 1;
        Q.public_trust += 1;
        Q.left_poll_momentum += 0.1;
    }
} else if (issue == "pegasus_legalisation") {
    if (resolution == "accept") {
        Q.pegasus_legal_framework = 2;
        Q.government_procedural_restraint -= 7;
        Q.constitutional_restraint -= 5;
        Q.public_trust -= 4;
        Q.left_poll -= 0.4;
        Q.left_poll_momentum -= 0.2;
        Q.progressives_dissent += 8;
    } else if (resolution == "amend") {
        Q.pegasus_legal_framework = Math.min(
            2,
            Number(Q.pegasus_legal_framework) + 1
        );
        Q.government_procedural_restraint += 2;
        Q.prosecution_oversight_capacity += 3;
        Q.public_trust -= 1;
        Q.left_poll_momentum -= 0.05;
    } else {
        Q.constitutional_restraint += 3;
    }
} else if (issue == "clerical_truce") {
    if (resolution == "accept") {
        Q.anticlerical_edge -= 25;
        Q.left_cultural_position += 7;
        Q.progressive_credibility -= 6;
        Q.public_trust -= 3;
        Q.left_poll_momentum -= 0.15;
        Q.urban_progressive_support -= 4;
        Q.spring_dissent += 7;
        Q.progressives_dissent += 8;
        Q.razem_dissent += 4;
    } else if (resolution == "amend") {
        Q.anticlerical_edge -= 10;
        Q.left_cultural_position += 3;
        Q.public_trust -= 1;
        Q.progressives_dissent += 3;
    } else {
        Q.secular_state_support += 2;
        Q.progressive_credibility += 2;
    }
} else if (issue == "pzpr_condemnation") {
    if (resolution == "accept") {
        Q.pzpr_history_concessions += 2;
        Q.barons_dissent += 18;
        Q.barons_grievance_memory += 24;
        Q.party_unity -= 6;
        Q.public_trust -= 2;
        Q.left_poll -= 0.3;
        Q.left_poll_momentum -= 0.15;
        if (intensity >= 70 || Q.pzpr_history_concessions >= 3) {
            Q.barons_escalation_stage = 7;
            Q.barons_defection_readiness = 100;
            Q.caucus_crisis_pending = 1;
        }
    } else if (resolution == "amend") {
        Q.pzpr_history_concessions += 1;
        Q.barons_dissent += 8;
        Q.barons_grievance_memory += 10;
        Q.party_unity -= 2;
        Q.public_trust -= 1;
    } else {
        Q.barons_dissent -= 2;
        Q.party_unity += 1;
    }
}

if (issue == "marketisation" && resolution == "accept") {
    Q.reform_pressure_last_result =
        (thirdWayMarketisation
            ? Q.third_way_display_name + " extracts a marketisation package and Lewica pays the social cost"
            : "Lewica accepts a marketisation package to preserve coalition peace");
} else if (issue == "marketisation" && resolution == "amend") {
    Q.reform_pressure_last_result =
        "Lewica narrows a marketisation demand but still concedes a costly retreat";
}

if (!(issue == "marketisation" &&
    (resolution == "accept" || resolution == "amend"))) {
    Q.reform_pressure_last_result =
        Q.reform_pressure_actor_name + " — " +
        Q.reform_pressure_issue_name + ": " + resolution;
}
Q.reform_pressure_pending = 0;
Q.reform_pressure_mode = "None";
Q.reform_pressure_frozen_return = 0;
if (resolution == "accept" || resolution == "amend") {
    // Settling the file empties the freezer for it.
    Q.reform_pressure_frozen = 0;
    Q.frozen_demand_count = 0;
    Q.frozen_demand_due_time = -1;
}
// A frozen file keeps its own clock and must be able to come back before the
// ordinary pressure cooldown expires; that is the whole point of freezing it.
Q.reform_pressure_cooldown = resolution == "freeze"
    ? 0
    : (illegality >= 55 ? 3 : 5);
Q.reform_pressure_due_time = -1;
Q.news_headline = resolution == "freeze"
    ? Q.reform_pressure_actor_name + " accepts a promise of parliamentary " +
        "action on " + Q.reform_pressure_issue_name
    : Q.reform_pressure_last_result;
!}
go-to: poland_polling
