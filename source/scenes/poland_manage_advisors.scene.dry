title: Reshuffle leadership bureau
subtitle: Rebuild the three-seat slate. A changed bureau locks for six months.
is-pinned-card: true
view-if: started = 1 and leadership_reshuffle_timer <= 0
card-image: img/poland/reshuffle.svg
new-page: true
on-arrival: {!
const advisorKeys = [
    "czarzasty",
    "biedron",
    "zandberg",
    "dziemianowicz_bak",
    "zukowska",
    "kotula",
    "biejat",
    "wieczorek",
    "gawkowski",
    "nowicka",
    "zawisza",
    "matysiak"
];
Q.n_advisors = advisorKeys.reduce(function(total, advisor) {
    return total + (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
}, 0);
if (!Q.advisor_reshuffle_active) {
    Q.advisor_reshuffle_before = advisorKeys.map(function(advisor) {
        return Number(Q[advisor + "_advisor"]) === 1 ? "1" : "0";
    }).join("");
    Q.advisor_reshuffle_active = 1;
    Q.removed_advisor = "None";
    for (const advisor of advisorKeys) {
        Q["advisor_reshuffle_removed_" + advisor] = 0;
    }
}
!}

= Reshuffle the leadership bureau

The bureau has **[+ n_advisors +] / 3** filled seats. You may change several
seats before confirming the final slate.

| Caucus | Strength | Dissent |
| --- | ---: | ---: |
| Old SLD / barons | [+ barons_strength : strength +] | [+ barons_dissent : dissent +] |
| Wiosna / Spring | [+ spring_strength : strength +] | [+ spring_dissent : dissent +] |
| Labour current | [+ labor_strength : strength +] | [+ labor_dissent : dissent +] |
| Younger progressive SLD | [+ progressives_strength : strength +] | [+ progressives_dissent : dissent +] |
| Razem | [+ razem_strength : strength +] | [+ razem_dissent : dissent +] |

- @remove: Remove advisers
- @add: Appoint advisers
- @finish: Finish the reshuffle

@remove
title: Remove advisers
subtitle: Open a caucus, then withdraw one of its active representatives.

- @remove_barons
- @remove_spring
- @remove_labor
- @remove_progressives
- @remove_razem
- @poland_manage_advisors: Back to the slate

@remove_barons
title: Old SLD / barons
subtitle: Party apparatus, regional machinery and the old organisational elite.
view-if: czarzasty_advisor = 1 or wieczorek_advisor = 1

- @remove_czarzasty
- @remove_wieczorek
- @remove: Back to the caucuses

@remove_spring
title: Wiosna / Spring
subtitle: The Wiosna organisation and its distinct political brand.
view-if: biedron_advisor = 1

- @remove_biedron
- @remove: Back to the caucuses

@remove_labor
title: Labour current
subtitle: Public services, workplace organisation and trade-union politics.
view-if: dziemianowicz_bak_advisor = 1

- @remove_adb
- @remove: Back to the caucuses

@remove_progressives
title: Younger progressive SLD
subtitle: The women-led secular current and its parliamentary organisers.
view-if: zukowska_advisor = 1 or kotula_advisor = 1 or gawkowski_advisor = 1 or nowicka_advisor = 1

- @remove_zukowska
- @remove_kotula
- @remove_gawkowski
- @remove_nowicka
- @remove: Back to the caucuses

@remove_razem
title: Razem
subtitle: Razem's autonomous organisation, programme and parliamentary network.
view-if: zandberg_advisor = 1 or biejat_advisor = 1 or zawisza_advisor = 1 or matysiak_advisor = 1

