title: Reshuffle leadership bureau
subtitle: Rebuild the three-seat slate. A changed bureau locks for six months.
is-pinned-card: true
view-if: started = 1 and leadership_reshuffle_timer <= 0
card-image: img/poland/cards/reshuffle.webp
new-page: true
on-arrival: {!
const advisorKeys = [
    "miller",
    "czarzasty",
    "biedron",
    "zandberg",
    "dziemianowicz_bak",
    "zukowska",
    "kotula",
    "biejat",
    "wieczorek",
    "gawkowski",
    "nowicka",
    "zawisza",
    "matysiak",
    "konieczny",
    "morawska_stanecka",
    "kwiatkowski",
    "pelczynska_nalecz",
    "hennig_kloska",
    "zielinska",
    "morawiecki",
    "holownia",
    "tracz",
    "spurek",
    "semieniuk",
    "cieszynski"
];
Q.n_advisors = advisorKeys.reduce(function(total, advisor) {
    return total + (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
}, 0);
const activeAdvisors = advisorKeys.filter(function(advisor) {
    return Number(Q[advisor + "_advisor"]) === 1;
});
if (Number(Q.advisor_slot_1_locked) === 1) {
    Q.advisor_slot_1 = "miller";
    Q.miller_advisor = 1;
    const openSeats = activeAdvisors.filter(function(advisor) {
        return advisor !== "miller";
    });
    Q.advisor_slot_2 = openSeats[0] || "";
    Q.advisor_slot_3 = openSeats[1] || "";
} else {
    Q.advisor_slot_1 = activeAdvisors[0] || "";
    Q.advisor_slot_2 = activeAdvisors[1] || "";
    Q.advisor_slot_3 = activeAdvisors[2] || "";
}
if (!Q.advisor_reshuffle_active) {
    Q.advisor_reshuffle_before = advisorKeys.map(function(advisor) {
        return Number(Q[advisor + "_advisor"]) === 1 ? "1" : "0";
    }).join("");
    Q.advisor_reshuffle_active = 1;
    Q.removed_advisor = "None";
    for (const advisor of advisorKeys) {
        Q["advisor_reshuffle_removed_" + advisor] = 0;
    }
}
!}

= Reshuffle the leadership bureau

The bureau has **[+ n_advisors +] / 3** filled seats. You may change several
seats before confirming the final slate.

Only active caucuses can appoint or retain a bureau representative.

[? if advisor_slot_1_locked: **Slot 1 is locked:** Leszek Miller remains in
place and cannot be removed by reshuffle. ?]

[? if barons_active: **[+ barons_name +]** — [+ barons_strength : strength +]
strength, [+ barons_dissent : dissent +] dissent.  ?]
[? if spring_active: **[+ spring_name +]** — [+ spring_strength : strength +]
strength, [+ spring_dissent : dissent +] dissent.  ?]
[? if labor_active: **[+ labor_name +]** — [+ labor_strength +]
parliamentary influence, [+ labor_credibility +] credibility, [+ union_trust +]
wider-union trust.  ?]
[? if progressives_active: **[+ progressives_name +]** — [+
progressives_strength : strength +] strength, [+ progressives_dissent : dissent
+] dissent.  ?]
[? if razem_active: **Razem** — [+ razem_strength : strength +] strength, [+
razem_dissent : dissent +] dissent.  ?]
[? if pps_active: **PPS** — [+ pps_strength : strength +] strength, [+
pps_dissent : dissent +] dissent.  ?]
[? if social_patriot_active: **[+ social_patriot_name +]** — [+
social_patriot_strength : strength +] strength, [+ social_patriot_dissent :
dissent +] dissent.  ?]

- @remove: Remove advisers
- @add: Appoint advisers
- @finish: Finish the reshuffle

@remove
title: Remove advisers
subtitle: Withdraw any active representative directly by name.

- @remove_czarzasty
- @remove_wieczorek
- @remove_biedron
- @remove_adb
- @remove_zukowska
- @remove_kotula
- @remove_gawkowski
- @remove_nowicka
- @remove_zandberg
- @remove_biejat
- @remove_zawisza
- @remove_matysiak
- @remove_konieczny
- @remove_morawska_stanecka
- @remove_kwiatkowski
- @remove_pelczynska_nalecz
- @remove_hennig_kloska
- @remove_holownia
- @remove_zielinska
- @remove_tracz
- @remove_spurek
- @remove_morawiecki
- @remove_semieniuk
- @remove_cieszynski
- @poland_manage_advisors: Back to the slate

@remove_barons
title: Organisational establishment
subtitle: Party apparatus, regional machinery and the old organisational elite.
view-if: barons_active = 1 and (czarzasty_advisor = 1 or wieczorek_advisor = 1)

- @remove_czarzasty
- @remove_wieczorek
- @remove: Back to the caucuses

@remove_spring
title: Wiosna / Spring
subtitle: The Wiosna organisation and its distinct political brand.
view-if: spring_active = 1 and biedron_advisor = 1

- @remove_biedron
- @remove: Back to the caucuses

@remove_labor
title: Lewica Pracy parliamentary network
subtitle: Public services, workplace organisation and trade-union relationships; not a separate member party.
view-if: labor_active = 1 and dziemianowicz_bak_advisor = 1

- @remove_adb
- @remove: Back to the caucuses

@remove_progressives
title: Younger progressive SLD
subtitle: The women-led secular current and its parliamentary organisers.
view-if: progressives_active = 1 and (zukowska_advisor = 1 or kotula_advisor = 1 or gawkowski_advisor = 1 or nowicka_advisor = 1 or (spring_active = 0 and biedron_advisor = 1))

- @remove_biedron_progressive
- @remove_zukowska
- @remove_kotula
- @remove_gawkowski
- @remove_nowicka
- @remove: Back to the caucuses

@remove_razem
title: Razem
subtitle: Razem's autonomous organisation, programme and parliamentary network.
view-if: razem_active = 1 and (zandberg_advisor = 1 or biejat_advisor = 1 or zawisza_advisor = 1 or (social_patriot_active = 0 and matysiak_advisor = 1))

- @remove_zandberg
- @remove_biejat
- @remove_zawisza
- @remove_matysiak_razem
- @remove: Back to the caucuses

@remove_social_patriot
title: Lewica Patriotyczna
subtitle: Regional welfare, development and sovereignty organisers.
view-if: social_patriot_active = 1 and matysiak_advisor = 1

- @remove_matysiak
- @remove: Back to the caucuses

@remove_pps
title: PPS
subtitle: Parliamentary socialists organising a separate caucus inside the broader Left field.
view-if: pps_active = 1 and (konieczny_advisor = 1 or morawska_stanecka_advisor = 1 or kwiatkowski_advisor = 1)

- @remove_konieczny
- @remove_morawska_stanecka
- @remove_kwiatkowski
- @remove: Back to the caucuses

@remove_matysiak_razem
title: Remove Paulina Matysiak
