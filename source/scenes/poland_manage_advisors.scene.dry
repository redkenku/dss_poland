    Q.matysiak_party = "Lewica Patriotyczna";
    Q.news_headline = "Matysiak represents Lewica Patriotyczna in the bureau";
} else {
    Q.razem_strength += 1;
    Q.labor_strength += 1;
    Q.news_headline = "Matysiak joins the bureau";
}
Q.local_network += 1;
!}
go-to: poland_manage_advisors

@finish
title: Finish the reshuffle
subtitle: A caucus taking most seats inflicts 10 dissent on every unrepresented wing.
on-arrival: {!
const advisorKeys = [
    "miller",
    "czarzasty",
    "biedron",
    "zandberg",
    "dziemianowicz_bak",
    "zukowska",
    "kotula",
    "biejat",
    "wieczorek",
    "gawkowski",
    "nowicka",
    "zawisza",
    "matysiak",
    "konieczny",
    "morawska_stanecka",
    "kwiatkowski",
    "pelczynska_nalecz",
    "hennig_kloska",
    "zielinska",
    "morawiecki",
    "holownia",
    "tracz",
    "spurek",
    "semieniuk",
    "cieszynski"
];
const finalSignature = advisorKeys.map(function(advisor) {
    return Number(Q[advisor + "_advisor"]) === 1 ? "1" : "0";
}).join("");
Q.n_advisors = advisorKeys.reduce(function(total, advisor) {
    return total + (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
}, 0);
const openingSignature =
    typeof Q.advisor_reshuffle_before === "string"
        ? Q.advisor_reshuffle_before
        : finalSignature;
if (finalSignature !== openingSignature) {
    Q.leadership_reshuffle_timer = 6;
    const advisorCaucuses = {
        barons: ["miller", "czarzasty", "wieczorek"],
        spring: Q.spring_active ? ["biedron"] : [],
        labor: ["dziemianowicz_bak"],
        progressives: [
            "zukowska", "kotula", "gawkowski", "nowicka"
        ].concat(Q.spring_active ? [] : ["biedron"]),
        razem: ["zandberg", "biejat", "zawisza"].concat(
            Q.social_patriot_active ? [] : ["matysiak"]
        ),
        pps: [
            "konieczny", "morawska_stanecka", "kwiatkowski"
        ],
        social_patriot: ["matysiak"],
        p2050_current: [
            "pelczynska_nalecz", "hennig_kloska", "holownia"
        ],
        zieloni_current: ["zielinska", "tracz", "spurek"],
        rozwoj_current: ["morawiecki", "semieniuk", "cieszynski"]
    };
    const representation = {};
    for (const faction of Object.keys(advisorCaucuses)) {
        representation[faction] = advisorCaucuses[faction].reduce(
            function(total, advisor) {
                return total +
                    (Number(Q[advisor + "_advisor"]) === 1 ? 1 : 0);
            },
            0
        );
        Q[faction + "_advisor_count"] = representation[faction];
    }
    const dominantFaction = Object.keys(representation).find(function(faction) {
        return representation[faction] >= 2;
    });
    const factionIsActive = function(faction) {
        if (faction == "p2050_current") {
            return (Q.p2050_joined_left || Q.p2050_social_joined_left) &&
                Number(Q.left_p2050_current_seats) > 0;
        }
        if (faction == "zieloni_current") {
            return Q.greens_joined_left && Number(Q.left_green_current_seats) > 0;
        }
        if (faction == "rozwoj_current") {
            return Q.rozwoj_joined_left && Number(Q.left_rozwoj_current_seats) > 0;
        }
        return Q[faction + "_active"];
    };
    const hurtFactions = dominantFaction
        ? Object.keys(representation).filter(function(faction) {
            return factionIsActive(faction) && representation[faction] === 0;
        })
        : [];
    for (const faction of hurtFactions) {
        Q[faction + "_dissent"] += 10;
    }
    Q.news_headline = hurtFactions.length
        ? "A lopsided bureau shuts whole wings out of the leadership"
        : "The leadership confirms a new three-seat bureau";
}
Q.advisor_reshuffle_before = finalSignature;
Q.advisor_reshuffle_active = 0;
Q.removed_advisor = "None";
!}
go-to: poland_hub

